#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-backlog — offline harness for bin/backlog (--dry-run, a stub gh, or a stateful fake gh).
set -uo pipefail

PASS=0
FAIL=0
FAILURES=()

ok()   { printf '[PASS] %s\n' "$1"; PASS=$((PASS + 1)); }
fail() { printf '[FAIL] %s\n' "$1"; FAIL=$((FAIL + 1)); FAILURES+=("$1"); }
want() {
    local label="$1" output="$2" token="$3"
    if grep -qF -- "$token" <<< "$output"; then
        ok "$label"
    else
        fail "$label (missing: $token)"
    fi
}

SCRIPT="$(cd "$(dirname "$0")" && pwd)/backlog"

# Case 1: --help exits 0 and names the repo
OUT="$("$SCRIPT" --help 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "--help exits 0" || fail "--help exits 0 (got $RC)"
want "--help names the repo" "$OUT" "a-jay85/IBL5-backlog"

# Fake gh shared with the harness pytest. mkfake <name> [seed-json] sets FAKE_DIR/FAKE_STORE
# and writes a `gh` wrapper that routes to the stateful fake.
FIXTURE="$(cd "$(dirname "$0")/.." && pwd)/tools/postplan-harness/tests/fixtures/fake_backlog_gh.py"
FAKE_ROOT="$(mktemp -d)"
trap 'rm -rf "$FAKE_ROOT" "${STUB_DIR:-}"' EXIT
mkfake() {
    FAKE_DIR="$FAKE_ROOT/$1"; mkdir -p "$FAKE_DIR"
    FAKE_STORE="$FAKE_DIR/store.json"
    local seed='{"issues": [], "fail_list": false}'
    [ -n "${2:-}" ] && seed="$2"
    printf '%s' "$seed" > "$FAKE_STORE"
    printf '#!/bin/sh\nexec python3 "%s" --store "%s" "$@"\n' "$FIXTURE" "$FAKE_STORE" > "$FAKE_DIR/gh"
    chmod +x "$FAKE_DIR/gh"
}

# Case 2: --dry-run new reads GitHub (an empty fake) and prints the cap decision
VALID_BODY='https://github.com/a-jay85/IBL5/pull/1234
bin/backlog:83 passes an empty --body, so every filed issue carries no origin.
Failure scenario: a Phase 6.5 writer files a finding and triage cannot locate it.'
if command -v python3 >/dev/null 2>&1; then
    mkfake case2
    OUT="$(BACKLOG_GH="$FAKE_DIR/gh" "$SCRIPT" --dry-run new ci "x" "$VALID_BODY" 2>&1)"; RC=$?
    [ "$RC" -eq 0 ] && ok "--dry-run new exits 0" || fail "--dry-run new exits 0 (got $RC)"
    if grep -qE '^would-create	-	x$' <<< "$OUT"; then
        ok "--dry-run new prints would-create"
    else
        fail "--dry-run new prints would-create (got: $OUT)"
    fi
    if [ -e "$FAKE_STORE.log" ] && grep -qE '"issue", "(create|edit|reopen)"' "$FAKE_STORE.log"; then
        fail "--dry-run new wrote to GitHub"
    else
        ok "--dry-run new wrote nothing"
    fi
else
    printf '[SKIP] Case 2 --dry-run new (python3 not installed)\n'
fi

# Case 3: unknown subcommand exits non-zero
"$SCRIPT" bogus-subcommand >/dev/null 2>&1; RC=$?
[ "$RC" -ne 0 ] && ok "unknown subcommand exits non-zero" || fail "unknown subcommand exits non-zero (got $RC)"

# reject <label> <stderr-token> <args...>: expects exit 2, the named rule
# on stderr, and no composed gh command (validation runs before run()).
reject() {
    local label="$1" token="$2"; shift 2
    local out rc
    out="$("$SCRIPT" --dry-run "$@" 2>&1)"; rc=$?
    [ "$rc" -eq 2 ] && ok "$label exits 2" || fail "$label exits 2 (got $rc)"
    want "$label names the rule" "$out" "$token"
    if grep -qF -- "gh issue" <<< "$out"; then
        fail "$label composed a gh command"
    else
        ok "$label composed no gh command"
    fi
}

PR='https://github.com/a-jay85/IBL5/pull/1234'
LONG_TAIL='Failure scenario: the writer files an issue with no location and triage stalls on it for weeks.'

# Case 4: body arity
reject "new with no body" "new requires <label> <title> <body>" new ci "t"
reject "new with 4 args" "new requires <label> <title> <body>" new ci "t" "$VALID_BODY" extra

# Case 5: body content rules (checked in this order: empty, URL, file:line, length)
reject "empty body" "body is empty" new ci "t" ""
reject "whitespace-only body" "body is empty" new ci "t" "
	"
reject "URL-only body" "body needs a file:line location" new ci "t" "$PR"
reject "URL not on first line" "body must start with an origin PR URL" \
    new ci "t" "Found in review.
$PR
bin/backlog:83 $LONG_TAIL"
reject "wrong-repo URL" "body must start with an origin PR URL" \
    new ci "t" "https://github.com/a-jay85/IBL5-backlog/pull/1
bin/backlog:83 $LONG_TAIL"
reject "no file:line" "body needs a file:line location" \
    new ci "t" "$PR
bin/backlog has no location here. $LONG_TAIL"
reject "body at 100 chars or less" "body is too short" \
    new ci "t" "$PR
bin/backlog:83 empty body"

# Case 6: for-pr composes a startswith lookup
OUT="$("$SCRIPT" --dry-run for-pr "$PR" 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "for-pr exits 0" || fail "for-pr exits 0 (got $RC)"
want "for-pr: gh issue list" "$OUT" "gh issue list"
want "for-pr: repo flag" "$OUT" "--repo a-jay85/IBL5-backlog"
want "for-pr: open only" "$OUT" "--state open"
want "for-pr: json fields" "$OUT" "--json number,title,body"
want "for-pr: startswith filter" "$OUT" "startswith(\"$PR\")"
want "for-pr: --limit 1000" "$OUT" "--limit 1000"

# Case 7: for-pr argument rejection
reject "for-pr with no URL" "for-pr requires <pr-url>" for-pr
reject "for-pr with 2 args" "for-pr requires <pr-url>" for-pr "$PR" extra
reject "for-pr non-PR arg" "for-pr requires a PR URL" for-pr 1234
reject "for-pr URL with quote" "for-pr requires a PR URL" for-pr "$PR\""

# Case 8: --help documents the new surface
OUT="$("$SCRIPT" --help 2>&1)"
want "--help lists new body arg" "$OUT" "new <label> <title> <body>"
want "--help lists for-pr" "$OUT" "for-pr <pr-url>"

# Case 9: for-pr filter semantics against fixture JSON via a gh stub.
if command -v jq >/dev/null 2>&1; then
    STUB_DIR="$(mktemp -d)"
    cat > "$STUB_DIR/gh" <<'STUB'
#!/usr/bin/env bash
filter=""
while [ $# -gt 0 ]; do
    if [ "$1" = "--jq" ]; then filter="$2"; shift 2; else shift; fi
done
jq -r "$filter" <<'JSON'
[{"number":1,"title":"same pr","body":"https://github.com/a-jay85/IBL5/pull/1234\nbin/a.sh:1 x"},
 {"number":2,"title":"longer pr","body":"https://github.com/a-jay85/IBL5/pull/12345\nbin/b.sh:2 y"},
 {"number":3,"title":"mid-body url","body":"See https://github.com/a-jay85/IBL5/pull/1234\nbin/c.sh:3 z"},
 {"number":4,"title":"other pr","body":"https://github.com/a-jay85/IBL5/pull/99\nbin/d.sh:4 w"}]
JSON
STUB
    chmod +x "$STUB_DIR/gh"
    OUT="$(BACKLOG_GH="$STUB_DIR/gh" "$SCRIPT" for-pr "$PR" 2>&1)"; RC=$?
    [ "$RC" -eq 0 ] && ok "for-pr stub run exits 0" || fail "for-pr stub run exits 0 (got $RC)"
    want "for-pr lists the same-PR issue" "$OUT" "#1 same pr"
    for n in 2 3 4; do
        if grep -qF -- "#$n " <<< "$OUT"; then
            fail "for-pr excludes #$n"
        else
            ok "for-pr excludes #$n"
        fi
    done
else
    printf '[SKIP] Case 9 for-pr filter (jq not installed)\n'
fi

# Cases 10-14: the per-PR cap through `new`, against the stateful fake gh.
if command -v python3 >/dev/null 2>&1; then
    PR900='https://github.com/a-jay85/IBL5/pull/900'
    body_for() {
        printf '%s\n\nbin/backlog:144 failure scenario for item %s, padded so the body clears the one hundred character floor. unique-token-%s' \
            "$PR900" "$1" "$1"
    }
    store_count() { python3 -c 'import json,sys; print(len(json.load(open(sys.argv[1]))["issues"]))' "$FAKE_STORE"; }
    file_items() {
        local from="$1" to="$2" k rc=0
        for k in $(seq "$from" "$to"); do
            BACKLOG_GH="$FAKE_DIR/gh" "$SCRIPT" new maintenance "item $k" "$(body_for "$k")" >/dev/null 2>&1 || rc=$?
        done
        return "$rc"
    }

    # Case 10: n = 2, 3, 4, 8 leave min(n, 3) issues; extras live in one roll-up.
    for n in 2 3 4 8; do
        mkfake "case10-$n"
        file_items 1 "$n"
        want_count=$(( n < 3 ? n : 3 ))
        [ "$(store_count)" -eq "$want_count" ] \
            && ok "Case 10 n=$n leaves $want_count issues" \
            || fail "Case 10 n=$n leaves $want_count issues (got $(store_count))"
        if [ "$n" -gt 3 ]; then
            if python3 - "$FAKE_STORE" "$n" <<'PY'
import json, sys
issues = json.load(open(sys.argv[1]))["issues"]
n = int(sys.argv[2])
rollups = [i for i in issues if "<!-- followup-rollup -->" in i["body"]]
ok = len(rollups) == 1 and all(f"unique-token-{k}" in rollups[0]["body"] for k in range(3, n + 1))
sys.exit(0 if ok else 1)
PY
            then ok "Case 10 n=$n: one roll-up holds items 3..$n"
            else fail "Case 10 n=$n: one roll-up holds items 3..$n"; fi
        fi
    done

    # Case 11: re-filing the same 5 items adds nothing.
    mkfake case11
    file_items 1 5
    file_items 1 5; RC=$?
    [ "$RC" -eq 0 ] && ok "Case 11 retry calls exit 0" || fail "Case 11 retry calls exit 0 (got $RC)"
    [ "$(store_count)" -eq 3 ] && ok "Case 11 retry leaves 3 issues" || fail "Case 11 retry leaves 3 issues (got $(store_count))"
    LINES="$(python3 -c 'import json,re,sys
for i in json.load(open(sys.argv[1]))["issues"]:
    if "<!-- followup-rollup -->" in i["body"]:
        print(len(re.findall(r"^- \[ \] ", i["body"], re.M)))' "$FAKE_STORE")"
    [ "$LINES" = "3" ] && ok "Case 11 roll-up keeps 3 checklist lines" || fail "Case 11 roll-up keeps 3 checklist lines (got $LINES)"

    # Case 12: --dry-run new is a read-only decision probe.
    mkfake case12
    file_items 1 3
    cp "$FAKE_STORE" "$FAKE_DIR/before.json"
    OUT="$(BACKLOG_GH="$FAKE_DIR/gh" "$SCRIPT" --dry-run new maintenance "item 4" "$(body_for 4)" 2>&1)"; RC=$?
    [ "$RC" -eq 0 ] && ok "Case 12 dry-run exits 0" || fail "Case 12 dry-run exits 0 (got $RC)"
    if grep -qE '^would-convert	#3	item 4$' <<< "$OUT"; then
        ok "Case 12 dry-run prints would-convert #3"
    else
        fail "Case 12 dry-run prints would-convert #3 (got: $OUT)"
    fi
    cmp -s "$FAKE_STORE" "$FAKE_DIR/before.json" && ok "Case 12 store unchanged" || fail "Case 12 store unchanged"
    # The first 3 filings legitimately logged creates; only calls after the snapshot matter.
    if [ "$(grep -cE '"issue", "(create|edit|reopen)"' "$FAKE_STORE.log")" -eq 3 ]; then
        ok "Case 12 dry-run logged no write"
    else
        fail "Case 12 dry-run logged no write"
    fi

    # Case 13: a failing list read fails closed.
    mkfake case13 '{"issues": [], "fail_list": true}'
    OUT="$(BACKLOG_GH="$FAKE_DIR/gh" "$SCRIPT" new maintenance "item 1" "$(body_for 1)" 2>&1 >/dev/null)"; RC=$?
    [ "$RC" -eq 1 ] && ok "Case 13 read failure exits 1" || fail "Case 13 read failure exits 1 (got $RC)"
    want "Case 13 says nothing filed" "$OUT" "nothing filed"
    [ "$(store_count)" -eq 0 ] && ok "Case 13 files zero issues" || fail "Case 13 files zero issues"

    # Case 14: validation runs before any GitHub read.
    mkfake case14
    BACKLOG_GH="$FAKE_DIR/gh" "$SCRIPT" new maintenance "t" "$PR900
no location here, but long enough to clear the length floor on its own so only file:line fails the gate" >/dev/null 2>&1; RC=$?
    [ "$RC" -eq 2 ] && ok "Case 14 invalid body exits 2" || fail "Case 14 invalid body exits 2 (got $RC)"
    [ ! -e "$FAKE_STORE.log" ] && ok "Case 14 gh never ran" || fail "Case 14 gh never ran"
else
    printf '[SKIP] Cases 10-14 (python3 not installed)\n'
fi

echo ""
echo "Results: $PASS passed, $FAIL failed"
if [ "$FAIL" -gt 0 ]; then
    for f in "${FAILURES[@]}"; do printf '  FAIL: %s\n' "$f"; done
    exit 1
fi
exit 0
