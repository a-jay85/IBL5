#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * bin/check-docs — Living Documentation Principle enforcement.
 * Policy lives in .claude/rules/doc-freshness.md.
 */

const STALENESS_DAYS = 60;

const IN_SCOPE_GLOBS = [
    'CLAUDE.md',
    'README.md',
    '.claude/rules/*.md',
    '.claude/skills/*/SKILL.md',
    'ibl5/docs/*.md',
    'ibl5/docs/backlog/*.md',
    'ibl5/docs/decisions/*.md',
    'ibl5/classes/*/README.md',
    'engine/docs/backlog/*.md',
    'engine/.claude/rules/*.md',
];

const EXCLUDED_RELATIVE_FRAGMENTS = [
    '.archive/',
    'ibl5/docs/archive/',
    'worktrees/',
    'vendor/',
    'node_modules/',
];

const REFERENCE_PREFIXES = [
    'bin/',
    'ibl5/',
    '.claude/',
    '.github/',
    'docs/',
    'migrations/',
    'engine/docs/',
    'engine/.claude/',
];

// Non-markdown source trees whose *comment bodies* are also dead-ref-checked
// (checkSourceCommentReferences). Whole-tree only — never --since. Deliberately
// narrow: these are the trees where the 2026-07-27 audit found real rot.
const SOURCE_SCAN_GLOBS = [
    'bin/*',
    'bin/lib/*',
    'ibl5/classes',        // recursive: **/*.php
    'ibl5/phpstan-rules/*.php',
    'ibl5/migrations/*.php',
];

// Test harnesses deliberately contain non-resolving fixture paths.
// Scanning them would flag the fixtures themselves.
const SOURCE_SCAN_EXCLUDED_PREFIXES = [
    'bin/test-',
    'ibl5/tests/',
];

// Local-only paths referenced in source comments that never exist on clean checkout.
// Kept separate from REFERENCE_ALLOWLIST so that constant governs markdown only.
const SOURCE_SCAN_RUNTIME_ARTIFACTS = [
    'ibl5/vr-gallery.json',   // written by bin/vr-build-gallery at CI runtime
    'ibl5/backups',           // gitignored local data dir (~55 GB season zip files)
    'ibl5/bin/jsbsim',        // compiled native binary, gitignored
];

// Paths that are intentionally local-only, user-managed, or generated at runtime.
// Keep this list tiny — prefer fixing references over extending the allowlist.
const REFERENCE_ALLOWLIST = [
    '.claude/settings.json',
    '.claude/settings.local.json',
    'ibl5/themes/IBL/style/style.css',  // gitignored — compiled Tailwind build artifact (absent on clean CI checkout)
    'ibl5/vr-actuals',                  // gitignored — per-run PR render scratch dir (written at CI runtime, never committed)
    'ibl5/vr-gallery',                  // gitignored — per-run generated gallery scratch dir (written at CI runtime, never committed)
];

// Backlogs that mark items done with a table-cell glyph (e.g. `| C1 | … | ✅ |`)
// rather than a `**Status:** ✅ Implemented` body line. They keep resolved rows
// in place instead of archiving them, so the (c) done→archive invariant in
// checkBacklogTransitions() does not apply to them. Empirically (2026-07-10)
// both maintenance-backlog.md and a11y-backlog.md are pure table-status; only
// maintenance is listed here because the (c) check is anchored strictly to
// `**Status:**`-shaped lines, so a table-cell flip never trips it regardless —
// keeping the set minimal preserves the catch if a11y-backlog.md ever grows a
// real body `**Status:**` line without archiving.
const TABLE_STATUS_BACKLOGS = [
    'maintenance-backlog.md',
];

// Figures that a dated correction retired. The observed failure mode (PRs #1620,
// #1622, #1626) is a superseded number re-surfacing in a doc that the correction
// sweep missed — a string check, not judgment. Each entry fails the full scan when
// its pattern appears in a doc body with no correction marker nearby.
//
// Deliberately narrow. A figure only belongs here when its retired form is
// distinctive enough that a legitimate live use is implausible — "~100× smaller",
// for instance, was considered and REJECTED, because ADR-0094 uses that exact
// phrase for a different and still-correct comparison (ADR-0049's corpus-vs-seed
// ratio), so gating it would force stamping correct prose as if it were retired.
// Scope limit worth knowing: this catches the `pp`-suffixed prose form only. It
// would NOT have caught the #1622 miss, which lived in a JSON artifact field
// (`"guidance": "... 0.012 ..."`) outside the in-scope doc globs.
const RETIRED_FIGURES = [
    [
        'pattern' => '/0\.012[ ]*pp|0\.01189/i',
        'label'   => 'gate-1 engine seed SD 0.012pp',
        'why'     => 'ADR-0094 Phase 6 spaced seed blocks 1 apart while runs=4 consumes seed..seed+3, so the 8 readings were a sliding window over 11 draws; the sample SD is deflated ~x0.781',
        'use'     => 'use 0.016pp (de-overlapped Phase 6, all-era) or 0.021pp (matched recent-era, PR #1620) — see ibl5/docs/decisions/0094-gate1-ci-construction-audit.md § Addendum',
    ],
];

// A retired figure may be quoted legitimately inside its own correction. Any of
// these on the line, or within CORRECTION_WINDOW lines of it, exempts the hit.
// `⚠` is deliberately NOT a marker: it is a generic emphasis glyph, so accepting
// it would let an unrelated nearby warning silently exempt a genuinely stale
// figure — and a false negative in this gate is invisible.
const CORRECTION_MARKERS = [
    '[CORRECTED',
    '[SUPERSEDED',
    '**Superseded by:**',
    'RETIRED-OK',
];

const CORRECTION_WINDOW = 3;

// A heading whose text announces a correction scopes the exemption to its whole
// section — an Addendum discusses the retired figure throughout, and stamping
// every line of it would be noise.
const CORRECTION_HEADING_RE = '/^#{1,6}\s.*\b(addendum|correction|corrected|supersed)/i';

function usage(): string
{
    return <<<USAGE
Usage: bin/check-docs [options]

Enforces the Living Documentation policy defined in
.claude/rules/doc-freshness.md. Validates YAML frontmatter
(description, last_verified), staleness (60-day max),
dead repo-path references, and un-stamped citations of retired
figures on every in-scope markdown file. Full-scan mode additionally
checks non-markdown source-file comment bodies (bin/, bin/lib/,
ibl5/classes/, ibl5/phpstan-rules/, ibl5/migrations/) for dead
repo-path references; test harnesses are excluded and five named
false-positive suppressions apply (see checkSourceCommentReferences).
Mark an intentionally non-resolving path with a trailing "(example)".

Options:
  --fix-dates        Requires --since=<ref>. Bumps last_verified to today only
                     on docs whose body changed vs <ref> without a date bump —
                     exactly the files the on-touch check flags. Bumping every
                     doc is refused: it would falsely claim re-verification.
  --include-memory   Also scan Claude Code memory for this repo
                     (auto-derived from the main repo path; works from
                     worktrees). Off in CI.
  --since=<ref>      Changed-files (PR) mode: every in-scope .md whose body
                     changed vs <ref> must also bump last_verified. Each
                     changed file is also run through the full-scan checks
                     (future-date, staleness, dead-ref). Pure base-vs-head
                     value comparison — never date-equality-to-today.
  --no-staleness     Full-scan only: suppress the 60-day staleness rule while
                     still failing on frontmatter, future-date, dead-ref, and
                     ADR-transition issues. Used by the PR/push gate so an
                     untouched stale doc never blocks an unrelated change; the
                     nightly audit owns repo-wide staleness instead.
  --staleness-report Full-scan only: emit a JSON array of stale docs
                     ([{path, last_verified, age_days, days_over}]) and exit 0
                     regardless of whether any doc is stale. A report, not a
                     gate. Consumed by the doc-freshness-audit workflow.
  --self-test        Run the offline fixtures and exit — retired-figure
                     exemptions, plus the changed-doc diff union (in a throwaway
                     temp repo). Never scans this repo. Both cover logic whose
                     bug is a SILENT false negative; the loud failure modes are
                     left to the next PR.
  --verbose, -v      Show passing files too.
  --help, -h         Show this message.

Exit 0 on success, 1 on any validation failure, 2 on a usage error.

USAGE;
}

function repoRoot(): string
{
    $dir = __DIR__;
    while ($dir !== '/' && !is_dir($dir . '/.git') && !is_file($dir . '/.git')) {
        $dir = dirname($dir);
    }
    if ($dir === '/') {
        fwrite(STDERR, "error: could not locate repo root\n");
        exit(1);
    }
    return $dir;
}

/**
 * Derive Claude Code's memory dir for this repo. Works from worktrees by resolving
 * the main repo path (memory is keyed to the main repo, not per-worktree).
 * Returns null if HOME is unset or the slug cannot be built.
 */
function memoryDirForRepo(string $repoRoot): ?string
{
    $home = getenv('HOME');
    if (!is_string($home) || $home === '') {
        return null;
    }
    $mainRepo = $repoRoot;
    $gitMarker = $repoRoot . '/.git';
    if (is_file($gitMarker)) {
        $content = file_get_contents($gitMarker);
        if ($content !== false && preg_match('/gitdir:\s*(\S+)/', $content, $m) === 1) {
            // $m[1] is <main>/.git/worktrees/<name> — three dirnames back to <main>.
            $mainRepo = dirname($m[1], 3);
        }
    }
    $slug = '-' . str_replace('/', '-', ltrim($mainRepo, '/'));
    return $home . '/.claude/projects/' . $slug . '/memory';
}

/** @return list<string> */
function collectFiles(string $root, bool $includeMemory): array
{
    $files = [];
    foreach (IN_SCOPE_GLOBS as $glob) {
        $matches = glob($root . '/' . $glob);
        if ($matches === false) {
            continue;
        }
        foreach ($matches as $path) {
            $files[] = $path;
        }
    }
    if ($includeMemory) {
        $memory = memoryDirForRepo($root);
        if ($memory !== null && is_dir($memory)) {
            $matches = glob($memory . '/*.md');
            if ($matches !== false) {
                foreach ($matches as $path) {
                    $files[] = $path;
                }
            }
        }
    }
    $prefix = $root . '/';
    $filtered = array_filter($files, static function (string $path) use ($prefix): bool {
        $rel = str_starts_with($path, $prefix) ? substr($path, strlen($prefix)) : $path;
        foreach (EXCLUDED_RELATIVE_FRAGMENTS as $frag) {
            if (str_starts_with($rel, $frag)) {
                return false;
            }
        }
        return true;
    });
    return array_values($filtered);
}

/** @return array<string, string>|null */
function parseFrontmatter(string $content): ?array
{
    if (!str_starts_with($content, "---\n") && !str_starts_with($content, "---\r\n")) {
        return null;
    }
    $offset = str_starts_with($content, "---\r\n") ? 5 : 4;
    $end = strpos($content, "\n---", $offset);
    if ($end === false) {
        return null;
    }
    $yaml = substr($content, $offset, $end - $offset);
    $fields = [];
    foreach (preg_split('/\r?\n/', $yaml) ?: [] as $line) {
        if (preg_match('/^([a-zA-Z_][a-zA-Z0-9_]*):\s*(.*)$/', $line, $m) === 1) {
            $key = $m[1];
            $value = trim($m[2]);
            if (strlen($value) >= 2 && ($value[0] === '"' || $value[0] === "'") && $value[strlen($value) - 1] === $value[0]) {
                $value = substr($value, 1, -1);
            }
            $fields[$key] = $value;
        }
    }
    return $fields;
}

/**
 * Shared dead-reference resolution. Takes raw candidate tokens (however they
 * were extracted — markdown backtick spans, markdown links, or source-file
 * comment bodies) and returns the subset that is a repo path AND does not
 * resolve on disk.
 *
 * Extraction is the caller's job; resolution policy lives here so the
 * markdown scanner and the source-comment scanner can never disagree about
 * what "dead" means.
 *
 * @param list<string> $tokens
 * @return list<string>
 */
function resolveReferenceTokens(array $tokens, string $repoRoot): array
{
    $issues = [];
    foreach (array_unique($tokens) as $token) {
        $parts = preg_split('/[\s#?]/', $token, 2);
        $token = is_array($parts) && isset($parts[0]) ? $parts[0] : '';
        if ($token === '') {
            continue;
        }
        $isRepoPath = false;
        foreach (REFERENCE_PREFIXES as $prefix) {
            if (str_starts_with($token, $prefix)) {
                $isRepoPath = true;
                break;
            }
        }
        if (!$isRepoPath) {
            continue;
        }
        if (preg_match('/[\*\?\[\]\{\}<>]/', $token) === 1) {
            continue;
        }
        if (preg_match('/^[A-Za-z0-9._\/-]+$/', $token) !== 1) {
            continue;
        }
        if (in_array($token, REFERENCE_ALLOWLIST, true)) {
            continue;
        }
        $fullPath = $repoRoot . '/' . $token;
        if (file_exists($fullPath)) {
            continue;
        }
        // Local config pattern: gitignored local files whose template is tracked alongside them.
        // Accept both the project's trailing suffix convention (`config.php` → `config.php.example`,
        // `.env.test` → `.env.test.example`) and the middle-insertion variant
        // (`foo.bar.php` → `foo.bar.example.php`) that some projects prefer.
        if (file_exists($fullPath . '.example')) {
            continue;
        }
        $ext = pathinfo($fullPath, PATHINFO_EXTENSION);
        if ($ext !== '') {
            $dir = dirname($fullPath);
            $stem = pathinfo($fullPath, PATHINFO_FILENAME);
            if (file_exists($dir . '/' . $stem . '.example.' . $ext)) {
                continue;
            }
        }
        $issues[] = $token;
    }
    return array_values(array_unique($issues));
}

/** @return list<string> */
function scanReferences(string $content, string $repoRoot): array
{
    $tokens = [];

    if (preg_match_all('/\[[^\]]*\]\(([^)\s]+)\)/', $content, $m) > 0) {
        foreach ($m[1] as $target) {
            $tokens[] = $target;
        }
    }
    // Capture optional trailing (example) marker after closing backtick — signals intentional non-resolving path.
    if (preg_match_all('/`([^`\n]+)`(\s*\(example\))?/', $content, $m) > 0) {
        foreach ($m[1] as $i => $span) {
            if (isset($m[2][$i]) && $m[2][$i] !== '') {
                continue;
            }
            $tokens[] = $span;
        }
    }

    return resolveReferenceTokens($tokens, $repoRoot);
}

/**
 * Age in days of a valid, non-future, past ISO last_verified value.
 *
 * Returns null when the value is missing, not an ISO date, unparseable, or in
 * the future — those are the gate's job (checkFile emits them as failures) and
 * must never appear in the staleness report. Both the gate's staleness check
 * and the staleness report derive age from this single helper so they cannot
 * disagree about what "stale" means.
 */
function stalenessAgeDays(?string $lv, \DateTimeImmutable $today): ?int
{
    if ($lv === null || preg_match('/^\d{4}-\d{2}-\d{2}$/', $lv) !== 1) {
        return null;
    }
    $verified = \DateTimeImmutable::createFromFormat('!Y-m-d', $lv);
    if ($verified === false || $verified > $today) {
        return null;
    }
    return (int) $today->diff($verified)->days;
}

/** @return list<string> */
function checkFile(string $path, string $repoRoot, \DateTimeImmutable $today, bool $enforceStaleness = true): array
{
    if (!is_file($path)) {
        return ['broken symlink or missing file'];
    }
    $content = file_get_contents($path);
    if ($content === false) {
        return ['read error'];
    }
    $fm = parseFrontmatter($content);
    $issues = [];
    if ($fm === null) {
        return ['missing frontmatter block'];
    }
    if (!isset($fm['description']) || $fm['description'] === '') {
        $issues[] = 'missing or empty `description`';
    }
    if (!isset($fm['last_verified'])) {
        $issues[] = 'missing `last_verified`';
    } else {
        $lv = $fm['last_verified'];
        if (preg_match('/^\d{4}-\d{2}-\d{2}$/', $lv) !== 1) {
            $issues[] = sprintf('`last_verified` not ISO date: %s', $lv);
        } else {
            $verified = \DateTimeImmutable::createFromFormat('!Y-m-d', $lv);
            if ($verified === false) {
                $issues[] = sprintf('`last_verified` unparseable: %s', $lv);
            } elseif ($verified > $today) {
                $issues[] = sprintf('`last_verified` in the future: %s', $lv);
            } else {
                $diff = $today->diff($verified);
                $age = (int) $diff->days;
                if ($enforceStaleness && $age > STALENESS_DAYS) {
                    $issues[] = sprintf('stale: last_verified %s is %d days old (max %d)', $lv, $age, STALENESS_DAYS);
                }
            }
        }
    }

    foreach (scanReferences($content, $repoRoot) as $deadRef) {
        $issues[] = sprintf('dead reference: `%s`', $deadRef);
    }

    return $issues;
}

/**
 * Repo-wide staleness report: one entry per in-scope doc whose last_verified is
 * a valid past ISO date older than STALENESS_DAYS. Missing/invalid/future dates
 * are excluded — the gate (checkFile) owns those; the report only lists docs
 * that are genuinely stale. Pure read; never fails.
 *
 * @return list<array{path: string, last_verified: string, age_days: int, days_over: int}>
 */
function stalenessReport(string $repoRoot, \DateTimeImmutable $today): array
{
    $files = collectFiles($repoRoot, false);
    sort($files);

    $report = [];
    foreach ($files as $path) {
        if (!is_file($path)) {
            continue;
        }
        $content = file_get_contents($path);
        if ($content === false) {
            continue;
        }
        $fm = parseFrontmatter($content);
        if ($fm === null || !isset($fm['last_verified'])) {
            continue;
        }
        $lv = $fm['last_verified'];
        $age = stalenessAgeDays($lv, $today);
        if ($age === null || $age <= STALENESS_DAYS) {
            continue;
        }
        $report[] = [
            'path' => substr($path, strlen($repoRoot) + 1),
            'last_verified' => $lv,
            'age_days' => $age,
            'days_over' => $age - STALENESS_DAYS,
        ];
    }

    return $report;
}

/**
 * Repo-wide dead-`paths:`-glob findings, sourced from
 * `bin/check-rules-byte-budget --report-mode`. The per-PR gate stays
 * changeset-scoped; the repo-wide sweep belongs to this nightly report.
 *
 * Fail-quiet: a non-zero exit, empty output, or non-array JSON yields [] — a
 * broken sweep must never break the staleness report or the audit that consumes
 * it. Same contract as bin/docfix-poll's `health_report()` guard at :200.
 *
 * @return list<array{path: string, last_verified: string, age_days: int, days_over: int, reason: string, glob: string}>
 */
function deadGlobReport(string $repoRoot): array
{
    // cd into the repo first: the sweep resolves its own ROOT from
    // `git rev-parse --show-toplevel`, and check-docs is invoked from arbitrary
    // cwd (bin/docfix-poll calls it as "$MAIN/bin/check-docs").
    $cmd = sprintf(
        'cd %s && %s --report-mode 2>/dev/null',
        escapeshellarg($repoRoot),
        escapeshellarg($repoRoot . '/bin/check-rules-byte-budget')
    );
    $out = [];
    $code = 0;
    exec($cmd, $out, $code);
    if ($code !== 0) {
        return [];
    }
    $decoded = json_decode(implode("\n", $out), true);
    if (!is_array($decoded)) {
        return [];
    }

    $entries = [];
    foreach ($decoded as $item) {
        if (!is_array($item)
            || !isset($item['path'], $item['glob'])
            || !is_string($item['path'])
            || !is_string($item['glob'])
        ) {
            continue;   // malformed row: drop it, never emit a half-built entry
        }
        $entries[] = [
            'path' => $item['path'],
            'last_verified' => '',
            'age_days' => 0,
            'days_over' => 0,
            'reason' => 'dead-glob',
            'glob' => $item['glob'],
        ];
    }

    return $entries;
}

/**
 * Verify ADR bidirectional Supersedes / Superseded-by integrity.
 *
 * Forward: if ADR-X has `Status: Superseded by ADR-Y`, then ADR-Y must exist
 * and ADR-Y's `## Supersedes` section must reference ADR-X.
 *
 * Reverse: if ADR-Y's `## Supersedes` section references ADR-X, then ADR-X
 * must exist and ADR-X's `Status` line must say `Superseded by ADR-Y`.
 *
 * @return list<string> diagnostic lines, each naming the offending ADR path.
 */
function checkAdrTransitions(string $repoRoot): array
{
    $adrDir = $repoRoot . '/ibl5/docs/decisions';
    if (!is_dir($adrDir)) {
        return [];
    }
    $files = glob($adrDir . '/[0-9][0-9][0-9][0-9]-*.md') ?: [];
    if ($files === []) {
        return [];
    }

    $byNum = [];
    foreach ($files as $path) {
        if (!is_file($path)) {
            continue;
        }
        $base = basename($path);
        if (preg_match('/^(\d{4})-/', $base, $m) !== 1) {
            continue;
        }
        if ($m[1] === '0000') {
            continue;
        }
        $byNum[$m[1]] = $path;
    }

    $claims = [];
    foreach ($byNum as $num => $path) {
        $content = file_get_contents($path);
        if ($content === false) {
            continue;
        }
        $claim = ['supersededBy' => null, 'supersedes' => []];
        if (preg_match('/^\*\*Status:\*\*\s*Superseded by ADR-(\d{4})/m', $content, $m) === 1) {
            $claim['supersededBy'] = $m[1];
        }
        $section = '';
        if (preg_match('/^## Supersedes\s*\r?\n(.+?)^## /ms', $content, $m) === 1) {
            $section = $m[1];
        } elseif (preg_match('/^## Supersedes\s*\r?\n(.+)/ms', $content, $m) === 1) {
            $section = $m[1];
        }
        if ($section !== '' && preg_match_all('/ADR-(\d{4})/', $section, $mm) > 0) {
            $claim['supersedes'] = array_values(array_unique($mm[1]));
        }
        $claims[$num] = $claim;
    }

    $issues = [];
    foreach ($claims as $num => $claim) {
        $rel = substr($byNum[$num], strlen($repoRoot) + 1);
        if ($claim['supersededBy'] !== null) {
            $y = $claim['supersededBy'];
            if (!isset($byNum[$y])) {
                $issues[] = sprintf('%s: claims Superseded by ADR-%s, but ADR-%s does not exist', $rel, $y, $y);
            } else {
                $yClaim = $claims[$y] ?? ['supersedes' => []];
                if (!in_array($num, $yClaim['supersedes'], true)) {
                    $issues[] = sprintf(
                        "%s: claims Superseded by ADR-%s, but ADR-%s's ## Supersedes section does not reference ADR-%s",
                        $rel,
                        $y,
                        $y,
                        $num
                    );
                }
            }
        }
        foreach ($claim['supersedes'] as $y) {
            if (!isset($byNum[$y])) {
                $issues[] = sprintf('%s: ## Supersedes references ADR-%s, but it does not exist', $rel, $y);
                continue;
            }
            $yClaim = $claims[$y] ?? ['supersededBy' => null];
            if ($yClaim['supersededBy'] !== $num) {
                $issues[] = sprintf(
                    '%s: ## Supersedes references ADR-%s, but ADR-%s Status line does not say "Superseded by ADR-%s" (if ADR-%s is not genuinely superseded, rename the section to ## Lineage)',
                    $rel,
                    $y,
                    $y,
                    $num,
                    $y
                );
            }
        }
    }
    return $issues;
}

/** @param list<string> $files */
function fixDates(array $files, \DateTimeImmutable $today): int
{
    $updated = 0;
    $dateStr = $today->format('Y-m-d');
    foreach ($files as $path) {
        if (!is_file($path)) {
            continue;
        }
        $content = file_get_contents($path);
        if ($content === false) {
            continue;
        }
        if (preg_match('/^(---\r?\n)(.*?)(\r?\n---\r?\n)/s', $content, $m) !== 1) {
            continue;
        }
        $head = $m[1];
        $body = $m[2];
        $tail = $m[3];
        $rest = substr($content, strlen($m[0]));
        if (preg_match('/^last_verified:\s*.*$/m', $body) === 1) {
            $body = (string) preg_replace('/^last_verified:\s*.*$/m', 'last_verified: ' . $dateStr, $body);
        } else {
            $body .= "\nlast_verified: " . $dateStr;
        }
        file_put_contents($path, $head . $body . $tail . $rest);
        $updated++;
    }
    return $updated;
}

/**
 * Calendar date (Y-m-d) of the most recent commit in $base..HEAD that touched
 * $rel, in the **author's own timezone**. Read from the author timestamp (%aI,
 * ISO 8601 with embedded tz offset) so the date reflects the author's calendar
 * day, not the CI runner's (which is UTC and can be one day ahead for
 * late-evening commits made in a negative-offset timezone like PDT).
 *
 * Immutable per commit, so comparing last_verified against it is independent of
 * when CI runs: a same-day re-edit of a doc already verified today passes without
 * waiting for UTC rollover, and a PR spanning midnight never false-fails (the trap
 * equality-to-today would create). Read from the author timestamp, which a rebase
 * preserves — so the caller compares last_verified `>=` this date (freshness), not
 * `===` (which would false-fail a rebased doc whose author date predates a base
 * that already carries today's date). Returns null when the date can't be read, so
 * the caller falls back to the strict value comparison (fail-closed).
 */
function editCommitDate(string $repoRoot, string $base, string $rel): ?string
{
    $cmd = sprintf(
        'git -C %s log -1 --format=%%aI %s..HEAD -- %s 2>/dev/null',
        escapeshellarg($repoRoot),
        escapeshellarg($base),
        escapeshellarg($rel)
    );
    $out = [];
    $code = 0;
    exec($cmd, $out, $code);
    $iso = trim(implode('', $out));
    if ($code !== 0 || $iso === '') {
        return null;
    }

    try {
        // PHP parses the ISO 8601 string preserving the embedded tz offset, so
        // format('Y-m-d') returns the date in the author's timezone, not UTC.
        return (new \DateTimeImmutable($iso))->format('Y-m-d');
    } catch (\Exception $e) {
        return null;
    }
}

/**
 * Changed-files (PR) mode. For each in-scope .md that changed between $base and
 * HEAD, fail when its body changed but the parsed `last_verified` value did NOT
 * change (the On-Touch Rule), and additionally run the full-scan checkFile()
 * rules (future-date, staleness, dead-ref, missing frontmatter).
 *
 * The bump check compares the parsed frontmatter VALUE base-vs-head — never
 * date-equality-to-today — so a PR opened Monday and merged Wednesday does not
 * false-fail, and body text that literally contains `last_verified:` (e.g. inside
 * a code fence) cannot trip the check. One escape sits on top of the value
 * compare: when head and base values are EQUAL, the file still passes if that
 * value is `>=` the edit's commit date (editCommitDate) — a doc whose verification
 * is at least as fresh as the edit, which includes both a same-day re-edit (value
 * == commit date) and a rebased PR whose preserved author date now predates a base
 * that already carries today's date (value > commit date). The escape keys off the
 * immutable commit date, not the CI wall clock, so it does not reintroduce the
 * midnight false-fail; a strictly-newer value is only ever a future date, which
 * checkFile() rejects separately. Cases: body-changed-not-bumped fails (values
 * equal AND lv predates the edit), date-bumped passes (values differ), same-day
 * re-edit passes (value == commit date), rebased-onto-today passes (value > commit
 * date), newly-added-with-date passes (base null != date), added-without-date
 * fails (null === null, null !< commit date).
 *
 * @return list<string> diagnostic lines, each prefixed with the repo-relative path.
 */
function checkChanged(string $base, string $repoRoot, \DateTimeImmutable $today): array
{
    $issues = [];
    foreach (iterChangedDocs($base, $repoRoot) as $doc) {
        if ($doc['needsBump']) {
            $issues[] = sprintf(
                '%s: body changed but last_verified not bumped (still %s) — run `bin/check-docs --fix-dates --since=%s` (or bump last_verified to today manually) and commit',
                $doc['rel'],
                $doc['headLv'] ?? '(none)',
                $base
            );
        }

        foreach (checkFile($doc['abs'], $repoRoot, $today) as $fileIssue) {
            $issues[] = sprintf('%s: %s', $doc['rel'], $fileIssue);
        }
    }

    return $issues;
}

/**
 * Repo-relative `.md` paths changed vs $base, as the UNION of three git views:
 *
 *   1. `<base>...HEAD`  — committed on this branch (the merge-base diff CI sees)
 *   2. `HEAD`           — unstaged working-tree edits
 *   3. `--cached`       — staged-but-uncommitted edits
 *
 * View 1 alone is HEAD-anchored, and that was a silent false negative: a caller
 * that edits docs and then runs `--since` to check ITSELF before committing
 * (backlog-housekeep op 7, post-plan Phase 2.5) cannot see its own edits, so the
 * gate printed "On-touch doc check passed" four seconds before committing the
 * very edit CI then failed on (PR #1878, 2026-08-14). Views 2 and 3 close it.
 *
 * CI checks out a clean tree, so views 2 and 3 are empty there and CI behavior is
 * unchanged — this only adds signal to a dirty tree. The `*.md` pathspec keeps
 * unrelated build dirt (a lockfile, a compiled stylesheet) out of the union;
 * scoping to the in-scope doc set still happens in iterChangedDocs().
 *
 * Untracked files are deliberately NOT unioned in: a never-committed doc has no
 * base blob, so the on-touch predicate cannot fire on it, and the full scan
 * (which walks the tree) already checks its frontmatter.
 *
 * @return list<string> repo-relative paths, deduplicated, order not significant
 */
function changedDocPaths(string $base, string $escapedRoot, string $escapedBase): array
{
    $views = [
        sprintf('%s...HEAD', $escapedBase),
        'HEAD',
        '--cached',
    ];

    $union = [];
    foreach ($views as $view) {
        $cmd = sprintf(
            "git -C %s diff --name-only --diff-filter=AM %s -- '*.md' 2>/dev/null",
            $escapedRoot,
            $view
        );
        $out = [];
        $code = 0;
        exec($cmd, $out, $code);
        if ($code !== 0) {
            fwrite(STDERR, sprintf("check-docs: unable to diff '%s' against base ref '%s' (git exit %d). Is it a valid commit? In CI, ensure fetch-depth: 0.\n", $view, $base, $code));
            exit(2);
        }
        foreach ($out as $rel) {
            $rel = trim($rel);
            if ($rel !== '') {
                $union[] = $rel;
            }
        }
    }

    return array_values(array_unique($union));
}

/**
 * Enumerate in-scope docs changed between $base and HEAD, returning the
 * frontmatter facts both the on-touch check and --fix-dates consume. `needsBump`
 * is the SINGLE source of the On-Touch predicate: body changed vs base but
 * last_verified did not move past the edit's commit date. Both callers share
 * this enumeration (and its diff-view union) so the failing set and the
 * --fix-dates fixable set can never silently diverge.
 *
 * The changed set is the UNION of three views — see changedDocPaths().
 *
 * The freshness escape (`$verifiedAtEdit`): an unchanged date still passes when
 * it is `>=` the edit's git commit date — a verification at least as fresh as the
 * edit. Covers a same-day re-verify (== commit date) and a rebased PR whose
 * preserved author date now predates a base already carrying today's date
 * (> commit date). Keyed off the immutable commit date, not the CI wall clock, so
 * it does not reintroduce a midnight false-fail; a strictly-newer value can only
 * be a future date, which checkFile() rejects separately.
 *
 * @return list<array{rel: string, abs: string, headLv: ?string, baseLv: ?string, needsBump: bool}>
 */
function iterChangedDocs(string $base, string $repoRoot): array
{
    $escapedRoot = escapeshellarg($repoRoot);
    $escapedBase = escapeshellarg($base);

    $changedRel = changedDocPaths($base, $escapedRoot, $escapedBase);

    // Intersect with the in-scope set so scoping/exclusions are reused, not
    // re-implemented.
    $inScopeSet = [];
    foreach (collectFiles($repoRoot, false) as $abs) {
        $inScopeSet[$abs] = true;
    }

    $docs = [];
    foreach ($changedRel as $rel) {
        $rel = trim($rel);
        if ($rel === '') {
            continue;
        }
        $abs = $repoRoot . '/' . $rel;
        if (!isset($inScopeSet[$abs])) {
            continue;
        }

        $headContent = is_file($abs) ? file_get_contents($abs) : false;
        $headFm = $headContent !== false ? parseFrontmatter($headContent) : null;

        // Base blob: command fails when the file did not exist at $base (added)
        // => treat base frontmatter as null.
        $showCmd = sprintf('git -C %s show %s:%s 2>/dev/null', $escapedRoot, $escapedBase, escapeshellarg($rel));
        $baseOut = [];
        $baseCode = 0;
        exec($showCmd, $baseOut, $baseCode);
        $baseFm = $baseCode === 0 ? parseFrontmatter(implode("\n", $baseOut)) : null;

        $headLv = $headFm['last_verified'] ?? null;
        $baseLv = $baseFm['last_verified'] ?? null;
        $editDate = editCommitDate($repoRoot, $base, $rel);
        $verifiedAtEdit = $headLv !== null && $editDate !== null && $headLv >= $editDate;

        $docs[] = [
            'rel' => $rel,
            'abs' => $abs,
            'headLv' => $headLv,
            'baseLv' => $baseLv,
            'needsBump' => $headLv === $baseLv && !$verifiedAtEdit,
        ];
    }

    return $docs;
}

/**
 * Diff-scoped backlog archive-transition invariants (--since mode only).
 *
 * Body-status backlogs (docs/backlog/<x>-backlog.md) mark an item ✅ Implemented /
 * 🚫 Declined and archive the resolved body behind a dated `archive/…` pointer so the
 * LIVE file stays short. This enforces that pairing at PR time, ONLY on files the diff
 * actually changed — never a full-scan corpus migration. Three transition invariants:
 *
 *   (a) Every `archive/<x>-backlog-archive.md` link present in the head body must
 *       resolve to an existing file.
 *   (b) When the head body ADDS an archive pointer the base body lacked (a
 *       done→archived transition), the canonical sibling derived from the LIVE
 *       filename (archive/<stem>-backlog-archive.md) must exist. Derived from the
 *       filename, not the link text, so it also catches a pointer that links the
 *       wrong archive file.
 *   (c) Body-status backlogs only: when the diff ADDS a `**Status:** ✅ Implemented`
 *       / `🚫 Declined` line the base lacked, the same file must also add an archive
 *       pointer. Anchored to `**Status:**`-shaped lines, so a table-cell status flip
 *       (a11y style) never trips it. TABLE_STATUS_BACKLOGS files are exempt: a resolved
 *       row there is **removed** rather than status-flipped, and that removal is enforced
 *       separately and corpus-wide by checkMaintenanceResolved().
 *
 * README.md (the index) and archive/ files are out of scope for all three. Base-missing
 * (added) files read as an empty base body, matching iterChangedDocs' base-blob fetch.
 *
 * @return list<string>
 */
function checkBacklogTransitions(string $base, string $repoRoot): array
{
    $escapedRoot = escapeshellarg($repoRoot);
    $escapedBase = escapeshellarg($base);
    $archiveDir = 'ibl5/docs/backlog/archive/';
    $pointerRe = '/\]\(archive\/([A-Za-z0-9._-]+-backlog-archive\.md)\)/';
    $doneRe = '/^\s*\*\*Status[^*]*:\*\*\s*(?:✅ Implemented|🚫 Declined)/m';

    $issues = [];
    foreach (iterChangedDocs($base, $repoRoot) as $doc) {
        $rel = $doc['rel'];
        if (!str_starts_with($rel, 'ibl5/docs/backlog/')) {
            continue;
        }
        $name = basename($rel);
        // The index and archived history are out of scope — only LIVE item files.
        if ($name === 'README.md' || str_contains($rel, '/archive/') || !str_ends_with($name, '-backlog.md')) {
            continue;
        }

        $headBody = is_file($doc['abs']) ? (string) file_get_contents($doc['abs']) : '';
        // Base blob: fails when the file did not exist at $base (added) => empty base.
        $showCmd = sprintf('git -C %s show %s:%s 2>/dev/null', $escapedRoot, $escapedBase, escapeshellarg($rel));
        $baseOut = [];
        $baseCode = 0;
        exec($showCmd, $baseOut, $baseCode);
        $baseBody = $baseCode === 0 ? implode("\n", $baseOut) : '';

        $headPointers = preg_match_all($pointerRe, $headBody, $m) > 0 ? array_values(array_unique($m[1])) : [];
        $basePointers = preg_match_all($pointerRe, $baseBody, $m) > 0 ? array_values(array_unique($m[1])) : [];
        $newPointers = array_diff($headPointers, $basePointers);

        // (a) Every archive pointer in the head body must resolve.
        foreach ($headPointers as $ptr) {
            if (!is_file($repoRoot . '/' . $archiveDir . $ptr)) {
                $issues[] = sprintf(
                    '%s: archive pointer `archive/%s` does not resolve — %s%s is missing (commit the sibling archive file or fix the link)',
                    $rel,
                    $ptr,
                    $archiveDir,
                    $ptr
                );
            }
        }

        // (b) A newly-added pointer signals a done→archived transition; the canonical
        // sibling derived from the LIVE filename must exist.
        if ($newPointers !== []) {
            $canonical = substr($name, 0, -strlen('-backlog.md')) . '-backlog-archive.md';
            if (!is_file($repoRoot . '/' . $archiveDir . $canonical)) {
                $issues[] = sprintf(
                    '%s: archived an item but its canonical archive sibling %s%s is missing — create it (LIVE %s pairs with archive/%s)',
                    $rel,
                    $archiveDir,
                    $canonical,
                    $name,
                    $canonical
                );
            }
        }

        // (c) Body-status backlogs: a newly-added done Status line must be paired with a
        // newly-added archive pointer (move the body out, leave a dated pointer).
        if (!in_array($name, TABLE_STATUS_BACKLOGS, true)) {
            $headDone = preg_match_all($doneRe, $headBody, $m) > 0 ? $m[0] : [];
            $baseDone = preg_match_all($doneRe, $baseBody, $m) > 0 ? $m[0] : [];
            if (array_diff($headDone, $baseDone) !== [] && $newPointers === []) {
                $issues[] = sprintf(
                    '%s: item marked done inline (`**Status:** ✅ Implemented` / `🚫 Declined`) but no archive pointer added — move the resolved body into archive/%s-backlog-archive.md and replace the LIVE entry with a dated pointer',
                    $rel,
                    substr($name, 0, -strlen('-backlog.md'))
                );
            }
        }
    }

    return $issues;
}

/**
 * Line numbers (1-indexed) in $content where a retired figure appears without an
 * adjacent correction marker. Pure over the file body so --self-test can exercise
 * the exemption logic — the half of this check where a bug is silent.
 *
 * @return list<array{line: int, label: string, why: string, use: string, text: string}>
 */
function retiredFigureHits(string $content): array
{
    // Split on explicit newline sequences, NOT \R: outside UTF-8 mode \R also
    // matches the bare byte 0x85, which is a UTF-8 continuation byte in glyphs
    // these docs use heavily (`✅` is E2 9C 85) — that splits mid-character and
    // silently shifts every subsequent line number.
    $lines = preg_split("/\r\n|\n|\r/", $content);
    if ($lines === false) {
        return [];
    }

    // Frontmatter is a summary, not a claim site, and a bracketed stamp reads
    // badly in a `description:` value — exempt it wholesale.
    $bodyStart = 0;
    if (isset($lines[0]) && trim($lines[0]) === '---') {
        foreach ($lines as $i => $line) {
            if ($i > 0 && trim($line) === '---') {
                $bodyStart = $i + 1;
                break;
            }
        }
    }

    $hasMarker = static function (string $line): bool {
        foreach (CORRECTION_MARKERS as $marker) {
            if (str_contains($line, $marker)) {
                return true;
            }
        }
        return false;
    };

    $hits = [];
    $inCorrectionSection = false;
    foreach ($lines as $i => $line) {
        if ($i < $bodyStart) {
            continue;
        }
        if (preg_match('/^#{1,6}\s/', $line) === 1) {
            $inCorrectionSection = preg_match(CORRECTION_HEADING_RE, $line) === 1;
        }
        if ($inCorrectionSection) {
            continue;
        }
        foreach (RETIRED_FIGURES as $fig) {
            if (preg_match($fig['pattern'], $line) !== 1) {
                continue;
            }
            $exempt = false;
            $from = max($bodyStart, $i - CORRECTION_WINDOW);
            $to = min(count($lines) - 1, $i + CORRECTION_WINDOW);
            for ($j = $from; $j <= $to; $j++) {
                if ($hasMarker($lines[$j])) {
                    $exempt = true;
                    break;
                }
            }
            if ($exempt) {
                continue;
            }
            $hits[] = [
                'line'  => $i + 1,
                'label' => $fig['label'],
                'why'   => $fig['why'],
                'use'   => $fig['use'],
                'text'  => trim($line),
            ];
        }
    }
    return $hits;
}

/**
 * Non-markdown source files whose comment bodies are dead-ref-checked.
 *
 * @return list<string> absolute paths, sorted
 */
function collectSourceFiles(string $repoRoot): array
{
    $files = [];
    foreach (SOURCE_SCAN_GLOBS as $entry) {
        if (str_contains($entry, '*')) {
            $matches = glob($repoRoot . '/' . $entry);
            if ($matches !== false) {
                foreach ($matches as $path) {
                    if (is_file($path)) {
                        $files[] = $path;
                    }
                }
            }
        } else {
            $dir = $repoRoot . '/' . $entry;
            if (is_dir($dir)) {
                $iter = new \RecursiveIteratorIterator(
                    new \RecursiveDirectoryIterator($dir, \FilesystemIterator::SKIP_DOTS)
                );
                foreach ($iter as $fileInfo) {
                    if ($fileInfo->isFile() && $fileInfo->getExtension() === 'php') {
                        $files[] = $fileInfo->getPathname();
                    }
                }
            }
        }
    }

    $prefix = $repoRoot . '/';
    $files = array_filter($files, static function (string $path) use ($prefix, $repoRoot): bool {
        $rel = str_starts_with($path, $prefix) ? substr($path, strlen($prefix)) : $path;
        foreach (SOURCE_SCAN_EXCLUDED_PREFIXES as $excl) {
            if (str_starts_with($rel, $excl)) {
                return false;
            }
        }
        foreach (EXCLUDED_RELATIVE_FRAGMENTS as $frag) {
            if (str_starts_with($rel, $frag)) {
                return false;
            }
        }
        // Type sniff
        $head = @file_get_contents($path, false, null, 0, 512);
        if ($head === false) {
            return false;
        }
        $ext = pathinfo($path, PATHINFO_EXTENSION);
        return str_starts_with($head, '<?php')
            || str_starts_with($head, '#!')
            || $ext === 'php'
            || $ext === 'sh';
    });

    $files = array_values($files);
    sort($files);
    return $files;
}

/**
 * Candidate repo-path tokens from every comment line in a source file.
 *
 * @return list<array{token: string, line: int, text: string}>
 */
function sourceCommentTokens(string $content, bool $isPhp): array
{
    $lines = explode("\n", $content);
    $results = [];
    $phpPattern = '/^\s*(?:\/\/|#|\/\*+|\*)\s?(.*)/';
    $nonPhpPattern = '/^\s*(?:#|\/\/)\s?(.*)/';
    $pattern = $isPhp ? $phpPattern : $nonPhpPattern;
    // Lookbehind excludes word chars + hyphen + slash to reject compound words like storage-engine/config
    $tokenPattern = '#(?<![A-Za-z0-9/_-])(?:bin|ibl5|\.claude|\.github|docs|migrations|engine)/[A-Za-z0-9._/*?\[\]{}<>-]+#';

    foreach ($lines as $idx => $line) {
        if (preg_match($pattern, $line, $m) !== 1) {
            continue;
        }
        $body = $m[1];
        if (preg_match_all($tokenPattern, $body, $tm) > 0) {
            foreach ($tm[0] as $token) {
                $results[] = ['token' => $token, 'line' => $idx + 1, 'text' => $line];
            }
        }
    }
    return $results;
}

/**
 * @param list<string> $files absolute paths, as returned by collectFiles()
 * @return list<string>
 */
function checkRetiredFigures(array $files, string $repoRoot): array
{
    $issues = [];
    foreach ($files as $path) {
        $content = @file_get_contents($path);
        if ($content === false) {
            continue;
        }
        $rel = str_starts_with($path, $repoRoot . '/') ? substr($path, strlen($repoRoot) + 1) : $path;
        foreach (retiredFigureHits($content) as $hit) {
            $issues[] = sprintf(
                "%s:%d cites retired figure (%s) with no correction marker within %d lines — %s. Fix: %s. If the mention is deliberate (quoting the old claim), stamp the line with [CORRECTED …], [SUPERSEDED …], or RETIRED-OK.\n         > %s",
                $rel,
                $hit['line'],
                $hit['label'],
                CORRECTION_WINDOW,
                $hit['why'],
                $hit['use'],
                $hit['text']
            );
        }
    }
    return $issues;
}

/**
 * Dead repo-path references inside non-markdown source-file comment bodies.
 *
 * Peer of checkRetiredFigures(): corpus-wide, full-scan only, never --since.
 * Extraction is sourceCommentTokens(); resolution is the SAME
 * resolveReferenceTokens() the markdown scanner uses.
 *
 * Between the two sit five NAMED false-positive suppressions.
 *
 * @return list<string>
 */
function checkSourceCommentReferences(string $repoRoot): array
{
    $issues = [];
    foreach (collectSourceFiles($repoRoot) as $path) {
        $content = @file_get_contents($path);
        if ($content === false) {
            continue;
        }
        $rel = str_starts_with($path, $repoRoot . '/') ? substr($path, strlen($repoRoot) + 1) : $path;
        $head = substr($content, 0, 512);
        $isPhp = str_starts_with($head, '<?php') || pathinfo($path, PATHINFO_EXTENSION) === 'php';

        $surviving = [];
        foreach (sourceCommentTokens($content, $isPhp) as $entry) {
            $tok = $entry['token'];
            $lno = $entry['line'];
            $line = $entry['text'];

            // suppressTrailingPunctuation — normalize before glob-char test
            $tok = rtrim($tok, '.,:;)]}>');

            // (example) escape hatch, matching markdown's `path` (example) shape: the
            // normalized token, any run of closing delimiters the prose wraps it in
            // (backtick, quote, bracket, punctuation), then the marker.
            if (preg_match('/' . preg_quote($tok, '/') . '[.,:;)\]}>\'"`]*\s*\(example\)/', $line) === 1) {
                continue;
            }

            // suppressDirectoryToken — trailing slash signals a category mention
            if (str_ends_with($tok, '/')) {
                continue;
            }

            // suppressAdrSlugPlaceholder — N-run in numeric slug or literal -x.md stand-in
            if (preg_match('/(^|\/)[0-9]*N+[0-9N]*-/', $tok) === 1) {
                continue;
            }
            if (preg_match('/(^|\/)\d{4}-x\.md$/', $tok) === 1) {
                continue;
            }

            // suppressRuntimeArtifact — CI-generated paths never committed
            if (in_array($tok, SOURCE_SCAN_RUNTIME_ARTIFACTS, true)) {
                continue;
            }

            $surviving[] = ['token' => $tok, 'line' => $lno, 'text' => $line];
        }

        if ($surviving === []) {
            continue;
        }

        $rawTokens = array_map(fn($e) => $e['token'], $surviving);
        $dead = resolveReferenceTokens($rawTokens, $repoRoot);

        if ($dead === []) {
            continue;
        }

        $deadSet = array_flip($dead);

        foreach ($surviving as $entry) {
            $tok = $entry['token'];
            if (!isset($deadSet[$tok])) {
                continue;
            }

            // suppressIbl5BinAmbiguity — bin/<x> that resolves at ibl5/bin/<x>
            if (str_starts_with($tok, 'bin/') && file_exists($repoRoot . '/ibl5/' . $tok)) {
                continue;
            }

            $issues[] = sprintf(
                "%s:%d dead reference in comment: `%s`\n         > %s",
                $rel,
                $entry['line'],
                $tok,
                trim($entry['text'])
            );
        }
    }
    return $issues;
}

/**
 * Exercise retiredFigureHits()'s exemption logic. Only the exemption half is
 * fixture-tested: a wrong *pattern* fails loudly on the next PR, but a wrong
 * *exemption* is a silent false negative that nothing else surfaces.
 */
function selfTestRetiredFigures(): int
{
    $cases = [
        ['bare figure flags', "# Doc\n\nSeed SD was 0.012pp across 8 seeds.\n", 1],
        ['population-SD form flags', "# Doc\n\nThe ADR quoted 0.01189 here.\n", 1],
        ['same-line CORRECTED exempts', "# Doc\n\nSeed SD 0.012pp [CORRECTED 2026-07-24 — see § Addendum].\n", 0],
        ['same-line SUPERSEDED exempts', "# Doc\n\n[SUPERSEDED 2026-07-24] Seed SD 0.012pp across 8 seeds.\n", 0],
        ['RETIRED-OK exempts', "# Doc\n\nSeed SD 0.012pp <!-- RETIRED-OK: quoted deliberately -->\n", 0],
        ['Superseded by: field exempts', "# Doc\n\n**Superseded by:** #1622 — overlap\n\nSeed SD 0.012pp.\n", 0],
        ['marker 3 lines above exempts', "# Doc\n\n[CORRECTED 2026-07-24]\n\n\nSeed SD 0.012pp.\n", 0],
        ['marker 4 lines above does not exempt', "# Doc\n\n[CORRECTED 2026-07-24]\n\n\n\nSeed SD 0.012pp.\n", 1],
        ['marker 3 lines below exempts', "# Doc\n\nSeed SD 0.012pp.\n\n\n[CORRECTED 2026-07-24]\n", 0],
        ['Addendum heading scopes its section', "# Doc\n\n## Addendum (2026-07-24): SD 0.012pp -> 0.016pp\n\nThe 0.012pp figure came from overlapping blocks.\n", 0],
        ['section scope ends at next heading', "# Doc\n\n## Addendum (2026-07-24)\n\nfine\n\n## Phase 6\n\nSeed SD 0.012pp across 8 seeds.\n", 1],
        ['frontmatter is exempt', "---\ndescription: corrects seed SD 0.012pp to 0.016pp\nlast_verified: 2026-07-24\n---\n\n# Doc\n", 0],
        ['frontmatter exemption does not leak into body', "---\ndescription: a doc\nlast_verified: 2026-07-24\n---\n\nSeed SD 0.012pp.\n", 1],
        ['unrelated nearby figure does not flag', "# Doc\n\nSeed SD 0.0125pp and 0.021pp are fine.\n", 0],
        ['warning glyph alone does not exempt', "# Doc\n\n⚠ heads up\n\nSeed SD 0.012pp across 8 seeds.\n", 1],
        // Regression guard: \R would split inside `✅` (E2 9C 85) and shift the
        // line number, so this asserts the reported line, not just the count.
        ['multi-byte glyphs do not shift line numbers', "# Doc\n\n✅ done ✅\n\nSeed SD 0.012pp.\n", 1, 5],
    ];

    $failed = 0;
    foreach ($cases as $case) {
        [$name, $body, $want] = $case;
        $wantLine = $case[3] ?? null;
        $hits = retiredFigureHits($body);
        $got = count($hits);
        if ($got !== $want) {
            echo "FAIL {$name}: want {$want} hit(s), got {$got}\n";
            $failed++;
            continue;
        }
        if ($wantLine !== null && $hits[0]['line'] !== $wantLine) {
            echo "FAIL {$name}: want hit on line {$wantLine}, got line {$hits[0]['line']}\n";
            $failed++;
            continue;
        }
        echo "ok   {$name}\n";
    }
    $total = count($cases);
    if ($failed === 0) {
        echo "\nretired-figure exemption self-test: {$total} case(s) passed.\n";
        return 0;
    }
    echo "\nretired-figure exemption self-test: {$failed}/{$total} case(s) FAILED.\n";
    return 1;
}

/**
 * Fixtures for changedDocPaths()' three-view union, in a throwaway git repo under
 * sys_get_temp_dir() (never this repo). Peer of selfTestRetiredFigures() and here
 * for the same reason: a union that silently drops a view fails OPEN — the gate
 * prints "passed" on a doc it never looked at, which is exactly how PR #1878
 * merged a stale last_verified. A wrong view is invisible without a fixture.
 */
function selfTestChangedDocPaths(): int
{
    $tmp = sys_get_temp_dir() . '/check-docs-selftest-' . getmypid();
    $q = escapeshellarg($tmp);
    exec(sprintf('rm -rf %s && mkdir -p %s', $q, $q));

    // Base commit: one committed doc. -c flags keep the fixture independent of
    // the machine's git identity and of init.defaultBranch.
    $git = sprintf('git -C %s -c user.email=t@t -c user.name=t -c commit.gpgsign=false', $q);
    exec(sprintf('git init -q %s 2>/dev/null', $q));
    file_put_contents($tmp . '/base.md', "# base\n");
    exec(sprintf('%s add -A && %s commit -qm base 2>/dev/null', $git, $git));
    $baseSha = trim((string) shell_exec(sprintf('%s rev-parse HEAD 2>/dev/null', $git)));

    $cases = [];

    // View 1 — committed on the branch vs base.
    file_put_contents($tmp . '/committed.md', "# committed\n");
    exec(sprintf('%s add -A && %s commit -qm second 2>/dev/null', $git, $git));
    $cases[] = ['view 1: committed vs base', 'committed.md'];

    // View 3 — staged, not committed.
    file_put_contents($tmp . '/staged.md', "# staged\n");
    exec(sprintf('%s add staged.md 2>/dev/null', $git));
    $cases[] = ['view 3: staged, uncommitted', 'staged.md'];

    // View 2 — modified in the working tree, never staged. This is the view whose
    // absence caused PR #1878.
    file_put_contents($tmp . '/base.md', "# base\n\nedited\n");
    $cases[] = ['view 2: unstaged working-tree edit', 'base.md'];

    $got = changedDocPaths($baseSha, $q, escapeshellarg($baseSha));

    $failed = 0;
    foreach ($cases as [$name, $want]) {
        if (in_array($want, $got, true)) {
            echo "ok   {$name}\n";
            continue;
        }
        echo "FAIL {$name}: '{$want}' missing from union [" . implode(', ', $got) . "]\n";
        $failed++;
    }

    // Negative: a non-.md dirty file must not enter the union (keeps build dirt
    // and lockfiles out, so CI's clean-tree behavior stays byte-identical).
    file_put_contents($tmp . '/notes.txt', "dirty\n");
    $withNoise = changedDocPaths($baseSha, $q, escapeshellarg($baseSha));
    if (in_array('notes.txt', $withNoise, true)) {
        echo "FAIL pathspec: non-.md file leaked into the union\n";
        $failed++;
    } else {
        echo "ok   pathspec: non-.md dirt excluded\n";
    }

    // Dedup: a file both staged AND further edited unstaged appears once.
    file_put_contents($tmp . '/staged.md', "# staged\n\nfurther\n");
    $dupes = array_count_values(changedDocPaths($baseSha, $q, escapeshellarg($baseSha)));
    if (($dupes['staged.md'] ?? 0) !== 1) {
        echo "FAIL dedup: 'staged.md' appears " . ($dupes['staged.md'] ?? 0) . " time(s), want 1\n";
        $failed++;
    } else {
        echo "ok   dedup: file in two views listed once\n";
    }

    exec(sprintf('rm -rf %s', $q));

    $total = count($cases) + 2;
    if ($failed === 0) {
        echo "\nchanged-doc union self-test: {$total} case(s) passed.\n";
        return 0;
    }
    echo "\nchanged-doc union self-test: {$failed}/{$total} case(s) FAILED.\n";
    return 1;
}

/**
 * Resolved (✅/🚫) findings must not remain as rows in a per-axis table — they collapse
 * to the axis's `> ✅ resolved (N): …` summary line with evidence moved to the sibling
 * archive (ibl5/docs/backlog/README.md § Archiving an item).
 *
 * Reads the one LIVE table-status backlog directly rather than the changed-file set: a
 * resolved row that slipped in on an untouched commit is exactly the miss this catches.
 *
 * @return list<string>
 */
function checkMaintenanceResolved(string $repoRoot): array
{
    $rel = 'ibl5/docs/backlog/maintenance-backlog.md';
    $abs = $repoRoot . '/' . $rel;
    if (!is_file($abs)) {
        return [];
    }
    $body = (string) file_get_contents($abs);
    $n = preg_match_all('/^\|\s*\d+\.\d+\s*\|\s*(?:✅|🚫)/mu', $body);

    return $n > 0 ? [sprintf(
        '%s: %d resolved (✅/🚫) table row(s) found — collapse to per-axis summary lines and move evidence to archive/ (README.md § Archive)',
        $rel,
        $n
    )] : [];
}

// --- main ---

$opts = ['fix_dates' => false, 'include_memory' => false, 'verbose' => false, 'since' => null, 'no_staleness' => false, 'staleness_report' => false];
foreach (array_slice($argv, 1) as $arg) {
    if (str_starts_with($arg, '--since=')) {
        $opts['since'] = substr($arg, strlen('--since='));
        if (trim($opts['since']) === '') {
            fwrite(STDERR, "check-docs: --since= requires a base ref (e.g. --since=master or --since=<sha>)\n");
            fwrite(STDERR, usage());
            exit(2);
        }
        continue;
    }
    switch ($arg) {
        case '--fix-dates':
            $opts['fix_dates'] = true;
            break;
        case '--include-memory':
            $opts['include_memory'] = true;
            break;
        case '--verbose':
        case '-v':
            $opts['verbose'] = true;
            break;
        case '--no-staleness':
            $opts['no_staleness'] = true;
            break;
        case '--staleness-report':
            $opts['staleness_report'] = true;
            break;
        case '--self-test':
            // Run both suites unconditionally (no short-circuit) so one failure
            // never hides the other's result.
            $rc = selfTestRetiredFigures();
            echo "\n";
            exit(max($rc, selfTestChangedDocPaths()));
        case '--help':
        case '-h':
            echo usage();
            exit(0);
        default:
            fwrite(STDERR, "unknown flag: {$arg}\n");
            fwrite(STDERR, usage());
            exit(2);
    }
}

$root = repoRoot();
$today = new \DateTimeImmutable('today');

// Report mode short-circuits: emit the stale-doc and dead-glob list as JSON and exit 0
// regardless of whether any doc is stale. It is a report, not a gate — the
// nightly audit workflow decides what to do with the list.
if ($opts['staleness_report']) {
    // Two finding kinds share one report: date staleness and dead paths: globs.
    // `reason` is additive — every existing consumer reads only .path, length,
    // .age_days, .days_over (bin/docfix-poll uncovered_count/health_report,
    // the audit workflow's jq), so the extra key breaks nothing.
    $stale = array_map(
        static fn (array $e): array => $e + ['reason' => 'stale'],
        stalenessReport($root, $today)
    );
    $report = array_merge($stale, deadGlobReport($root));
    echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES), "\n";
    exit(0);
}

if ($opts['since'] !== null) {
    // --fix-dates is scoped to the changed-but-unbumped set (the exact files
    // the on-touch check flags), never the whole tree — bumping an unchanged
    // doc's date is a false re-verification claim.
    if ($opts['fix_dates']) {
        $toFix = [];
        foreach (iterChangedDocs($opts['since'], $root) as $doc) {
            if ($doc['needsBump']) {
                $toFix[] = $doc['abs'];
            }
        }
        $n = fixDates($toFix, $today);
        echo "bumped last_verified on {$n} changed-but-unbumped file(s) vs {$opts['since']}\n";
        exit(0);
    }

    $issues = checkChanged($opts['since'], $root, $today);
    // Diff-scoped backlog archive-transition invariants — --since mode only, never
    // full-scan (avoids forcing a corpus migration of pre-existing backlog history).
    $issues = array_merge($issues, checkBacklogTransitions($opts['since'], $root));
    if ($issues === []) {
        echo "On-touch doc check passed (changed files vs {$opts['since']}).\n";
        exit(0);
    }
    echo "On-touch doc check FAILED:\n";
    foreach ($issues as $issue) {
        echo "     - {$issue}\n";
    }
    echo "\n" . count($issues) . " issue(s) in changed docs.\n";
    exit(1);
}

if ($opts['fix_dates']) {
    fwrite(STDERR, "check-docs: --fix-dates requires --since=<ref> so it bumps only docs whose body changed vs that ref. Bumping every doc would falsely claim re-verification.\n");
    fwrite(STDERR, usage());
    exit(2);
}

$files = collectFiles($root, $opts['include_memory']);
sort($files);

$failures = 0;
$passed = 0;
foreach ($files as $path) {
    $rel = substr($path, strlen($root) + 1);
    $issues = checkFile($path, $root, $today, !$opts['no_staleness']);
    if ($issues === []) {
        $passed++;
        if ($opts['verbose']) {
            echo "ok   {$rel}\n";
        }
        continue;
    }
    $failures++;
    echo "FAIL {$rel}\n";
    foreach ($issues as $i) {
        echo "     - {$i}\n";
    }
}

// Corpus-wide, not --since-scoped: a retired figure sitting in a doc nobody
// touched is exactly the miss this exists to catch.
$retiredIssues = checkRetiredFigures($files, $root);
if ($retiredIssues !== []) {
    echo "FAIL retired-figure citations\n";
    foreach ($retiredIssues as $issue) {
        echo "     - {$issue}\n";
    }
    $failures++;
}

// Source-file comment bodies, corpus-wide. Full-scan only, deliberately not in
// the --since branch above: source files carry no frontmatter, so they never
// participate in the on-touch bump rule, and a rotted reference in a file this
// PR did not touch is exactly the miss this exists to catch.
$sourceRefIssues = checkSourceCommentReferences($root);
if ($sourceRefIssues !== []) {
    echo "FAIL dead references in source comments\n";
    foreach ($sourceRefIssues as $issue) {
        echo "     - {$issue}\n";
    }
    $failures++;
}

$maintenanceIssues = checkMaintenanceResolved($root);
if ($maintenanceIssues !== []) {
    echo "FAIL maintenance-backlog resolved rows\n";
    foreach ($maintenanceIssues as $issue) {
        echo "     - {$issue}\n";
    }
    $failures++;
}

$transitionIssues = checkAdrTransitions($root);
if ($transitionIssues !== []) {
    echo "FAIL ADR transition integrity\n";
    foreach ($transitionIssues as $issue) {
        echo "     - {$issue}\n";
    }
    $failures++;
}

$total = count($files);
if ($failures === 0) {
    echo "\n{$total} docs verified.\n";
    exit(0);
}

echo "\n{$failures} failure(s) across {$total} docs plus ADR transitions.\n";
exit(1);
