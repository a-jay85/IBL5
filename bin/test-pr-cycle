# ==========================================================================================
# Helpers for Fix 3/4 harness fixtures
# ==========================================================================================
# harness_verdict_comment: build a verdict sticky body in the harness format.
#   $1 = reviewed diff (40-hex patch-id recorded in the body)
#   $2 = verdict line (default "**READY**")
harness_verdict_comment() {
    local diff="$1" line="${2:-**READY**}"
    cat <<HVC_EOF
**LATEST VERDICT:** see below

\`covers head e583673dbf0a · master ffb6d1995a95 · written 2026-09-07T22:30Z\`

### Rebase
onto master, no conflicts.

**Reviewed diff:** $diff

$line

<!-- pr-ready-verdict -->
HVC_EOF
}

# harness_verdict_comment_details: the post-PR sticky shape (audit trail in <details> after `---`).
#   $1 = reviewed diff, $2 = terminal verdict line (default "READY")
harness_verdict_comment_details() {
    local diff="$1" line="${2:-READY}"
    cat <<HVCD_EOF
**READY** · auto-merge armed

Findings: none.

### Merge digest
**What changed:** x
**Why:** y
**Watch:** z
**Touches:** w
**Machine-authored fixes:** none

---

<details><summary>Audit trail</summary>

REVIEW-COVERAGE: CURRENT
**Reviewed tree:** aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
**Reviewed diff:** $diff
**Plan hash:** eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee

</details>

$line
<!-- pr-ready-verdict -->
HVCD_EOF
}

# install_harness_verdict: stage harness-format sticky for PR $1.
#   $2 = diff sha in comment
#   $3 = actual patch-id (patchid fixture, default equal to $2)
#   $4 = verdict line (default "**READY**")
install_harness_verdict() {
    local n="$1" cdiff="$2" adiff="${3:-$2}" line="${4:-**READY**}" shape="${5:-legacy}" body oid
    oid="deadbeefcafe$(printf '%028d' "$n")"
    if [[ "$shape" == details ]]; then body="$(harness_verdict_comment_details "$cdiff" "$line")"; else body="$(harness_verdict_comment "$cdiff" "$line")"; fi
    printf '{"comments":[{"body":%s}],"headRefOid":"%s"}' \
        "$(printf '%s' "$body" | jq -Rs .)" "$oid" > "$SCRATCH/verdictview-$n.json"
    # patchid fixture
    printf '%s\n' "$adiff" > "$SCRATCH/patchid-$n.txt"
    # tree fixture (not used by harness path but avoids a gh exit-4)
    printf '%s\n' "$TREE_A" > "$SCRATCH/tree-$oid"
}

# install_harness_result: write a harness result.json for PR $1 under harness-out/.
#   $2 = branch name
#   $3 = terminal status  (default: shipped-held)
#   $4 = blocked conditions CSV (e.g. "3" or "3,7")
#   $5 = mergeStateStatus for armed-state (default: CLEAN)
install_harness_result() {
    local n="$1" branch="$2" terminal="${3:-shipped-held}" \
          conds="${4:-3}" mss="${5:-CLEAN}"
    local ts="20260901-120000-99999"
    local dir="$SCRATCH/harness-out/live-$branch-$ts"
    mkdir -p "$dir"
    # Build conditions JSON array
    local cjson="[]"
    if [[ -n "$conds" ]]; then
        cjson="["
        local first=1
        local IFS=","
        for c in $conds; do
            [[ $first -eq 0 ]] && cjson+=","
            cjson+="{\"number\":$c,\"blocked\":true}"
            first=0
        done
        cjson+="]"
    fi
    printf '{"terminal":"%s","pr_number":%d,"arm":{"conditions":%s}}\n' \
        "$terminal" "$n" "$cjson" > "$dir/result.json"
    # Populate armed-state.json entry for this PR (mergeStateStatus from $5)
    local entry
    entry="$(printf '[{"number":%d,"headRefName":"%s","autoMergeRequest":null,"mergeStateStatus":"%s"}]' \
        "$n" "$branch" "$mss")"
    printf '%s\n' "$entry" > "$SCRATCH/armed-state.json"
}

