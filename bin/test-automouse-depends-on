#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-automouse-depends-on — contract test for the depends_on: plan
# frontmatter key. Pins the three-state verdict of plan_depends_on_status
# (bin/lib/plan-depends-on) and the hold/heal behaviour it drives in
# bin/automouse/run and bin/automouse/self-heal.
#
# The bug class this exists to prevent: a dependency the runner cannot
# EVALUATE being silently treated as SATISFIED, so a plan runs against an
# unmerged prerequisite.
#
# Run: bin/test-automouse-depends-on  (exit 0 = all pass, 1 = any case failed)

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/usage-test-isolation.sh"; usage_test_isolate "$TMP/usage"
FAILED=0

# ── Assertion helpers ─────────────────────────────────────────────────────────

ok()   { echo "ok: $1"; }
fail() { echo "FAIL: $1"; FAILED=1; }

assert_eq() {
    local desc="$1" got="$2" expected="$3"
    if [ "$got" = "$expected" ]; then ok "$desc"
    else fail "$desc — expected [$expected], got [$got]"; fi
}

# Clause 2: every secondary token named in a row label must have a want call.
want() {
    local desc="$1" haystack="$2" needle="$3"
    case "$haystack" in
        *"$needle"*) ok "$desc" ;;
        *)           fail "$desc — missing token [$needle] in: $haystack" ;;
    esac
}

assert_present() {
    local desc="$1" path="$2"
    if [ -e "$path" ] || [ -L "$path" ]; then ok "$desc"
    else fail "$desc — missing: $path"; fi
}

assert_absent() {
    local desc="$1" path="$2"
    if [ -e "$path" ] || [ -L "$path" ]; then fail "$desc — unexpected: $path"
    else ok "$desc"; fi
}

# Portable mtime: date -r FILE +%s works on both GNU date (Linux) and BSD date (macOS).
mtime_of() {
    date -r "$1" +%s
}

# ── Fixture builders ──────────────────────────────────────────────────────────

setup() {
    rm -rf "$TMP/automouse" "$TMP/plans" "$TMP/stub"
    mkdir -p "$TMP/automouse/queue" "$TMP/automouse/skipped" "$TMP/automouse/done" \
             "$TMP/plans" "$TMP/stub"
    make_gh fail
}

write_plan() {
    local name="$1"; shift
    { echo '---'; echo 'impl_model: sonnet'; printf '%s\n' "$@"; echo '---'; echo "# $name"; } \
        > "$TMP/plans/$name.md"
    ln -s "$TMP/plans/$name.md" "$TMP/automouse/queue/$name.md"
}

mark_done() {
    : > "$TMP/plans/$1.md"
    ln -sfn "$TMP/plans/$1.md" "$TMP/automouse/done/$1.md"
}

# make_gh <mode> — mode: merged | open | closed | none | fail
# Answers both `pr view` (PR-number deps) and `pr list` (slug deps). gh applies
# --jq itself, so the stub prints the post-jq value. `none` prints nothing (no
# PR for the branch). Every invocation's argv is appended to $TMP/stub/gh.args.
make_gh() {
    local mode="$1"
    mkdir -p "$TMP/stub"
    cat > "$TMP/stub/gh" <<STUB
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "$TMP/stub/gh.args"
case "\$*" in
  *"pr view"*|*"pr list"*)
      case "$mode" in
        merged) echo MERGED ;;
        open)   echo OPEN ;;
        closed) echo CLOSED ;;
        none)   : ;;
        fail)   echo "gh: could not authenticate" >&2; exit 1 ;;
      esac ;;
  *) exit 1 ;;
esac
STUB
    chmod +x "$TMP/stub/gh"
}

# evaluate <plan-name> → prints the verdict (subshell: no residue in caller)
evaluate() {
    # shellcheck disable=SC2030
    ( PATH="$TMP/stub:$PATH"
      NIGHTLY_DIR="$TMP/automouse"
      export PATH NIGHTLY_DIR
      # shellcheck source=/dev/null
      . "$REPO_ROOT/bin/lib/plan-depends-on"
      plan_depends_on_status "$TMP/automouse/queue/$1.md" )
}

# ── Section 1: Helper-contract cases (portable, no macOS-only tooling) ────────

echo "# Section 1: helper-contract cases"

# Case 1 — no depends_on: key → met
setup
write_plan "p1"
assert_eq "case 1: no key → met" "$(evaluate p1)" "met"

# Case 2 — slug dep in done/ + PR MERGED → met
setup; mark_done alpha; make_gh merged
write_plan "p2" "depends_on: alpha"
assert_eq "case 2: slug in done/ + PR MERGED → met" "$(evaluate p2)" "met"
ARGS2="$(cat "$TMP/stub/gh.args" 2>/dev/null)"
want "case 2: slug dep queries gh pr list" "$ARGS2" "pr list"
want "case 2: slug is used as the branch name" "$ARGS2" "--head alpha"
want "case 2: query spans all PR states" "$ARGS2" "--state all"

# Case 3 — slug dep not in done/
setup
write_plan "p3" "depends_on: alpha"
GOT3="$(evaluate p3)"
assert_eq "case 3: slug dep unmet" "$GOT3" "unmet:alpha"
want "case 3 verdict names the blocking dependency" "$GOT3" "alpha"

# Case 4 — PR dep, gh says MERGED
setup; make_gh merged
write_plan "p4" "depends_on: 2077"
assert_eq "case 4: PR dep MERGED → met" "$(evaluate p4)" "met"

# Case 5 — PR dep, gh says OPEN
setup; make_gh open
write_plan "p5" "depends_on: 2077"
assert_eq "case 5: PR dep OPEN → unmet" "$(evaluate p5)" "unmet:2077"

# Case 6 — PR dep, gh fails (auth error)
setup; make_gh fail
write_plan "p6" "depends_on: 2077"
GOT6="$(evaluate p6)"
assert_eq "case 6: gh failure → unresolvable:gh-error" "$GOT6" "unresolvable:2077:gh-error"
want "case 6 verdict names the closed reason vocabulary" "$GOT6" "gh-error"

# Case 7 — list, first dep met, second unmet (first-unmet-wins)
setup; mark_done alpha; make_gh merged
write_plan "p7" "depends_on:" "  - alpha" "  - beta"
GOT7="$(evaluate p7)"
assert_eq "case 7: list, first unmet wins" "$GOT7" "unmet:beta"
want "case 7 verdict names the FIRST unmet dep, not the last" "$GOT7" "beta"

# Case 8 — list, both deps met
setup; mark_done alpha; mark_done beta; make_gh merged
write_plan "p8" "depends_on:" "  - alpha" "  - beta"
assert_eq "case 8: list, all met" "$(evaluate p8)" "met"

# Case 9 — PR dep, gh says CLOSED → unmet (not met)
setup; make_gh closed
write_plan "p9" "depends_on: 2077"
assert_eq "case 9: PR dep CLOSED → unmet" "$(evaluate p9)" "unmet:2077"

# Case 10 — depends_on: present but empty → unresolvable:empty-value
setup
write_plan "p10" "depends_on:"
assert_eq "case 10: empty key → unresolvable:empty-value" \
    "$(evaluate p10)" "unresolvable:<none>:empty-value"

# Case 11 — path-traversal value → unresolvable:bad-value
setup
write_plan "p11" "depends_on: ../../etc/passwd"
assert_eq "case 11: path-traversal → unresolvable:bad-value" \
    "$(evaluate p11)" "unresolvable:../../etc/passwd:bad-value"

# Case 12 — no key: fast path must not invoke gh at all
setup
# The marker path is expanded HERE (unquoted heredoc delimiter) so the stub and the
# assertion agree on it. A quoted delimiter defers "$$" to the stub's own PID, which
# never equals the harness PID — the negative assertion could then never fail.
MARKER="$TMP/gh-called-marker"
rm -f "$MARKER"
cat > "$TMP/stub/gh" <<STUB
#!/usr/bin/env bash
touch "$MARKER"
exit 1
STUB
chmod +x "$TMP/stub/gh"

# Positive control: the SAME recipe against a plan that DOES declare a PR dep must
# reach the stub. Without it, a stub unreachable from inside plan_depends_on_status
# would make the negative assertion below pass vacuously — the same class of
# unfalsifiable green this case was written to rule out.
write_plan "p12ctl" "depends_on: 2099"
# shellcheck disable=SC2030,SC2031
( PATH="$TMP/stub:$PATH"
  NIGHTLY_DIR="$TMP/automouse"
  export PATH NIGHTLY_DIR
  # shellcheck source=/dev/null
  . "$REPO_ROOT/bin/lib/plan-depends-on"
  plan_depends_on_status "$TMP/automouse/queue/p12ctl.md" ) > /dev/null
assert_present "case 12 control: stub gh IS reached when a PR dep is declared" "$MARKER"
rm -f "$MARKER"

write_plan "p12"  # no depends_on: key
# shellcheck disable=SC2031
( PATH="$TMP/stub:$PATH"
  NIGHTLY_DIR="$TMP/automouse"
  export PATH NIGHTLY_DIR
  # shellcheck source=/dev/null
  . "$REPO_ROOT/bin/lib/plan-depends-on"
  plan_depends_on_status "$TMP/automouse/queue/p12.md" ) > /dev/null
assert_absent "case 12: no key → gh never called (byte-identical fast path)" "$MARKER"

# Case 13 — dangling queue symlink (plan file deleted): must answer unresolvable, not met
# This is the reachable production path: bin/automouse/queue/ stores every entry
# as a symlink into ~/claude-plans; deleting or renaming the plan file strands
# the link. An unreadable plan file is not evidence the dependency is met.
setup
write_plan "p13" "depends_on: alpha"
rm "$TMP/plans/p13.md"  # strand the queue symlink
GOT13="$(evaluate p13)"
assert_eq "case 13: dangling symlink → unresolvable (not met)" \
    "$GOT13" "unresolvable:<none>:unreadable-plan"
want "case 13 verdict names the unreadable-plan reason" "$GOT13" "unreadable-plan"

# Case 14 — slug in done/, PR still OPEN → unmet (a done/ file alone is not a merge)
setup; mark_done alpha; make_gh open
write_plan "p14" "depends_on: alpha"
assert_eq "case 14: slug in done/ + PR OPEN → unmet" "$(evaluate p14)" "unmet:alpha"

# Case 15 — slug in done/, PR CLOSED without merge → unresolvable (needs a human)
setup; mark_done alpha; make_gh closed
write_plan "p15" "depends_on: alpha"
GOT15="$(evaluate p15)"
assert_eq "case 15: slug in done/ + PR CLOSED → unresolvable:closed-unmerged" \
    "$GOT15" "unresolvable:alpha:closed-unmerged"
want "case 15 verdict names the closed-unmerged reason" "$GOT15" "closed-unmerged"

# Case 16 — slug in done/, no PR for the branch → unresolvable
setup; mark_done alpha; make_gh none
write_plan "p16" "depends_on: alpha"
GOT16="$(evaluate p16)"
assert_eq "case 16: slug in done/ + no PR → unresolvable:no-pr" \
    "$GOT16" "unresolvable:alpha:no-pr"
want "case 16 verdict names the no-pr reason" "$GOT16" "no-pr"

# Case 17 — slug in done/, gh fails → unresolvable:gh-error, never met
setup; mark_done alpha; make_gh fail
write_plan "p17" "depends_on: alpha"
GOT17="$(evaluate p17)"
assert_eq "case 17: slug in done/ + gh failure → unresolvable:gh-error" \
    "$GOT17" "unresolvable:alpha:gh-error"
want "case 17 verdict names the gh-error reason" "$GOT17" "gh-error"

# Case 18 — slug NOT in done/: unmet without any gh call (done/ check runs first)
setup; make_gh merged
write_plan "p18" "depends_on: alpha"
assert_eq "case 18: slug absent from done/ → unmet even if gh would say MERGED" \
    "$(evaluate p18)" "unmet:alpha"
assert_absent "case 18: gh never called when slug is absent from done/" \
    "$TMP/stub/gh.args"

# ── check-plan gate: depends_on: is inert to existing frontmatter validation ──

echo ""
echo "# Section 1b: bin/check-plan compatibility (V10/V11)"

FIXTURE_WITH="$TMP/check-plan-with.md"
FIXTURE_WITHOUT="$TMP/check-plan-without.md"
# Fixtures use impl_model: opus (no sonnet-recipe check) and no auto_merge: false
# (no hold-justification section required). The matrix header must be
# '| # | What to verify | ...' (check-plan gate [1]).
{
    echo '---'
    echo 'impl_model: opus'
    echo 'depends_on: some-slug'
    echo '---'
    echo '# Fixture plan'
    echo ''
    echo '## Phase 1: do a thing'
    echo ''
    echo '**Tier:** Opus (novel reasoning).'
    echo ''
    echo '### Verification — Phase 1'
    echo ''
    echo '| # | What to verify | Test type | Timing | Location |'
    echo '|---|----------------|-----------|--------|----------|'
    echo '| V1 | the thing works | Truly-manual | post-impl | human |'
} > "$FIXTURE_WITH"
{
    echo '---'
    echo 'impl_model: opus'
    echo '---'
    echo '# Fixture plan'
    echo ''
    echo '## Phase 1: do a thing'
    echo ''
    echo '**Tier:** Opus (novel reasoning).'
    echo ''
    echo '### Verification — Phase 1'
    echo ''
    echo '| # | What to verify | Test type | Timing | Location |'
    echo '|---|----------------|-----------|--------|----------|'
    echo '| V1 | the thing works | Truly-manual | post-impl | human |'
} > "$FIXTURE_WITHOUT"

RC_WITH=0
RC_WITHOUT=0
"$REPO_ROOT/bin/check-plan" "$FIXTURE_WITH" >/dev/null 2>&1 || RC_WITH=$?
"$REPO_ROOT/bin/check-plan" "$FIXTURE_WITHOUT" >/dev/null 2>&1 || RC_WITHOUT=$?

if [ "$RC_WITH" -eq 0 ]; then
    ok "H9: check-plan exits 0 with depends_on: key (V10)"
else
    fail "H9: check-plan exits $RC_WITH with depends_on: key (V10)"
fi
if [ "$RC_WITH" -eq "$RC_WITHOUT" ]; then
    ok "H10: check-plan exit code identical with/without depends_on: (V11)"
else
    fail "H10: check-plan exit codes differ: with=$RC_WITH without=$RC_WITHOUT (V11)"
fi

# ── Section 3: self-heal cases (portable) ─────────────────────────────────────
# Phase 6 §6.1 requires these cases to run outside the macOS guard so that the
# Linux CI step exercises the release side of the mechanism. V9 uses mtime_of()
# (BSD/GNU portable) rather than BSD-only stat -f %m directly.

echo ""
echo "# Section 3: self-heal cases"

SELF_HEAL="$REPO_ROOT/bin/automouse/self-heal"
# Never let these runs sweep orphan watchers: the default knobs match any
# reparented bin/automouse/run, including bin/test-automouse-self-heal's
# fixtures when the CI runner runs both tests in parallel.
export AUTOMOUSE_ORPHAN_ARGV_RE='^no-orphan-sweep-in-this-test$'

heal_setup() {
    rm -rf "$TMP/heal"
    mkdir -p "$TMP/heal/queue" "$TMP/heal/skipped" "$TMP/heal/done" \
             "$TMP/heal/reports" "$TMP/heal/plans"
}

write_heal_plan() {
    local name="$1"; shift
    { echo '---'; echo 'impl_model: sonnet'; printf '%s\n' "$@"; echo '---'; echo "# $name"; } \
        > "$TMP/heal/plans/$name.md"
    ln -sf "$TMP/heal/plans/$name.md" "$TMP/heal/queue/$name.md"
}

mark_heal_done() {
    : > "$TMP/heal/plans/$1.md"
    ln -sfn "$TMP/heal/plans/$1.md" "$TMP/heal/done/$1.md"
}

# V6 — self-heal clears a .depends-hold once dep is met, even when skipped/ is empty
heal_setup
write_heal_plan "hp6" "depends_on: prereq6"
mark_heal_done prereq6
HOLD6="$TMP/heal/queue/hp6.md.depends-hold"
echo "unmet:prereq6" > "$HOLD6"
make_gh merged
GH="$TMP/stub/gh" NIGHTLY_DIR="$TMP/heal" bash "$SELF_HEAL" > /dev/null 2>&1
assert_absent "V6: self-heal clears hold when dep is met" "$HOLD6"

# V7 — self-heal leaves hold intact while dep is still unmet
heal_setup
write_heal_plan "hp7" "depends_on: prereq7"
HOLD7="$TMP/heal/queue/hp7.md.depends-hold"
echo "unmet:prereq7" > "$HOLD7"
NIGHTLY_DIR="$TMP/heal" bash "$SELF_HEAL" > /dev/null 2>&1
assert_present "V7: self-heal leaves hold when dep still unmet" "$HOLD7"

# V7b — dep in done/ but PR still OPEN: hold stays (unmet arm is a silent no-op)
heal_setup
write_heal_plan "hp7b" "depends_on: prereq7b"
mark_heal_done prereq7b
make_gh open
HOLD7B="$TMP/heal/queue/hp7b.md.depends-hold"
echo "unmet:prereq7b" > "$HOLD7B"
GH="$TMP/stub/gh" NIGHTLY_DIR="$TMP/heal" bash "$SELF_HEAL" > /dev/null 2>&1
assert_present "V7b: self-heal keeps hold when dep is in done/ but PR is OPEN" "$HOLD7B"

# V7c — dep in done/ but PR CLOSED unmerged: hold stays (unresolvable arm never clears)
heal_setup
write_heal_plan "hp7c" "depends_on: prereq7c"
mark_heal_done prereq7c
make_gh closed
HOLD7C="$TMP/heal/queue/hp7c.md.depends-hold"
echo "unmet:prereq7c" > "$HOLD7C"
GH="$TMP/stub/gh" NIGHTLY_DIR="$TMP/heal" bash "$SELF_HEAL" > /dev/null 2>&1
assert_present "V7c: self-heal keeps hold when dep PR is CLOSED unmerged" "$HOLD7C"

# V8 — orphan sidecar (no matching plan) is reaped
heal_setup
HOLD8="$TMP/heal/queue/gone.md.depends-hold"
echo "unmet:some-dep" > "$HOLD8"
NIGHTLY_DIR="$TMP/heal" bash "$SELF_HEAL" > /dev/null 2>&1
assert_absent "V8: orphan sidecar reaped" "$HOLD8"

# V9 — plan mtime preserved across heal
heal_setup
write_heal_plan "hp9" "depends_on: prereq9"
mark_heal_done prereq9
HOLD9="$TMP/heal/queue/hp9.md.depends-hold"
echo "unmet:prereq9" > "$HOLD9"
PLAN9_LINK="$TMP/heal/queue/hp9.md"
make_gh merged
MTIME_BEFORE=$(mtime_of "$PLAN9_LINK")
sleep 1
GH="$TMP/stub/gh" NIGHTLY_DIR="$TMP/heal" bash "$SELF_HEAL" > /dev/null 2>&1
MTIME_AFTER=$(mtime_of "$PLAN9_LINK")
if [ "$MTIME_BEFORE" -eq "$MTIME_AFTER" ]; then
    ok "V9: plan mtime preserved across heal (queue order unchanged)"
else
    fail "V9: plan mtime changed — queue order may have shifted (before=$MTIME_BEFORE after=$MTIME_AFTER)"
fi

# ── Section 2: run-loop hold cases (macOS-only — require caffeinate/BSD stat) ─

if [ "$(uname)" != "Darwin" ]; then
    echo ""
    echo "# Section 2: skipping macOS-only run-loop cases (uname=$(uname))"
    echo "SKIP: run-loop cases skipped on non-Darwin"
    echo ""
    echo "# Results: $FAILED failed"
    exit "$FAILED"
fi

echo ""
echo "# Section 2: run-loop hold cases (macOS-only)"

# ── Runner isolation recipe (from bin/test-automouse-concurrency) ─────────────
# Three load-bearing details (documented in Phase 4 §4.1):
#   1. REPO= is rewritten so the runner cd's to the worktree, not the main checkout,
#      and therefore calls bin/lib/plan-depends-on from the code under test.
#   2. export PATH= is rewritten so the claude stub is found before any real claude.
#   3. NIGHTLY_DIR= is rewritten so all sidecar writes land in the temp tree.

E2_ROOT="$TMP/e2"
E2_NDIR="$E2_ROOT/automouse"
E2_PLANS="$E2_ROOT/plans"
E2_STUB="$E2_ROOT/stub"
E2_WORKTREE="$E2_ROOT/worktree"  # real dir written into the handoff so postplan finds it
mkdir -p "$E2_NDIR/queue" "$E2_NDIR/handoff" "$E2_NDIR/logs" \
         "$E2_NDIR/reports" "$E2_NDIR/done" "$E2_NDIR/skipped" \
         "$E2_PLANS" "$E2_STUB" "$E2_WORKTREE"

# The runner locates prompt-impl via SELF_DIR (the dir containing the runner
# file) and calls "$SELF_DIR/../post-plan-now" for postplan. The runner lives
# in $E2_NDIR, so the post-plan-now stub goes in $E2_ROOT.
ln -sf "$REPO_ROOT/bin/automouse/prompt-impl" "$E2_NDIR/prompt-impl"
# The runner also sources $SELF_DIR/lib-queue-order (queue_entries_ordered).
ln -sf "$REPO_ROOT/bin/automouse/lib-queue-order" "$E2_NDIR/lib-queue-order"

# Rewritten runner: REPO→worktree, NIGHTLY_DIR→temp, PATH→stub first
E2_RUNNER="$E2_NDIR/run"
sed \
    -e "s#^NIGHTLY_DIR=.*#NIGHTLY_DIR=\"$E2_NDIR\"#" \
    -e "s#^REPO=.*#REPO=\"$REPO_ROOT\"#" \
    -e "s#^export PATH=.*#export PATH=\"$E2_STUB:/usr/local/bin:/opt/homebrew/bin:\$PATH\"#" \
    "$REPO_ROOT/bin/automouse/run" > "$E2_RUNNER"
chmod +x "$E2_RUNNER"

# TRACE file: the claude stub appends plan names here so tests can assert "never reached impl"
E2_TRACE="$E2_ROOT/trace"

# Claude stub: impl phase only. PLAN_FILE=<plan> is embedded in the prompt text
# passed as the -p arg; grep it out. Writes the handoff with a real worktree path
# so the runner hands postplan to the post-plan-now stub below.
cat > "$E2_STUB/claude" <<CLAUDE
#!/usr/bin/env bash
set -u
NDIR="$E2_NDIR"
TRACE="$E2_TRACE"
WORKTREE="$E2_WORKTREE"
plan="\$(printf '%s\n' "\$*" | grep -oE 'PLAN_FILE=[^[:space:]]+' | tail -1 | cut -d= -f2)"
if [ -n "\$plan" ]; then
    mkdir -p "\$NDIR/handoff"
    printf '{"slug":"stub","worktree":"%s","branch":"stub","plan_file":"%s","plan_title":"stub","completed_at":"2026-01-01T00:00:00Z"}\n' \
        "\$WORKTREE" "\$plan" > "\$NDIR/handoff/\$plan.json"
    printf '%s impl\n' "\$plan" >> "\$TRACE"
fi
printf '{"type":"result","subtype":"success","stop_reason":"end_turn","num_turns":1,"duration_ms":100,"total_cost_usd":0.001,"usage":{"input_tokens":1,"output_tokens":1}}\n'
exit 0
CLAUDE
chmod +x "$E2_STUB/claude"

# post-plan-now stub. Mode comes from $E2_ROOT/pp.mode (reset to "success" by
# reset_e2). success: moves the queue symlink to done/, removes the handoff,
# exits 0. fail: touches nothing in queue/ or handoff/, records a
# "<plan> postplan-fail" trace line, exits 1 with output that matches no
# environmental-error signature, so only the runner's own logic decides the path.
cat > "$E2_ROOT/post-plan-now" <<PPSTUB
#!/usr/bin/env bash
set -u
NDIR="$E2_NDIR"
TRACE="$E2_TRACE"
MODE_FILE="$E2_ROOT/pp.mode"
plan=""
while [ "\$#" -gt 0 ]; do
    case "\$1" in
        --plan) plan=\$(basename "\${2:-}"); shift 2 ;;
        *)      shift ;;
    esac
done
mode=\$(cat "\$MODE_FILE" 2>/dev/null || echo success)
if [ "\$mode" = "fail" ]; then
    [ -n "\$plan" ] && printf '%s postplan-fail\n' "\$plan" >> "\$TRACE"
    printf 'post-plan stub: simulated plan failure\n'
    printf 'RESULT: failure\n'
    exit 1
fi
if [ -n "\$plan" ]; then
    for e in "\$NDIR/queue/\$plan" "\$NDIR"/queue/[0-9][0-9][0-9]-"\$plan"; do mv "\$e" "\$NDIR/done/\$plan" 2>/dev/null || true; done
    rm -f "\$NDIR/handoff/\$plan.json" "\$NDIR/queue/\$plan.attempts" 2>/dev/null || true
    printf '%s postplan\n' "\$plan" >> "\$TRACE"
fi
printf 'RESULT: success\n'
exit 0
PPSTUB
chmod +x "$E2_ROOT/post-plan-now"

# gh stub for bin/lib/plan-depends-on only (reached via GH=, not PATH).
# Prints the contents of $E2_ROOT/gh.mode for `pr list`; the runner never reads $GH.
E2_GH="$E2_ROOT/gh"
cat > "$E2_GH" <<GHSTUB
#!/usr/bin/env bash
case "\$*" in
  *"pr list"*) cat "$E2_ROOT/gh.mode" 2>/dev/null ;;
  *) exit 1 ;;
esac
GHSTUB
chmod +x "$E2_GH"
echo MERGED > "$E2_ROOT/gh.mode"
echo success > "$E2_ROOT/pp.mode"

write_e2_plan() {
    local name="$1"; shift
    { echo '---'; echo 'impl_model: sonnet'; printf '%s\n' "$@"; echo '---'; echo "# $name"; } \
        > "$E2_PLANS/$name.md"
    ln -sf "$E2_PLANS/$name.md" "$E2_NDIR/queue/$name.md"
}

mark_e2_done() {
    : > "$E2_PLANS/$1.md"
    ln -sfn "$E2_PLANS/$1.md" "$E2_NDIR/done/$1.md"
}

reset_e2() {
    rm -f "$E2_NDIR/queue"/*.md "$E2_NDIR/queue"/*.lock "$E2_NDIR/queue"/*.attempts \
          "$E2_NDIR/queue"/*.depends-hold "$E2_NDIR/handoff"/*.json \
          "$E2_NDIR/done"/*.md "$E2_TRACE"
    : > "$E2_TRACE"
    echo MERGED > "$E2_ROOT/gh.mode"
    echo success > "$E2_ROOT/pp.mode"
}

# reset_e2_clean: reset_e2 plus empty logs/, reports/, and skipped/. Used only by
# the post-plan failure cases (P1-P2). reset_e2 keeps every earlier runner log
# and report, and e2_logtxt reads all of today's logs, so a negative assertion
# ("no env-stop report", "no Environmental failure line") would otherwise see a
# previous case's files. V1-V5 keep calling plain reset_e2, unchanged.
reset_e2_clean() {
    reset_e2
    rm -f "$E2_NDIR/logs"/*.log "$E2_NDIR/reports"/*.md "$E2_NDIR/skipped"/*.md \
          "$E2_NDIR/skipped"/*.attempts 2>/dev/null || true
}

run_e2() {  # run exactly one iteration; each caller pre-loads exactly one plan in queue
    GH="$E2_GH" NIGHTLY_DIR="$E2_NDIR" PLANS_DIR="$E2_PLANS" CLAUDE_HEADLESS=1 \
    CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 \
    timeout 30 "$E2_RUNNER" 2>&1 || true
}

# bin/automouse/run writes one logs/<date>-<pid>.log per process, and each
# run_e2 call is a new process, so read today's per-runner logs together.
e2_logtxt() { cat "$E2_NDIR/logs/$(date +%Y-%m-%d)"-*.log 2>/dev/null || true; }

# V14 baseline: existing concurrency harness is green before any run edits
echo "# V14 baseline: running bin/test-automouse-concurrency"
if "$REPO_ROOT/bin/test-automouse-concurrency" >/dev/null 2>&1; then
    ok "V14: bin/test-automouse-concurrency baseline green"
else
    echo "# V14 WARN: bin/test-automouse-concurrency baseline FAILED — pre-existing drift (runner lacks prompt-impl at SELF_DIR); not counted as a failure here"
fi

# V1 — plan with no depends_on: drains normally (moved to done/, no .depends-hold)
reset_e2
write_e2_plan "nodep"
run_e2 > /dev/null 2>&1
assert_present "V1: no-key plan → moved to done/" "$E2_NDIR/done/nodep.md"
assert_absent  "V1: no-key plan → no .depends-hold written" \
    "$E2_NDIR/queue/nodep.md.depends-hold"

# qentry <queue-dir> <slug> - the NNN-<slug>.md entry path. The runner's
# normalize_queue prefixes the bare entries the fixtures create, so "still
# queued" asserts resolve through this. No entry prints a path that cannot exist.
qentry() {
    local f
    for f in "$1"/[0-9][0-9][0-9]-"$2".md; do
        if [ -e "$f" ] || [ -L "$f" ]; then printf '%s\n' "$f"; return 0; fi
    done
    printf '%s\n' "$1/(no entry for $2)"
}

# V2 — unmet slug dep: hold written, attempt NOT incremented, plan stays in queue
reset_e2
write_e2_plan "held" "depends_on: prereq"
run_e2 > /dev/null 2>&1
assert_present "V2: unmet dep → .depends-hold sidecar written" \
    "$E2_NDIR/queue/held.md.depends-hold"
assert_absent  "V2: unmet dep → attempt counter not incremented" \
    "$E2_NDIR/queue/held.md.attempts"
assert_present "V2: unmet dep → plan stays in queue/"  "$(qentry "$E2_NDIR/queue" held)"
assert_absent  "V2: unmet dep → plan NOT moved to skipped/" "$E2_NDIR/skipped/held.md"
LOGTXT_V2="$(e2_logtxt)"
want "V2: log carries [depends-hold]"           "$LOGTXT_V2" "[depends-hold]"
want "V2: log names the plan"                   "$LOGTXT_V2" "held.md"
want "V2: log names the blocking dependency"    "$LOGTXT_V2" "prereq"
want "V2: sidecar records the dependency" \
    "$(cat "$E2_NDIR/queue/held.md.depends-hold")" "prereq"
if grep -q 'held.md impl' "$E2_TRACE" 2>/dev/null; then
    fail "V2: claude was unexpectedly invoked"
else
    ok "V2: claude never invoked for held plan"
fi

# V3 — met slug dep (symlink in done/): plan runs, no hold written
reset_e2
mark_e2_done prereq
write_e2_plan "met-plan" "depends_on: prereq"
# Plant a stale hold to verify it gets cleared (Phase 3 §3.3 met arm)
echo "unmet:prereq" > "$E2_NDIR/queue/met-plan.md.depends-hold"
run_e2 > /dev/null 2>&1
assert_absent "V3: met dep → no .depends-hold (stale hold cleared)" \
    "$E2_NDIR/queue/met-plan.md.depends-hold"
assert_present "V3: met dep → moved to done/" "$E2_NDIR/done/met-plan.md"

# V3b — dep in done/ but its PR CLOSED unmerged: runner holds, never runs impl
reset_e2
mark_e2_done prereq
echo CLOSED > "$E2_ROOT/gh.mode"
write_e2_plan "closed-dep" "depends_on: prereq"
run_e2 > /dev/null 2>&1
assert_present "V3b: closed-unmerged dep → .depends-hold written" \
    "$E2_NDIR/queue/closed-dep.md.depends-hold"
assert_present "V3b: closed-unmerged dep → plan stays in queue/" \
    "$(qentry "$E2_NDIR/queue" closed-dep)"
LOGTXT_V3B="$(e2_logtxt)"
want "V3b: log carries [depends-unresolvable]" "$LOGTXT_V3B" "[depends-unresolvable]"
want "V3b: log names the closed-unmerged reason" "$LOGTXT_V3B" "closed-unmerged"
if grep -q 'closed-dep.md impl' "$E2_TRACE" 2>/dev/null; then
    fail "V3b: claude was unexpectedly invoked"
else
    ok "V3b: claude never invoked for closed-unmerged dep"
fi

# V4 — unresolvable dep: hold written with reason, log has [depends-unresolvable]
reset_e2
write_e2_plan "unres" "depends_on: ../../etc/passwd"
run_e2 > /dev/null 2>&1
assert_present "V4: unresolvable dep → .depends-hold written" \
    "$E2_NDIR/queue/unres.md.depends-hold"
LOGTXT_V4="$(e2_logtxt)"
want "V4: log carries [depends-unresolvable]"  "$LOGTXT_V4" "[depends-unresolvable]"
want "V4: log names the dependency"            "$LOGTXT_V4" "../../etc/passwd"
want "V4: log names the reason"                "$LOGTXT_V4" "bad-value"

# V5 — all-held queue terminates: exit 0, names held plans, no spin
# Run the FULL runner (no --plan flag) so the termination branch is reached.
reset_e2
write_e2_plan "held5a" "depends_on: missing-dep"
write_e2_plan "held5b" "depends_on: missing-dep"
V5_RC=0
( NIGHTLY_DIR="$E2_NDIR" PLANS_DIR="$E2_PLANS" CLAUDE_HEADLESS=1 \
  CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 \
  "$E2_RUNNER" > "$E2_ROOT/run5.out" 2>&1 ) & V5_PID=$!
( sleep 60; kill -9 "$V5_PID" 2>/dev/null ) & V5_KP=$!
wait "$V5_PID"; V5_RC=$?; kill "$V5_KP" 2>/dev/null; wait "$V5_KP" 2>/dev/null || true
if [ "$V5_RC" -ne 137 ]; then
    ok "V5: all-held queue terminates (not killed, RC=$V5_RC)"
else
    fail "V5: all-held queue spun — killed by watchdog (RC=137, §3.2 DEPENDS_HELD skip missing)"
fi
LOGTXT_V5="$(e2_logtxt)"
want "V5: termination log names held plans, not concurrency" \
    "$LOGTXT_V5" "Dependency-held this run"
case "$LOGTXT_V5" in *"claimed by a concurrent runner"*) \
    fail "V5: runner logged the false concurrency message" ;; esac

# P1 — post-plan-now exits 1 instantly with the handoff kept: the runner must
# classify it environmental (sub-MIN_VIABLE_SECS exit, handoff present), refund
# the attempt, write the env-stop report, and stop without re-claiming.
reset_e2_clean
echo fail > "$E2_ROOT/pp.mode"
write_e2_plan "ppfast"
run_e2 > /dev/null 2>&1
LOGTXT_P1="$(e2_logtxt)"
if grep -q 'ppfast.md postplan-fail' "$E2_TRACE" 2>/dev/null; then
    ok "P1: runner reached postplan and the stub took its fail branch"
else
    fail "P1: post-plan-now fail branch never ran (trace: $(cat "$E2_TRACE" 2>/dev/null))"
fi
assert_eq "P1: post-plan-now invoked exactly once (loop stopped, no re-claim)" \
    "$(grep -c 'ppfast.md postplan-fail' "$E2_TRACE" 2>/dev/null)" "1"
assert_present "P1: fast failure → plan stays in queue/"  "$(qentry "$E2_NDIR/queue" ppfast)"
assert_absent  "P1: fast failure → plan NOT moved to done/" "$E2_NDIR/done/ppfast.md"
assert_absent  "P1: fast failure → plan NOT moved to skipped/" "$E2_NDIR/skipped/ppfast.md"
# Impl handoff seeds .attempts to 1, so this absence proves refund_attempt ran
# (a refund of 1 removes the file). The "Refunding attempt, stopping loop" want
# below pins the log side of the same refund.
assert_absent  "P1: fast failure → no .attempts counter left behind" \
    "$E2_NDIR/queue/ppfast.md.attempts"
P1_REPORT="$(ls "$E2_NDIR/reports"/*-env-stop-*ppfast*.md 2>/dev/null | head -1)"
if [ -n "$P1_REPORT" ]; then
    ok "P1: env-stop report written"
else
    fail "P1: no env-stop report under $E2_NDIR/reports (have: $(ls "$E2_NDIR/reports" 2>/dev/null))"
fi
want "P1: log records the non-zero post-plan exit" \
    "$LOGTXT_P1" "post-plan-now exited code=1 (postplan phase)"
want "P1: log carries the environmental breaker line" \
    "$LOGTXT_P1" "Environmental failure during postplan"
want "P1: breaker reason names the sub-minute exit" "$LOGTXT_P1" "postplan exited in"
want "P1: breaker names the refund-and-stop decision" \
    "$LOGTXT_P1" "Refunding attempt, stopping loop"

# P2 — post-plan-now exits 1 past the viability floor: a genuine plan failure.
# A second runner copy pins MIN_VIABLE_SECS=0 so the breaker's duration arm
# cannot fire; the shared $E2_RUNNER stays untouched for V1-V5. Its PATH puts
# $E2_STUB_SF first: the same claude stub plus a gh stub that prints nothing
# (no PR), so terminal disposition never reaches the real GitHub CLI.
# `plan ppslow` is single-plan mode: one attempt, then break before the
# between-plans canary.
E2_STUB_SF="$E2_ROOT/stub-sf"
E2_GH_SF_ARGS="$E2_ROOT/gh-sf.args"
mkdir -p "$E2_STUB_SF"
ln -sf "$E2_STUB/claude" "$E2_STUB_SF/claude"
cat > "$E2_STUB_SF/gh" <<GHSF
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "$E2_GH_SF_ARGS"
exit 0
GHSF
chmod +x "$E2_STUB_SF/gh"
E2_RUNNER_SF="$E2_NDIR/run-slowfail"
sed \
    -e "s#^NIGHTLY_DIR=.*#NIGHTLY_DIR=\"$E2_NDIR\"#" \
    -e "s#^REPO=.*#REPO=\"$REPO_ROOT\"#" \
    -e "s#^export PATH=.*#export PATH=\"$E2_STUB_SF:/usr/local/bin:/opt/homebrew/bin:\$PATH\"#" \
    -e "s#^MIN_VIABLE_SECS=[0-9][0-9]*#MIN_VIABLE_SECS=0#" \
    "$REPO_ROOT/bin/automouse/run" > "$E2_RUNNER_SF"
chmod +x "$E2_RUNNER_SF"
assert_eq "P2: slow-fail runner copy pins MIN_VIABLE_SECS=0" \
    "$(grep -c '^MIN_VIABLE_SECS=0' "$E2_RUNNER_SF")" "1"

reset_e2_clean
: > "$E2_GH_SF_ARGS"
echo fail > "$E2_ROOT/pp.mode"
write_e2_plan "ppslow"
GH="$E2_GH" NIGHTLY_DIR="$E2_NDIR" PLANS_DIR="$E2_PLANS" CLAUDE_HEADLESS=1 \
CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 \
timeout 30 "$E2_RUNNER_SF" plan ppslow > /dev/null 2>&1 || true
LOGTXT_P2="$(e2_logtxt)"
if grep -q 'ppslow.md postplan-fail' "$E2_TRACE" 2>/dev/null; then
    ok "P2: runner reached postplan and the stub took its fail branch"
else
    fail "P2: post-plan-now fail branch never ran (trace: $(cat "$E2_TRACE" 2>/dev/null); gh calls: $(cat "$E2_GH_SF_ARGS" 2>/dev/null))"
fi
assert_eq "P2: post-plan-now invoked exactly once (single-plan mode, no retry)" \
    "$(grep -c 'ppslow.md postplan-fail' "$E2_TRACE" 2>/dev/null)" "1"
assert_present "P2: genuine failure → plan stays in queue/ for retry"  "$(qentry "$E2_NDIR/queue" ppslow)"
assert_absent  "P2: genuine failure → plan NOT filed to done/" "$E2_NDIR/done/ppslow.md"
assert_absent  "P2: genuine failure → plan NOT moved to skipped/" "$E2_NDIR/skipped/ppslow.md"
# Impl handoff seeds .attempts to 1 (the impl run's post-plan is attempt 1), so
# a genuine post-plan failure leaves the counter at 1, never absent. The env-stop
# report and Environmental line below separate this path from the breaker.
assert_eq "P2: genuine failure → impl run's post-plan counted as attempt 1" \
    "$(cat "$E2_NDIR/queue/ppslow.md.attempts" 2>/dev/null)" "1"
P2_REPORT="$(ls "$E2_NDIR/reports"/*-env-stop-*ppslow*.md 2>/dev/null | head -1)"
if [ -z "$P2_REPORT" ]; then
    ok "P2: no env-stop report for a genuine failure"
else
    fail "P2: env-stop report written for a genuine failure: $P2_REPORT"
fi
want "P2: log records the non-zero post-plan exit" \
    "$LOGTXT_P2" "post-plan-now exited code=1 (postplan phase)"
case "$LOGTXT_P2" in
    *"Environmental failure during postplan"*)
        fail "P2: genuine failure misclassified as Environmental failure during postplan" ;;
    *)  ok "P2: no Environmental failure during postplan line" ;;
esac
want "P2: terminal disposition queried PR state via the stub gh (pr list --head)" \
    "$(cat "$E2_GH_SF_ARGS" 2>/dev/null)" "pr list --head"

# P3 — invocation 2 over P2's real output (no hand-built state): a plan that
# depends on the failed plan must stay held. ppslow is still in queue/, not
# done/, so the resolver answers unmet without any gh call.
write_e2_plan "ppdep" "depends_on: ppslow"
GOT_P3="$( export NIGHTLY_DIR="$E2_NDIR" GH="$E2_GH"
           . "$REPO_ROOT/bin/lib/plan-depends-on"
           plan_depends_on_status "$E2_NDIR/queue/ppdep.md" )"
assert_eq "P3: dependent of a failed post-plan resolves unmet:ppslow" "$GOT_P3" "unmet:ppslow"

# P4 — multi-run cap over P2's real state: ppslow sits in queue/ with its
# handoff and .attempts=1 after P2. Each `plan ppslow` resumes (impl skipped)
# and runs post-plan once. MAX_ATTEMPTS=3 must give post-plan exactly 3 runs in
# total: P2's run, then resumes 2 and 3; the 4th claim files it to skipped/.
# $E2_TRACE is not reset here, so its postplan-fail count is cumulative.
rm -f "$E2_NDIR/queue/ppdep.md"
p4_resume() {
    GH="$E2_GH" NIGHTLY_DIR="$E2_NDIR" PLANS_DIR="$E2_PLANS" CLAUDE_HEADLESS=1 \
    CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 \
    timeout 30 "$E2_RUNNER_SF" plan ppslow > /dev/null 2>&1 || true
}
p4_resume
assert_eq "P4: resume 1 → .attempts reads 2" \
    "$(cat "$E2_NDIR/queue/ppslow.md.attempts" 2>/dev/null)" "2"
assert_eq "P4: resume 1 → post-plan invoked 2 times in total" \
    "$(grep -c 'ppslow.md postplan-fail' "$E2_TRACE" 2>/dev/null)" "2"
p4_resume
assert_eq "P4: resume 2 → .attempts reads 3" \
    "$(cat "$E2_NDIR/queue/ppslow.md.attempts" 2>/dev/null)" "3"
assert_present "P4: resume 2 → plan still in queue/"  "$(qentry "$E2_NDIR/queue" ppslow)"
p4_resume
assert_present "P4: claim at cap → plan moved to skipped/" "$E2_NDIR/skipped/ppslow.md"
assert_absent  "P4: claim at cap → plan gone from queue/"  "$(qentry "$E2_NDIR/queue" ppslow)"
assert_eq "P4: post-plan invoked exactly MAX_ATTEMPTS=3 times across all runs" \
    "$(grep -c 'ppslow.md postplan-fail' "$E2_TRACE" 2>/dev/null)" "3"

# ── Final summary ─────────────────────────────────────────────────────────────

echo ""
echo "# Results: $FAILED failed"
exit "$FAILED"
