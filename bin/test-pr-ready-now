# --- case 18: E14 the CI watcher is a committed script run inside an Agent delegate -------
# The watcher runs under neither `Monitor` nor a backgrounded `Bash`. Monitor turns every
# stdout line into a conversation message, and ~46 checks landing in waves woke the
# orchestrator a dozen-odd times per run. `Bash(run_in_background: true)` is worse: under
# headless `claude -p` the wind-down sweep awaits only `local_agent`/`local_workflow`, so a
# `local_bash` shell is killed after a 5s grace — and ~/.claude/hooks/bash-guard.sh Check 17
# denies it outright under CLAUDE_HEADLESS. The single foreground fallback the deny message
# suggests caps at 600000ms < this repo's ~10-15min CI, so it auto-backgrounds into the same
# grave. That is how PR #1825 (2026-08-29) died at Phase 4 with green CI, no verdict comment
# and exit status 0. The surviving shape is an `Agent` delegate (`local_agent` IS awaited),
# which runs the script in ITS foreground in <=600s windows and returns one verdict block.
# These assertions are the anti-drift guard: a re-added `Monitor(`/`command:` block, a pasted
# copy of the loop, a dropped delegate, or ANY positive `run_in_background` instruction fails
# here. Unconditional counts (case 17's shape) so a regression fails loudly rather than
# skipping. The `**Exempt:**` check is E14's original assertion, kept because that clause is
# what told a reader Monitor was safe to arm here.
begin_case
[[ -s "$UNION" ]] || fail "e14: pr-ready doc union missing or empty at $UNION"

[[ "$(grep -cF '**Exempt:**' "$UNION")" -eq 0 ]] \
    || fail "e14: SKILL.md still carries an **Exempt:** clause (E14 regression)"
# no Monitor arming block, and no `command:` key, may exist anywhere in the skill
[[ "$(grep -c 'command:' "$UNION")" -eq 0 ]] \
    || fail "e14: SKILL.md has a 'command:' line — a Monitor arm was re-added (E14 regression)"
[[ "$(grep -cF 'Monitor(' "$UNION")" -eq 0 ]] \
    || fail "e14: SKILL.md arms a Monitor( — the CI watcher must run via an Agent delegate"
# the watcher is materialised once from the pin, and armed twice (Phase 4.5 + Phase 6.5),
# always with the 540s window that keeps each run under the 600000ms Bash cap
[[ "$(grep -cF 'scripts/watch-ci.sh > /tmp/pr-ready-ciwatch-<N>.sh' "$UNION")" -eq 1 ]] \
    || fail "e14: expected exactly 1 watch-ci.sh materialise line in SKILL.md"
[[ "$(grep -cF 'bash /tmp/pr-ready-ciwatch-<N>.sh <N> <HEAD_SHA> 540' "$UNION")" -eq 2 ]] \
    || fail "e14: expected 2 'bash /tmp/pr-ready-ciwatch-<N>.sh <N> <HEAD_SHA> 540' arm lines (Phase 4.5 + 6.5)"
[[ "$(grep -cF 'bash /tmp/pr-ready-ciwatch-<N>.sh <N> <HEAD_SHA>' "$UNION")" -eq 2 ]] \
    || fail "e14: a watcher arm line is missing its 540s window — it would hit the 600000ms Bash cap"
# the delegate is the load-bearing part: `local_agent` is the only task type print mode awaits
grep -qF 'Agent(description: "Watch CI for PR <N>", model: "haiku"' "$UNION" \
    || fail "e14: the CI watcher Agent delegate spawn line is gone — a headless run will be killed at Phase 4 (PR #1825)"
grep -qF 'timeout: 600000' "$UNION" \
    || fail "e14: the delegate no longer pins the foreground Bash timeout — it would auto-background"
# EVERY mention of run_in_background must be prohibitive; a positive instruction is the #1825 bug.
# Asserted PER FILE, not on the union: a union floor passes while Phase 6.5 silently loses its
# warning, and Phase 6.5 is the step this skill's own prose names as where a fixed run relapses.
for _w in _phase4-push-and-ci.md _phase65-remediation.md; do
    [[ "$(grep -c 'run_in_background' "$PRD/$_w")" -ge 1 ]] \
        || fail "e14: $_w lost its run_in_background prohibition"
done
# and the delegate must be told a missing verdict block is a retry, not a result (#1825)
grep -qF 'no verdict block at all' "$PRD/_phase4-push-and-ci.md" \
    || fail "e14: the delegate packet no longer handles a killed/empty watcher run — that is the #1825 gap"
[[ "$(grep 'run_in_background' "$UNION" | grep -cviE '\b(NOT|never|denies|denied|deny|unsafe|discarded|may not|must not|cannot|do not)\b')" -eq 0 ]] \
    || fail "e14: a POSITIVE run_in_background instruction is back in the skill — this is exactly what killed PR #1825"
# the polling logic must live ONLY in the script; a pasted copy is the drift this guards
[[ "$(grep -c 'gh pr checks <N>' "$UNION")" -eq 0 ]] \
    || fail "e14: a copy of the watcher loop was pasted back into SKILL.md (drift)"
end_case e14-ci-watcher-agent-delegate

# --- case 19: E15 rebase delegate is never told to push ----------------------------------
# The delegate packet runs under ~/.claude/hooks/plan-gate-commit.sh, which denies `git push`
# for sub-agents. Any positive push instruction in the packet is an instant hard-fail.
begin_case
REBASE="$SCRIPT_DIR/../.claude/skills/pr-ready/_rebase-and-conflicts.md"
[[ -s "$REBASE" ]] || fail "e15: _rebase-and-conflicts.md missing or empty at $REBASE"

grep -qiE '(NOT|may not|must not) run.*git push' "$REBASE" \
    || fail "e15: delegate hard limits do not prohibit 'git push' (E15 regression)"
[[ "$(grep 'git push' "$REBASE" | grep -cviE '\b(NOT|never|may not|must not|cannot|do not)\b')" -eq 0 ]] \
    || fail "e15: positive 'git push' instruction in the delegate packet (E15 regression)"
end_case e15-delegate-no-push

# --- case 20: scripts/watch-ci.sh — one wake, and every terminal path is loud -------------
# Driven through a PATH gh shim plus the script's two documented test seams
# (WATCH_CI_INTERVAL / WATCH_CI_GRACE), so no arm here touches the network or sleeps 30s.
begin_case
WCI="$SCRIPT_DIR/../.claude/skills/pr-ready/scripts/watch-ci.sh"
[[ -s "$WCI" ]] || fail "watch-ci: script missing or empty at $WCI"
[[ -x "$WCI" ]] || fail "watch-ci: script is not executable"

CIW="$SCRATCH/ciwatch"
mkdir -p "$CIW/bin"
# gh shim: `pr view` and `pr checks` each cat the fixture the current arm wrote.
cat > "$CIW/bin/gh" <<GH2_EOF
#!/usr/bin/env bash
if [[ "\${1:-}" == "pr" && "\${2:-}" == "view" ]];   then cat "$CIW/view.json";   exit 0; fi
if [[ "\${1:-}" == "pr" && "\${2:-}" == "checks" ]]; then cat "$CIW/checks.json"; exit 0; fi
echo "gh shim: unexpected args: \$*" >&2
exit 1
GH2_EOF
chmod +x "$CIW/bin/gh"

SHA_NEW=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
SHA_OLD=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# $1 = headRefOid the API reports, $2 = mergeStateStatus, $3 = checks JSON, $4.. = script args.
wci_out=""; wci_rc=0
run_wci() {
    printf '{"headRefOid":"%s","mergeStateStatus":"%s"}\n' "$1" "$2" > "$CIW/view.json"
    printf '%s\n' "$3" > "$CIW/checks.json"
    shift 3
    wci_out="$(env PATH="$CIW/bin:$PATH" WATCH_CI_INTERVAL=0 WATCH_CI_GRACE=2 bash "$WCI" "$@" 2>&1)"
    wci_rc=$?
}

ALL_GREEN='[{"name":"a","bucket":"pass"},{"name":"b","bucket":"skipping"}]'
ONE_RED='[{"name":"a","bucket":"pass"},{"name":"b","bucket":"fail"},{"name":"c","bucket":"cancel"}]'
PENDING='[{"name":"a","bucket":"pass"},{"name":"b","bucket":"pending"}]'

# (a) all settled, none red
run_wci "$SHA_NEW" CLEAN "$ALL_GREEN" 1234 "$SHA_NEW"
[[ $wci_rc -eq 0 ]] || fail "watch-ci (a): expected exit 0, got $wci_rc — $wci_out"
grep -qF 'CI COMPLETE' <<< "$wci_out" || fail "watch-ci (a): no CI COMPLETE line — $wci_out"
grep -qF 'CLEAN' <<< "$wci_out" || fail "watch-ci (a): verdict does not carry mergeStateStatus"

# (b) red checks — EVERY non-pass/skipping bucket is named. This is what buys the single
# wake: Phase 6.5 fixes all of them in one pass instead of one CI round trip per failure.
run_wci "$SHA_NEW" CLEAN "$ONE_RED" 1234 "$SHA_NEW"
[[ $wci_rc -eq 1 ]] || fail "watch-ci (b): expected exit 1, got $wci_rc — $wci_out"
grep -qF 'CI FAILED' <<< "$wci_out" || fail "watch-ci (b): no CI FAILED line — $wci_out"
grep -qF 'b: fail'   <<< "$wci_out" || fail "watch-ci (b): failing check not named"
grep -qF 'c: cancel' <<< "$wci_out" || fail "watch-ci (b): cancelled check not named (fail-fast leak?)"
grep -qF 'a: pass'   <<< "$wci_out" && fail "watch-ci (b): a green check was listed as red"

# (c) DIRTY beats the checks predicate
run_wci "$SHA_NEW" DIRTY "$ALL_GREEN" 1234 "$SHA_NEW"
[[ $wci_rc -eq 2 ]] || fail "watch-ci (c): expected exit 2 on DIRTY, got $wci_rc — $wci_out"
grep -qF 'MERGE CONFLICT' <<< "$wci_out" || fail "watch-ci (c): no MERGE CONFLICT line"

# (d) THE #1830 REGRESSION. The API still serves the pre-push head, whose checks are all
# settled and green. Without the `seen` gate this returns a false CI COMPLETE for a head
# whose CI was never watched at all. It must report STALE instead.
run_wci "$SHA_OLD" CLEAN "$ALL_GREEN" 1234 "$SHA_NEW"
[[ $wci_rc -eq 3 ]] || fail "watch-ci (d): expected exit 3 (STALE), got $wci_rc — the seen gate is gone"
grep -qF 'STALE' <<< "$wci_out" || fail "watch-ci (d): no STALE line — $wci_out"
grep -qF 'CI COMPLETE' <<< "$wci_out" && fail "watch-ci (d): FALSE CI COMPLETE on the pre-push head (#1830)"

# (e) timeout with the head seen and a check still pending
run_wci "$SHA_NEW" CLEAN "$PENDING" 1234 "$SHA_NEW" 1
[[ $wci_rc -eq 4 ]] || fail "watch-ci (e): expected exit 4 (CI TIMEOUT), got $wci_rc — $wci_out"
grep -qF 'CI TIMEOUT'  <<< "$wci_out" || fail "watch-ci (e): no CI TIMEOUT line — $wci_out"
grep -qF 'pending: b'  <<< "$wci_out" || fail "watch-ci (e): timeout verdict does not name the pending check"

# (f) usage errors are loud, never a silent exit 0
run_wci "$SHA_NEW" CLEAN "$ALL_GREEN"
[[ $wci_rc -eq 5 ]] || fail "watch-ci (f): expected exit 5 with no args, got $wci_rc"
grep -qF 'STOP:' <<< "$wci_out" || fail "watch-ci (f): no STOP: line on missing args"
run_wci "$SHA_NEW" CLEAN "$ALL_GREEN" 1234
[[ $wci_rc -eq 5 ]] || fail "watch-ci (f): expected exit 5 with no SHA, got $wci_rc"
[[ -n "$wci_out" ]] || fail "watch-ci (f): a terminal path printed nothing — silence is not success"
end_case watch-ci-single-wake

# --- case 21: static assertions for the Sonnet-orchestrator + pinned-Opus-reviewer PR ---
begin_case
# 21a: orchestrator pinned to claude-sonnet-4-6; banned sonnet alias absent
grep -qx 'model: claude-sonnet-4-6' "$SCRIPT_DIR/../.claude/skills/pr-ready/SKILL.md" \
  || fail "21a: SKILL.md missing model: claude-sonnet-4-6"
grep -qE '^model: *"?sonnet"?' "$SCRIPT_DIR/../.claude/skills/pr-ready/SKILL.md" \
  && fail "21a: SKILL.md has banned sonnet alias"
grep -qF 'DO NOT ADD ONE' "$SCRIPT_DIR/../.claude/skills/pr-ready/SKILL.md" \
  && fail "21a: superseded NO-model: gate comment is still in SKILL.md"
# 21b: reviewer def exists, is Opus-pinned, cannot nest a delegate
test -f "$SCRIPT_DIR/../.claude/agents/pr-ready-phase6.md" \
  || fail "21b: pr-ready-phase6.md missing"
grep -qx 'model: claude-opus-5' "$SCRIPT_DIR/../.claude/agents/pr-ready-phase6.md" \
  || fail "21b: pr-ready-phase6.md not pinned to claude-opus-5"
grep -q '^disallowedTools:.*Agent' "$SCRIPT_DIR/../.claude/agents/pr-ready-phase6.md" \
  || fail "21b: pr-ready-phase6.md does not disallow Agent"
# 21c: Phase 6 spawn site carries no model: override — asserted over the whole
# Agent( ... ) block, not over the lines that happen to name the def. A line-scoped grep
# is vacuous by construction here: the only line matching subagent_type: "pr-ready-phase6"
# IS the subagent_type key, and one key line can never also be a model: key line. The
# realistic regression is a bare `model: "sonnet",` added as its own line inside the block,
# which contains no 'pr-ready-phase6' and so was invisible to the old form.
blk="$(awk '
    /^[[:space:]]*Agent\(/                  { inblk=1; buf="" }
    inblk                                   { buf = buf $0 "\n" }
    inblk && /^[[:space:]]*\)[[:space:]]*$/ {
        if (buf ~ /subagent_type: "pr-ready-phase6"/) printf "%s", buf
        inblk = 0
    }
' "$SCRIPT_DIR/../.claude/skills/pr-ready/SKILL.md")"
# Empty window => the spawn block was deleted or reshaped. Fail loudly rather than let the
# absence of a block silently satisfy the "no model: override" assertion below.
[[ -n "$blk" ]] \
  || fail "21c: no Agent( ... ) block spawning pr-ready-phase6 found in SKILL.md"
grep -qE 'model:' <<< "$blk" \
  && fail "21c: spawn site has a model: override (def pin must win)"
: # 21c passes when no line in the spawn block matches model:
# 21d: verdict handoff uses no $( or <( — survives EnterWorktree isolation.
# Scoped to EVERY line naming the verdict path, not only the `test -s` line: the fail-closed
# read spans several lines, so the narrower form left the `&&`/`||` arms unasserted and a
# later $(cat ...) added there would have sailed through.
_vd=$(grep -cF 'pr-ready-phase6-verdict' "$SCRIPT_DIR/../.claude/skills/pr-ready/SKILL.md")
[[ "$_vd" -ge 3 ]] \
  || fail "21d: verdict-read block shrank to $_vd line(s) naming the verdict path, want >= 3"
grep -F 'pr-ready-phase6-verdict' "$SCRIPT_DIR/../.claude/skills/pr-ready/SKILL.md" \
  | grep -qE '\$\(|<\(' \
  && fail "21d: fail-closed read contains command substitution"
: # 21d passes when no match
# 21e: section 6a rewritten; old form gone
grep -qF 'It is NEVER delegated' "$SCRIPT_DIR/../.claude/skills/pr-ready/_plan-fidelity-review.md" \
  && fail "21e: old 6a text still present"
grep -qF 'This review runs on the orchestrator' "$SCRIPT_DIR/../.claude/skills/pr-ready/_plan-fidelity-review.md" \
  && fail "21e: old 6a text still present (orchestrator form)"
grep -qF 'pinned Opus 5 def' "$SCRIPT_DIR/../.claude/skills/pr-ready/_plan-fidelity-review.md" \
  || fail "21e: new 6a text missing"
grep -qF 'Spawning any sub-agent for this phase is a defect' "$SCRIPT_DIR/../.claude/skills/pr-ready/SKILL.md" \
  && fail "21e: superseded never-delegate clause still in SKILL.md"
# 21f: driver default and revert lever — behavioral, over the EMITTED runner.
# The static `grep -q -- '--model claude-opus-5'` this replaces matched comment prose only
# (bin/pr-ready-now lines 14 and 112), so it kept passing with the entire --model parsing arm
# deleted — the plan's own named rollback lever had no test at all. The `grep -qx` on the
# assignment is KEPT: it is what gives the mutation check teeth on the default's source text.
# `rm -f "$R"` before each arm is load-bearing — case 5 fires the same PR under the default
# model, and fire_pr's stale-clearing glob excludes $RUNNER by name, so a leftover runner
# would satisfy arm 1 even if this case's own driver run never reached emit_runner.
grep -qx 'MODEL="claude-sonnet-4-6"' "$SCRIPT_DIR/pr-ready-now" \
  || fail "21f: bin/pr-ready-now default is not claude-sonnet-4-6"
R="/tmp/pr-ready-now-runner-1901.sh"
clean_slots; rm -f "$R"
out="$(PR_READY_NOW_PR_JSON="$SCRATCH/two-open.json" PR_READY_NOW_DRY_RUN=1 run_driver --go --jobs 3 2>&1)"; rc=$?
[[ $rc -eq 0 ]] || fail "21f: default dry-run exited $rc, want 0 (out: $out)"
test -s "$R"    || fail "21f: default dry-run emitted no runner at $R"
grep -qx 'MODEL=claude-sonnet-4-6' "$R" \
  || fail "21f: default runner MODEL is not claude-sonnet-4-6"
clean_slots; rm -f "$R"
out="$(PR_READY_NOW_PR_JSON="$SCRATCH/two-open.json" PR_READY_NOW_DRY_RUN=1 run_driver --go --jobs 3 --model claude-opus-5 2>&1)"; rc=$?
[[ $rc -eq 0 ]] || fail "21f: --model dry-run exited $rc, want 0 (out: $out)"
test -s "$R"    || fail "21f: --model dry-run emitted no runner at $R"
grep -qx 'MODEL=claude-opus-5' "$R" \
  || fail "21f: --model claude-opus-5 did not override the default — the revert lever is broken"
# 21g: the verdict path is cleared BEFORE the spawn. Ordering is the whole property — an
# rm -f sitting after the Agent( call would still leave step 2's `test -s` satisfiable by a
# prior run's file for the same PR, which is the stale-verdict hole this closes. Both line
# numbers are captured so a missing clause and a misordered one fail with distinct messages.
_sk="$SCRIPT_DIR/../.claude/skills/pr-ready/SKILL.md"
_rm_ln=$(grep -nF 'rm -f /tmp/pr-ready-phase6-verdict' "$_sk" | head -1 | cut -d: -f1)
_spawn_ln=$(grep -nF 'subagent_type: "pr-ready-phase6"' "$_sk" | head -1 | cut -d: -f1)
[[ -n "$_rm_ln" ]] \
  || fail "21g: SKILL.md never clears the verdict path — step 2's test -s can pass on a stale file"
[[ -n "$_spawn_ln" && -n "$_rm_ln" && "$_rm_ln" -lt "$_spawn_ln" ]] \
  || fail "21g: verdict rm -f (line ${_rm_ln:-none}) does not precede the spawn (line ${_spawn_ln:-none})"
end_case phase6-opus-delegate-static

# --- case 26: every git-show include path resolves ----------------------------------------
# The runtime loader is `git show <MASTER_SHA>:<path>`. A stub naming a path that does not
# exist STOPs the run: fail-closed, but a dead stop on every future /pr-ready. Resolve
# against the WORKING TREE, not a master SHA -- the companions are not in any master SHA
# until this PR merges, so a `git show` based check here would fail for the wrong reason.
begin_case
_root="$SCRIPT_DIR/.."
_paths=$(grep -ohE 'git show <MASTER_SHA>:[^ `]+' "$PRD/SKILL.md" "$PRD"/_*.md \
             "$_root/.claude/agents/pr-ready-phase6.md" \
         | sed 's|^git show <MASTER_SHA>:||' | sort -u)
[[ -n "$_paths" ]] || fail "no 'git show <MASTER_SHA>:<path>' includes found -- did the loader idiom change?"
while IFS= read -r _p; do
    [[ -z "$_p" ]] && continue
    case "$_p" in *"<"*) continue ;; esac   # the invariants quote a literal <path> placeholder
    [[ -f "$_root/$_p" ]] || fail "include path does not resolve to a file: $_p"
done <<< "$_paths"
end_case pr-ready-include-paths-resolve

# --- case 22: new pr-ready companions carry doc-freshness frontmatter --------------------
# bin/check-docs' IN_SCOPE_GLOBS covers .claude/skills/*/SKILL.md but NOT _*.md, so nothing
# else in the repo enforces this. The two PRE-EXISTING companions predate the convention and
# are deliberately excluded rather than retrofitted in an unrelated PR.
begin_case
for _c in _phase4-push-and-ci.md _phase59-files-changed.md _phase65-remediation.md _phase7-verdict.md; do
    head -1 "$PRD/$_c" | grep -qx -- '---' \
        || fail "$_c does not open with a YAML frontmatter fence"
    head -5 "$PRD/$_c" | grep -q '^description: ' \
        || fail "$_c is missing a 'description:' frontmatter key"
    head -5 "$PRD/$_c" | grep -qE '^last_verified: [0-9]{4}-[0-9]{2}-[0-9]{2}$' \
        || fail "$_c is missing a well-formed 'last_verified: YYYY-MM-DD' key"
done
end_case pr-ready-companion-frontmatter

# --- case 23: relocated phases fail CLOSED -----------------------------------------------
# A stub whose `git show` fails must STOP the run, never silently skip the phase. A skipped
# Phase 7 means no verdict is ever posted; a skipped Phase 4 means nothing is ever pushed.
# Neither leaves a trace, so this is asserted statically or not at all.
begin_case
_SKILL="$PRD/SKILL.md"
for _c in _phase4-push-and-ci.md _phase59-files-changed.md _phase65-remediation.md _phase7-verdict.md; do
    grep -qF "git show <MASTER_SHA>:.claude/skills/pr-ready/$_c" "$_SKILL" \
        || fail "SKILL.md has no git-show stub for $_c"
    grep -qF "STOP: cannot load $_c from <MASTER_SHA> or from the worktree" "$_SKILL" \
        || fail "the $_c stub has no inline fail-closed STOP line -- a failed load would silently skip the phase"
done
# The one PRE-EXISTING orchestrator-side stub uses the sanctioned fallback shape: it points
# at the single declared fallback in the invariants rather than carrying an inline STOP.
# _plan-fidelity-review.md is NO LONGER loaded by SKILL.md directly: Phase 6 now spawns the
# pr-ready-phase6 agent def, which loads _plan-fidelity-review.md on its own. Only
# _rebase-and-conflicts.md is loaded by the orchestrator via git show.
grep -qF "git show <MASTER_SHA>:.claude/skills/pr-ready/_rebase-and-conflicts.md" "$_SKILL" \
    || fail "SKILL.md has no git-show stub for _rebase-and-conflicts.md"
grep -qF 'STOP: cannot load <file> from <MASTER_SHA> or from the worktree' "$_SKILL" \
    || fail "the include-fallback invariant lost its declared STOP line"
# The enumeration must not drift behind the number of includes -- a stale count leaves
# includes outside the single declared fallback, which is a fail-OPEN hole. Two distinct
# assertions: the first pins line 38's phrasing, the second pins line 39's.
grep -qF 'all seven progressive-disclosure includes' "$_SKILL" \
    || fail "the git-show invariant no longer says 'all seven progressive-disclosure includes'"
grep -qF "orchestrator's seven progressive-disclosure includes" "$_SKILL" \
    || fail "the include-fallback clause no longer enumerates seven includes"
# Constraint 5: the model: key is claude-sonnet-4-6 (user-authorized 2026-08-26, superseding
# the prior "NO model: KEY" note). Case 21a also asserts this; the two are complementary.
grep -qx 'model: claude-sonnet-4-6' "$_SKILL" \
    || fail "SKILL.md lost its model: claude-sonnet-4-6 key -- it is deliberate, do not remove it"
grep -qF 'DO NOT REMOVE IT' "$_SKILL" \
    || fail "the deliberate model: key comment was removed or reworded -- constraint 5 marker lost"
end_case pr-ready-stub-fail-closed

# --- case 24: push.sh fails CLOSED --------------------------------------------------------
# The bug: a lease-only push with no explicit refspec, on a no-upstream worktree branch,
# publishes NOTHING and its rc is push.default-dependent. push.sh must (1) publish anyway
# via an explicit refspec, (2) still honour the lease, and (3) never report success unless
# origin actually holds HEAD. Arm (d) is the one that matters: a rejected push must be loud.
begin_case
PUSHSH="$PRD/scripts/push.sh"
if [[ ! -x "$PUSHSH" ]]; then
    fail "scripts/push.sh missing or not executable at $PUSHSH"
else
    PFIX="$SCRATCH/pushfix"; PORIGIN="$PFIX/origin.git"; PW="$PFIX/work"; PW2="$PFIX/work2"
    mkdir -p "$PFIX"
    g init -q --bare "$PORIGIN"
    g init -q "$PW"
    commit_on "$PW" one
    g -C "$PW" remote add origin "file://$PORIGIN"
    g -C "$PW" branch -M feat-x          # branch with NO upstream: the live worktree shape

    # (a) publishes on a no-upstream branch (the whole point), and verifies against origin
    out=$(cd "$PW" && bash "$PUSHSH" 9999 2>&1); rc=$?
    [[ $rc -eq 0 ]] || fail "push.sh rc=$rc on a clean no-upstream publish, expected 0: $out"
    grep -q '^PUSHED PR #9999 ' <<< "$out" || fail "push.sh did not print the PUSHED verdict: $out"
    grep -q 'moved: yes' <<< "$out" || fail "push.sh should report moved: yes when it creates the ref"
    _hs=$(g -C "$PW" rev-parse HEAD)
    [[ "$(g -C "$PW" ls-remote origin refs/heads/feat-x | awk '{print $1}')" == "$_hs" ]] \
        || fail "push.sh reported PUSHED but origin/feat-x does not hold HEAD"

    # (b) idempotent re-run: the ref does NOT move, and the verdict is still PUSHED.
    # This is why `after == HEAD` is authoritative and `moved` is only reported.
    out=$(cd "$PW" && bash "$PUSHSH" 9999 2>&1); rc=$?
    [[ $rc -eq 0 ]] || fail "push.sh rc=$rc on an idempotent re-run, expected 0: $out"
    grep -q '^PUSHED PR #9999 ' <<< "$out" \
        || fail "push.sh false-failed an up-to-date re-run -- 'moved' must not be the authoritative gate: $out"
    grep -q 'moved: no' <<< "$out" || fail "push.sh should report moved: no on an up-to-date re-run"

    # (c) stale lease: a concurrent third-party publish is REJECTED, never clobbered
    g clone -q "file://$PORIGIN" "$PW2"
    g -C "$PW2" checkout -q feat-x
    commit_on "$PW2" concurrent
    g -C "$PW2" push -q origin feat-x
    _third=$(g -C "$PW2" rev-parse HEAD)
    commit_on "$PW" mine
    out=$(cd "$PW" && bash "$PUSHSH" 9999 2>&1); rc=$?
    [[ $rc -eq 2 ]] || fail "push.sh rc=$rc on a stale lease, expected 2: $out"
    grep -q '^STALE LEASE' <<< "$out" || fail "push.sh did not print the STALE LEASE verdict: $out"
    grep -q '^PUSHED' <<< "$out" && fail "push.sh reported PUSHED on a stale lease -- FAIL-OPEN"
    [[ "$(g -C "$PW" ls-remote origin refs/heads/feat-x | awk '{print $1}')" == "$_third" ]] \
        || fail "push.sh CLOBBERED a concurrent update despite the lease"

    # (d) THE fail-closed arm: the remote REJECTS the update. A pre-receive hook exiting 1
    # lets the lease read succeed and only the update fail -- exactly the silent-failure shape.
    DFIX="$SCRATCH/pushdeny"; DORIGIN="$DFIX/origin.git"; DW="$DFIX/work"
    mkdir -p "$DFIX"
    g init -q --bare "$DORIGIN"
    printf '#!/bin/sh\nexit 1\n' > "$DORIGIN/hooks/pre-receive"
    chmod 755 "$DORIGIN/hooks/pre-receive"
    g init -q "$DW"
    commit_on "$DW" d1
    g -C "$DW" remote add origin "file://$DORIGIN"
    g -C "$DW" branch -M feat-deny
    out=$(cd "$DW" && bash "$PUSHSH" 9999 2>&1); rc=$?
    [[ $rc -ne 0 ]] || fail "push.sh exited 0 against a rejecting remote -- FAIL-OPEN: $out"
    grep -q 'PUSH FAILED' <<< "$out" || fail "push.sh did not print PUSH FAILED on a rejected update: $out"
    grep -q '^PUSHED' <<< "$out" && fail "push.sh reported PUSHED on a rejected update -- FAIL-OPEN"
    [[ -z "$(g -C "$DW" ls-remote origin refs/heads/feat-deny | awk '{print $1}')" ]] \
        || fail "fixture bug: the pre-receive deny hook did not actually block the update"

    # (g) rc 0 but origin does NOT hold HEAD. A post-receive hook rewinds the ref after the
    # update lands: git reports success (post-receive's status is ignored) while origin ends
    # up elsewhere. This is the arm that makes `after == HEAD` authoritative rather than rc --
    # arms (a)-(d) alone cannot tell the two gates apart, since a rejected push already sets
    # rc != 0. Mutate the gate to `[ "$RC" -eq 0 ]` and only this arm goes red.
    RFIX="$SCRATCH/pushrewind"; RORIGIN="$RFIX/origin.git"; RW="$RFIX/work"
    mkdir -p "$RFIX"
    g init -q --bare "$RORIGIN"
    printf '#!/bin/sh\ngit update-ref refs/heads/feat-rw "$(git rev-parse refs/heads/feat-rw^ 2>/dev/null || echo %s)" 2>/dev/null\nexit 0\n' \
        0000000000000000000000000000000000000000 > "$RORIGIN/hooks/post-receive"
    chmod 755 "$RORIGIN/hooks/post-receive"
    g init -q "$RW"
    commit_on "$RW" r1
    commit_on "$RW" r2
    g -C "$RW" remote add origin "file://$RORIGIN"
    g -C "$RW" branch -M feat-rw
    _rhead=$(g -C "$RW" rev-parse HEAD)
    out=$(cd "$RW" && bash "$PUSHSH" 9999 2>&1); rc=$?
    grep -q 'push rc: 0' <<< "$out" \
        || fail "fixture bug: the post-receive rewind should leave push rc 0 (out: $out)"
    [[ "$(g -C "$RW" ls-remote origin refs/heads/feat-rw | awk '{print $1}')" != "$_rhead" ]] \
        || fail "fixture bug: the post-receive hook did not rewind refs/heads/feat-rw"
    [[ $rc -ne 0 ]] || fail "push.sh exited 0 when origin does not hold HEAD -- rc is not the gate: $out"
    grep -q '^PUSHED' <<< "$out" \
        && fail "push.sh reported PUSHED on an rc-0 push that origin did not keep -- FAIL-OPEN"
    grep -q 'PUSH FAILED' <<< "$out" \
        || fail "push.sh did not print PUSH FAILED when origin does not hold HEAD: $out"

    # (f) origin holds the branch but we have NEVER fetched it: there is no lease to hold.
    # Unreachable from arms (a)-(d), and it is exactly where a naive fresh-read lease
    # silently degrades into --force.
    NFIX="$SCRATCH/pushnofetch"; NW="$NFIX/work"
    mkdir -p "$NFIX"
    g init -q "$NW"
    commit_on "$NW" nofetch
    g -C "$NW" remote add origin "file://$PORIGIN"
    g -C "$NW" branch -M feat-x
    out=$(cd "$NW" && bash "$PUSHSH" 9999 2>&1); rc=$?
    [[ $rc -eq 2 ]] || fail "push.sh rc=$rc with origin ahead and no tracking ref, expected 2: $out"
    grep -q '^STALE LEASE' <<< "$out" || fail "push.sh did not fail closed on an unfetched branch: $out"
    grep -q '^PUSHED' <<< "$out" && fail "push.sh reported PUSHED with no lease to hold -- FAIL-OPEN"
    [[ "$(g -C "$NW" ls-remote origin refs/heads/feat-x | awk '{print $1}')" == "$_third" ]] \
        || fail "push.sh CLOBBERED origin/feat-x when it held no lease"

    # (e) the four STOP guards
    out=$(cd "$PW" && bash "$PUSHSH" 2>&1); rc=$?
    [[ $rc -ne 0 ]] || fail "push.sh exited 0 with no PR-number argument"
    grep -q '^STOP: arg1' <<< "$out" || fail "push.sh missing-arg guard did not STOP: $out"

    NOGIT=$(mktemp -d)
    if git -C "$NOGIT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        fail "fixture problem: mktemp -d ($NOGIT) is inside a git work tree; the non-repo guard cannot be exercised"
    else
        out=$(cd "$NOGIT" && bash "$PUSHSH" 9999 2>&1); rc=$?
        [[ $rc -ne 0 ]] || fail "push.sh exited 0 outside a git work tree"
        grep -q '^STOP: not inside a git work tree' <<< "$out" || fail "push.sh non-repo guard did not STOP: $out"
    fi
    rm -rf "$NOGIT"

    g -C "$PW" checkout -q --detach
    out=$(cd "$PW" && bash "$PUSHSH" 9999 2>&1); rc=$?
    [[ $rc -ne 0 ]] || fail "push.sh exited 0 on a detached HEAD"
    grep -q '^STOP: detached HEAD' <<< "$out" || fail "push.sh detached-HEAD guard did not STOP: $out"
    g -C "$PW" checkout -q feat-x

    g -C "$DW" branch -M master
    out=$(cd "$DW" && bash "$PUSHSH" 9999 2>&1); rc=$?
    [[ $rc -ne 0 ]] || fail "push.sh exited 0 on branch master"
    grep -q "^STOP: refusing to push 'master'" <<< "$out" || fail "push.sh master guard did not STOP: $out"
fi
end_case pr-ready-push-fail-closed

# --- case 25: SKILL.md stays inside its resident-bytes band ------------------------------
# SKILL.md is resident in context on EVERY turn of a /pr-ready run, so its size is a cost
# invariant, not a style preference. The band is 2000 B wide -- deliberately NARROWER than
# the smallest relocatable phase (Phase 5.9, 2671 B) -- so re-inlining any phase trips it.
# Measured at implementation: 33224 B (Step 3.5 post Phase-6-delegate rewrite; the plan
# predicted 29021 B but a separate merged PR added the Phase 6 Opus-delegate block (+4203 B)
# before this PR rebased onto master).
# Re-measured 2026-09-04: 34047 B (Phase 6.7 stub added to SKILL.md; band updated to [33047, 35047]).
# Re-measured 2026-09-05: 34552 B (post-rebase on master 4721cb2ce; band [33047, 35047] still contains it — no re-centre needed).
begin_case
_sz=$(wc -c < "$PRD/SKILL.md" | tr -d ' ')
if [[ "$_sz" -lt 33047 || "$_sz" -gt 35047 ]]; then
    fail "SKILL.md is $_sz B, outside the [33047, 35047] resident-bytes band -- a phase was re-inlined, a relocation was reverted, or the file grew unreviewed"
fi
end_case pr-ready-skill-size-band

# --- case 27: E22/E23 prevention prose pins -----------------------------------------------
# Pins the load-bearing phrases added by this PR's prevention work so a prose gutting is
# caught immediately rather than discovered in a future /pr-ready Phase 6 review.
begin_case
# 27a: E22 Class B — pre-commit scope-reconciliation step. Removing the numstat command
# from _phase65-remediation.md step 4 makes this fail.
grep -qF 'git diff --numstat HEAD' "$SCRIPT_DIR/../.claude/skills/pr-ready/_phase65-remediation.md" \
  || fail "27a: _phase65-remediation.md lost 'git diff --numstat HEAD' — E22 Class B prevention removed"
# 27b: E22 Class B — body correction command. Removing the gh pr edit line from step 4
# makes this fail.
grep -qF 'gh pr edit' "$SCRIPT_DIR/../.claude/skills/pr-ready/_phase65-remediation.md" \
  || fail "27b: _phase65-remediation.md lost 'gh pr edit' — E22 Class B prevention removed"
# 27c: E23 — named-constant-volume check (sub-clause 4a). Removing the 4a sub-clause from
# _plan-fidelity-review.md makes this fail.
grep -qF 'inheriting its blocking verdict' "$SCRIPT_DIR/../.claude/skills/pr-ready/_plan-fidelity-review.md" \
  || fail "27c: _plan-fidelity-review.md lost 'inheriting its blocking verdict' — E23 4a sub-clause removed"
# 27d: E23 — EXPECTED constant array check. Removing the named-constant prose from 4a
# makes this fail.
grep -qF '`EXPECTED` constant array' "$SCRIPT_DIR/../.claude/skills/pr-ready/_plan-fidelity-review.md" \
  || fail "27d: _plan-fidelity-review.md lost '\`EXPECTED\` constant array' — E23 4a sub-clause removed"
# 27e: coupling pin — "all six 6d checks" in 6a and "all six 6d classes" in
# _phase65-remediation.md forbid a 7th 6d class item; changing this count breaks both
# coupling statements and makes this fail.
grep -qF 'all six 6d checks' "$SCRIPT_DIR/../.claude/skills/pr-ready/_plan-fidelity-review.md" \
  || fail "27e: _plan-fidelity-review.md lost 'all six 6d checks' — coupling that forbids a 7th 6d class item removed"
end_case e22-e23-prevention-prose-pins

# --- case 28 (pr-ready skill block): merge-digest extraction + body shape ---
# Tests the digest.sh script (Phase 4) and the prose contracts in the four edited files.
# Four arms:
#   28a: a well-formed DIGEST section extracts verbatim (5 lines, correct labels, exact body)
#   28b: missing DIGEST section degrades to 5 placeholders (all "unavailable —", rc=0)
#   28c: 3-line DIGEST degrades wholly — no partial mix of real and placeholder
#   28d–f: label drift, absent/empty file, missing argument
#   28g: assembled-body ordering — ### Merge digest sits between fidelity and remediation,
#        <!-- pr-ready-verdict --> is the last line
#   28h–k: prose pins for the four edited files (DIGEST contract, labels, last_verified)
# The placeholder uses an em dash (U+2014) — not a hyphen. A hyphen here fails 28b.
begin_case pr-ready-merge-digest-shape

D="$PRD/scripts/digest.sh"
DG="$SCRATCH/digest"; mkdir -p "$DG"

[[ -x "$D" ]] || fail "28: $D missing or not executable — Phase 4 chmod +x skipped"
bash -n "$D" 2>/dev/null || fail "28: digest.sh is not valid bash"

LABELS=( '**What changed:**' '**Why:**' '**Watch:**' '**Touches:**' '**Machine-authored fixes:**' )

# --- 28a: well-formed digest extracts verbatim ---
FIX="$DG/a.md"
cat > "$FIX" <<'FIX_A'
Plan fidelity: the diff matches the plan.

PASS

## DIGEST
**What changed:** Added a five-line merge digest to the pr-ready sticky comment.
**Why:** Prose and one new script; no runtime behavior on the PR itself changes.
**Watch:** .claude/skills/pr-ready/** and bin/test-pr-ready-now.
**Touches:** none.
**Machine-authored fixes:** Digest text is model-authored and unverified against the diff.
FIX_A
out=$(bash "$D" "$FIX" 2>&1); rc=$?
[[ $rc -eq 0 ]] || fail "28a: rc=$rc (expected 0)"
[[ $(printf '%s\n' "$out" | wc -l | tr -d ' ') -eq 5 ]] || fail "28a: expected 5 lines, got $(printf '%s\n' "$out" | wc -l | tr -d ' ')"
for i in 0 1 2 3 4; do
  line=$(printf '%s\n' "$out" | sed -n "$((i+1))p")
  [[ "$line" == "${LABELS[$i]}"* ]] || fail "28a: line $((i+1)) does not start with ${LABELS[$i]}"
done
grep -qF 'Added a five-line merge digest' <<<"$out" || fail "28a: body text not preserved verbatim"
grep -qF 'unavailable' <<<"$out" && fail "28a: placeholder emitted for a valid digest"
grep -qxF 'PASS' <<<"$out" && fail "28a: verdict word leaked into digest output"

# --- 28b: no DIGEST section → 5 unavailable lines ---
FIX="$DG/b.md"
cat > "$FIX" <<'FIX_B'
Plan fidelity: the diff matches the plan.

PASS
FIX_B
out=$(bash "$D" "$FIX" 2>&1); rc=$?
[[ $rc -eq 0 ]] || fail "28b: rc=$rc (expected 0)"
[[ $(printf '%s\n' "$out" | wc -l | tr -d ' ') -eq 5 ]] || fail "28b: expected 5 lines, got $(printf '%s\n' "$out" | wc -l | tr -d ' ')"
for i in 0 1 2 3 4; do
  line=$(printf '%s\n' "$out" | sed -n "$((i+1))p")
  [[ "$line" == "${LABELS[$i]} unavailable"* ]] || fail "28b: line $((i+1)) not a placeholder: $line"
done
grep -qF 'Plan fidelity' <<<"$out" && fail "28b: file content leaked into degrade output"

# --- 28c: 3-line DIGEST degrades wholly (not partially) ---
FIX="$DG/c.md"
cat > "$FIX" <<'FIX_C'
PASS

## DIGEST

**What changed:** Something.
**Why:** Reasons.
**Watch:** Small.
FIX_C
out=$(bash "$D" "$FIX" 2>&1); rc=$?
[[ $rc -eq 0 ]] || fail "28c: rc=$rc (expected 0)"
[[ $(printf '%s\n' "$out" | wc -l | tr -d ' ') -eq 5 ]] || fail "28c: expected 5 lines, got $(printf '%s\n' "$out" | wc -l | tr -d ' ')"
for i in 0 1 2 3 4; do
  line=$(printf '%s\n' "$out" | sed -n "$((i+1))p")
  [[ "$line" == "${LABELS[$i]} unavailable"* ]] || fail "28c: line $((i+1)) not a placeholder: $line"
done
grep -qF 'Something.' <<<"$out" && fail "28c: partial digest emitted — first 3 lines kept real text, last 2 placeholdered"

# --- 28d: label drift → all 5 unavailable ---
FIX="$DG/d.md"
cat > "$FIX" <<'FIX_D'
PASS

## DIGEST
**What changed:** Something.
**Why this is safe:** Drift.
**Watch:** nothing specific.
**Touches:** bin/.
**Machine-authored fixes:** none.
FIX_D
out=$(bash "$D" "$FIX" 2>&1); rc=$?
[[ $rc -eq 0 ]] || fail "28d: rc=$rc (expected 0)"
[[ $(printf '%s\n' "$out" | wc -l | tr -d ' ') -eq 5 ]] || fail "28d: expected 5 lines"
for i in 0 1 2 3 4; do
  line=$(printf '%s\n' "$out" | sed -n "$((i+1))p")
  [[ "$line" == "${LABELS[$i]} unavailable"* ]] || fail "28d: line $((i+1)) not a placeholder: $line"
done

# --- 28e: absent and empty file ---
out=$(bash "$D" "$DG/nope.md" 2>&1); rc=$?
[[ $rc -eq 0 ]] || fail "28e: absent file rc=$rc (expected 0)"
[[ $(printf '%s\n' "$out" | wc -l | tr -d ' ') -eq 5 ]] || fail "28e: absent file expected 5 lines"
for i in 0 1 2 3 4; do
  line=$(printf '%s\n' "$out" | sed -n "$((i+1))p")
  [[ "$line" == "${LABELS[$i]} unavailable"* ]] || fail "28e: absent: line $((i+1)) not a placeholder"
done
: > "$DG/empty.md"
out=$(bash "$D" "$DG/empty.md" 2>&1); rc=$?
[[ $rc -eq 0 ]] || fail "28e: empty file rc=$rc (expected 0)"
[[ $(printf '%s\n' "$out" | wc -l | tr -d ' ') -eq 5 ]] || fail "28e: empty file expected 5 lines"
for i in 0 1 2 3 4; do
  line=$(printf '%s\n' "$out" | sed -n "$((i+1))p")
  [[ "$line" == "${LABELS[$i]} unavailable"* ]] || fail "28e: empty: line $((i+1)) not a placeholder"
done

# --- 28f: missing argument → STOP + exit 1 ---
out=$(bash "$D" 2>&1); rc=$?
[[ $rc -eq 1 ]] || fail "28f: missing arg rc=$rc (expected 1)"
grep -qF 'STOP:' <<<"$out" || fail "28f: missing arg: expected STOP: in output"

# --- 28g: assembled-body ordering ---
BODY="$DG/body.md"
{ printf '### Plan fidelity\nPASS\n\n### Merge digest\n%s\n\n### Remediation\nnone\n\n<!-- pr-ready-verdict -->\n' "$out2"; } > "$BODY"
# Use fixture A output for the digest lines
out_a=$(bash "$D" "$DG/a.md" 2>&1)
{ printf '### Plan fidelity\nPASS\n\n### Merge digest\n%s\n\n### Remediation\nnone\n\n<!-- pr-ready-verdict -->\n' "$out_a"; } > "$BODY"
n_fid=$(grep -n '^### Plan fidelity' "$BODY" | head -1 | cut -d: -f1)
n_dig=$(grep -n '^### Merge digest' "$BODY" | head -1 | cut -d: -f1)
n_rem=$(grep -n '^### Remediation' "$BODY" | head -1 | cut -d: -f1)
[[ $n_fid -lt $n_dig ]] || fail "28g: ### Plan fidelity must precede ### Merge digest"
[[ $n_dig -lt $n_rem ]] || fail "28g: ### Merge digest must precede ### Remediation"
n_dig_count=$(grep -c '^### Merge digest' "$BODY" || true)
[[ $n_dig_count -eq 1 ]] || fail "28g: expected exactly 1 ### Merge digest, got $n_dig_count"
[[ "$(tail -1 "$BODY")" == '<!-- pr-ready-verdict -->' ]] || fail "28g: <!-- pr-ready-verdict --> must be last line"
[[ $(grep -c '^<!-- pr-ready-verdict -->$' "$BODY" || true) -eq 1 ]] || fail "28g: expected exactly 1 marker"

# --- 28h: .claude/agents/pr-ready-phase6.md prose pins ---
f="$PRD/../../agents/pr-ready-phase6.md"
grep -qF '## DIGEST' "$f" || fail "28h: ## DIGEST missing from pr-ready-phase6.md"
grep -qF '**What changed:**' "$f" || fail "28h: **What changed:** missing from pr-ready-phase6.md"
grep -qF '**Why:**' "$f" || fail "28h: **Why:** missing from pr-ready-phase6.md"
grep -qF '**Watch:**' "$f" || fail "28h: **Watch:** missing from pr-ready-phase6.md"
grep -qF '**Touches:**' "$f" || fail "28h: **Touches:** missing from pr-ready-phase6.md"
grep -qF '**Machine-authored fixes:**' "$f" || fail "28h: **Machine-authored fixes:** missing from pr-ready-phase6.md"
grep -qF 'and nothing after it' "$f" || fail "28h: 'and nothing after it' missing from pr-ready-phase6.md"
grep -qE '^last_verified: 2026-09-04$' "$f" || fail "28h: last_verified not bumped to 2026-09-04 in pr-ready-phase6.md"

# --- 28i: _plan-fidelity-review.md prose pins ---
f="$PRD/_plan-fidelity-review.md"
grep -qF '## DIGEST' "$f" || fail "28i: ## DIGEST missing from _plan-fidelity-review.md"
grep -qF 'descriptive, never a verdict' "$f" || fail "28i: 'descriptive, never a verdict' missing from _plan-fidelity-review.md"

# --- 28j: _phase7-verdict.md prose pins ---
f="$PRD/_phase7-verdict.md"
grep -qF 'scripts/digest.sh' "$f" || fail "28j: digest.sh materialise line missing from _phase7-verdict.md"
n_merge=$(grep -c '### Merge digest' "$f" || true)
[[ $n_merge -eq 2 ]] || fail "28j: expected exactly 2 '### Merge digest' in _phase7-verdict.md, got $n_merge"
grep -qF '**What changed:**' "$f" || fail "28j: **What changed:** missing from _phase7-verdict.md"
grep -qF '**Why:**' "$f" || fail "28j: **Why:** missing from _phase7-verdict.md"
grep -qF '**Watch:**' "$f" || fail "28j: **Watch:** missing from _phase7-verdict.md"
grep -qF '**Touches:**' "$f" || fail "28j: **Touches:** missing from _phase7-verdict.md"
grep -qF '**Machine-authored fixes:**' "$f" || fail "28j: **Machine-authored fixes:** missing from _phase7-verdict.md"
grep -qF 'a stable-shaped degraded block is' "$f" || fail "28j: degraded-block clause missing from _phase7-verdict.md"

# --- 28k: SKILL.md prose pins ---
f="$PRD/SKILL.md"
grep -qF '## DIGEST' "$f" || fail "28k: ## DIGEST missing from SKILL.md"
grep -qF 'scripts/digest.sh' "$f" || fail "28k: scripts/digest.sh missing from SKILL.md"
n_skill_merge=$(grep -c '### Merge digest' "$f" || true)
[[ $n_skill_merge -eq 2 ]] || fail "28k: expected exactly 2 '### Merge digest' in SKILL.md, got $n_skill_merge"
grep -qE '^last_verified: 2026-09-06$' "$f" || fail "28k: last_verified not bumped in SKILL.md"
n_ends_in_one=$(grep -c 'the file ends in one' "$f" || true)
[[ $n_ends_in_one -eq 0 ]] || fail "28k: 'the file ends in one' still present in SKILL.md — stale claim not removed"

# --- 28l: trailing space on ## DIGEST heading is normalised, not degraded ---
FIX="$DG/l.md"
printf 'READY\n## DIGEST \n**What changed:** trailing-space fix\n**Why:** grep and awk agree\n**Watch:** nothing specific\n**Touches:** digest.sh\n**Machine-authored fixes:** none\n' > "$FIX"
out=$(bash "$D" "$FIX" 2>&1); rc=$?
[[ $rc -eq 0 ]] || fail "28l: rc=$rc (expected 0) — trailing-space heading degraded"
[[ $(printf '%s\n' "$out" | wc -l | tr -d ' ') -eq 5 ]] || fail "28l: expected 5 lines, got $(printf '%s\n' "$out" | wc -l | tr -d ' ')"
grep -qF 'unavailable' <<<"$out" && fail "28l: trailing-space heading produced unavailable placeholder: $out" || true

end_case pr-ready-merge-digest-shape

# --- case pr-ready-terminator-still-forbids ----------------------------------------------
