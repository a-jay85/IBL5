export POSTPLAN_FIX_STATE_DIR="" POSTPLAN_FIX_DISCORD_DM="" POSTPLAN_FIX_USAGE_JSON="" POSTPLAN_FIX_POST_PLAN_NOW=""
run_fix "$SUT" --holdrepeat --dry-run 77
need "rc 0 (stderr: $ERR)" test "$RC" = 0
need "final line" final_is "$STDOUT" dry-run
need "state-dir default" line_re "$STDOUT" '^state-dir=.*/main/tools/postplan-harness/out/state$'
need "dm-bin default" line_re "$STDOUT" '^dm-bin=.*/main/bin/discord-dm$'
need "usage-source default" has_s "$STDOUT" "usage-source=live"
need "post-plan-now-bin default" line_re "$STDOUT" '^post-plan-now-bin=.*/main/bin/post-plan-now$'
rm -rf "$HR_DEF_STATE"
case_end holdrepeat-empty-env
fi

# 30
