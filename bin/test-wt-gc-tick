printf '123\t0\tcom.ibl5.postplan-now-e-old-1-2\n' > "$CD/labels1"
printf -- '-\t0\tcom.ibl5.pr-cycle-1-2\n' > "$CD/labels2"
rt "${E_ON[@]}" STUB_LAUNCHCTL_LIST="$CD/labels1" -- --force
