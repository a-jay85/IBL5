need "run 2: DM lists the MISSING item" dm_has "bin/test-widget"
need "run 2: DM lists the MISSING-FILE item" dm_has "bin/widget-tool"
need "run 2: each item listed once" test "$(grep -c 'bin/widget-tool' "$TMP/dm.log")" = 1
hr_run
need "run 3: final line" final_is "$STDOUT" gave-up-repeat
need "run 3: dm=no sends nothing" test "$(dm_count)" = 1
case_end holdrepeat-giveup-dm-lists-items
fi

