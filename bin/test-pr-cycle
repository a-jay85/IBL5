run --dry-run
[[ "$OUT" == "$BARE" ]] || fail "--dry-run output differs from the bare form"
end_case "case 20 dry-run default"

# ==========================================================================================
# 21 / 22 / 23 — artifact generation under --go
# ==========================================================================================
begin_case
reset_state
TSPIN="${TSBASE}1"
PLIST="$SCRATCH/Library/LaunchAgents/com.ibl5.pr-cycle-$TSPIN.plist"
RUNNER="/tmp/pr-cycle-$TSPIN.sh"
rm -f "$RUNNER" "/tmp/pr-cycle-$TSPIN.log" "$PLIST"
PR_CYCLE_DRY_LAUNCH=1 TSPIN="$TSPIN" run --go
[[ $RC -eq 0 ]] || fail "--go (dry launch) exit $RC, want 0"
[[ -f "$PLIST" ]] || fail "no plist at $PLIST"
grep -qF "<string>com.ibl5.pr-cycle-$TSPIN</string>" "$PLIST" || fail "plist Label wrong"
grep -qF '<key>KeepAlive</key><false/>' "$PLIST" || fail "plist KeepAlive is not false"
[[ "$(grep -c "<string>/tmp/pr-cycle-$TSPIN.log</string>" "$PLIST")" == "2" ]] \
    || fail "plist stdout/stderr paths do not both point at the printed log"
grep -qF '/usr/bin' "$PLIST" || fail "plist PATH lacks /usr/bin"
grep -qF '${' "$PLIST" && fail "plist has an unexpanded \${...} sequence"
grep -qF '<string></string>' "$PLIST" && fail "plist has an empty <string></string> value"
grep -qF "log=/tmp/pr-cycle-$TSPIN.log" <<< "$OUT" || fail "--go did not print the log path"

[[ -x "$RUNNER" ]] || fail "runner not executable"
bash -n "$RUNNER" || fail "runner does not parse"
grep -qF -- '--worker' "$RUNNER" || fail "runner does not carry --worker"
grep -qF "NO_DM=''" "$RUNNER" || fail "runner NO_DM not empty by default"
grep -qE '^export PR_CYCLE_SKIP_READY_WHEN_ARMABLE=' "$RUNNER" \
    || fail "runner does not export the ARMABLE-skip seam"
grep -qE '^export PR_CYCLE_SKIP_HELD_UNCHANGED=' "$RUNNER" \
    || fail "runner does not export the SKIP_HELD_UNCHANGED seam"
_rv_maxready="$(bash -c "$(grep -m1 '^MAX_READY=' "$RUNNER"); printf '%s' \"\$MAX_READY\"")"
[[ "$_rv_maxready" == "10" ]] || fail "runner MAX_READY='$_rv_maxready', want 10"
_rv_jobs="$(bash -c "$(grep -m1 '^JOBS=' "$RUNNER"); printf '%s' \"\$JOBS\"")"
[[ "$_rv_jobs" == "3" ]] || fail "runner JOBS='$_rv_jobs', want 3"
! grep -q 'PR_CYCLE_POLL_' "$RUNNER" || fail "runner still exports PR_CYCLE_POLL_ vars"

rm -f "$RUNNER" "$PLIST"
PR_CYCLE_DRY_LAUNCH=1 TSPIN="$TSPIN" run --go --max-ready 4 --jobs 2
_rv_mr4="$(bash -c "$(grep -m1 '^MAX_READY=' "$RUNNER"); printf '%s' \"\$MAX_READY\"")"
_rv_j2="$(bash -c "$(grep -m1 '^JOBS=' "$RUNNER"); printf '%s' \"\$JOBS\"")"
[[ "$_rv_mr4" == "4" ]] || fail "--max-ready 4: runner MAX_READY='$_rv_mr4', want 4"
[[ "$_rv_j2" == "2" ]] || fail "--jobs 2: runner JOBS='$_rv_j2', want 2"

rm -f "$RUNNER" "$PLIST"
PR_CYCLE_DRY_LAUNCH=1 TSPIN="$TSPIN" run --go --no-dm
grep -qF "NO_DM=1" "$RUNNER" || fail "--no-dm did not reach the runner"

# 23a — artifact collision refuses without writing a plist
rm -f "$PLIST"
PR_CYCLE_DRY_LAUNCH=1 TSPIN="$TSPIN" run --go
[[ $RC -eq 1 ]] || fail "runner collision: exit $RC, want 1"
[[ ! -e "$PLIST" ]] || fail "runner collision still wrote a plist"

# 23b — a pre-existing stop file refuses
rm -f "$RUNNER" "$PLIST"
: > "$SCRATCH/.ibl5-pr-cycle.stop"
PR_CYCLE_DRY_LAUNCH=1 TSPIN="$TSPIN" run --go
[[ $RC -eq 1 ]] || fail "stop file present: exit $RC, want 1"
[[ -e "$SCRATCH/.ibl5-pr-cycle.stop" ]] || fail "the driver removed the stop file"
rm -f "$SCRATCH/.ibl5-pr-cycle.stop" "$RUNNER" "$PLIST" "/tmp/pr-cycle-$TSPIN.log"
unset TSPIN
end_case "case 21/22/23 artifacts"

# ==========================================================================================
