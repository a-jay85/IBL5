need "origin moved" test "$(origin_hr)" != "$HR_TIP"
need "commit subject" has_s "$(git -C "$WTH" log -1 --format=%s)" "chore(postplan-fix): resolve repeat-hold items ("
need "one post-plan call" test "$(ppn_count)" = 1
need "post-plan args" ppn_has "args=--pr 77 --foreground"
need "ledger outcome" ledger_has "fixed-refire-rc=0"
need "refire line" has_s "$STDOUT" "holdrepeat refire rc=0"
case_end holdrepeat-fixed-refires
fi

