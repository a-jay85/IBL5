    run_watch
    h_eq "near-miss slug: no-trace DM" 1 "$(cnt discord-dm)"
    h_eq "near-miss slug: key" "pl-0001:no-trace:none" "$(slurp "$S/home/.cache/jsb-parity-stalls.txt")"
}

case_plannow_unattributable_waits() {
    sandbox plannow_missing
    printf -- '-\t0\tcom.ibl5.plan-now-20261123-012805-44230\n' > "$S/fix/launchctl-list"
    run_watch
    no_actions "plan-now log missing"
    h_contains "plan-now log missing: verdict is a wait" "$(out)" "WAIT:plan-now-unattributed"
}

