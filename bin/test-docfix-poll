  || bad "(23e) salvage arm must report 'could not remove' and skip branch -D when wt-remove fails"

# Test 24: reaper prints "could not reap" when bin/cleanup exits non-zero
# (named mode exits 3 on SKIP, IBL5-backlog#1244).
# _reap_case <label> <pr_state> <cleanup_rc> <expect: reaped|not-reaped>
_reap_case() {
    local label="$1" pr_state="$2" rc="$3" expect="$4" SB pass=true
    SB="$(_wt_sandbox)"
    SHIM_STALE_JSON="$STALE_ONE" SHIM_ISSUE_OUT="77" \
        SHIM_BRANCH_OUT="$B_OLD" SHIM_LS_REMOTE="" \
        SHIM_REFLOG_OUT="$REFLOG_OLD" SHIM_WORKTREE_LIST="$(_wl "$SB")" \
        SHIM_STATUS_OUT="" SHIM_LAUNCHCTL_OUT="" \
        SHIM_PR_STATE="$pr_state" SHIM_CLEANUP_RC="$rc" \
        run_poll_split "$SB"
    grep -qx "$B_OLD" "$SB/cleanup-calls" 2>/dev/null || pass=false
    if [ "$expect" = "reaped" ]; then
        grep -qF "docfix-poll: reaped '$B_OLD' (PR ${pr_state})." "$POLL_OUT_FILE" || pass=false
        ! grep -qF 'could not reap' "$POLL_ERR_FILE" || pass=false
    else
        grep -qF "docfix-poll: could not reap '$B_OLD'" "$POLL_ERR_FILE" || pass=false
        ! grep -qF "reaped '$B_OLD'" "$POLL_OUT_FILE" || pass=false
    fi
    $pass && ok "$label" || bad "$label"
}
_reap_case "(24a) MERGED + cleanup rc 3: could not reap, no reaped line" MERGED 3 not-reaped
_reap_case "(24b) MERGED + cleanup rc 0: reaped line, no could-not-reap" MERGED 0 reaped
_reap_case "(24c) CLOSED + cleanup rc 3: could not reap, no reaped line" CLOSED 3 not-reaped

# Test 25: wedged alert states a failed-attempt count, not an automatic-salvage promise.
SB="$(build_sandbox)"
WL25="$(_wl "$SB")"
OUT25A="$(SHIM_STALE_JSON="$STALE_ONE" SHIM_PR_OPEN="" \
    SHIM_LS_REMOTE="" SHIM_PR_FOR_BRANCH=0 \
    SHIM_BRANCH_OUT="$B_OLD" SHIM_REFLOG_OUT="$REFLOG_OLD" \
    SHIM_LAUNCHCTL_OUT="" SHIM_WORKTREE_LIST="$WL25" \
    run_health "$SB" 77)"
OUT25B="$(SHIM_STALE_JSON="$STALE_ONE" SHIM_PR_OPEN="" \
    SHIM_LS_REMOTE="" SHIM_PR_FOR_BRANCH=0 \
    SHIM_BRANCH_OUT="$B_OLD" SHIM_REFLOG_OUT="" \
    SHIM_LAUNCHCTL_OUT="" SHIM_WORKTREE_LIST="$WL25" \
    run_health "$SB" 77)"
OUT25C="$(SHIM_STALE_JSON="$STALE_ONE" SHIM_PR_OPEN="" \
    SHIM_LS_REMOTE="" SHIM_PR_FOR_BRANCH=0 \
    SHIM_BRANCH_OUT="$B_OLD" SHIM_REFLOG_OUT="$REFLOG_5H" \
    SHIM_LAUNCHCTL_OUT="" SHIM_WORKTREE_LIST="$WL25" \
    run_health "$SB" 77)"
printf '%s\n' "$OUT25A" | grep -qxF "detail=Local branch $B_OLD has no origin ref and no in-flight launchd run — the doc-fix run died before pushing. It has survived 2 nightly salvage attempt(s) and needs a manual look." \
  && ok "(25a) wedged detail: 48h age reports 2 failed salvage attempts" \
  || bad "(25a) wedged detail with known age"
printf '%s\n' "$OUT25B" | grep -qxF "detail=Local branch $B_OLD has no origin ref and no in-flight launchd run — the doc-fix run died before pushing. Failed salvage attempts: unknown (branch reflog expired); it needs a manual look." \
  && ok "(25b) wedged detail: unknown age says the count is unknown" \
  || bad "(25b) wedged detail with unknown age"
printf '%s\n' "$OUT25C" | grep -qF 'It has survived 1 nightly salvage attempt(s)' \
  && ok "(25c) wedged detail: 5h age floors at 1 attempt" \
  || bad "(25c) wedged detail attempt-count floor"
{ [ "$(printf '%s\n' "$OUT25A" | grep -c '^')" -eq 3 ] \
    && [ "$(printf '%s\n' "$OUT25B" | grep -c '^')" -eq 3 ] \
    && ! printf '%s\n' "$OUT25A" "$OUT25B" | grep -q 'salvage it automatically'; } \
  && ok "(25d) wedged outputs stay 3 lines and drop the automatic-salvage promise" \
  || bad "(25d) wedged outputs: 3-line contract / no automatic-salvage promise"

# (25e) Same 5h local-only branch as 25c, but its docfix-run job is loaded: the
# run is alive, so the health arm must not call it wedged. This is the 2026-11-23
# false alert: a warm-pool slot carried a 4h25m reflog age into a run that had
# just started, and the interlock read the live job as gone.
OUT25E="$(SHIM_STALE_JSON="$STALE_ONE" SHIM_PR_OPEN="" \
    SHIM_LS_REMOTE="" SHIM_PR_FOR_BRANCH=0 \
    SHIM_BRANCH_OUT="$B_OLD" SHIM_REFLOG_OUT="$REFLOG_5H" \
    SHIM_LAUNCHCTL_OUT="$(printf '4242\t0\tcom.ibl5.docfix-run-%s-20261123-210514-1' "$B_OLD")" \
    SHIM_WORKTREE_LIST="$WL25" \
    run_health "$SB" 77)"
{ grep -q '^alert=' <<< "$OUT25E" && ! grep -qxF 'kind=wedged' <<< "$OUT25E"; } \
  && ok "(25e) live job: 5h-old branch with a loaded docfix-run job is not wedged" \
  || bad "(25e) live job: health arm called a running branch wedged (or printed no report)"

# ---------------------------------------------------------------------------
# Test 26 (row 24): the poller joins docs-content-review-* PRs (bin/docfix-split's
# held pile) at its counting, listing, health and wedge sites, and never reaps one.
# Sites that filter inside --jq run on the raw-mode gh shim (SHIM_GH_PR_LIST_JSON),
# so a reverted filter fails here instead of passing on a post-jq value.
# ---------------------------------------------------------------------------
R_OLD="docs-content-review-20260802"
TS_1H="$(_ts_ago 3600)"
STALE_AB='[{"path":"a.md"},{"path":"b.md"}]'
RED_ROLLUP='[{"conclusion":"FAILURE"}]'
# _pr NUM HEAD STATE MERGED_AT FILES_CSV ROLLUP CREATED -> one raw PR object
_pr() {
    jq -nc --argjson n "$1" --arg h "$2" --arg s "$3" --arg m "$4" --arg f "$5" \
        --argjson r "$6" --arg c "$7" \
        '{number:$n, headRefName:$h, state:$s, url:("https://example.test/pr/" + ($n|tostring)),
          mergedAt:(if $m == "" then null else $m end), autoMergeRequest:null,
          files:($f | split(",") | map(select(. != "")) | map({path:.})),
          statusCheckRollup:$r, createdAt:$c}'
}
_prs() { jq -sc '.' <<< "$*"; }

# (26a) declined: closed-unmerged refresh PR covered a.md and closed-unmerged review
# PR covered b.md, so the union covers the whole stale set and the poll stays quiet.
SB="$(build_sandbox)"
RAW26A="$(_prs "$(_pr 10 docs-stale-refresh-20260801 CLOSED '' a.md '[]' "$TS_48H")" \
               "$(_pr 11 "$R_OLD" CLOSED '' b.md '[]' "$TS_48H")")"
SHIM_GH_PR_LIST_JSON="$RAW26A" SHIM_STALE_JSON="$STALE_AB" SHIM_ISSUE_OUT="77" \
    SHIM_BRANCH_OUT="" SHIM_LAUNCHCTL_OUT="" run_poll_split "$SB"
{ [ ! -f "$SB/docfix-calls" ] && grep -qF 'a human declined a refresh covering all 2' "$POLL_OUT_FILE"; } \
  && ok "(26a) declined review PR's files join the declined set: poll stays quiet" \
  || bad "(26a) declined review PR not counted ($(cat "$POLL_OUT_FILE" "$POLL_ERR_FILE"))"
# Control: without the declined review PR, b.md is uncovered and the poll fires.
SB="$(build_sandbox)"
RAW26A2="$(_prs "$(_pr 10 docs-stale-refresh-20260801 CLOSED '' a.md '[]' "$TS_48H")")"
SHIM_GH_PR_LIST_JSON="$RAW26A2" SHIM_STALE_JSON="$STALE_AB" SHIM_ISSUE_OUT="77" \
    SHIM_BRANCH_OUT="" SHIM_LAUNCHCTL_OUT="" run_poll_split "$SB"
[ -f "$SB/docfix-calls" ] \
  && ok "(26a) control: refresh-only decline leaves b.md uncovered, poll fires" \
  || bad "(26a) control: poll should fire when b.md is uncovered"

# (26b) DM list: an open review PR is listed; an open feature-x PR is not.
SB="$(build_sandbox)"
CALLS26B="$SB/gh-calls"
RAW26B="$(_prs "$(_pr 88 docs-content-review-20260803 OPEN '' a.md '[]' "$TS_1H")" \
               "$(_pr 89 feature-x OPEN '' a.md '[]' "$TS_1H")")"
SHIM_GH_PR_LIST_JSON="$RAW26B" SHIM_GH_CALLS="$CALLS26B" SHIM_STALE_JSON='[]' \
    SHIM_BRANCH_OUT="" SHIM_LAUNCHCTL_OUT="" run_poll_split "$SB"
{ grep -qF 'docs-refreshed-notify.yml -f pr_number=88' "$CALLS26B" \
    && ! grep -qF 'pr_number=89' "$CALLS26B"; } \
  && ok "(26b) DM list includes the open review PR #88 and skips feature-x #89" \
  || bad "(26b) DM list ($(cat "$CALLS26B" 2>/dev/null))"

# (26c) red CI on an open review PR is reported when nothing else alerted.
SB="$(build_sandbox)"
RAW26C="$(_prs "$(_pr 88 docs-content-review-20260803 OPEN '' a.md "$RED_ROLLUP" "$TS_1H")")"
OUT="$(SHIM_GH_PR_LIST_JSON="$RAW26C" SHIM_STALE_JSON="$STALE_ONE" SHIM_LS_REMOTE="" \
    SHIM_ISSUE_BODY="<!-- stale-since: $TS_48H -->" SHIM_BRANCH_OUT="" \
    SHIM_REFLOG_OUT="" SHIM_LAUNCHCTL_OUT="" run_health "$SB" 77)"; RC=$?
_if_case "26c" true "ci-red" "open review PR with red CI: alert=true kind=ci-red"
grep -qxF 'detail=Content-review PR https://example.test/pr/88 has 1 failing check(s) — the held doc edits need a fix before you can merge them.' <<< "$OUT" \
  && ok "(26c) ci-red detail names the review PR URL and the failing-check count" \
  || bad "(26c) ci-red detail ($OUT)"

# (26d) last_pr anchor: a review PR opened 1h ago counts as a run, so a 48h-old
# stale episode does not alert never-ran. Control: no review PR -> never-ran.
SB="$(build_sandbox)"
RAW26D="$(_prs "$(_pr 12 docs-content-review-20260803 MERGED "$TS_1H" '' '[]' "$TS_1H")")"
OUT="$(SHIM_GH_PR_LIST_JSON="$RAW26D" SHIM_STALE_JSON="$STALE_ONE" SHIM_LS_REMOTE="" \
    SHIM_ISSUE_BODY="<!-- stale-since: $TS_48H -->" SHIM_BRANCH_OUT="" \
    SHIM_REFLOG_OUT="" SHIM_LAUNCHCTL_OUT="" run_health "$SB" 77)"; RC=$?
_if_case "26d" false "" "review PR opened 1h ago anchors last_pr: never-ran stays quiet"
RAW26D2="$(_prs "$(_pr 13 feature-x MERGED "$TS_1H" '' '[]' "$TS_1H")")"
OUT="$(SHIM_GH_PR_LIST_JSON="$RAW26D2" SHIM_STALE_JSON="$STALE_ONE" SHIM_LS_REMOTE="" \
    SHIM_ISSUE_BODY="<!-- stale-since: $TS_48H -->" SHIM_BRANCH_OUT="" \
    SHIM_REFLOG_OUT="" SHIM_LAUNCHCTL_OUT="" run_health "$SB" 77)"; RC=$?
_if_case "26d" true "never-ran" "control: only a feature-x PR, 48h episode: never-ran fires"

# (26e) never-ran stays quiet when every stale path is held in an open review PR
# with green CI. Control: the review PR holds a different path -> never-ran.
SB="$(build_sandbox)"
RAW26E="$(_prs "$(_pr 88 docs-content-review-20260801 OPEN '' a.md '[]' "$TS_48H")")"
OUT="$(SHIM_GH_PR_LIST_JSON="$RAW26E" SHIM_STALE_JSON="$STALE_ONE" SHIM_LS_REMOTE="" \
    SHIM_ISSUE_BODY="<!-- stale-since: $TS_48H -->" SHIM_BRANCH_OUT="" \
    SHIM_REFLOG_OUT="" SHIM_LAUNCHCTL_OUT="" run_health "$SB" 77)"; RC=$?
_if_case "26e" false "" "every stale path held in an open review PR: never-ran stays quiet"
RAW26E2="$(_prs "$(_pr 88 docs-content-review-20260801 OPEN '' b.md '[]' "$TS_48H")")"
OUT="$(SHIM_GH_PR_LIST_JSON="$RAW26E2" SHIM_STALE_JSON="$STALE_ONE" SHIM_LS_REMOTE="" \
    SHIM_ISSUE_BODY="<!-- stale-since: $TS_48H -->" SHIM_BRANCH_OUT="" \
    SHIM_REFLOG_OUT="" SHIM_LAUNCHCTL_OUT="" run_health "$SB" 77)"; RC=$?
_if_case "26e" true "never-ran" "control: a.md not held, 48h episode: never-ran fires"

# (26f) the died alert still fires beside a red review PR (the review check runs
# only while no alert has fired).
SB="$(build_sandbox)"
OUT="$(SHIM_GH_PR_LIST_JSON="$RAW26C" SHIM_STALE_JSON="$STALE_ONE" \
    SHIM_LS_REMOTE="$(printf 'abc\trefs/heads/docs-stale-refresh-20260801')" \
    SHIM_ISSUE_BODY="<!-- stale-since: $TS_48H -->" SHIM_BRANCH_OUT="" \
    SHIM_REFLOG_OUT="" SHIM_LAUNCHCTL_OUT="" run_health "$SB" 77)"; RC=$?
_if_case "26f" true "died" "orphaned refresh branch beside a red review PR: kind=died wins"

# (26h) several review PRs open at once: a green newest PR does not hide a red
# older one, and every red PR is named. Control: all green stays quiet.
_health_26h() {   # $1 = raw PR array; prints the health report
    local SB; SB="$(build_sandbox)"
    SHIM_GH_PR_LIST_JSON="$1" SHIM_STALE_JSON="$STALE_ONE" SHIM_LS_REMOTE="" \
        SHIM_ISSUE_BODY="<!-- stale-since: $TS_48H -->" SHIM_BRANCH_OUT="" \
        SHIM_REFLOG_OUT="" SHIM_LAUNCHCTL_OUT="" run_health "$SB" 77
}
GREEN_NEW="$(_pr 90 docs-content-review-20260804 OPEN '' a.md '[]' "$TS_1H")"
OUT="$(_health_26h "$(_prs "$GREEN_NEW" \
    "$(_pr 88 docs-content-review-20260803 OPEN '' a.md "$RED_ROLLUP" "$TS_48H")")")"; RC=$?
_if_case "26h" true "ci-red" "green newest review PR, red older one: alert=true kind=ci-red"
grep -qxF 'detail=Content-review PR https://example.test/pr/88 has 1 failing check(s) — the held doc edits need a fix before you can merge them.' <<< "$OUT" \
  && ok "(26h) detail names only the red older PR" \
  || bad "(26h) older red PR detail ($OUT)"
OUT="$(_health_26h "$(_prs \
    "$(_pr 90 docs-content-review-20260804 OPEN '' a.md "$RED_ROLLUP" "$TS_1H")" \
    "$(_pr 88 docs-content-review-20260803 OPEN '' a.md "$RED_ROLLUP" "$TS_48H")")")"; RC=$?
grep -qxF 'detail=Content-review PR https://example.test/pr/90 has 1 failing check(s); Content-review PR https://example.test/pr/88 has 1 failing check(s) — the held doc edits need a fix before you can merge them.' <<< "$OUT" \
  && ok "(26h) two red review PRs are both named on one detail line" \
  || bad "(26h) two red PRs detail ($OUT)"
OUT="$(_health_26h "$(_prs "$GREEN_NEW" \
    "$(_pr 88 docs-content-review-20260803 OPEN '' a.md '[]' "$TS_48H")")")"; RC=$?
_if_case "26h" false "" "control: both review PRs green: stays quiet"

# (26g) a leftover local review branch shows as wedged in health and is never
# salvaged or reaped by the poll.
SB="$(_wt_sandbox)"
REFLOG_R_OLD="abc1234 ${R_OLD}@{${EPOCH_48H}}: branch: Created from master"
OUT="$(SHIM_STALE_JSON="$STALE_ONE" SHIM_PR_OPEN="" SHIM_LS_REMOTE="" \
    SHIM_PR_FOR_BRANCH=0 SHIM_BRANCH_OUT="$R_OLD" SHIM_REFLOG_OUT="$REFLOG_R_OLD" \
    SHIM_LAUNCHCTL_OUT="" run_health "$SB" 77)"; RC=$?
_if_case "26g" true "wedged" "leftover local review branch: kind=wedged"
grep -qxF "detail=Local branch $R_OLD has no origin ref and no in-flight launchd run — the content-review run died before pushing. The poll never salvages a review branch, so it needs a manual look." <<< "$OUT" \
  && ok "(26g) wedged detail names the review branch and claims no salvage attempt" \
  || bad "(26g) wedged detail ($OUT)"
SHIM_STALE_JSON="$STALE_ONE" SHIM_ISSUE_OUT="77" SHIM_BRANCH_OUT="$R_OLD" \
    SHIM_PR_STATE="NONE" SHIM_LS_REMOTE="" SHIM_REFLOG_OUT="$REFLOG_R_OLD" \
    SHIM_WORKTREE_LIST="$(_wl "$SB" "$R_OLD")" SHIM_STATUS_OUT="" \
    SHIM_LAUNCHCTL_OUT="" run_poll_split "$SB"
{ [ ! -f "$SB/cleanup-calls" ] && [ ! -f "$SB/git-add-calls" ] \
    && [ ! -f "$SB/wt-remove-calls" ] && [ ! -f "$SB/git-branch-d-calls" ] \
    && ! grep -qF "$R_OLD" "$POLL_OUT_FILE" "$POLL_ERR_FILE"; } \
  && ok "(26g) the poll never salvages, reaps or removes a review branch" \
  || bad "(26g) review branch touched by the reap loop"

# ---------------------------------------------------------------------------
# Test 27 (row 25): bin/lib/docfix-dm.sh accepts an OPEN review PR and leads its
# DM with the held wording; it refuses other branches and non-OPEN review PRs.
# ---------------------------------------------------------------------------
# _dm27 META OUT -> rc of docfix_dm_compose 88 OUT with a stub gh.
_dm27() {
    local d; d="$(mktemp -d)"
    cat > "$d/gh" <<'DMGH'
#!/usr/bin/env bash
case "$*" in
  *"headRefName,state,url"*) printf '%s' "$DM27_META" ;;
  *"--json files"*)          printf 'ibl5/docs/a.md' ;;
esac
DMGH
    chmod +x "$d/gh"
    ( PATH="$d:$PATH" DM27_META="$1"
      export DM27_META
      # shellcheck source=bin/lib/docfix-dm.sh
      source "$REPO_ROOT/bin/lib/docfix-dm.sh"
      docfix_dm_compose 88 "$2" ) 2>/dev/null
}
D27="$(mktemp -d)"
_dm27 $'docs-content-review-20260803\tOPEN\thttps://example.test/pr/88' "$D27/a"; RC27A=$?
{ [ "$RC27A" -eq 0 ] \
    && [ "$(head -n 1 "$D27/a")" = 'Held for content review: Claude refreshed your stale docs — ready for your review. PR #88:' ] \
    && grep -qF 'https://example.test/pr/88' "$D27/a"; } \
  && ok "(27a) DM lib: OPEN review PR accepted; text leads with 'Held for content review: '" \
  || bad "(27a) DM lib review PR (rc $RC27A: $(cat "$D27/a" 2>/dev/null))"
_dm27 $'docs-stale-refresh-20260803\tOPEN\thttps://example.test/pr/88' "$D27/r"; RC27R=$?
{ [ "$RC27R" -eq 0 ] \
    && [ "$(head -n 1 "$D27/r")" = 'Claude refreshed your stale docs — ready for your review. PR #88:' ]; } \
  && ok "(27b) DM lib: refresh PR text keeps its unprefixed first line" \
  || bad "(27b) DM lib refresh PR (rc $RC27R: $(cat "$D27/r" 2>/dev/null))"
_dm27 $'feature-x\tOPEN\thttps://example.test/pr/88' "$D27/f"; RC27F=$?
{ [ "$RC27F" -eq 1 ] && [ ! -e "$D27/f" ]; } \
  && ok "(27c) DM lib: OPEN feature-x PR refused (rc 1, no out-file)" \
  || bad "(27c) DM lib feature-x (rc $RC27F)"
_dm27 $'docs-content-review-20260803\tCLOSED\thttps://example.test/pr/88' "$D27/c"; RC27C=$?
{ [ "$RC27C" -eq 1 ] && [ ! -e "$D27/c" ]; } \
  && ok "(27d) DM lib: CLOSED review PR refused (rc 1, no out-file)" \
  || bad "(27d) DM lib CLOSED review PR (rc $RC27C)"
rm -rf "$D27"


h_done
