#!/usr/bin/env bash
# pr-cycle — serial, unattended driver that readies and arms one open PR at a time.
#
# Drives the hand-equivalent sequence: bin/pr-attack picks the order, bin/post-plan-fleet
# rebases and greens one PR, bin/pr-triage arms whatever is genuinely ARMABLE. Because
# every merge re-BEHINDs every other open PR, that sequence has to be repeated after each
# merge — this script is the loop that repeats it, detached, so a human need not sit in it.
#
# Dry-run by default: prints what it would do and exits. Nothing fires without --go.
#
# Usage:
#   bin/pr-cycle [--go] [--dry-run] [--stop] [--no-dm] [--max-ready N] [--jobs N]
#                [--only LIST | --skip LIST] [--help]
#
#   --go            Detach a worker via launchd and return. Without it the script only
#                   reports (default).
#   --dry-run       Explicit alias for the default. Useful in scripts that state intent.
#   --stop          Create the stop file, then call bin/post-plan-fleet --stop-all. The stop
#                   file is never removed by this script; clearing it is the human's
#                   explicit re-enable.
#   --no-dm         Suppress the single end-of-run Discord DM.
#   --max-ready N   Cap on PRs handed to post-plan-fleet in Stage 1 (default 10). Ordered
#                   PRs fill the cap first, then DIRTY rescues. Arming is never capped.
#   --jobs N        Concurrent readying sessions in Stage 1 (default 3).
#   --only LIST     Work ONLY these PRs. Comma-separated; a leading # is optional, so
#                   `--only 2101,2108` and `--only '#2101,#2108'` name the same set.
#                   The ORDER still comes from bin/pr-attack — this drops rows outside
#                   the set, so the dependency order among the kept PRs is unchanged.
#   --skip LIST     The inverse: work every orderable PR except these. Same format.
#                   Mutually exclusive with --only (same precedent as --go --stop).
#   --help, -h      Print this usage and exit 0.
#
# SCOPE LIMIT of --only/--skip — they scope the WORK ORDER, not the arm call. Arming is
# exactly one `bin/pr-triage --arm` with no added flags (a hard invariant below), and that
# single call arms EVERY ARMABLE PR, in-set or not. So an already-green out-of-set PR still
# lands, and it appears in neither the ready batch nor the your-turn DM as work this run did.
# Narrowing the arm call would break the one-arm invariant. What these flags actually buy
# is that no hour-long `post-plan-fleet --wait` session is ever spent on an out-of-set PR —
# which is the cost they exist to avoid.
# Runs once: Stage 1 (ready) -> Stage 2 (arm) -> your-turn DM -> exit. No loop.
#
# Env seams (used by bin/test-pr-cycle):
#   PR_CYCLE_ATTACK_CMD      Path to the ordering tool.       Default: bin/pr-attack
#   PR_CYCLE_TRIAGE_CMD      Path to the triage tool.         Default: bin/pr-triage
#   PR_CYCLE_READY_CMD       Path to the ready tool.          Default: bin/post-plan-fleet
#   PR_CYCLE_DM_CMD          Path to the notifier.            Default: bin/discord-dm
#   PR_CYCLE_GH_CMD          The gh binary.                   Default: gh
#   PR_CYCLE_MAIN_CHECKOUT   The only tree this may run in.
#   PR_CYCLE_RESCUE          0 disables DIRTY-PR rescue.      Default: 1 (enabled)
#   PR_CYCLE_SKIP_READY_WHEN_ARMABLE
#                            0 disables the pr-ready skip. The skip needs BOTH: the ARMABLE
#                            bucket AND a /pr-ready READY verdict over the head's current
#                            tree. Default: 1 (enabled)
#   PR_CYCLE_STOP_FILE       Stop file path.                  Default: $HOME/.ibl5-pr-cycle.stop
#   PR_CYCLE_DRY_LAUNCH      With --go: emit runner + plist but skip launchctl bootstrap.
#   PR_CYCLE_TS              Timestamp token for runner/log/plist paths (tests). Unset = date+PID at launch.
#   PR_CYCLE_LOG             Detached-worker log path; set by --go, read by the worker. Derived from TS.
#
#   Every seam is PR_CYCLE_-prefixed on purpose. bin/pr-attack reads a bare PR_TRIAGE_CMD
#   itself, and this script spawns the real bin/pr-attack as a child — an unprefixed export
#   here would silently redirect that child's own triage calls too.
#
# Artifacts:
#   $HOME/.ibl5-pr-cycle.stop    the interrupt; create it to halt a running worker
#   /tmp/pr-cycle-<TS>.log       the detached worker's combined log (path printed by --go)
#   /tmp/pr-cycle-<TS>.sh        the emitted runner
#   /tmp/pr-cycle-<TS>/          per-run scratch (attack plan, triage reports, run state)
#
# Gate nominees:
#   bin/pr-attack --gate-candidates may nominate a PR for a gate edge. This driver never
#   invents one. It re-runs pr-attack with --gate-edges /dev/null — pr-attack's documented
#   judged-empty form — so every nominee is ordered and readied like any other PR. The
#   nominee lines printed during a run are a heads-up for the log reader, not an exclusion.
#
# Hard invariants (asserted statically by bin/test-pr-cycle, not merely intended):
#   * This script never merges anything itself. There is no gh merge subcommand anywhere
#     in this file, not even as a fallback when arming succeeds but a PR sits unmerged.
#   * Arming is exactly one call to the triage tool, with no added flags. This script never
#     judges eligibility, never widens a bucket, never relaxes a human sign-off, and never
#     sources or reimplements the armable library.
#   * This script never polls for merges and never sleeps. .github/workflows/update-behind-prs.yml
#     re-BEHINDs open PRs after each merge, and merge-digest-notify.yml sends the per-merge
#     digest DM. This script's only DM is the your-turn summary at the end of a run.
#   * Stage 1 is exactly one post-plan-fleet --pr-list call. Its exit code is the only
#     readiness signal; no stderr text match of any kind.

set -euo pipefail

# --- PATH prelude ------------------------------------------------------------------------
# A safety net for invocation from a restricted context (launchd, a hook) that lacks the
# usual tool dirs. Appended, not prepended: an interactive caller's own PATH — and the test
# harness's shim dir — must still win. The runner emitted below prepends instead, because
# launchd hands it a minimal PATH with no caller preference to respect.
export PATH="$PATH:/usr/local/bin:/opt/homebrew/bin:$HOME/.bun/bin:$HOME/.local/bin:/Applications/cmux.app/Contents/Resources/bin"

# --- ROOT pin ----------------------------------------------------------------------------
# Resolve the MAIN checkout, never the worktree we happen to be standing in.
# --git-common-dir points at the main .git even from a linked worktree, where
# --show-toplevel would return the worktree instead. Used only to locate sibling tools.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
GIT_COMMON="$(git -C "$SCRIPT_DIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
if [ -z "$GIT_COMMON" ]; then
    # git < 2.31 has no --path-format; fall back to resolving the relative answer by hand.
    GIT_COMMON="$(cd "$SCRIPT_DIR" && cd "$(git rev-parse --git-common-dir)" && pwd -P)"
fi
ROOT="$(dirname "$GIT_COMMON")"

# --- env seams ---------------------------------------------------------------------------
# All :- (not -) so an EMPTY value falls back to the default exactly as an unset one does.
PR_CYCLE_ATTACK_CMD="${PR_CYCLE_ATTACK_CMD:-$ROOT/bin/pr-attack}"
PR_CYCLE_TRIAGE_CMD="${PR_CYCLE_TRIAGE_CMD:-$ROOT/bin/pr-triage}"
PR_CYCLE_READY_CMD="${PR_CYCLE_READY_CMD:-$ROOT/bin/post-plan-fleet}"
PR_CYCLE_DM_CMD="${PR_CYCLE_DM_CMD:-$ROOT/bin/discord-dm}"
PR_CYCLE_GH_CMD="${PR_CYCLE_GH_CMD:-gh}"
PR_CYCLE_MAIN_CHECKOUT="${PR_CYCLE_MAIN_CHECKOUT:-/Users/ajaynicolas/GitHub/IBL5}"
PR_CYCLE_RESCUE="${PR_CYCLE_RESCUE:-1}"
PR_CYCLE_SKIP_READY_WHEN_ARMABLE="${PR_CYCLE_SKIP_READY_WHEN_ARMABLE:-1}"
PR_CYCLE_STOP_FILE="${PR_CYCLE_STOP_FILE:-$HOME/.ibl5-pr-cycle.stop}"
PR_CYCLE_DRY_LAUNCH="${PR_CYCLE_DRY_LAUNCH:-}"

# Print the usage header above: every comment line from the shebang to `set -euo pipefail`.
usage() {
    awk 'NR>1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"
}

# _normalize_prs LIST -- echo LIST as a bare comma-joined digit-only set, or return 1.
#
# Normalization is a SAFETY dependency here, not cosmetics: the emitted runner interpolates
# the result UNQUOTED (`${ONLY:+--only $ONLY}`) inside its quoted heredoc, and that is only
# safe because this function guarantees the stored string matches [0-9,]+ with no
# whitespace. Storing raw argv ("#2101, #2102") would hand the worker one space-broken
# garbage token that %q would faithfully preserve.
#
# Each token is validated with the same `case` glob idiom --max-ready uses: never an
# arithmetic test (which *errors* under set -e on `abc` rather than rejecting it) and never
# a grep pipe (which inverts under pipefail/SIGPIPE -- the trap this file documents three
# times). `0*` rejects both 0 and a leading-zero number; `*[!0-9]*` rejects abc and -1.
_normalize_prs() {
    _np_out=""
    _np_in="${1//,/ }"
    for _np_t in $_np_in; do
        _np_t="${_np_t#\#}"
        case "$_np_t" in ''|0*|*[!0-9]*) return 1 ;; esac
        _np_out="${_np_out:+$_np_out,}$_np_t"
    done
    [ -n "$_np_out" ] || return 1
    printf '%s' "$_np_out"
}

# --- flags -------------------------------------------------------------------------------
GO=0
DRY=0
STOP=0
NO_DM=""
WORKER=0
MAX_READY=10
JOBS=3
ONLY=""
SKIP=""

while [ $# -gt 0 ]; do
    case "$1" in
        --go)      GO=1; shift ;;
        --dry-run) DRY=1; shift ;;
        --stop)    STOP=1; shift ;;
        --no-dm)   NO_DM=1; shift ;;
        # --worker: set by the emitted runner; do not pass by hand.
        --worker)  WORKER=1; shift ;;
        --max-ready)
            # A `case` glob, not [ "$N" -gt 0 ] and not a grep pipe: the arithmetic test
            # *errors* on `abc` under set -e rather than rejecting it, and any `x | grep -q`
            # form risks the same pipefail/SIGPIPE inversion as the liveness guard below.
            # `0*` rejects both 0 and a leading-zero count; `*[!0-9]*` rejects abc and -1.
            [ $# -ge 2 ] || { usage >&2; exit 2; }
            case "$2" in ''|0*|*[!0-9]*) usage >&2; exit 2 ;; esac
            MAX_READY="$2"; shift 2 ;;
        --jobs)
            [ $# -ge 2 ] || { usage >&2; exit 2; }
            case "$2" in ''|0*|*[!0-9]*) usage >&2; exit 2 ;; esac
            JOBS="$2"; shift 2 ;;
        --only)
            [ $# -ge 2 ] || { usage >&2; exit 2; }
            ONLY="$(_normalize_prs "$2")" || { usage >&2; exit 2; }
            shift 2 ;;
        --skip)
            [ $# -ge 2 ] || { usage >&2; exit 2; }
            SKIP="$(_normalize_prs "$2")" || { usage >&2; exit 2; }
            shift 2 ;;
        --help|-h) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
done

if [ "$GO" = "1" ] && [ "$STOP" = "1" ]; then usage >&2; exit 2; fi
# Refused rather than merged: `--only 101 --skip 101` has no honest reading, and the
# --go/--stop line above is this file's existing precedent for refusing over picking.
if [ -n "$ONLY" ] && [ -n "$SKIP" ]; then usage >&2; exit 2; fi

# --- --stop ------------------------------------------------------------------------------
# Handled before every other guard so it works from any cwd, including a worktree.
# The stop file is created FIRST: a failing --stop-all must still halt the loop at its
# next check rather than leaving the run armed.
if [ "$STOP" = "1" ]; then
    mkdir -p "$(dirname "$PR_CYCLE_STOP_FILE")"
    : > "$PR_CYCLE_STOP_FILE"
    echo "pr-cycle: stop file created: $PR_CYCLE_STOP_FILE"
    "$PR_CYCLE_READY_CMD" --stop-all
    exit $?
fi

# --- refusal guards ----------------------------------------------------------------------
# Guard (a) applies to --go, --dry-run and --worker alike; never to --stop or --help.
# A guard wired only into the --go branch would let a dry run read the wrong tree.
# Guard (b) skips for --worker: the worker invocation IS the live session; testing for its
# own label would make it exit 1 immediately, killing every real run silently.

# (a) Main checkout only. .git is a DIRECTORY in the main checkout and a FILE in a linked
# worktree, so -d structurally rejects a worktree even if the path somehow matched.
TOP="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$TOP" ] || [ "$TOP" != "$PR_CYCLE_MAIN_CHECKOUT" ] || [ ! -d "$TOP/.git" ]; then
    echo "ERROR: pr-cycle runs only from the main checkout ($PR_CYCLE_MAIN_CHECKOUT);" >&2
    echo "       the current directory resolves to '${TOP:-<not a git repository>}'." >&2
    exit 1
fi

# (b) No live session. Skipped for --worker (the worker IS the running session).
# Snapshot the job table ONCE into a variable, then match it with a `case` glob —
# no pipe, no subprocess.
#
# The obvious `printf '%s\n' "$LIST" | grep -q ...` is WRONG under `set -o pipefail`, and
# wrong in the direction that disables the guard: grep -q exits on the first match, the
# writer takes SIGPIPE on its remaining thousands of lines, pipefail promotes that 141 to
# the pipeline's status, and the `if` concludes "no match" precisely BECAUSE a match was
# found. bin/post-plan-fleet documents the same trap at its own call site.
# `|| true` also covers Linux CI, which has no launchctl at all.
if [ "$WORKER" = "0" ]; then
    LAUNCHCTL_LIST="$(launchctl list 2>/dev/null || true)"
    case "$LAUNCHCTL_LIST" in
        *com.ibl5.post-plan-fleet-*|*com.ibl5.pr-cycle-*)
            echo "ERROR: a post-plan-fleet or pr-cycle session is already live; refusing to start another." >&2
            exit 1 ;;
    esac
fi

# --- run state ---------------------------------------------------------------------------
TS="${PR_CYCLE_TS:-$(date +%Y%m%d-%H%M%S)-$$}"
RUNDIR="/tmp/pr-cycle-$TS"
HALT=""
ARMED=0
READIED=0
LEFT=0
WARNED_ONLY=0

# ==========================================================================================
# Phase 2 — selection
# ==========================================================================================

# _attack_plan [retry-count] — leave an ordered plan of attack in $RUNDIR/attack.md.
#
# `--gate-candidates` ALWAYS exits 0: bin/pr-attack runs gate_candidates and then falls
# through to emit_order only when the nominee file is empty. Exit 2 is raised inside
# emit_order, i.e. reachable only from the second invocation. So the discriminator between
# "this is already the plan" and "nominees need excluding" is the stdout content, never $?.
_attack_plan() {
    _retry="${1:-0}"

    set +e
    "$PR_CYCLE_ATTACK_CMD" --gate-candidates > "$RUNDIR/attack.md" 2> "$RUNDIR/attack.err"
    _rc=$?
    set -e
    if [ "$_rc" -ne 0 ]; then
        cat "$RUNDIR/attack.err" >&2 || true
        HALT="pr-attack --gate-candidates exit $_rc"
        return 1
    fi

    if grep -qF '# Plan of attack' "$RUNDIR/attack.md"; then
        return 0
    fi

    # Nominees exist. The driver never invents a gate edge, so it re-runs pr-attack with the
    # documented judged-empty form (--gate-edges /dev/null): every nominee is re-admitted and
    # ordered like any other PR. These lines are a heads-up for the log reader, not a skip.
    grep -E '^### #[0-9]+' "$RUNDIR/attack.md" 2>/dev/null | while read -r _line; do
        echo "  $_line — ordered with no gate edges (gate nominee, judged-empty)"
    done || true

    # LAST match, so a slug containing the literal WORK= cannot spoof the real trailer.
    _work="$(sed -n 's/^WORK=//p' "$RUNDIR/attack.md" | tail -n 1)"
    if [ -z "$_work" ]; then
        HALT="pr-attack emitted no WORK= trailer"
        return 1
    fi

    set +e
    "$PR_CYCLE_ATTACK_CMD" --work "$_work" --gate-edges /dev/null \
        > "$RUNDIR/attack.md" 2> "$RUNDIR/attack.err"
    _rc=$?
    set -e
    if [ "$_rc" -eq 0 ]; then
        return 0
    fi

    # Exit 3 means $WORK went stale because origin/master moved — expected right after a
    # merge. Retry exactly once, tracked by the counter argument, never by a `while true`.
    if [ "$_rc" -eq 3 ]; then
        if [ "$_retry" -ge 1 ]; then
            HALT="pr-attack WORK stale twice"
            return 1
        fi
        echo "  pr-attack WORK went stale (exit 3) — recomputing the plan once"
        _attack_plan $((_retry + 1))
        return $?
    fi

    cat "$RUNDIR/attack.err" >&2 || true
    HALT="pr-attack --work exit $_rc"
    return 1
}

# _attack_rows — emit "<pr>\t<needs-you>" for every orderable row, in table order.
#
# The table is `| <pos> | #<PR> <slug> | <constraint> | <needs> |`. Splitting on | gives
# an empty $1, so the position is $2 and the PR cell is $3. Requiring $2 to be an integer
# AND $3 to start with # rejects the |---|----| separator row, which would otherwise be
# collected as data.
_attack_rows() {
    awk -F'|' '
        NF >= 5 {
            pos = $2; gsub(/[ \t]/, "", pos)
            cell = $3; gsub(/^[ \t]+|[ \t]+$/, "", cell)
            if (pos ~ /^[0-9]+$/ && cell ~ /^#[0-9]+/) {
                split(cell, a, /[ \t]+/)
                n = a[1]; sub(/^#/, "", n)
                needs = $5; gsub(/^[ \t]+|[ \t]+$/, "", needs)
                print n "\t" needs
            }
        }
    ' "$RUNDIR/attack.md"
}

# _pr_allowed N -- true when PR N is inside the --only/--skip scope. Always true when
# neither flag was given, so every call site below is a no-op on a default run.
#
# A comma-SENTINEL `case` glob, never `printf | grep`: the sentinels end-anchor the match for
# free (a bare grep for 101 also matches 1010 and 2101), and a grep pipe would be the fourth
# instance of the pipefail/SIGPIPE inversion this file already documents three times. $ONLY
# and $SKIP are guaranteed [0-9,]+ by _normalize_prs, so the globs cannot be fooled.
#
# SELECTION ONLY. This predicate belongs at the points that CHOOSE what to work on
# (_next_pr, _rescue_one) and nowhere near the accounting in _arm_and_classify, _reconcile,
# or the MERGES counter -- see the warning above the armed.txt awk.
_pr_allowed() {
    if [ -n "$ONLY" ]; then
        case ",$ONLY," in *",$1,"*) return 0 ;; esac
        return 1
    fi
    case ",$SKIP," in *",$1,"*) return 1 ;; esac
    return 0
}

# _warn_unmatched_only -- one advisory line naming every --only PR the plan of attack does
# not mention at all. Advisory: it never sets HALT and never changes the exit status.
#
# Without it a typo'd number is indistinguishable from success. `--only 2110` when the real
# PR is #2101 leaves _next_pr with nothing, so DRAINED=1 and the digest reports
# "merged 0, left for human 0 -- queue drained", which reads as "your subset was already
# clean". This line is the difference between a tool and a silent no-op.
#
# Deliberately generous: it accepts a #<digits> token ANYWHERE in the document -- the ordered
# table, ## Excluded, ## Hand-resolutions alike. The job is catching a typo, so it must err
# toward silence rather than crying wolf about a PR the plan does in fact list.
_warn_unmatched_only() {
    [ -n "$ONLY" ] || return 0
    [ -f "$RUNDIR/attack.md" ] || return 0
    _wu_seen="$(grep -oE '#[0-9]+' "$RUNDIR/attack.md" 2>/dev/null | tr -d '#' | sort -u | tr '\n' ',' || true)"
    _wu_miss=""
    for _wu_p in ${ONLY//,/ }; do
        case ",$_wu_seen" in *",$_wu_p,"*) continue ;; esac
        _wu_miss="${_wu_miss:+$_wu_miss }#$_wu_p"
    done
    if [ -n "$_wu_miss" ]; then
        echo "pr-cycle: --only names PR(s) absent from the plan of attack: $_wu_miss"
    fi
    return 0
}

# Rescue candidates: PR numbers under the attack document's `## Excluded` section carrying a
# DIRTY classification, in document order. Read from $RUNDIR/attack.md, which _attack_plan has
# already written -- no extra gh call, no access to pr-attack's private work directory.
#
# SECTION-SCOPED on purpose. `## Hand-resolutions needed` follows `## Excluded` in the same
# document and can name a conflicted PR; an unscoped line-regex would collect it and rescue a
# PR that was never excluded. The classification is taken from the LAST " — " on the line,
# because a slug may contain that separator -- the same reason pr-attack reads its own `WORK=`
# trailer with `tail -n 1`. The number is cut at the first non-digit rather than by field
# position, because an empty slug (pr-attack's `jq ... // ""`) leaves a DOUBLE space after it.
# DRAFT bullets never match: the classification must begin with DIRTY. That is where the
# "only DIRTY is rescuable" rule lives -- in the parser, not in a downstream filter.
_excluded_dirty_rows() {
    [ -f "$RUNDIR/attack.md" ] || return 0
    awk '
        /^## Excluded[[:space:]]*$/ { in_ex = 1; next }
        /^## / { in_ex = 0 }
        in_ex && /^- #[0-9]+/ {
            rest = $0; found = 0
            while ((p = index(rest, " — ")) > 0) {
                rest = substr(rest, p + length(" — ")); found = 1
            }
            if (!found) next
            if (rest !~ /^DIRTY/) next
            n = $0
            sub(/^- #/, "", n)
            sub(/[^0-9].*$/, "", n)
            if (n != "") print n
        }
    ' "$RUNDIR/attack.md"
}

# True when launchd already holds a post-plan-fleet slot for this PR. The plist IS the slot
# token (bin/post-plan-fleet:688), so firing a rescue against a PR whose session is already in
# flight would put two sessions on one PR.
#
# The list is snapshotted into a VARIABLE and matched with a `case` glob. NEVER
# `printf '%s\n' "$list" | grep -q ...`: under `set -o pipefail` grep exits at the first
# match, the writer takes SIGPIPE, pipefail promotes the status to 141, and the `if`
# concludes "no match" precisely BECAUSE a match was found. Same trap the live-session guard
# above documents -- this is the same idiom, not a second one.
#
# The pattern is END-ANCHORED with a trailing newline. bin/post-plan-fleet:178 spells out why:
# an unanchored `com.ibl5.post-plan-fleet-190` also matches the label for PR #1901, which would
# make a live session for #1901 silently veto every rescue of #190.
_slot_held() {
    _sh_label="com.ibl5.post-plan-fleet-$1"
    _sh_list="$(launchctl list 2>/dev/null || true)"
    _sh_nl='
'
    case "$_sh_list$_sh_nl" in
        *"$_sh_label$_sh_nl"*) return 0 ;;
    esac
    return 1
}

# ==========================================================================================
# Phase 3 — ready, then arm
# ==========================================================================================

# _precheck_bucket N — echo PR N's current bucket, or "" when it cannot be determined.
# Read-only: this invocation deliberately omits --arm, so it reports and changes nothing.
# Never sets HALT and never returns non-zero: an unknown bucket must fall through to the
# normal readying path, so every failure mode here degrades to "" (= do not skip).
# The plain triage report is run once per run into $RUNDIR/precheck.txt; later calls
# only awk it. On a nonzero exit, precheck.failed is touched and every call echoes "".
_precheck_bucket() {
    _pn="$1"
    if [ -f "$RUNDIR/precheck.failed" ]; then
        echo ""; return 0
    fi
    if [ ! -f "$RUNDIR/precheck.txt" ]; then
        set +e
        "$PR_CYCLE_TRIAGE_CMD" > "$RUNDIR/precheck.txt" 2> "$RUNDIR/precheck.err"
        _prc=$?
        set -e
        if [ "$_prc" -ne 0 ]; then
            touch "$RUNDIR/precheck.failed"
            echo ""; return 0
        fi
    fi
    # Fixed-width columns separated by 2+ spaces — the consumer contract documented in
    # bin/pr-triage. exit after the first match: one row per PR.
    awk -F"  +" -v pr="#$_pn" '$1 == pr { print $2; exit }' "$RUNDIR/precheck.txt"
    return 0
}

# _precheck_verdict N — echo READY when PR N carries a /pr-ready sticky verdict that is
# BOTH a READY verdict AND still describes the PR head's current tree. Echo "" otherwise.
#
# ARMABLE alone is NOT evidence that /pr-ready ever ran. The `pr_manual_testing_clearance`
# predicate bin/pr-triage sources greps the PR *body* for "No manual testing needed", and
# `/post-plan` writes that sentinel when it opens the PR — so a brand-new chore: PR with
# green CI is ARMABLE minutes later, having never been readied once. The two verdicts
# share only those six hold predicates: ARMABLE adds merge-state and checks-green, READY
# adds rebase currency, plan-fidelity review and remediation. Neither verdict contains the
# other, so both are required before a readying session may be declined.
#
# This function reaches the clearance signal only through bin/pr-triage's report, never by
# sourcing the shared predicate library itself — the boundary static guard
# `g_no_armable_lib` in bin/test-pr-cycle enforces.
#
# The tree comparison is load-bearing, not belt-and-braces. The sticky comment is edited
# in place and therefore renders at its original timeline position forever, above every
# commit that has landed since (_phase7-verdict.md records PR #2083: verdict written, then
# six further commits, comment untouched). A bare "the comment says READY" test honours a
# verdict for a tree that no longer exists.
#
# Read-only, and fails toward running /pr-ready in every arm: a failed gh call, no sticky
# comment, a missing or malformed tree line, an unresolvable head tree, a tree mismatch,
# and a NOT READY verdict all echo "". Never sets HALT and never returns non-zero.
_precheck_verdict() {
    _vn="$1"

    set +e
    "$PR_CYCLE_GH_CMD" pr view "$_vn" --json comments,headRefOid \
        > "$RUNDIR/verdict-$_vn.json" 2> "$RUNDIR/verdict-$_vn.err"
    _vrc=$?
    set -e
    [ "$_vrc" -ne 0 ] && { echo ""; return 0; }

    # The LAST sticky comment wins — the same rule .github/workflows/merge-digest-notify.yml
    # applies, and for the same reason: /pr-ready rewrites the comment across phases.
    _vbody="$(jq -r '[.comments[]? | select((.body // "") | contains("<!-- pr-ready-verdict -->"))] | last | .body // ""' \
        "$RUNDIR/verdict-$_vn.json" 2>/dev/null || true)"
    [ -n "$_vbody" ] || { echo ""; return 0; }
    printf '%s\n' "$_vbody" | tr -d '\r' > "$RUNDIR/verdict-body-$_vn.md"

    # Line 1 only, exactly 40 lowercase hex, nothing else on the line — the identical
    # anchored shape .claude/review-shared/scripts/skip-review.sh matches, so this skip
    # and /pr-ready's own Phase 6 skip agree by construction rather than by coincidence.
    # A verdict written before that contract line existed simply has no match here, which
    # is the safe direction.
    _vtree="$(sed -n '1s/^\*\*Reviewed tree:\*\* \([0-9a-f]\{40\}\)$/\1/p' \
        "$RUNDIR/verdict-body-$_vn.md")"
    [ -n "$_vtree" ] || { echo ""; return 0; }

    _void="$(jq -r '.headRefOid // ""' "$RUNDIR/verdict-$_vn.json" 2>/dev/null || true)"
    [ -n "$_void" ] || { echo ""; return 0; }

    # The head's TREE, not its commit: a rebase that changes no content leaves the tree
    # equal, and that is exactly the case the skip is for.
    set +e
    "$PR_CYCLE_GH_CMD" api "repos/{owner}/{repo}/git/commits/$_void" --jq .tree.sha \
        > "$RUNDIR/verdict-tree-$_vn.txt" 2> "$RUNDIR/verdict-tree-$_vn.err"
    _vrc=$?
    set -e
    [ "$_vrc" -ne 0 ] && { echo ""; return 0; }
    _vcur="$(tr -d ' \r\n' < "$RUNDIR/verdict-tree-$_vn.txt")"
    [ -n "$_vcur" ] || { echo ""; return 0; }
    [ "$_vcur" = "$_vtree" ] || { echo ""; return 0; }

    # The verdict line, matched ANCHORED and taking the LAST match. /pr-ready's own body
    # narrates its Phase 6 findings in prose, so a body-wide grep is wrong in both
    # directions: real READY verdicts carry lines like "Phase 6 returned **NOT READY**"
    # (PR #2144) and "**Initial verdict: NOT READY**" (PR #2160) describing findings that
    # remediation then fixed. Only a line whose entire content — after stripping markdown
    # emphasis, heading hashes and backticks — begins with the bare word READY or NOT
    # READY is the verdict itself. Verified against the three live shapes: `READY`
    # (#2160), `**READY** (after Phase 6.5 remediation; ...)` (#2144), `### READY`
    # (#2141), and against the narrating lines above, which this excludes.
    _vline="$(sed 's/[*`#]//g; s/^[[:space:]]*//; s/[[:space:]]*$//' \
        "$RUNDIR/verdict-body-$_vn.md" \
        | grep -E '^(NOT )?READY([[:space:]]|$)' | tail -1)"
    [ -n "$_vline" ] || { echo ""; return 0; }
    case "$_vline" in
        "NOT READY"*) echo ""; return 0 ;;
    esac

    echo "READY"
    return 0
}


# _stage1_list — build $RUNDIR/stage1.txt (one PR per line, final order) and
# $RUNDIR/stage1-skipped.txt (#N — reason lines). Side-effect free: reads only.
_stage1_list() {
    : > "$RUNDIR/stage1.txt"
    : > "$RUNDIR/stage1-skipped.txt"
    while IFS=$'\t' read -r _sl_n _sl_needs; do
        [ -n "$_sl_n" ] || continue
        if ! _pr_allowed "$_sl_n"; then continue; fi
        if [ "$PR_CYCLE_SKIP_READY_WHEN_ARMABLE" != "0" ]; then
            _sl_bkt="$(_precheck_bucket "$_sl_n")"
            if [ "$_sl_bkt" = "ARMABLE" ]; then
                _sl_vrd="$(_precheck_verdict "$_sl_n")"
                if [ "$_sl_vrd" = "READY" ]; then
                    echo "#$_sl_n — already ARMABLE with a current READY verdict, skipping pr-ready" >> "$RUNDIR/stage1-skipped.txt"
                    continue
                fi
                echo "#$_sl_n — ARMABLE but no current READY verdict, running pr-ready"
            fi
        fi
        echo "$_sl_n" >> "$RUNDIR/stage1.txt"
    done <<EOF
$(_attack_rows)
EOF

    if [ "${PR_CYCLE_RESCUE:-1}" != "0" ]; then
        while IFS= read -r _sl_dn; do
            [ -n "$_sl_dn" ] || continue
            if ! _pr_allowed "$_sl_dn"; then continue; fi
            if _slot_held "$_sl_dn"; then
                echo "#$_sl_dn — post-plan-fleet slot already live" >> "$RUNDIR/stage1-skipped.txt"
                continue
            fi
            if grep -qxF "$_sl_dn" "$RUNDIR/stage1.txt" 2>/dev/null; then continue; fi
            echo "$_sl_dn" >> "$RUNDIR/stage1.txt"
        done <<EOF
$(_excluded_dirty_rows)
EOF
    fi

    # Apply the cap: keep first MAX_READY lines.
    if [ -s "$RUNDIR/stage1.txt" ]; then
        local _total
        _total="$(wc -l < "$RUNDIR/stage1.txt" | tr -d ' ')"
        if [ "$_total" -gt "$MAX_READY" ]; then
            local _overflow
            _overflow="$(tail -n +"$((MAX_READY + 1))" "$RUNDIR/stage1.txt")"
            head -n "$MAX_READY" "$RUNDIR/stage1.txt" > "$RUNDIR/stage1.tmp" && mv "$RUNDIR/stage1.tmp" "$RUNDIR/stage1.txt"
            while IFS= read -r _ov_n; do
                [ -n "$_ov_n" ] || continue
                echo "#$_ov_n — over --max-ready cap" >> "$RUNDIR/stage1-skipped.txt"
            done <<EOF
$_overflow
EOF
        fi
    fi
}

# _stage1_fire — run post-plan-fleet with the stage1.txt list. Returns 0 on empty or
# fleet exit 0; sets HALT and returns 1 on failure.
_stage1_fire() {
    if [ ! -s "$RUNDIR/stage1.txt" ]; then
        echo "stage 1: nothing to ready"
        return 0
    fi
    if [ -e "$PR_CYCLE_STOP_FILE" ]; then
        HALT="stopped by $PR_CYCLE_STOP_FILE"
        return 1
    fi
    _csv="$(paste -sd, "$RUNDIR/stage1.txt")"
    set +e
    "$PR_CYCLE_READY_CMD" --pr-list "$_csv" --jobs "$JOBS" --go --wait \
        > "$RUNDIR/ready.out" 2> "$RUNDIR/ready.err"
    _rc=$?
    set -e
    cat "$RUNDIR/ready.out" || true
    cat "$RUNDIR/ready.err" >&2 || true
    if [ "$_rc" -ne 0 ]; then
        HALT="post-plan-fleet exit $_rc in stage 1 (failure or --wait timeout; sessions may still be running)"
        return 1
    fi
    return 0
}

# _arm_and_classify — the one arming call, then parse every PR's bucket from the report.
# Sets ARMED and LEFT. Returns non-zero (with HALT set) only on an unusable report.
_arm_and_classify() {

    # A second, separate stop check: readying can take an hour, so the top-of-loop check
    # is far too stale to gate the side effect that follows.
    if [ -e "$PR_CYCLE_STOP_FILE" ]; then
        HALT="stopped by $PR_CYCLE_STOP_FILE"
        return 1
    fi

    set +e
    "$PR_CYCLE_TRIAGE_CMD" --arm > "$RUNDIR/triage.txt" 2> "$RUNDIR/triage.err"
    _rc=$?
    set -e
    cat "$RUNDIR/triage.err" >&2 || true

    # Exit 2 is usage/auth: every later classification would be garbage, so halt. Exit 1
    # means an attempted arm failed — that failure may belong to another PR, and the report
    # still tells us the bucket, so log it and carry on.
    if [ "$_rc" -eq 2 ]; then
        HALT="pr-triage exit 2 (usage or auth)"
        return 1
    fi
    if [ "$_rc" -ne 0 ]; then
        echo "  pr-triage exit $_rc — an arm attempt failed; continuing with the report"
    fi

    # Parse all rows. Two-space column separator (the pr-triage contract).
    # NEVER filter by _pr_allowed: --only/--skip scope SELECTION, not ACCOUNTING.
    : > "$RUNDIR/armed.txt"
    : > "$RUNDIR/your-turn.txt"
    while IFS="$(printf '\t')" read -r _ac_pr _ac_bkt _ac_act; do
        [ -n "$_ac_pr" ] || continue
        case "$_ac_pr" in '#'[0-9]*) ;; *) continue ;; esac
        _ac_n="${_ac_pr#\#}"
        if [ "$_ac_bkt" = "ARMABLE" ]; then
            echo "$_ac_n" >> "$RUNDIR/armed.txt"
        else
            printf '%s\t%s\t%s\n' "$_ac_n" "$_ac_bkt" "${_ac_act:-see pr-triage}" >> "$RUNDIR/your-turn.txt"
        fi
    done < <(awk -F"  +" 'NF>=2 { printf "%s\t%s\t%s\n", $1, $2, $3 }' "$RUNDIR/triage.txt")

    ARMED="$(wc -l < "$RUNDIR/armed.txt" | tr -d ' ')"
    LEFT="$(wc -l < "$RUNDIR/your-turn.txt" | tr -d ' ')"

    return 0
}

# _your_turn_lines — print one markdown line per your-turn.txt row, linked via gh pr list.
# Called only from inside the DM block; never sets HALT, never returns non-zero.
_your_turn_lines() {
    [ -s "$RUNDIR/your-turn.txt" ] || return 0

    set +e
    "$PR_CYCLE_GH_CMD" pr list --state open --limit 200 \
        --json number,url,title,state \
        --jq '.[] | [(.number|tostring), .url, .title] | @tsv' \
        > "$RUNDIR/prlist.tsv" 2>/dev/null
    _yl_rc=$?
    set -e
    [ "$_yl_rc" -ne 0 ] && : > "$RUNDIR/prlist.tsv"

    _yt_total="$(wc -l < "$RUNDIR/your-turn.txt" | tr -d ' ')"
    _yt_shown=0
    _yt_running=0
    while IFS="$(printf '\t')" read -r _yn _ybkt _yact; do
        [ -n "$_yn" ] || continue
        _yact="${_yact:-see pr-triage}"
        _row="$(awk -F'\t' -v n="$_yn" '$1 == n { print; exit }' "$RUNDIR/prlist.tsv" 2>/dev/null || true)"
        if [ -n "$_row" ]; then
            _yurl="$(printf '%s\n' "$_row" | cut -f2)"
            _ytitle="$(printf '%s\n' "$_row" | cut -f3 | tr '[]' '()')"
            _yl_line="- [#$_yn: $_ytitle]($_yurl) — $_ybkt — $_yact"
        else
            _yl_line="- #$_yn — $_ybkt — $_yact"
        fi
        if [ "$((_yt_running + ${#_yl_line} + 1))" -gt 1800 ]; then
            echo "- …and $((_yt_total - _yt_shown)) more: $RUNDIR/your-turn.txt"
            return 0
        fi
        echo "$_yl_line"
        _yt_running=$((_yt_running + ${#_yl_line} + 1))
        _yt_shown=$((_yt_shown + 1))
    done < "$RUNDIR/your-turn.txt"
}

# ==========================================================================================
# Phase 5 — the worker loop
# ==========================================================================================

_worker() {
    mkdir -p "$RUNDIR"
    : > "$RUNDIR/armed.txt"
    : > "$RUNDIR/your-turn.txt"

    echo "pr-cycle worker starting — max-ready $MAX_READY, jobs $JOBS, rundir $RUNDIR"
    if [ -n "$ONLY" ]; then echo "pr-cycle scope: --only $ONLY"; fi
    if [ -n "$SKIP" ]; then echo "pr-cycle scope: --skip $SKIP"; fi

    if [ -e "$PR_CYCLE_STOP_FILE" ]; then
        HALT="stopped by $PR_CYCLE_STOP_FILE"
    fi

    if [ -z "$HALT" ]; then
        _attack_plan 0 || true
        _warn_unmatched_only
    fi

    if [ -z "$HALT" ]; then
        _stage1_list
        [ -s "$RUNDIR/stage1-skipped.txt" ] && cat "$RUNDIR/stage1-skipped.txt" || true
        READIED="$(wc -l < "$RUNDIR/stage1.txt" | tr -d ' ')"
        _stage1_fire || true
    fi

    if [ -z "$HALT" ]; then
        _arm_and_classify || true
    fi

    _reason="${HALT:-done}"
    echo "pr-cycle finished — readied $READIED, armed $ARMED, your turn $LEFT — $_reason"

    if [ -z "$NO_DM" ]; then
        if [ -n "$HALT" ]; then
            _yt_block="Your turn: unknown — stage 2 did not run"
        elif [ "$LEFT" -eq 0 ]; then
            _yt_block="Your turn: nothing"
        else
            _yt_block="Your turn:
$(_your_turn_lines)"
        fi
        _msg="pr-cycle finished — readied $READIED, armed $ARMED, your turn $LEFT — $_reason
log: ${PR_CYCLE_LOG:-<foreground>}
$_yt_block"
        "$PR_CYCLE_DM_CMD" "$_msg" || true
    fi

    case "$_reason" in
        "done"|"stopped by "*) return 0 ;;
        *) return 1 ;;
    esac
}

# ==========================================================================================
# Phase 6 — dry-run report and detached parent
# ==========================================================================================

_report_dry_run() {
    mkdir -p "$RUNDIR"

    echo "pr-cycle DRY RUN — nothing fires. Re-run with --go to detach a worker."
    echo ""
    _attack_plan 0 || { echo "ERROR: $HALT" >&2; return 1; }
    _warn_unmatched_only

    _stage1_list
    _s1_cnt="$(wc -l < "$RUNDIR/stage1.txt" | tr -d ' ')"
    if [ "$_s1_cnt" -eq 0 ]; then
        echo "stage 1 would ready: none"
    else
        echo "stage 1 would ready ($_s1_cnt): $(awk '{printf "#%s ", $0}' "$RUNDIR/stage1.txt")"
    fi
    if [ -s "$RUNDIR/stage1-skipped.txt" ]; then
        while IFS= read -r _sk; do
            echo "  $_sk"
        done < "$RUNDIR/stage1-skipped.txt"
    fi
    if [ "$_s1_cnt" -gt 0 ]; then
        _s1_csv="$(paste -sd, "$RUNDIR/stage1.txt")"
        echo "would run: post-plan-fleet --pr-list $_s1_csv --jobs $JOBS --go --wait"
    fi
    if [ "$PR_CYCLE_RESCUE" = "0" ]; then
        echo "DIRTY rescue: disabled (PR_CYCLE_RESCUE=0) — excluded PRs stay unreachable."
    fi
    echo ""
    echo "Triage report (read-only — this run arms nothing):"
    # The plain report, with no arguments. Arming appears in exactly one place in this
    # file, and the dry-run path is deliberately not it.
    "$PR_CYCLE_TRIAGE_CMD" || true
    echo ""
    if [ -n "$ONLY" ]; then      echo "would use scope:      --only $ONLY"
    elif [ -n "$SKIP" ]; then    echo "would use scope:      --skip $SKIP"
    else                         echo "would use scope:      every orderable PR"; fi
    echo "would use max-ready:  $MAX_READY"
    echo "would use jobs:       $JOBS"
    echo "would use stop file:  $PR_CYCLE_STOP_FILE"
    echo "would use rundir:     $RUNDIR"
    return 0
}

_launch() {
    LABEL="com.ibl5.pr-cycle-$TS"
    LOG="/tmp/pr-cycle-$TS.log"
    RUNNER="/tmp/pr-cycle-$TS.sh"
    PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"

    # The driver never removes the stop file — clearing it is the human's explicit
    # re-enable. Detaching a worker that would halt on its first check is pure noise.
    if [ -e "$PR_CYCLE_STOP_FILE" ]; then
        echo "ERROR: stop file present: $PR_CYCLE_STOP_FILE" >&2
        echo "       clear it first:  rm $PR_CYCLE_STOP_FILE" >&2
        exit 1
    fi
    for _p in "$RUNNER" "$LOG" "$PLIST"; do
        if [ -e "$_p" ]; then
            echo "ERROR: artifact collision, refusing to overwrite: $_p" >&2
            exit 1
        fi
    done

    # ~/Library/LaunchAgents always exists on the Mac this runs on; the mkdir is for the
    # Linux CI box, where bin/test-pr-cycle drives this under PR_CYCLE_DRY_LAUNCH.
    mkdir -p "$(dirname "$PLIST")"

    # Header shell-quoted once via %q; the body is a QUOTED heredoc emitted verbatim, so
    # nothing in it expands twice.
    {   printf '#!/usr/bin/env bash\n'
        printf 'ROOT=%q\n'       "$ROOT"
        printf 'LABEL=%q\n'      "$LABEL"
        printf 'PLIST=%q\n'      "$PLIST"
        printf 'LOG=%q\n'        "$LOG"
        printf 'TS=%q\n'         "$TS"
        printf 'MAX_READY=%q\n'  "$MAX_READY"
        printf 'JOBS=%q\n'       "$JOBS"
        printf 'NO_DM=%q\n'      "$NO_DM"
        printf 'ONLY=%q\n'       "$ONLY"
        printf 'SKIP=%q\n'       "$SKIP"
        printf 'export PR_CYCLE_TS=%q\n'   "$TS"
        printf 'export PR_CYCLE_LOG=%q\n'  "$LOG"
        for _v in PR_CYCLE_ATTACK_CMD PR_CYCLE_TRIAGE_CMD PR_CYCLE_READY_CMD \
                  PR_CYCLE_DM_CMD PR_CYCLE_GH_CMD PR_CYCLE_MAIN_CHECKOUT \
                  PR_CYCLE_RESCUE PR_CYCLE_SKIP_READY_WHEN_ARMABLE \
                  PR_CYCLE_STOP_FILE; do
            eval "_val=\${$_v}"
            # shellcheck disable=SC2154  # _val is assigned by the eval above
            printf 'export %s=%q\n' "$_v" "$_val"
        done
        cat <<'RUNNER_EOF'
# launchd hands this a minimal PATH with no caller preference to respect, so PREPEND here —
# the opposite of the driver's own appended prelude.
export PATH="/usr/local/bin:/opt/homebrew/bin:$HOME/.bun/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
cd "$ROOT" || exit 1
# $ONLY/$SKIP are interpolated UNQUOTED so an empty one expands to nothing. That is safe
# only because _normalize_prs guarantees the value is [0-9,]+ with no whitespace; a raw
# "#2101, #2102" would word-split here into a garbage token. Do not "fix" this by quoting
# the whole ${VAR:+...} -- that passes an empty argument when the flag is unset.
"$ROOT/bin/pr-cycle" --worker --max-ready "$MAX_READY" --jobs "$JOBS" ${NO_DM:+--no-dm} ${ONLY:+--only $ONLY} ${SKIP:+--skip $SKIP}
# Release the label so the "already live" guard stops matching.
rm -f "$PLIST"
launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
RUNNER_EOF
    } > "$RUNNER"
    chmod +x "$RUNNER"

    # Unquoted heredoc: ${LABEL}/${RUNNER}/${ROOT}/${LOG}/${HOME} expand at write time.
    # KeepAlive is FALSE and that is specific to this tool, not inherited style: a merge
    # loop that launchd silently restarted would re-arm PRs a human had just halted.
    cat > "$PLIST" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>${LABEL}</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>-lc</string><string>exec ${RUNNER}</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>WorkingDirectory</key><string>${ROOT}</string>
  <key>StandardOutPath</key><string>${LOG}</string>
  <key>StandardErrorPath</key><string>${LOG}</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:${HOME}/.bun/bin:${HOME}/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict></plist>
PLIST_EOF

    if [ -n "$PR_CYCLE_DRY_LAUNCH" ]; then
        echo "DRY(plist) pr-cycle: runner=${RUNNER} plist=${PLIST} log=${LOG}"
        exit 0
    fi
    launchctl bootout "gui/$(id -u)/${LABEL}" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
    echo "pr-cycle started: label=${LABEL}"
    echo "log: ${LOG}"
}

# --- dispatch ----------------------------------------------------------------------------
if [ "$WORKER" = "1" ]; then
    _worker
    exit $?
fi
if [ "$GO" = "1" ]; then
    _launch
    exit 0
fi
# Dry run is the default; --dry-run only states the intent explicitly.
: "$DRY"
_report_dry_run
exit $?
