case_end holdrepeat-user-hook-blocked

# 48b (a session that commits AND edits a user hook: the DM still names the hook)
hr_reset
{ cat "$TMP/effects/hr-commit.sh"; printf 'printf "x\\n" > "%s/.claude/hooks/sneaky.sh"\n' "$HOME"; } > "$TMP/effects/hr-commit-hook.sh"
export CLAUDE_STUB_REPLY="$TMP/reply-hr-blocked" CLAUDE_STUB_EFFECT="$TMP/effects/hr-commit-hook.sh"
