    assert_contains decide_stale:log "$(cat "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log")" "reason=stale-usage"
    assert_no_file decide_stale:no-marker "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
}

# blind_setup <five> <week> <five_resets_epoch|""> <week_resets_epoch|""> [age]
# No-token stub, so usage_fetch returns rc 2 with the seeded cache; age defaults to 600 (stale).
blind_setup() {
    new_env
    make_stub_bin "$STUB" "" '{}' 1
    seed_cache "$(( $(date +%s) - ${5:-600} ))" "$(usage_json_resets "$1" "$2" "$3" "$4")"
    RBIN="$T/resume.sh"
    printf '#!/bin/sh\n' > "$RBIN"; chmod +x "$RBIN"
}

test_decide_blind_normal_allows() {
    local FUT out
    FUT=$(( $(date +%s) + 3600 ))
    blind_setup 50 0 "$FUT" ""
    out=$(IBL5_USAGE_GATE_RUNNER=plan-now IBL5_USAGE_GATE_RESUME_BIN="$RBIN" decide $SID_A)
    assert_eq decide_blind_normal:out "" "$out"
    assert_no_file decide_blind_normal:no-marker "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
    assert_contains decide_blind_normal:log "$(cat "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log")" "fail-open reason=stale-usage"
    assert_eq decide_blind_normal:no-blind-trust 0 "$(log_count blind-trust)"
}

test_decide_blind_drain_pauses() {
    local FUT out m
    FUT=$(( $(date +%s) + 3600 ))
    blind_setup 95 0 "$FUT" ""
    out=$(IBL5_USAGE_GATE_RUNNER=plan-now IBL5_USAGE_GATE_RESUME_BIN="$RBIN" decide $SID_A)
    assert_eq decide_blind_drain:out "$PAUSE_JSON" "$out"
    assert_file decide_blind_drain:marker "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
    m=$(cat "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json" 2>/dev/null)
    assert_eq decide_blind_drain:zone drain "$(printf '%s' "$m" | jq -r .zone)"
    assert_eq decide_blind_drain:reason usage-pause "$(printf '%s' "$m" | jq -r .reason)"
    assert_eq decide_blind_drain:window five_hour "$(printf '%s' "$m" | jq -r .window)"
    assert_eq decide_blind_drain:resets_at "$FUT" "$(printf '%s' "$m" | jq -r .resets_at)"
    assert_contains decide_blind_drain:log "$(cat "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log")" "blind-trust zone=drain age="
    assert_no_file decide_blind_drain:no-delta-log "$IBL5_USAGE_GATE_STATE_DIR/deltas.jsonl"
}

test_decide_blind_drain_allows_holder() {
    local FUT out
