bpt_log_has "$STUB" dm.stdin.log '`id`' "r46: backtick literal in DM (not executed)"
bpt_log_has "$STUB" dm.stdin.log '$(id)' "r46: dollar-paren literal in DM (not executed)"
bpt_log_has "$STUB" dm.stdin.log "**bold**" "r46: markdown bold in DM"
bpt_log_has "$STUB" dm.stdin.log "second line" "r46: text after embedded newline present in DM"
if grep -rq 'uid=' "$STUB" 2>/dev/null; then bpt_fail "r46: shell injection executed — uid= found under STUB"; else bpt_ok "r46: no shell injection executed (uid= absent)"; fi
_lines="$(wc -l < "$STUB/dm.args.log" 2>/dev/null | xargs)"
bpt_expect_eq "r46: dm.args.log has 7 lines (no injected payload in argv)" 7 "${_lines:-0}"

# ── Row 47 — escalate + remedy, BUG_PIPELINE_APPROVER_ID="": --to omitted from dm argv ──
