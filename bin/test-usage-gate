test_resume_paused_args_rejects() {
    new_env
    make_stub_bin "$STUB" "" "$BODY_B"
    in_env "usage_resume_paused_args post-plan-now ../x" >/dev/null 2>&1
    assert_eq resume_args:bad-sid 2 "$?"
    in_env "usage_resume_paused_args post-plan-now $SID_A" >/dev/null 2>&1
    assert_eq resume_args:no-marker 2 "$?"
    in_env "usage_marker_write $SID_A automouse $PPN_BIN usage-pause drain 94 five_hour ''; usage_argv_save $SID_A --auto; usage_resume_paused_args post-plan-now $SID_A" >/dev/null 2>&1
    assert_eq resume_args:runner-mismatch 2 "$?"
    in_env "usage_marker_write $SID_B post-plan-now $PPN_BIN usage-pause drain 94 five_hour ''; usage_resume_paused_args post-plan-now $SID_B" >/dev/null 2>&1
    assert_eq resume_args:no-argv 2 "$?"
    in_env "usage_marker_write $SID_C post-plan-now $PPN_BIN usage-pause drain 94 five_hour ''; usage_argv_save $SID_C --auto --force; usage_resume_paused_args post-plan-now $SID_C" >/dev/null 2>&1
    assert_eq resume_args:ok 0 "$?"
}

test_ppn_resume_paused_argcount() {
    new_env
    make_stub_bin "$STUB" "" "$BODY_B"
    local rc
    mkdir -p "$T/home"
    ( export PATH="$STUB:$ORIG_PATH" HOME="$T/home"; "$PPN_BIN" --resume-paused ) >/dev/null 2>&1
    assert_eq ppn_argcount:none 2 "$?"
    ( export PATH="$STUB:$ORIG_PATH" HOME="$T/home"; "$PPN_BIN" --resume-paused a b ) >/dev/null 2>&1
    assert_eq ppn_argcount:two 2 "$?"
    ( export PATH="$STUB:$ORIG_PATH" HOME="$T/home"; "$PPN_BIN" --auto --resume-paused "$SID_A" ) >/dev/null 2>&1
    assert_eq ppn_argcount:not-first 2 "$?"
    ( export PATH="$STUB:$ORIG_PATH" HOME="$T/home"; "$PPN_BIN" --resume-paused ../x ) >/dev/null 2>&1
    assert_eq ppn_argcount:bad-sid 2 "$?"
    assert_no_file ppn_argcount:no-runs "$IBL5_USAGE_GATE_STATE_DIR/runs"
    assert_no_file ppn_argcount:no-plist "$T/home/Library/LaunchAgents"
}

