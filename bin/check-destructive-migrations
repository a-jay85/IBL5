#!/bin/bash

# Scans migration files (.sql and .php) for destructive SQL statements.
# Git plumbing lives here; statement splitting, PHP extraction, the trigger
# rules and the bypass-marker policy live in bin/lib/destructive-migration-scan.py.
#
# Exit codes: 0 = pass, 1 = destructive patterns found, 2 = usage error
# (or python3 / the engine is missing: the scan never passes silently).

set -euo pipefail

BYPASS_MIN_LENGTH=20
BASELINE_FILE="ibl5/migrations/000_baseline_schema.sql"
ENGINE="$(cd "$(dirname "$0")" && pwd)/lib/destructive-migration-scan.py"

usage() {
    cat <<'EOF'
Usage: bin/check-destructive-migrations [--staged|--since=<sha>|--full-scan] [--schema=<path>] [--bypass-from-stdin] [--self-test] [--help|-h]

Scans added/modified migration files under ibl5/migrations/ (*.sql and *.php)
for destructive SQL statements and blocks unless a tagged bypass marker names
each trigger that fired.

Modes:
  --staged           Scan staged changes (git diff --cached). Default.
  --since=<sha>      Scan changes since the given SHA (git diff <sha>...HEAD).
  --full-scan        Audit every tracked ibl5/migrations/*.sql|*.php in the
                     working tree, whole files. Legacy untagged markers are
                     honoured here only. Takes no --since and no stdin.

Options:
  --schema=<path>       Resolve narrow-type old types from this schema dump instead of ibl5/docs/schema/current-schema.sql.
  --bypass-from-stdin   Read PR body from stdin for PR-wide bypass markers.
  --self-test           Run the engine's inline fixture table.
  --help, -h            Show this message.

Detected patterns (v2, statement-level):
  drop-column             ALTER TABLE ... DROP [COLUMN] <col>
  drop-table              DROP TABLE (suppressed when IF EXISTS + matching
                          CREATE TABLE in the scanned statements = recreate)
  truncate                TRUNCATE [TABLE] ...
  rename-column           ALTER TABLE ... RENAME COLUMN, or
                          CHANGE [COLUMN] <old> <new> with old != new
  add-not-null-no-default ADD [COLUMN] ... NOT NULL without DEFAULT
  tighten-not-null        MODIFY [COLUMN] <col> ... NOT NULL, or same-name
                          CHANGE <col> <col> ... NOT NULL, without DEFAULT
                          (false positive if the column was already NOT NULL)
  drop-index              DROP INDEX|KEY <name> (suppressed when the scanned
                          statements add an index/key with the same name)
  rename-table            RENAME TABLE, or ALTER TABLE ... RENAME [TO|AS]
  delete-no-where         DELETE ... FROM with no WHERE anywhere in the statement
  update-no-where         UPDATE ... SET with no WHERE anywhere in the statement;
                          UPDATE ... JOIN without WHERE counts, INSERT ... ON
                          DUPLICATE KEY UPDATE does not
  narrow-type             MODIFY/CHANGE to a narrower type. Old type comes from
                          ibl5/docs/schema/current-schema.sql, then a same-file
                          definition; a column the dump does not know fires as
                          unresolved
  drop-recreate-existing  DROP TABLE IF EXISTS + CREATE TABLE of a table that
                          already exists in the schema dump, the baseline, or an
                          earlier-numbered migration

Statements are split on ';' outside strings and comments, comments are
removed and string literals masked before matching, so a statement may span
any number of lines. A statement is scanned when any of its lines is added;
its text comes from the post-image.

PHP migrations (heuristic): SQL is read from string literals, heredocs and
nowdocs, with dotted concatenation joined. A WHERE supplied by a concatenated
variable reads as missing (use a tagged marker).

Prepared DDL: for PREPARE n FROM @v, the nearest preceding SET @v = ... has
each string literal that starts with ALTER, CREATE, DROP, RENAME, TRUNCATE,
DELETE or UPDATE scanned as its own statement, reported at the SET's lines.
PREPARE n FROM '<literal>' is scanned the same way. An edit to the SET lines
rescans it; an edit to the PREPARE line alone does not.

Explicitly NOT scanned (v2 limitations):
  - DELIMITER blocks (procedure and trigger bodies split at their inner ';')
  - A WHERE inside a subquery counts as the statement's WHERE
  - PHP SQL built by sprintf/implode or held in a variable
  - Prepared SQL built by CONCAT(...) or bound by SELECT ... INTO @v
  - narrow-type with no schema dump: only same-file definitions resolve

Bypass markers name the triggers they suppress:
  Per-file (SQL comment, or PHP // # /* */ comment, on an added line):
    -- destructive-migration[<trigger>[,<trigger>]]: <reason at least 20 chars>
  Per-PR (HTML comment in PR body, via --bypass-from-stdin):
    <!-- destructive-migration[<trigger>]: <reason at least 20 chars> -->
  A marker suppresses only the triggers it names. Known tags: drop-column,
  drop-table, truncate, rename-column, add-not-null-no-default,
  tighten-not-null, drop-index, rename-table, delete-no-where,
  update-no-where, narrow-type, drop-recreate-existing.
  An untagged marker (destructive-migration: <reason>) is rejected in --staged
  and --since modes and honoured only by --full-scan. An unknown tag is an error.

Requires python3; exits 2 (never a silent pass) when it is missing.

Hard-excluded files:
  - 000_baseline_schema.sql (recreate template with intentional DROP TABLE)

Exit codes: 0 = pass, 1 = destructive patterns found, 2 = usage error or
python3 missing.
EOF
}

MODE="staged"
BYPASS_STDIN=0
SINCE_SHA=""
SINCE_GIVEN=0
FULL_GIVEN=0
SELF_TEST=0
SCHEMA_OVERRIDE=""

for arg in "$@"; do
    case "$arg" in
        --staged)
            MODE="staged"
            ;;
        --since=*)
            MODE="since"
            SINCE_GIVEN=1
            SINCE_SHA="${arg#--since=}"
            ;;
        --schema=*)
            SCHEMA_OVERRIDE="${arg#--schema=}"
            ;;
        --bypass-from-stdin)
            BYPASS_STDIN=1
            ;;
        --full-scan)
            FULL_GIVEN=1
            ;;
        --self-test)
            SELF_TEST=1
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --*)
            echo "unknown flag: $arg" >&2
            usage >&2
            exit 2
            ;;
        *)
            echo "unknown argument: $arg" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if [ -n "$SCHEMA_OVERRIDE" ]; then
    if [ ! -f "$SCHEMA_OVERRIDE" ]; then
        echo "schema file not found: $SCHEMA_OVERRIDE" >&2
        exit 2
    fi
    # Absolute before the later cd to the repo root.
    SCHEMA_OVERRIDE="$(cd "$(dirname "$SCHEMA_OVERRIDE")" && pwd)/$(basename "$SCHEMA_OVERRIDE")"
fi

if [ "$FULL_GIVEN" = "1" ]; then
    if [ "$SINCE_GIVEN" = "1" ] || [ "$BYPASS_STDIN" = "1" ]; then
        echo "--full-scan takes no range and no stdin" >&2
        exit 2
    fi
    MODE="full"
fi

PYTHON="$(command -v python3 || true)"
if [ -z "$PYTHON" ] || [ ! -f "$ENGINE" ]; then
    echo "check-destructive-migrations: python3 (or bin/lib/destructive-migration-scan.py) not found; refusing to pass silently" >&2
    exit 2
fi

if [ "$SELF_TEST" = "1" ]; then
    exec "$PYTHON" "$ENGINE" --self-test
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
# Pathspecs and the --full-scan reads are repo-relative.
cd "$REPO_ROOT"

if [ "$MODE" = "since" ]; then
    RANGE="${SINCE_SHA}...HEAD"
else
    RANGE="--cached"
fi

get_migration_files() {
    if [ "$MODE" = "full" ]; then
        git ls-files -- 'ibl5/migrations/*.sql' 'ibl5/migrations/*.php' \
            | grep -v '^$' \
            | grep -v "^${BASELINE_FILE}$" \
            || true
        return
    fi
    # shellcheck disable=SC2086
    git diff $RANGE --name-only --diff-filter=AM -- 'ibl5/migrations/*.sql' 'ibl5/migrations/*.php' 2>/dev/null \
        | grep -v '^$' \
        | grep -v "^${BASELINE_FILE}$" \
        || true
}

FILES="$(get_migration_files)"

if [ -z "$FILES" ]; then
    echo "No destructive migration patterns detected."
    exit 0
fi

PR_BODY_FILE=""
if [ "$BYPASS_STDIN" = "1" ]; then
    PR_BODY_FILE="$(mktemp)"
    trap 'rm -f "$PR_BODY_FILE"' EXIT
    cat > "$PR_BODY_FILE"
fi

if [ "$MODE" = "full" ]; then
    MARKER_POLICY="legacy"
else
    MARKER_POLICY="strict"
fi

SCHEMA_ARGS=()
if [ -n "$SCHEMA_OVERRIDE" ]; then
    SCHEMA_ARGS=(--schema "$SCHEMA_OVERRIDE")
elif [ -f "$REPO_ROOT/ibl5/docs/schema/current-schema.sql" ]; then
    SCHEMA_ARGS=(--schema "$REPO_ROOT/ibl5/docs/schema/current-schema.sql")
fi
PR_ARGS=()
if [ -n "$PR_BODY_FILE" ]; then
    PR_ARGS=(--pr-body-file "$PR_BODY_FILE")
fi

TRIGGERS=""

# Post-image text of a file: the index for --staged, HEAD for --since, the
# working tree for --full-scan.
post_image() {
    local file="$1"
    case "$MODE" in
        staged) git show ":$file" ;;
        since) git show "HEAD:$file" ;;
        full) cat "$file" ;;
    esac
}

# Added line ranges of a file as "a-b,c-d" from the -U0 hunk headers.
# A hunk with +c,0 is a pure deletion and adds nothing.
added_ranges() {
    local file="$1"
    # shellcheck disable=SC2086
    git diff -U0 $RANGE -- "$file" \
        | awk '/^@@/ {
            split($3, a, ",")
            c = substr(a[1], 2) + 0
            d = (a[2] == "") ? 1 : a[2] + 0
            if (d > 0) { printf "%s%d-%d", (n++ ? "," : ""), c, c + d - 1 }
        }'
}

check_file() {
    local file="$1"
    local select_args=()
    if [ "$MODE" = "full" ]; then
        select_args=(--all-lines)
    else
        local ranges
        ranges="$(added_ranges "$file")"
        [ -z "$ranges" ] && return
        select_args=(--added-ranges "$ranges")
    fi

    local out rc errfile
    errfile="$(mktemp)"
    set +e
    out="$(post_image "$file" | "$PYTHON" "$ENGINE" scan --file "$file" \
        "${select_args[@]}" --marker-policy "$MARKER_POLICY" \
        --migrations-dir "$REPO_ROOT/ibl5/migrations" \
        ${SCHEMA_ARGS[@]+"${SCHEMA_ARGS[@]}"} ${PR_ARGS[@]+"${PR_ARGS[@]}"} 2>"$errfile")"
    rc=$?
    set -e
    case "$rc" in
        0)
            [ -n "$out" ] && printf '%s\n' "$out"
            ;;
        1)
            TRIGGERS="${TRIGGERS}${out}
"
            ;;
        *)
            echo "check-destructive-migrations: engine failed on $file (exit $rc)" >&2
            cat "$errfile" >&2
            rm -f "$errfile"
            exit 2
            ;;
    esac
    rm -f "$errfile"
}

while IFS= read -r file; do
    [ -z "$file" ] && continue
    check_file "$file"
done <<< "$FILES"

if [ -z "$TRIGGERS" ]; then
    echo "No destructive migration patterns detected."
    exit 0
fi

echo "Destructive migration patterns detected:"
echo ""
printf '%s' "$TRIGGERS"
echo ""
if grep -q '\[tighten-not-null\]' <<< "$TRIGGERS"; then
    echo "tighten-not-null is a false positive if the column was already NOT NULL"
    echo "and only its type changed; use -- destructive-migration[tighten-not-null]: <reason> in that case."
    echo ""
fi
echo "To proceed, add a tagged bypass marker naming each accepted trigger:"
echo ""
echo "  Per-file (SQL comment in the migration):"
echo "    -- destructive-migration[<trigger>[,<trigger>]]: <reason at least ${BYPASS_MIN_LENGTH} chars>"
echo ""
echo "  Per-PR (HTML comment in PR body):"
echo "    <!-- destructive-migration[<trigger>]: <reason at least ${BYPASS_MIN_LENGTH} chars> -->"
echo ""
echo "A marker suppresses only the triggers it names."
echo ""
echo "See ibl5/migrations/README.md for the full destructive migration policy."
exit 1
