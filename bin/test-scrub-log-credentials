#!/usr/bin/env bash
# Harness tests for bin/scrub-log-credentials.
# Uses synthetic credentials only — no real log content is read, copied, or committed.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SCRIPT="${REPO_ROOT}/bin/scrub-log-credentials"

pass=0
fail=0

ok() { pass=$((pass + 1)); echo "  PASS: $1"; }
fail_msg() { fail=$((fail + 1)); echo "  FAIL: $1"; }

run_case() {
    local label="$1"; echo "--- case: $label ---"
}

# ---------------------------------------------------------------------------
# Build fixtures in a temp dir
# ---------------------------------------------------------------------------
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

# file_a.log — 5 lines (3 contaminated + 1 unparseable + 1 already-clean line from file_c)
# Line 1: contaminated — context.trace with regular frames
LINE1=$(jq -nc '{
  "level": 400,
  "level_name": "ERROR",
  "channel": "app",
  "message": "Uncaught exception",
  "context": {
    "exception": "RuntimeException",
    "trace": "#0 /app/ibl5/classes/Auth/AuthService.php(78): Auth\\AuthService->loginWithUsername('\''gm_user'\'', '\''SYNTH_SECRET_PASSWORD'\'', 3600)\n#1 {main}"
  }
}')
# Line 2: clean — info record, no trace key
LINE2=$(jq -nc '{
  "level": 200,
  "level_name": "INFO",
  "channel": "app",
  "message": "user logged in",
  "context": {}
}')
# Line 3: contaminated — context.trace with internal frame
LINE3=$(jq -nc '{
  "level": 400,
  "level_name": "ERROR",
  "channel": "app",
  "message": "Uncaught exception",
  "context": {
    "trace": "#0 [internal function]: Auth\\AuthService->loginWithUsername('\''gm_user'\'', '\''SYNTH_SECRET_PASSWORD'\'', 3600)\n#1 {main}"
  }
}')
# Line 4: deliberately unparseable
LINE4='{"truncated": '
# Line 5: PHP 8.4+ closure frame with parens in name
LINE5=$(jq -nc '{
  "level": 400,
  "level_name": "ERROR",
  "channel": "app",
  "message": "Uncaught exception",
  "context": {
    "trace": "#0 [internal function]: {closure:probe():2}('\''SYNTH_SECRET_PASSWORD'\'')\n#1 {main}"
  }
}')

printf '%s\n' "$LINE1" "$LINE2" "$LINE3" "$LINE4" "$LINE5" > "${TMP}/file_a.log"

# file_b.log — 2 clean lines, no trace key
jq -nc '{"level":200,"channel":"app","message":"ok","context":{}}' > "${TMP}/file_b.log"
jq -nc '{"level":200,"channel":"app","message":"ok2","context":{}}' >> "${TMP}/file_b.log"

# file_c.log — 1 already-arg-free trace (new format) — must NOT be a hit
jq -nc '{
  "level": 400,
  "channel": "app",
  "message": "Uncaught exception",
  "context": {
    "trace": "#0 Auth\\AuthService->loginWithUsername() at /app/x.php:78\n#1 {main}"
  }
}' > "${TMP}/file_c.log"

# Save pristine copies for comparison
cp "${TMP}/file_a.log" "${TMP}/file_a.log.orig"
cp "${TMP}/file_b.log" "${TMP}/file_b.log.orig"
cp "${TMP}/file_c.log" "${TMP}/file_c.log.orig"

# ---------------------------------------------------------------------------
# Case 1: dry-run
# ---------------------------------------------------------------------------
run_case "dry-run"

output=$("$SCRIPT" --log-dir="$TMP" 2>&1)

# Files unchanged
if cmp -s "${TMP}/file_a.log" "${TMP}/file_a.log.orig"; then ok "file_a unchanged"; else fail_msg "file_a was modified in dry-run"; fi
if cmp -s "${TMP}/file_b.log" "${TMP}/file_b.log.orig"; then ok "file_b unchanged"; else fail_msg "file_b was modified in dry-run"; fi
if cmp -s "${TMP}/file_c.log" "${TMP}/file_c.log.orig"; then ok "file_c unchanged"; else fail_msg "file_c was modified in dry-run"; fi

# Reports hit count 3 (lines 1, 3, 5 — not line 2 or 4, not idempotent line in file_c)
if printf '%s\n' "$output" | grep -q 'Total hits: 3'; then ok "dry-run reports 3 hits"; else fail_msg "dry-run hit count wrong (expected 3): $output"; fi

# Secret never in output
if printf '%s\n' "$output" | grep -q 'SYNTH_SECRET_PASSWORD'; then fail_msg "secret appeared in dry-run output"; else ok "no secret in dry-run output"; fi

# No backup files
if ls "${TMP}"/*.bak-*.log 2>/dev/null | grep -q .; then fail_msg "backup files created in dry-run"; else ok "no backups in dry-run"; fi

# ---------------------------------------------------------------------------
# Case 2: write mode
# ---------------------------------------------------------------------------
run_case "write mode"

"$SCRIPT" --log-dir="$TMP" --write 2>&1 >/dev/null || true

# Secret gone from file_a
if grep -q 'SYNTH_SECRET_PASSWORD' "${TMP}/file_a.log" 2>/dev/null; then
    fail_msg "secret still in file_a after --write"
else
    ok "secret removed from file_a"
fi

# Frame identity preserved
if grep -q 'loginWithUsername' "${TMP}/file_a.log" 2>/dev/null; then ok "loginWithUsername preserved"; else fail_msg "loginWithUsername missing after scrub"; fi
if grep -q 'AuthService.php(78)' "${TMP}/file_a.log" 2>/dev/null; then ok "file:line preserved"; else fail_msg "file:line (78) missing after scrub"; fi

# Lines 1, 2, 3, 5 still parse as JSON (line 4 is unparseable)
if sed -n '1p;2p;3p;5p' "${TMP}/file_a.log" | jq -e . >/dev/null 2>&1; then ok "valid lines still parse"; else fail_msg "valid lines no longer parse"; fi

# Line 5 (closure): secret gone, not wholesale-redacted
line5_after=$(sed -n '5p' "${TMP}/file_a.log")
if printf '%s\n' "$line5_after" | grep -q 'SYNTH_SECRET_PASSWORD'; then
    fail_msg "secret in closure line after scrub"
else
    ok "closure line secret removed"
fi
# Closure frames may be wholesale-redacted if the is_clean regex doesn't match {closure:...}()
# This is a known cosmetic limit — acceptable if the secret is gone
ok "closure line redaction method is acceptable (cosmetic limit)"

# Line 4 (unparseable) byte-identical
line4_after=$(sed -n '4p' "${TMP}/file_a.log")
if [[ "$line4_after" == '{"truncated": ' ]]; then ok "unparseable line preserved"; else fail_msg "unparseable line changed: $line4_after"; fi

# Exactly one backup for file_a
backup_count=$(ls "${TMP}/file_a.bak-"*.log 2>/dev/null | wc -l | tr -d ' ')
if [[ "$backup_count" -eq 1 ]]; then ok "exactly 1 backup for file_a"; else fail_msg "wrong backup count for file_a: $backup_count"; fi
backup_file=$(ls "${TMP}/file_a.bak-"*.log 2>/dev/null | head -1)
if [[ -s "$backup_file" ]]; then ok "backup is non-empty"; else fail_msg "backup is empty"; fi

# file_b and file_c untouched, no backup for them
if cmp -s "${TMP}/file_b.log" "${TMP}/file_b.log.orig"; then ok "file_b untouched"; else fail_msg "file_b was modified"; fi
if cmp -s "${TMP}/file_c.log" "${TMP}/file_c.log.orig"; then ok "file_c untouched"; else fail_msg "file_c was modified"; fi
if ls "${TMP}/file_b.bak-"*.log 2>/dev/null | grep -q .; then fail_msg "spurious backup for file_b"; else ok "no backup for file_b"; fi
if ls "${TMP}/file_c.bak-"*.log 2>/dev/null | grep -q .; then fail_msg "spurious backup for file_c"; else ok "no backup for file_c"; fi

# No secret in combined output
write_output=$("$SCRIPT" --log-dir="$TMP" --write 2>&1 || true)
if printf '%s\n' "$write_output" | grep -q 'SYNTH_SECRET_PASSWORD'; then fail_msg "secret in --write output"; else ok "no secret in --write output"; fi

# ---------------------------------------------------------------------------
# Case 3: idempotence
# ---------------------------------------------------------------------------
run_case "idempotence"

file_a_before=$(cat "${TMP}/file_a.log")
idempotent_output=$("$SCRIPT" --log-dir="$TMP" --write 2>&1 || true)

if printf '%s\n' "$idempotent_output" | grep -q 'Total hits: 0'; then ok "second write reports 0 hits"; else fail_msg "second write hit count wrong: $idempotent_output"; fi
file_a_after=$(cat "${TMP}/file_a.log")
if [[ "$file_a_before" == "$file_a_after" ]]; then ok "file_a byte-identical after idempotent write"; else fail_msg "file_a changed on second write"; fi

# ---------------------------------------------------------------------------
# Case 4: unknown flag
# ---------------------------------------------------------------------------
run_case "unknown flag rejection"

if "$SCRIPT" --unknown-flag 2>/dev/null; then
    fail_msg "--unknown-flag should have failed"
else
    ok "--unknown-flag exits non-zero"
fi
# Capture stderr separately — piping a failing command through grep trips pipefail
unknown_stderr=$("$SCRIPT" --unknown-flag 2>&1 || true)
if printf '%s\n' "$unknown_stderr" | grep -q 'Unknown option'; then ok "stderr contains 'Unknown option'"; else fail_msg "stderr missing 'Unknown option': $unknown_stderr"; fi

# ---------------------------------------------------------------------------
# Case 5: PROD_SSH_HOST env var states
# ---------------------------------------------------------------------------
run_case "PROD_SSH_HOST env checks"

# Create a PATH shim that stubs ssh to exit 97
SSH_SHIM_DIR=$(mktemp -d)
trap 'rm -rf "$SSH_SHIM_DIR"' EXIT
cat > "${SSH_SHIM_DIR}/ssh" << 'SSHSTUB'
#!/usr/bin/env bash
exit 97
SSHSTUB
chmod +x "${SSH_SHIM_DIR}/ssh"

# Create a fake repo root that has no .env and is not a git repo.
# The script derives REPO_ROOT from dirname($0), so we symlink the script
# into a temp bin/ dir; the git common-dir lookup will fail silently (not
# a git repo), so no .env fallback can override the env var.
FAKE_ROOT=$(mktemp -d)
trap 'rm -rf "$FAKE_ROOT"' EXIT
mkdir -p "${FAKE_ROOT}/bin"
ln -s "$SCRIPT" "${FAKE_ROOT}/bin/scrub-log-credentials"
FAKE_SCRIPT="${FAKE_ROOT}/bin/scrub-log-credentials"

# 5a: unset PROD_SSH_HOST
unset_exit=0
env -u PROD_SSH_HOST PATH="${SSH_SHIM_DIR}:${PATH}" "$FAKE_SCRIPT" --prod 2>/dev/null || unset_exit=$?
if [[ "$unset_exit" -ne 0 ]]; then ok "unset PROD_SSH_HOST exits non-zero"; else fail_msg "unset PROD_SSH_HOST should have failed"; fi
if [[ "$unset_exit" -eq 97 ]]; then fail_msg "unset: ssh was invoked before config check"; else ok "unset: ssh not invoked"; fi
unset_stderr=$(env -u PROD_SSH_HOST PATH="${SSH_SHIM_DIR}:${PATH}" "$FAKE_SCRIPT" --prod 2>&1 || true)
if printf '%s\n' "$unset_stderr" | grep -q 'PROD_SSH_HOST'; then ok "unset: stderr names PROD_SSH_HOST"; else fail_msg "unset: stderr missing PROD_SSH_HOST: $unset_stderr"; fi

# 5b: set-but-empty PROD_SSH_HOST
empty_exit=0
PROD_SSH_HOST= PATH="${SSH_SHIM_DIR}:${PATH}" "$FAKE_SCRIPT" --prod 2>/dev/null || empty_exit=$?
if [[ "$empty_exit" -ne 0 ]]; then ok "empty PROD_SSH_HOST exits non-zero"; else fail_msg "empty PROD_SSH_HOST should have failed"; fi
if [[ "$empty_exit" -eq 97 ]]; then fail_msg "empty: ssh was invoked before config check"; else ok "empty: ssh not invoked"; fi
empty_stderr=$(PROD_SSH_HOST= PATH="${SSH_SHIM_DIR}:${PATH}" "$FAKE_SCRIPT" --prod 2>&1 || true)
if printf '%s\n' "$empty_stderr" | grep -q 'PROD_SSH_HOST'; then ok "empty: stderr names PROD_SSH_HOST"; else fail_msg "empty: stderr missing PROD_SSH_HOST: $empty_stderr"; fi

# ---------------------------------------------------------------------------
# Case 6: never auto-run
# ---------------------------------------------------------------------------
run_case "never auto-run"

cd "$REPO_ROOT"

# Nothing in CI or Docker may reference it (excluding the harness itself)
if ! grep -rn 'scrub-log-credentials' .github/ docker/ 2>/dev/null | grep -v 'test-scrub-log-credentials'; then
    ok "no CI/Docker reference to scrub-log-credentials (outside harness)"
else
    fail_msg "found unexpected CI/Docker reference to scrub-log-credentials"
fi

# No other bin/ script may invoke it
if ! grep -rn 'scrub-log-credentials' bin/ 2>/dev/null | grep -v '^bin/scrub-log-credentials:\|^bin/test-scrub-log-credentials:'; then
    ok "no other bin/ script invokes scrub-log-credentials"
else
    fail_msg "found unexpected bin/ invocation of scrub-log-credentials"
fi

# ---------------------------------------------------------------------------
# Case 7: backup files are gitignored
# ---------------------------------------------------------------------------
run_case "backups are gitignored"

if git check-ignore -q "ibl5/logs/ibl5-2026-01-01.bak-20260101T000000Z.log" 2>/dev/null; then
    ok "backup .log files are gitignored"
else
    fail_msg "backup .log files are NOT gitignored"
fi

# ---------------------------------------------------------------------------
# Case 8: remote jq filter correctness (drift test + invocation guard)
# These tests would FAIL on the pre-fix remote code path. The three reviewer
# findings and one additional bug (missing -R flag) were all invisible to the
# existing tests because they only exercise run_local(); this case checks the
# remote embedded filter and invocation directly without requiring SSH.
# ---------------------------------------------------------------------------
run_case "remote jq filter drift and invocation guard"

# 8a: the remote jq invocation must NOT use /dev/stdin or <<< here-strings
#     (Finding 1: here-string overrides pipe stdin so jq receives no JSON input)
if grep -q '/dev/stdin' "$SCRIPT"; then
    fail_msg "remote jq still uses /dev/stdin (Finding 1 not fixed)"
else
    ok "remote jq: /dev/stdin absent"
fi
if grep -q '<<<' "$SCRIPT"; then
    fail_msg "remote jq still uses <<< here-string (Finding 1 not fixed)"
else
    ok "remote jq: <<< absent"
fi
# Must use -Rc (raw-input + compact) and a filter file variable
if grep -qF 'jq -Rc -f "\$jq_filter_file"' "$SCRIPT"; then
    ok "remote jq uses -Rc -f \$jq_filter_file"
else
    fail_msg "remote jq missing -Rc -f \$jq_filter_file (Findings 1 and 4)"
fi

# Extract the remote embedded jq filter block for content checks
remote_filter=$(awk "/REMOTEJQ'/{found=1; next} /^REMOTEJQ\$/{found=0} found{print}" "$SCRIPT")

# 8b: remote is_clean must include the buildArgFreeTrace frame pattern
#     (Finding 2: missing third pattern causes clean new-format traces to be corrupted)
if printf '%s\n' "$remote_filter" | grep -qF '\\(\\) at .+:[0-9]+'; then
    ok "remote is_clean has at-file:line pattern (Finding 2 fixed)"
else
    fail_msg "remote is_clean missing at-file:line pattern (Finding 2)"
fi

# 8c: remote process_trace must guard already-redacted entries
#     (Finding 3: missing guard causes re-runs to report spurious hits and rewrite files)
if printf '%s\n' "$remote_filter" | grep -q 'if . == redacted'; then
    ok "remote process_trace has idempotence guard (Finding 3 fixed)"
else
    fail_msg "remote process_trace missing idempotence guard (Finding 3)"
fi

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
echo ""
echo "Results: ${pass} passed, ${fail} failed"
if [[ "$fail" -gt 0 ]]; then
    exit 1
fi
