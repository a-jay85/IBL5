    fresh finish_extra_args
    run_oa "$PR" --finish --option=x
    want_rc 2
    no_gh
}

# ---------------------------------------------------------------------------
# Kept-unplanned cases: the marker's diff= fingerprint and the copied kept span
# ---------------------------------------------------------------------------
use_origin() { # gives the fixture repo an origin remote (itself) and the PR a base ref
    git -C "$TMP/fix" remote get-url origin >/dev/null 2>&1 || git -C "$TMP/fix" remote add origin "$TMP/fix"
    printf 'master\n' > "$FX/base"
}
real_commit() { # commits a real file change in the case worktree, points pr.json at it
    printf '%s\n' "$CASE" > "$WT/$CASE.txt"
    git -C "$WT" add "$CASE.txt"
    git -C "$WT" commit -q -m "change $CASE"
    H=$(git -C "$WT" rev-parse HEAD)
    write_pr "$H"
}
marker_line() { tail -n 1 "$FX/posted.1.md" 2>/dev/null; }
kept_span() {
    awk '/^<!-- owner-approve:kept:begin -->$/ {on=1; next}
         /^<!-- owner-approve:kept:end -->$/ {on=0; next}
         on {print}' "$FX/posted.1.md" 2>/dev/null
}
KEPT_B1='- Renamed the retry flag in bin/foo (`bin/foo`)'
KEPT_B2='- Added a dry-run switch to bin/bar (`bin/bar`)'
write_kept_body() { # the PR body Phase 5.5 writes, with CRLF line ends
    printf '%s\r\n' "Summary of the change" "" "<!-- kept-unplanned:begin -->" \
        "## Kept unplanned changes" \
        "Phase 5.5 kept these changes. No plan phase covers them." \
        "$KEPT_B1" "$KEPT_B2" "<!-- kept-unplanned:end -->" "- a bullet outside the block" > "$FX/body"
}
# Fails when the marker writes the literal unread instead of the fingerprint (row 2).
marker_diff_fp() {
    fresh marker_diff_fp
    use_origin
    real_commit
    local want
    want=$(cd "$WT" && . "$REPO/bin/lib/human-signoff-classifier.sh" && git fetch -q origin master && hs_diff_fingerprint origin/master "$H")
    [ "${#want}" -eq 40 ] || note "fixture fingerprint is '$want'"
    run_oa "$PR" "ok"
    [ "$(marker_line)" = "<!-- owner-approve mode=approve head=$H diff=$want -->" ] \
        || note "marker is '$(marker_line)', want diff=$want"
}
# Fails when a failed fingerprint aborts the post instead of writing unread (row 3).
diff_unread_head_missing() {
    fresh diff_unread_head_missing
    use_origin
    write_pr "$C40"
    run_oa "$PR" "ok"
    [ -f "$FX/posted.1.md" ] || note "no approval comment posted"
    [ "$(marker_line)" = "<!-- owner-approve mode=approve head=$C40 diff=unread -->" ] \
        || note "marker is '$(marker_line)', want diff=unread"
}
# Fails when the awk filter copies non-bullet lines of the kept block (row 4).
kept_span_copied() {
    fresh kept_span_copied
    write_kept_body
    run_oa "$PR" "ok"
    local span
    span=$(kept_span)
    [ "$span" = "$KEPT_B1"$'\n'"$KEPT_B2" ] || note "kept span is '$span'"
    if grep -qF '## Kept unplanned changes' <<< "$span"; then note "the span holds the block header"; fi
    if grep -qF 'Phase 5.5 kept' <<< "$span"; then note "the span holds the Phase 5.5 kept line"; fi
    if grep -qF 'outside the block' <<< "$span"; then note "the span holds a bullet outside the block"; fi
    [ "$(marker_line)" = "<!-- owner-approve mode=approve head=$H diff=unread -->" ] || note "the marker is not the last line"
}
# Fails when an empty kept list still writes the span delimiters (row 5).
no_kept_span() {
    fresh no_kept_span
    printf 'Summary only\n- a bullet, no kept block\n' > "$FX/body"
    run_oa "$PR" "ok"
    [ -f "$FX/posted.1.md" ] || note "no approval comment posted"
    if grep -qF 'owner-approve:kept:begin' "$FX/posted.1.md" 2>/dev/null; then note "a kept span was written with no kept block"; fi
}
# Fails when --finish cannot read the new marker with diff= (row 6). Both runs are real.
finish_new_marker() {
    fresh finish_new_marker
    run_oa "$PR" "go" "--fix-first=fix it"
    want_rc 6
    grep -qF " diff=" "$FX/posted.1.md" 2>/dev/null || note "the record is not in the new shape"
    new_commit
    seed_ready
    run_oa "$PR" --finish
    want_rc 0
    want_out "RESULT: armed"
}
# Invocation-2-only: hand-seeds a record from before diff= existed, so --finish must still read it (row 6).
finish_old_marker() {
    fresh finish_old_marker
    local old_head=$H
    jq -nc --arg b "Owner approved: \"go\". Head $old_head."$'\n\n'"<!-- owner-approve mode=fix-first head=$old_head -->" \
        '{user:{login:"owner"},body:$b}' >> "$FX/comments.ndjson"
    new_commit
    seed_ready
    run_oa "$PR" --finish
    want_rc 0
    want_out "RESULT: armed"
}

# ---------------------------------------------------------------------------
# Re-fire cases: one bin/post-plan-now --state-changed after a kept-span approval
# ---------------------------------------------------------------------------
refire_setup() { # <case>: a kept block, a real diff= value, and a NOT READY sticky
    fresh "$1"
    use_origin
    real_commit
    write_kept_body
    seed_sticky owner "NOT READY" "**Reviewed tree:** $A40"
}
refire_lines() { if [ -f "$FX/refire.log" ]; then wc -l < "$FX/refire.log" | tr -d ' '; else echo 0; fi; }
no_refire() { [ ! -e "$FX/refire.log" ] || note "post-plan-now ran: $(cat "$FX/refire.log")"; }
# Fails when --state-changed is dropped from the re-fire call (row 25).
refire_kept_arms() {
    refire_setup refire_kept_arms
    run_oa_env REFIRE_MODE=ready REFIRE_RC=0 "$OA" "$PR" "ok" --poll=0 --timeout=30
    want_rc 0
    want_out "RESULT: armed"
    [ "$(cat "$FX/refire.log" 2>/dev/null)" = "--state-changed" ] \
        || note "refire.log is '$(cat "$FX/refire.log" 2>/dev/null)', want exactly --state-changed"
}
# Fails when the final verdict pass may re-fire again (row 26).
refire_still_not_ready() {
    refire_setup refire_still_not_ready
    run_oa_env REFIRE_MODE=notready REFIRE_RC=0 "$OA" "$PR" "ok" --poll=0 --timeout=30
    want_rc 4
    want_posted "the verdict is NOT READY."
    [ "$(refire_lines)" = 1 ] || note "post-plan-now ran $(refire_lines) times, want 1"
    refute_gh "pr merge"
}
# Fails when OA_KEPT_ACCEPTED is set without a kept span (row 27).
no_refire_without_kept() {
    fresh no_refire_without_kept
    use_origin
    real_commit
    printf 'Summary only\n' > "$FX/body"
    seed_sticky owner "NOT READY" "**Reviewed tree:** $A40"
    run_oa_env REFIRE_MODE=ready REFIRE_RC=0 "$OA" "$PR" "ok" --poll=0 --timeout=30
    want_rc 4
    want_posted "the verdict is NOT READY."
    no_refire
}
# Fails when the unread test is dropped from the OA_KEPT_ACCEPTED condition (row 28).
no_refire_diff_unread() {
    fresh no_refire_diff_unread
    use_origin
    write_pr "$C40"
    write_kept_body
    seed_sticky owner "NOT READY" "**Reviewed tree:** $A40"
    run_oa_env REFIRE_MODE=ready REFIRE_RC=0 "$OA" "$PR" "ok" --poll=0 --timeout=30
    want_rc 4
    grep -qF 'diff=unread -->' "$FX/posted.1.md" 2>/dev/null || note "the approval marker is not diff=unread"
    no_refire
}
# Fails when the top-of-script headless exit is removed (row 29).
headless_never_refires() {
    refire_setup headless_never_refires
    run_oa_env CLAUDE_HEADLESS=1 REFIRE_MODE=ready REFIRE_RC=0 "$OA" "$PR" "ok" --poll=0 --timeout=30
    want_rc 3
    want_out "RESULT: headless"
    no_refire
    refute_gh "pr comment"
}
# Fails when _oa_refire ignores the stub's exit code (row 30).
refire_ppn_fails() {
    refire_setup refire_ppn_fails
    run_oa_env REFIRE_MODE=none REFIRE_RC=9 "$OA" "$PR" "ok" --poll=0 --timeout=30
    want_rc 4
    want_posted "bin/post-plan-now exit 9"
    refute_gh "pr merge"
}
# Fails when the start-wait loop is removed (row 31).
refire_never_starts() {
    refire_setup refire_never_starts
    run_oa_env REFIRE_MODE=none REFIRE_RC=0 "$OA" "$PR" "ok" --poll=0 --timeout=0
    want_rc 4
    want_posted "did not start"
    [ "$(refire_lines)" = 1 ] || note "post-plan-now ran $(refire_lines) times, want 1"
}

# ---------------------------------------------------------------------------
# Phase 5 case: the docs route through the script
# ---------------------------------------------------------------------------
docs_route_through_script() {
    local skill="$REPO/.claude/skills/pr-burndown/SKILL.md" rule="$REPO/.claude/rules/auto-commit.md"
    OUT=""
    if command grep -nE 'gh pr merge [^`]*--auto|add-label human-approved' "$skill" >/dev/null 2>&1; then
        note "the skill still arms or labels directly"
    fi
    grep -qF 'bin/owner-approve' "$skill" || note "the skill never names bin/owner-approve"
    grep -qF "When the owner's own words approve a named PR (any shape:" "$rule" || note "the rule lost its trigger sentence"
    grep -qF 'bin/owner-approve N' "$rule" || note "the rule does not point at bin/owner-approve N"
    if grep -qF 'gh pr comment N --body' "$rule"; then note "the manual comment command survives in the rule"; fi
}

# ---------------------------------------------------------------------------
# Carry cases: a plain approval follows a new head whose PR diff is unchanged
# ---------------------------------------------------------------------------
carry_setup() { # <case>: a real PR change on top of a per-case base branch
    fresh "$1"
    use_origin
    git -C "$WT" branch -q "b/$CASE" master
    printf 'b/%s\n' "$CASE" > "$FX/base"
    real_commit
}
rebase_case() { # moves the base branch on, then rebases the PR onto it; pr.json follows
    git -C "$WT" checkout -q "b/$CASE"
    printf 'master moved\n' > "$WT/master-$CASE.txt"
    git -C "$WT" add "master-$CASE.txt"
    git -C "$WT" commit -q -m "master moves under $CASE"
    git -C "$WT" checkout -q "case/$CASE"
    git -C "$WT" rebase -q "b/$CASE" >/dev/null 2>&1 || note "fixture rebase failed"
    H=$(git -C "$WT" rev-parse HEAD)
    write_pr "$H"
}
live_then_moved() { # the first pr view shows the approved head with post-plan running
    jq -nc --arg h "$H" --arg b "case/$CASE" '{state:"OPEN",headRefOid:$h,headRefName:$b,labels:[{name:"post-plan-running"}]}' > "$FX/pr.live.json"
    echo 1 > "$FX/pr.live.left"
}
# Fails when a rebase-only head move still asks the owner to approve again.
carry_rebase_arms() {
    carry_setup carry_rebase_arms
    live_then_moved
    rebase_case
    seed_ready
    run_oa "$PR" "go" --poll=0 --timeout=30
    want_rc 0
    want_out "RESULT: armed"
    want_out "The approval carries"
    want_gh "--match-head-commit $H"
}
# Fails when the carry ignores a change to the PR's own lines after the approval.
carry_changed_diff_refuses() {
    carry_setup carry_changed_diff_refuses
    live_then_moved
    rebase_case
    printf 'edited after approval\n' >> "$WT/$CASE.txt"
    git -C "$WT" commit -q -am "edit $CASE"
    H=$(git -C "$WT" rev-parse HEAD)
    write_pr "$H"
    seed_ready
    run_oa "$PR" "go" --poll=0 --timeout=30
    want_rc 4
    want_posted "the PR's own changes are not the approved ones"
    refute_out "The approval carries"
    refute_gh "pr merge"
}
# Fails when --finish after a plain approval drops the recorded diff= value.
carry_finish_rebase_arms() {
    carry_setup carry_finish_rebase_arms
    printf -- '-\t0\tcom.ibl5.post-plan-fleet-%s\n' "$PR" > "$FX/launchctl.out"
    echo 99 > "$FX/launchctl.left"
    run_oa "$PR" "go" --poll=1 --timeout=0
    want_rc 5
    : > "$FX/launchctl.out"
    rebase_case
    seed_ready
    run_oa "$PR" --finish
    want_rc 0
    want_out "RESULT: armed"
    want_out "The approval carries"
}
# Fails when --finish ignores the kept span of the approval it resumes: a NOT READY
# on kept items the owner approved must get its one re-review, then arm.
finish_kept_refire_arms() {
    refire_setup finish_kept_refire_arms
    printf -- '-\t0\tcom.ibl5.post-plan-fleet-%s\n' "$PR" > "$FX/launchctl.out"
    echo 99 > "$FX/launchctl.left"
    run_oa "$PR" "go" --poll=1 --timeout=0
    want_rc 5
    : > "$FX/launchctl.out"
    run_oa_env REFIRE_MODE=ready REFIRE_RC=0 "$OA" "$PR" --finish --poll=0 --timeout=30
    want_rc 0
    want_out "RESULT: armed"
    [ "$(cat "$FX/refire.log" 2>/dev/null)" = "--state-changed" ] \
        || note "refire.log is '$(cat "$FX/refire.log" 2>/dev/null)', want exactly --state-changed"
}
# Fails when --finish re-fires for an approval that listed no kept items.
finish_no_kept_no_refire() {
    fresh finish_no_kept_no_refire
    use_origin
    real_commit
    printf 'Summary only\n' > "$FX/body"
    seed_sticky owner "NOT READY" "**Reviewed tree:** $A40"
    printf -- '-\t0\tcom.ibl5.post-plan-fleet-%s\n' "$PR" > "$FX/launchctl.out"
    echo 99 > "$FX/launchctl.left"
    run_oa "$PR" "go" --poll=1 --timeout=0
    want_rc 5
    : > "$FX/launchctl.out"
    run_oa_env REFIRE_MODE=ready REFIRE_RC=0 "$OA" "$PR" --finish --poll=0 --timeout=30
    want_rc 4
    want_posted "the verdict is NOT READY."
    no_refire
}

# ---------------------------------------------------------------------------
# Owner amendments: --fix-first appends to the plan, --record-amendments backfills
# ---------------------------------------------------------------------------
# The plan resolver matches a file name, so these cases name the PR branch amend-<case>
# (no slash). The worktree lookup then finds none, which the fix-first path allows.
amend_pr() {
    mkdir -p "$FX/home/claude-plans"
    jq -nc --arg h "$H" --arg b "amend-$CASE" '{state:"OPEN",headRefOid:$h,headRefName:$b,labels:[]}' > "$FX/pr.json"
}
amend_home() { # creates $FX/home/claude-plans/amend-<case>.md; sets PLANF
    amend_pr
    PLANF="$FX/home/claude-plans/amend-$CASE.md"
    printf '# Plan\n\n## Approach\n\nDo it.\n' > "$PLANF"
}
amend_count() { command grep -c '^<!-- owner-amendment comment=' "$1" 2>/dev/null || true; }
fix_first_appends_amendment() {
    fresh fix_first_appends_amendment
    amend_home
    run_oa_env HOME="$FX/home" "$OA" "$PR" "go" "--fix-first=rename the button"
    want_rc 6
    want_out "RESULT: fix-first-recorded"
    want_out "amendments: appended 1, present 0"
    [ "$(amend_count "$PLANF")" = 1 ] || note "plan has $(amend_count "$PLANF") entries, want 1"
    command grep -qxF 'Condition: rename the button' "$PLANF" || note "plan lacks the Condition line"
    command grep -qxF 'Owner words: go' "$PLANF" || note "plan lacks the Owner words line"
    command grep -qxF '## Owner amendments' "$PLANF" || note "plan lacks the section heading"
}
fix_first_second_run_appends_none() {
    fresh fix_first_second_run_appends_none
    amend_home
    run_oa_env HOME="$FX/home" "$OA" "$PR" "go" "--fix-first=rename the button"
    want_rc 6
    cp "$PLANF" "$FX/plan.after1"
    run_oa_env HOME="$FX/home" "$OA" "$PR" --record-amendments
    want_rc 0
    want_out "amendments: appended 0, present 1"
    cmp -s "$PLANF" "$FX/plan.after1" || note "the second run changed the plan"
    [ "$(amend_count "$PLANF")" = 1 ] || note "plan has $(amend_count "$PLANF") entries, want 1"
}
fix_first_missing_plan_exit_unchanged() {
    fresh fix_first_missing_plan_exit_unchanged
    amend_pr
    run_oa_env HOME="$FX/home" "$OA" "$PR" "go" "--fix-first=rename the button"
    want_rc 6
    want_out "RESULT: fix-first-recorded"
    want_out "owner amendment not recorded (exit 3); the approval comment is posted"
    want_out "no plan file for branch amend-fix_first_missing_plan_exit_unchanged"
    [ -z "$(ls -A "$FX/home/claude-plans")" ] || note "something was created under claude-plans"
    [ -f "$FX/posted.1.md" ] || note "no approval comment posted"
}
record_amendments_backfills_once() {
    fresh record_amendments_backfills_once
    amend_pr
    run_oa_env HOME="$FX/home" "$OA" "$PR" "go" "--fix-first=rename the button"
    want_rc 6
    amend_home
    run_oa_env HOME="$FX/home" "$OA" "$PR" --record-amendments
    want_rc 0
    want_out "amendments: appended 1, present 0"
    want_out "RESULT: amendments-recorded"
    [ "$(amend_count "$PLANF")" = 1 ] || note "plan has $(amend_count "$PLANF") entries after the backfill, want 1"
    [ ! -f "$FX/posted.2.md" ] || note "--record-amendments posted a comment"
    cp "$PLANF" "$FX/plan.after1"
    run_oa_env HOME="$FX/home" "$OA" "$PR" --record-amendments
    want_rc 0
    want_out "amendments: appended 0, present 1"
    cmp -s "$PLANF" "$FX/plan.after1" || note "the rerun changed the plan"
}
record_amendments_rejects_value_form() {
    fresh record_amendments_rejects_value_form
    run_oa "$PR" --record-amendments=yes
    want_rc 2
    want_out "--record-amendments takes no value"
    no_gh
    run_oa "$PR" --record-amendments "--fix-first=x"
    want_rc 2
    run_oa "$PR" --record-amendments --finish
    want_rc 2
    no_gh
}
record_amendments_headless_refused() {
    fresh record_amendments_headless_refused
    amend_home
    cp "$PLANF" "$FX/plan.before"
    run_oa_env HOME="$FX/home" CLAUDE_HEADLESS=1 "$OA" "$PR" --record-amendments
    want_rc 3
    want_out "RESULT: headless"
    no_gh
    cmp -s "$PLANF" "$FX/plan.before" || note "headless run changed the plan"
}

# ---------------------------------------------------------------------------
# Detach cases: --detach hands the wait to launchd (the shim records the submit)
# ---------------------------------------------------------------------------
oa_job_script() { printf '%s' "$FX/home/Library/Caches/com.ibl5.owner-approve/owner-approve-$PR.sh"; }
run_detach() { run_oa_env HOME="$FX/home" "$OA" "$PR" "$@"; }
want_lc() { grep -qF -- "$1" "$FX/launchctl.log" 2>/dev/null || note "launchctl.log lacks '$1'"; }
refute_lc() { if grep -qF -- "$1" "$FX/launchctl.log" 2>/dev/null; then note "launchctl.log unexpectedly has '$1'"; fi; }
no_launchctl() { [ ! -e "$FX/launchctl.log" ] || note "launchctl ran but should not have"; }
no_post() { if ls "$FX"/posted.*.md >/dev/null 2>&1; then note "a comment was posted"; fi; }
list_label() { # <label> <how many list calls see it>
    printf -- '-\t0\t%s\n' "$1" > "$FX/launchctl.out"
    echo "$2" > "$FX/launchctl.left"
}
detach_rejects_value_form() {
    fresh detach_rejects_value_form
    run_detach "ok" --detach=x
    want_rc 2
    want_out "--detach takes no value"
    no_gh
    no_launchctl
}
detach_rejects_combos() {
    fresh detach_rejects_combos
    run_detach --record-amendments --detach
    want_rc 2
    want_out "--detach cannot be combined with --record-amendments"
    no_gh
    run_detach "ok" --fix-first=x --detach
    want_rc 2
    want_out "--detach cannot be combined with --fix-first"
    no_gh
}
detach_headless_launches_nothing() {
    fresh detach_headless_launches_nothing
    run_oa_env HOME="$FX/home" CLAUDE_HEADLESS=1 "$OA" "$PR" "ok" --detach
    want_rc 3
    want_out "RESULT: headless"
    no_gh
    no_launchctl
}
detach_second_run_busy() {
    fresh detach_second_run_busy
    list_label "com.ibl5.owner-approve-$PR" 5
    run_detach "ok" --detach
    want_rc 7
    want_out "RESULT: busy"
    no_gh
    refute_lc "submit"
}
detach_busy_near_miss() {
    fresh detach_busy_near_miss
    list_label "com.ibl5.owner-approve-${PR}7" 5
    run_detach "ok" --detach
    want_rc 0
    want_out "RESULT: detached"
}
detach_launches_finish_child() {
    fresh detach_launches_finish_child
    local script
    script=$(oa_job_script)
    run_detach "ok" --detach --poll=0 --timeout=30
    want_rc 0
    want_out "RESULT: detached"
    want_out "Log: ${script%.sh}.log"
    want_posted "Owner approved"
    refute_gh "pr merge"
    refute_gh "pr edit"
    want_lc "submit -l com.ibl5.owner-approve-$PR "
    grep -qF 'OA_DETACHED_CHILD=1' "$script" 2>/dev/null || note "job script lacks OA_DETACHED_CHILD=1"
    grep -qF "$PR --finish --timeout=30 --poll=0" "$script" 2>/dev/null || note "job script lacks the --finish call"
    if grep -qw -- 'ok' "$script" 2>/dev/null; then note "the owner's words reached the job script"; fi
    [ ! -e "$FX/home/Library/Caches/com.ibl5.ljob-locks/owner-approve-$PR-lock.d" ] || note "the per-PR lock was not released"
}
detach_finish_launches_no_post() {
    fresh detach_finish_launches_no_post
    run_detach --finish --detach
    want_rc 0
    want_out "RESULT: detached"
    no_post
    want_lc "submit -l com.ibl5.owner-approve-$PR "
}
detach_submit_argv_env() {
    fresh detach_submit_argv_env
    local line
    run_detach "ok" --detach
    want_rc 0
    line=$(grep '^submit ' "$FX/launchctl.log" 2>/dev/null)
    grep -qF 'PATH=/usr/local/bin:/opt/homebrew/bin' <<< "$line" || note "submit argv lacks the job PATH"
    grep -qF "HOME=$FX/home" <<< "$line" || note "submit argv lacks HOME"
    if grep -qF '$HOME' <<< "$line"; then note "submit argv holds an unexpanded \$HOME"; fi
    if grep -qF " ''" <<< "$line"; then note "submit argv holds an empty argument"; fi
}
# Run by name only: it talks to the real launchd, with a stand-in sleep job.
detach_survives_group_kill() {
    if [ "$(uname -s)" != Darwin ]; then
        printf 'SKIP detach_survives_group_kill: needs macOS launchd\n'
        return 0
    fi
    fresh detach_survives_group_kill
    local d="$TMP/survive" label="com.ibl5.oa-survive-test-$$" leader n=0 snap
    mkdir -p "$d"
    printf '#!/bin/sh\nsleep 120\n' > "$d/job.sh"
    chmod +x "$d/job.sh"
    perl -e 'setpgrp(0,0); exec @ARGV' bash -c '. "$1/bin/lib/launchd-job.sh"
LAUNCHCTL_CMD=/bin/launchctl ljob_submit "$2" "$3/job.log" "$3/job.sh" && : > "$3/submitted"
nohup sleep 121 >/dev/null 2>&1 &
sleep 60' _ "$REPO" "$label" "$d" > "$d/leader.log" 2>&1 &
    leader=$!
    while [ "$n" -lt 50 ]; do
        if [ -e "$d/submitted" ] && /usr/bin/pgrep -f '^sleep 121$' >/dev/null 2>&1; then break; fi
        sleep 0.1; n=$((n + 1))
    done
    [ -e "$d/submitted" ] || note "ljob_submit did not succeed: $(cat "$d/leader.log")"
    /usr/bin/pgrep -f '^sleep 121$' >/dev/null 2>&1 || note "the nohup counterfactual never started"
    sleep 1
    kill -TERM -- "-$leader" 2>/dev/null || note "could not signal process group $leader"
    sleep 1
    snap=$(/bin/launchctl list 2>/dev/null)
    awk -F'\t' -v l="$label" '$3 == l {f=1} END {exit !f}' <<< "$snap" || note "the launchd job died with the process group"
    if /usr/bin/pgrep -f '^sleep 121$' >/dev/null 2>&1; then
        note "the nohup child survived the process-group kill"
        /usr/bin/pkill -f '^sleep 121$' 2>/dev/null
    fi
    /bin/launchctl remove "$label" >/dev/null 2>&1
    wait "$leader" 2>/dev/null
    return 0
}

# ---------------------------------------------------------------------------
# Detached child: it DMs on any non-zero exit and yields to a newer record
# ---------------------------------------------------------------------------
seed_plain_approval() { # a real plain approval that times out, leaving its marker comment
    list_label "com.ibl5.post-plan-fleet-$PR" 99
    run_oa "$PR" "go" --poll=1 --timeout=0
    want_rc 5
    : > "$FX/launchctl.out"
    echo 0 > "$FX/launchctl.left"
    rm -f "$FX/gh.log" "$FX/launchctl.log" "$FX"/posted.*.md
}
detach_child_not_self_live() {
    fresh detach_child_not_self_live
    seed_ready
    seed_plain_approval
    list_label "com.ibl5.owner-approve-$PR" 3
    printf '555 /usr/bin/env bash %s/bin/owner-approve %s --finish --timeout=30 --poll=0\n' "$WT" "$PR" > "$FX/pgrep.lf"
    echo 3 > "$FX/pgrep.left"
    run_oa_env HOME="$FX/home" OA_DETACHED_CHILD=1 "$OA" "$PR" --finish --poll=0 --timeout=30
    want_rc 0
    want_out "RESULT: armed"
    refute_out "waiting"
}
write_job() { # runs --detach so the job script exists
    run_detach "ok" --detach --poll=0 --timeout=0
    want_rc 0
    [ -x "$(oa_job_script)" ] || note "no job script was written"
}
run_job() { run_oa_env HOME="$FX/home" "${1:-$(oa_job_script)}"; }
want_dm() { grep -qF -- "$1" "$FX/dm.log" 2>/dev/null || note "dm.log lacks '$1'"; }
want_one_dm() {
    local n=0
    if [ -f "$FX/dm.log" ]; then n=$(grep -c . "$FX/dm.log"); fi
    [ "$n" -eq 1 ] || note "$n DMs sent, want 1"
}
want_job_gone() { [ ! -e "${1:-$(oa_job_script)}" ] || note "the job script did not delete itself"; }
detach_child_refuse_dms() {
    fresh detach_child_refuse_dms
    write_job
    run_job
    want_rc 4
    want_one_dm
    want_dm "PR #$PR"
    want_dm "exit 4"
    want_dm "RESULT: refused"
    want_job_gone
}
detach_child_timeout_dms() {
    fresh detach_child_timeout_dms
    seed_ready
    write_job
    list_label "com.ibl5.postplan-now-case-$CASE-20261112-101010-4242" 99
    run_job
    want_rc 5
    want_one_dm
    want_dm "PR #$PR"
    want_dm "exit 5"
    want_dm "RESULT: timeout"
    want_job_gone
}
detach_child_arms_no_dm() {
    fresh detach_child_arms_no_dm
    seed_ready
    write_job
    run_job
    want_rc 0
    [ ! -e "$FX/dm.log" ] || note "a DM was sent for an armed run: $(cat "$FX/dm.log")"
    want_gh "pr merge"
    want_job_gone
}
detach_child_crash_dms() {
    fresh detach_child_crash_dms
    write_job
    printf '#!/bin/sh\nexit 1\n' > "$FX/crash-stub"
    chmod +x "$FX/crash-stub"
    sed -E "s#^OA_DETACHED_CHILD=1 [^ ]+#OA_DETACHED_CHILD=1 $FX/crash-stub#" "$(oa_job_script)" > "$FX/crash.sh"
    chmod +x "$FX/crash.sh"
    grep -qF "OA_DETACHED_CHILD=1 $FX/crash-stub " "$FX/crash.sh" || note "the stub was not swapped in"
    run_job "$FX/crash.sh"
    want_rc 1
    want_one_dm
    want_dm "no RESULT line, so it crashed"
    want_job_gone "$FX/crash.sh"
}
# <case> <marker login> <marker head fields> [env assignment]: a second record lands
# while the child waits (posted by the launchctl hook on its first liveness check).
child_later_record() {
    fresh "$1"
    seed_ready
    seed_plain_approval
    list_label "com.ibl5.postplan-now-case-$1-20261112-101010-4242" 1
    jq -nc --arg u "$2" --arg b "fix this first"$'\n'"<!-- owner-approve mode=fix-first $3 -->" \
        '{user:{login:$u},body:$b}' > "$FX/hook.comment"
    printf '#!/bin/sh\ncat "$FX/hook.comment" >> "$FX/comments.ndjson"\n' > "$FX/launchctl.hook"
    chmod +x "$FX/launchctl.hook"
    run_oa_env HOME="$FX/home" ${4+"$4"} "$OA" "$PR" --finish --poll=0 --timeout=30
    [ ! -e "$FX/launchctl.hook" ] || note "the launchctl hook never ran"
}
want_yielded() {
    want_rc 4
    want_out "a newer owner-approve record"
    refute_gh "pr merge"
    refute_gh "pr edit"
}
want_armed() {
    want_rc 0
    want_out "RESULT: armed"
    want_gh "pr merge"
}
detach_child_fixfirst_wins() {
    child_later_record detach_child_fixfirst_wins owner "head=$A40" OA_DETACHED_CHILD=1
    want_yielded
}
detach_child_fixfirst_unread_head_wins() {
    child_later_record detach_child_fixfirst_unread_head_wins owner "head=unread diff=unread" OA_DETACHED_CHILD=1
    want_yielded
}
detach_child_foreign_fixfirst_ignored() {
    child_later_record detach_child_foreign_fixfirst_ignored someone "head=$A40" OA_DETACHED_CHILD=1
    want_armed
}
detach_child_env_unset_arms() {
    child_later_record detach_child_env_unset_arms owner "head=$A40"
    want_armed
}
detach_child_env_empty_arms() {
    child_later_record detach_child_env_empty_arms owner "head=$A40" OA_DETACHED_CHILD=
    want_armed
}

ALL_CASES="
