# B10: drift guard — every signal the real checker can emit keys cleanly
CHK="$SCRIPT_DIR/bug-pipeline-check"
eq "B10 every emit site names a literal signal" \
    "$(grep -cE 'emit (DEGRADED|UNKNOWN) ' "$CHK")" \
    "$(grep -cE 'emit (DEGRADED|UNKNOWN) [a-z]+:[a-z-]+ ' "$CHK")"
eq "B10 both emit arms print the SIGNAL shape" 2 "$(grep -c "printf 'SIGNAL: %s — %s" "$CHK")"
grep -oE 'emit (DEGRADED|UNKNOWN) [a-z]+:[a-z-]+' "$CHK" | awk '{print $3}' | sort -u > "$TMP/corpus.txt"
if [ "$(wc -l < "$TMP/corpus.txt")" -ge 20 ]; then ok "B10 corpus has at least 20 names"; else fail "B10 corpus size" "$(wc -l < "$TMP/corpus.txt") names"; fi
_B10_I=0
while read -r _name; do
    [ -n "$_name" ] || continue
    _B10_I=$((_B10_I+1))
    healthy_fixture "B10_$_B10_I"
    bpc_set 1 "SIGNAL: $_name — drift probe"
    run_checker
    eq "B10 $_name keys" 1 "$(count_fail "bug-pipeline:$_name")"
done < "$TMP/corpus.txt"

