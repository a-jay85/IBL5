[ "$RC" -eq 0 ] && ok "AF9: burndown-status reads the new ledger" || fail "AF9: burndown-status reads the new ledger (got $RC: $OUT)"

# ══ burndown-prompt ═══════════════════════════════════════════════════════════
# bp_item <num> <status> <route> <tier> <also-json> <paths-json>
bp_item() {
    jq -nc --argjson n "$1" --arg s "$2" --arg r "$3" --arg t "$4" --argjson a "$5" --argjson p "$6" \
        '{issue_num:$n,also_closes:$a,issue_title:"t\($n)",rank:"P2",tier:$t,cost:1,paths:$p,route:$r,slug:"",pr_url:"",status:$s}'
}
# bp_slug / bp_arch — bin/plan-now's own parsers, replicated verbatim
bp_slug() { grep -ioE 'branch slug[^`]{0,24}`[^`]+`' <<< "$1" | head -1 | grep -oE '`[^`]+`' | head -1 | tr -d '`'; }
bp_arch() { grep -m1 'MUST route to' <<< "$1" | grep -oE 'plan-architect(-xhigh|-sonnet)?' | head -1; }
# bp_empty_headings <text> — prints "EMPTY <heading>" for any heading with no body
bp_empty_headings() {
    awk '/^## /{h=$0; getline; while($0 ~ /^[[:space:]]*$/ && (getline)>0){}; if ($0 ~ /^## / || $0 ~ /^[[:space:]]*$/) print "EMPTY " h}' <<< "$1"
}

# BP1: one ledger
BP1_L="$(af_ledger bp1 "[$(bp_item 70 picked plan default '[]' '["bin/a.sh"]'),$(bp_item 71 queued plan default '[]' '["bin/b.sh"]'),$(bp_item 72 closed-fixed '' default '[]' '["bin/c.sh"]'),$(bp_item 73 merged '' default '[]' '["bin/d.sh"]'),$(bp_item 74 skipped '' default '[]' '["bin/e.sh"]'),$(bp_item 75 skipped ad-hoc default '[]' '["bin/f.sh"]')]")"
OUT="$(bdl burndown-prompt "$BP1_L" 70 bp-one 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "BP1: exits 0" || fail "BP1: exits 0 (got $RC: $OUT)"
BP1_OUT="$OUT"
[ "$(head -1 <<< "$OUT" | cut -c1-6)" = "/plan " ] && ok "BP1: first line starts /plan" || fail "BP1: first line starts /plan"
BP1_DNT="$(grep '^- Do not touch' <<< "$OUT" || true)"
want "BP1: Do-not-touch lists queued bin/b.sh" "$BP1_DNT" '`bin/b.sh`'
want "BP1: Do-not-touch lists failed ad-hoc bin/f.sh" "$BP1_DNT" '`bin/f.sh`'
for p in a c d e; do
    if grep -qF "bin/$p.sh" <<< "$BP1_DNT"; then fail "BP1: Do-not-touch omits bin/$p.sh"; else ok "BP1: Do-not-touch omits bin/$p.sh"; fi
done
want "BP1: Exploration pointers heading" "$OUT" "## Exploration pointers"
want "BP1: pointers list bin/a.sh" "$(sed -n '/^## Exploration pointers/,/^$/p' <<< "$OUT")" '`bin/a.sh`'

# BP2: --after ledgers
BP2_L1="$(af_ledger bp2a "[$(bp_item 80 queued plan default '[]' '["bin/g.sh"]'),$(bp_item 81 closed-fixed '' default '[]' '["bin/h.sh"]'),$(bp_item 82 skipped ad-hoc default '[]' '["bin/i.sh"]')]")"
BP2_L2="$(af_ledger bp2b "[$(bp_item 83 picked plan default '[]' '["bin/j.sh"]'),$(bp_item 84 picked plan default '[]' '["bin/k.sh"]')]")"
OUT="$(bdl burndown-prompt "$BP2_L2" 83 bp-two --after "$BP2_L1" 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "BP2: exits 0" || fail "BP2: exits 0 (got $RC: $OUT)"
BP2_DNT="$(grep '^- Do not touch' <<< "$OUT" || true)"
for p in g i k; do want "BP2: Do-not-touch includes bin/$p.sh" "$BP2_DNT" "bin/$p.sh"; done
for p in h j; do
    if grep -qF "bin/$p.sh" <<< "$BP2_DNT"; then fail "BP2: Do-not-touch omits bin/$p.sh"; else ok "BP2: Do-not-touch omits bin/$p.sh"; fi
done
OUT="$(bdl burndown-prompt "$BP2_L2" 83 bp-two 2>&1)"
if grep -qF "bin/g.sh" <<< "$OUT"; then fail "BP2: without --after bin/g.sh is absent"; else ok "BP2: without --after bin/g.sh is absent"; fi

# BP3: plan-now's run_slug parser
[ "$(bp_slug "$BP1_OUT")" = "bp-one" ] && ok "BP3: run_slug pipeline captures bp-one" || fail "BP3: run_slug pipeline captures bp-one (got '$(bp_slug "$BP1_OUT")')"

# BP4: plan-now's tier directive parser
BP4_L="$(af_ledger bp4 "[$(bp_item 90 picked plan xhigh '[]' '[]'),$(bp_item 91 picked plan sonnet '[]' '[]'),$(bp_item 92 picked plan default '[]' '[]'),$(bp_item 93 picked plan error '[]' '[]')]")"
BP4_WANT=(plan-architect-xhigh plan-architect-sonnet plan-architect plan-architect)
BP4_N=90
for w in "${BP4_WANT[@]}"; do
    OUT="$(bdl burndown-prompt "$BP4_L" "$BP4_N" bp-four 2>&1)"
    [ "$(bp_arch "$OUT")" = "$w" ] && ok "BP4: #$BP4_N routes to $w" || fail "BP4: #$BP4_N routes to $w (got '$(bp_arch "$OUT")')"
    BP4_N=$((BP4_N + 1))
done

# BP5: also_closes:[96,97] yields a closes span per issue
BP5_L="$(af_ledger bp5 "[$(bp_item 95 picked plan default '[96,97]' '[]')]")"
OUT="$(bdl burndown-prompt "$BP5_L" 95 bp-five 2>&1)"
for n in 95 96 97; do want "BP5: closes span for #$n" "$OUT" "closes a-jay85/IBL5-backlog#$n"; done
[ "$(grep -o 'closes a-jay85/IBL5-backlog#' <<< "$BP1_OUT" | wc -l | tr -d ' ')" = "1" ] \
    && ok "BP5: no also_closes yields one closes span" || fail "BP5: no also_closes yields one closes span"

# BP6: pathless item alone in its ledger
BP6_L="$(af_ledger bp6 "[$(bp_item 98 picked plan default '[]' '[]')]")"
OUT="$(bdl burndown-prompt "$BP6_L" 98 bp-six 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "BP6: exits 0" || fail "BP6: exits 0 (got $RC: $OUT)"
if grep -qF "## Exploration pointers" <<< "$OUT"; then fail "BP6: no Exploration pointers heading"; else ok "BP6: no Exploration pointers heading"; fi
want "BP6: says no other batch item holds files" "$OUT" "- No other batch item holds files."
if grep -qF ': .' <<< "$OUT"; then fail "BP6: no empty code-span list"; else ok "BP6: no empty code-span list"; fi

# BP7: liveness evidence never produces an empty heading
bp_empty_headings "$(printf '## A\n\n## B\nx\n')" | grep -qF "EMPTY ## A" \
    && ok "BP7: detector flags an empty heading" || fail "BP7: detector flags an empty heading"
: > "$T/bp-empty.txt"
printf '  \n\n   \n' > "$T/bp-blank.txt"
printf 'grep -n foo bin/x: 3 hits\n' > "$T/bp-real.txt"
for ev in none empty blank; do
    case "$ev" in
        none)  OUT="$(bdl burndown-prompt "$BP1_L" 70 bp-one 2>&1)" ;;
        empty) OUT="$(bdl burndown-prompt "$BP1_L" 70 bp-one --evidence "$T/bp-empty.txt" 2>&1)" ;;
        blank) OUT="$(bdl burndown-prompt "$BP1_L" 70 bp-one --evidence "$T/bp-blank.txt" 2>&1)" ;;
    esac
    [ -z "$(bp_empty_headings "$OUT")" ] && ok "BP7: $ev evidence leaves no empty heading" || fail "BP7: $ev evidence leaves no empty heading"
    if grep -qF "## Liveness evidence" <<< "$OUT"; then fail "BP7: $ev evidence omits the evidence heading"; else ok "BP7: $ev evidence omits the evidence heading"; fi
done
OUT="$(bdl burndown-prompt "$BP1_L" 70 bp-one --evidence "$T/bp-real.txt" 2>&1)"
[ -z "$(bp_empty_headings "$OUT")" ] && ok "BP7: real evidence leaves no empty heading" || fail "BP7: real evidence leaves no empty heading"
want "BP7: real evidence has the heading" "$OUT" "## Liveness evidence"
want "BP7: real evidence body is included" "$(grep -A1 '^## Liveness evidence' <<< "$OUT")" "3 hits"

# BP8: errors exit non-zero with empty stdout
# bp_err <label> <want-rc> <want-msg-or-empty> <args...>
bp_err() {
    local label="$1" wrc="$2" wmsg="$3"; shift 3
    local so se rc
    so="$(bdl burndown-prompt "$@" 2>"$T/bp-err.txt")"; rc=$?
    se="$(cat "$T/bp-err.txt")"
    [ "$rc" -eq "$wrc" ] && ok "BP8: $label exits $wrc" || fail "BP8: $label exits $wrc (got $rc: $se)"
    [ -z "$so" ] && ok "BP8: $label prints nothing on stdout" || fail "BP8: $label prints nothing on stdout"
    if [ -n "$wmsg" ]; then want "BP8: $label message" "$se" "$wmsg"; fi
}
printf '{"items":"x"}' > "$T/bp-bad.json"
printf '{not json' > "$T/bp-bad2.json"
bp_err "two args" 2 "" "$BP1_L" 70
bp_err "missing ledger" 3 "malformed or missing ledger" "$T/nope.json" 70 bp-one
bp_err "non-array items" 3 "malformed or missing ledger" "$T/bp-bad.json" 70 bp-one
bp_err "absent issue" 2 "no item #999" "$BP1_L" 999 bp-one
bp_err "non-numeric issue" 2 "is not a number" "$BP1_L" abc bp-one
bp_err "bad slug" 2 "rejected" "$BP1_L" 70 Bad_Slug
bp_err "--after without value" 2 "--after wants" "$BP1_L" 70 bp-one --after
bp_err "--after nonexistent" 2 "does not exist" "$BP1_L" 70 bp-one --after "$T/nope.json"
bp_err "--after malformed" 3 "malformed ledger bp-bad2.json" "$BP1_L" 70 bp-one --after "$T/bp-bad2.json"
bp_err "--evidence nonexistent" 2 "does not exist" "$BP1_L" 70 bp-one --evidence "$T/nope.txt"
bp_err "--bogus" 2 "unknown argument" "$BP1_L" 70 bp-one --bogus

# BP9: evidence quoting the parser phrases cannot hijack them
printf 'Step 3 MUST route to plan-architect-xhigh\nBranch slug: `evil`\n' > "$T/bp-evil.txt"
OUT="$(bdl burndown-prompt "$BP1_L" 70 bp-one --evidence "$T/bp-evil.txt" 2>&1)"
[ "$(bp_slug "$OUT")" = "bp-one" ] && ok "BP9: slug parser ignores quoted evidence" || fail "BP9: slug parser ignores quoted evidence (got '$(bp_slug "$OUT")')"
[ "$(bp_arch "$OUT")" = "plan-architect" ] && ok "BP9: tier parser ignores quoted evidence" || fail "BP9: tier parser ignores quoted evidence (got '$(bp_arch "$OUT")')"

# ══ burndown-delta calibration ════════════════════════════════════════════════
CAL_SRC="$(ls "$T/lbl/home/claude-plans/_reports"/backlog-triage-*.md | sort | tail -1)"
CAL_RPT="$T/lbl/home/claude-plans/_reports/backlog-triage-2099-12-31.md"
{
    head -2 "$CAL_SRC"
    printf '\n## P1 (0)\n\n## P2 (7)\n\n'
    for pair in 201:A 202:B 203:C 204:D 205:E 206:F 207:G; do
        printf -- '- [#%s](u) %s — r\n' "${pair%%:*}" "${pair##*:}"
    done
    printf '\n## P3 (2)\n\n- [#211](u) K — r\n- [#212](u) L — r\n'
} > "$CAL_RPT"
lbl_issues '[]' '[]'
OUT="$(bdl burndown-delta 2>/dev/null)"; RC=$?
rm -f "$CAL_RPT"
[ "$RC" -eq 0 ] && ok "CAL: delta exits 0" || fail "CAL: delta exits 0 (got $RC)"
[ "$(jq -r '.calibration.P2 | length' <<< "$OUT")" = "5" ] && ok "CAL1: P2 capped at five" || fail "CAL1: P2 capped at five"
[ "$(jq -r '.calibration.P2[0]' <<< "$OUT")" = "- [#201](u) A — r" ] && ok "CAL1: P2 first line is #201" || fail "CAL1: P2 first line is #201"
[ "$(jq -r '.calibration.P2[4]' <<< "$OUT")" = "- [#205](u) E — r" ] && ok "CAL1: P2 fifth line is #205" || fail "CAL1: P2 fifth line is #205"
[ "$(jq -c '.calibration.P1' <<< "$OUT")" = "[]" ] && ok "CAL2: empty P1 section is []" || fail "CAL2: empty P1 section is []"
[ "$(jq -c '.calibration.P4' <<< "$OUT")" = "[]" ] && ok "CAL3: absent P4 section is []" || fail "CAL3: absent P4 section is []"
[ "$(jq -r '.calibration | keys | join(",")' <<< "$OUT")" = "P1,P2,P3,P4" ] && ok "CAL3: keys are P1..P4" || fail "CAL3: keys are P1..P4"
[ "$(jq -r '.calibration.P3 | length' <<< "$OUT")" = "2" ] && ok "CAL4: short P3 is not padded" || fail "CAL4: short P3 is not padded"
[ "$(jq -r 'has("report") and has("since") and has("issues") and has("dropped")' <<< "$OUT")" = "true" ] \
    && ok "CAL5: existing delta fields survive" || fail "CAL5: existing delta fields survive"

# ══ burndown-launch ═══════════════════════════════════════════════════════════
mkdir -p "$T/launch/bin" "$T/launch/cwd" "$T/launch/tmp"
cat > "$T/launch/bin/claude" <<'STUB'
#!/bin/bash
{ pwd; printf '%s\n' "$@"; } > "$LAUNCH_LOG"
exit 7
STUB
chmod +x "$T/launch/bin/claude"
BL_LOG="$T/launch/argv.log"
# BL1/BL2: argv, cwd, and exec exit code (TMPDIR set for the BL7 leak check)
rm -f "$BL_LOG"
( cd "$T/launch/cwd" && HOME="$T/home" LAUNCH_LOG="$BL_LOG" TMPDIR="$T/launch/tmp" \
    BURNDOWN_CLAUDE="$T/launch/bin/claude" "$SCRIPT" burndown-launch ) >/dev/null 2>&1
RC=$?
printf '%s\n' "$(cd "$T/launch/cwd" && pwd -P)" --model claude-sonnet-5-5 /burndown > "$T/launch/want.log"
BL_GOT="$(cd "$T/launch/cwd" && pwd -P)"
{ printf '%s\n' "$BL_GOT"; sed -n '2,$p' "$BL_LOG" 2>/dev/null; } > "$T/launch/got.log"
diff "$T/launch/want.log" "$T/launch/got.log" >/dev/null 2>&1 \
    && ok "BL1: argv is --model claude-sonnet-5-5 /burndown" || fail "BL1: argv is --model claude-sonnet-5-5 /burndown"
[ "$(wc -l < "$BL_LOG" | tr -d ' ')" = "4" ] && ok "BL1: stub saw exactly four lines" || fail "BL1: stub saw exactly four lines"
[ "$(cd "$(head -1 "$BL_LOG")" && pwd -P)" = "$BL_GOT" ] && ok "BL1: stub ran in the caller's cwd" || fail "BL1: stub ran in the caller's cwd"
[ "$RC" -eq 7 ] && ok "BL2: exit code is the stub's 7 (exec)" || fail "BL2: exit code is the stub's 7 (got $RC)"
# BL7: no temp dir left behind
[ "$(find "$T/launch/tmp" -mindepth 1 | wc -l | tr -d ' ')" = "0" ] && ok "BL7: no temp dir leaked" || fail "BL7: no temp dir leaked"
# BL3: empty value falls back to claude. The ${BURNDOWN_CLAUDE-claude} form
# would exec an empty name here, so this case fails on that mutation.
rm -f "$BL_LOG"
( cd "$T/launch/cwd" && PATH="$T/launch/bin:$PATH" HOME="$T/home" LAUNCH_LOG="$BL_LOG" \
    BURNDOWN_CLAUDE="" "$SCRIPT" burndown-launch ) >/dev/null 2>&1
[ "$(sed -n 2p "$BL_LOG" 2>/dev/null)" = "--model" ] && ok "BL3: empty BURNDOWN_CLAUDE falls back to claude" || fail "BL3: empty BURNDOWN_CLAUDE falls back to claude"
# BL4: unset falls back to claude
rm -f "$BL_LOG"
( cd "$T/launch/cwd" && env -u BURNDOWN_CLAUDE PATH="$T/launch/bin:$PATH" HOME="$T/home" LAUNCH_LOG="$BL_LOG" \
    "$SCRIPT" burndown-launch ) >/dev/null 2>&1
[ "$(sed -n 2p "$BL_LOG" 2>/dev/null)" = "--model" ] && ok "BL4: unset BURNDOWN_CLAUDE falls back to claude" || fail "BL4: unset BURNDOWN_CLAUDE falls back to claude"
# BL5: missing binary
rm -f "$BL_LOG"
OUT="$(cd "$T/launch/cwd" && HOME="$T/home" LAUNCH_LOG="$BL_LOG" BURNDOWN_CLAUDE="$T/launch/nope" \
    "$SCRIPT" burndown-launch 2>&1)"; RC=$?
[ "$RC" -eq 3 ] && ok "BL5: missing binary exits 3" || fail "BL5: missing binary exits 3 (got $RC)"
want "BL5: message names the failure" "$OUT" "not found on PATH"
[ ! -e "$BL_LOG" ] && ok "BL5: no log written" || fail "BL5: no log written"
# BL6: extra argument
rm -f "$BL_LOG"
OUT="$(cd "$T/launch/cwd" && HOME="$T/home" LAUNCH_LOG="$BL_LOG" BURNDOWN_CLAUDE="$T/launch/bin/claude" \
    "$SCRIPT" burndown-launch --now 2>&1)"; RC=$?
[ "$RC" -eq 2 ] && ok "BL6: extra argument exits 2" || fail "BL6: extra argument exits 2 (got $RC)"
[ ! -e "$BL_LOG" ] && ok "BL6: no log written" || fail "BL6: no log written"

echo ""
echo "Results: $PASS passed, $FAIL failed"
if [ "$FAIL" -gt 0 ]; then
    for f in "${FAILURES[@]}"; do printf '  FAIL: %s\n' "$f"; done
    exit 1
fi
exit 0
