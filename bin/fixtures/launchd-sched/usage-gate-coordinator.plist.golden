<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ibl5.usage-gate-coordinator</string>
	<key>ProgramArguments</key>
	<array>
		<string>@MAIN_WT@/bin/usage-gate-coordinator</string>
		<string>--once</string>
	</array>
	<key>StartInterval</key>
	<integer>60</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>AbandonProcessGroup</key>
	<true/>
	<key>WorkingDirectory</key>
	<string>@MAIN_WT@</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:@HOME@/.local/bin</string>
	</dict>
	<key>StandardOutPath</key>
	<string>@HOME@/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/usage-gate/launchd-stdout.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/usage-gate/launchd-stderr.log</string>
</dict>
</plist>
