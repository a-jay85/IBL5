#!/usr/bin/env bash
# scrub-log-credentials — remove call arguments from historical exception traces in
# IBL5 JSON logs. Historical files only; new leaks are prevented at the source by
# Bootstrap\ErrorHandlerRegistrar::buildArgFreeTrace().
#
# MANUAL OPERATOR TOOL. Never wire this into CI, cron, a deploy hook, or another
# script. It rewrites log files in place. Defaults to dry-run.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WRITE=false
LOG_DIR="${REPO_ROOT}/ibl5/logs"
PROD=false
SSH_HOST=""
SSH_PORT=""
SSH_KEY=""

usage() {
    cat >&2 <<'USAGE'
Usage: bin/scrub-log-credentials [OPTIONS]

Remove call arguments from historical exception traces in IBL5 JSON logs.
Defaults to dry-run — use --write to actually modify files.

Options:
  --write               Modify files in place (with backup)
  --log-dir=<path>      Local directory to scan (default: ibl5/logs)
  --prod                Operate over SSH against the prod log directory
  --ssh-host=<host>     SSH user@host (overrides .env PROD_SSH_HOST)
  --ssh-port=<port>     SSH port
  --ssh-key=<file>      SSH private key file
  -h, --help            Show this help and exit
USAGE
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --write)          WRITE=true; shift ;;
        --log-dir=*)      LOG_DIR="${1#--log-dir=}"; shift ;;
        --prod)           PROD=true; shift ;;
        --ssh-host=*)     SSH_HOST="${1#--ssh-host=}"; shift ;;
        --ssh-port=*)     SSH_PORT="${1#--ssh-port=}"; shift ;;
        --ssh-key=*)      SSH_KEY="${1#--ssh-key=}"; shift ;;
        -h|--help)        usage; exit 0 ;;
        *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
    esac
done

command -v jq >/dev/null 2>&1 || { echo "scrub-log-credentials: jq is required" >&2; exit 1; }

# ---------------------------------------------------------------------------
# jq defs — written to a temp file so backslashes reach jq verbatim
# ---------------------------------------------------------------------------
JQ_FILTER_FILE=$(mktemp "${TMPDIR:-/tmp}/scrub-log-credentials-jq.XXXXXX")
trap 'rm -f "$JQ_FILTER_FILE"' EXIT

cat > "$JQ_FILTER_FILE" << 'JQEOF'
def strip_args:
  split("\n")
  | map(
      sub("^(?<h>#[0-9]+ .*?\\([0-9]+\\): [^(]*)\\(.*$"; "\(.h)()")
      | sub("^(?<h>#[0-9]+ \\[internal function\\]: [^(]*)\\(.*$"; "\(.h)()")
    )
  | join("\n");

def is_clean:
  split("\n") | all(
    test("^#[0-9]+ \\{main\\}$")
    or test("^#[0-9]+ .*\\(\\)$")
    or test("^#[0-9]+ .*\\(\\) at .+:[0-9]+$")
  );

def redacted: "[REDACTED: frame arguments removed by bin/scrub-log-credentials]";

def process_trace:
  . as $old
  | if . == redacted then {val: $old, changed: false}
    else
      (. | strip_args) as $new
      | if ($new | is_clean)
        then {val: $new, changed: ($new != $old)}
        else {val: redacted, changed: ($old != redacted)}
        end
    end;

# Input: one raw NDJSON line (string via --raw-input)
# Output: {"out": string, "hit": bool}
. as $raw
| (try ($raw | fromjson) catch null) as $parsed
| if $parsed == null then
    {out: $raw, hit: false}
  elif (($parsed | .context.trace) | type) == "string" then
    ($parsed.context.trace | process_trace) as $res
    | {out: ($parsed | .context.trace = $res.val | tojson), hit: $res.changed}
  elif (($parsed | .context.exception.trace) | type) == "string" then
    ($parsed.context.exception.trace | process_trace) as $res
    | {out: ($parsed | .context.exception.trace = $res.val | tojson), hit: $res.changed}
  else
    {out: ($parsed | tojson), hit: false}
  end
JQEOF

# ---------------------------------------------------------------------------
# Process one local log file — returns hit count via stdout ("HITS:<n>")
# and writes transformed lines to $out_file.
# ---------------------------------------------------------------------------
process_file_local() {
    local file="$1"
    local out_file="$2"
    local hits=0
    local lineno=0
    local hit_lines=()

    while IFS= read -r line; do
        lineno=$((lineno + 1))
        result=$(printf '%s' "$line" | jq -Rc -f "$JQ_FILTER_FILE" 2>/dev/null || true)
        if [[ -z "$result" ]]; then
            # jq itself failed (very malformed input) — pass through unchanged
            printf '%s\n' "$line" >> "$out_file"
            continue
        fi
        hit=$(printf '%s' "$result" | jq -r '.hit')
        if [[ "$hit" == "true" ]]; then
            hits=$((hits + 1))
            hit_lines+=("$lineno")
        fi
        printf '%s' "$result" | jq -r '.out' >> "$out_file"
    done < "$file"

    if [[ ${#hit_lines[@]} -gt 0 ]]; then
        printf '%s: lines %s\n' "$file" "$(IFS=,; echo "${hit_lines[*]}")"
    fi
    echo "HITS:${hits}"
}

# ---------------------------------------------------------------------------
# Local mode
# ---------------------------------------------------------------------------
run_local() {
    local total_hits=0
    local tmp_global
    tmp_global=$(mktemp "${TMPDIR:-/tmp}/scrub-log-credentials.XXXXXX")
    trap 'rm -f "$tmp_global"' RETURN

    for f in "${LOG_DIR}"/*.log; do
        [[ -f "$f" ]] || continue
        # Skip backup files — they are read-only archives, not active logs
        [[ "$f" == *.bak-*.log ]] && continue

        local tmpout
        tmpout=$(mktemp "${TMPDIR:-/tmp}/scrub-log-credentials.XXXXXX")
        # Ensure tmpout is cleaned even on error
        # (EXIT trap removes JQ_FILTER_FILE; this removes the per-file tmp)
        local file_hits=0

        result_text=$(process_file_local "$f" "$tmpout")
        file_hits=$(printf '%s\n' "$result_text" | grep '^HITS:' | head -1 | cut -d: -f2)
        file_hits=${file_hits:-0}
        total_hits=$((total_hits + file_hits))

        if [[ "$WRITE" == "true" && "$file_hits" -gt 0 ]]; then
            local backup
            backup="${f%.log}.bak-$(date -u +%Y%m%dT%H%M%SZ).log"
            cp -p "$f" "$backup"
            if [[ ! -s "$backup" ]]; then
                echo "scrub-log-credentials: backup failed for $f" >&2
                rm -f "$tmpout"
                exit 1
            fi
            mv "$tmpout" "$f"
        else
            rm -f "$tmpout"
        fi
    done

    echo "Total hits: ${total_hits}"
    if [[ "$WRITE" == "false" ]]; then
        echo "DRY RUN — no files modified. Re-run with --write to apply."
    fi
}

# ---------------------------------------------------------------------------
# Prod SSH mode
# ---------------------------------------------------------------------------
run_prod() {
    # Resolve SSH_HOST from .env if not given on command line
    if [[ -z "$SSH_HOST" ]]; then
        ENV_FILE="${REPO_ROOT}/.env"
        if [[ ! -f "$ENV_FILE" ]]; then
            local git_root
            git_root="$(git -C "$REPO_ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null | sed 's|/\.git$||')" || true
            if [[ -n "$git_root" && -f "${git_root}/.env" ]]; then
                ENV_FILE="${git_root}/.env"
            fi
        fi
        if [[ -f "$ENV_FILE" ]]; then
            # shellcheck source=/dev/null
            source "$ENV_FILE"
        fi

        # Distinct checks for unset vs set-but-empty
        if [[ -z "${PROD_SSH_HOST+x}" ]]; then
            echo "scrub-log-credentials: PROD_SSH_HOST is not set — provide --ssh-host or set PROD_SSH_HOST in .env" >&2
            exit 1
        fi
        if [[ -z "${PROD_SSH_HOST}" ]]; then
            echo "scrub-log-credentials: PROD_SSH_HOST is set but empty — provide --ssh-host or set a valid PROD_SSH_HOST in .env" >&2
            exit 1
        fi
        SSH_HOST="${PROD_SSH_HOST}"
    fi

    # Build SSH_ARGS
    SSH_ARGS=""
    [[ -n "$SSH_PORT" ]] && SSH_ARGS="$SSH_ARGS -p $SSH_PORT"
    [[ -n "$SSH_KEY" ]]  && SSH_ARGS="$SSH_ARGS -i $SSH_KEY"

    local write_flag=""
    [[ "$WRITE" == "true" ]] && write_flag="--write"

    # shellcheck disable=SC2086
    ssh $SSH_ARGS "$SSH_HOST" bash << REMOTE
set -euo pipefail
command -v jq >/dev/null 2>&1 || { echo "scrub-log-credentials: jq is required on remote" >&2; exit 1; }

cd www/ibl5/logs 2>/dev/null || cd ~/www/ibl5/logs 2>/dev/null || {
    echo "scrub-log-credentials: prod log dir not found" >&2
    exit 1
}

JQ_FILTER=\$(cat << 'REMOTEJQ'
def strip_args:
  split("\n")
  | map(
      sub("^(?<h>#[0-9]+ .*?\\([0-9]+\\): [^(]*)\\(.*\$"; "\(.h)()")
      | sub("^(?<h>#[0-9]+ \\[internal function\\]: [^(]*)\\(.*\$"; "\(.h)()")
    )
  | join("\n");
def is_clean:
  split("\n") | all(test("^#[0-9]+ \\{main\\}\$") or test("^#[0-9]+ .*\\(\\)\$"));
def redacted: "[REDACTED: frame arguments removed by bin/scrub-log-credentials]";
def process_trace:
  . as \$old | (. | strip_args) as \$new
  | if (\$new | is_clean) then {val: \$new, changed: (\$new != \$old)}
    else {val: redacted, changed: true}
    end;
. as \$raw
| (try (\$raw | fromjson) catch null) as \$parsed
| if \$parsed == null then {out: \$raw, hit: false}
  elif ((\$parsed | .context.trace) | type) == "string" then
    (\$parsed.context.trace | process_trace) as \$res
    | {out: (\$parsed | .context.trace = \$res.val | tojson), hit: \$res.changed}
  elif ((\$parsed | .context.exception.trace) | type) == "string" then
    (\$parsed.context.exception.trace | process_trace) as \$res
    | {out: (\$parsed | .context.exception.trace = \$res.val | tojson), hit: \$res.changed}
  else {out: (\$parsed | tojson), hit: false}
  end
REMOTEJQ
)

total_hits=0
for f in *.log; do
    [[ -f "\$f" ]] || continue

    hits=0
    tmpout=\$(mktemp)
    lineno=0
    hit_lines=""
    while IFS= read -r line; do
        lineno=\$((lineno + 1))
        result=\$(printf '%s' "\$line" | jq -c -f /dev/stdin <<< "\$JQ_FILTER" 2>/dev/null || true)
        if [[ -z "\$result" ]]; then
            printf '%s\n' "\$line" >> "\$tmpout"
            continue
        fi
        hit=\$(printf '%s' "\$result" | jq -r '.hit')
        if [[ "\$hit" == "true" ]]; then
            hits=\$((hits + 1))
            hit_lines="\${hit_lines:+\$hit_lines,}\$lineno"
        fi
        printf '%s' "\$result" | jq -r '.out' >> "\$tmpout"
    done < "\$f"

    [[ -n "\$hit_lines" ]] && echo "\$f: lines \$hit_lines"
    total_hits=\$((total_hits + hits))

    if [[ "${write_flag}" == "--write" && "\$hits" -gt 0 ]]; then
        backup="\${f%.log}.bak-\$(date -u +%Y%m%dT%H%M%SZ).log"
        cp -p "\$f" "\$backup"
        [[ -s "\$backup" ]] || { echo "scrub-log-credentials: backup failed for \$f" >&2; rm -f "\$tmpout"; exit 1; }
        mv "\$tmpout" "\$f"
    else
        rm -f "\$tmpout"
    fi
done

echo "Total hits: \${total_hits}"
[[ "${write_flag}" == "--write" ]] || echo "DRY RUN — no files modified. Re-run with --write to apply."
REMOTE
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
if [[ "$PROD" == "true" ]]; then
    run_prod
else
    run_local
fi
