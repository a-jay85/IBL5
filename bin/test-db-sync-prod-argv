#!/usr/bin/env bash
# bin/test-db-sync-prod-argv — characterization harness for the mariadb argv that
# bin/db-sync-prod sends to `docker exec` on the --snapshot path, plus the
# bin/lib/db-helpers.sh constants and db_cmd helper behind it.
#
# Pins the six preserve-tables probes, the in-container preserved-tables dump,
# the two db_import_sql loads, the schema_migrations backfill and the final row
# count. docker is stubbed on PATH: no Docker, no MariaDB, no prod contact.
#
# Cases: D1 default argv, O1 env override, N1 ambient DB_NAME ignored, F1
# fail-closed probe, S1 dump stdout/stderr separation, L1-L4 db_cmd unit cases,
# M1-M3 DB_CMD composition in db-migrate/db-test-up/wt-up, E1 e2e-wt pin, P1 keep-list
# covers every ibl_bug_* table the migrations create, P2 keep-list order, P3-P4 no inline
# list or source, K1-K12 fail-closed keep-list, R1-R9 preserved-table replay.
set -euo pipefail
# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
h_tmp TMP

pass()     { h_pass "$1"; }
failcase() { h_fail "$1" "$2"; }

assert_eq() {  # <label> <expected> <actual>
    h_eq "$1" "$2" "$3"
}
assert_match() {  # <label> <needle> <haystack>
    h_contains "$1" "$3" "$2"
}
count_in() {  # <needle> <haystack> — fixed-string line count, herestring (no pipe SIGPIPE)
    grep -cF -- "$1" <<<"$2" || true
}

STUBBIN="$TMP/bin"
mkdir -p "$STUBBIN"
export STUB_ARGV_LOG="$TMP/argv"

cat > "$STUBBIN/docker" <<'STUB'
#!/bin/bash
printf '%s\n' "$*" >> "$STUB_ARGV_LOG.docker"
case "$1" in
    ps)   printf 'ibl5-mariadb\n'; exit 0 ;;
    exec)
        case "$*" in
            *'/* pre-sync */'*)      printf '%s' "${STUB_PRE_VERSIONS:-}" ;;
            *'/* post-backfill */'*) printf '%s' "${STUB_POST_VERSIONS:-}" ;;
            *information_schema.tables*)
                if [ "${STUB_PROBE_RC:-0}" -ne 0 ]; then
                    echo "ERROR 2002 (HY000): stub probe failure" >&2
                    exit "$STUB_PROBE_RC"
                fi
                printf '1\n' ;;
            *mariadb-dump*)
                [ -n "${STUB_DUMP_STDERR:-}" ] && echo "$STUB_DUMP_STDERR" >&2
                printf -- '-- stub dump body\nINSERT INTO ibl_api_keys VALUES (1);\n' ;;
            *--force*)
                cat >/dev/null
                [ -n "${STUB_IMPORT_ERROR:-}" ] && echo "$STUB_IMPORT_ERROR" ;;
            *) : ;;
        esac
        exit 0 ;;
    *) exit 0 ;;
esac
STUB
chmod +x "$STUBBIN/docker"

# Sandbox checkout so REPO_ROOT inside db-sync-prod resolves here and
# worktrees_parent_dir sees a git repo.
MAIN="$TMP/IBL5"
mkdir -p "$MAIN/bin/lib"
cp "$REPO_ROOT/bin/lib/db-helpers.sh"  "$MAIN/bin/lib/db-helpers.sh"
cp "$REPO_ROOT/bin/lib/git-helpers.sh" "$MAIN/bin/lib/git-helpers.sh"
cp "$REPO_ROOT/bin/db-sync-prod"       "$MAIN/bin/db-sync-prod"
cp "$REPO_ROOT/bin/db-sync-preserve-tables.txt" "$MAIN/bin/db-sync-preserve-tables.txt"
chmod +x "$MAIN/bin/db-sync-prod"
h_git_repo "$MAIN" --no-commit
git -C "$MAIN" add -A
git -C "$MAIN" commit -qm init

printf 'SELECT 1;\n' | gzip -c > "$TMP/snap.sql.gz"

run_sync() {   # usage: run_sync [VAR=value ...] — extra env assignments for a case
    : > "$STUB_ARGV_LOG.docker"
    set +e
    OUT=$(cd "$TMP" && env -i PATH="$STUBBIN:/usr/bin:/bin" HOME="$TMP" TMPDIR="$TMP" \
          STUB_ARGV_LOG="$STUB_ARGV_LOG" "$@" \
          "$MAIN/bin/db-sync-prod" --snapshot "$TMP/snap.sql.gz" 2>"$TMP/err")
    RC=$?
    set -e
    ERR=$(cat "$TMP/err")
    LOG=$(cat "$STUB_ARGV_LOG.docker")
}

# The default-argv pin. The expected strings are what the unmodified
# db-sync-prod logged; the refactor must keep them byte-identical.
assert_default_argv() {  # <label>
    local l="$1"
    assert_eq "$l exit 0" "0" "$RC"
    assert_eq "$l probe argv x6" "6" \
        "$(count_in 'exec ibl5-mariadb mariadb -uroot -proot -N -B -e SELECT COUNT(*) FROM information_schema.tables' "$LOG")"
    assert_eq "$l probe schema literal" "1" \
        "$(count_in "WHERE table_schema='iblhoops_ibl5' AND table_name='ibl_bug_reports'" "$LOG")"
    assert_eq "$l dump argv" "1" \
        "$(count_in 'exec ibl5-mariadb mariadb-dump -uroot -proot --single-transaction --skip-lock-tables iblhoops_ibl5 ibl_api_keys ibl_bug_reports ibl_bug_report_attachments ibl_bug_reporter_profile ibl_bug_pipeline_state ibl_bug_report_operator_context' "$LOG")"
    assert_eq "$l import argv x2" "2" \
        "$(count_in 'exec -i ibl5-mariadb mariadb --force -uroot -proot iblhoops_ibl5' "$LOG")"
    assert_eq "$l backfill argv" "1" \
        "$(count_in 'exec ibl5-mariadb mariadb -uroot -proot iblhoops_ibl5 -e ' "$LOG")"
    assert_eq "$l pre-sync argv" "1" \
        "$(count_in 'exec ibl5-mariadb mariadb -uroot -proot iblhoops_ibl5 -N -B -e SELECT version FROM schema_migrations /* pre-sync */' "$LOG")"
    # The pre-sync read shares the `-N -B -e` form with the row-count call, so the count is 2.
    assert_eq "$l rowcount argv" "2" \
        "$(count_in 'exec ibl5-mariadb mariadb -uroot -proot iblhoops_ibl5 -N -B -e ' "$LOG")"
    assert_eq "$l exec total" "12" "$(grep -c '^exec ' <<<"$LOG" || true)"
    assert_eq "$l two-token form absent" "0" "$(count_in '-u root' "$LOG")"
    assert_eq "$l password not echoed" "0" "$(grep -c proot <<<"$OUT$ERR" || true)"
    assert_match "$l snapshot banner" "Source: snapshot file" "$OUT"
}

# D1: default argv.
run_sync
assert_default_argv "D1"

# O1: env override changes every argv. Distinctive values make a leak greppable.
run_sync DB_ROOT_USER=u1 DB_ROOT_PASS=sekret99 DB_DEFAULT_NAME=altdb
assert_eq "O1 exit 0" "0" "$RC"
assert_eq "O1 probe argv x6" "6" \
    "$(count_in 'exec ibl5-mariadb mariadb -uu1 -psekret99 -N -B -e SELECT COUNT(*)' "$LOG")"
assert_eq "O1 probe schema altdb x6" "6" "$(count_in "table_schema='altdb'" "$LOG")"
assert_eq "O1 dump argv" "1" \
    "$(count_in 'exec ibl5-mariadb mariadb-dump -uu1 -psekret99 --single-transaction --skip-lock-tables altdb ibl_api_keys' "$LOG")"
assert_eq "O1 import argv x2" "2" \
    "$(count_in 'exec -i ibl5-mariadb mariadb --force -uu1 -psekret99 altdb' "$LOG")"
assert_eq "O1 backfill argv" "1" \
    "$(count_in 'exec ibl5-mariadb mariadb -uu1 -psekret99 altdb -e ' "$LOG")"
assert_eq "O1 rowcount argv (pre-sync read shares the form)" "2" \
    "$(count_in 'exec ibl5-mariadb mariadb -uu1 -psekret99 altdb -N -B -e ' "$LOG")"
assert_eq "O1 no -uroot left" "0" "$(count_in '-uroot' "$LOG")"
assert_eq "O1 no iblhoops_ibl5 left" "0" "$(count_in 'iblhoops_ibl5' "$LOG")"
assert_eq "O1 password not echoed" "0" "$(grep -c sekret99 <<<"$OUT$ERR" || true)"

# N1: an ambient DB_NAME must not retarget the destructive sync.
run_sync DB_NAME=other
assert_default_argv "N1"
assert_eq "N1 ambient name absent from argv" "0" "$(count_in 'other' "$LOG")"

# F1: fail-closed probe. A probe error aborts the sync and its cause stays on stderr.
run_sync STUB_PROBE_RC=1
assert_eq "F1 exit 1" "1" "$RC"
assert_match "F1 abort message" "ERROR: preserve-tables probe failed for table ibl_api_keys" "$ERR"
assert_match "F1 cause on stderr" "ERROR 2002" "$ERR"
assert_eq "F1 cause not on stdout" "0" "$(grep -c 'ERROR 2002' <<<"$OUT" || true)"
assert_eq "F1 stopped at first probe (after the pre-sync read)" "2" "$(grep -c '^exec ' <<<"$LOG" || true)"
assert_eq "F1 nothing dumped" "0" "$(count_in 'mariadb-dump' "$LOG")"

# S1: the dump file gets stdout only; a failed load keeps the backup.
run_sync STUB_DUMP_STDERR="stub dump warning" STUB_IMPORT_ERROR="ERROR 1064 (42000): stub load failure"
assert_eq "S1 exit 1" "1" "$RC"
assert_match "S1 backup retained" "Preserved-tables backup retained at: " "$ERR"
PRESERVED=$(sed -n 's/.*backup retained at: //p' <<<"$ERR" | head -1)
if [ -n "$PRESERVED" ] && [ -f "$PRESERVED" ]; then
    pass "S1 backup file exists"
    BODY=$(cat "$PRESERVED")
    assert_match "S1 dump body in file" "-- stub dump body" "$BODY"
    assert_eq "S1 warning absent from file" "0" "$(count_in 'stub dump warning' "$BODY")"
else
    failcase "S1 backup file exists" "no file at [$PRESERVED]"
fi
assert_match "S1 warning reached stderr" "stub dump warning" "$ERR"

# L1-L4: db_cmd unit cases against the sandbox copy of the library.
# shellcheck source=/dev/null
. "$MAIN/bin/lib/db-helpers.sh"
last_exec() { tail -n 1 "$STUB_ARGV_LOG.docker"; }

: > "$STUB_ARGV_LOG.docker"
PATH="$STUBBIN:$PATH" db_cmd c1 mariadb -N -e 'SELECT 1' >/dev/null
assert_eq "L1 default argv" "exec c1 mariadb -uroot -proot -N -e SELECT 1" "$(last_exec)"

: > "$STUB_ARGV_LOG.docker"
(
    DB_ROOT_USER=u1
    DB_ROOT_PASS=sekret99
    # shellcheck source=/dev/null
    . "$MAIN/bin/lib/db-helpers.sh"
    PATH="$STUBBIN:$PATH" db_cmd c1 mariadb-dump altdb t1 >/dev/null
)
assert_eq "L2 override argv" "exec c1 mariadb-dump -uu1 -psekret99 altdb t1" "$(last_exec)"

set +e
L3_OUT=$(PATH="$STUBBIN:$PATH" STUB_PROBE_RC=1 db_cmd c1 mariadb -e 'SELECT COUNT(*) FROM information_schema.tables' 2>"$TMP/l3err")
L3_RC=$?
L4_OUT=$(PATH="$STUBBIN:$PATH" STUB_PROBE_RC=3 db_cmd c1 mariadb -e 'SELECT COUNT(*) FROM information_schema.tables' 2>/dev/null)
L4_RC=$?
set -e
assert_eq "L3 exit code" "1" "$L3_RC"
assert_eq "L3 stdout empty" "" "$L3_OUT"
assert_match "L3 error on stderr" "ERROR 2002" "$(cat "$TMP/l3err")"
assert_eq "L4 exit code passthrough" "3" "$L4_RC"
assert_eq "L4 stdout empty" "" "$L4_OUT"

# Library constants: defaults, override, ambient DB_NAME, not exported.
assert_eq "L5 defaults" "root|root|iblhoops_ibl5" "$DB_ROOT_USER|$DB_ROOT_PASS|$DB_DEFAULT_NAME"
L6=$(env -i PATH=/usr/bin:/bin DB_NAME=other DB_DEFAULT_NAME=alt DB_ROOT_USER=u1 \
    bash -c ". '$MAIN/bin/lib/db-helpers.sh'; printf '%s|%s|%s' \"\$DB_DEFAULT_NAME\" \"\$DB_ROOT_USER\" \"\$DB_ROOT_PASS\"")
assert_eq "L6 override honored, ambient DB_NAME ignored" "alt|u1|root" "$L6"
L7=$(env -i PATH=/usr/bin:/bin bash -c ". '$MAIN/bin/lib/db-helpers.sh'; env | grep -c '^DB_ROOT_PASS=' || true")
assert_eq "L7 constants not exported" "0" "$L7"

# M1-M3: the DB_CMD= line of each script, evaluated against the real library.
compose_db_cmd() {  # <script> [VAR=value ...]
    local script="$1" name_line cmd_line body
    shift
    name_line=$(grep -m1 '^DB_NAME=' "$REPO_ROOT/bin/$script" || true)
    cmd_line=$(grep -m1 '^DB_CMD=' "$REPO_ROOT/bin/$script")
    body=$(printf '%s\n' "set --" ". '$REPO_ROOT/bin/lib/db-helpers.sh'" "$name_line" "$cmd_line" \
        'printf "%s" "$DB_CMD"')
    env -i PATH=/usr/bin:/bin "$@" bash -c "$body"
}
OVR=(DB_ROOT_USER=u1 DB_ROOT_PASS=sekret99 DB_DEFAULT_NAME=altdb)
assert_eq "M1 db-migrate" "mariadb -u root -proot iblhoops_ibl5" "$(compose_db_cmd db-migrate)"
assert_eq "M2 db-test-up" "mariadb -u root -proot" "$(compose_db_cmd db-test-up)"
assert_eq "M3 wt-up" "mariadb -u root -proot iblhoops_ibl5" "$(compose_db_cmd wt-up)"
assert_eq "M1o db-migrate override" "mariadb -u u1 -psekret99 altdb" "$(compose_db_cmd db-migrate "${OVR[@]}")"
assert_eq "M2o db-test-up override" "mariadb -u u1 -psekret99" "$(compose_db_cmd db-test-up "${OVR[@]}")"
assert_eq "M3o wt-up override" "mariadb -u u1 -psekret99 altdb" "$(compose_db_cmd wt-up "${OVR[@]}")"
assert_eq "M3n wt-up ambient DB_NAME" "mariadb -u root -proot iblhoops_ibl5" "$(compose_db_cmd wt-up DB_NAME=other)"
# The three DB_CMD strings keep the two-token form so the wt-up `DB CLI:` banner
# stays byte-identical; the single-token -u$DB_ROOT_USER form belongs to db_cmd only.
M_SRC=$(cat "$REPO_ROOT/bin/db-migrate" "$REPO_ROOT/bin/db-test-up" "$REPO_ROOT/bin/wt-up")
assert_eq "M3 two-token form kept" "0" "$(count_in '-u$DB_ROOT_USER' "$M_SRC")"

# E1: bin/e2e-wt passes the name through the container env and keeps no literal.
E2E="$REPO_ROOT/bin/e2e-wt"
assert_eq "E1 passes E2E_DB_NAME" "1" "$(grep -cF -- '-e "E2E_DB_NAME=$DB_DEFAULT_NAME" \' "$E2E" || true)"
assert_eq "E1 reads getenv" "1" "$(grep -cF -- 'getenv("E2E_DB_NAME")' "$E2E" || true)"
assert_eq "E1 no literal name" "0" "$(grep -cF -- '"iblhoops_ibl5")' "$E2E" || true)"
assert_eq "E1 sources db-helpers" "1" "$(grep -cF -- 'source "$REPO_ROOT/bin/lib/db-helpers.sh"' "$E2E" || true)"

# P1: the sync must keep every local-only bug-pipeline table. A new ibl_bug_* table
# that misses bin/db-sync-preserve-tables.txt is dropped on each prod sync with no visible error.
P_LIST=$(sed -e '/^#/d' -e '/^$/d' "$REPO_ROOT/bin/db-sync-preserve-tables.txt" | paste -s -d ' ' -)
P_TABLES=$(cat "$REPO_ROOT"/ibl5/migrations/*.sql \
    | sed -nE 's/.*CREATE TABLE (IF NOT EXISTS )?`?(ibl_bug_[a-z_]+).*/\2/p' | sort -u)
assert_match "P1 migrations create ibl_bug_reports" "ibl_bug_reports" "$P_TABLES"
for t in $P_TABLES; do
    assert_match "P1 $t preserved" " $t " " $P_LIST "
done
assert_eq "P2 keep-list names and order" \
    "ibl_api_keys ibl_bug_reports ibl_bug_report_attachments ibl_bug_reporter_profile ibl_bug_pipeline_state ibl_bug_report_operator_context" \
    "$P_LIST"
SYNC_SRC=$(cat "$REPO_ROOT/bin/db-sync-prod")
assert_eq "P3 no inline keep-list literal" "0" "$(count_in 'PRESERVE_TABLES="ibl_' "$SYNC_SRC")"
assert_eq "P4 keep-list never sourced (.)" "0" "$(count_in '. "$PRESERVE_LIST_FILE"' "$SYNC_SRC")"
assert_eq "P4 keep-list never sourced (source)" "0" "$(count_in 'source "$PRESERVE_LIST_FILE"' "$SYNC_SRC")"

# K1-K12: the keep-list is read fail-closed. Each case swaps the sandbox list,
# runs the D1 invocation (run_sync), then restores the real list.
KEEP_SRC="$REPO_ROOT/bin/db-sync-preserve-tables.txt"
KEEP_DST="$MAIN/bin/db-sync-preserve-tables.txt"
run_keep_case() {  # <label> <missing|unreadable|content> [content] [stderr-needle]
    local label="$1" mode="$2" body="${3:-}" needle="${4:-}"
    rm -f "$KEEP_DST" "$TMP/pwn"
    case "$mode" in
        unreadable) cp "$KEEP_SRC" "$KEEP_DST"; chmod 000 "$KEEP_DST" ;;
        content)    printf '%s' "$body" > "$KEEP_DST" ;;
    esac
    run_sync
    rm -f "$KEEP_DST"
    cp "$KEEP_SRC" "$KEEP_DST"
    if [ "$RC" -ne 0 ]; then pass "$label exits non-zero"; else failcase "$label exits non-zero" "rc=$RC"; fi
    assert_match "$label names the list" "ERROR: preserved-tables list" "$ERR"
    if [ -n "$needle" ]; then assert_match "$label reason" "$needle" "$ERR"; fi
    assert_eq "$label no docker/dump/drop/import call" "" "$LOG"
    if [ ! -e "$TMP/pwn" ]; then pass "$label nothing executed"; else failcase "$label nothing executed" "$TMP/pwn exists"; fi
}
run_keep_case "K1 missing"       missing    "" "missing or unreadable"
if [ "$(id -u)" -eq 0 ]; then echo "SKIP: K9 unreadable (root ignores mode 000)"; else
run_keep_case "K9 unreadable"    unreadable "" "missing or unreadable"; fi
run_keep_case "K2 empty"         content "" "has no table names"
run_keep_case "K3 comment-only"  content $'# header\n\n#ibl_api_keys\n' "has no table names"
run_keep_case "K4 uppercase"     content $'IBL_API_KEYS\n' "invalid table name"
run_keep_case "K5 semicolon"     content "ibl_x;touch $TMP/pwn"$'\n' "invalid table name"
run_keep_case "K6 dollar-paren"  content $'ibl_$(id)\n' "invalid table name"
run_keep_case "K7 backtick"      content $'ibl_`id`\n' "invalid table name"
run_keep_case "K8 leading space" content $' ibl_api_keys\n' "invalid table name"
run_keep_case "K11 bare prefix"  content $'ibl_\n' "invalid table name"
run_keep_case "K12 inline note"  content $'ibl_api_keys # keep\n' "invalid table name"
# K10: a list without a trailing newline still keeps its last name.
printf '%s' "$(grep -v '^#' "$KEEP_SRC")" > "$KEEP_DST"
run_sync
cp "$KEEP_SRC" "$KEEP_DST"
assert_eq "K10 no-trailing-newline list runs" "0" "$RC"
assert_match "K10 last name still probed" "ibl_bug_report_operator_context" "$LOG"

# R1-R9: preserved-table migration replay (Phase 4 helpers in bin/lib/db-helpers.sh).
# shellcheck source=/dev/null
. "$REPO_ROOT/bin/lib/db-helpers.sh"
R_TABLES=(ibl_api_keys ibl_bug_reports ibl_bug_report_attachments ibl_bug_reporter_profile ibl_bug_pipeline_state ibl_bug_report_operator_context)

# R1: on the real migrations dir the list holds 177, 178, 198 and lacks 201 (its only
# mention of ibl_api_keys is a `--` comment).
R1_LIST="$(preserved_table_migrations "$REPO_ROOT/ibl5/migrations" "${R_TABLES[@]}")"
assert_match "R1 holds 177" "177_add_filed_status_to_bug_reports.sql" "$R1_LIST"
assert_match "R1 holds 178" "178_add_roster_error_class_to_bug_reports.sql" "$R1_LIST"
assert_match "R1 holds 198" "198_bug_pipeline_dormant_and_operator_context.sql" "$R1_LIST"
assert_eq "R1 lacks 201 (comment-only mention)" "0" "$(count_in '201_google_sheet_connections.sql' "$R1_LIST")"

# R2 near-miss: a longer table name and a comment-only file are excluded; an indented,
# lowercase, backticked UPDATE is included.
R_FIX="$TMP/rfix"; mkdir -p "$R_FIX"
printf 'ALTER TABLE ibl_bug_reports_archive ADD COLUMN y INT;\n' > "$R_FIX/900_x.sql"
printf -- '-- touches ibl_bug_reports later\n' > "$R_FIX/901_x.sql"
printf '  update `ibl_bug_reports` set x=1;\n' > "$R_FIX/902_x.sql"
R2_LIST="$(preserved_table_migrations "$R_FIX" "${R_TABLES[@]}")"
assert_eq "R2 longer table name excluded" "0" "$(count_in '900_x.sql' "$R2_LIST")"
assert_eq "R2 comment-only file excluded" "0" "$(count_in '901_x.sql' "$R2_LIST")"
assert_eq "R2 indented lowercase backticked update included" "1" "$(count_in '902_x.sql' "$R2_LIST")"

# R3: the real 153, 177 and 198 are re-runnable; the real 075 is not.
for n in 153 177 198; do
    if migration_is_rerunnable "$(ls "$REPO_ROOT"/ibl5/migrations/${n}_*.sql)"; then pass "R3 $n re-runnable"; else failcase "R3 $n re-runnable" "rejected"; fi
done
if migration_is_rerunnable "$REPO_ROOT/ibl5/migrations/075_api_keys_user_link.sql"; then
    failcase "R3 075 rejected" "accepted"; else pass "R3 075 rejected"; fi

# R4 near-miss: a negated header is not a marker.
printf -- '-- NOT re-runnable: adds a column\nALTER TABLE t ADD COLUMN c INT;\n' > "$R_FIX/910_neg.sql"
printf -- '-- non-idempotent backfill\nALTER TABLE t ADD COLUMN c INT;\n' > "$R_FIX/911_neg.sql"
for f in 910_neg 911_neg; do
    if migration_is_rerunnable "$R_FIX/$f.sql"; then failcase "R4 $f rejected" "accepted"; else pass "R4 $f rejected"; fi
done

# R5-R9: integration through run_sync. The sandbox gets an ibl5/migrations fixture tree and a
# db-migrate stub that logs its container, db and the files in the dir it was handed. Both
# are removed after each case so the D1/K cases above never see them.
cat > "$TMP/db-migrate.stub" <<'STUB'
#!/bin/bash
{ printf 'CALL %s %s\n' "$1" "${3:-}"; printf 'FILES %s\n' "$(ls "$2" | tr '\n' ' ')"; } >> "$STUB_ARGV_LOG.migrate"
exit 0
STUB
R_198="198_bug_pipeline_dormant_and_operator_context.sql"
R_PRE=$'153_create_bug_pipeline_tables.sql\n178_add_roster_error_class_to_bug_reports.sql'
R_POST="$R_PRE"$'\n'"$R_198"
r_fixture() {  # <198-body> [extra-file-name extra-file-body]
    rm -rf "$MAIN/ibl5"; mkdir -p "$MAIN/ibl5/migrations"
    printf -- '-- Re-runnable\nCREATE TABLE IF NOT EXISTS ibl_bug_reports (id INT);\n' \
        > "$MAIN/ibl5/migrations/153_create_bug_pipeline_tables.sql"
    printf -- '-- Re-runnable\nALTER TABLE ibl_bug_reports ADD COLUMN IF NOT EXISTS e INT;\n' \
        > "$MAIN/ibl5/migrations/178_add_roster_error_class_to_bug_reports.sql"
    printf '%s' "$1" > "$MAIN/ibl5/migrations/$R_198"
    if [ -n "${2:-}" ]; then printf '%s' "$3" > "$MAIN/ibl5/migrations/$2"; fi
    cp "$TMP/db-migrate.stub" "$MAIN/bin/db-migrate"; chmod +x "$MAIN/bin/db-migrate"
    : > "$STUB_ARGV_LOG.migrate"
}
r_teardown() { rm -rf "$MAIN/ibl5" "$MAIN/bin/db-migrate"; }
R_OK_BODY=$'-- Re-runnable\nALTER TABLE ibl_bug_reports MODIFY status VARCHAR(20);\n'
R_DEL="DELETE FROM schema_migrations WHERE version IN ('$R_198')"

r_fixture "$R_OK_BODY"
run_sync STUB_PRE_VERSIONS="$R_PRE" STUB_POST_VERSIONS="$R_POST"
MLOG="$(cat "$STUB_ARGV_LOG.migrate")"
assert_eq "R5 exit 0" "0" "$RC"
assert_eq "R5 un-marks only 198" "1" "$(count_in "$R_DEL" "$LOG")"
assert_eq "R5 db-migrate handed a dir holding only 198" "1" "$(count_in "FILES $R_198 " "$MLOG")"
assert_match "R5 summary line" "Replayed 1 preserved-table migration(s): $R_198" "$OUT"

# R6 fail-loud: a prod-applied candidate with an ALTER and no marker aborts before any delete.
r_fixture $'ALTER TABLE ibl_bug_reports ADD COLUMN z INT;\n'
run_sync STUB_PRE_VERSIONS="$R_PRE" STUB_POST_VERSIONS="$R_POST"
MLOG="$(cat "$STUB_ARGV_LOG.migrate")"
if [ "$RC" -ne 0 ]; then pass "R6 exits non-zero"; else failcase "R6 exits non-zero" "rc=$RC"; fi
assert_match "R6 names the refusal" "is not marked re-runnable" "$ERR"
assert_eq "R6 no DELETE" "0" "$(count_in 'DELETE FROM schema_migrations' "$LOG")"
assert_eq "R6 no db-migrate call" "0" "$(count_in 'CALL' "$MLOG")"

# R7 boundary: an empty pre-sync history skips the replay.
r_fixture "$R_OK_BODY"
run_sync STUB_POST_VERSIONS="$R_POST"
assert_eq "R7 exit 0" "0" "$RC"
assert_match "R7 skip warning" "preserved-table migration replay skipped" "$ERR"
assert_eq "R7 no DELETE" "0" "$(count_in 'DELETE FROM schema_migrations' "$LOG")"

# R8: a candidate prod never applied is left to the normal db-migrate path.
r_fixture "$R_OK_BODY"
run_sync STUB_PRE_VERSIONS="$R_PRE" STUB_POST_VERSIONS="$R_PRE"
MLOG="$(cat "$STUB_ARGV_LOG.migrate")"
assert_eq "R8 exit 0" "0" "$RC"
assert_eq "R8 no DELETE" "0" "$(count_in 'DELETE FROM schema_migrations' "$LOG")"
assert_eq "R8 198 not handed to a replay dir" "0" "$(count_in "FILES $R_198 " "$MLOG")"

# R9 boundary: a name outside ^[0-9]{3}_[a-z0-9_]+\.sql$ never reaches SQL.
r_fixture "$R_OK_BODY" "199_Bad Name.sql" $'ALTER TABLE ibl_bug_reports ADD COLUMN q INT;\n'
run_sync STUB_PRE_VERSIONS="$R_PRE" STUB_POST_VERSIONS="$R_POST"$'\n199_Bad Name.sql'
if [ "$RC" -ne 0 ]; then pass "R9 exits non-zero"; else failcase "R9 exits non-zero" "rc=$RC"; fi
assert_match "R9 names the bad name" "unexpected migration name 199_Bad Name.sql" "$ERR"
assert_eq "R9 no DELETE" "0" "$(count_in 'DELETE FROM schema_migrations' "$LOG")"
r_teardown

h_done
