#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-automouse-queue — regression test for evict_dispositions in
# bin/automouse/queue. Covers the duplicate-disposition symlink bug: queuing a
# previously-done/skipped plan must evict the stale sibling before creating the
# new queue/ entry.
#
# Run: bin/test-automouse-queue  (exit 0 = all pass, 1 = any case failed)

set -u
# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SCRIPT="$SCRIPT_DIR/automouse/queue"
# shellcheck source=bin/automouse/lib-queue-order
source "$SCRIPT_DIR/automouse/lib-queue-order"
h_tmp TMP

NDIR="$TMP/automouse"
PDIR="$TMP/plans"
# Phase 3 seam: skip the real bin/check-plan; these fixtures carry no Verification Matrix.
export AUTOMOUSE_CHECK_PLAN=/usr/bin/true

# Phase 3 check-plan stubs (override per call with AUTOMOUSE_CHECK_PLAN=<stub>).
CP_FAIL="$TMP/cp-fail"
printf '#!/bin/bash\necho "check-plan: scanning (stub)"\necho "[1] no Verification Matrix (stub)"\necho "[C] plan too long (stub)"\nexit 1\n' > "$CP_FAIL"
CP_USAGE="$TMP/cp-usage"
printf '#!/bin/bash\necho "usage: check-plan <plan>"\nexit 2\n' > "$CP_USAGE"
CP_PASS="$TMP/cp-pass"
printf '#!/bin/bash\necho "OK (stub)"\nexit 0\n' > "$CP_PASS"
CP_MANY="$TMP/cp-many"
printf '#!/bin/bash\nfor n in $(seq 1 50); do echo "[X] stub gate $n"; done\nexit 1\n' > "$CP_MANY"
CP_RECORD="$TMP/cp-record"
printf '#!/bin/bash\necho "$1" >> "%s/cp-calls"\nexit 1\n' "$TMP" > "$CP_RECORD"
chmod +x "$CP_FAIL" "$CP_USAGE" "$CP_PASS" "$CP_MANY" "$CP_RECORD"

setup() {
    rm -rf "$NDIR"
    mkdir -p "$NDIR/queue" "$NDIR/skipped" "$NDIR/done"
    rm -rf "$PDIR"
    mkdir -p "$PDIR"
}

run_queue() {
    NIGHTLY_DIR="$NDIR" PLANS_DIR="$PDIR" "$SCRIPT" "$@"
}

# Create fixture plans carrying a valid impl_model:, which bin/automouse/queue add
# now requires. Use for plans the queue add path is expected to accept.
mkplan() {
    local f
    for f in "$@"; do
        printf -- '---\nimpl_model: sonnet\n---\n\n# fixture plan %s\n' "$f" > "$PDIR/$f"
    done
}

assert_present() {
    local desc="$1" path="$2"
    if [ ! -e "$path" ] && [ ! -L "$path" ]; then
        h_fail "$desc" "expected present: $path"
    fi
}

assert_absent() {
    local desc="$1" path="$2"
    if [ -e "$path" ]; then
        h_fail "$desc" "expected absent (exists): $path"
        return
    fi
    if [ -L "$path" ]; then
        h_fail "$desc" "expected absent (dangling symlink): $path"
    fi
}

# ---------------------------------------------------------------------------
# Row 1 — plan in skipped/ only → evicted, lands in queue/
# ---------------------------------------------------------------------------
setup
mkplan plan-a.md
ln -s "$PDIR/plan-a.md" "$NDIR/skipped/plan-a.md"
run_queue plan-a >/dev/null 2>&1
assert_absent  "row1 skipped gone" "$NDIR/skipped/plan-a.md"
assert_present "row1 queued"       "$NDIR/queue/plan-a.md"
h_pass "row1 — skipped-only eviction"
# ---------------------------------------------------------------------------
# Row 2 — plan in done/ only → evicted, lands in queue/
# ---------------------------------------------------------------------------
setup
mkplan plan-b.md
ln -s "$PDIR/plan-b.md" "$NDIR/done/plan-b.md"
run_queue plan-b >/dev/null 2>&1
assert_absent  "row2 done gone" "$NDIR/done/plan-b.md"
assert_present "row2 queued"    "$NDIR/queue/plan-b.md"
h_pass "row2 — done-only eviction"
# ---------------------------------------------------------------------------
# Row 3 — plan in BOTH skipped/ and done/ → evicted from both, lands in queue/
# (the core bug; asserts exactly one disposition folder after queuing)
# ---------------------------------------------------------------------------
setup
mkplan plan-c.md
ln -s "$PDIR/plan-c.md" "$NDIR/skipped/plan-c.md"
ln -s "$PDIR/plan-c.md" "$NDIR/done/plan-c.md"
run_queue plan-c >/dev/null 2>&1
assert_absent  "row3 skipped gone" "$NDIR/skipped/plan-c.md"
assert_absent  "row3 done gone"    "$NDIR/done/plan-c.md"
assert_present "row3 queued"       "$NDIR/queue/plan-c.md"
h_pass "row3 — both-dirs eviction (core bug)"
# ---------------------------------------------------------------------------
# Row 4 — fresh plan in neither sibling → queues normally, no error
# ---------------------------------------------------------------------------
setup
mkplan plan-d.md
run_queue plan-d >/dev/null 2>&1
assert_absent  "row4 no skipped" "$NDIR/skipped/plan-d.md"
assert_absent  "row4 no done"    "$NDIR/done/plan-d.md"
assert_present "row4 queued"     "$NDIR/queue/plan-d.md"
h_pass "row4 — fresh plan no-op eviction"
# ---------------------------------------------------------------------------
# Row 5 — requeue of a plan that also has a stale done/ entry → done evicted
# (uses `requeue` subcommand — no impl_model check in that path)
# ---------------------------------------------------------------------------
setup
touch "$PDIR/plan-e.md"
ln -s "$PDIR/plan-e.md" "$NDIR/skipped/plan-e.md"
ln -s "$PDIR/plan-e.md" "$NDIR/done/plan-e.md"
run_queue requeue >/dev/null 2>&1
assert_absent  "row5 done gone"    "$NDIR/done/plan-e.md"
assert_absent  "row5 skipped gone" "$NDIR/skipped/plan-e.md"
assert_present "row5 queued"       "$NDIR/queue/plan-e.md"
h_pass "row5 — requeue done-eviction"
# ---------------------------------------------------------------------------
# Row 6 — .attempts counter evicted alongside symlink
# ---------------------------------------------------------------------------
setup
mkplan plan-f.md
ln -s "$PDIR/plan-f.md" "$NDIR/skipped/plan-f.md"
touch "$NDIR/skipped/plan-f.md.attempts"
ln -s "$PDIR/plan-f.md" "$NDIR/done/plan-f.md"
touch "$NDIR/done/plan-f.md.attempts"
run_queue plan-f >/dev/null 2>&1
assert_absent  "row6 skipped symlink gone"  "$NDIR/skipped/plan-f.md"
assert_absent  "row6 skipped attempts gone" "$NDIR/skipped/plan-f.md.attempts"
assert_absent  "row6 done symlink gone"     "$NDIR/done/plan-f.md"
assert_absent  "row6 done attempts gone"    "$NDIR/done/plan-f.md.attempts"
assert_present "row6 queued"                "$NDIR/queue/plan-f.md"
h_pass "row6 — .attempts eviction"
# ---------------------------------------------------------------------------
# Row 7 — stale entry is a real (non-dangling) symlink; assert ! -e AND ! -L
# after eviction so a dangling symlink left behind would also fail
# ---------------------------------------------------------------------------
setup
mkplan plan-g.md
ln -s "$PDIR/plan-g.md" "$NDIR/skipped/plan-g.md"
if [ ! -e "$NDIR/skipped/plan-g.md" ]; then
    h_fail "row7 setup" "symlink is dangling before eviction"
fi
run_queue plan-g >/dev/null 2>&1
assert_absent  "row7 symlink gone"  "$NDIR/skipped/plan-g.md"
assert_present "row7 queued"        "$NDIR/queue/plan-g.md"
h_pass "row7 — real-symlink eviction + dangling guard"
# ---------------------------------------------------------------------------
# Row 8 — idempotent re-queue of the same plan (same target): exit 0,
# "Already queued (no change)", and skipped/ entry left untouched (eviction
# must not fire before the already-queued check).
# (plan-h manually linked into queue via ln -s; already-queued check fires first)
# ---------------------------------------------------------------------------
setup
touch "$PDIR/plan-h.md"
ln -s "$PDIR/plan-h.md" "$NDIR/queue/plan-h.md"
ln -s "$PDIR/plan-h.md" "$NDIR/skipped/plan-h.md"
set +e
out=$(run_queue plan-h 2>&1)
exit_code=$?
# Restore the top-level state (set -u only, never -e): a leaked `set -e` here
# would silently abort every row below on any non-zero return instead of
# recording a FAIL — which is exactly how the CI failure masqueraded as an
# early exit.
set +e
if [ "$exit_code" -ne 0 ]; then
    h_fail "row8" "expected exit 0 for same-target re-queue, got $exit_code"
fi
if ! echo "$out" | grep -q "Already queued (no change)"; then
    h_fail "row8" "expected 'Already queued (no change)' in output, got: $out"
fi
assert_present "row8 skipped untouched" "$NDIR/skipped/plan-h.md"
assert_present "row8 queued untouched"  "$NDIR/queue/plan-h.md"
h_pass "row8 — same-target re-queue is idempotent (exit 0), skipped/ untouched"
# ---------------------------------------------------------------------------
# Row 8a — genuine conflict: same filename, different physical source → error,
# queue entry unchanged.  Without the idempotent-check, a naïve `ln -s` would
# crash with a raw "ln: File exists" message and leave the queue corrupted.
# (conflict check fires before impl_model check; touch'd plans are fine here)
# ---------------------------------------------------------------------------
setup
touch "$PDIR/plan-h.md"
mkdir -p "$TMP/altplans"
touch "$TMP/altplans/plan-h.md"
ln -s "$PDIR/plan-h.md" "$NDIR/queue/plan-h.md"
set +e
out=$(NIGHTLY_DIR="$NDIR" PLANS_DIR="$TMP/altplans" "$SCRIPT" plan-h 2>&1)
ec=$?
set +e
if [ "$ec" -eq 0 ]; then
    h_fail "row8a" "expected non-zero exit for genuine conflict, got 0"
fi
if ! echo "$out" | grep -q "queued:"; then
    h_fail "row8a" "expected 'queued:' in error output, got: $out"
fi
if ! echo "$out" | grep -q "new:"; then
    h_fail "row8a" "expected 'new:' in error output, got: $out"
fi
link_target=$(readlink "$NDIR/queue/plan-h.md")
if [ "$link_target" != "$PDIR/plan-h.md" ]; then
    h_fail "row8a" "readlink changed from original: $link_target"
fi
h_pass "row8a — genuine conflict exits 1 with clean error, queue unchanged"
# ---------------------------------------------------------------------------
# Row 8b — dangling symlink in queue/ gives a clean error, not a raw "ln: File
# exists" crash.  Without the `[ -L "$f" ]` guard in the already-queued check,
# `-e` alone is false for a dangling link, control falls through to `ln -s`,
# and the shell prints a raw fatal error.  Here the dangling symlink points at
# a path that differs from the real source, so it is a genuine conflict too.
# (conflict check fires before impl_model check; touch'd plan-h is fine here)
# ---------------------------------------------------------------------------
setup
touch "$PDIR/plan-h.md"
ln -s "/nonexistent/plan-h.md" "$NDIR/queue/plan-h.md"   # dangling, different target
set +e
out=$(run_queue plan-h 2>&1)
ec=$?
set +e
if [ "$ec" -eq 0 ]; then
    h_fail "row8b" "expected non-zero exit for dangling+different path, got 0"
fi
if echo "$out" | grep -qE '^ln:'; then
    h_fail "row8b" "raw ln error leaked into output: $out"
fi
if ! echo "$out" | grep -q "queued:"; then
    h_fail "row8b" "expected 'queued:' in error output, got: $out"
fi
h_pass "row8b — dangling symlink gives clean error, no raw ln crash"
# Helpers used by rows 8c, 8d, 10-14, and 17-20.  Defined here so they are
# available to all callers regardless of which section they are in.

# basenames of queue entries, oldest-first (runs-first), space-joined. Uses
# queue_entries_ordered (the symlink's own lstat mtime), the same sort key as
# production. Plain `ls -1tr` sorts by the target's mtime on macOS BSD ls.
queue_order() {
    local out="" f
    while IFS= read -r f; do out="$out $(basename "$f")"; done \
        < <(queue_entries_ordered "$NDIR/queue")
    echo "${out# }"
}
assert_order() {
    local desc="$1" expected="$2" actual
    actual="$(queue_order)"
    if [ "$actual" != "$expected" ]; then
        h_fail "$desc" "expected order [$expected], got [$actual]"
    fi
}
# epoch mtime of a queue entry's readlink target, portable: GNU (-c %Y) first
# for Linux CI, BSD (-f %m) fallback for macOS (mirrors bin/wt-status).
target_mtime() {
    local t; t="$(readlink "$NDIR/queue/$1")"
    stat -c %Y "$t" 2>/dev/null || stat -f %m "$t"
}
# lstat mtime of a queue entry itself (the GNU `ls` sort key). Neither GNU nor
# BSD `stat` dereferences by default, so this reports the symlink's own mtime.
link_mtime() {
    stat -c %Y "$NDIR/queue/$1" 2>/dev/null || stat -f %m "$NDIR/queue/$1"
}

# ---------------------------------------------------------------------------
# Row 8c — idempotent re-queue preserves run-order position and does not touch
# the symlink mtimes that queue_entries_ordered sorts by.  If the re-queue mistakenly called
# stamp_back_of_queue, the plan would jump to the back.
# ---------------------------------------------------------------------------
setup
mkplan plan-a.md plan-b.md plan-c.md
run_queue plan-a >/dev/null 2>&1
run_queue plan-b >/dev/null 2>&1
run_queue plan-c >/dev/null 2>&1
lm_before=$(link_mtime plan-a.md)
tm_before=$(target_mtime plan-a.md)
set +e
out=$(run_queue plan-a 2>&1)
ec=$?
set +e
if [ "$ec" -ne 0 ]; then
    h_fail "row8c" "expected exit 0 for idempotent re-queue, got $ec"
fi
if ! echo "$out" | grep -q "Already queued (no change)"; then
    h_fail "row8c" "expected 'Already queued (no change)' in output, got: $out"
fi
assert_order "row8c order preserved after re-queue" "plan-a.md plan-b.md plan-c.md"
lm_after=$(link_mtime plan-a.md)
tm_after=$(target_mtime plan-a.md)
if [ "$lm_after" != "$lm_before" ]; then
    h_fail "row8c" "link mtime changed on idempotent re-queue: $lm_before -> $lm_after"
fi
if [ "$tm_after" != "$tm_before" ]; then
    h_fail "row8c" "target mtime changed on idempotent re-queue: $tm_before -> $tm_after"
fi
h_pass "row8c — idempotent re-queue preserves position and mtimes"
# ---------------------------------------------------------------------------
# Row 8d — a plan already queued with an ancient mtime that is re-queued via
# the idempotent path stays in its ORIGINAL position (not stamped to the back).
# If stamp_back_of_queue ran, the ancient plan would move to last.
# ---------------------------------------------------------------------------
setup
mkplan plan-a.md plan-b.md plan-old.md
touch -t 202001010000.00 "$PDIR/plan-old.md"
run_queue plan-a >/dev/null 2>&1
run_queue plan-old >/dev/null 2>&1
run_queue plan-b >/dev/null 2>&1
# order: plan-a, plan-old, plan-b (plan-old was stamped to back of a,b,... no:
# queue was a,old,b — each queued in insertion order with stamp_back_of_queue).
# Re-queue plan-old (same target) → must stay in its current position, not jump.
order_before="$(queue_order)"
set +e
out=$(run_queue plan-old 2>&1)
ec=$?
set +e
if [ "$ec" -ne 0 ]; then
    h_fail "row8d" "expected exit 0 for idempotent re-queue of ancient plan, got $ec"
fi
order_after="$(queue_order)"
if [ "$order_after" != "$order_before" ]; then
    h_fail "row8d" "order changed on idempotent re-queue: [$order_before] -> [$order_after]"
fi
h_pass "row8d — idempotent re-queue of ancient-mtime plan keeps its position"
# ---------------------------------------------------------------------------
# Row 9 — .staleness sidecar evicted alongside symlink on (re)queue
# ---------------------------------------------------------------------------
setup
mkplan plan-i.md
ln -s "$PDIR/plan-i.md" "$NDIR/skipped/plan-i.md"
touch "$NDIR/skipped/plan-i.md.staleness"
run_queue plan-i >/dev/null 2>&1
assert_absent  "row9 skipped symlink gone"   "$NDIR/skipped/plan-i.md"
assert_absent  "row9 staleness marker gone"  "$NDIR/skipped/plan-i.md.staleness"
assert_present "row9 queued"                  "$NDIR/queue/plan-i.md"
h_pass "row9 — .staleness eviction"
# ===========================================================================
# impl_model <-> Verification Matrix consistency backstop (bin/lib/
# plan-model-consistency). The plan archive predates bin/check-plan gate 13,
# so an old unmarked plan can still be sitting in ~/claude-plans/ — queuing
# must refuse it rather than let automouse-run burn a session on it.
# ===========================================================================

# shellcheck disable=SC2016  # backtick span is a literal markdown code span,
# not command substitution — single quotes are intentional.
CLEAN_MATRIX='
| # | What to verify | Test type | Timing | Test file / location |
|---|---------------|-----------|--------|---------------------|
| 1 | thing works | PHPUnit | post-impl | `tests/X.php` |
'

# shellcheck disable=SC2016  # literal fixture text; nothing here should expand.
MANUAL_MATRIX=$(printf '%s\n' \
  '' \
  '| # | What to verify | Test type | Timing | Test file / location |' \
  '|---|---------------|-----------|--------|---------------------|' \
  '| 1 | a human eyeballs the rendered page | Truly-manual | post-impl | browser |')

# ---------------------------------------------------------------------------
# Row 15 — a plan with a clean (zero-manual) matrix and NO impl_model marker
# is refused at queue time (nonzero exit); it must NOT land in queue/.
# The PRESENCE check (impl_model: is missing or blank) must fire BEFORE the
# matrix-consistency check — this row is the harness's ordering assertion:
# if the output matches the presence error message exactly, we know the gate
# fires early and does not require a matrix to refuse an unmarked plan.
# ---------------------------------------------------------------------------
setup
printf '%s\n' "$CLEAN_MATRIX" > "$PDIR/plan-j.md"
set +e
out=$(run_queue plan-j 2>&1)
ec=$?
set +e
if [ "$ec" -eq 0 ]; then
    h_fail "row15" "expected non-zero exit for a plan missing impl_model"
fi
if ! echo "$out" | grep -q "impl_model: is missing or blank"; then
    h_fail "row15" "expected the impl_model PRESENCE error (which must fire before"
    echo "      the matrix-consistency error), got: $out"
fi
assert_absent "row15 not queued" "$NDIR/queue/plan-j.md"
h_pass "row15 — refuses to queue a plan missing impl_model"
# ---------------------------------------------------------------------------
# Row 16 — the same clean matrix WITH a deliberate `impl_model: sonnet` marker
# queues normally.
# ---------------------------------------------------------------------------
setup
printf -- '---\nimpl_model: sonnet\n---\n%s\n' "$CLEAN_MATRIX" > "$PDIR/plan-k.md"
run_queue plan-k >/dev/null 2>&1
assert_present "row16 queued" "$NDIR/queue/plan-k.md"
h_pass "row16 — queues a clean, correctly-marked plan"
# ===========================================================================
# reorder subcommand — permutation validation + spaced ascending-mtime touch.
# Order is asserted via queue_entries_ordered (oldest-first by symlink lstat
# mtime) — exactly how bin/automouse/run claims the next plan.
# ===========================================================================

# ---------------------------------------------------------------------------
# Row 10 — happy path: reorder >=3 plans -> queue_entries_ordered matches requested order
# ---------------------------------------------------------------------------
setup
mkplan plan-a.md plan-b.md plan-c.md
run_queue plan-a >/dev/null 2>&1
run_queue plan-b >/dev/null 2>&1
run_queue plan-c >/dev/null 2>&1
run_queue reorder plan-c plan-a plan-b >/dev/null 2>&1
assert_order "row10 reorder applies requested order" "plan-c.md plan-a.md plan-b.md"
h_pass "row10 — reorder happy path"
# ---------------------------------------------------------------------------
# Row 11 — ordering: mtimes end >=1 min apart, no same-second tie-scramble.
# Start from an identical-mtime state and request a non-alphabetical order —
# a same-second touch loop would let `ls` filename-tiebreak and scramble it.
# ---------------------------------------------------------------------------
setup
mkplan plan-a.md plan-b.md plan-c.md
run_queue plan-a >/dev/null 2>&1
run_queue plan-b >/dev/null 2>&1
run_queue plan-c >/dev/null 2>&1
touch -t 202601010000.00 "$PDIR/plan-a.md" "$PDIR/plan-b.md" "$PDIR/plan-c.md"
run_queue reorder plan-c plan-b plan-a >/dev/null 2>&1
assert_order "row11 non-alpha order survives identical start" "plan-c.md plan-b.md plan-a.md"
m1=$(target_mtime plan-c.md); m2=$(target_mtime plan-b.md); m3=$(target_mtime plan-a.md)
if [ $((m2 - m1)) -lt 60 ] || [ $((m3 - m2)) -lt 60 ]; then
    h_fail "row11" "target mtimes not >=60s apart: $m1 $m2 $m3"
fi
h_pass "row11 — spaced ascending mtimes, no tie-scramble"
# ---------------------------------------------------------------------------
# Row 12 — reject a slug not currently queued (non-zero exit, order unchanged)
# ---------------------------------------------------------------------------
setup
mkplan plan-a.md plan-b.md plan-c.md
run_queue plan-a >/dev/null 2>&1; run_queue plan-b >/dev/null 2>&1; run_queue plan-c >/dev/null 2>&1
run_queue reorder plan-a plan-b plan-c >/dev/null 2>&1
before="$(queue_order)"
set +e; out=$(run_queue reorder plan-a plan-b plan-z 2>&1); ec=$?; set +e
[ "$ec" -eq 0 ] && { h_fail "row12" "expected non-zero exit for unqueued slug"; }
echo "$out" | grep -q "not in the queue" || { h_fail "row12" "missing not-in-queue error: $out"; }
assert_order "row12 order unchanged after reject" "$before"
h_pass "row12 — reject unqueued slug"
# ---------------------------------------------------------------------------
# Row 13 — reject a non-permutation: missing entry AND duplicate-as-extra
# ---------------------------------------------------------------------------
setup
mkplan plan-a.md plan-b.md plan-c.md
run_queue plan-a >/dev/null 2>&1; run_queue plan-b >/dev/null 2>&1; run_queue plan-c >/dev/null 2>&1
run_queue reorder plan-a plan-b plan-c >/dev/null 2>&1
before="$(queue_order)"
# (a) missing entry -> count mismatch
set +e; out=$(run_queue reorder plan-a plan-b 2>&1); ec=$?; set +e
[ "$ec" -eq 0 ] && { h_fail "row13a" "expected non-zero for missing entry"; }
assert_order "row13a order unchanged" "$before"
# (b) duplicate-as-extra -> dup rejection
set +e; out=$(run_queue reorder plan-a plan-b plan-b 2>&1); ec=$?; set +e
[ "$ec" -eq 0 ] && { h_fail "row13b" "expected non-zero for duplicate entry"; }
assert_order "row13b order unchanged" "$before"
h_pass "row13 — reject non-permutation (missing/extra)"
# ---------------------------------------------------------------------------
# Row 14 — touch-nothing-on-rejection: target mtimes unchanged after a reject
# ---------------------------------------------------------------------------
setup
mkplan plan-a.md plan-b.md plan-c.md
run_queue plan-a >/dev/null 2>&1; run_queue plan-b >/dev/null 2>&1; run_queue plan-c >/dev/null 2>&1
run_queue reorder plan-a plan-b plan-c >/dev/null 2>&1
a0=$(target_mtime plan-a.md); b0=$(target_mtime plan-b.md); c0=$(target_mtime plan-c.md)
set +e; run_queue reorder plan-c plan-a plan-z >/dev/null 2>&1; set +e   # rejected: plan-z not queued
a1=$(target_mtime plan-a.md); b1=$(target_mtime plan-b.md); c1=$(target_mtime plan-c.md)
if [ "$a0" != "$a1" ] || [ "$b0" != "$b1" ] || [ "$c0" != "$c1" ]; then
    h_fail "row14" "target mtimes changed on a rejected reorder"
fi
h_pass "row14 — touch-nothing on rejection"
# ===========================================================================
# Back-of-queue stamping on ENQUEUE. A bare `ln -s`/`mv` leaves the new entry
# sorting by the plan's AUTHORING mtime, and `reorder` writes its ladder into
# the PAST — so a plan authored before the last reorder used to jump to the
# FRONT and run next. Every row below deliberately gives the incoming plan an
# ANCIENT target mtime; queuing a freshly-created plan would pass even with
# the bug present.
# ===========================================================================

# ---------------------------------------------------------------------------
# Row 17 — the reported bug: queue a plan whose target predates the existing
# reorder ladder. It must land LAST, not first.
# ---------------------------------------------------------------------------
setup
mkplan plan-a.md plan-b.md plan-c.md plan-old.md
touch -t 202001010000.00 "$PDIR/plan-old.md"
run_queue plan-a >/dev/null 2>&1; run_queue plan-b >/dev/null 2>&1; run_queue plan-c >/dev/null 2>&1
run_queue reorder plan-a plan-b plan-c >/dev/null 2>&1   # ladder stamped into the past
run_queue plan-old >/dev/null 2>&1
assert_order "row17 stale-mtime plan lands at the back" \
             "plan-a.md plan-b.md plan-c.md plan-old.md"
h_pass "row17 — enqueue of an old plan goes to the back (core bug)"
# ---------------------------------------------------------------------------
# Row 18 — platform-agnostic: BOTH sort keys (symlink lstat for GNU ls, target
# stat for BSD ls) of the new entry are strictly newer than every incumbent.
# Without both, the test passes on Linux CI while macOS keeps breaking.
# ---------------------------------------------------------------------------
setup
mkplan plan-a.md plan-b.md plan-old.md
touch -t 202001010000.00 "$PDIR/plan-old.md"
run_queue plan-a >/dev/null 2>&1; run_queue plan-b >/dev/null 2>&1
run_queue reorder plan-a plan-b >/dev/null 2>&1
run_queue plan-old >/dev/null 2>&1
for incumbent in plan-a.md plan-b.md; do
    if [ "$(link_mtime plan-old.md)" -le "$(link_mtime "$incumbent")" ]; then
        h_fail "row18" "new entry's symlink mtime not newer than $incumbent"
    fi
    if [ "$(target_mtime plan-old.md)" -le "$(target_mtime "$incumbent")" ]; then
        h_fail "row18" "new entry's target mtime not newer than $incumbent"
    fi
done
h_pass "row18 — both symlink and target sort keys stamped"
# ---------------------------------------------------------------------------
# Row 19 — `requeue` (mv out of skipped/) is the second enqueue path and must
# stamp too; `mv` otherwise carries the old mtime straight across.
# (plan-old uses `requeue` path — no impl_model check; plan-a/b use queue add)
# ---------------------------------------------------------------------------
setup
mkplan plan-a.md plan-b.md
touch "$PDIR/plan-old.md"; touch -t 202001010000.00 "$PDIR/plan-old.md"
run_queue plan-a >/dev/null 2>&1; run_queue plan-b >/dev/null 2>&1
run_queue reorder plan-a plan-b >/dev/null 2>&1
ln -s "$PDIR/plan-old.md" "$NDIR/skipped/plan-old.md"
touch -h -t 202001010000.00 "$NDIR/skipped/plan-old.md"
run_queue requeue >/dev/null 2>&1
assert_order "row19 requeued plan lands at the back" "plan-a.md plan-b.md plan-old.md"
h_pass "row19 — requeue stamps to the back"
# ---------------------------------------------------------------------------
# Row 20 — two successive enqueues of equally-ancient plans keep INSERTION
# order and stay >=60s apart (no same-second tie -> no filename tie-scramble;
# 'y' before 'x' alphabetically would expose one).
# ---------------------------------------------------------------------------
setup
mkplan plan-a.md plan-y.md plan-x.md
touch -t 202001010000.00 "$PDIR/plan-y.md" "$PDIR/plan-x.md"
run_queue plan-a >/dev/null 2>&1
run_queue plan-y >/dev/null 2>&1
run_queue plan-x >/dev/null 2>&1
assert_order "row20 insertion order preserved" "plan-a.md plan-y.md plan-x.md"
if [ "$(( $(target_mtime plan-x.md) - $(target_mtime plan-y.md) ))" -lt 60 ]; then
    h_fail "row20" "successive enqueues not >=60s apart"
fi
h_pass "row20 — successive enqueues stay spaced and ordered"
# ===========================================================================
# impl_model presence/validity gate — enforced independently of whether the
# plan carries a Verification Matrix (L46).  bin/lib/plan-model-consistency
# short-circuits to exit 0 on a matrix-less plan, so these rows exercise the
# separate check in `queue add` that runs BEFORE it.
# ===========================================================================

# Assert `queue add` REFUSES a fixture: non-zero exit, plan absent from the
# queue, and every $3.. token present in the combined output.
expect_reject() {
    local row="$1" plan="$2"; shift 2
    local out ec tok
    set +e; out=$(run_queue "$plan" 2>&1); ec=$?; set +e
    if [ "$ec" -eq 0 ]; then
        h_fail "$row" "expected non-zero exit, got 0"
    fi
    for tok in "$@"; do
        if ! echo "$out" | grep -q "$tok"; then
            h_fail "$row" "output missing '$tok', got: $out"
        fi
    done
    assert_absent "$row not queued" "$NDIR/queue/$plan.md"
    return 0
}

# Row 21 — NO matrix, valid `impl_model: sonnet` → queues.  Proves the gate does
# not over-reject the (common) matrix-less plan.
setup
printf -- '---\nimpl_model: sonnet\n---\n\n# no matrix here\n' > "$PDIR/plan-m.md"
run_queue plan-m >/dev/null 2>&1
assert_present "row21 queued" "$NDIR/queue/plan-m.md"
h_pass "row21 — matrix-less plan with a valid impl_model queues"
# Row 22 — NO matrix, NO impl_model → refused.  The exact L46 hole: before this
# gate plan-model-consistency exited 0 and the plan queued unvalidated.
setup
printf -- '# no frontmatter, no matrix\n' > "$PDIR/plan-n.md"
expect_reject row22 plan-n "impl_model: is missing or blank"
h_pass "row22 — matrix-less plan missing impl_model is refused"
# Row 23 — NO matrix, `impl_model: fable` → refused, message NAMES the value.
# plan-model-tier writes its rejection to STDOUT, so a dropped capture or a
# stray `2>/dev/null` would silence it.
setup
printf -- '---\nimpl_model: fable\n---\n\n# no matrix here\n' > "$PDIR/plan-o.md"
expect_reject row23 plan-o "fable" "not selectable"
h_pass "row23 — matrix-less plan with an unselectable impl_model is refused"
# Row 24 — valid matrix + valid `impl_model: sonnet` → still queues.  Regression
# guard: the presence check must not shadow the accepted path.
setup
printf -- '---\nimpl_model: sonnet\n---\n%s\n' "$CLEAN_MATRIX" > "$PDIR/plan-p.md"
run_queue plan-p >/dev/null 2>&1
assert_present "row24 queued" "$NDIR/queue/plan-p.md"
h_pass "row24 — matrixed, correctly-marked plan still queues"
# Row 26 — a Truly-manual matrix row under `impl_model: sonnet` is STILL refused
# by bin/lib/plan-model-consistency.  Without this row the whole consistency call
# could be deleted and rows 15/21/22/23/24 would all stay green.
setup
printf -- '---\nimpl_model: sonnet\n---\n%s\n' "$MANUAL_MATRIX" > "$PDIR/plan-q.md"
expect_reject row26 plan-q "Truly-manual row forbids impl_model: sonnet"
h_pass "row26 — consistency backstop still fires under the new gate"
# ---------------------------------------------------------------------------
# Row 27 — queue_entries_ordered is unaffected by editing a queued plan's TARGET.
# queue_entries_ordered sorts by the SYMLINK's own lstat mtime (not the target's
# mtime), so touching the target never shifts its run position.
#
# Sequence: queue a then b, reorder so a is first (the reorder ladder stamps
# symlinks into the past with a clear gap), then touch a's TARGET to a far-future
# time. Assert queue_entries_ordered still returns a before b.
setup
mkplan plan-lstat-a.md plan-lstat-b.md
run_queue plan-lstat-a >/dev/null 2>&1
run_queue plan-lstat-b >/dev/null 2>&1
# Reorder: a first, b second — stamps symlinks into the past with a clear gap.
run_queue reorder plan-lstat-a plan-lstat-b >/dev/null 2>&1
# Edit plan-a's TARGET to a far-future time (simulates authoring/editing the plan).
touch -t 209912312359.59 "$PDIR/plan-lstat-a.md"
# queue_entries_ordered must still return a then b (oldest symlink lstat first).
_r27_order=$(queue_entries_ordered "$NDIR/queue" | xargs -n1 basename | tr '\n' ' ')
if [ "$_r27_order" = "plan-lstat-a.md plan-lstat-b.md " ]; then
    h_pass "row27 — queue_entries_ordered unaffected by target edit"
else
    h_fail "row27" "wrong order after target edit (got: $_r27_order)"
fi

