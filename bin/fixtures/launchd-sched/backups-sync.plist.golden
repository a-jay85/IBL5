<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ibl5.backups-sync</string>
	<key>Program</key>
	<string>@MAIN_WT@/bin/backups-sync</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>@MAIN_WT@</string>
	<key>StandardOutPath</key>
	<string>@HOME@/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/backups-sync/logs/launchd-stdout.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/backups-sync/logs/launchd-stderr.log</string>
</dict>
</plist>
