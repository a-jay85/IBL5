@@ -0,0 +1,205 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Tests\DatabaseIntegration;
+
+use JsbParser\AswFileParser;
+use JsbParser\Importers\AswImporter;
+use JsbParser\JsbImportRepository;
+use JsbParser\JsbImportService;
+use JsbParser\PlayerIdResolver;
+use PHPUnit\Framework\Attributes\Group;
+use Tests\JsbParser\Importers\BuildsAswFixtures;
+
+require_once __DIR__ . '/../JsbParser/Importers/BuildsAswFixtures.php';
+
+/**
+ * Full .asw import cycles against real MariaDB: the canonical roster table, the
+ * participant awards written beside it, the updater-path stale guard, and the
+ * bulk path that skips it.
+ */
+#[Group('database')]
+class AswImportCycleTest extends DatabaseTestCase
+{
+    use BuildsAswFixtures;
+
+    private const PID_ALLSTAR = 200000101;
+    private const PID_ROOKIE = 200000201;
+    private const PID_THREE_POINT = 200000301;
+    private const PID_DUNK = 200000401;
+
+    private AswImporter $importer;
+    private JsbImportService $service;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        $repository = new JsbImportRepository($this->db);
+        $this->importer = new AswImporter($repository);
+        $this->service = new JsbImportService($repository, new PlayerIdResolver($this->db));
+    }
+
+    public function testFullImportCycleWritesRostersAndAwards(): void
+    {
+        $bytes = $this->seedPlayersAndBuildBytes();
+
+        $this->importer->import($bytes, 2090);
+
+        self::assertSame($this->parsedSlotCount($bytes), $this->countRows('ibl_jsb_allstar_rosters', 'season_year = 2090'));
+        self::assertSame(
+            [
+                'Eastern Conference All-Star|Asw Cycle AllStar',
+                'Rookie-Sophomore Challenge|Asw Cycle Rookie',
+                'Slam Dunk Competition|Asw Cycle Dunker',
+                'Three-Point Contest|Asw Cycle Shooter',
+            ],
+            $this->awardRows(2090)
+        );
+        self::assertSame(0, $this->countRows('ibl_awards', "year = 2090 AND (award LIKE '% - Winner' OR award LIKE '% - MVP')"));
+    }
+
+    public function testSecondImportCycleAddsNoAwardRows(): void
+    {
+        $bytes = $this->seedPlayersAndBuildBytes();
+        $this->importer->import($bytes, 2090);
+        $awardsAfterFirst = $this->countRows('ibl_awards', 'year = 2090');
+        self::assertSame(4, $awardsAfterFirst);
+
+        $second = $this->importer->import($bytes, 2090);
+
+        self::assertSame(0, $second->errors);
+        self::assertSame($awardsAfterFirst, $this->countRows('ibl_awards', 'year = 2090'));
+    }
+
+    public function testStaleUpdaterImportLeavesTablesUnchanged(): void
+    {
+        $bytes = $this->seedPlayersAndBuildBytes();
+        $path = $this->writeTempFile($bytes);
+        try {
+            $this->service->processAswFile($path, 2089);
+
+            $result = $this->service->processAswData($bytes, 2090);
+        } finally {
+            unlink($path);
+        }
+
+        self::assertSame(0, $this->countRows('ibl_jsb_allstar_rosters', 'season_year = 2090'));
+        self::assertSame(0, $this->countRows('ibl_jsb_allstar_scores', 'season_year = 2090'));
+        self::assertSame(0, $this->countRows('ibl_awards', 'year = 2090'));
+        self::assertStringContainsString('season 2089', implode("\n", $result->messages));
+    }
+
+    public function testBulkImportSkipsStaleCheck(): void
+    {
+        $bytes = $this->seedPlayersAndBuildBytes();
+        $path = $this->writeTempFile($bytes);
+        try {
+            $this->service->processAswFile($path, 2089);
+            $this->service->processAswFile($path, 2090);
+        } finally {
+            unlink($path);
+        }
+
+        self::assertSame($this->parsedSlotCount($bytes), $this->countRows('ibl_jsb_allstar_rosters', 'season_year = 2090'));
+    }
+
+    // ── Private helpers ────────────────────────────────────────────────────────
+
+    /**
+     * Seeds the four named players on team 1, the 2090 conference mapping, and returns
+     * a .asw file whose rosters lead with those players.
+     */
+    private function seedPlayersAndBuildBytes(): string
+    {
+        $bytes = $this->buildRookieAwareFixture();
+        $rosters = AswFileParser::parse($bytes)['rosters'];
+
+        $firstPids = [
+            ['allstar_1', 'Asw Cycle AllStar'],
+            ['rookie_1', 'Asw Cycle Rookie'],
+            ['three_point', 'Asw Cycle Shooter'],
+            ['dunk_contest', 'Asw Cycle Dunker'],
+        ];
+        foreach ($firstPids as [$eventType, $name]) {
+            $this->insertTestPlayer($rosters[$eventType][0], $name, ['teamid' => 1]);
+        }
+
+        $this->insertRow('ibl_league_config', [
+            'season_ending_year' => 2090,
+            'team_slot' => 1,
+            'team_name' => 'Asw Cycle Team',
+            'teamid' => 1,
+            'conference' => 'Eastern',
+            'division' => 'Atlantic',
+            'playoff_qualifiers_per_conf' => 4,
+            'playoff_round1_format' => 'bo7',
+            'playoff_round2_format' => 'bo7',
+            'playoff_round3_format' => 'bo7',
+            'playoff_round4_format' => 'bo7',
+            'team_count' => 1,
+        ]);
+
+        return $bytes;
+    }
+
+    /**
+     * buildAswFile() leaves the rookie rosters empty, so overwrite the first Rookie 1 line.
+     */
+    private function buildRookieAwareFixture(): string
+    {
+        $bytes = $this->buildAswFile(
+            allstar1: [self::PID_ALLSTAR, self::PID_ALLSTAR + 1],
+            threePointPids: [self::PID_THREE_POINT, self::PID_THREE_POINT + 1],
+            dunkPids: [self::PID_DUNK, self::PID_DUNK + 1],
+            dunkRound1Scores: [455, 480, 470],
+            threePtRound1Scores: [18, 21],
+        );
+        $lines = explode("\r\n", $bytes);
+        $lines[AswFileParser::ROOKIE_1_START] = (string) self::PID_ROOKIE;
+
+        return str_pad(rtrim(implode("\r\n", $lines), ' '), AswFileParser::FILE_SIZE);
+    }
+
+    private function parsedSlotCount(string $bytes): int
+    {
+        $total = 0;
+        foreach (AswFileParser::parse($bytes)['rosters'] as $pids) {
+            $total += count($pids);
+        }
+        return $total;
+    }
+
+    private function writeTempFile(string $bytes): string
+    {
+        $path = tempnam(sys_get_temp_dir(), 'asw_cycle_');
+        self::assertIsString($path);
+        file_put_contents($path, $bytes);
+        return $path;
+    }
+
+    /**
+     * @return list<string> "award|name" rows for the year, sorted
+     */
+    private function awardRows(int $year): array
+    {
+        $result = $this->db->query("SELECT award, name FROM ibl_awards WHERE year = $year ORDER BY award, name");
+        self::assertInstanceOf(\mysqli_result::class, $result);
+        $rows = [];
+        while ($row = $result->fetch_assoc()) {
+            $rows[] = $row['award'] . '|' . $row['name'];
+        }
+        $result->free();
+        return $rows;
+    }
+
+    private function countRows(string $table, string $where): int
+    {
+        $result = $this->db->query("SELECT COUNT(*) AS c FROM $table WHERE $where");
+        self::assertInstanceOf(\mysqli_result::class, $result);
+        $row = $result->fetch_assoc();
+        $result->free();
+        self::assertNotNull($row);
+        return (int) $row['c'];
+    }
+}
diff --git a/ibl5/tests/DatabaseIntegration/AswRepositoryAllStarAwardsTest.php b/ibl5/tests/DatabaseIntegration/AswRepositoryAllStarAwardsTest.php
new file mode 100644
index 0000000000..373630c609
--- /dev/null
+++ b/ibl5/tests/DatabaseIntegration/AswRepositoryAllStarAwardsTest.php
@@ -0,0 +1,202 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Tests\DatabaseIntegration;
+
+use JsbParser\Repositories\AswRepository;
+use PHPUnit\Framework\Attributes\Group;
+
+/**
+ * DB-integration tests for the stale-roster finder, the conference lookup, and the
+ * family-guarded award insert on AswRepository.
+ *
+ * Seasons 2089 and 2090 never collide with ci-seed rows; every fixture rolls back
+ * with the DatabaseTestCase transaction.
+ */
+#[Group('database')]
+class AswRepositoryAllStarAwardsTest extends DatabaseTestCase
+{
+    private const PID = 200000401;
+    private const HIST_YEAR = 2090;
+    private const EVENT_TYPES = ['allstar_1', 'allstar_2', 'rookie_1', 'rookie_2', 'three_point', 'dunk_contest'];
+
+    private AswRepository $repo;
+    private int $nextSlot = 1;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        $this->repo = new AswRepository($this->db);
+    }
+
+    public function testFindOtherSeasonReturnsMatchingEarlierYear(): void
+    {
+        $rosters = $this->sampleRosters();
+        $this->seedRosters(2089, $rosters);
+
+        self::assertSame(2089, $this->repo->findOtherSeasonWithIdenticalRosters(2090, $rosters));
+    }
+
+    public function testFindOtherSeasonIgnoresTargetSeason(): void
+    {
+        $rosters = $this->sampleRosters();
+        $this->seedRosters(2090, $rosters);
+
+        self::assertNull($this->repo->findOtherSeasonWithIdenticalRosters(2090, $rosters));
+    }
+
+    public function testFindOtherSeasonReturnsNullWhenOneSlotDiffers(): void
+    {
+        $rosters = $this->sampleRosters();
+        $this->seedRosters(2089, $rosters);
+
+        $differing = $rosters;
+        $differing['dunk_contest'] = [200000301, 200000399];
+
+        self::assertNull($this->repo->findOtherSeasonWithIdenticalRosters(2090, $differing));
+    }
+
+    public function testFindConferencePrefersHistTeam(): void
+    {
+        $this->insertTestPlayer(self::PID, 'Asw Conf Player', ['teamid' => 2]);
+        $this->insertHistRow(self::PID, 'Asw Conf Player', self::HIST_YEAR, ['teamid' => 1]);
+        $this->seedConfig(2090, 1, 'Eastern');
+        $this->seedConfig(2090, 2, 'Western');
+
+        self::assertSame('Eastern', $this->repo->findAllStarConference(self::PID, 2090));
+    }
+
+    public function testFindConferenceFallsBackToPlrTeam(): void
+    {
+        $this->insertTestPlayer(self::PID, 'Asw Conf Player', ['teamid' => 2]);
+        $this->seedConfig(2090, 1, 'Eastern');
+        $this->seedConfig(2090, 2, 'Western');
+
+        self::assertSame('Western', $this->repo->findAllStarConference(self::PID, 2090));
+    }
+
+    public function testFindConferenceReturnsNullForUnmappedTeam(): void
+    {
+        $this->insertTestPlayer(self::PID, 'Asw Conf Player', ['teamid' => 3]);
+        $this->seedConfig(2090, 1, 'Eastern');
+        $this->seedConfig(2090, 2, 'Western');
+
+        self::assertNull($this->repo->findAllStarConference(self::PID, 2090));
+    }
+
+    public function testInsertAwardInsertsWhenAbsent(): void
+    {
+        $affected = $this->repo->insertAwardUnlessFamilyExists(
+            2090,
+            'Eastern Conference All-Star',
+            'Asw Test',
+            'Western Conference All-Star'
+        );
+
+        self::assertSame(1, $affected);
+        self::assertSame(1, $this->awardCount('Asw Test'));
+    }
+
+    public function testInsertAwardSkipsExactDuplicate(): void
+    {
+        $this->repo->insertAwardUnlessFamilyExists(2090, 'Eastern Conference All-Star', 'Asw Test', 'Western Conference All-Star');
+
+        $affected = $this->repo->insertAwardUnlessFamilyExists(
+            2090,
+            'Eastern Conference All-Star',
+            'Asw Test',
+            'Western Conference All-Star'
+        );
+
+        self::assertSame(0, $affected);
+        self::assertSame(1, $this->awardCount('Asw Test'));
+    }
+
+    public function testInsertAwardSkipsWhenSiblingFamilyRowExists(): void
+    {
+        $this->insertRow('ibl_awards', [
+            'year' => 2090,
+            'award' => 'Western Conference All-Star',
+            'name' => 'Asw Test',
+        ]);
+
+        $affected = $this->repo->insertAwardUnlessFamilyExists(
+            2090,
+            'Eastern Conference All-Star',
+            'Asw Test',
+            'Western Conference All-Star'
+        );
+
+        self::assertSame(0, $affected);
+        self::assertSame(1, $this->awardCount('Asw Test'));
+        $result = $this->db->query(
+            "SELECT COUNT(*) AS c FROM ibl_awards WHERE name = 'Asw Test' AND award = 'Eastern Conference All-Star'"
+        );
+        self::assertInstanceOf(\mysqli_result::class, $result);
+        $row = $result->fetch_assoc();
+        $result->free();
+        self::assertNotNull($row);
+        self::assertSame(0, (int) $row['c']);
+    }
+
+    /**
+     * @return array<string, list<int>>
+     */
+    private function sampleRosters(): array
+    {
+        return [
+            'allstar_1' => [200000101, 200000102],
+            'allstar_2' => [200000111],
+            'rookie_1' => [200000201],
+            'rookie_2' => [200000211],
+            'three_point' => [200000301, 200000302],
+            'dunk_contest' => [200000301, 200000302],
+        ];
+    }
+
+    /**
+     * @param array<string, list<int>> $rosters
+     */
+    private function seedRosters(int $seasonYear, array $rosters): void
+    {
+        foreach (self::EVENT_TYPES as $eventType) {
+            foreach ($rosters[$eventType] as $index => $pid) {
+                $this->insertRow('ibl_jsb_allstar_rosters', [
+                    'season_year' => $seasonYear,
+                    'event_type' => $eventType,
+                    'roster_slot' => $index + 1,
+                    'pid' => $pid,
+                ]);
+            }
+        }
+    }
+
+    private function seedConfig(int $seasonEndingYear, int $teamId, string $conference): void
+    {
+        $this->insertRow('ibl_league_config', [
+            'season_ending_year' => $seasonEndingYear,
+            'team_slot' => $this->nextSlot++,
+            'team_name' => 'Asw Config Team ' . $teamId,
+            'teamid' => $teamId,
+            'conference' => $conference,
+            'division' => 'Atlantic',
+            'playoff_qualifiers_per_conf' => 4,
+            'playoff_round1_format' => 'bo7',
+            'playoff_round2_format' => 'bo7',
+            'playoff_round3_format' => 'bo7',
+            'playoff_round4_format' => 'bo7',
+            'team_count' => 2,
+        ]);
+    }
+
+    private function awardCount(string $name): int
+    {
+        $result = $this->db->query("SELECT COUNT(*) AS c FROM ibl_awards WHERE year = 2090 AND name = '" . $this->db->real_escape_string($name) . "'");
+        self::assertInstanceOf(\mysqli_result::class, $result);
+        $row = $result->fetch_assoc();
+        $result->free();
+        self::assertNotNull($row);
+        return (int) $row['c'];
+    }
+}
diff --git a/ibl5/tests/DatabaseIntegration/AswStaleRosterMigrationTest.php b/ibl5/tests/DatabaseIntegration/AswStaleRosterMigrationTest.php
new file mode 100644
index 0000000000..87f29770b8
--- /dev/null
+++ b/ibl5/tests/DatabaseIntegration/AswStaleRosterMigrationTest.php
@@ -0,0 +1,182 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Tests\DatabaseIntegration;
+
+use PHPUnit\Framework\Attributes\Group;
+
+/**
+ * Runs the shipped stale-ASW-rows migration against seeded rows: the 2009 delete
+ * with its backup, the 2008 participant backfill, the conference-family guard,
+ * and the rerun no-op.
+ *
+ * CI applies every migration before the suite, so the backup tables already exist
+ * (asserted first). The test executes only the non-DDL statements, which keeps the
+ * run inside DatabaseTestCase's transaction and rolls every row back in tearDown.
+ */
+#[Group('database')]
+final class AswStaleRosterMigrationTest extends DatabaseTestCase
+{
+    private const ROSTER_BACKUP = 'ibl_jsb_allstar_rosters_backup_210';
+    private const SCORE_BACKUP = 'ibl_jsb_allstar_scores_backup_210';
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        $this->assertBackupTablesExist();
+        $this->seedRows();
+    }
+
+    public function testMigrationDeletesOnly2009RowsAndBacksThemUp(): void
+    {
+        $before2009Rosters = $this->countRows('ibl_jsb_allstar_rosters', 'season_year = 2009');
+        $before2009Scores = $this->countRows('ibl_jsb_allstar_scores', 'season_year = 2009');
+        $before2007Rosters = $this->countRows('ibl_jsb_allstar_rosters', 'season_year = 2007');
+        $before2007Scores = $this->countRows('ibl_jsb_allstar_scores', 'season_year = 2007');
+        $before2008Rosters = $this->countRows('ibl_jsb_allstar_rosters', 'season_year = 2008');
+        self::assertGreaterThan(0, $before2009Rosters);
+        self::assertGreaterThan(0, $before2009Scores);
+
+        $this->runMigration();
+
+        self::assertSame(0, $this->countRows('ibl_jsb_allstar_rosters', 'season_year = 2009'));
+        self::assertSame(0, $this->countRows('ibl_jsb_allstar_scores', 'season_year = 2009'));
+        self::assertSame($before2007Rosters, $this->countRows('ibl_jsb_allstar_rosters', 'season_year = 2007'));
+        self::assertSame($before2007Scores, $this->countRows('ibl_jsb_allstar_scores', 'season_year = 2007'));
+        self::assertSame($before2008Rosters, $this->countRows('ibl_jsb_allstar_rosters', 'season_year = 2008'));
+        self::assertGreaterThanOrEqual($before2009Rosters, $this->countRows(self::ROSTER_BACKUP, 'season_year = 2009'));
+        self::assertGreaterThanOrEqual($before2009Scores, $this->countRows(self::SCORE_BACKUP, 'season_year = 2009'));
+    }
+
+    public function testMigrationBackfills2008ParticipantCounts(): void
+    {
+        $this->runMigration();
+
+        self::assertSame(20, $this->awardCount('Rookie-Sophomore Challenge'));
+        self::assertSame(8, $this->awardCount('Three-Point Contest'));
+        self::assertSame(8, $this->awardCount('Slam Dunk Competition'));
+    }
+
+    public function testMigrationHonorsConferenceFamilyGuard(): void
+    {
+        $this->runMigration();
+
+        $result = $this->db->query(
+            "SELECT award FROM ibl_awards WHERE year = 2008 AND name = 'Chris Paul'"
+            . " AND award IN ('Eastern Conference All-Star', 'Western Conference All-Star')"
+        );
+        self::assertInstanceOf(\mysqli_result::class, $result);
+        $awards = [];
+        while ($row = $result->fetch_assoc()) {
+            $awards[] = (string) $row['award'];
+        }
+        $result->free();
+
+        self::assertSame(['Western Conference All-Star'], $awards);
+    }
+
+    public function testMigrationSkipsBackfillWhen2008RostersAreMissing(): void
+    {
+        $this->db->query('DELETE FROM ibl_jsb_allstar_rosters WHERE season_year = 2008');
+        $before = $this->countRows('ibl_awards', 'year = 2008');
+
+        $this->runMigration();
+
+        self::assertSame($before, $this->countRows('ibl_awards', 'year = 2008'));
+    }
+
+    public function testMigrationSecondRunInsertsNothing(): void
+    {
+        $this->runMigration();
+        $afterFirst = $this->countRows('ibl_awards', 'year = 2008');
+        self::assertGreaterThan(0, $afterFirst);
+
+        $this->runMigration();
+
+        self::assertSame($afterFirst, $this->countRows('ibl_awards', 'year = 2008'));
+    }
+
+    // ── Private helpers ────────────────────────────────────────────────────────
+
+    private function assertBackupTablesExist(): void
+    {
+        foreach ([self::ROSTER_BACKUP, self::SCORE_BACKUP] as $table) {
+            $result = $this->db->query(
+                "SELECT 1 FROM information_schema.TABLES WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = '" . $table . "'"
+            );
+            self::assertInstanceOf(\mysqli_result::class, $result);
+            $exists = $result->num_rows > 0;
+            $result->free();
+            self::assertTrue($exists, "Backup table $table must exist; apply migrations first (bin/db-migrate)");
+        }
+    }
+
+    private function seedRows(): void
+    {
+        foreach ([2007, 2008, 2009] as $year) {
+            $this->db->query(
+                "INSERT IGNORE INTO ibl_jsb_allstar_rosters (season_year, event_type, roster_slot, pid, player_name)"
+                . " VALUES ($year, 'allstar_1', 1, NULL, NULL)"
+            );
+        }
+        foreach ([2007, 2009] as $year) {
+            $this->db->query(
+                "INSERT IGNORE INTO ibl_jsb_allstar_scores (season_year, contest_type, round, participant_slot, pid, score)"
+                . " VALUES ($year, 'three_point', 1, 1, NULL, 10)"
+            );
+        }
+        // CI already applied the migration, so clear its 2008 rows (rolled back in tearDown)
+        // before seeding the one Western row the family guard must respect.
+        $this->db->query('DELETE FROM ibl_awards WHERE year = 2008');
+        $this->db->query(
+            "INSERT INTO ibl_awards (year, award, name) VALUES (2008, 'Western Conference All-Star', 'Chris Paul')"
+        );
+    }
+
+    /**
+     * @return list<string>
+     */
+    private function statements(): array
+    {
+        $matches = glob(dirname(__DIR__, 2) . '/migrations/*_asw_stale_rows_allstar_awards_backfill.sql');
+        self::assertIsArray($matches);
+        self::assertCount(1, $matches, 'expected exactly one asw_stale_rows_allstar_awards_backfill migration');
+        $sql = file_get_contents($matches[0]); // phpunit-hygiene-allow: migration SQL has no executable seam other than its text
+        self::assertIsString($sql);
+        $sql = (string) preg_replace('/--[^\n]*/', '', $sql);
+
+        $statements = [];
+        foreach (explode(';', $sql) as $statement) {
+            $statement = trim($statement);
+            if ($statement === '' || stripos($statement, 'CREATE TABLE') === 0) {
+                continue;
+            }
+            $statements[] = $statement;
+        }
+        self::assertNotSame([], $statements);
+        return $statements;
+    }
+
+    private function runMigration(): void
+    {
+        foreach ($this->statements() as $sql) {
+            $this->db->query($sql);
+        }
+    }
+
+    private function countRows(string $table, string $where): int
+    {
+        $result = $this->db->query("SELECT COUNT(*) AS c FROM $table WHERE $where");
+        self::assertInstanceOf(\mysqli_result::class, $result);
+        $row = $result->fetch_assoc();
+        $result->free();
+        self::assertNotNull($row);
+        return (int) $row['c'];
+    }
+
+    private function awardCount(string $award): int
+    {
+        return $this->countRows('ibl_awards', "year = 2008 AND award = '" . $this->db->real_escape_string($award) . "'");
+    }
+}
