#!/usr/bin/env bash
# Usage: bin/digest-dm-build --pr-number N --title TITLE --url URL [--branch BRANCH] [--pr-body-file FILE] < verdict-body
#   Reads a /pr-ready sticky verdict comment body on STDIN and writes a Discord-sized
#   merge-digest DM to STDOUT. --pr-number, --title and --url are required; an unknown or
#   missing flag exits 2 with a message on stderr. --branch is optional; when non-empty it
#   prints as a link to --url on the line under the "Merged" header, otherwise the
#   header's #N is that link. The URL is never printed bare. A missing or unparseable
#   digest is NOT an error: it degrades the message body and still exits 0.
#   --pr-body-file is optional; when it names a readable PR body carrying a valid
#   `**Merge danger:**` line, a one-way door adds a loud line above the PR header (any
#   after-merge lines print first) and a two-way localized change compresses the
#   What/Watch budgets. An unreadable path exits 2; a missing or malformed danger
#   line leaves the output unchanged.
#   After-merge mode: [--ping-out FILE] [--manual-count N] [--auto-ci-count N]
#   [--auto-mac-count N] [--auto-failed-count N] [--comment-url URL] [--run-url URL]
#   [--job-result NAME=RESULT]...  --ping-out turns the mode on and receives `true` or
#   `false`. The ping is true when manual or auto-failed rows exist, when any count is not
#   all digits, or when any --job-result is not `success`. A bad count or a failed job
#   writes `true` and still exits 0, so the merge is announced. `--ping-out ''` exits 2.
#   The top of the message then carries the action line and the directions link.
#
# Consumed by .github/workflows/merge-digest-notify.yml, which pipes in the body of the
# LAST comment carrying `<!-- pr-ready-verdict -->`.
#
# The `_digest_labels` awk below moved here out of bin/pr-cycle when the
# ~/IBL5-merge-digest.md ledger was replaced by a per-merge DM. The `### Merge digest`
# block shape it parses is a contract documented in
# .claude/review-shared/_phase7-verdict.md: exactly five bold labels, and the block
# ends at the next heading or horizontal rule.
#
# Budget: Discord caps a DM at 2000 characters and .github/actions/notify-discord does
# NOT chunk -- the cap is the caller's responsibility, and this script is the caller.
#   fixed scaffolding   ~70
#   "#N: <title>"      <=100   (title truncated at 80)
#   branch link        <=135   (branch truncated at 60, plus the <URL>)
#   What changed       <=1000  (a one-way danger prefix spends from this budget)
#   Watch              <=650
#                      ------
#                      ~1955
#   The after-merge top block spends from the What-changed budget, floor 200.

set -euo pipefail
# shellcheck source=bin/lib/post-merge-rows.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/post-merge-rows.sh"

TITLE_MAX=80
WHAT_MAX=1000
WATCH_MAX=650
BRANCH_MAX=60

# Truncation must be CHARACTER-wise, not byte-wise. Repo digests carry `·` (U+00B7) and
# `…`; a byte-wise cut can split a UTF-8 sequence, and the invalid bytes then reach
# `jq --arg` inside notify-discord. Bash's ${#v} and ${v:0:n} count characters only under
# a UTF-8 locale, and the name differs by platform (ubuntu-latest normalises to `C.utf8`,
# macOS ships `en_US.UTF-8`), so pick the first available rather than hardcoding one.
# A `while` fed by a HERESTRING (not a pipe) so the loop body's assignments survive, and
# so an early `return` cannot take SIGPIPE under pipefail
# (.claude/rules/shell-pipefail-grep.md).
_pick_utf8_locale() {
    local _l
    while IFS= read -r _l; do
        case "$_l" in
            C.UTF-8|C.utf8|en_US.UTF-8|en_US.utf8) printf '%s' "$_l"; return 0 ;;
        esac
    done <<< "$(locale -a 2>/dev/null || true)"
    return 1
}
_LOC="$(_pick_utf8_locale || true)"
if [ -n "$_LOC" ]; then
    export LC_ALL="$_LOC"
fi

PR_NUMBER=""
TITLE=""
URL=""
BRANCH=""
PR_BODY_FILE=""
PING_OUT=""
PING_OUT_SET=0
AM_MANUAL=""
AM_AUTO_CI=""
AM_AUTO_MAC=""
AM_FAILED=""
AM_COMMENT_URL=""
RUN_URL=""
JOB_RESULTS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --pr-number) PR_NUMBER="${2-}"; shift 2 ;;
        --title)     TITLE="${2-}";     shift 2 ;;
        --url)       URL="${2-}";       shift 2 ;;
        --branch)    BRANCH="${2-}";    shift 2 ;;
        --pr-body-file) PR_BODY_FILE="${2-}"; shift 2 ;;
        --ping-out)  PING_OUT="${2-}"; PING_OUT_SET=1; shift 2 ;;
        --manual-count)      AM_MANUAL="${2-}";      shift 2 ;;
        --auto-ci-count)     AM_AUTO_CI="${2-}";     shift 2 ;;
        --auto-mac-count)    AM_AUTO_MAC="${2-}";    shift 2 ;;
        --auto-failed-count) AM_FAILED="${2-}";      shift 2 ;;
        --comment-url)       AM_COMMENT_URL="${2-}"; shift 2 ;;
        --run-url)           RUN_URL="${2-}";        shift 2 ;;
        --job-result)        JOB_RESULTS+=("${2-}"); shift 2 ;;
        -h|--help)
            sed -n '/^# Usage:/,/^#$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)
            printf 'digest-dm-build: unknown argument: %s\n' "$1" >&2
            exit 2 ;;
    esac
done

if [ -z "$PR_NUMBER" ] || [ -z "$TITLE" ] || [ -z "$URL" ]; then
    printf 'digest-dm-build: --pr-number, --title and --url are all required\n' >&2
    exit 2
fi
case "$PR_NUMBER" in
    ''|*[!0-9]*)
        printf 'digest-dm-build: --pr-number must be digits, got: %s\n' "$PR_NUMBER" >&2
        exit 2 ;;
esac
if [ "$PING_OUT_SET" = 1 ] && [ -z "$PING_OUT" ]; then
    printf 'digest-dm-build: --ping-out needs a value\n' >&2
    exit 2
fi

# _digest_labels -- fold a `### Merge digest` block into "<label>\t<one-line value>" records.
# Values spanning several lines are folded so each label yields exactly one record.
_digest_labels() {
    # The squeeze happens INSIDE awk, at print time. A `| sed s/[[:space:]]\+/ /g` after
    # this would also collapse the tab this function emits as its field separator, and
    # every later `awk -F'\t'` lookup would silently find nothing.
    awk '
        function emit(l, v) {
            gsub(/[[:space:]]+/, " ", v); sub(/^ /, "", v); sub(/ $/, "", v)
            print l "\t" v
        }
        /^### Merge digest[[:space:]]*$/ { inblk = 1; next }
        inblk && /^#+ / { exit }
        # A horizontal rule ends the digest block just as a heading does. /pr-ready emits a
        # `---` after the block and then keeps writing, and an HR is not a heading, so without
        # this the rule and everything after it fall through to the continuation branch below
        # and get folded onto the last label value. Live rows for PRs #2092 and #2084 both
        # ended in a stray ` ---` this way.
        inblk && /^[[:space:]]*(---+|\*\*\*+|___+)[[:space:]]*$/ { exit }
        inblk {
            line = $0
            # The trailing [[:space:]]+ is load-bearing, not cosmetic. `*` is a list marker
            # in the class AND the first byte of `**Label:**`, so a zero-or-more space would
            # let a bare (unbulleted) production line self-strip to `*Label:** ...`, the
            # match below would fail, and every label would vanish into `digest: unavailable`.
            sub(/^[[:space:]]*[-*][[:space:]]+/, "", line)
            if (match(line, /^\*\*[^*]+:\*\*/)) {
                if (label != "") emit(label, val)
                label = substr(line, 3, RLENGTH - 5)
                val = substr(line, RLENGTH + 1)
            } else if (label != "" && line ~ /[^[:space:]]/) {
                val = val " " line
            }
        }
        END { if (label != "") emit(label, val) }
    '
}

# _trunc MAX VALUE -- character-wise truncate, appending U+2026 only when a cut happened.
# The ellipsis replaces the last kept character rather than extending past MAX, so the
# returned string is never longer than MAX.
_trunc() {
    _m="$1"; _v="$2"
    if [ "${#_v}" -le "$_m" ]; then
        printf '%s' "$_v"
        return 0
    fi
    printf '%s…' "${_v:0:$((_m - 1))}"
}

BODY="$(cat)"

# Herestrings, never pipes: _digest_labels' awk `exit`s at the block terminator, and a
# `printf ... | _digest_labels` would take SIGPIPE (141) under pipefail on a long body.
LABELS="$(_digest_labels <<< "$BODY")"

_label_value() {
    awk -F'\t' -v l="$1" '$1 == l { print $2; exit }' <<< "$LABELS"
}

WHAT="$(_label_value 'What changed')"
WATCH="$(_label_value 'Watch')"
# A zero-width space after each `@` in PR-sourced text: it renders but never notifies. The
# ping arms allowed_mentions.users=[owner] on some posts, so a `<@id>` or `@everyone` typed
# into a title or digest must stay inert whatever the ping value. send.sh's own prepended
# mention is added later and is never touched.
ZWSP="$(printf '\342\200\213')"
TITLE="${TITLE//@/@$ZWSP}"
WHAT="${WHAT//@/@$ZWSP}"
WATCH="${WATCH//@/@$ZWSP}"
BRANCH="${BRANCH//@/@$ZWSP}"
# Merge danger (optional): parsed from the PR body file with the same line shape that
# bin/lib/pr-armable.sh pr_merge_danger_hold and harness/merge_danger.py accept.
DANGER_LINE=""; MD_DOOR=""; MD_BLAST=""
if [ -n "$PR_BODY_FILE" ]; then
    [ -r "$PR_BODY_FILE" ] || { echo "digest-dm-build: --pr-body-file not readable: $PR_BODY_FILE" >&2; exit 2; }
    MD_RAW="$(grep -E '^\*\*Merge danger:\*\* Door: (one-way|two-way) · Blast radius: (localized|module|site-wide|external) · Why: .{20,}$' "$PR_BODY_FILE" | head -n1 || true)"
    if [ -n "$MD_RAW" ]; then
        MD_DOOR="${MD_RAW#*Door: }"; MD_DOOR="${MD_DOOR%% ·*}"
        MD_BLAST="${MD_RAW#*Blast radius: }"; MD_BLAST="${MD_BLAST%% ·*}"
    fi
fi
if [ "$MD_DOOR" = one-way ]; then
    DANGER_LINE="!! ONE-WAY DOOR (blast radius: $MD_BLAST)"
    WHAT_MAX=$((WHAT_MAX - ${#DANGER_LINE} - 1))     # the prefix spends from WHAT's budget
elif [ "$MD_DOOR" = two-way ] && [ "$MD_BLAST" = localized ]; then
    WHAT_MAX=400; WATCH_MAX=200                      # quiet merge: compressed body
fi
TITLE_T="$(_trunc "$TITLE_MAX" "$TITLE")"

# After-merge mode (--ping-out): decide the ping and build the top block. A bad VALUE never
# exits non-zero, since a failed build step would skip the send and silence the merge.
# Bad values ping instead.
TOP=""
if [ "$PING_OUT_SET" = 1 ]; then
    _results=(${JOB_RESULTS[@]+"${JOB_RESULTS[@]}"})
    # The two auto counts are display-only. A pseudo-result makes a bad value ping too.
    if ! pmr_is_count "$AM_AUTO_CI"; then _results+=("auto_ci_count=invalid"); fi
    if ! pmr_is_count "$AM_AUTO_MAC"; then _results+=("auto_mac_count=invalid"); fi
    pmr_ping_decision "$AM_MANUAL" "$AM_FAILED" ${_results[@]+"${_results[@]}"}
    printf '%s\n' "$PMR_PING" > "$PING_OUT"
    printf 'ping=%s reasons=%s\n' "$PMR_PING" "${PMR_PING_REASONS:-none}" >&2
    _url_re='^https://[^[:space:]<>]+$'
    DIR_URL="$URL"
    if [[ "$AM_COMMENT_URL" =~ $_url_re ]]; then DIR_URL="$AM_COMMENT_URL"; fi
    RUN_REF='(run link unavailable)'
    if [[ "$RUN_URL" =~ $_url_re ]]; then RUN_REF="<$RUN_URL>"; fi
    _reasons=" ${PMR_PING_REASONS//@/@$ZWSP} "
    _nz='[1-9]'
    case "$_reasons" in
        *" bad-count:"*|*" job:"*)
            _shown="${_reasons# }"
            TOP="**Post-merge pipeline problem** (${_shown% }). Run: $RUN_REF · Directions: <$DIR_URL>" ;;
    esac
    case "$_reasons" in
        *" manual "*)
            TOP="${TOP:+$TOP$'\n'}**Action needed after merge:** $AM_MANUAL manual step(s). Directions: <$DIR_URL>" ;;
    esac
    case "$_reasons" in
        *" auto-failed "*)
            TOP="${TOP:+$TOP$'\n'}**Post-merge auto step failed:** $AM_FAILED. Run: $RUN_REF" ;;
    esac
    if pmr_is_count "$AM_AUTO_CI" && pmr_is_count "$AM_AUTO_MAC" \
            && { [[ "$AM_AUTO_CI" =~ $_nz ]] || [[ "$AM_AUTO_MAC" =~ $_nz ]]; }; then
        TOP="${TOP:+$TOP$'\n'}After merge: $AM_AUTO_CI CI and $AM_AUTO_MAC Mac step(s) run automatically; Mac failures ping you in #dev."
    fi
    if [ -n "$TOP" ]; then
        WHAT_MAX=$((WHAT_MAX - ${#TOP} - 2))
        if [ "$WHAT_MAX" -lt 200 ]; then WHAT_MAX=200; fi
    fi
fi

# The branch is the link text for the PR URL, so the brackets that would close the
# link early are stripped, along with backticks. Without a branch, `#N` in the header
# carries the link instead. Every URL is wrapped in <> -- Discord's embed-suppression
# syntax, which also works inside a masked link.
BRANCH="${BRANCH//\`/}"
BRANCH="${BRANCH//[/}"
BRANCH="${BRANCH//]/}"
BRANCH_LINE=""
PR_REF="[#$PR_NUMBER](<$URL>)"
if [ -n "$BRANCH" ]; then
    BRANCH_LINE="$(printf '\n[%s](<%s>)' "$(_trunc "$BRANCH_MAX" "$BRANCH")" "$URL")"
    PR_REF="#$PR_NUMBER"
fi
# A confirmed merge is ALWAYS announced. A missing or unparseable digest degrades the
# message; it never suppresses it. (Same invariant bin/pr-cycle held for the ledger row.)
if [ -z "$WHAT" ] && [ -z "$WATCH" ]; then
    printf '%s**Merged %s: %s**%s\n\n(No /pr-ready digest — armed by triage sweep or no review pass run.)\n' \
        "${TOP:+$TOP$'\n\n'}" "$PR_REF" "$TITLE_T" "$BRANCH_LINE"
    exit 0
fi
# One label present and the other absent is a malformed-but-present digest: name the gap
# per field rather than discarding the half that parsed.
[ -n "$WHAT" ]  || WHAT='(missing)'
[ -n "$WATCH" ] || WATCH='(missing)'
printf '%s%s**Merged %s: %s**%s\n\n**What changed:** %s\n\n**Watch:** %s\n' \
    "${TOP:+$TOP$'\n\n'}" "${DANGER_LINE:+$DANGER_LINE$'\n'}" "$PR_REF" "$TITLE_T" "$BRANCH_LINE" \
    "$(_trunc "$WHAT_MAX" "$WHAT")" \
    "$(_trunc "$WATCH_MAX" "$WATCH")"
