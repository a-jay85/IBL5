# Fails every ref DELETE (-d, or a --stdin batch holding "delete"); the keep-ref
# creates the archive step issues still pass through.
cat > "$CD/gitwrap/git" <<SH
#!/usr/bin/env bash
upd=0; std=0
for a in "\$@"; do
    [ "\$a" = update-ref ] && upd=1
    [ "\$a" = -d ] && [ "\$upd" = 1 ] && exit 1
    [ "\$a" = --stdin ] && std=1
done
if [ "\$upd" = 1 ] && [ "\$std" = 1 ]; then
    in="\$(cat)"
    case "\$in" in *delete*) exit 1 ;; esac
    printf '%s\n' "\$in" | exec "$(command -v git)" "\$@"
fi
exec "$(command -v git)" "\$@"
SH
chmod +x "$CD/gitwrap/git"
rt "${R_ON[@]}" PATH="$CD/gitwrap:$STUBBIN:$PATH" -- --force
