#!/usr/bin/env bash
#
# bin/docfix-poll — Runnerless Mac poll for stale-docs auto-remediation (ADR-0086).
# Replaces the deleted `docfix` job in doc-freshness-audit.yml: GitHub schedules
# nothing on this Mac (no self-hosted runner is registered — the public-repo runner
# security constraint, stated in ADR-0086, makes that permanently unsafe). Instead,
# launchd drives this poller from the owner's Mac at 09:17 local daily.
#
# Install AFTER this PR lands on master: the launchd Program points at the MAIN
# checkout's copy of this file, so a pre-merge install silently runs a stale version.
#
# Usage:
#   bin/docfix-poll                    # nightly poll (run by launchd)
#   bin/docfix-poll --install-schedule   # install the 09:17 launchd job (post-merge)
#   bin/docfix-poll --uninstall-schedule # remove the launchd job (rollback)
#   bin/docfix-poll --print-schedule     # emit plist to stdout — test seam, no side effect
#   bin/docfix-poll --health-report [ISSUE_NUM]  # print 3 key=value lines; always exits 0
#   bin/docfix-poll -h                 # this help

set -euo pipefail

# --- launchd PATH supplement --------------------------------------------------
# launchd runs jobs with a minimal PATH (/usr/bin:/bin:/usr/sbin:/sbin), which has
# neither php (bin/check-docs is `#!/usr/bin/env php`) nor gh — so every scheduled
# run died at the first check-docs call with `env: php: No such file or directory`
# and exit 127, silently, from install (2026-07-16) until this fix. The dirs are the
# same set the plist in bin/docfix-run:90 already preludes for its spawned session —
# .bun/bin included, because the run chain reaches bin/wt-new's `bunx tailwindcss`
# CSS build, which is soft-guarded (falls back to copying main's style.css) but would
# otherwise degrade on every run.
#
# APPEND, never prepend: bin/test-docfix-run sandboxes this script by putting stub
# gh/git shims first on PATH. Prepending /opt/homebrew/bin would shadow those with
# the REAL gh and let the test suite hit the live repo.
export PATH="$PATH:/usr/local/bin:/opt/homebrew/bin:${HOME:-}/.bun/bin:${HOME:-}/.local/bin"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# --- MAIN checkout derivation (Divergence 1 from backups-sync-setup template) ---
# IBL5_MAIN lets bin/test-docfix-run sandbox this script without touching the real
# checkout. Falls back to the worktree-list awk (mirrors bin/docfix-run:31).
MAIN="${IBL5_MAIN:-}"
if [ -z "$MAIN" ]; then
    MAIN="$(git -C "$SCRIPT_DIR/.." worktree list --porcelain 2>/dev/null \
             | awk '/^worktree / {print $2; exit}')"
fi
[ -n "$MAIN" ] || MAIN="$(cd "$SCRIPT_DIR/.." && pwd)"

SCHEDULE_ACTION=""
HEALTH_ISSUE_ARG=""

while [ $# -gt 0 ]; do
    case "$1" in
        --install-schedule)   SCHEDULE_ACTION="install";   shift ;;
        --uninstall-schedule) SCHEDULE_ACTION="uninstall"; shift ;;
        --print-schedule)     SCHEDULE_ACTION="print";     shift ;;
        --health-report)      SCHEDULE_ACTION="health";    shift
                              [ $# -gt 0 ] && { HEALTH_ISSUE_ARG="$1"; shift; } || true ;;
        -h|--help) awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; exit 0 ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

# --- Schedule management (launchd) -------------------------------------------
PLIST_LABEL="com.ibl5.docfix-poll"
PLIST_PATH="$HOME/Library/LaunchAgents/${PLIST_LABEL}.plist"
PROGRAM="$MAIN/bin/docfix-poll"
LOG_DIR="$HOME/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/docfix-poll/logs"

# Single source of truth for the plist — shared by --print-schedule and
# --install-schedule, so the MAIN-checkout derivation is exercised by tests.
build_plist() {
    cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>${PLIST_LABEL}</string>
	<key>Program</key>
	<string>${PROGRAM}</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>17</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>${MAIN}</string>
	<key>StandardOutPath</key>
	<string>${LOG_DIR}/launchd-stdout.log</string>
	<key>StandardErrorPath</key>
	<string>${LOG_DIR}/launchd-stderr.log</string>
</dict>
</plist>
PLIST
}

if [ -n "$SCHEDULE_ACTION" ] && [ "$SCHEDULE_ACTION" != "health" ]; then
    case "$SCHEDULE_ACTION" in
        print)
            build_plist
            ;;
        install)
            # Fail-closed guard (Divergence 2): launchd accepts a plist whose Program
            # does not exist and then silently never runs it — the exact silent-failure
            # class that killed this pipeline the first time. Refuse rather than install
            # a job that can never fire, and name the fix.
            if [ ! -x "$PROGRAM" ]; then
                echo "FAILED: $PROGRAM is not an executable file." >&2
                echo "  The launchd job runs the MAIN checkout's copy, so merge this PR first:" >&2
                echo "    cd \"$MAIN\" && git pull && bin/docfix-poll --install-schedule" >&2
                exit 1
            fi
            mkdir -p "$HOME/Library/LaunchAgents" "$LOG_DIR"
            launchctl bootout "gui/$(id -u)/${PLIST_LABEL}" 2>/dev/null || true
            build_plist > "$PLIST_PATH"
            launchctl bootstrap "gui/$(id -u)" "$PLIST_PATH"
            if ! launchctl print "gui/$(id -u)/${PLIST_LABEL}" >/dev/null 2>&1; then
                echo "FAILED: ${PLIST_LABEL} did not load." >&2
                exit 1
            fi
            echo "Installed ${PLIST_LABEL} (daily 09:17 local). Program: $PROGRAM"
            ;;
        uninstall)
            launchctl bootout "gui/$(id -u)/${PLIST_LABEL}" 2>/dev/null || true
            rm -f "$PLIST_PATH"
            echo "Uninstalled ${PLIST_LABEL}."
            ;;
    esac
    exit 0
fi

# --- Shared helpers (poll and --health-report both use these) -----------------

iso_to_epoch() {
    # BSD (macOS) and GNU date disagree on the parsing flag; try both.
    date -u -d "$1" +%s 2>/dev/null || date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$1" +%s
}

# The ONE definition of "a human already declined a refresh covering these docs".
# Coverage, not equality: --fix-dates can make the PR touch more docs than the
# worklist, and if the stale set later grows beyond what was declined the pipeline
# resumes on its own.
uncovered_count() {   # $1 = path to a --staleness-report JSON file
    local declined
    declined="$(gh pr list --state closed --limit 20 --json headRefName,mergedAt,files \
      --jq '[.[] | select(.headRefName | startswith("docs-stale-refresh-"))
                 | select(.mergedAt == null)] | .[0].files // [] | map(.path)' 2>/dev/null || echo '[]')"
    jq -r --argjson d "$declined" '[.[].path] - $d | length' "$1"
}

# Seam for the `died` branch: shimmed in bin/test-docfix-run so the git ls-remote
# call is testable without hitting the network. Do NOT inline this call.
git_remote_refresh_branches() {
    git ls-remote --heads origin 'refs/heads/docs-stale-refresh-*' | sed 's#.*refs/heads/##'
}

# A branch on origin with NO PR of ANY state = a run that pushed and then died
# before opening one. NOT merely "a branch exists": nothing ever deletes a DECLINED
# PR's remote branch (bin/cleanup only READS origin/<branch> at :174 — GitHub's
# delete_branch_on_merge reaps the MERGED case, and there is no closed-unmerged
# equivalent), so a lingering branch is the normal residue of a decline. Keying on
# branch-existence alone would fire `died` forever on every later stale set.
# Verified against bin/cleanup 2026-07-15.
orphaned_refresh_branch() {   # echoes the first branch with no PR at all; empty if none
    local b
    while read -r b; do
        [ -z "$b" ] && continue
        if [ "$(gh pr list --state all --head "$b" --json number --jq 'length' 2>/dev/null || echo 1)" -eq 0 ]; then
            printf '%s' "$b"; return
        fi
    done < <(git_remote_refresh_branches)
}

# Age of a local branch in seconds, keyed on the reflog CREATION timestamp.
# THREE traps, all of which produce a plausible-looking wrong number:
#   1. git for-each-ref --format='%(creatordate:unix)' — a zero-commit branch points
#      at master's commit, so this returns MASTER's date, not the branch's age.
#   2. git log -g --format='%ct' — %ct is the COMMIT timestamp of the entry's commit,
#      not the reflog event timestamp. For a branch cut from an old commit it can be
#      years off.
#   3. head -1 — that is the NEWEST reflog entry. Creation is the OLDEST: tail -1.
# `git reflog show --date=unix` puts the event epoch in the @{...} field, e.g.
#   cbe4e1152 docs-stale-refresh-20260802@{1785687929}: branch: Created from master
branch_age_seconds() {   # $1 = branch name; echoes seconds; empty when unknown
    local epoch
    epoch="$(git -C "$MAIN" reflog show --date=unix "refs/heads/$1" 2>/dev/null \
             | tail -1 | sed -n 's/.*@{\([0-9][0-9]*\)}.*/\1/p')"
    [ -n "$epoch" ] || return 0
    echo $(( $(date -u +%s) - epoch ))
}

# Salvage a wedged docs-stale-refresh-* branch that died with uncommitted edits.
# Disposition (user-decided): commit → push to docs-stale-salvage-YYYYMMDD (not
# refresh-* so orphaned_refresh_branch never sees it) → cleanup original.
# If push fails: leave branch in place, return 1 (do not destroy the work).
# If the worktree is clean: reap directly. If there is no worktree: delete the ref.
# Echoes one line describing the outcome; caller uses it for --health-report detail.
#
# TRAP: the uncommitted edits live in the branch's WORKTREE, NOT in $MAIN. $MAIN sits
# on master and is normally clean, so `git -C "$MAIN" status --porcelain` reports
# "clean" for EVERY wedged branch and sends a dirty branch down the direct-reap arm,
# destroying exactly the work this function exists to preserve. Derive the worktree
# path from git; never assume the IBL5-worktrees/<slug> layout, and never let an empty
# derivation degrade into `git -C ""` (which silently means "cwd").
salvage_wedged_branch() {   # $1 = branch name
    local branch="$1"
    # Declared then assigned: `local x="$(cmd)"` is SC2155, and CI shellchecks bin/**
    # at --severity=warning as a REQUIRED check (.github/workflows/tests.yml:430).
    local salvage_branch
    salvage_branch="docs-stale-salvage-$(date +%Y%m%d)"
    local wt changed files
    wt="$(git -C "$MAIN" worktree list --porcelain \
          | awk -v b="refs/heads/$branch" '/^worktree /{p=$2} $0=="branch "b{print p; exit}')"

    if [ -z "$wt" ] || [ ! -d "$wt" ]; then
        # No worktree ⇒ nothing uncommitted can exist, and named-mode bin/cleanup
        # cannot run (bin/cleanup:695-704 → exit 1). Delete the ref directly, or the
        # branch deadlocks docfix-run's no-stacking guard forever. git refuses this
        # for a worktree-held branch, so it cannot reach a live run.
        if git -C "$MAIN" branch -D "$branch" >/dev/null 2>&1; then
            echo "Wedged branch '$branch' had no worktree; deleted the ref directly."
            return 0
        fi
        echo "Could not delete wedged branch '$branch' (no worktree) — leaving." >&2
        return 1
    fi

    changed="$(git -C "$wt" status --porcelain 2>/dev/null)"
    if [ -z "$changed" ]; then
        # Clean worktree — no uncommitted work to preserve, reap directly.
        if "$MAIN/bin/cleanup" "$branch" >/dev/null 2>&1; then
            echo "Wedged branch '$branch' was clean; reaped directly."
            return 0
        fi
        echo "Could not reap clean wedged branch '$branch' — leaving." >&2
        return 1
    fi

    # $NF, not $2: a rename line is `R  old -> new`, and $NF is the surviving path.
    files="$(git -C "$wt" status --porcelain | awk '{print $NF}' | paste -sd, -)"
    # Commit the uncommitted edits, clearly marked as unverified salvage.
    # Explicit `if !` on each step: a bare failing command under `set -e` would exit
    # the whole poll rather than return from this function.
    if ! git -C "$wt" add -A 2>/dev/null \
       || ! git -C "$wt" commit -q \
            -m "[SALVAGE: unverified] Uncommitted edits from died docfix run on $branch" \
            -m "Files: $files" \
            -m "These last_verified bumps were written by a run that died before committing." \
            -m "The run's verification may be incomplete. Review before merging." 2>/dev/null; then
        echo "COMMIT FAILED: could not commit salvage for '$branch' — leaving it in place. Files: $files" >&2
        return 1
    fi
    # Push to the salvage branch (not refresh-*, cannot become fire-forever residue).
    if git -C "$wt" push origin "HEAD:refs/heads/$salvage_branch" >/dev/null 2>&1; then
        "$MAIN/bin/cleanup" "$branch" >/dev/null 2>&1 \
            || echo "docfix-poll: salvage pushed but could not cleanup '$branch' — leaving." >&2
        echo "Salvaged uncommitted edits from '$branch' to '$salvage_branch' (files: $files). Review before merging. No PR was opened."
        return 0
    fi
    echo "PUSH FAILED: could not push salvage branch '$salvage_branch' — leaving '$branch' in place to avoid data loss. Files: $files" >&2
    # Undo the salvage commit to restore the worktree to its pre-commit state.
    git -C "$wt" reset --soft HEAD~1 2>/dev/null || true
    return 1
}

# Detects a local docs-stale-refresh-* branch with no origin ref, no PR, and age
# past the 4h threshold. Returns (echoes) the branch name if found, empty if none.
# This is the case orphaned_refresh_branch() cannot see (origin-only check).
# IMPORTANT: declined PRs also leave local branches but WITH an origin ref (bin/cleanup
# only reads origin/<branch>; GitHub delete_branch_on_merge covers MERGED; CLOSED
# has no auto-delete). A local branch WITH an origin ref → orphaned_refresh_branch()
# domain. Only local-only (no origin ref) → this function's domain.
wedged_local_refresh_branch() {   # echoes branch name or empty; always exits 0
    local b age_s on_origin pr_count
    while IFS= read -r b; do
        [ -n "$b" ] || continue
        # A loaded docfix-run job means the run is alive, not wedged — never alert.
        launchctl list 2>/dev/null | grep -q "com\.ibl5\.docfix-run-$b-" && continue
        # ASYMMETRY, deliberate (Design decision 8): an UNKNOWN age (expired reflog)
        # counts as wedged HERE, because this arm only sends a DM. The reaper treats the
        # same unknown as "leave alone". Alerting fails open; destroying fails closed.
        age_s="$(branch_age_seconds "$b")"
        [ -z "$age_s" ] || [ "$age_s" -gt 14400 ] || continue
        on_origin="$(git -C "$MAIN" ls-remote --heads origin "refs/heads/$b" 2>/dev/null)"
        [ -z "$on_origin" ] || continue
        # Any PR at all (open, merged, or closed) means this is not a pre-push wedge.
        # FAIL CLOSED on API failure: `|| echo 1` makes an unreachable API look like
        # "a PR exists", so a network blip yields no alert rather than a false one.
        pr_count="$(gh pr list --state all --head "$b" --json number --jq 'length' 2>/dev/null || echo 1)"
        [ "${pr_count:-1}" -eq 0 ] || continue
        printf '%s' "$b"; return
    done < <(git -C "$MAIN" branch --list 'docs-stale-refresh-*' --format='%(refname:short)')
}

# Epoch at which the CURRENT stale set was first filed. NOT the issue's createdAt:
# the audit keeps ONE long-lived `stale-docs` issue (workflow :77-103 — created only
# when none is open, EDITED when the signature changes, closed only at count 0), so
# createdAt marks the FIRST episode ever, possibly weeks stale. The audit rebuilds
# the body exactly when an episode starts, so a body marker carries the right
# timestamp. Fallback to createdAt covers the pre-existing issue whose body predates
# the marker: there the fallback is CORRECT — an old createdAt with no PR is a
# genuinely uninstalled poll, which is the bootstrap alert this plan needs on day one.
issue_episode_epoch() {   # $1 = issue number
    local since
    since="$(gh issue view "$1" --json body --jq .body 2>/dev/null | tr -d '\r' \
             | sed -n 's/.*<!-- stale-since: \(.*\) -->.*/\1/p' | head -1)"
    [ -z "$since" ] && since="$(gh issue view "$1" --json createdAt --jq .createdAt)"
    iso_to_epoch "$since"
}

# --- --health-report: is the refresh pipeline broken? -------------------------
# Emits three `key=value` lines on stdout (alert/kind/detail); always exits 0 —
# a report, not a gate, mirroring `check-docs --staleness-report`. The audit
# workflow appends them to $GITHUB_OUTPUT verbatim.
health_report() {
    local alert=false kind="" detail="" report count pr_json pr_num red orphan wedged age_h episode
    report="$(mktemp)"; trap 'rm -f "$report"' RETURN
    "$MAIN/bin/check-docs" --staleness-report > "$report" \
        || { printf 'alert=false\nkind=\ndetail=\n'; return 0; }
    count="$(jq 'length' "$report")"
    local issue_num="${1:-}"

    if [ "${count:-0}" -gt 0 ] && [ -n "$issue_num" ]; then
        # `|| var=""` on every bare gh assignment: set -e is live in this function
        # body, so an unguarded transient gh failure (rate limit, network) would
        # abort before the final printf — the exact silent-skip the guard above
        # exists to prevent. Fail-quiet, same contract as the check-docs guard.
        pr_json="$(gh pr list --state open --json number,headRefName,url \
          --jq '[.[] | select(.headRefName | startswith("docs-stale-refresh-"))] | .[0] // empty')" \
          || pr_json=""
        if [ -n "$pr_json" ]; then
            # An open PR is the DESIGNED steady state (auto_merge:false — the user
            # reviews it). Only a RED check is a failure; green/pending stay silent.
            pr_num="$(jq -r .number <<<"$pr_json")"
            red="$(gh pr view "$pr_num" --json statusCheckRollup \
              --jq '[.statusCheckRollup[]? | select(.conclusion == "FAILURE" or .conclusion == "TIMED_OUT"
                     or .conclusion == "CANCELLED" or .conclusion == "ACTION_REQUIRED")] | length')" \
              || red=""
            if [ "${red:-0}" -gt 0 ]; then
                alert=true; kind="ci-red"
                detail="Refresh PR $(jq -r .url <<<"$pr_json") has ${red} failing check(s) — the doc refresh needs a fix before you can merge it."
            fi
        elif [ "$(uncovered_count "$report")" -eq 0 ]; then
            : # a human declined a refresh covering these docs — stay quiet
        elif orphan="$(orphaned_refresh_branch)"; [ -n "$orphan" ]; then
            alert=true; kind="died"
            detail="Refresh branch ${orphan} is on origin with no PR — the doc-fix run died mid-flight. Log: ls -t /tmp/docfix-run-*.log | head -1"
        elif wedged="$(wedged_local_refresh_branch)"; [ -n "$wedged" ]; then
            alert=true; kind="wedged"
            detail="Local branch ${wedged} has no origin ref and no in-flight launchd run — the doc-fix run died before pushing. Next poll will salvage it automatically."
        else
            # gh dying inside issue_episode_epoch yields empty output, and an empty
            # arithmetic operand is a syntax error that kills the function. Fall back
            # to "now" (age 0 → no alert) — fail-quiet like every guard above.
            episode="$(issue_episode_epoch "$issue_num")" && [ -n "$episode" ] \
                || episode="$(date -u +%s)"
            age_h=$(( ( $(date -u +%s) - episode ) / 3600 ))
            if [ "$age_h" -ge 36 ]; then
                alert=true; kind="never-ran"
                detail="No refresh PR has been opened in ${age_h}h. The Mac poll is probably not installed: cd ~/GitHub/IBL5 && git pull && bin/docfix-poll --install-schedule"
            fi
        fi
    fi
    printf 'alert=%s\nkind=%s\ndetail=%s\n' "$alert" "$kind" "$detail"
}

if [ "$SCHEDULE_ACTION" = "health" ]; then
    health_report "${HEALTH_ISSUE_ARG:-}"
    exit 0
fi

# --- The poll -----------------------------------------------------------------
cd "$MAIN"

# --- Lingering-unarmed-PR DM --------------------------------------------------
# Send a once-per-PR DM for any open docfix PR that is not yet armed for
# auto-merge. An armed PR self-ships; a DM there would be noise.  We do this
# BEFORE the staleness check so it fires even on nights with no new stale docs,
# which are exactly the nights a lingering PR is most likely the only thing
# outstanding.  Fail-quiet on gh errors: a missed notification retries tomorrow.
if ! DM_PRS="$(gh pr list --state open --json number,headRefName,autoMergeRequest \
     --jq '.[] | select(.headRefName | startswith("docs-stale-refresh-"))
                | select(.autoMergeRequest == null) | .number' 2>/dev/null)"; then
    DM_PRS=""   # fail-quiet, like every guard in this script
fi

DM_MARKER_DIR="${LOG_DIR%/logs}/dm-sent"
mkdir -p "$DM_MARKER_DIR"

for PR_NUM in $DM_PRS; do
    if [ -e "$DM_MARKER_DIR/pr-$PR_NUM" ]; then
        continue
    fi
    if gh workflow run docs-refreshed-notify.yml -f pr_number="$PR_NUM" 2>/dev/null; then
        : > "$DM_MARKER_DIR/pr-$PR_NUM"
        echo "docfix-poll: DM dispatched for lingering unarmed PR #$PR_NUM."
    else
        echo "docfix-poll: DM dispatch failed for PR #$PR_NUM — will retry next poll." >&2
    fi
done

REPORT="$(mktemp)"
trap 'rm -f "$REPORT"' EXIT
"$MAIN/bin/check-docs" --staleness-report > "$REPORT"
COUNT="$(jq 'length' "$REPORT")"
SIG="$(jq -r '.[].path' "$REPORT" | sort -u | paste -sd, -)"
[ "$COUNT" -eq 0 ] && { echo "docfix-poll: no stale docs — nothing to do."; exit 0; }

# Reap leftovers whose PR is finished (merged or declined). An OPEN PR's branch
# stays: it is waiting on the user's review, which is the designed steady state.
while IFS= read -r branch; do
    [ -n "$branch" ] || continue
    # Defect 6: launchctl interlock — if a docfix-run launchd job is still loaded,
    # cleanup would kill a live run. Skip until the job self-removes on completion.
    if launchctl list 2>/dev/null | grep -q "com\.ibl5\.docfix-run-$branch-"; then
        echo "docfix-poll: leaving '$branch' — docfix-run job still loaded (in flight)."
        continue
    fi

    # Defect 5: fail-closed probe. gh pr list exits non-zero when the API is
    # unreachable (empty stdout + exit 1), unlike `gh pr view ... || true` (always
    # exits 0). jq classifies by liveness priority: OPEN > MERGED > CLOSED, so a
    # branch with both an OPEN and a MERGED PR is treated as still-open (not safe
    # to reap), and a branch with no PRs is classified as NONE.
    if ! state="$(gh pr list --head "$branch" --state all --json state --jq \
           '[.[].state] as $s | if ($s|length)==0 then "NONE"
            elif ($s|index("OPEN")) then "OPEN"
            elif ($s|index("MERGED")) then "MERGED" else "CLOSED" end' \
           2>/dev/null)"; then
        echo "docfix-poll: gh API unreachable — leaving '$branch' untouched (fail closed)." >&2
        continue
    fi

    case "$state" in
        MERGED|CLOSED)
            "$MAIN/bin/cleanup" "$branch" \
                && echo "docfix-poll: reaped '$branch' (PR $state)." \
                || echo "docfix-poll: could not reap '$branch' — leaving it." >&2 ;;
        OPEN)
            echo "docfix-poll: leaving '$branch' (open PR, awaiting human review)." ;;
        NONE)
            # No PR at all. Distinguish a WEDGED branch (local-only, past the age
            # threshold) from a run that is genuinely in flight and has not pushed yet.
            # Do NOT relax docfix-run's no-stacking guard — fix on the reaper side.
            #
            # NOTE: no `local` here. This loop is at TOP-LEVEL script scope
            # (health_report() closes above it), and `local` outside a function is a
            # hard bash error — under `set -euo pipefail` it aborts the entire poll on
            # every run. Verified: `bash -c 'set -e; local x=1'` →
            # "local: can only be used in a function".
            age_s="$(branch_age_seconds "$branch")"
            on_origin="$(git -C "$MAIN" ls-remote --heads origin "refs/heads/$branch" 2>/dev/null)"
            if [ -n "$on_origin" ]; then on_origin_msg="yes"; else on_origin_msg="no"; fi
            if [ -z "$age_s" ]; then
                # Age UNKNOWN (reflog expired — git gc prunes at 90 days). Do not guess
                # and do NOT fail open toward reaping: leave the branch and let the
                # `wedged` health arm (Phase 3) surface it for a human.
                echo "docfix-poll: leaving '$branch' — reflog age unavailable; see --health-report." >&2
            elif [ "$age_s" -gt 14400 ] && [ -z "$on_origin" ]; then
                # Local-only, no PR, older than 4h — wedged, not in flight. Runs start
                # at 09:17 EDT and finish in <60 min; the inter-poll gap is ~24h, so 4h
                # is safely above the in-flight window and safely below the gap.
                echo "docfix-poll: wedged branch '$branch' detected (age ${age_s}s, no origin ref, no PR). Salvaging."
                salvage_wedged_branch "$branch" \
                    || echo "docfix-poll: salvage failed for '$branch' — left in place." >&2
            else
                echo "docfix-poll: leaving '$branch' (no PR, age ${age_s}s, origin ref: $on_origin_msg)."
            fi
            ;;
    esac
done < <(git -C "$MAIN" branch --list 'docs-stale-refresh-*' --format='%(refname:short)')

# Did a human already decline a refresh COVERING this exact stale set?
UNCOVERED="$(uncovered_count "$REPORT")"
if [ "$UNCOVERED" -eq 0 ]; then
    echo "docfix-poll: a human declined a refresh covering all $COUNT stale doc(s) — staying quiet."
    exit 0
fi

ISSUE_NUM="$(gh issue list --label stale-docs --state open --json number \
              --jq '.[0].number // empty')"
if [ -z "$ISSUE_NUM" ]; then
    echo "docfix-poll: $COUNT stale doc(s) but no open stale-docs issue — the audit owns issue creation; skipping."
    exit 0
fi

echo "docfix-poll: $COUNT stale doc(s), issue #$ISSUE_NUM — firing bin/docfix-run."
"$MAIN/bin/docfix-run" "$ISSUE_NUM" "$SIG"   # no `exec`: it would skip the EXIT trap
