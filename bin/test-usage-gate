test_decide_blind_resets_unparseable_allows() {
    local out
    blind_setup 95 0 "" ""
    out=$(IBL5_USAGE_GATE_RUNNER=plan-now IBL5_USAGE_GATE_RESUME_BIN="$RBIN" decide $SID_A)
    assert_eq decide_blind_unparse:missing:out "" "$out"
    assert_no_file decide_blind_unparse:missing:no-marker "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
    seed_cache "$(( $(date +%s) - 600 ))" "$(usage_json_resets 95 0 "" "" | jq -c '.five_hour.resets_at="not-a-date"')"
    out=$(IBL5_USAGE_GATE_RUNNER=plan-now IBL5_USAGE_GATE_RESUME_BIN="$RBIN" decide $SID_A)
    assert_eq decide_blind_unparse:garbage:out "" "$out"
    assert_no_file decide_blind_unparse:garbage:no-marker "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
}

test_decide_blind_seven_day_window() {
    local FUT PAST out
    FUT=$(( $(date +%s) + 3600 ))
    PAST=$(( $(date +%s) - 60 ))
    blind_setup 10 96 "$FUT" "$FUT"
    out=$(IBL5_USAGE_GATE_RUNNER=plan-now IBL5_USAGE_GATE_RESUME_BIN="$RBIN" decide $SID_A)
    assert_eq decide_blind_week:future:out "$PAUSE_JSON" "$out"
    assert_file decide_blind_week:future:marker "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
    assert_eq decide_blind_week:future:window seven_day "$(jq -r .window "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json" 2>/dev/null)"
    blind_setup 10 96 "$FUT" "$PAST"
    out=$(IBL5_USAGE_GATE_RUNNER=plan-now IBL5_USAGE_GATE_RESUME_BIN="$RBIN" decide $SID_A)
    assert_eq decide_blind_week:past:out "" "$out"
