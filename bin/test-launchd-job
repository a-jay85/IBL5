#!/usr/bin/env bash
# bin/test-launchd-job — unit tests for bin/lib/launchd-job.sh
#
# Usage: bin/test-launchd-job
#
# Self-contained: creates a temp dir, builds stub binaries, never touches
# ~/Library/LaunchAgents.  Runs on macOS and Linux CI.

set -uo pipefail
# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"
H_FAIL_FD=2  # FAIL: lines stay on stderr, as before migration

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
LIB="$SCRIPT_DIR/lib/launchd-job.sh"

[[ -f "$LIB" ]] || { printf 'FATAL: %s: No such file\n' "$LIB" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Temp dir — asserted to be under $T to guard against real LaunchAgents writes
# ---------------------------------------------------------------------------
T="$(mktemp -d)"
export T
_cleanup() { rm -rf "$T"; h_cleanup; }
trap _cleanup EXIT
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/usage-test-isolation.sh"; usage_test_isolate "$T/usage"

# Verify HOME never points outside T (safety assertion enforced per case below)

# ---------------------------------------------------------------------------
# Resolve real paths for the minimal-PATH shim dir before we alter PATH
# ---------------------------------------------------------------------------
_REAL_GREP="$(command -v grep)"
_REAL_SED="$(command -v sed)"
_REAL_RM="$(command -v rm)"
_REAL_MV="$(command -v mv)"
_REAL_MKTEMP="$(command -v mktemp)"
_REAL_BASENAME="$(command -v basename)"
_REAL_DIRNAME="$(command -v dirname)"
_REAL_CAT="$(command -v cat)"
_REAL_ID="$(command -v id)"
_REAL_PRINTF="$(command -v printf 2>/dev/null || true)"

# ---------------------------------------------------------------------------
# Shim dir — stubs for launchctl, pgrep, pkill, sleep, id
# ---------------------------------------------------------------------------
mkdir -p "$T/shim" "$T/min" "$T/ctl" "$T/home/Library/LaunchAgents"

# launchctl stub
cat > "$T/shim/launchctl" <<'STUB'
#!/bin/bash
echo "launchctl $*" >> "${T}/ctl/launchctl_calls"
subcommand="${1:-}"
case "$subcommand" in
    list)
        out_file="${T}/ctl/launchctl_list_output"
        [ -f "$out_file" ] && cat "$out_file"
        rc_file="${T}/ctl/launchctl_list_rc"
        ;;
    bootstrap)
        rc_file="${T}/ctl/launchctl_bootstrap_rc"
        ;;
    bootout)
        rc_file="${T}/ctl/launchctl_bootout_rc"
        ;;
    submit)
        rc_file="${T}/ctl/launchctl_submit_rc"
        ;;
    remove)
        rc_file="${T}/ctl/launchctl_remove_rc"
        ;;
    *)
        rc_file=""
        ;;
esac
[ -n "${rc_file:-}" ] && [ -f "${rc_file:-}" ] && exit "$(cat "$rc_file")"
exit 0
STUB
chmod +x "$T/shim/launchctl"

# pgrep stub — exit code driven by $T/ctl/pgrep_rc (one exit code per line,
# consumed in call order).  Default exit code: 1 (no match).
cat > "$T/shim/pgrep" <<'STUB'
#!/bin/bash
echo "pgrep $*" >> "${T}/ctl/pgrep_calls"
count_file="${T}/ctl/pgrep_call_count"
count=$(($(cat "$count_file" 2>/dev/null || echo 0) + 1))
printf '%s\n' "$count" > "$count_file"
rc_file="${T}/ctl/pgrep_rc"
rc=$(sed -n "${count}p" "$rc_file" 2>/dev/null)
exit "${rc:-1}"
STUB
chmod +x "$T/shim/pgrep"

# pkill stub — records calls, always succeeds
cat > "$T/shim/pkill" <<'STUB'
#!/bin/bash
echo "pkill $*" >> "${T}/ctl/pkill_calls"
exit 0
STUB
chmod +x "$T/shim/pkill"

# sleep stub — records calls, no-op
cat > "$T/shim/sleep" <<'STUB'
#!/bin/bash
echo "sleep $*" >> "${T}/ctl/sleep_calls"
exit 0
STUB
chmod +x "$T/shim/sleep"

# id stub — returns fixed UID 12345
cat > "$T/shim/id" <<'STUB'
#!/bin/bash
if [ "${1:-}" = "-u" ]; then
    printf '12345\n'
else
    printf 'uid=12345(test) gid=12345(test)\n'
fi
STUB
chmod +x "$T/shim/id"

# ---------------------------------------------------------------------------
# Minimal PATH shim dir — only basic tools, no pgrep/launchctl
# ---------------------------------------------------------------------------
for _bin in grep sed rm mv mktemp basename dirname cat; do
    _real="$(command -v "$_bin")"
    ln -sf "$_real" "$T/min/$_bin"
done
ln -sf "$T/shim/id" "$T/min/id"

# Full shim PATH (has launchctl, pgrep, pkill, sleep, id stubs + system tools)
SHIM_PATH="$T/shim:/usr/bin:/bin:/usr/sbin:/sbin"
# Minimal PATH (no pgrep, no launchctl)
MIN_PATH="$T/min:/usr/bin:/bin:/usr/sbin:/sbin"

# ---------------------------------------------------------------------------
# Test framework
# ---------------------------------------------------------------------------
pass() { h_pass "$1"; }
fail() { h_fail "$1: $2"; }

# reset_ctl — clear per-test control state
reset_ctl() {
    rm -rf "$T/ctl"
    mkdir -p "$T/ctl"
    # Reset pgrep call counter
    printf '0\n' > "$T/ctl/pgrep_call_count"
}

# ---------------------------------------------------------------------------
# Helper: source the lib into a subshell and run a test body.
# Each test must be in a subshell so set/shopt changes don't bleed.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Case: snapshot_no_launchctl
# No launchctl on PATH, under set -e: ljob_snapshot returns rc 0 and prints nothing.
# ---------------------------------------------------------------------------
reset_ctl
OUT="$(
    HOME="$T/home"
    # shellcheck disable=SC2123
    PATH="$T/min"
    set -e
    # shellcheck source=/dev/null
    . "$LIB"
    ljob_snapshot
)"
RC=$?
if [[ $RC -eq 0 && -z "$OUT" ]]; then
    pass "snapshot_no_launchctl"
else
    fail "snapshot_no_launchctl" "rc=$RC output='$OUT'"
fi

# ---------------------------------------------------------------------------
# Case: listed_large_snapshot_pipefail
# stub launchctl prints 50000 lines with com.ibl5.t-7 on line 10;
# under set -o pipefail, ljob_listed matches and returns 0.
# ---------------------------------------------------------------------------
reset_ctl
{
    for i in $(seq 1 9);     do printf 'line%s\n' "$i"; done
    printf 'com.ibl5.t-7\n'
    for i in $(seq 11 50000); do printf 'line%s\n' "$i"; done
} > "$T/ctl/launchctl_list_output"

OUT="$(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    set -o pipefail
    . "$LIB"
    SNAP="$(ljob_snapshot)"
    ljob_listed 'com\.ibl5\.t-7$' "$SNAP" && echo "matched"
)"
RC=$?
if [[ $RC -eq 0 ]] && grep -qF "matched" <<< "$OUT"; then
    pass "listed_large_snapshot_pipefail"
else
    fail "listed_large_snapshot_pipefail" "rc=$RC out='$OUT'"
fi

# ---------------------------------------------------------------------------
# Case: listed_anchor
# snapshot contains only com.ibl5.t-1892; anchored ERE com\.ibl5\.t-189$ returns 1.
# ---------------------------------------------------------------------------
reset_ctl
RC=0
(
    HOME="$T/home"
    PATH="$MIN_PATH"
    . "$LIB"
    SNAP="com.ibl5.t-1892"
    ljob_listed 'com\.ibl5\.t-189$' "$SNAP"
) && RC=0 || RC=$?
if [[ $RC -ne 0 ]]; then
    pass "listed_anchor"
else
    fail "listed_anchor" "expected nonzero, got $RC"
fi

# ---------------------------------------------------------------------------
# Case: alive_missing_pgrep
# No pgrep on PATH; ljob_pgrep_alive returns 0 (alive/undecidable).
# ---------------------------------------------------------------------------
reset_ctl
RC=99
(
    HOME="$T/home"
    # shellcheck disable=SC2123
    PATH="$T/min"
    . "$LIB"
    ljob_pgrep_alive "some-pattern"
)
RC=$?
if [[ $RC -eq 0 ]]; then
    pass "alive_missing_pgrep"
else
    fail "alive_missing_pgrep" "expected 0, got $RC"
fi

# ---------------------------------------------------------------------------
# Case: alive_no_match_dead
# stub pgrep exits 1 for every pattern; ljob_pgrep_alive returns 1 (dead).
# ---------------------------------------------------------------------------
reset_ctl
printf '1\n1\n' > "$T/ctl/pgrep_rc"
RC=0
(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    . "$LIB"
    ljob_pgrep_alive "pat-a" "pat-b"
)
RC=$?
if [[ $RC -eq 1 ]]; then
    pass "alive_no_match_dead"
else
    fail "alive_no_match_dead" "expected 1, got $RC"
fi

# ---------------------------------------------------------------------------
# Case: alive_error_is_alive
# stub pgrep exits 2; ljob_pgrep_alive returns 0 (alive/undecidable).
# ---------------------------------------------------------------------------
reset_ctl
printf '2\n' > "$T/ctl/pgrep_rc"
RC=99
(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    . "$LIB"
    ljob_pgrep_alive "pat-a"
)
RC=$?
if [[ $RC -eq 0 ]]; then
    pass "alive_error_is_alive"
else
    fail "alive_error_is_alive" "expected 0, got $RC"
fi

# ---------------------------------------------------------------------------
# Case: alive_second_pattern
# first pgrep exits 1, second exits 0; returns 0.
# ---------------------------------------------------------------------------
reset_ctl
printf '1\n0\n' > "$T/ctl/pgrep_rc"
RC=99
(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    . "$LIB"
    ljob_pgrep_alive "pat-dead" "pat-alive"
)
RC=$?
if [[ $RC -eq 0 ]]; then
    pass "alive_second_pattern"
else
    fail "alive_second_pattern" "expected 0, got $RC"
fi

# ---------------------------------------------------------------------------
# Case: reap_keeps_loaded_label
# plist on disk, launchctl list exits 0 (label loaded); plist survives, no output.
# ---------------------------------------------------------------------------
reset_ctl
PLIST_DIR="$T/home/Library/LaunchAgents"
mkdir -p "$PLIST_DIR"
touch "$PLIST_DIR/com.ibl5.test-42.plist"
printf '0\n' > "$T/ctl/launchctl_list_rc"

OUT="$(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    . "$LIB"
    always_dead() { return 1; }
    ljob_reap_stale "com.ibl5.test-" "always_dead"
)"
if [[ -f "$PLIST_DIR/com.ibl5.test-42.plist" && -z "$OUT" ]]; then
    pass "reap_keeps_loaded_label"
else
    fail "reap_keeps_loaded_label" "plist_exists=$([ -f "$PLIST_DIR/com.ibl5.test-42.plist" ] && echo y || echo n) out='$OUT'"
fi
rm -f "$PLIST_DIR/com.ibl5.test-42.plist"

# ---------------------------------------------------------------------------
# Case: reap_keeps_live_process
# label not loaded (list rc 1), alive_fn returns 0; plist survives.
# ---------------------------------------------------------------------------
reset_ctl
touch "$PLIST_DIR/com.ibl5.test-42.plist"
printf '1\n' > "$T/ctl/launchctl_list_rc"

OUT="$(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    . "$LIB"
    always_alive() { return 0; }
    ljob_reap_stale "com.ibl5.test-" "always_alive"
)"
if [[ -f "$PLIST_DIR/com.ibl5.test-42.plist" && -z "$OUT" ]]; then
    pass "reap_keeps_live_process"
else
    fail "reap_keeps_live_process" "plist_exists=$([ -f "$PLIST_DIR/com.ibl5.test-42.plist" ] && echo y || echo n) out='$OUT'"
fi
rm -f "$PLIST_DIR/com.ibl5.test-42.plist"

# ---------------------------------------------------------------------------
# Case: reap_removes_dead
# label not loaded, alive_fn returns 1; plist removed, stdout="reaped stale slot <label>", rc 0.
# ---------------------------------------------------------------------------
reset_ctl
touch "$PLIST_DIR/com.ibl5.test-42.plist"
printf '1\n' > "$T/ctl/launchctl_list_rc"

OUT="$(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    set -e
    . "$LIB"
    always_dead() { return 1; }
    ljob_reap_stale "com.ibl5.test-" "always_dead"
)"
RC=$?
WANT_OUT="reaped stale slot com.ibl5.test-42"
if [[ $RC -eq 0 && ! -f "$PLIST_DIR/com.ibl5.test-42.plist" && "$OUT" == "$WANT_OUT" ]]; then
    pass "reap_removes_dead"
else
    fail "reap_removes_dead" "rc=$RC plist=$([ -f "$PLIST_DIR/com.ibl5.test-42.plist" ] && echo exists || echo gone) out='$OUT'"
fi

# ---------------------------------------------------------------------------
# Case: reap_prefix_scoped
# A plist with a different prefix is left untouched.
# ---------------------------------------------------------------------------
reset_ctl
touch "$PLIST_DIR/com.ibl5.other-99.plist"
printf '1\n' > "$T/ctl/launchctl_list_rc"

(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    . "$LIB"
    always_dead() { return 1; }
    ljob_reap_stale "com.ibl5.test-" "always_dead"
) >/dev/null 2>&1
if [[ -f "$PLIST_DIR/com.ibl5.other-99.plist" ]]; then
    pass "reap_prefix_scoped"
else
    fail "reap_prefix_scoped" "other-prefix plist was unexpectedly removed"
fi
rm -f "$PLIST_DIR/com.ibl5.other-99.plist"

# ---------------------------------------------------------------------------
# Case: count_plists_empty_and_two
# 0 with empty dir; 2 with two matching plists + one non-matching.
# ---------------------------------------------------------------------------
reset_ctl
# Remove any residual plists
rm -f "$PLIST_DIR"/*.plist

COUNT_EMPTY="$(
    HOME="$T/home"
    PATH="$MIN_PATH"
    . "$LIB"
    ljob_count_plists "com.ibl5.test-"
)"
touch "$PLIST_DIR/com.ibl5.test-1.plist"
touch "$PLIST_DIR/com.ibl5.test-2.plist"
touch "$PLIST_DIR/com.ibl5.other-3.plist"

COUNT_TWO="$(
    HOME="$T/home"
    PATH="$MIN_PATH"
    . "$LIB"
    ljob_count_plists "com.ibl5.test-"
)"
rm -f "$PLIST_DIR"/com.ibl5.test-1.plist "$PLIST_DIR"/com.ibl5.test-2.plist "$PLIST_DIR"/com.ibl5.other-3.plist

if [[ "$COUNT_EMPTY" -eq 0 && "$COUNT_TWO" -eq 2 ]]; then
    pass "count_plists_empty_and_two"
else
    fail "count_plists_empty_and_two" "empty=$COUNT_EMPTY two=$COUNT_TWO"
fi

# ---------------------------------------------------------------------------
# Case: write_runner_plist_golden
# Output equals fixture copied verbatim from fleet's heredoc with fixed inputs.
# ---------------------------------------------------------------------------
reset_ctl
GOLDEN_HOME="/test-home"
GOLDEN_LABEL="com.ibl5.post-plan-fleet-42"
GOLDEN_RUNNER="/tmp/post-plan-fleet-runner-42.sh"
GOLDEN_ROOT="/test/root"
GOLDEN_LOG="/tmp/post-plan-fleet-42.log"
GOLDEN_PLIST="$T/golden.plist"

(
    HOME="$GOLDEN_HOME"
    PATH="$MIN_PATH"
    . "$LIB"
    ljob_write_runner_plist "$GOLDEN_PLIST" "$GOLDEN_LABEL" "$GOLDEN_RUNNER" "$GOLDEN_ROOT" "$GOLDEN_LOG"
)

EXPECTED_PLIST="$T/expected.plist"
cat > "$EXPECTED_PLIST" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>${GOLDEN_LABEL}</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>-lc</string><string>exec ${GOLDEN_RUNNER}</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>WorkingDirectory</key><string>${GOLDEN_ROOT}</string>
  <key>StandardOutPath</key><string>${GOLDEN_LOG}</string>
  <key>StandardErrorPath</key><string>${GOLDEN_LOG}</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:${GOLDEN_HOME}/.bun/bin:${GOLDEN_HOME}/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict></plist>
PLIST_EOF

if diff -q "$GOLDEN_PLIST" "$EXPECTED_PLIST" >/dev/null 2>&1; then
    # plutil lint if available
    if command -v plutil >/dev/null 2>&1; then
        if plutil -lint "$GOLDEN_PLIST" >/dev/null 2>&1; then
            pass "write_runner_plist_golden"
        else
            fail "write_runner_plist_golden" "plutil -lint failed"
        fi
    else
        pass "write_runner_plist_golden"
    fi
else
    fail "write_runner_plist_golden" "plist mismatch:$(diff "$GOLDEN_PLIST" "$EXPECTED_PLIST")"
fi

# ---------------------------------------------------------------------------
# Case: bootstrap_order_and_rc
# recorder shows bootout gui/12345/<label> then bootstrap gui/12345 <plist>;
# bootout exiting 5 is ignored; bootstrap exiting 5 propagates.
# ---------------------------------------------------------------------------
reset_ctl
TEST_PLIST="$T/test.plist"
touch "$TEST_PLIST"
printf '5\n' > "$T/ctl/launchctl_bootout_rc"
printf '5\n' > "$T/ctl/launchctl_bootstrap_rc"

RC=0
(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    . "$LIB"
    ljob_bootstrap "com.ibl5.test-99" "$TEST_PLIST"
)
RC=$?

CALLS="$(cat "$T/ctl/launchctl_calls" 2>/dev/null || true)"
BOOTOUT_LINE="launchctl bootout gui/12345/com.ibl5.test-99"
BOOTSTRAP_LINE="launchctl bootstrap gui/12345 $TEST_PLIST"

# Check order: bootout first, bootstrap second
LINE1="$(sed -n '1p' "$T/ctl/launchctl_calls" 2>/dev/null || true)"
LINE2="$(sed -n '2p' "$T/ctl/launchctl_calls" 2>/dev/null || true)"

if [[ $RC -eq 5 && "$LINE1" == "$BOOTOUT_LINE" && "$LINE2" == "$BOOTSTRAP_LINE" ]]; then
    pass "bootstrap_order_and_rc"
else
    fail "bootstrap_order_and_rc" "rc=$RC line1='$LINE1' line2='$LINE2'"
fi

# ---------------------------------------------------------------------------
# Case: kill_label_order
# pkill recorder: -TERM A, -TERM B, -KILL A, -KILL B; preceded by one bootout.
# alive_fn returns dead (1) immediately so no sleep-1 iterations.
# ---------------------------------------------------------------------------
reset_ctl

(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    . "$LIB"
    always_dead() { return 1; }
    ljob_kill_label "com.ibl5.test-1" "always_dead" "pat-A" "pat-B"
) >/dev/null 2>&1

LC_LINE1="$(sed -n '1p' "$T/ctl/launchctl_calls" 2>/dev/null || true)"
PK1="$(sed -n '1p' "$T/ctl/pkill_calls" 2>/dev/null || true)"
PK2="$(sed -n '2p' "$T/ctl/pkill_calls" 2>/dev/null || true)"
PK3="$(sed -n '3p' "$T/ctl/pkill_calls" 2>/dev/null || true)"
PK4="$(sed -n '4p' "$T/ctl/pkill_calls" 2>/dev/null || true)"

if [[ "$LC_LINE1" == "launchctl bootout gui/12345/com.ibl5.test-1" \
   && "$PK1" == "pkill -TERM -f pat-A" \
   && "$PK2" == "pkill -TERM -f pat-B" \
   && "$PK3" == "pkill -KILL -f pat-A" \
   && "$PK4" == "pkill -KILL -f pat-B" ]]; then
    pass "kill_label_order"
else
    fail "kill_label_order" "lc='$LC_LINE1' pk1='$PK1' pk2='$PK2' pk3='$PK3' pk4='$PK4'"
fi

# ---------------------------------------------------------------------------
# Case: kill_label_survivor
# alive_fn always returns 0; ljob_kill_label returns 1 after exactly 5 wait
# iterations (sleep recorder count: 1 sleep 2 + 5 sleep 1 = 6 total).
# ---------------------------------------------------------------------------
reset_ctl

RC=0
(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    . "$LIB"
    always_alive() { return 0; }
    ljob_kill_label "com.ibl5.test-1" "always_alive" "pat-A"
)
RC=$?

SLEEP_COUNT="$(wc -l < "$T/ctl/sleep_calls" 2>/dev/null | tr -d ' ')"

if [[ $RC -eq 1 && "$SLEEP_COUNT" -eq 6 ]]; then
    pass "kill_label_survivor"
else
    fail "kill_label_survivor" "rc=$RC sleep_count=$SLEEP_COUNT (want rc=1 count=6)"
fi

# ---------------------------------------------------------------------------
# Case: release_slot_preserves_log
# log -> log.aborted; plist gone; scratch files removed; .aborted survives.
# ---------------------------------------------------------------------------
reset_ctl
REL_DIR="$T/release"
mkdir -p "$REL_DIR"
REL_PLIST="$REL_DIR/rel.plist"
REL_LOG="$REL_DIR/rel.log"
REL_SCRATCH1="$REL_DIR/rel.scratch1"
REL_SCRATCH2="$REL_DIR/rel.scratch2"

touch "$REL_PLIST" "$REL_LOG" "$REL_SCRATCH1" "$REL_SCRATCH2"

(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    . "$LIB"
    ljob_release_slot "$REL_PLIST" "$REL_LOG" "$REL_DIR/rel.*"
)

PLIST_GONE=0; [[ ! -f "$REL_PLIST" ]]      && PLIST_GONE=1
LOG_GONE=0;   [[ ! -f "$REL_LOG" ]]        && LOG_GONE=1
S1_GONE=0;    [[ ! -f "$REL_SCRATCH1" ]]   && S1_GONE=1
S2_GONE=0;    [[ ! -f "$REL_SCRATCH2" ]]   && S2_GONE=1
ABORTED=0;    [[ -f "${REL_LOG}.aborted" ]] && ABORTED=1

if [[ $PLIST_GONE -eq 1 && $LOG_GONE -eq 1 && $S1_GONE -eq 1 && $S2_GONE -eq 1 && $ABORTED -eq 1 ]]; then
    pass "release_slot_preserves_log"
else
    fail "release_slot_preserves_log" \
        "plist_gone=$PLIST_GONE log_gone=$LOG_GONE s1_gone=$S1_GONE s2_gone=$S2_GONE aborted=$ABORTED"
fi

# ---------------------------------------------------------------------------
# Case: wait_for_slot_dry_exits
# count_fn returns 3, jobs=3, FAKE_DRY=1 → subshell exits 0, stderr names FAKE_DRY.
# ---------------------------------------------------------------------------
reset_ctl
STDERR_OUT="$T/wait_stderr"

(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    FAKE_DRY=1
    export FAKE_DRY
    . "$LIB"
    my_count() { printf '3\n'; }
    my_reap()  { :; }
    ljob_wait_for_slot "my_count" "my_reap" 3 7200 "FAKE_DRY"
) 2>"$STDERR_OUT"
RC=$?

STDERR_CONTENT="$(cat "$STDERR_OUT" 2>/dev/null || true)"
if [[ $RC -eq 0 ]] && grep -qF "FAKE_DRY" "$STDERR_OUT"; then
    pass "wait_for_slot_dry_exits"
else
    fail "wait_for_slot_dry_exits" "rc=$RC stderr='$STDERR_CONTENT'"
fi

# ---------------------------------------------------------------------------
# Case: dm_helpers_standalone
# Three sub-cases run via env -i /bin/bash with declare -f injected.
# ---------------------------------------------------------------------------
reset_ctl

# Sub-case 1: NOTIFY=1, DISCORD_DM=<failing stub> → prints UNDELIVERED line.
FAILING_DM="$T/ctl/failing_dm"
printf '#!/bin/bash\nexit 1\n' > "$FAILING_DM"
chmod +x "$FAILING_DM"

DM_OUT1="$(env -i IBL5_USAGE_GATE_STATE_DIR="$IBL5_USAGE_GATE_STATE_DIR" IBL5_USAGE_CLAUDE_PROJECTS="$IBL5_USAGE_CLAUDE_PROJECTS" IBL5_USAGE_GATE_TEST_MODE="$IBL5_USAGE_GATE_TEST_MODE" HOME="$T/home" /bin/bash -c "
$(declare -f ljob_dm_ready ljob_dm_send 2>/dev/null || (. "$LIB" && declare -f ljob_dm_ready ljob_dm_send))
NOTIFY=1
DISCORD_DM='$FAILING_DM'
ljob_dm_ready mytool && ljob_dm_send mytool 'hello'
" 2>&1)"

# Sub-case 2: NOTIFY=0 → ljob_dm_ready returns 1 silently (no output)
DM_OUT2="$(env -i IBL5_USAGE_GATE_STATE_DIR="$IBL5_USAGE_GATE_STATE_DIR" IBL5_USAGE_CLAUDE_PROJECTS="$IBL5_USAGE_CLAUDE_PROJECTS" IBL5_USAGE_GATE_TEST_MODE="$IBL5_USAGE_GATE_TEST_MODE" HOME="$T/home" /bin/bash -c "
$(. "$LIB" && declare -f ljob_dm_ready)
NOTIFY=0
DISCORD_DM='$FAILING_DM'
ljob_dm_ready mytool && echo SHOULD_NOT_PRINT
" 2>&1)"

# Sub-case 3: NOTIFY=1 but DISCORD_DM is not executable → prints "no executable discord-dm" line
NON_EXEC_DM="$T/ctl/non_exec_dm"
printf 'not executable\n' > "$NON_EXEC_DM"
# do NOT chmod +x

DM_OUT3="$(env -i IBL5_USAGE_GATE_STATE_DIR="$IBL5_USAGE_GATE_STATE_DIR" IBL5_USAGE_CLAUDE_PROJECTS="$IBL5_USAGE_CLAUDE_PROJECTS" IBL5_USAGE_GATE_TEST_MODE="$IBL5_USAGE_GATE_TEST_MODE" HOME="$T/home" /bin/bash -c "
$(. "$LIB" && declare -f ljob_dm_ready)
NOTIFY=1
DISCORD_DM='$NON_EXEC_DM'
ljob_dm_ready mytool
" 2>&1)"

DM_OK=1
[[ "$DM_OUT1" == *"DM UNDELIVERED"* ]]              || { DM_OK=0; fail "dm_helpers_standalone" "sub1 UNDELIVERED not in output: '$DM_OUT1'"; }
[[ -z "$DM_OUT2" ]]                                  || { DM_OK=0; fail "dm_helpers_standalone" "sub2 should be silent, got: '$DM_OUT2'"; }
[[ "$DM_OUT3" == *"no executable discord-dm"* ]]     || { DM_OK=0; fail "dm_helpers_standalone" "sub3 no-exec line not in output: '$DM_OUT3'"; }
[[ $DM_OK -eq 1 ]] && pass "dm_helpers_standalone"

# ---------------------------------------------------------------------------
# Case: escape_and_quote
# xml_escape and shq correctness.
# ---------------------------------------------------------------------------
reset_ctl
(
    . "$LIB"
    RESULT_ESC="$(xml_escape 'a&b<c>d')"
    WANT_ESC='a&amp;b&lt;c&gt;d'
    [[ "$RESULT_ESC" == "$WANT_ESC" ]] || { printf 'xml_escape mismatch: got %s\n' "$RESULT_ESC" >&2; exit 1; }
    eval "x=$(shq "it's \$HOME")"
    # shellcheck disable=SC2154
    [[ "$x" == "it's \$HOME" ]] || { printf "shq roundtrip mismatch: got %s\n" "$x" >&2; exit 1; }
)
RC=$?
if [[ $RC -eq 0 ]]; then
    pass "escape_and_quote"
else
    fail "escape_and_quote" "subshell exited $RC"
fi

# ---------------------------------------------------------------------------
# Case: source_is_inert
# Sourcing twice in a shell with set +euo pipefail leaves $- and pipefail unchanged;
# launchctl recorder empty.
# ---------------------------------------------------------------------------
reset_ctl
# Capture $- and pipefail state before sourcing
(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    set +euo pipefail  2>/dev/null || true
    BEFORE_FLAGS="$-"
    BEFORE_PIPE="$(set -o | grep pipefail | awk '{print $2}')"

    . "$LIB"
    . "$LIB"  # double-source

    AFTER_FLAGS="$-"
    AFTER_PIPE="$(set -o | grep pipefail | awk '{print $2}')"

    [[ "$BEFORE_FLAGS" == "$AFTER_FLAGS" ]] || { printf 'flags changed: %s -> %s\n' "$BEFORE_FLAGS" "$AFTER_FLAGS" >&2; exit 1; }
    [[ "$BEFORE_PIPE"  == "$AFTER_PIPE"  ]] || { printf 'pipefail changed: %s -> %s\n' "$BEFORE_PIPE" "$AFTER_PIPE" >&2; exit 1; }
    exit 0
)
RC=$?
LAUNCHCTL_CALLS_COUNT=0
[[ -f "$T/ctl/launchctl_calls" ]] && LAUNCHCTL_CALLS_COUNT="$(wc -l < "$T/ctl/launchctl_calls" | tr -d ' ')"

if [[ $RC -eq 0 && "$LAUNCHCTL_CALLS_COUNT" -eq 0 ]]; then
    pass "source_is_inert"
else
    fail "source_is_inert" "subshell_rc=$RC launchctl_calls=$LAUNCHCTL_CALLS_COUNT"
fi

# ---------------------------------------------------------------------------
# Cases: reap_orphan_* (ljob_reap_orphan_scripts)
# Fixture: $RO_DIR/post-plan-now-x-1.sh plus its .once dir; label
# com.ibl5.postplan-now-x-1.
# ---------------------------------------------------------------------------
RO_DIR="$T/ro"
RO_SCRIPT="$RO_DIR/post-plan-now-x-1.sh"
RO_LABEL="com.ibl5.postplan-now-x-1"
RO_OTHER="$(printf '%s\t%s\t%s\n' '4242' '0' 'com.ibl5.other-job')"

# ro_fixture <old|young>: fresh script + .once dir.
ro_fixture() {
    rm -rf "$RO_DIR"; mkdir -p "$RO_DIR"
    touch "$RO_SCRIPT"; mkdir "$RO_SCRIPT.once"
    if [[ "$1" == old ]]; then touch -t 202601010000 "$RO_SCRIPT"; fi
    return 0
}
# ro_run <snapshot> [dry]: run the reap in a subshell sourcing $LIB.
ro_run() {
    (
        HOME="$T/home"
        PATH="$SHIM_PATH"
        . "$LIB"
        if [[ "${2:-}" == dry ]]; then LJOB_REAP_DRY=1; fi
        ljob_reap_orphan_scripts "$RO_DIR" post-plan-now- com.ibl5.postplan-now- 10 "$1"
    )
}

# Case: reap_orphan_old_unlisted
reset_ctl
ro_fixture old
RO1_OUT="$(ro_run "$RO_OTHER")"
RO1_GONE=0; [[ ! -e "$RO_SCRIPT" && ! -e "$RO_SCRIPT.once" ]] && RO1_GONE=1
RO1_MSG=0; grep -qF "reaped orphan script $RO_SCRIPT" <<< "$RO1_OUT" && RO1_MSG=1
if [[ $RO1_GONE -eq 1 && $RO1_MSG -eq 1 ]]; then
    pass "reap_orphan_old_unlisted"
else
    fail "reap_orphan_old_unlisted" "gone=$RO1_GONE msg=$RO1_MSG out='$RO1_OUT'"
fi

# Case: reap_orphan_young_kept
reset_ctl
ro_fixture young
RO2_OUT="$(ro_run "$RO_OTHER")"
if [[ -e "$RO_SCRIPT" && -d "$RO_SCRIPT.once" && -z "$RO2_OUT" ]]; then
    pass "reap_orphan_young_kept"
else
    fail "reap_orphan_young_kept" "script_present=$([[ -e "$RO_SCRIPT" ]] && echo 1 || echo 0) out='$RO2_OUT'"
fi

# Case: reap_orphan_listed_kept
reset_ctl
ro_fixture old
RO3_OUT="$(ro_run "$(printf '%s\t%s\t%s\n' '4242' '0' "$RO_LABEL")")"
if [[ -e "$RO_SCRIPT" && -d "$RO_SCRIPT.once" && -z "$RO3_OUT" ]]; then
    pass "reap_orphan_listed_kept"
else
    fail "reap_orphan_listed_kept" "script_present=$([[ -e "$RO_SCRIPT" ]] && echo 1 || echo 0) out='$RO3_OUT'"
fi

# Case: reap_orphan_empty_snapshot_noop
reset_ctl
ro_fixture old
RO4_OUT="$(ro_run "")"
if [[ -e "$RO_SCRIPT" && -d "$RO_SCRIPT.once" && -z "$RO4_OUT" ]]; then
    pass "reap_orphan_empty_snapshot_noop"
else
    fail "reap_orphan_empty_snapshot_noop" "script_present=$([[ -e "$RO_SCRIPT" ]] && echo 1 || echo 0) out='$RO4_OUT'"
fi

# Case: reap_orphan_dry_run
reset_ctl
ro_fixture old
RO5_OUT="$(ro_run "$RO_OTHER" dry)"
RO5_MSG=0; grep -qF "would reap $RO_SCRIPT" <<< "$RO5_OUT" && RO5_MSG=1
if [[ -e "$RO_SCRIPT" && -d "$RO_SCRIPT.once" && $RO5_MSG -eq 1 ]]; then
    pass "reap_orphan_dry_run"
else
    fail "reap_orphan_dry_run" "script_present=$([[ -e "$RO_SCRIPT" ]] && echo 1 || echo 0) msg=$RO5_MSG out='$RO5_OUT'"
fi

# Case: reap_orphan_prefix_exact
# Label ...-x-1 listed: file kept. Only ...-x-10 listed: file deleted.
reset_ctl
ro_fixture old
ro_run "$(printf '%s\t%s\t%s\n' '4242' '0' "$RO_LABEL")" >/dev/null
RO6_KEPT=0; [[ -e "$RO_SCRIPT" ]] && RO6_KEPT=1
ro_run "$(printf '%s\t%s\t%s\n' '4242' '0' 'com.ibl5.postplan-now-x-10')" >/dev/null
RO6_GONE=0; [[ ! -e "$RO_SCRIPT" ]] && RO6_GONE=1
if [[ $RO6_KEPT -eq 1 && $RO6_GONE -eq 1 ]]; then
    pass "reap_orphan_prefix_exact"
else
    fail "reap_orphan_prefix_exact" "kept_when_listed=$RO6_KEPT gone_when_only_x-10=$RO6_GONE"
fi

# ---------------------------------------------------------------------------
# Case: safe_slug_squeezes
# ljob_safe_slug maps every run of chars outside [A-Za-z0-9._-] to one dash.
# ---------------------------------------------------------------------------
SS_OUT="$(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    . "$LIB"
    ljob_safe_slug 'feat/x.y z'
)"
if [[ "$SS_OUT" == "feat-x.y-z" ]]; then
    pass "safe_slug_squeezes"
else
    fail "safe_slug_squeezes" "got '$SS_OUT'"
fi

# ---------------------------------------------------------------------------
# Case: postplan_now_live_exact_slug
# ljob_postplan_now_live matches the exact slug between the fixed prefix and the
# timestamp. branch-one-extra must not match branch-one, and an empty slug is rc 1.
# ---------------------------------------------------------------------------
PNL_SNAP="$(printf '%s\t%s\t%s\n' '-' '0' 'com.ibl5.postplan-now-branch-one-extra-20260101-120000-99')"
PNL_SNAP_HIT="$(printf '%s\t%s\t%s\n' '4242' '0' 'com.ibl5.postplan-now-branch-one-20260101-120000-99')"
PNL_RC="$(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    . "$LIB"
    hit=0 miss=0 empty=0
    ljob_postplan_now_live branch-one "$PNL_SNAP_HIT" >/dev/null && hit=1
    ljob_postplan_now_live branch-one "$PNL_SNAP" >/dev/null || miss=1
    ljob_postplan_now_live '' "$PNL_SNAP_HIT" >/dev/null || empty=1
    echo "hit=$hit miss=$miss empty=$empty"
)"
if [[ "$PNL_RC" == "hit=1 miss=1 empty=1" ]]; then
    pass "postplan_now_live_exact_slug"
else
    fail "postplan_now_live_exact_slug" "got '$PNL_RC'"
fi
PNL_LABEL_OUT="$(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    . "$LIB"
    ljob_postplan_now_live branch-one "$PNL_SNAP_HIT"
)"
if [[ "$PNL_LABEL_OUT" == "com.ibl5.postplan-now-branch-one-20260101-120000-99" ]]; then
    pass "postplan_now_live_exact_slug: prints label"
else
    fail "postplan_now_live_exact_slug: prints label" "got '$PNL_LABEL_OUT'"
fi

# ---------------------------------------------------------------------------
# Submit-helper fixtures: executable script, and a respawn-safe counter script.
# ---------------------------------------------------------------------------
SUB_DIR="$T/sub"
mkdir -p "$SUB_DIR"
SUB_SCRIPT="$SUB_DIR/S.sh"
SUB_LOG="$SUB_DIR/L.log"
SUB_LABEL="com.ibl5.t-1"
printf '#!/bin/bash\nexit 0\n' > "$SUB_SCRIPT"
chmod +x "$SUB_SCRIPT"

# ---------------------------------------------------------------------------
# Case: submit_argv_golden
# HOME=/test-home; the recorded launchctl call line equals the golden line (the
# scratch dir is the @T@ placeholder). Pasted from one run of the helper.
# ---------------------------------------------------------------------------
reset_ctl
(
    HOME="/test-home"
    PATH="$SHIM_PATH"
    . "$LIB"
    ljob_submit "$SUB_LABEL" "$SUB_LOG" "$SUB_SCRIPT"
) >/dev/null 2>&1
SA_LINE="$(cat "$T/ctl/launchctl_calls" 2>/dev/null || true)"
SA_GOLD="$(cat <<'GOLD_EOF'
launchctl submit -l com.ibl5.t-1 -o @T@/sub/L.log -e @T@/sub/L.log -- /usr/bin/env HOME=/test-home PATH=/usr/local/bin:/opt/homebrew/bin:/test-home/.bun/bin:/test-home/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin /bin/bash -lc if ! mkdir '@T@/sub/S.sh.once' 2>/dev/null; then trap '' TERM; '@T@/shim/launchctl' remove 'com.ibl5.t-1'; rmdir '@T@/sub/S.sh.once'; exit 0; fi; '@T@/sub/S.sh'; rc=$?; trap '' TERM; '@T@/shim/launchctl' remove 'com.ibl5.t-1'; rmdir '@T@/sub/S.sh.once'; exit $rc
GOLD_EOF
)"
SA_GOLD="${SA_GOLD//@T@/$T}"
SA_OK=1
[[ "$SA_LINE" == "$SA_GOLD" ]]                               || { SA_OK=0; fail "submit_argv_golden" "golden mismatch: got '$SA_LINE'"; }
[[ "$SA_LINE" == *"-o $SUB_LOG -e $SUB_LOG"* ]]              || { SA_OK=0; fail "submit_argv_golden" "missing -o/-e"; }
[[ "$SA_LINE" == *"HOME=/test-home"* ]]                      || { SA_OK=0; fail "submit_argv_golden" "missing HOME=/test-home"; }
[[ "$SA_LINE" == *"PATH="*"/opt/homebrew/bin"*"/usr/bin"* ]] || { SA_OK=0; fail "submit_argv_golden" "PATH incomplete"; }
[[ "$SA_LINE" != *'$HOME'* ]]                                || { SA_OK=0; fail "submit_argv_golden" "literal \$HOME present"; }
[[ "$SA_LINE" == *"${SUB_SCRIPT}.once"* ]]                   || { SA_OK=0; fail "submit_argv_golden" "missing .once marker path"; }
[[ $SA_OK -eq 1 ]] && pass "submit_argv_golden"

# ---------------------------------------------------------------------------
# Case: submit_rejects_bad_args
# Usage errors return 2 and never call launchctl (launchctl_calls stays absent).
# ---------------------------------------------------------------------------
SB_NOEXEC="$SUB_DIR/noexec.sh"
printf '#!/bin/bash\nexit 0\n' > "$SB_NOEXEC"
chmod -x "$SB_NOEXEC"
SB_OK=1
for SB_CASE in none badlabel otherns relscript noexec; do
    reset_ctl
    RC=0
    (
        HOME="$T/home"
        PATH="$SHIM_PATH"
        . "$LIB"
        case "$SB_CASE" in
            none)     ljob_submit ;;
            badlabel) ljob_submit "bad.label-1" "$SUB_LOG" "$SUB_SCRIPT" ;;
            otherns)  ljob_submit "com.other.x" "$SUB_LOG" "$SUB_SCRIPT" ;;
            relscript) ljob_submit "$SUB_LABEL" "$SUB_LOG" "S.sh" ;;
            noexec)   ljob_submit "$SUB_LABEL" "$SUB_LOG" "$SB_NOEXEC" ;;
        esac
    ) >/dev/null 2>&1 || RC=$?
    if [[ $RC -ne 2 || -e "$T/ctl/launchctl_calls" ]]; then
        SB_OK=0
        fail "submit_rejects_bad_args" "$SB_CASE: rc=$RC calls_file=$([ -e "$T/ctl/launchctl_calls" ] && echo present || echo absent)"
    fi
done
[[ $SB_OK -eq 1 ]] && pass "submit_rejects_bad_args"

# ---------------------------------------------------------------------------
# Case: submit_rc_propagates
# launchctl_submit_rc=5 makes ljob_submit return 5.
# ---------------------------------------------------------------------------
reset_ctl
printf '5\n' > "$T/ctl/launchctl_submit_rc"
RC=0
(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    . "$LIB"
    ljob_submit "$SUB_LABEL" "$SUB_LOG" "$SUB_SCRIPT"
) >/dev/null 2>&1 || RC=$?
if [[ $RC -eq 5 ]]; then
    pass "submit_rc_propagates"
else
    fail "submit_rc_propagates" "expected 5, got $RC"
fi

# ---------------------------------------------------------------------------
# Case: submit_print_matches_submit
# ljob_submit_print output, split back into words, equals the call line
# ljob_submit recorded; the print run records no call.
# ---------------------------------------------------------------------------
reset_ctl
SP_PRINT="$(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    . "$LIB"
    ljob_submit_print "$SUB_LABEL" "$SUB_LOG" "$SUB_SCRIPT"
)"
SP_PRINT_CALLS=absent; [[ -e "$T/ctl/launchctl_calls" ]] && SP_PRINT_CALLS=present
reset_ctl
(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    . "$LIB"
    ljob_submit "$SUB_LABEL" "$SUB_LOG" "$SUB_SCRIPT"
) >/dev/null 2>&1
SP_REC="$(cat "$T/ctl/launchctl_calls" 2>/dev/null || true)"
eval "set -- $SP_PRINT"
SP_JOINED="$*"
if [[ "$SP_PRINT_CALLS" == absent && -n "$SP_REC" && "$SP_JOINED" == "$SP_REC" ]]; then
    pass "submit_print_matches_submit"
else
    fail "submit_print_matches_submit" "print_calls=$SP_PRINT_CALLS joined='$SP_JOINED' recorded='$SP_REC'"
fi

# ---------------------------------------------------------------------------
# Case: wrapper_runs_once_then_removes
# The wrapper runs the body once, exits with its status (7), records
# `remove L` after the body line, and leaves no marker.
# ---------------------------------------------------------------------------
reset_ctl
WR_SCRIPT="$SUB_DIR/wr.sh"
WR_COUNT="$SUB_DIR/wr.count"
rm -rf "${WR_SCRIPT}.once" "$WR_COUNT"
cat > "$WR_SCRIPT" <<WR_EOF
#!/bin/bash
echo x >> "$WR_COUNT"
echo "BODY" >> "$T/ctl/launchctl_calls"
exit 7
WR_EOF
chmod +x "$WR_SCRIPT"
RC=0
(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    . "$LIB"
    bash -c "$(ljob_submit_wrapper_text L "$WR_SCRIPT")"
) >/dev/null 2>&1 || RC=$?
WR_N="$(wc -l < "$WR_COUNT" 2>/dev/null | tr -d ' ')"
WR_BODY_LN="$(grep -n '^BODY$' "$T/ctl/launchctl_calls" 2>/dev/null | head -1 | cut -d: -f1)"
WR_REM_LN="$(grep -n 'remove L$' "$T/ctl/launchctl_calls" 2>/dev/null | head -1 | cut -d: -f1)"
if [[ "$WR_N" == "1" && $RC -eq 7 && -n "$WR_BODY_LN" && -n "$WR_REM_LN" \
   && "$WR_REM_LN" -gt "$WR_BODY_LN" && ! -e "${WR_SCRIPT}.once" ]]; then
    pass "wrapper_runs_once_then_removes"
else
    fail "wrapper_runs_once_then_removes" "count='$WR_N' rc=$RC body_ln='$WR_BODY_LN' remove_ln='$WR_REM_LN' marker=$([ -e "${WR_SCRIPT}.once" ] && echo present || echo gone)"
fi

# ---------------------------------------------------------------------------
# Case: wrapper_respawn_hits_guard
# S.once already exists (a killed first run): the wrapper exits 0, the body
# never runs, `remove L` is recorded, and the marker is gone.
# ---------------------------------------------------------------------------
reset_ctl
RG_SCRIPT="$SUB_DIR/rg.sh"
RG_COUNT="$SUB_DIR/rg.count"
rm -rf "${RG_SCRIPT}.once" "$RG_COUNT"
cat > "$RG_SCRIPT" <<RG_EOF
#!/bin/bash
echo x >> "$RG_COUNT"
exit 7
RG_EOF
chmod +x "$RG_SCRIPT"
mkdir "${RG_SCRIPT}.once"
RC=0
(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    . "$LIB"
    bash -c "$(ljob_submit_wrapper_text L "$RG_SCRIPT")"
) >/dev/null 2>&1 || RC=$?
RG_N=0; [[ -f "$RG_COUNT" ]] && RG_N="$(wc -l < "$RG_COUNT" | tr -d ' ')"
RG_REM=0; grep -q 'remove L$' "$T/ctl/launchctl_calls" 2>/dev/null && RG_REM=1
if [[ $RC -eq 0 && "$RG_N" == "0" && $RG_REM -eq 1 && ! -e "${RG_SCRIPT}.once" ]]; then
    pass "wrapper_respawn_hits_guard"
else
    fail "wrapper_respawn_hits_guard" "rc=$RC count=$RG_N remove=$RG_REM marker=$([ -e "${RG_SCRIPT}.once" ] && echo present || echo gone)"
fi

# ---------------------------------------------------------------------------
# Case: kill_label_remove_fallback
# After bootout, a still-listed label (list rc 0) gets `launchctl remove`;
# a gone label (list rc 113) does not.
# ---------------------------------------------------------------------------
reset_ctl
printf '0\n' > "$T/ctl/launchctl_list_rc"
(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    . "$LIB"
    always_dead() { return 1; }
    ljob_kill_label "com.ibl5.test-1" "always_dead" "pat-A"
) >/dev/null 2>&1
KR_LISTED=0; grep -qxF "launchctl remove com.ibl5.test-1" "$T/ctl/launchctl_calls" 2>/dev/null && KR_LISTED=1
reset_ctl
printf '113\n' > "$T/ctl/launchctl_list_rc"
(
    HOME="$T/home"
    PATH="$SHIM_PATH"
    . "$LIB"
    always_dead() { return 1; }
    ljob_kill_label "com.ibl5.test-1" "always_dead" "pat-A"
) >/dev/null 2>&1
KR_GONE=0; grep -qF "launchctl remove" "$T/ctl/launchctl_calls" 2>/dev/null && KR_GONE=1
if [[ $KR_LISTED -eq 1 && $KR_GONE -eq 0 ]]; then
    pass "kill_label_remove_fallback"
else
    fail "kill_label_remove_fallback" "remove_when_listed=$KR_LISTED remove_when_gone=$KR_GONE"
fi

