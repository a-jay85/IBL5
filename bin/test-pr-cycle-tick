#!/usr/bin/env bash
args=()
for a in "\$@"; do
    if [[ "\$a" == --go ]]; then args+=(--worker --no-dm); else args+=("\$a"); fi
done
cd "$RW/repo" || exit 1
exec env HOME="$RW/home" \\
    PR_CYCLE_ATTACK_CMD="$RW/bin/attack" PR_CYCLE_TRIAGE_CMD="$RW/bin/triage" \\
    PR_CYCLE_READY_CMD="$RW/bin/ready" PR_CYCLE_DM_CMD="$RW/bin/dm" \\
    PR_CYCLE_GH_CMD="$RW/bin/gh" PR_CYCLE_MAIN_CHECKOUT="$RW_TOP" \\
    PR_CYCLE_STOP_FILE="$RW/stop" PR_CYCLE_TS="tpt\$\$" PR_CYCLE_AUTH_PROBE_CMD=true \\
    PR_CYCLE_PATCH_ID_CMD=false PR_CYCLE_HARNESS_OUT="$RW/harness-out" \\
    PR_CYCLE_FLEET_LOG_DIR="$RW/fleetlogs" PR_CYCLE_HOLDREPEAT_HARNESS="$RW/hr-none" \\
    PR_CYCLE_HOLDREPEAT_STATE_DIR="$RW/hrstate" \\
    "$SCRIPT_DIR/pr-cycle" "\${args[@]}"
WR_EOF
chmod +x "$RW/bin"/* "$RW/wrapper"
