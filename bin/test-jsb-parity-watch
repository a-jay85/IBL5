case_fixer_open_no_rewake() {
    sandbox fixer_open
    quiet_row
    arm_fixer
    one_fix "$BASE"
    run_watch
    no_actions "claimed blocker"
    h_absent "claimed: no queue file" "$S/home/.cache/jsb-parity-fixer-queue.txt"
    write_blockers '{"active":{"days-empty":{"first":1,"fix":"f","bucket":"fixer","dm_sent":false}},"fixer":{"owner":{"days-empty":"gave up"}}}'
    run_watch
    no_actions "owner-held blocker"
    # Wake, claim, then the same blocker returns much later: it wakes again, with no DM.
    sandbox fixer_recur
    quiet_row
    arm_fixer
    one_blocker "$FIX_KEY"
    run_watch
    h_eq "recurrence: first wake" 1 "$(posts fixer)"
    one_fix "$BASE"
