#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-automouse-postplan-engine — regression tests for the automouse post-plan
# invocation wiring added in the automouse-postplan-harness-engine branch.
#
# Covers Verification Matrix rows 8-12:
#
#   8  The postplan block cd's into the handoff worktree and invokes
#      $SELF_DIR/../post-plan-now --foreground --plan <abs>
#   9  Handoff absent, or .worktree empty / not a directory → no invocation,
#      PP_STATUS non-zero, log line names the handoff path
#  10  A seeded 'api error: 429' on the invocation's stderr lands in $LOG
#      before the slice read, so phase_env_error still fires
#  11  Static negative — bin/automouse/run never sets/exports HARNESS
#      (ADR-0092) and never passes --auto to post-plan-now
#  12  post-plan-now rc=3 (terminal BLOCKED) → plan to skipped/ with a report
#      quoting the RESULT: line; no refund, no env-stop, no break. 12b: no
#      RESULT line → fallback text. 12c: rc=1 fast exit still trips the
#      breaker. 12-neg: breaker alone (no arm) reproduces the defect.
#
# Extraction idiom: awk pulls the live blocks from bin/automouse/run and
# bin/automouse/run so tests cannot drift from the real code.
#
# Run: bin/test-automouse-postplan-engine  (exit 0 = all pass, 1 = a case failed)

set -u

REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
FAILED=0

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

assert_eq() {
    if [ "$1" = "$2" ]; then
        printf '  ok   %s\n' "$3"
    else
        printf '  FAIL %s: got %s, expected %s\n' "$3" "$1" "$2"
        FAILED=1
    fi
}

assert_contains() {
    # Use -e so strings starting with -- aren't mistaken for grep options.
    if printf '%s' "$1" | grep -qF -e "$2"; then
        printf '  ok   %s\n' "$3"
    else
        printf '  FAIL %s: %q not found in output\n' "$3" "$2"
        FAILED=1
    fi
}

# ---------------------------------------------------------------------------
# Extract live blocks — never copy them.
# ---------------------------------------------------------------------------

# shellcheck disable=SC2034  # PP_BLOCK, ENV_ERR_FN read via eval
PP_BLOCK=$(awk '/^        PP_WORKTREE=\$\(automouse_worktree_for_plan/,/^        fi$/' "$REPO_ROOT/bin/automouse/run")
ENV_ERR_FN=$(awk '/^phase_env_error\(\)/,/^}/' "$REPO_ROOT/bin/automouse/run")
# The PP block now resolves the worktree through a helper (handoff .worktree is an
# optional override over the $WORKTREES_ROOT/<slug> derivation). Extract it too, or
# the eval'd block below dies on `command not found`.
WT_FN=$(awk '/^automouse_worktree_for_plan\(\) \{/,/^\}/' "$REPO_ROOT/bin/automouse/run")
eval "$WT_FN"

# rc=3 terminal arm + the environmental breaker it must pre-empt. Unique comment
# anchors delimit both spans. Never anchor on an indent token like `fi`.
RUN_FILE="$REPO_ROOT/bin/automouse/run"
PP_TERMINAL_SPAN=$(awk '/# postplan-rc3-terminal: begin/,/# postplan-env-breaker: end/' "$RUN_FILE")
PP_BREAKER_ONLY=$(awk '/# postplan-env-breaker: begin/,/# postplan-env-breaker: end/' "$RUN_FILE")
# rc=7 (no worktree) arm from Phase 2. Unique comment anchors delimit it, the same scheme as rc3.
PP_NOWT_SPAN=$(awk '/# postplan-no-worktree-merged: begin/,/# postplan-no-worktree-merged: end/' "$RUN_FILE")
BLOCKED_FN=$(awk '/^dispose_plan_postplan_blocked\(\) \{/,/^\}/' "$RUN_FILE")
REFUND_FN=$(awk '/^refund_attempt\(\) \{/,/^\}/' "$RUN_FILE")
STALLED_FN=$(awk '/^phase_stalled\(\) \{/,/^\}/' "$RUN_FILE")
ENVSTOP_FN=$(awk '/^write_env_stop_report\(\) \{/,/^\}/' "$RUN_FILE")
eval "$REFUND_FN"; eval "$STALLED_FN"; eval "$ENVSTOP_FN"; eval "$BLOCKED_FN"

# Anchor uniqueness: if an anchor is missing, the awk range reads to EOF.
# If it is duplicated, the range starts at the wrong place.
for anchor in '# postplan-rc3-terminal: begin' \
              '# postplan-env-breaker: begin' \
              '# postplan-env-breaker: end' \
              '# postplan-no-worktree-merged: begin' \
              '# postplan-no-worktree-merged: end'; do
    n=$(grep -cF -e "$anchor" "$RUN_FILE" || true)
    assert_eq "$n" "1" "anchor '$anchor' appears exactly once in bin/automouse/run"
done
assert_contains "$PP_TERMINAL_SPAN" '"$PP_STATUS" -eq 3' "rc3 span tests PP_STATUS against 3"
assert_contains "$PP_TERMINAL_SPAN" 'dispose_plan_postplan_blocked' "rc3 span calls the blocked disposer"
assert_contains "$PP_BREAKER_ONLY" 'refund_attempt' "breaker span is the environmental breaker"
assert_contains "$PP_BREAKER_ONLY" '"$PP_TERMINAL" -eq 0' "breaker is guarded by PP_TERMINAL"
assert_contains "$BLOCKED_FN" 'dispose_plan_postplan_blocked() {' "blocked disposer extracted"
assert_contains "$PP_NOWT_SPAN" '"$PP_STATUS" -eq 7' "rc7 span tests PP_STATUS against 7"
assert_contains "$PP_NOWT_SPAN" 'postplan_no_worktree_dispose_if_merged' "rc7 span calls the merged-PR disposer"
assert_contains "$PP_NOWT_SPAN" 'PP_NOWT_DISPOSED' "rc7 span honors the pre-call disposal flag"
# Ordering: the rc7 arm must sit BEFORE the env breaker. Otherwise the breaker's
# fast-exit `break` fires first and the merged PR is refunded instead of disposed.
NOWT_LN=$(grep -nF -e '# postplan-no-worktree-merged: begin' "$RUN_FILE" | head -1 | cut -d: -f1)
BRK_LN=$(grep -nF -e '# postplan-env-breaker: begin' "$RUN_FILE" | head -1 | cut -d: -f1)
if [ -n "$NOWT_LN" ] && [ -n "$BRK_LN" ] && [ "$NOWT_LN" -lt "$BRK_LN" ]; then
    printf '  ok   rc7 span precedes the env breaker\n'
else
    printf '  FAIL rc7 span must precede # postplan-env-breaker: begin (got %s vs %s)\n' "${NOWT_LN:-none}" "${BRK_LN:-none}"; FAILED=1
fi

# Sanity: confirm extraction captured the right block before evaling anything.
assert_contains "$PP_BLOCK" 'PP_WORKTREE=$(automouse_worktree_for_plan' "PP block starts with the worktree resolution"
assert_contains "$PP_BLOCK" '--foreground'   "PP block invokes --foreground"

eval "$ENV_ERR_FN"

# Timeout passthrough shim: the PP block uses `timeout $secs cmd`, but the
# unit-test sandbox does not need a real wall-clock limit.
timeout() { local _s="$1"; shift; "$@"; }

echo
echo "-- row 8: postplan block cd's into worktree and runs post-plan-now --foreground --plan <abs> --"

# ---------------------------------------------------------------------------
# Row 8
# ---------------------------------------------------------------------------
S8=$(mktemp -d)
mkdir -p "$S8/run-dir/bin" "$S8/worktree" "$S8/plans"
LOG="$S8/log"; : > "$LOG"
HANDOFF_DIR="$S8"
HANDOFF_FILE="$HANDOFF_DIR/test-plan.md.json"
# No $WORKTREES_ROOT/<slug> on disk, so this row exercises the handoff-override path.
WORKTREES_ROOT="$S8/no-such-worktrees-root"
PLANS_DIR="$S8/plans"
PLAN_NAME="test-plan.md"
PLAN_SLUG="test-plan"
CMDPID_FILE="$S8/cmdpid"
REMAINING_SECS=30
SELF_DIR="$S8/run-dir/bin"  # SELF_DIR/../post-plan-now = $S8/run-dir/post-plan-now

# Stub writes PWD and argv to STUB_RECORD, then exits 0.
# $S8 is expanded here (unquoted delimiter); $PWD/$@ are escaped for the stub.
STUB_RECORD="$S8/stub-record"
: > "$STUB_RECORD"
cat > "$S8/run-dir/post-plan-now" <<STUBEOF
#!/bin/sh
printf 'STUB-PWD: %s\n' "\$PWD" >> "$STUB_RECORD"
printf 'STUB-ARG: %s\n' "\$@" >> "$STUB_RECORD"
exit 0
STUBEOF
chmod +x "$S8/run-dir/post-plan-now"

printf '{"worktree": "%s"}\n' "$S8/worktree" > "$HANDOFF_FILE"

PP_STATUS=0
eval "$PP_BLOCK"

assert_eq "$PP_STATUS" "0"                              "row 8: PP_STATUS=0 when worktree is valid"
assert_contains "$(cat "$STUB_RECORD")" "STUB-PWD: $S8/worktree" \
                                                        "row 8: cd'd into the handoff worktree"
assert_contains "$(cat "$STUB_RECORD")" "--foreground"  "row 8: --foreground passed to post-plan-now"
assert_contains "$(cat "$STUB_RECORD")" "--plan"        "row 8: --plan passed to post-plan-now"
assert_contains "$(cat "$STUB_RECORD")" "$PLANS_DIR/$PLAN_NAME" \
                                                        "row 8: absolute plan path in args"

# ---------------------------------------------------------------------------
# Row 8b: END-TO-END for the 2026-09-17 defect. A handoff carrying no .worktree
# at all must still reach post-plan-now, cd'd into $WORKTREES_ROOT/<slug>.
#
# Row 8 above pins $WORKTREES_ROOT at a nonexistent path on purpose, so it only
# exercises the handoff-override branch. This row is the composition the live bug
# broke: agent writes a wrong-schema handoff, loop derives the tree from the slug,
# post-plan-now runs anyway.
# ---------------------------------------------------------------------------
WORKTREES_ROOT="$S8/wt"
mkdir -p "$WORKTREES_ROOT/$PLAN_SLUG"
printf '{"branch": "%s", "status": "verified-clean"}\n' "$PLAN_SLUG" > "$HANDOFF_FILE"
: > "$STUB_RECORD"
: > "$LOG"

PP_STATUS=0
eval "$PP_BLOCK"

assert_eq "$PP_STATUS" "0"                              "row 8b: PP_STATUS=0 when the tree is derived from the slug"
assert_contains "$(cat "$STUB_RECORD")" "STUB-PWD: $WORKTREES_ROOT/$PLAN_SLUG" \
                                                        "row 8b: cd'd into the slug-derived worktree"
assert_contains "$(cat "$STUB_RECORD")" "--foreground"  "row 8b: --foreground still passed"
assert_contains "$(cat "$LOG")" "handoff has no usable .worktree" \
                                                        "row 8b: the derive path logs loudly"

rm -rf "$S8"

echo
echo "-- row 9: missing/empty handoff → skip, PP_STATUS non-zero, log names handoff path --"

# ---------------------------------------------------------------------------
# Row 9: three sub-cases (absent file, empty worktree key, nonexistent dir)
# ---------------------------------------------------------------------------
for SCENARIO in "no-handoff" "empty-worktree" "missing-worktree-dir"; do
    S9=$(mktemp -d)
    mkdir -p "$S9/run-dir/bin" "$S9/plans"
    LOG="$S9/log"; : > "$LOG"
    HANDOFF_DIR="$S9"
    HANDOFF_FILE="$HANDOFF_DIR/test-plan.md.json"
    # Neither source resolves: no handoff path AND no $WORKTREES_ROOT/<slug> on disk.
    WORKTREES_ROOT="$S9/no-such-worktrees-root"
    PLANS_DIR="$S9/plans"
    PLAN_NAME="test-plan.md"
    PLAN_SLUG="test-plan"
    CMDPID_FILE="$S9/cmdpid"
    REMAINING_SECS=30
    SELF_DIR="$S9/run-dir/bin"

    case "$SCENARIO" in
        no-handoff)
            # HANDOFF_FILE does not exist — leave it absent
            ;;
        empty-worktree)
            printf '{"worktree": ""}\n' > "$HANDOFF_FILE"
            ;;
        missing-worktree-dir)
            printf '{"worktree": "%s/nonexistent"}\n' "$S9" > "$HANDOFF_FILE"
            ;;
    esac

    PP_STATUS=0
    eval "$PP_BLOCK"

    if [ "$PP_STATUS" -ne 0 ]; then
        printf '  ok   row 9 [%s]: PP_STATUS=%d (non-zero as expected)\n' "$SCENARIO" "$PP_STATUS"
    else
        printf '  FAIL row 9 [%s]: PP_STATUS=0, expected non-zero\n' "$SCENARIO"
        FAILED=1
    fi
    assert_contains "$(cat "$LOG")" "$HANDOFF_FILE" \
        "row 9 [$SCENARIO]: log names the handoff path"

    rm -rf "$S9"
done

echo
echo "-- row 10: api error: 429 on stub stderr triggers phase_env_error --"

# ---------------------------------------------------------------------------
# Row 10: stderr of the post-plan-now invocation lands in $LOG via `>> "$LOG" 2>&1`
# ---------------------------------------------------------------------------
S10=$(mktemp -d)
mkdir -p "$S10/run-dir/bin" "$S10/worktree" "$S10/plans"
LOG="$S10/log"; : > "$LOG"
HANDOFF_DIR="$S10"
HANDOFF_FILE="$HANDOFF_DIR/test-plan.md.json"
WORKTREES_ROOT="$S10/no-such-worktrees-root"
PLANS_DIR="$S10/plans"
PLAN_NAME="test-plan.md"
# shellcheck disable=SC2034  # read by the eval'd PP block extracted from bin/automouse/run
PLAN_SLUG="test-plan"
# shellcheck disable=SC2034  # read by the eval'd PP block extracted from bin/automouse/run
CMDPID_FILE="$S10/cmdpid"
# shellcheck disable=SC2034  # read by the eval'd PP block extracted from bin/automouse/run
REMAINING_SECS=30
# shellcheck disable=SC2034  # read by the eval'd PP block extracted from bin/automouse/run
SELF_DIR="$S10/run-dir/bin"

cat > "$S10/run-dir/post-plan-now" <<'STUBEOF'
#!/bin/sh
printf 'api error: 429 Too Many Requests\n' >&2
exit 1
STUBEOF
chmod +x "$S10/run-dir/post-plan-now"

printf '{"worktree": "%s"}\n' "$S10/worktree" > "$HANDOFF_FILE"

log_before=$(wc -l < "$LOG")

PP_STATUS=0
eval "$PP_BLOCK"

# phase_env_error reads $LOG from line $log_before+1 and greps for the pattern.
if phase_env_error "$log_before"; then
    printf '  ok   row 10: phase_env_error fires when api error: 429 appears in LOG\n'
else
    printf '  FAIL row 10: phase_env_error did not fire (api error: 429 must reach LOG via stderr)\n'
    FAILED=1
fi

rm -rf "$S10"

echo
echo "-- row 11: static negative — no HARNESS export, no --auto in post-plan-now invocation --"

# ---------------------------------------------------------------------------
# Row 11: assertions on bin/automouse/run source text
# ---------------------------------------------------------------------------
RUN_SRC="$REPO_ROOT/bin/automouse/run"

# HARNESS must not be exported or assigned on a live (non-comment) line.
# The comment block inside the replaced section mentions "HARNESS" — anchor
# on assignment syntax to avoid a false positive.
if grep -nE '^[[:space:]]*(export[[:space:]]+)?HARNESS=' "$RUN_SRC" | grep -qv '^[0-9]*:[[:space:]]*#'; then
    printf '  FAIL row 11: bin/automouse/run exports or assigns HARNESS\n'
    FAILED=1
else
    printf '  ok   row 11: HARNESS is not exported or assigned in bin/automouse/run\n'
fi

# --auto must not appear alongside post-plan-now in any non-comment line.
if grep -n 'post-plan-now' "$RUN_SRC" | grep -v '^[0-9]*:[[:space:]]*#' | grep -q -- '--auto'; then
    printf '  FAIL row 11: bin/automouse/run passes --auto to post-plan-now\n'
    FAILED=1
else
    printf '  ok   row 11: --auto not passed to post-plan-now\n'
fi

# Positive: --foreground IS present in the PP block (the bash -c inner command
# and the post-plan-now path are on adjacent lines; checking the extracted block
# is more robust than a multi-line grep over the source file).
if printf '%s' "$PP_BLOCK" | grep -qF -e '--foreground'; then
    printf '  ok   row 11: --foreground is present in the postplan invocation block\n'
else
    printf '  FAIL row 11: --foreground not found in the postplan invocation block\n'
    FAILED=1
fi

echo
echo "-- row 12: post-plan-now rc=3 (terminal BLOCKED) → skipped/, no refund, no env-stop, no break --"

RC3_RESULT_LINE='RESULT: post-plan BLOCKED — rebase conflict, human required; ERROR terminal=failed, no PR opened.'

# Builds a fresh sandbox and runs the LIVE PP block against a stub post-plan-now
# that exits $1 instantly. When $2 = yes, the stub also prints RC3_RESULT_LINE to stdout.
# shellcheck disable=SC2034  # globals are read by the eval'd spans
rc3_sandbox() {
    local stub_rc=$1 print_result=$2
    SB=$(mktemp -d)
    NIGHTLY_DIR="$SB/nightly"; QUEUE_DIR="$NIGHTLY_DIR/queue"
    mkdir -p "$SB/run-dir/bin" "$SB/worktree" "$SB/plans" "$SB/handoff" "$QUEUE_DIR"
    LOG="$SB/log"; : > "$LOG"
    HANDOFF_DIR="$SB/handoff"
    PLAN_NAME="test-plan.md"; PLAN_SLUG="test-plan"
    HANDOFF_FILE="$HANDOFF_DIR/$PLAN_NAME.json"
    WORKTREES_ROOT="$SB/no-such-worktrees-root"
    PLANS_DIR="$SB/plans"; CMDPID_FILE="$SB/cmdpid"; REMAINING_SECS=30
    SELF_DIR="$SB/run-dir/bin"
    printf '# plan\n' > "$PLANS_DIR/$PLAN_NAME"
    ln -s "$PLANS_DIR/$PLAN_NAME" "$QUEUE_DIR/$PLAN_NAME"   # queue entries are symlinks
    NEXT_PLAN="$QUEUE_DIR/$PLAN_NAME"
    # attempts=2 on purpose: refund_attempt DECREMENTS to 1 (file survives), so
    # "attempt file absent" separates the rc=3 arm from a breaker refund.
    ATTEMPT_FILE="$QUEUE_DIR/$PLAN_NAME.attempts"; echo 2 > "$ATTEMPT_FILE"
    FAILURE_FILE="$QUEUE_DIR/$PLAN_NAME.failure"
    CAP_REFUND_FILE="$QUEUE_DIR/$PLAN_NAME.cap-refunds"; echo 1 > "$CAP_REFUND_FILE"
    MIN_VIABLE_SECS=60; STALL_KILL_SECS=1800
    printf '{"worktree": "%s"}\n' "$SB/worktree" > "$HANDOFF_FILE"
    STUB_RECORD="$SB/stub-record"; : > "$STUB_RECORD"
    cat > "$SB/run-dir/post-plan-now" <<STUBEOF
#!/bin/sh
printf 'STUB-INVOKED\n' >> "$STUB_RECORD"
[ "$print_result" = yes ] && printf '%s\n' '$RC3_RESULT_LINE'
exit $stub_rc
STUBEOF
    chmod +x "$SB/run-dir/post-plan-now"
    PP_LOG_BEFORE=$(wc -l < "$LOG")
    PP_STATUS=0
    eval "$PP_BLOCK"
    PP_DUR=2   # instant exit: under MIN_VIABLE_SECS, so the breaker's fast-exit clause is live
}

# Runs a span under the runner's own `set -euo pipefail` inside a one-shot loop,
# so the breaker's `break` is legal. The sentinel only prints when nothing broke out.
run_span() {
    ( set -euo pipefail
      # shellcheck disable=SC2043  # intentional one-shot loop — `break` exits the subshell cleanly
      for _pp_once in 1; do
          eval "$1"
          echo "SPAN-FELL-THROUGH"
      done ) > "$SB/span.out" 2>&1
    SPAN_RC=$?
}

yn() { if "$@"; then echo yes; else echo no; fi; }
count_envstop() { find "$NIGHTLY_DIR" -name '*-env-stop-*' 2>/dev/null | wc -l | tr -d ' '; }
skipped_report() { for f in "$NIGHTLY_DIR"/reports/*-skipped-"$PLAN_SLUG".md; do [ -f "$f" ] && echo "$f"; done; }

# --- Row 12: rc=3 + RESULT line → terminal disposition ---
rc3_sandbox 3 yes
assert_eq "$PP_STATUS" "3" "row 12: PP_STATUS captures post-plan-now exit 3"
run_span "$PP_TERMINAL_SPAN"
assert_eq "$SPAN_RC" "0" "row 12: span completes under set -euo pipefail"
assert_eq "$(grep -c '^STUB-INVOKED$' "$STUB_RECORD")" "1" "row 12: post-plan-now invoked exactly once"
assert_eq "$(yn test -L "$NIGHTLY_DIR/skipped/$PLAN_NAME")" "yes" "row 12: plan symlink moved to skipped/"
assert_eq "$(yn test -L "$QUEUE_DIR/$PLAN_NAME")" "no" "row 12: plan no longer in queue/"
RPT=$(skipped_report)
assert_eq "$(yn test -n "$RPT")" "yes" "row 12: skipped report written"
assert_contains "$(cat "$RPT" 2>/dev/null)" "$RC3_RESULT_LINE" "row 12: report quotes the RESULT: line"
assert_eq "$(yn test -e "$CAP_REFUND_FILE")" "no" "row 12: no .cap-refunds left in QUEUE_DIR"
assert_eq "$(count_envstop)" "0" "row 12: no env-stop report"
assert_eq "$(yn test -e "$ATTEMPT_FILE")" "no" "row 12: attempt file removed (not refunded)"
assert_eq "$(yn test -e "$HANDOFF_FILE")" "no" "row 12: handoff removed"
assert_contains "$(cat "$SB/span.out")" "SPAN-FELL-THROUGH" "row 12: breaker did NOT break the loop"
assert_contains "$(cat "$LOG")" "postplan terminal (rc=3)" "row 12: arm logs its disposition"
if grep -qF -e "Environmental failure during postplan" "$LOG"; then
    printf '  FAIL row 12: env-breaker log line present\n'; FAILED=1
else
    printf '  ok   row 12: env-breaker log line absent\n'
fi
rm -rf "$SB"

# --- Row 12b (boundary): rc=3 but no RESULT line → still terminal, fallback text ---
rc3_sandbox 3 no
run_span "$PP_TERMINAL_SPAN"
assert_eq "$SPAN_RC" "0" "row 12b: no-RESULT grep miss does not abort under set -e"
assert_eq "$(yn test -L "$NIGHTLY_DIR/skipped/$PLAN_NAME")" "yes" "row 12b: plan still dispositioned to skipped/"
assert_contains "$(cat "$(skipped_report)" 2>/dev/null)" "printed no RESULT: line" "row 12b: report carries fallback text"
rm -rf "$SB"

# --- Row 12c (negative path): rc=1 fast exit → breaker unchanged ---
rc3_sandbox 1 no
run_span "$PP_TERMINAL_SPAN"
assert_eq "$(yn test -L "$QUEUE_DIR/$PLAN_NAME")" "yes" "row 12c: rc=1 leaves plan in queue/"
assert_eq "$(yn test -L "$NIGHTLY_DIR/skipped/$PLAN_NAME")" "no" "row 12c: rc=1 does not skip"
assert_eq "$(count_envstop)" "1" "row 12c: rc=1 fast exit still writes env-stop report"
assert_eq "$(cat "$ATTEMPT_FILE" 2>/dev/null)" "1" "row 12c: rc=1 refunds the attempt (2 -> 1)"
if grep -qF -e "SPAN-FELL-THROUGH" "$SB/span.out"; then
    printf '  FAIL row 12c: breaker did not break on rc=1 fast exit\n'; FAILED=1
else
    printf '  ok   row 12c: breaker broke the loop on rc=1 fast exit\n'
fi
rm -rf "$SB"

# --- Row 12-neg (mutation control): rc=3 through the breaker ALONE ---
# Simulates the pre-fix loop, with the arm removed or placed after the breaker,
# where the breaker's `break` fires first. Row 12's assertions must be able to fail.
rc3_sandbox 3 yes
# shellcheck disable=SC2034  # PP_TERMINAL read by the eval'd PP_BREAKER_ONLY span
PP_TERMINAL=0   # pre-fix code has no arm, so nothing sets it
run_span "$PP_BREAKER_ONLY"
assert_eq "$(yn test -L "$NIGHTLY_DIR/skipped/$PLAN_NAME")" "no" "row 12-neg: without arm, plan NOT in skipped/"
assert_eq "$(yn test -L "$QUEUE_DIR/$PLAN_NAME")" "yes" "row 12-neg: without arm, plan stays in queue/"
assert_eq "$(count_envstop)" "1" "row 12-neg: without arm, env-stop report written (the defect)"
assert_eq "$(yn test -e "$CAP_REFUND_FILE")" "yes" "row 12-neg: without arm, .cap-refunds survives"
assert_eq "$(cat "$ATTEMPT_FILE" 2>/dev/null)" "1" "row 12-neg: without arm, attempt refunded not cleared"
rm -rf "$SB"

echo
echo "-- row 13: post-plan-now rc=7 (no worktree) → merged PR is terminal; unmerged/gh-error refunds + breaks --"

# $1 = what the disposer stub returns (0 = PR merged and disposed, 1 = not merged or gh error).
# Phase 2 contract: postplan_no_worktree_dispose_if_merged returns 0 only after it has disposed the plan.
# shellcheck disable=SC2034
nowt_sandbox() {
    SB=$(mktemp -d)
    NIGHTLY_DIR="$SB/nightly"; QUEUE_DIR="$NIGHTLY_DIR/queue"; mkdir -p "$QUEUE_DIR"
    LOG="$SB/log"; : > "$LOG"
    PLAN_NAME="test-plan.md"; PLAN_SLUG="test-plan"
    NEXT_PLAN="$QUEUE_DIR/$PLAN_NAME"
    ATTEMPT_FILE="$QUEUE_DIR/$PLAN_NAME.attempts"; echo 2 > "$ATTEMPT_FILE"
    PP_DUR=2; MIN_VIABLE_SECS=60
    NOWT_CALLS="$SB/calls"; : > "$NOWT_CALLS"
    NOWT_DISPOSE_RC=$1
}

# Prepends the stubs and the PP_TERMINAL recorder, then hands the text to run_span.
run_nowt_span() {
    local prelude
    prelude=$(cat <<'PRELUDE'
postplan_no_worktree_dispose_if_merged() { printf 'DISPOSE\n' >> "$NOWT_CALLS"; return "$NOWT_DISPOSE_RC"; }
refund_attempt() { printf 'REFUND\n' >> "$NOWT_CALLS"; }
write_env_stop_report() { printf 'ENVSTOP\n' >> "$NOWT_CALLS"; }
trap 'printf "%s\n" "${PP_TERMINAL:-unset}" > "$SB/terminal"' EXIT
PRELUDE
)
    run_span "$prelude"$'\n'"$PP_NOWT_SPAN"
}
calls_of() { grep -c "^$1\$" "$NOWT_CALLS" || true; }
fell_through() { if grep -qF -e "SPAN-FELL-THROUGH" "$SB/span.out"; then echo yes; else echo no; fi; }

# --- Row 13a: pre-call disposal already happened → terminal, no re-dispose, no refund ---
nowt_sandbox 0
PP_NOWT_DISPOSED=1; PP_STATUS=0; PP_TERMINAL=0
run_nowt_span
assert_eq "$SPAN_RC" "0" "row 13a: span completes under set -euo pipefail"
assert_eq "$(cat "$SB/terminal")" "1" "row 13a: PP_NOWT_DISPOSED=1 marks PP_TERMINAL=1"
assert_eq "$(calls_of DISPOSE)" "0" "row 13a: disposer NOT re-called after pre-call disposal"
assert_eq "$(calls_of REFUND)" "0" "row 13a: no refund"
assert_eq "$(fell_through)" "yes" "row 13a: loop not broken"
rm -rf "$SB"

# --- Row 13b: rc=7 and the PR is merged → dispose, terminal, no refund, no break ---
nowt_sandbox 0
PP_NOWT_DISPOSED=0; PP_STATUS=7; PP_TERMINAL=0
run_nowt_span
assert_eq "$SPAN_RC" "0" "row 13b: span completes under set -euo pipefail"
assert_eq "$(cat "$SB/terminal")" "1" "row 13b: merged rc=7 marks PP_TERMINAL=1"
assert_eq "$(calls_of DISPOSE)" "1" "row 13b: disposer called exactly once"
assert_eq "$(calls_of REFUND)" "0" "row 13b: merged PR is not refunded"
assert_eq "$(fell_through)" "yes" "row 13b: merged arm does NOT break the loop"
rm -rf "$SB"

# --- Row 13c: rc=7, PR not merged or gh errored → terminal, refund, loop stopped ---
nowt_sandbox 1
PP_NOWT_DISPOSED=0; PP_STATUS=7; PP_TERMINAL=0
run_nowt_span
assert_eq "$SPAN_RC" "0" "row 13c: a disposer rc=1 does not abort under set -e (called in a conditional)"
assert_eq "$(cat "$SB/terminal")" "1" "row 13c: unmerged rc=7 marks PP_TERMINAL=1 (the breaker must not fire again)"
assert_eq "$(calls_of DISPOSE)" "1" "row 13c: disposer consulted once"
assert_eq "$(calls_of REFUND)" "1" "row 13c: attempt refunded exactly once"
assert_eq "$(fell_through)" "no" "row 13c: loop broken (SPAN-FELL-THROUGH absent)"
rm -rf "$SB"

# --- Row 13d: baseline rc=0, no pre-call disposal → arm is a no-op ---
nowt_sandbox 0
# shellcheck disable=SC2034  # consumed by the eval'd span
PP_NOWT_DISPOSED=0
# shellcheck disable=SC2034
PP_STATUS=0
# shellcheck disable=SC2034
PP_TERMINAL=0
run_nowt_span
assert_eq "$SPAN_RC" "0" "row 13d: span completes under set -euo pipefail"
assert_eq "$(cat "$SB/terminal")" "0" "row 13d: PP_TERMINAL untouched on rc=0"
assert_eq "$(calls_of DISPOSE)" "0" "row 13d: disposer not called on rc=0"
assert_eq "$(calls_of REFUND)" "0" "row 13d: no refund on rc=0"
assert_eq "$(fell_through)" "yes" "row 13d: loop not broken on rc=0"
rm -rf "$SB"

exit "$FAILED"
