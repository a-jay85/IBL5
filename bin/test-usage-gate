    fetch_once 45 >/dev/null
    assert_backoff_delay ep_ra:direct 120
    read -r _ step < "$IBL5_USAGE_GATE_STATE_DIR/fetch-backoff"
    assert_eq ep_ra:step 5 "$step"
    assert_eq ep_ra:attempts 5 "$(episode_attempts)"
    assert_eq ep_ra:no-start 0 "$(log_count '429-episode start')"
}

