    > "$_FIX/roster-context.json"

# Run the real builder; output → prompt.out, errors → prompt.err.
run_prompt() {
    SIM_RECAP_EXEMPLAR="$SRT_EXEMPLAR" \
        "$SRT_PROMPT_BIN" "$@" > "$STUB/prompt.out" 2>"$STUB/prompt.err"
    SRT_PROMPT_RC=$?
}

