# ==========================================================================================
begin_case
reset_state
MAIN_OVERRIDE="" run --worker   # empty checkout seam falls back to the real hardcoded path
[[ $RC -eq 1 ]] || fail "empty PR_CYCLE_MAIN_CHECKOUT did not fall back to the pinned default"
