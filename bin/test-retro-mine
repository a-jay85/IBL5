#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-retro-mine — harness for bin/retro-mine.
#
# Every case builds its own fixture registry under mktemp -d and points the
# RETRO_MINE_* env seams at it. No PATH modification; jq and awk are real.
#
# Run: bin/test-retro-mine              all cases
#      bin/test-retro-mine case_a ...   only the named cases (unknown name exits 2)
#
# RETRO_MINE_SELF overrides the script under test (mutation proofs point it at
# a doctored copy). Exit 0 = all pass, 1 = failures.

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
RM_DRIVER="${RETRO_MINE_SELF:-$SCRIPT_DIR/retro-mine}"

FAILED=0
RM_RC=0
RM_OUT=""
RM_ERR=""

rm_ok()   { echo "ok: $1"; }
rm_fail() { echo "FAIL: $1"; FAILED=1; }

# rm_expect_eq <name> <want> <got>
rm_expect_eq() {
    if [ "$2" = "$3" ]; then rm_ok "$1"
    else rm_fail "$1 — want [$2] got [$3]"; fi
}
# rm_has <name> <haystack> <needle>   /   rm_lacks <name> <haystack> <needle>
rm_has() {
    if grep -qF -- "$3" <<< "$2"; then rm_ok "$1"
    else rm_fail "$1 — '$3' absent from: $2"; fi
}
rm_lacks() {
    if grep -qF -- "$3" <<< "$2"; then rm_fail "$1 — '$3' unexpectedly present in: $2"
    else rm_ok "$1"; fi
}

RM_TMPS=()
rm_cleanup() {
    local d
    for d in ${RM_TMPS[@]+"${RM_TMPS[@]}"}; do rm -rf "$d"; done
}
trap rm_cleanup EXIT

# rm_tmp — make a scratch dir, register it for cleanup, print its path.
rm_tmp() {
    local d
    d="$(mktemp -d)"
    RM_TMPS+=("$d")
    printf '%s\n' "$d"
}

# rm_registry <file> <row>... — write a fixture registry with the given data rows.
rm_registry() {
    local f="$1"
    shift
    {
        echo "# fixture registry"
        echo '```'
        echo "| Date       | PR   | Class | Routed to rung | Prior |"
        echo "| ---------- | ---- | ----- | -------------- | ----- |"
        local row
        for row in "$@"; do printf '%s\n' "$row"; done
        echo '```'
    } > "$f"
}

# rm_row <pr> <class> <rung> <dest> <prior>
rm_row() {
    printf '| 2026-08-01 | %s | class: %s | routed to: Rung %s - rule doc %s | prior: %s |' \
        "$1" "$2" "$3" "$4" "$5"
}

# rm_run <registry> <state_dir> [args...] — run the driver, capture rc/out/err.
rm_run() {
    local reg="$1" state="$2" errf
    shift 2
    errf="$(mktemp)"
    RM_OUT="$(RETRO_MINE_REGISTRY="$reg" RETRO_MINE_STATE_DIR="$state" \
        "$RM_DRIVER" "$@" 2>"$errf")"
    RM_RC=$?
    RM_ERR="$(cat "$errf")"
    rm -f "$errf"
}

# ── Scan cases ────────────────────────────────────────────────────────────────
case_scan_row_count() {
    local t; t="$(rm_tmp)"
    rm_registry "$t/reg.md" \
        "$(rm_row '#1' 'alpha' 3 .claude/rules/a.md '--')" \
        "$(rm_row '#2' 'beta' 3 .claude/rules/b.md '--')" \
        "$(rm_row '#3' 'gamma' 4 .claude/rules/c.md '--')" \
        "$(rm_row '#4' 'delta' 1 bin/d '--')" \
        "$(rm_row '#5' 'eps' 2 bin/check-e '--')"
    rm_run "$t/reg.md" "$t/state" --dry-run
    rm_expect_eq "scan_row_count: exit 0" 0 "$RM_RC"
    rm_has "scan_row_count: ROWS 5" "$RM_OUT" "ROWS 5"
    rm_lacks "scan_row_count: header row not parsed" "$RM_OUT" "ROWS 6"
}

case_family_below_min_rows() {
    local t; t="$(rm_tmp)"
    rm_registry "$t/reg.md" \
        "$(rm_row '#1' 'shell quoting' 3 .claude/rules/a.md '--')" \
        "$(rm_row '#2' 'shell globbing' 4 .claude/rules/b.md '--')"
    rm_run "$t/reg.md" "$t/state" --dry-run
    rm_expect_eq "family_below_min_rows: exit 0" 0 "$RM_RC"
    rm_lacks "family_below_min_rows: no shell family" "$RM_OUT" "FAMILY shell"
}

case_single_span_suppressed() {
    local t; t="$(rm_tmp)"
    rm_registry "$t/reg.md" \
        "$(rm_row '#1' 'shell quoting' 3 .claude/rules/a.md '--')" \
        "$(rm_row '#2' 'shell globbing' 3 .claude/rules/a.md '--')" \
        "$(rm_row '#3' 'shell tilde' 3 .claude/rules/a.md '--')"
    rm_run "$t/reg.md" "$t/state" --dry-run
    rm_expect_eq "single_span_suppressed: exit 0" 0 "$RM_RC"
    rm_lacks "single_span_suppressed: no FAMILY line" "$RM_OUT" "FAMILY"
}

case_escalation_flagged() {
    local t; t="$(rm_tmp)"
    rm_registry "$t/reg.md" \
        "$(rm_row '#100' 'first sighting' 2 bin/check-x '--')" \
        "$(rm_row '#200' 'weaker recurrence' 3 .claude/rules/r.md '#100')" \
        "$(rm_row '#300' 'stronger recurrence' 1 bin/check-y '#100')"
    rm_run "$t/reg.md" "$t/state" --dry-run
    rm_expect_eq "escalation_flagged: exit 0" 0 "$RM_RC"
    rm_has "escalation_flagged: weaker recurrence reported" "$RM_OUT" "ESCALATION #200 rung=3 prior=#100 prior_rung=2"
    rm_lacks "escalation_flagged: stronger recurrence not reported" "$RM_OUT" "ESCALATION #300"
}

case_malformed_row_fails() {
    local t; t="$(rm_tmp)"
    rm_registry "$t/reg.md" \
        "$(rm_row '#1' 'alpha' 3 .claude/rules/a.md '--')" \
        "| 2026-08-01 | #2 | class: short | routed to: Rung 3 |"
    rm_run "$t/reg.md" "$t/state" --dry-run
    rm_expect_eq "malformed_row_fails: exit 1" 1 "$RM_RC"
    rm_has "malformed_row_fails: named error" "$RM_ERR" "malformed registry row"
}

case_empty_registry_fails() {
    local t; t="$(rm_tmp)"
    rm_registry "$t/reg.md"
    rm_run "$t/reg.md" "$t/state" --dry-run
    rm_expect_eq "empty_registry_fails: exit 1" 1 "$RM_RC"
    rm_has "empty_registry_fails: named error" "$RM_ERR" "no registry rows parsed"
}

case_state_dedupe() {
    local t; t="$(rm_tmp)"
    mkdir -p "$t/state"
    printf 'family-shell\t3\t2026-09-01\n' > "$t/state/proposed.tsv"
    cp "$t/state/proposed.tsv" "$t/state.before"
    rm_registry "$t/reg3.md" \
        "$(rm_row '#1' 'shell quoting' 3 .claude/rules/a.md '--')" \
        "$(rm_row '#2' 'shell globbing' 4 .claude/rules/b.md '--')" \
        "$(rm_row '#3' 'shell tilde' 3 .claude/rules/c.md '--')"
    rm_run "$t/reg3.md" "$t/state" --dry-run
    rm_has "state_dedupe: 3 rows after a 3-row record is seen" "$RM_OUT" "FAMILY shell rows=3 rungs=3,4 dests=3 prs=#1,#2,#3 status=seen"
    rm_registry "$t/reg5.md" \
        "$(rm_row '#1' 'shell quoting' 3 .claude/rules/a.md '--')" \
        "$(rm_row '#2' 'shell globbing' 4 .claude/rules/b.md '--')" \
        "$(rm_row '#3' 'shell tilde' 3 .claude/rules/c.md '--')" \
        "$(rm_row '#4' 'shell trap' 3 .claude/rules/d.md '--')" \
        "$(rm_row '#5' 'shell glob' 4 .claude/rules/e.md '--')"
    rm_run "$t/reg5.md" "$t/state" --dry-run
    rm_has "state_dedupe: 5 rows after a 3-row record is regrown" "$RM_OUT" "status=regrown"
    if cmp -s "$t/state.before" "$t/state/proposed.tsv"; then
        rm_ok "state_dedupe: --dry-run leaves state byte-identical"
    else
        rm_fail "state_dedupe: --dry-run changed proposed.tsv"
    fi
    rm_run "$t/reg5.md" "$t/state-empty" --dry-run
    rm_has "state_dedupe: missing state file reads as empty (new)" "$RM_OUT" "status=new"
    if [ -e "$t/state-empty" ]; then
        rm_fail "state_dedupe: --dry-run created the state dir"
    else
        rm_ok "state_dedupe: --dry-run creates no state dir"
    fi
}

case_unknown_flag() {
    local t arg; t="$(rm_tmp)"
    rm_registry "$t/reg.md" "$(rm_row '#1' 'alpha' 3 .claude/rules/a.md '--')"
    for arg in --bogus --dry-run=1 x; do
        rm_run "$t/reg.md" "$t/state" "$arg"
        rm_expect_eq "unknown_flag [$arg]: exit 2" 2 "$RM_RC"
        rm_has "unknown_flag [$arg]: stderr names it" "$RM_ERR" "unknown argument"
    done
}

case_empty_env() {
    local t rc err; t="$(rm_tmp)"
    rm_registry "$t/reg.md" "$(rm_row '#1' 'alpha' 3 .claude/rules/a.md '--')"
    RETRO_MINE_REGISTRY='' RETRO_MINE_STATE_DIR="$t/state" "$RM_DRIVER" --dry-run >/dev/null 2>&1
    rc=$?
    rm_expect_eq "empty_env: empty RETRO_MINE_REGISTRY exits 2" 2 "$rc"
    RETRO_MINE_REGISTRY="$t/reg.md" RETRO_MINE_STATE_DIR='' "$RM_DRIVER" --dry-run >/dev/null 2>&1
    rc=$?
    rm_expect_eq "empty_env: empty RETRO_MINE_STATE_DIR exits 2" 2 "$rc"
    err="$(env -i PATH=/usr/bin:/bin RETRO_MINE_REGISTRY="$t/reg.md" "$RM_DRIVER" --dry-run 2>&1 >/dev/null)"
    rc=$?
    rm_expect_eq "empty_env: no HOME and no state var exits 2" 2 "$rc"
    rm_has "empty_env: error names HOME" "$err" "HOME"
    # The colon form ${RETRO_MINE_REGISTRY:-default} treats empty as unset and
    # falls back silently, so the driver must never read the variable that way.
    if grep -qF '${RETRO_MINE_REGISTRY:-' "$RM_DRIVER"; then
        rm_fail "empty_env: driver reads RETRO_MINE_REGISTRY with the colon-dash form"
    else
        rm_ok "empty_env: driver keeps empty distinct from unset"
    fi
}

case_claude_bin_empty() {
    local t rc; t="$(rm_tmp)"
    rm_registry "$t/reg.md" "$(rm_row '#1' 'alpha' 3 .claude/rules/a.md '--')"
    RETRO_MINE_REGISTRY="$t/reg.md" RETRO_MINE_STATE_DIR="$t/state" RETRO_MINE_CLAUDE_BIN='' \
        "$RM_DRIVER" --dry-run >/dev/null 2>&1
    rc=$?
    rm_expect_eq "claude_bin_empty: empty RETRO_MINE_CLAUDE_BIN exits 2" 2 "$rc"
}

case_gh_bin_empty() {
    local t rc; t="$(rm_tmp)"
    rm_registry "$t/reg.md" "$(rm_row '#1' 'alpha' 3 .claude/rules/a.md '--')"
    RETRO_MINE_REGISTRY="$t/reg.md" RETRO_MINE_STATE_DIR="$t/state" RETRO_MINE_GH_BIN='' \
        "$RM_DRIVER" --dry-run >/dev/null 2>&1
    rc=$?
    rm_expect_eq "gh_bin_empty: empty RETRO_MINE_GH_BIN exits 2" 2 "$rc"
    RETRO_MINE_REGISTRY="$t/reg.md" RETRO_MINE_STATE_DIR="$t/state" RETRO_MINE_REPO='' \
        "$RM_DRIVER" --dry-run >/dev/null 2>&1
    rc=$?
    rm_expect_eq "gh_bin_empty: empty RETRO_MINE_REPO exits 2" 2 "$rc"
}

case_launchd_env_dry_run() {
    local t out rc; t="$(rm_tmp)"
    rm_registry "$t/reg.md" "$(rm_row '#1' 'alpha' 3 .claude/rules/a.md '--')"
    out="$(env -i PATH=/usr/bin:/bin HOME="$t" RETRO_MINE_REGISTRY="$t/reg.md" \
        RETRO_MINE_STATE_DIR="$t/state" /bin/bash "$RM_DRIVER" --dry-run 2>&1)"
    rc=$?
    rm_expect_eq "launchd_env_dry_run: exit 0" 0 "$rc"
    rm_has "launchd_env_dry_run: prints ROWS" "$out" "ROWS 1"
}

# ── Cron emitter cases ────────────────────────────────────────────────────────
RM_CRON="$SCRIPT_DIR/retro-mine-cron-setup"

# rm_cron <home> [args...] — run the emitter under a launchd-like env.
rm_cron() {
    local home="$1" errf
    shift
    errf="$(mktemp)"
    RM_OUT="$(env -i PATH=/usr/bin:/bin HOME="$home" "$RM_CRON" "$@" 2>"$errf")"
    RM_RC=$?
    RM_ERR="$(cat "$errf")"
    rm -f "$errf"
}

case_cron_print_schedule_env() {
    local t; t="$(rm_tmp)"
    rm_cron "$t/home" --print-schedule
    rm_expect_eq "cron_print_schedule_env: exit 0" 0 "$RM_RC"
    rm_has "cron_print_schedule_env: label" "$RM_OUT" "<string>com.ibl5.retro-mine</string>"
    rm_has "cron_print_schedule_env: PATH covers brew, system, and expanded HOME" "$RM_OUT" \
        "<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$t/home/.local/bin</string>"
    rm_has "cron_print_schedule_env: weekly key" "$RM_OUT" "<key>Weekday</key>"
    rm_has "cron_print_schedule_env: ProgramArguments target" "$RM_OUT" "/bin/retro-mine</string>"
    if grep -qF '$' <<< "$RM_OUT"; then rm_fail "cron_print_schedule_env: unexpanded \$ in plist"
    else rm_ok "cron_print_schedule_env: no unexpanded \$"; fi
    rm_lacks "cron_print_schedule_env: no empty string" "$RM_OUT" "<string></string>"
    if [ "$(uname -s)" = "Darwin" ] && command -v plutil >/dev/null 2>&1; then
        if plutil -lint - <<< "$RM_OUT" >/dev/null 2>&1; then rm_ok "cron_print_schedule_env: plutil lint"
        else rm_fail "cron_print_schedule_env: plutil lint rejected the plist"; fi
    else
        echo "SKIP: plutil lint (macOS only)"
    fi
}

case_cron_print_no_side_effect() {
    local t; t="$(rm_tmp)"
    rm_cron "$t/home" --print-schedule
    rm_expect_eq "cron_print_no_side_effect: exit 0" 0 "$RM_RC"
    if [ -e "$t/home/Library" ]; then rm_fail "cron_print_no_side_effect: --print-schedule created Library/"
    else rm_ok "cron_print_no_side_effect: no Library/ created"; fi
}

case_cron_unknown_flag() {
    local t arg; t="$(rm_tmp)"
    for arg in --bogus --print-schedule=1; do
        rm_cron "$t/home" "$arg"
        rm_expect_eq "cron_unknown_flag [$arg]: exit 2" 2 "$RM_RC"
    done
    rm_cron "$t/home"
    rm_expect_eq "cron_unknown_flag [no argument]: exit 2" 2 "$RM_RC"
}

case_cron_install_refuses_missing_target() {
    local t rc; t="$(rm_tmp)"
    mkdir -p "$t/fix/bin" "$t/stubs" "$t/home"
    cp "$RM_CRON" "$t/fix/bin/retro-mine-cron-setup"
    printf '#!/bin/sh\necho "$*" >> "%s/launchctl.log"\n' "$t" > "$t/stubs/launchctl"
    chmod +x "$t/stubs/launchctl"
    env -i PATH="$t/stubs:/usr/bin:/bin" HOME="$t/home" \
        "$t/fix/bin/retro-mine-cron-setup" --install-schedule >/dev/null 2>&1
    rc=$?
    rm_expect_eq "cron_install_refuses_missing_target: exit 1" 1 "$rc"
    if [ -s "$t/launchctl.log" ]; then rm_fail "cron_install_refuses_missing_target: launchctl was called"
    else rm_ok "cron_install_refuses_missing_target: no launchctl call"; fi
}

case_expected_jobs_registered() {
    local label
    # shellcheck source=lib/launchd-expected-jobs.sh
    . "$SCRIPT_DIR/lib/launchd-expected-jobs.sh"
    if grep -qxF 'com.ibl5.retro-mine standard' <<< "$LEJ_EXPECTED_JOBS"; then
        rm_ok "expected_jobs_registered: LEJ_EXPECTED_JOBS holds the line"
    else
        rm_fail "expected_jobs_registered: 'com.ibl5.retro-mine standard' absent from LEJ_EXPECTED_JOBS"
    fi
    label="$(sed -n 's/^PLIST_LABEL="\(.*\)"$/\1/p' "$RM_CRON")"
    rm_expect_eq "expected_jobs_registered: plist label matches the registered job" "com.ibl5.retro-mine" "$label"
}

# ── Drafter, validator, and renderer cases ───────────────────────────────────
RM_FIXTURE_ENVELOPE="$SCRIPT_DIR/fixtures/retro-mine/drafter-envelope.json"
RM_TODAY_RE='^last_verified: [0-9]{4}-[0-9]{2}-[0-9]{2}$'

# rm_envelope <result-json> — wrap a result object in a canned CLI envelope.
rm_envelope() {
    jq -nc --argjson r "$1" '{type: "result", is_error: false, structured_output: $r}'
}

RM_RULE_DOC='{"kind":"rule_doc","slug":"shell-demo","description":"A demo rule.","pr_summary":"Summary text.","body":"Body text."}'
RM_TRIGGER_ROW='{"kind":"trigger_row","slug":"shell-row","description":"A demo row.","pr_summary":"Summary text.","trigger_if":"trig cell","must_assert":"assert cell"}'

# rm_tree <dir> — a fixture tree holding one rule doc and a trigger table.
rm_tree() {
    mkdir -p "$1/.claude/rules" "$1/.claude/review-shared"
    printf 'existing rule\n' > "$1/.claude/rules/existing.md"
    cat > "$1/.claude/review-shared/_plan-verification.md" <<'EOF'
---
description: fixture
last_verified: 2020-01-01
---
# Plan verification

## Earlier section

| a | b |
| - | - |
| x | y |

## Forced integration-verification trigger

| Trigger if | Must assert |
| --- | --- |
| first | one |
| second | two |

## Next

| n1 | n2 |
| -- | -- |
| z | z |
EOF
}

# rm_validate <envelope-json> <tree> [render] — source the script under test in a
# subshell, run validate_draft (and render_edit when asked), capture rc and stderr.
rm_validate() {
    local env="$1" tree="$2" render="${3:-}" errf
    errf="$(mktemp)"
    (
        # shellcheck source=/dev/null
        . "$RM_DRIVER"
        set +e
        validate_draft "$env" "$tree" || exit 1
        if [ -n "$render" ]; then render_edit "$tree" || exit 1; fi
    ) 2>"$errf"
    RM_RC=$?
    RM_ERR="$(cat "$errf")"
    rm -f "$errf"
}

case_validate_rule_doc_ok() {
    local t f; t="$(rm_tmp)"
    rm_tree "$t/tree"
    rm_validate "$(rm_envelope "$RM_RULE_DOC")" "$t/tree" render
    rm_expect_eq "validate_rule_doc_ok: exit 0" 0 "$RM_RC"
    f="$t/tree/.claude/rules/shell-demo.md"
    if [ -f "$f" ]; then
        rm_expect_eq "validate_rule_doc_ok: line 1 is the fence" "---" "$(sed -n 1p "$f")"
        rm_has "validate_rule_doc_ok: line 2 is the description" "$(sed -n 2p "$f")" 'description: "A demo rule."'
        if grep -qE "$RM_TODAY_RE" <<< "$(sed -n 3p "$f")"; then rm_ok "validate_rule_doc_ok: line 3 is a script-owned date"
        else rm_fail "validate_rule_doc_ok: line 3 not a last_verified date: $(sed -n 3p "$f")"; fi
        rm_has "validate_rule_doc_ok: heading and body" "$(cat "$f")" "# shell-demo"
        rm_has "validate_rule_doc_ok: body present" "$(cat "$f")" "Body text."
        rm_lacks "validate_rule_doc_ok: no paths key" "$(cat "$f")" "paths:"
    else
        rm_fail "validate_rule_doc_ok: $f not written"
    fi
}

case_validate_rejects_kind() {
    local t; t="$(rm_tmp)"
    rm_tree "$t/tree"
    rm_validate "$(rm_envelope '{"kind":"memory","slug":"x","description":"d","pr_summary":"s"}')" "$t/tree"
    rm_expect_eq "validate_rejects_kind: exit 1" 1 "$RM_RC"
    rm_has "validate_rejects_kind: named reason" "$RM_ERR" "kind not allowlisted"
}

case_validate_rejects_extra_key() {
    local t; t="$(rm_tmp)"
    rm_tree "$t/tree"
    rm_validate "$(rm_envelope '{"kind":"rule_doc","slug":"x","description":"d","pr_summary":"s","body":"b","path":".github/workflows/x.yml"}')" "$t/tree" render
    rm_expect_eq "validate_rejects_extra_key: exit 1" 1 "$RM_RC"
    rm_has "validate_rejects_extra_key: names the key" "$RM_ERR" "unexpected key path"
    rm_expect_eq "validate_rejects_extra_key: nothing written" "1" "$(find "$t/tree/.claude/rules" -type f | wc -l | tr -d ' ')"
    if [ -e "$t/tree/.github" ]; then rm_fail "validate_rejects_extra_key: .github appeared"
    else rm_ok "validate_rejects_extra_key: no .github dir"; fi
}

case_validate_rejects_traversal_slug() {
    local t slug; t="$(rm_tmp)"
    rm_tree "$t/tree"
    for slug in '../../bin/evil' 'a/b' 'a.b' 'Upper' '-lead'; do
        rm_validate "$(rm_envelope "$(jq -nc --arg s "$slug" '{kind:"rule_doc",slug:$s,description:"d",pr_summary:"s",body:"b"}')")" "$t/tree"
        rm_expect_eq "validate_rejects_traversal_slug [$slug]: exit 1" 1 "$RM_RC"
        rm_has "validate_rejects_traversal_slug [$slug]: named reason" "$RM_ERR" "bad slug"
    done
}

case_validate_rejects_existing_dest() {
    local t before; t="$(rm_tmp)"
    rm_tree "$t/tree"
    before="$(cksum < "$t/tree/.claude/rules/existing.md")"
    rm_validate "$(rm_envelope '{"kind":"rule_doc","slug":"existing","description":"d","pr_summary":"s","body":"b"}')" "$t/tree" render
    rm_expect_eq "validate_rejects_existing_dest: exit 1" 1 "$RM_RC"
    rm_has "validate_rejects_existing_dest: named reason" "$RM_ERR" "destination exists"
    rm_expect_eq "validate_rejects_existing_dest: file byte-identical" "$before" "$(cksum < "$t/tree/.claude/rules/existing.md")"
}

case_validate_rejects_pipe_cell() {
    local t; t="$(rm_tmp)"
    rm_tree "$t/tree"
    rm_validate "$(rm_envelope '{"kind":"trigger_row","slug":"x","description":"d","pr_summary":"s","trigger_if":"a | b","must_assert":"c"}')" "$t/tree"
    rm_expect_eq "validate_rejects_pipe_cell: exit 1" 1 "$RM_RC"
    rm_has "validate_rejects_pipe_cell: named reason" "$RM_ERR" "bad trigger cell"
}

case_validate_rejects_bad_body_and_description() {
    local t; t="$(rm_tmp)"
    rm_tree "$t/tree"
    rm_validate "$(rm_envelope '{"kind":"rule_doc","slug":"x","description":"d","pr_summary":"s","body":"---\nfake: frontmatter"}')" "$t/tree"
    rm_expect_eq "validate_rejects_bad_body: exit 1" 1 "$RM_RC"
    rm_has "validate_rejects_bad_body: named reason" "$RM_ERR" "bad body"
    rm_validate "$(rm_envelope '{"kind":"rule_doc","slug":"x","description":"has \"quote\"","pr_summary":"s","body":"b"}')" "$t/tree"
    rm_expect_eq "validate_rejects_bad_description: exit 1" 1 "$RM_RC"
    rm_has "validate_rejects_bad_description: named reason" "$RM_ERR" "bad description"
}

case_render_trigger_row_position() {
    local t f row n tail_before tail_after; t="$(rm_tmp)"
    rm_tree "$t/tree"
    f="$t/tree/.claude/review-shared/_plan-verification.md"
    tail_before="$(sed -n '/^## Next/,$p' "$f")"
    rm_validate "$(rm_envelope "$RM_TRIGGER_ROW")" "$t/tree" render
    rm_expect_eq "render_trigger_row_position: exit 0" 0 "$RM_RC"
    row='| trig cell | assert cell |'
    n="$(grep -nF '| second | two |' "$f" | cut -d: -f1)"
    rm_expect_eq "render_trigger_row_position: row follows the last table row" "$row" "$(sed -n "$((n + 1))p" "$f")"
    tail_after="$(sed -n '/^## Next/,$p' "$f")"
    rm_expect_eq "render_trigger_row_position: following section unchanged" "$tail_before" "$tail_after"
    rm_lacks "render_trigger_row_position: row absent from the following section" "$tail_after" "$row"
    rm_expect_eq "render_trigger_row_position: row appears once" 1 "$(grep -cF "$row" "$f")"
    if grep -qE "$RM_TODAY_RE" <<< "$(sed -n 3p "$f")" && [ "$(sed -n 3p "$f")" != "last_verified: 2020-01-01" ]; then
        rm_ok "render_trigger_row_position: last_verified bumped"
    else
        rm_fail "render_trigger_row_position: last_verified not bumped: $(sed -n 3p "$f")"
    fi
}

case_render_missing_section_fails() {
    local t f before; t="$(rm_tmp)"
    rm_tree "$t/tree"
    f="$t/tree/.claude/review-shared/_plan-verification.md"
    sed 's/^## Forced integration-verification trigger/## Something else/' "$f" > "$f.new"
    mv "$f.new" "$f"
    before="$(cksum < "$f")"
    rm_validate "$(rm_envelope "$RM_TRIGGER_ROW")" "$t/tree" render
    rm_expect_eq "render_missing_section_fails: exit 1" 1 "$RM_RC"
    rm_has "render_missing_section_fails: named reason" "$RM_ERR" "trigger section not found"
    rm_expect_eq "render_missing_section_fails: file unchanged" "$before" "$(cksum < "$f")"
    if [ -e "$f.tmp" ]; then rm_fail "render_missing_section_fails: temp file left behind"
    else rm_ok "render_missing_section_fails: no temp file left"; fi
}

# ── End-to-end fixture: bare remote, seed clone, working clone ───────────────
RM_BRANCH="retro-mine-$(date +%Y%m%d)-shell"

# rm_repo_fixture <t> — three shell rows over Rung 3 and Rung 4, on a bare remote.
rm_repo_fixture() {
    local t="$1"
    export GIT_AUTHOR_NAME=rm GIT_AUTHOR_EMAIL=rm@example.invalid
    export GIT_COMMITTER_NAME=rm GIT_COMMITTER_EMAIL=rm@example.invalid
    git init --quiet --bare "$t/remote.git"
    git -C "$t/remote.git" symbolic-ref HEAD refs/heads/master
    git clone --quiet "$t/remote.git" "$t/seed" 2>/dev/null
    git -C "$t/seed" switch --quiet -c master
    mkdir -p "$t/seed/ibl5/docs"
    rm_registry "$t/seed/ibl5/docs/retrospective-class-registry.md" \
        "$(rm_row '#11' 'shell quoting' 3 .claude/rules/a.md '--')" \
        "$(rm_row '#12' 'shell globbing' 4 .claude/rules/b.md '--')" \
        "$(rm_row '#13' 'shell tilde' 3 .claude/rules/c.md '--')"
    rm_tree "$t/seed"
    git -C "$t/seed" add -A
    git -C "$t/seed" commit --quiet -m seed
    git -C "$t/seed" push --quiet origin master 2>/dev/null
    git clone --quiet "$t/remote.git" "$t/repo" 2>/dev/null
}

# rm_stubs <t> <envelope-file> [claude-rc] [gh-rc] — canned claude and gh.
rm_stubs() {
    local t="$1" envf="$2" crc="${3:-0}" grc="${4:-0}"
    cat > "$t/claude" <<EOF
#!/bin/bash
printf '[%s]\n' "\$@" > "$t/claude.argv"
[ $crc -eq 0 ] || exit $crc
cat "$envf"
EOF
    cat > "$t/gh" <<EOF
#!/bin/bash
echo "\$*" >> "$t/gh.log"
while [ \$# -gt 0 ]; do
    if [ "\$1" = "--body-file" ]; then cp "\$2" "$t/gh-body"; fi
    shift
done
[ $grc -eq 0 ] || exit $grc
echo https://example.invalid/pr/1
EOF
    chmod +x "$t/claude" "$t/gh"
}

# rm_full_run <t> [args...] — a real run against the fixture repo.
rm_full_run() {
    local t="$1" errf
    shift
    errf="$(mktemp)"
    RM_OUT="$(RETRO_MINE_REPO="$t/repo" RETRO_MINE_STATE_DIR="$t/state" \
        RETRO_MINE_CLAUDE_BIN="$t/claude" RETRO_MINE_GH_BIN="$t/gh" \
        "$RM_DRIVER" "$@" 2>"$errf")"
    RM_RC=$?
    RM_ERR="$(cat "$errf")"
    rm -f "$errf"
}

# rm_e2e_setup <t> — fixture repo plus stubs that return a valid rule_doc.
rm_e2e_setup() {
    rm_repo_fixture "$1"
    rm_envelope "$RM_RULE_DOC" > "$1/envelope.json"
    rm_stubs "$1" "$1/envelope.json"
}

case_drafter_argv_deny_all() {
    local t argv; t="$(rm_tmp)"
    rm_e2e_setup "$t"
    rm_full_run "$t"
    argv="$(cat "$t/claude.argv" 2>/dev/null || true)"
    rm_has "drafter_argv_deny_all: --allowedTools passed" "$argv" "[--allowedTools]"
    if awk '$0 == "[--allowedTools]" {getline nxt; if (nxt == "[]") ok = 1} END {exit ok ? 0 : 1}' <<< "$argv"; then
        rm_ok "drafter_argv_deny_all: --allowedTools value is empty"
    else
        rm_fail "drafter_argv_deny_all: --allowedTools not followed by an empty argument"
    fi
    rm_has "drafter_argv_deny_all: --json-schema passed" "$argv" "[--json-schema]"
    rm_lacks "drafter_argv_deny_all: no skip-permissions flag" "$argv" "dangerously-skip-permissions"
}

case_drafter_failure_exits_nonzero() {
    local t; t="$(rm_tmp)"
    rm_repo_fixture "$t"
    rm_envelope "$RM_RULE_DOC" > "$t/envelope.json"
    rm_stubs "$t" "$t/envelope.json" 3
    rm_full_run "$t"
    rm_expect_eq "drafter_failure_exits_nonzero: exit 1" 1 "$RM_RC"
    rm_has "drafter_failure_exits_nonzero: names the drafter exit" "$RM_ERR" "drafter exited 3"
    if [ -s "$t/state/proposed.tsv" ]; then rm_fail "drafter_failure_exits_nonzero: state line written"
    else rm_ok "drafter_failure_exits_nonzero: no state line"; fi
}

case_invalid_json_exits_nonzero() {
    local t; t="$(rm_tmp)"
    rm_repo_fixture "$t"
    printf 'not json\n' > "$t/envelope.json"
    rm_stubs "$t" "$t/envelope.json"
    rm_full_run "$t"
    rm_expect_eq "invalid_json_exits_nonzero: exit 1" 1 "$RM_RC"
    rm_has "invalid_json_exits_nonzero: names the rejection" "$RM_ERR" "no result"
    if [ -s "$t/state/proposed.tsv" ]; then rm_fail "invalid_json_exits_nonzero: state line written"
    else rm_ok "invalid_json_exits_nonzero: no state line"; fi
}

case_e2e_draft_pr() {
    local t sha parent master; t="$(rm_tmp)"
    rm_e2e_setup "$t"
    rm_full_run "$t"
    rm_expect_eq "e2e_draft_pr: exit 0" 0 "$RM_RC"
    sha="$(git -C "$t/remote.git" rev-parse "$RM_BRANCH" 2>/dev/null || true)"
    if [ -n "$sha" ]; then
        rm_ok "e2e_draft_pr: branch pushed"
        parent="$(git -C "$t/remote.git" rev-parse "$sha^")"
        master="$(git -C "$t/remote.git" rev-parse master)"
        rm_expect_eq "e2e_draft_pr: commit sits directly on remote master" "$master" "$parent"
        rm_has "e2e_draft_pr: tree holds the rule doc" \
            "$(git -C "$t/remote.git" ls-tree -r --name-only "$sha")" ".claude/rules/shell-demo.md"
    else
        rm_fail "e2e_draft_pr: branch $RM_BRANCH not on the remote"
    fi
    rm_has "e2e_draft_pr: gh pr create" "$(cat "$t/gh.log" 2>/dev/null)" "pr create"
    rm_has "e2e_draft_pr: --draft" "$(cat "$t/gh.log" 2>/dev/null)" "--draft"
    rm_has "e2e_draft_pr: --base master" "$(cat "$t/gh.log" 2>/dev/null)" "--base master"
    rm_has "e2e_draft_pr: body holds PR #11" "$(cat "$t/gh-body" 2>/dev/null)" "#11"
    rm_has "e2e_draft_pr: body holds PR #12" "$(cat "$t/gh-body" 2>/dev/null)" "#12"
    rm_has "e2e_draft_pr: body holds PR #13" "$(cat "$t/gh-body" 2>/dev/null)" "#13"
    rm_has "e2e_draft_pr: state holds the family and count" "$(cut -f1,2 "$t/state/proposed.tsv" 2>/dev/null)" "$(printf 'family-shell\t3')"
}

case_e2e_dedupe_second_run() {
    local t first second; t="$(rm_tmp)"
    rm_e2e_setup "$t"
    rm_full_run "$t"
    first="$(grep -c 'pr create' "$t/gh.log" 2>/dev/null || true)"
    rm_full_run "$t"
    rm_expect_eq "e2e_dedupe_second_run: exit 0" 0 "$RM_RC"
    rm_has "e2e_dedupe_second_run: second run reports seen" "$RM_OUT" "status=seen"
    second="$(grep -c 'pr create' "$t/gh.log" 2>/dev/null || true)"
    rm_expect_eq "e2e_dedupe_second_run: no second pr create" "$first" "$second"
}

case_main_checkout_untouched() {
    local t branch; t="$(rm_tmp)"
    rm_e2e_setup "$t"
    branch="$(git -C "$t/repo" branch --show-current)"
    rm_full_run "$t"
    rm_expect_eq "main_checkout_untouched: exit 0" 0 "$RM_RC"
    rm_expect_eq "main_checkout_untouched: clean tree" "" "$(git -C "$t/repo" status --porcelain)"
    rm_expect_eq "main_checkout_untouched: branch unchanged" "$branch" "$(git -C "$t/repo" branch --show-current)"
    rm_expect_eq "main_checkout_untouched: one worktree entry" 1 "$(git -C "$t/repo" worktree list | wc -l | tr -d ' ')"
    if git -C "$t/repo" show-ref --verify --quiet "refs/heads/$RM_BRANCH"; then
        rm_fail "main_checkout_untouched: local branch left behind"
    else
        rm_ok "main_checkout_untouched: no local draft branch"
    fi
}

case_gh_failure_exits_nonzero() {
    local t; t="$(rm_tmp)"
    rm_repo_fixture "$t"
    rm_envelope "$RM_RULE_DOC" > "$t/envelope.json"
    rm_stubs "$t" "$t/envelope.json" 0 1
    rm_full_run "$t"
    rm_expect_eq "gh_failure_exits_nonzero: exit 1" 1 "$RM_RC"
    rm_has "gh_failure_exits_nonzero: names the step" "$RM_ERR" "gh pr create failed"
    if [ -s "$t/state/proposed.tsv" ]; then rm_fail "gh_failure_exits_nonzero: state line written"
    else rm_ok "gh_failure_exits_nonzero: no state line"; fi
    rm_expect_eq "gh_failure_exits_nonzero: one worktree entry" 1 "$(git -C "$t/repo" worktree list | wc -l | tr -d ' ')"
}

case_push_failure_exits_nonzero() {
    local t; t="$(rm_tmp)"
    if [ "$(id -u)" -eq 0 ]; then
        echo "SKIP: push_failure_exits_nonzero (root ignores read-only dirs)"
        return 0
    fi
    rm_e2e_setup "$t"
    chmod -R a-w "$t/remote.git"
    rm_full_run "$t"
    chmod -R u+w "$t/remote.git"
    rm_expect_eq "push_failure_exits_nonzero: exit 1" 1 "$RM_RC"
    rm_has "push_failure_exits_nonzero: names the step" "$RM_ERR" "push failed"
    if [ -e "$t/gh.log" ]; then rm_fail "push_failure_exits_nonzero: gh was invoked"
    else rm_ok "push_failure_exits_nonzero: gh never invoked"; fi
    rm_expect_eq "push_failure_exits_nonzero: one worktree entry" 1 "$(git -C "$t/repo" worktree list | wc -l | tr -d ' ')"
}

case_published_branch_not_rewritten() {
    local t before; t="$(rm_tmp)"
    rm_e2e_setup "$t"
    git -C "$t/seed" switch --quiet -c "$RM_BRANCH"
    printf 'published\n' > "$t/seed/published.txt"
    git -C "$t/seed" add -A
    git -C "$t/seed" commit --quiet -m published
    git -C "$t/seed" push --quiet origin "$RM_BRANCH" 2>/dev/null
    before="$(git -C "$t/remote.git" rev-parse "$RM_BRANCH")"
    rm_full_run "$t"
    rm_expect_eq "published_branch_not_rewritten: exit 1" 1 "$RM_RC"
    rm_has "published_branch_not_rewritten: names the guard" "$RM_ERR" "branch exists on origin"
    rm_expect_eq "published_branch_not_rewritten: remote sha unchanged" "$before" "$(git -C "$t/remote.git" rev-parse "$RM_BRANCH")"
}

case_lock_held() {
    local t; t="$(rm_tmp)"
    rm_e2e_setup "$t"
    mkdir -p "$t/state/lock"
    rm_full_run "$t"
    rm_expect_eq "lock_held: exit 1" 1 "$RM_RC"
    rm_has "lock_held: names the lock" "$RM_ERR" "lock held"
    if [ -d "$t/state/lock" ]; then rm_ok "lock_held: the foreign lock survives"
    else rm_fail "lock_held: the run removed a lock it did not create"; fi
}

case_dry_run_no_side_effects() {
    local t refs wts; t="$(rm_tmp)"
    rm_e2e_setup "$t"
    refs="$(git -C "$t/remote.git" for-each-ref)"
    wts="$(git -C "$t/repo" worktree list)"
    rm_full_run "$t" --dry-run
    rm_expect_eq "dry_run_no_side_effects: exit 0" 0 "$RM_RC"
    rm_has "dry_run_no_side_effects: report printed" "$RM_OUT" "FAMILY shell"
    rm_expect_eq "dry_run_no_side_effects: remote refs unchanged" "$refs" "$(git -C "$t/remote.git" for-each-ref)"
    rm_expect_eq "dry_run_no_side_effects: worktrees unchanged" "$wts" "$(git -C "$t/repo" worktree list)"
    if [ -e "$t/state" ]; then rm_fail "dry_run_no_side_effects: state dir created"
    else rm_ok "dry_run_no_side_effects: no state dir"; fi
    if [ -e "$t/gh.log" ] || [ -e "$t/claude.argv" ]; then rm_fail "dry_run_no_side_effects: a stub was invoked"
    else rm_ok "dry_run_no_side_effects: gh and claude never invoked"; fi
}

# ── Real registry and replay cases ───────────────────────────────────────────
case_real_registry_corpus() {
    local t reg want got; t="$(rm_tmp)"
    reg="$SCRIPT_DIR/../ibl5/docs/retrospective-class-registry.md"
    want="$(grep -c '^| 20' "$reg")"
    rm_run "$reg" "$t/state" --dry-run
    rm_expect_eq "real_registry_corpus: exit 0" 0 "$RM_RC"
    got="$(awk '/^ROWS /{print $2}' <<< "$RM_OUT")"
    rm_expect_eq "real_registry_corpus: parsed rows equal table rows" "$want" "$got"
    if [ "${got:-0}" -ge 38 ]; then rm_ok "real_registry_corpus: at least 38 rows"
    else rm_fail "real_registry_corpus: only [$got] rows"; fi
    rm_has "real_registry_corpus: shell family surfaces" "$RM_OUT" "FAMILY shell "
}

case_replay_real_envelope() {
    local t n; t="$(rm_tmp)"
    if [ ! -f "$RM_FIXTURE_ENVELOPE" ]; then
        rm_fail "replay_real_envelope: fixture missing: $RM_FIXTURE_ENVELOPE"
        return 0
    fi
    rm_tree "$t/tree"
    find "$t/tree" -type f -exec cksum {} + | sort > "$t/before"
    rm_validate "$(cat "$RM_FIXTURE_ENVELOPE")" "$t/tree" render
    rm_expect_eq "replay_real_envelope: validate and render exit 0" 0 "$RM_RC"
    find "$t/tree" -type f -exec cksum {} + | sort > "$t/after"
    n="$(comm -13 "$t/before" "$t/after" | wc -l | tr -d ' ')"
    rm_expect_eq "replay_real_envelope: exactly one file written or changed" 1 "$n"
}

case_replay_tampered_kind() {
    local t; t="$(rm_tmp)"
    if [ ! -f "$RM_FIXTURE_ENVELOPE" ]; then
        rm_fail "replay_tampered_kind: fixture missing: $RM_FIXTURE_ENVELOPE"
        return 0
    fi
    rm_tree "$t/tree"
    jq -c 'if (.structured_output | type) == "object" then .structured_output.kind = "memory"
           elif (.result | type) == "string" then .result = ((.result | fromjson) | .kind = "memory" | tojson)
           else .result.kind = "memory" end' "$RM_FIXTURE_ENVELOPE" > "$t/tampered.json"
    rm_validate "$(cat "$t/tampered.json")" "$t/tree"
    rm_expect_eq "replay_tampered_kind: exit 1" 1 "$RM_RC"
    rm_has "replay_tampered_kind: named reason" "$RM_ERR" "kind not allowlisted"
}

# ── Dispatch ──────────────────────────────────────────────────────────────────
RM_ALL_CASES() {
    declare -F | awk '$3 ~ /^case_/ {print $3}'
}

main() {
    local c
    if [ "$#" -gt 0 ]; then
        for c in "$@"; do
            if ! declare -F "$c" >/dev/null 2>&1 || [[ "$c" != case_* ]]; then
                echo "unknown case: $c" >&2
                exit 2
            fi
        done
        for c in "$@"; do "$c"; done
    else
        for c in $(RM_ALL_CASES); do "$c"; done
    fi
    if [ "$FAILED" -ne 0 ]; then
        echo "FAILED"
        exit 1
    fi
    echo "all passed"
}

main "$@"
