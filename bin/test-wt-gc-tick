mk_wt e-old e-old age_days=10; row EMPTY e-old
mk_registry "$CD/registry.json" other e-old
rt "${E_ON[@]}" -- --force
log_has 'live-work e-old: live Claude session' || note_err "session not seen"
[ -d "$(wt_dir e-old)" ] || note_err "removed"
