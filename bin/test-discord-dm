    || fail "G8: a db-backup failure step on the #dev secret went unnoticed"
want "G8: the swapped site is what differs" "$G8_GOT" "db-backup.yml#1 webhook=dev"

# G9: an #errors step that drops its #dev fallback must fail G1's comparison.
# Without the fallback, a missing or renamed DISCORD_ERRORS_WEBHOOK_URL secret
# sends an empty webhook-url and the notify step fails the job.
rm -rf "$TMP/wf"; mkdir -p "$TMP/wf"; cp "$ROOT"/.github/workflows/*.yml "$TMP/wf/"
perl -0pi -e 's/ \|\| secrets\.DISCORD_DEV_WEBHOOK_URL//' "$TMP/wf/main.yml"
G9_GOT=$(notify_sites "$TMP/wf")
[ "$G9_GOT" != "$NOTIFY_SITES_WANT" ] && ok "G9: an #errors site with no #dev fallback fails the table" \
    || fail "G9: an #errors site with no #dev fallback went unnoticed"
want "G9: the site without a fallback is what differs" "$G9_GOT" "main.yml#1 webhook=errors-no-fallback"

# -- no owner mention anywhere in .github/ or bin/ --
# owner_mention_scan <root> reads repo-relative paths on stdin and prints
# path:line:text for each line that builds a mention, a ping: key, --ping, dm_ping
# or --ping-out. MENTION_CARVE_OUTS are path globs it skips, one reason each.
MENTION_SCAN_RE='<@\$|<@[0-9]|users: *\[|--ping([^-[:alnum:]_]|$)|dm_ping|ping-out|^[[:space:]]+ping:'
MENTION_CARVE_OUTS=(
    'bin/sim-recap-*'                 # sim recaps mention league GMs by design, never the owner
    'bin/lib/sim-recap-exemplar.txt'  # the sim-recap style sample; its <@id> mentions are GMs
    'bin/test-*'                      # hostile-text fixtures such as <@123> that prove neutralisation
    'bin/fixtures/*'                  # frozen diff and corpus fixtures
)
owner_mention_scan() { # <root>
    local root="$1" path glob skip
    while IFS= read -r path; do
        [ -n "$path" ] || continue
        skip=0
        for glob in "${MENTION_CARVE_OUTS[@]}"; do
            # shellcheck disable=SC2053  # the right side is a glob on purpose
            if [[ "$path" == $glob ]]; then skip=1; break; fi
        done
        [ "$skip" = 1 ] && continue
        [ -f "$root/$path" ] || continue
        grep -InE -- "$MENTION_SCAN_RE" "$root/$path" 2>/dev/null | sed "s|^|$path:|"
    done
    return 0
}
printf '\n-- no owner mention --\n'

# G4: the live scan over every tracked .github/ and bin/ file prints nothing.
G4_HITS=$(git -C "$ROOT" ls-files -- .github bin | owner_mention_scan "$ROOT")
[ -z "$G4_HITS" ] && ok "G4: no tracked .github/ or bin/ file outside the carve-outs builds a mention or a ping" \
    || fail "G4: mention or ping left: $(head -5 <<< "$G4_HITS" | tr '\n' ' ')"

MS="$TMP/mention-scan"; rm -rf "$MS"; mkdir -p "$MS/bin"
# G5: an owner mention in a non-carved file is caught.
printf '%s\n' 'content="<@$OWNER_ID> $msg"' > "$MS/bin/fake-notifier"
G5_N=$(printf '%s\n' bin/fake-notifier | owner_mention_scan "$MS" | grep -c . || true)
[ "$G5_N" = 1 ] && ok "G5: an owner mention in bin/fake-notifier is one hit" \
    || fail "G5: want 1 hit for bin/fake-notifier, got $G5_N"

# G6: a GM mention under bin/sim-recap-* passes through the carve-out by path.
printf '%s\n' 'line="<@123> scored 40"' > "$MS/bin/sim-recap-fake"
G6_N=$(printf '%s\n' bin/sim-recap-fake | owner_mention_scan "$MS" | grep -c . || true)
[ "$G6_N" = 0 ] && ok "G6: bin/sim-recap-fake's mention is carved out" \
    || fail "G6: want 0 hits for bin/sim-recap-fake, got $G6_N"

# G7: --pinger is a near miss and passes; --ping is caught.
printf '%s\n' '"$DISCORD_DM" --pinger x' > "$MS/bin/fake-caller"
G7_N=$(printf '%s\n' bin/fake-caller | owner_mention_scan "$MS" | grep -c . || true)
[ "$G7_N" = 0 ] && ok "G7: --pinger passes the scan" || fail "G7: --pinger was flagged ($G7_N hits)"
printf '%s\n' '"$DISCORD_DM" --ping x' > "$MS/bin/fake-caller2"
G7_N=$(printf '%s\n' bin/fake-caller2 | owner_mention_scan "$MS" | grep -c . || true)
[ "$G7_N" = 1 ] && ok "G7: --ping is caught" || fail "G7: want 1 hit for --ping, got $G7_N"

# S1: the removed SSH inputs are gone from every site.
S1_LEFT=$(notify_scan "$ROOT/.github/workflows" lines | grep -E $'\t(discord-id|port|host|username):')
[ -z "$S1_LEFT" ] && ok "S1: no discord-id/port/host/username in a notify block" \
    || fail "S1: removed inputs remain: $(tr '\n' ' ' <<< "$S1_LEFT")"

# S2: a job that still runs ssh/scp must keep its setup-ssh step. Jobs split on
# `^  <name>:$`; lines before the first header (file comments) belong to no job.
ssh_scan() { # <wf-dir>: prints "<file>::<job>" for each job with ssh use but no setup-ssh
    local f
    for f in "$1"/*.yml; do
        awk -v file="$(basename "$f")" '
            function flush() {
                if (job != "" && uses_ssh && !has_setup) print file "::" job
            }
            { sub(/\r$/, "") }
            /^  [A-Za-z0-9_-]+:$/ { flush(); job = $0; sub(/^ +/, "", job); sub(/:$/, "", job); uses_ssh = 0; has_setup = 0; next }
            /actions\/setup-ssh/ { has_setup = 1 }
            /id_deploy|ssh -|scp -|--ssh-key/ { uses_ssh = 1 }
            END { flush() }' "$f"
    done | LC_ALL=C sort
}
S2_BAD=$(ssh_scan "$ROOT/.github/workflows")
[ -z "$S2_BAD" ] && ok "S2: every job that runs ssh/scp keeps its setup-ssh step" \
    || fail "S2: ssh/scp without setup-ssh in: $(tr '\n' ' ' <<< "$S2_BAD")"

# S2 self-test: dropping main.yml's setup-ssh line must be flagged.
rm -rf "$TMP/wf"; mkdir -p "$TMP/wf"; cp "$ROOT"/.github/workflows/*.yml "$TMP/wf/"
perl -ni -e 'print unless m{uses: \./\.github/actions/setup-ssh}' "$TMP/wf/main.yml"
S2_GOT=$(ssh_scan "$TMP/wf")
[ -n "$S2_GOT" ] && ok "S2: a dropped setup-ssh step in main.yml is flagged" \
    || fail "S2: a dropped setup-ssh step in main.yml went unnoticed"
grep -qF -- "main.yml::build-and-deploy" <<< "$S2_GOT" \
    && ok "S2: the flagged job is main.yml::build-and-deploy" \
    || fail "S2: expected main.yml::build-and-deploy, got: $(tr '\n' ' ' <<< "$S2_GOT")"

# D1: bin/lib/dm.sh (dm_bin, dm_send, dm_error). Each snippet runs under a bare strict bash.
DMLIB="$ROOT/bin/lib/dm.sh"
dmlib() {   # dmlib '<snippet>' [VAR=val ...]
    local snip="$1"; shift
    env -i IBL5_USAGE_GATE_STATE_DIR="$IBL5_USAGE_GATE_STATE_DIR" IBL5_USAGE_CLAUDE_PROJECTS="$IBL5_USAGE_CLAUDE_PROJECTS" IBL5_USAGE_GATE_TEST_MODE="$IBL5_USAGE_GATE_TEST_MODE" PATH=/usr/bin:/bin "$@" bash -c 'set -euo pipefail; . "$1"; '"$snip" _ "$DMLIB"
}
DM_REC="$TMP/dm-rec"
cat > "$DM_REC" <<REC_EOF
#!/usr/bin/env bash
: > "$TMP/dm-rec.argv"
for a in "\$@"; do printf '%s\n' "\$a" >> "$TMP/dm-rec.argv"; done
exit "\${DM_REC_RC:-0}"
REC_EOF
chmod +x "$DM_REC"

out=$(dmlib 'dm_bin /x/bin FOO_DM'); rc=$?
[ "$rc" -eq 0 ] && [ "$out" = "/x/bin/discord-dm" ] \
    && ok "D1a unset seam falls back to <bin-dir>/discord-dm" || fail "D1a unset seam (rc=$rc out=$out)"
# Mutation check: ${!name-} in place of ${!name:-} in dm_bin fails this case.
out=$(dmlib 'dm_bin /x/bin FOO_DM' FOO_DM=)
[ "$out" = "/x/bin/discord-dm" ] \
    && ok "D1b empty seam falls back like :-" || fail "D1b empty seam (out=$out)"
out=$(dmlib 'dm_bin /x/bin FOO_DM' FOO_DM=/s/dm)
[ "$out" = "/s/dm" ] && ok "D1c set seam wins" || fail "D1c set seam (out=$out)"
out=$(dmlib 'dm_bin /x A B' A= B=/b)
[ "$out" = "/b" ] && ok "D1d first non-empty seam wins (A empty)" || fail "D1d A empty (out=$out)"
out=$(dmlib 'dm_bin /x A B' A=/a B=/b)
[ "$out" = "/a" ] && ok "D1d first non-empty seam wins (A set)" || fail "D1d A set (out=$out)"

rm -f "$TMP/pwned"
for d1_name in 'bad-name' '1X' "a[\$(touch $TMP/pwned)]"; do
    err=$(dmlib 'dm_bin /x "$N"' "N=$d1_name" 2>&1 >/dev/null); rc=$?
    [ "$rc" -eq 2 ] && [ ! -e "$TMP/pwned" ] && grep -qF 'dm_bin: invalid seam name' <<< "$err" \
        && ok "D1e invalid seam name rejected: $d1_name" \
        || fail "D1e invalid seam name '$d1_name' (rc=$rc err=$err pwned=$([ -e "$TMP/pwned" ] && echo yes || echo no))"
done
err=$(dmlib 'dm_bin' 2>&1 >/dev/null); rc=$?
[ "$rc" -eq 2 ] && grep -qF 'dm_bin: missing <bin-dir>' <<< "$err" \
    && ok "D1f missing bin-dir returns 2" || fail "D1f missing bin-dir (rc=$rc err=$err)"

dmlib 'dm_error "hello world" --quiet --attempts 2' DM_CMD="$DM_REC"
[ "$(cat "$TMP/dm-rec.argv")" = "$(printf '%s\n' --error --quiet --attempts 2 'hello world')" ] \
    && ok "D1g dm_error puts --error first, flags next, message last" \
    || fail "D1g dm_error argv: $(tr '\n' '|' < "$TMP/dm-rec.argv")"
dmlib 'dm_send msg --quiet' DM_CMD="$DM_REC"
[ "$(cat "$TMP/dm-rec.argv")" = "$(printf '%s\n' --quiet msg)" ] \
    && ok "D1h dm_send passes flags then the message, with no --error" \
    || fail "D1h argv: $(tr '\n' '|' < "$TMP/dm-rec.argv")"
for d1_fn in dm_send dm_error; do
    out=$(dmlib "$d1_fn"' m || echo "rc=$?"' DM_CMD="$DM_REC" DM_REC_RC=3)
    [ "$out" = "rc=3" ] && ok "D1i $d1_fn propagates discord-dm's exit status" || fail "D1i $d1_fn (out=$out)"
    rm -f "$TMP/dm-rec.argv"
    out=$(dmlib "$d1_fn"' m || echo "rc=$?"' 2>"$TMP/d1j.err")
    [ "$out" = "rc=2" ] && grep -qF "$d1_fn: DM_CMD is not set" "$TMP/d1j.err" && [ ! -e "$TMP/dm-rec.argv" ] \
        && ok "D1j $d1_fn with DM_CMD unset returns 2 without calling the recorder" || fail "D1j $d1_fn (out=$out)"
    out=$(dmlib "$d1_fn"' || echo "rc=$?"' DM_CMD="$DM_REC" 2>"$TMP/d1j.err")
    [ "$out" = "rc=2" ] && grep -qF "$d1_fn: missing <msg>" "$TMP/d1j.err" \
        && ok "D1j $d1_fn with no message returns 2" || fail "D1j $d1_fn no message (out=$out)"
done
out=$(env -i IBL5_USAGE_GATE_STATE_DIR="$IBL5_USAGE_GATE_STATE_DIR" IBL5_USAGE_CLAUDE_PROJECTS="$IBL5_USAGE_CLAUDE_PROJECTS" IBL5_USAGE_GATE_TEST_MODE="$IBL5_USAGE_GATE_TEST_MODE" PATH=/usr/bin:/bin bash -c 'set -euo pipefail; a=$(set +o); . "$1"; b=$(set +o); [ "$a" = "$b" ] && echo same' _ "$DMLIB")
[ "$out" = "same" ] && ok "D1k sourcing leaves shell options unchanged" || fail "D1k (out=$out)"

# ── S1: sent log (one tab-separated line per delivered message) ───────────────
printf '\n── S1: sent log ──\n'
SENT="$TMP/sent.log"
TAB=$(printf '\t')
: > "$CAP"; rm -f "$SENT"
printf 'tab\there\rcr first line that is much longer than sixty characters in total length\nsecond' > "$TMP/s1msg.txt"
DM_CAPTURE="$CAP" DISCORD_DM_SSH_BIN="$SSH_OK" DISCORD_DM_SPOOL="$SPOOL" DISCORD_DM_SENT_LOG="$SENT" \
    DISCORD_DM_CALLER=my-script "$DM" --to "$FAKE_TO" --attempts 1 --quiet - < "$TMP/s1msg.txt"
s1_rc=$?
[ "$s1_rc" = 0 ] && ok "S1a success exits 0" || fail "S1a exit $s1_rc"
[ "$(wc -l < "$SENT" | tr -d ' ')" = 1 ] && ok "S1b exactly one line" || fail "S1b lines: $(cat "$SENT" 2>/dev/null)"
IFS="$TAB" read -r s_ts s_kind s_caller s_len s_prev < "$SENT"
case "$s_ts" in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]*) ok "S1c ISO timestamp" ;; *) fail "S1c ts=$s_ts" ;; esac
[ "$s_kind" = dm ] && ok "S1d kind dm" || fail "S1d kind=$s_kind"
[ "$s_caller" = my-script ] && ok "S1e caller from env" || fail "S1e caller=$s_caller"
[ "$s_len" = "$(wc -c < "$TMP/s1msg.txt" | tr -d ' ')" ] && ok "S1f byte length" || fail "S1f len=$s_len"
[ "$s_prev" = "tab here cr first line that is much longer than sixty charac" ] && ok "S1g preview 60 chars, whitespace flattened" || fail "S1g prev=[$s_prev]"

# Chunked send counts once.
rm -f "$SENT"; : > "$CAP"
DM_CAPTURE="$CAP" DISCORD_DM_SSH_BIN="$SSH_OK" DISCORD_DM_SPOOL="$SPOOL" DISCORD_DM_SENT_LOG="$SENT" \
    "$DM" --to "$FAKE_TO" --attempts 1 --quiet --chunk - < "$FIXTURE"
[ "$(wc -l < "$SENT" | tr -d ' ')" = 1 ] && ok "S1h chunked send logs once" || fail "S1h lines: $(wc -l < "$SENT")"

# Webhook routes: dev, errors.
rm -f "$SENT"
DISCORD_DM_CURL_BIN="$CURL_NEVER" DISCORD_DM_WEBHOOK_FILE="$FAKE_WEBHOOK_FILE" DISCORD_DM_SPOOL="$SPOOL" \
    DISCORD_DM_SENT_LOG="$SENT" "$DM" --to "$OWNER_ID" --attempts 1 --quiet "dev msg"
DISCORD_DM_CURL_BIN="$CURL_NEVER" DISCORD_DM_WEBHOOK_FILE="$FAKE_WEBHOOK_FILE" DISCORD_DM_ERRORS_WEBHOOK_FILE="$FAKE_WEBHOOK_FILE" \
    DISCORD_DM_SPOOL="$SPOOL" DISCORD_DM_SENT_LOG="$SENT" "$DM" --to "$OWNER_ID" --attempts 1 --quiet --error "err msg"
[ "$(cut -f2 "$SENT" | tr '\n' ' ')" = "dev errors " ] && ok "S1i webhook kinds dev then errors" || fail "S1i kinds: $(cut -f2 "$SENT" | tr '\n' ' ')"

# Raw route.
rm -f "$SENT"; : > "$CAP"
DM_CAPTURE="$CAP" DISCORD_DM_SSH_BIN="$SSH_OK" DISCORD_DM_SPOOL="$SPOOL" DISCORD_DM_SENT_LOG="$SENT" \
    "$DM" --attempts 1 --quiet --raw --route /plan-review '{"a":1}'
[ "$(cut -f2 "$SENT")" = "route:/plan-review" ] && ok "S1j raw route kind" || fail "S1j kind: $(cut -f2 "$SENT")"

# Caller fallback with no env: never empty.
rm -f "$SENT"; : > "$CAP"
env -u DISCORD_DM_CALLER DM_CAPTURE="$CAP" DISCORD_DM_SSH_BIN="$SSH_OK" DISCORD_DM_SPOOL="$SPOOL" DISCORD_DM_SENT_LOG="$SENT" \
    "$DM" --to "$FAKE_TO" --attempts 1 --quiet "x"
[ "$(cut -f3 "$SENT")" = test-discord-dm ] && ok "S1k caller fallback is the parent script (test-discord-dm)" || fail "S1k empty caller"

# Failure writes no sent-log line.
rm -f "$SENT"; rm -f "$SPOOL"
printf '#!/bin/bash\ncat >/dev/null\nprintf "\\nHTTP=400 curl_rc=0\\n"\n' > "$TMP/ssh-400"; chmod +x "$TMP/ssh-400"
DISCORD_DM_SSH_BIN="$TMP/ssh-400" DISCORD_DM_SPOOL="$SPOOL" DISCORD_DM_SENT_LOG="$SENT" \
    "$DM" --to "$FAKE_TO" --attempts 1 --quiet "will fail" 2>/dev/null
s1_rc=$?
{ [ "$s1_rc" = 1 ] && [ ! -s "$SENT" ]; } && ok "S1l failure: exit 1, no sent-log line" || fail "S1l rc=$s1_rc sent=$(cat "$SENT" 2>/dev/null)"

# Unwritable sent-log path: exit code and output unchanged.
: > "$CAP"
printf 'x' > "$TMP/notadir"
out_bad=$(DM_CAPTURE="$CAP" DISCORD_DM_SSH_BIN="$SSH_OK" DISCORD_DM_SPOOL="$SPOOL" DISCORD_DM_SENT_LOG="$TMP/notadir/sub/log" \
    "$DM" --to "$FAKE_TO" --attempts 1 "unwritable" 2>&1)
bad_rc=$?
: > "$CAP"
out_good=$(DM_CAPTURE="$CAP" DISCORD_DM_SSH_BIN="$SSH_OK" DISCORD_DM_SPOOL="$SPOOL" DISCORD_DM_SENT_LOG="$TMP/good.log" \
    "$DM" --to "$FAKE_TO" --attempts 1 "unwritable" 2>&1)
{ [ "$bad_rc" = 0 ] && [ "$out_bad" = "$out_good" ]; } && ok "S1m unwritable sent log: exit 0, same output" || fail "S1m rc=$bad_rc out=[$out_bad] vs [$out_good]"
out=$(DM_CAPTURE="$CAP" DISCORD_DM_SSH_BIN="$SSH_OK" DISCORD_DM_SPOOL="$SPOOL" DISCORD_DM_SENT_LOG="$TMP/notadir/sub/log" \
    "$DM" --to "$FAKE_TO" --attempts 1 --quiet "q" 2>&1)
[ -z "$out" ] && ok "S1n --quiet stays quiet when logging fails" || fail "S1n out=[$out]"
"$DM" --help | tail -1 | grep -q '^Exit:' && ok "S1o --help ends at the Exit line" || fail "S1o help tail: $("$DM" --help | tail -1)"

# ── S2: dev inbox (full message for bin/dev-inbox) ────────────────────────────
printf '\n── S2: dev inbox ──\n'
INB="$TMP/inbox.log"
DEV_INBOX="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/dev-inbox"
rm -f "$INB"; : > "$CAP"
printf '@@ fake header\nline two' > "$TMP/s2msg.txt"
DM_CAPTURE="$CAP" DISCORD_DM_SSH_BIN="$SSH_OK" DISCORD_DM_SPOOL="$SPOOL" DISCORD_DM_SENT_LOG="$SENT" \
    DISCORD_DM_INBOX="$INB" DISCORD_DM_CALLER="my script" "$DM" --to "$FAKE_TO" --attempts 1 --quiet - < "$TMP/s2msg.txt"
s2_hdr=$(head -n 1 "$INB")
case "$s2_hdr" in "@@ "[0-9][0-9][0-9][0-9]-*" dm my_script") ok "S2a header: time, target, caller with no spaces" ;; *) fail "S2a header=[$s2_hdr]" ;; esac
[ "$(sed -n 2,3p "$INB")" = "$(printf '  @@ fake header\n  line two')" ] && ok "S2b body indented, so a body line never reads as a header" || fail "S2b body=[$(sed -n 2,3p "$INB")]"
[ "$(grep -c '^@@ ' "$INB")" = 1 ] && ok "S2c one header per message" || fail "S2c headers=$(grep -c '^@@ ' "$INB")"

rm -f "$INB"; : > "$CAP"
DM_CAPTURE="$CAP" DISCORD_DM_SSH_BIN="$SSH_OK" DISCORD_DM_SPOOL="$SPOOL" DISCORD_DM_SENT_LOG="$SENT" \
    DISCORD_DM_INBOX="$INB" "$DM" --attempts 1 --quiet --raw --route /discordApproveDM '{"a":1}'
{ grep -q '^@@ .* raw:/discordApproveDM ' "$INB" && grep -qF 'Open Discord to act on it.' "$INB" && ! grep -qF '{"a":1}' "$INB"; } \
    && ok "S2d raw: a note to open Discord, not the JSON" || fail "S2d inbox=[$(cat "$INB")]"

rm -f "$INB"; : > "$CAP"
DM_CAPTURE="$CAP" DISCORD_DM_SSH_BIN="$SSH_OK" DISCORD_DM_SPOOL="$SPOOL" DISCORD_DM_SENT_LOG="$SENT" \
    DISCORD_DM_INBOX="$INB" "$DM" --to "$FAKE_TO" --attempts 1 --quiet --route /otherDM "✅ done"
grep -q '^@@ .* route:/otherDM ' "$INB" && ok "S2l plain text on another route keeps the route: target" || fail "S2l inbox=[$(cat "$INB")]"
r_out=$(DISCORD_DM_INBOX="$INB" "$DEV_INBOX" --once)
[[ "$r_out" != *$'\007'* ]] && ok "S2m a plain route: entry does not ring" || fail "S2m out=[$r_out]"

rm -f "$INB" "$SPOOL"
DISCORD_DM_SSH_BIN="$TMP/ssh-400" DISCORD_DM_SPOOL="$SPOOL" DISCORD_DM_SENT_LOG="$SENT" DISCORD_DM_INBOX="$INB" \
    "$DM" --to "$FAKE_TO" --attempts 1 --quiet "lost one" 2>/dev/null
{ grep -q '^@@ .* undelivered ' "$INB" && grep -qF '  lost one' "$INB"; } \
    && ok "S2e failure: inbox entry with target undelivered" || fail "S2e inbox=[$(cat "$INB" 2>/dev/null)]"

: > "$CAP"
out=$(DM_CAPTURE="$CAP" DISCORD_DM_SSH_BIN="$SSH_OK" DISCORD_DM_SPOOL="$SPOOL" DISCORD_DM_SENT_LOG="$SENT" \
    DISCORD_DM_INBOX="$TMP/notadir/sub/inbox" "$DM" --to "$FAKE_TO" --attempts 1 --quiet "q" 2>&1)
s2_rc=$?
{ [ "$s2_rc" = 0 ] && [ -z "$out" ]; } && ok "S2f unwritable inbox: exit 0, quiet" || fail "S2f rc=$s2_rc out=[$out]"

# bin/dev-inbox --once: the bell rings only on alert entries.
BEL=$(printf '\007')
printf '%s\n' '@@ 2026-11-25T11:00:00-0800 dev a' '  ✅ fine' \
    '@@ 2026-11-25T11:01:00-0800 dev b' '  ❓ need you' \
    '@@ 2026-11-25T11:02:00-0800 errors c' '  boom' \
    '@@ 2026-11-25T11:03:00-0800 dev d' '  plain' '  ❌ not first line' \
    '@@ 2026-11-25T11:04:00-0800 dev e' '  🛑 STOPPED' \
    '@@ 2026-11-25T11:05:00-0800 dev f' '  ⏱ TIMED OUT' \
    '@@ 2026-11-25T11:06:00-0800 dev g' '  💥 runner exited rc=1' \
    '@@ 2026-11-25T11:07:00-0800 raw:/discordApproveDM h' '  (button note)' \
    '@@ 2026-11-25T11:08:00-0800 route:/otherDM i' '  ✅ done' > "$TMP/r.log"
r_out=$(DISCORD_DM_INBOX="$TMP/r.log" "$DEV_INBOX" --once)
r_bells=$(tr -cd "$BEL" <<< "$r_out" | wc -c | tr -d ' ')
[ "$r_bells" = 6 ] && ok "S2g bell rings for ❓ 🛑 ⏱ 💥, #errors and raw: only" || fail "S2g bells=$r_bells"
grep -qF "2026-11-25 11:01" <<< "$r_out" && ok "S2h date and time shown" || fail "S2h out=[$r_out]"
grep -qxF "plain" <<< "$r_out" && ok "S2i body shown without its indent" || fail "S2i out=[$r_out]"
r_out=$(DISCORD_DM_INBOX="$TMP/r.log" "$DEV_INBOX" --once --no-bell)
r_bells=$(tr -cd "$BEL" <<< "$r_out" | wc -c | tr -d ' ')
[ "$r_bells" = 0 ] && ok "S2j --no-bell rings nothing" || fail "S2j bells=$r_bells"
DISCORD_DM_INBOX="$TMP/r.log" "$DEV_INBOX" --last x >/dev/null 2>&1
s2_rc=$?
[ "$s2_rc" = 2 ] && ok "S2k bad --last exits 2" || fail "S2k rc=$s2_rc"

# Follow mode. This tail stub adds an entry just before the viewer starts to
# follow, then drops -F so the viewer reads to the end and exits.
mkdir -p "$TMP/s2bin"
cat > "$TMP/s2bin/tail" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' '@@ 2026-11-25T12:02:00-0800 errors late' '  late boom' >> "$DISCORD_DM_INBOX"
args=()
for a in "$@"; do [ "$a" = -F ] || args+=("$a"); done
exec "$REAL_TAIL" "${args[@]}"
EOF
chmod +x "$TMP/s2bin/tail"
S2_TAIL=$(command -v tail)
printf '%s\n' '@@ 2026-11-25T12:00:00-0800 errors a' '  old boom 1' \
    '@@ 2026-11-25T12:01:00-0800 errors b' '  old boom 2' > "$TMP/f.log"
r_out=$(PATH="$TMP/s2bin:$PATH" REAL_TAIL="$S2_TAIL" DISCORD_DM_INBOX="$TMP/f.log" "$DEV_INBOX" --last 1)
r_bells=$(tr -cd "$BEL" <<< "$r_out" | wc -c | tr -d ' ')
[[ "$r_out" == *"old boom 2"*"watching"*"late boom"* ]] \
    && ok "S2n an entry added during startup shows after the watching line" || fail "S2n out=[$r_out]"
[ "$r_bells" = 1 ] && ok "S2o only the startup-time entry rings, not the backlog" || fail "S2o bells=$r_bells"
[[ "$r_out" != *"old boom 1"* ]] && ok "S2p --last trims the backlog" || fail "S2p out=[$r_out]"
: > "$TMP/f.log"
r_out=$(PATH="$TMP/s2bin:$PATH" REAL_TAIL="$S2_TAIL" DISCORD_DM_INBOX="$TMP/f.log" "$DEV_INBOX")
r_bells=$(tr -cd "$BEL" <<< "$r_out" | wc -c | tr -d ' ')
{ [[ "$r_out" == *"watching"*"late boom"* ]] && [ "$r_bells" = 1 ]; } \
    && ok "S2q empty inbox: watching line first, new entry rings" || fail "S2q bells=$r_bells out=[$r_out]"

# ── Summary ───────────────────────────────────────────────────────────────────
h_done
