JSON

BACKEND=ibl5/classes/Team/TeamService.php
ui_decide_is ui_decide_tooling_only_passes not-ui 0 "" bin/some-tool .claude/rules/x.md
ui_decide_is ui_decide_backend_changed_cell_holds ui-vr 1 "$UI_TMP/g-changed.json" "$BACKEND"
ui_decide_is ui_decide_new_cell_holds ui-vr 1 "$UI_TMP/g-new.json" "$BACKEND"
ui_decide_is ui_decide_strict_and_flake_pass not-ui 1 "$UI_TMP/g-strict-flake.json" "$BACKEND"
ui_decide_is ui_decide_missing_gallery_holds vr-missing 1 "$UI_TMP/does-not-exist.json" "$BACKEND"
ui_decide_is ui_decide_zero_rendered_holds vr-missing 1 "$UI_TMP/g-zero.json" "$BACKEND"
ui_decide_is ui_decide_empty_paths_holds ui-unknown 0 ""

printf 'docs/x.md\n' > "$UI_TMP/deny.txt"
# shellcheck disable=SC2016  # $1/$2 expand inside the child bash
UI_R=$(bash -c 'set -euo pipefail; source "$1"; ui_renderable "$2" "dependabot[bot]"' _ "$UI_LIB" "$UI_TMP/deny.txt" 2>&1)
same ui_renderable_dependabot_forced "$UI_R" 1
# shellcheck disable=SC2016  # $1/$2 expand inside the child bash
UI_R=$(bash -c 'set -euo pipefail; source "$1"; ui_renderable "$2" "a-jay85"' _ "$UI_LIB" "$UI_TMP/deny.txt" 2>&1)
same "ui_renderable: a human's deny-listed docs path prints 0" "$UI_R" 0
ui_decide_is ui_decide_dependabot_clean_gallery_passes not-ui 1 "$UI_TMP/g-clean.json" \
    ibl5/IBLbot/package.json ibl5/IBLbot/package-lock.json
# The VR job runs `bun install` and `composer install` from the PR head, so a
# bump of the app's own package or lock file holds on its path, gallery or not.
# ui_decide gets no dev_patch flag here, so the verdict stays ui-paths. The flag
# cases below and the dp_ cases cover the Dependabot dev-dependency patch
# exemption (ADR-0062 Update 2026-11-13).
ui_decide_is ui_decide_dependabot_app_lockfile_holds ui-paths 1 "$UI_TMP/g-clean.json" \
    ibl5/composer.lock ibl5/package.json ibl5/bun.lock
# ui_decide_flag_is <name> <expected_verdict> <renderable> <gallery_or_empty> <dev_patch> <path>...
ui_decide_flag_is() {
    local name="$1" want_v="$2" renderable="$3" gallery="$4" flag="$5" pf
    shift 5
    pf="$UI_TMP/paths-$name.txt"
    printf '%s\n' "$@" > "$pf"
    # shellcheck disable=SC2016  # $1.. expand inside the child bash
    LAST_OUT=$(bash -c 'set -euo pipefail; source "$1"; ui_decide "$2" "$3" "$4" "$5" || true' \
        _ "$UI_LIB" "$pf" "$renderable" "$gallery" "$flag" 2>&1)
    if [ "$LAST_OUT" = "$want_v" ]; then h_pass "$name"; else h_fail "$name" "expected [$want_v] got [$LAST_OUT]"; fi
}
ui_decide_flag_is ui_decide_dev_patch_flag_clean_gallery_passes not-ui 1 "$UI_TMP/g-clean.json" 1 \
    ibl5/package.json ibl5/bun.lock
ui_decide_flag_is ui_decide_dev_patch_flag_composer_lock_holds ui-paths 1 "$UI_TMP/g-clean.json" 1 \
    ibl5/composer.lock ibl5/package.json ibl5/bun.lock
ui_decide_flag_is ui_decide_dev_patch_flag_zero_holds ui-paths 1 "$UI_TMP/g-clean.json" 0 \
    ibl5/package.json ibl5/bun.lock
ui_decide_is ui_decide_dev_patch_flag_absent_holds ui-paths 1 "$UI_TMP/g-clean.json" \
    ibl5/package.json ibl5/bun.lock

# ui_await_run <attempts> <rc...> — ui_await_gallery with sleep 0 and a stub
# fetch that returns the next rc from the list on each call (the last rc
# repeats). Sets UI_AWAIT_RC and UI_AWAIT_CALLS.
cat > "$UI_TMP/stub-fetch.sh" <<'SH'
# shellcheck shell=bash
stub_fetch() {
    local n i
    echo call >> "$UI_STUB_CALLS"
    n=$(wc -l < "$UI_STUB_CALLS")
    read -r -a UI_STUB_SEQ_A <<< "$UI_STUB_SEQ"
    i=$((n - 1))
    if [ "$i" -ge "${#UI_STUB_SEQ_A[@]}" ]; then i=$((${#UI_STUB_SEQ_A[@]} - 1)); fi
    return "${UI_STUB_SEQ_A[$i]}"
}
SH
ui_await_run() {
    local attempts="$1" rc=0
    shift
    : > "$UI_TMP/calls"
    # shellcheck disable=SC2016  # $1.. expand inside the child bash
    UI_STUB_CALLS="$UI_TMP/calls" UI_STUB_SEQ="$*" bash -c \
        'set -euo pipefail; source "$1"; source "$2"; ui_await_gallery "$3" 0 stub_fetch "$4"' \
        _ "$UI_LIB" "$UI_TMP/stub-fetch.sh" "$attempts" "$UI_TMP/out.json" > /dev/null 2>&1 || rc=$?
    UI_AWAIT_RC=$rc
    UI_AWAIT_CALLS=$(wc -l < "$UI_TMP/calls" | tr -d ' ')
}
ui_await_case() { # name want_rc want_calls
    if [ "$UI_AWAIT_RC" = "$2" ] && [ "$UI_AWAIT_CALLS" = "$3" ]; then
        h_pass "$1"
    else
        h_fail "$1" "rc=$UI_AWAIT_RC calls=$UI_AWAIT_CALLS (want rc=$2 calls=$3)"
    fi
}
ui_await_run 3 1;   ui_await_case ui_await_gallery_bounded 1 3
ui_await_run 5 1 0; ui_await_case ui_await_gallery_found_late 0 2
ui_await_run 5 3;   ui_await_case ui_await_gallery_stops_on_completed 1 1

# Approval race: the `labeled human-approved` run must not wait on the gallery.
# A sync run gives up on the record after HS_AWAIT_ATTEMPTS x HS_AWAIT_SLEEP
# (about 5 min); the gallery wait runs up to UI_VR_ATTEMPTS x UI_VR_SLEEP
# (about 45 min). The stub fetch stays pending, so any wait shows as calls.
# ui_verdict_run <action> <event_label>: sets UI_WV (verdict) and UI_WV_CALLS.
ui_verdict_run() {
    : > "$UI_TMP/calls"
    # shellcheck disable=SC2016  # $1.. expand inside the child bash
    UI_WV=$(UI_STUB_CALLS="$UI_TMP/calls" UI_STUB_SEQ=1 UI_VR_ATTEMPTS=3 UI_VR_SLEEP=0 bash -c \
        'set -euo pipefail; source "$1"; source "$2"; ui_workflow_verdict "$3" someone stub_fetch "$4" "$5" || true' \
        _ "$UI_LIB" "$UI_TMP/stub-fetch.sh" "$UI_TMP/backend-paths-race.txt" "$1" "$2" 2>/dev/null)
    UI_WV_CALLS=$(wc -l < "$UI_TMP/calls" | tr -d ' ')
}
printf '%s\n' ibl5/classes/Team/TeamService.php > "$UI_TMP/backend-paths-race.txt"
ui_verdict_run labeled human-approved
same "approval race: labeled human-approved never waits on the gallery" "$UI_WV_CALLS" 0
same "approval race: labeled human-approved with no gallery holds as vr-missing" "$UI_WV" vr-missing
run_approval labeled human-approved "$UI_WV" human-approved "$(printf 'a%.0s' {1..40})" /dev/null
expect "approval race: the approving run clears the check" 0 "$?"
want "approval race: the approving run records its fingerprint" "$LAST_OUT" "VERDICT=record"
ui_verdict_run synchronize ""
same "approval race: a synchronize run still waits the full gallery bound" "$UI_WV_CALLS" 3
same "approval race: a synchronize run with no gallery holds" "$UI_WV" vr-missing
ui_verdict_run labeled needs-a-human
same "approval race: another label event still waits on the gallery" "$UI_WV_CALLS" 3
ui_verdict_run unlabeled human-approved
same "approval race: removing human-approved still waits on the gallery" "$UI_WV_CALLS" 3
# The workflow must hand the event to the verdict, or the skip never fires.
if command grep -qF 'ui_workflow_verdict "$PATHS" "$PR_AUTHOR" ui_fetch_gallery_gh "$ACTION" "$EVENT_LABEL"' \
    "$REPO_ROOT/.github/workflows/human-signoff.yml"; then
    h_pass "approval race: human-signoff.yml passes ACTION and EVENT_LABEL to ui_workflow_verdict"
else
    h_fail "approval race: human-signoff.yml passes ACTION and EVENT_LABEL to ui_workflow_verdict" "call not found"
fi

