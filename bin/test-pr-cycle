# ==========================================================================================
# 35 — your-turn DM links armed and non-armed PRs correctly
# ==========================================================================================
begin_case
reset_state
printf '%s' "$ATTACK_4PR" > "$SCRATCH/attack-out"
# Write triage output with 2-space separators so multi-word actions survive awk -F"  +"
{   printf '#2101  ARMABLE  arm\n'
    printf '#2102  FEAT-AWAITING-SIGNOFF  human sign-off\n'
    printf '#2103  UNCLEARED  run manual tests\n'
} > "$SCRATCH/triage-out"
# prlist for 2102 and 2103 (2101 is ARMABLE, not your-turn)
{   printf '2102\thttps://github.com/a-jay85/IBL5/pull/2102\tAlpha PR title\n'
    printf '2103\thttps://github.com/a-jay85/IBL5/pull/2103\tBeta PR title\n'
} > "$SCRATCH/prlist.tsv"
run --worker
[[ $RC -eq 0 ]] || fail "case 35 exit $RC, want 0"
[[ "$(calls dm)" == "1" ]] || fail "case 35: want 1 DM, got $(calls dm)"
grep -qF 'armed 1, your turn 2' "$SCRATCH/dm.argv" || fail "case 35: summary wrong: $(cat "$SCRATCH/dm.argv")"
grep -qF '[#2102: Alpha PR title](https://github.com/a-jay85/IBL5/pull/2102) — FEAT-AWAITING-SIGNOFF — human sign-off' \
    "$SCRATCH/dm.argv" || fail "case 35: 2102 link missing or misformatted"
grep -qF '[#2103: Beta PR title](https://github.com/a-jay85/IBL5/pull/2103) — UNCLEARED — run manual tests' \
    "$SCRATCH/dm.argv" || fail "case 35: 2103 link missing or misformatted"
grep -qF '#2101' "$SCRATCH/dm.argv" && fail "case 35: armed #2101 must not appear in your-turn list"

reset_state
printf '%s' "$ATTACK_4PR" > "$SCRATCH/attack-out"
{   printf '#2101  ARMABLE  arm\n'
    printf '#2102  FEAT-AWAITING-SIGNOFF  human sign-off\n'
    printf '#2103  UNCLEARED  run manual tests\n'
} > "$SCRATCH/triage-out"
{   printf '2102\thttps://github.com/a-jay85/IBL5/pull/2102\tAlpha PR title\n'
    printf '2103\thttps://github.com/a-jay85/IBL5/pull/2103\tBeta PR title\n'
} > "$SCRATCH/prlist.tsv"
echo 1 > "$SCRATCH/dm-rc"
run --worker
[[ $RC -eq 0 ]] || fail "case 35: a failed DM changed exit status to $RC"

reset_state
printf '%s' "$ATTACK_4PR" > "$SCRATCH/attack-out"
{   printf '#2101  ARMABLE  arm\n'
    printf '#2102  FEAT-AWAITING-SIGNOFF  human sign-off\n'
} > "$SCRATCH/triage-out"
