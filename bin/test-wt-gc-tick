# ── Env contract: switches, ages, stamp seam, help text ───────────────────────
# A token "-VAR" in rt's env list leaves VAR truly unset (run_tick drops it).
EC_SWITCHES=(WT_GC_ARCHIVE_PRUNE WT_GC_REAP_DIRTY_ARCHIVE WT_GC_REAP_DETACHED
    WT_GC_REAP_CLOSED WT_GC_DROP_STASHES WT_GC_REF_FALLBACK WT_GC_DOCKER_CONTAINERS
    WT_GC_REAP_T3 WT_GC_REAP_T3_MERGED WT_GC_REAP_LANDED WT_GC_REAP_UNBORN
    WT_GC_REAP_POOL_BRANCHES)
# The switches that own a run_step, as "VAR:step".
EC_STEPS=(WT_GC_ARCHIVE_PRUNE:archive-prune WT_GC_REAP_DETACHED:detached
    WT_GC_REAP_CLOSED:closed WT_GC_DROP_STASHES:stashes WT_GC_REAP_T3:t3
    WT_GC_REAP_LANDED:landed WT_GC_REAP_UNBORN:unborn
    WT_GC_REAP_POOL_BRANCHES:pool-branches)

for ec_var in "${EC_SWITCHES[@]}"; do
    if should_run "EC-switch-$ec_var"; then
    fx "EC-switch-$ec_var"
    rt "-$ec_var" -- --force --dry-run
    log_has "config (.* )?$ec_var=1( |\$)" || note_err "unset $ec_var did not default to 1"
    rt "$ec_var=" -- --force --dry-run
    log_has "config (.* )?$ec_var=1( |\$)" || note_err "empty $ec_var did not default to 1"
    rt "$ec_var=0" -- --force --dry-run
    log_has "config (.* )?$ec_var=0( |\$)" || note_err "$ec_var=0 not logged"
    for ec_pair in "${EC_STEPS[@]}"; do
        [ "${ec_pair%%:*}" = "$ec_var" ] || continue
        ec_step="${ec_pair##*:}"
        log_has "step $ec_step disabled \($ec_var=0\)" || note_err "$ec_var=0 did not disable step $ec_step"
        log_has "step $ec_step threshold" && note_err "step $ec_step ran with $ec_var=0"
    done
    finish_case
    fi
done

# "VAR|default|extra env to switch the owning step on"
EC_AGES=(
    'WT_GC_ARCHIVE_DAYS|90|WT_GC_ARCHIVE_PRUNE=1'
    'WT_GC_DIRTY_ARCHIVE_DAYS|3|WT_GC_REAP_DIRTY_MERGED=1 WT_GC_REAP_DIRTY_ARCHIVE=1'
    'WT_GC_DETACHED_DAYS|3|WT_GC_REAP_DETACHED=1'
    'WT_GC_CLOSED_DAYS|7|WT_GC_REAP_CLOSED=1'
    'WT_GC_STASH_DAYS|7|WT_GC_DROP_STASHES=1'
    'WT_GC_BACKUP_FALLBACK_DAYS|14|WT_GC_REAP_REFS=1 WT_GC_REF_FALLBACK=1'
    'WT_GC_CONTAINER_DAYS|14|WT_GC_DOCKER_PRUNE=1 WT_GC_DOCKER_CONTAINERS=1'
    'WT_GC_T3_DAYS|1|WT_GC_REAP_T3=1'
    'WT_GC_LANDED_DAYS|3|WT_GC_REAP_LANDED=1'
    'WT_GC_UNBORN_DAYS|3|WT_GC_REAP_UNBORN=1'
)
for ec_row in "${EC_AGES[@]}"; do
    ec_var="${ec_row%%|*}"
    ec_rest="${ec_row#*|}"
    ec_def="${ec_rest%%|*}"
    ec_on="${ec_rest#*|}"
    if should_run "EC-age-$ec_var"; then
    fx "EC-age-$ec_var"
    # shellcheck disable=SC2086
    rt $ec_on "-$ec_var" -- --force
    chk_rc "EC-age $ec_var unset" 0
    log_has "config (.* )?$ec_var=$ec_def( |\$)" || note_err "unset $ec_var did not default to $ec_def"
    log_has "invalid $ec_var" && note_err "unset $ec_var logged invalid"
    log_has 'reap done steps_failed=0' || note_err "unset $ec_var: steps failed"
    # shellcheck disable=SC2086
    rt $ec_on "$ec_var=" -- --force
    log_has "invalid $ec_var '' — step skipped \(fail-closed\)" || note_err "empty $ec_var not fail-closed"
    log_has 'reap done steps_failed=[1-9]' || note_err "empty $ec_var: no failed step counted"
    [ -z "$(git -C "$ENV_MAIN" for-each-ref refs/wt-gc-archive/)" ] || note_err "empty $ec_var wrote an archive"
    finish_case
    fi
done

if should_run EC-stamp-seam; then
fx EC-stamp-seam
for ec_mode in unset empty; do
    : > "$CD/rows"; : > "$CD/skips"
    d_wt "ecs-$ec_mode" diff
    epoch_ago 5 > "$CD/gh/7.json"
    if [ "$ec_mode" = unset ]; then ec_tok=-WT_GC_ARCHIVE_STAMP; else ec_tok=WT_GC_ARCHIVE_STAMP=; fi
    rt WT_GC_REAP_DIRTY_MERGED=1 WT_GC_REAP_DIRTY_ARCHIVE=1 "$ec_tok" STUB_SKIP_LINES="$CD/skips" -- --force
    chk_rc "EC-stamp $ec_mode" 0
    ec_refs="$(git -C "$ENV_MAIN" for-each-ref --format='%(refname)' refs/wt-gc-archive/)"
    [ -n "$ec_refs" ] || note_err "$ec_mode stamp: no archive written"
    ec_bad="$(grep -vE '^refs/wt-gc-archive/[0-9]{10}/' <<< "$ec_refs" || true)"
    [ -z "$ec_bad" ] || note_err "$ec_mode stamp: bad refname: $ec_bad"
    grep -qF 'refs/wt-gc-archive//' <<< "$ec_refs" && note_err "$ec_mode stamp: empty stamp component"
done
finish_case
fi

# NV1 — the new vars, empty. Unset is the default path every earlier case runs.
# An empty day count fails its step closed (nothing reaped); an empty switch
# turns the step on. Mutations this case catches:
#   ${WT_GC_UNBORN_DAYS-3} -> ${WT_GC_UNBORN_DAYS:-3}   (empty day count would default)
#   ${WT_GC_REAP_UNBORN:-1} -> ${WT_GC_REAP_UNBORN:-0}  (empty switch would disable)
if should_run NV1-new-vars-empty; then
fx NV1-new-vars-empty
landed_wt nv-landed br/nv-landed age_days=5
land_on_master
mk_unborn nv-unborn br/nv-unborn 5
for nv_row in 'WT_GC_LANDED_DAYS=|landed|WT_GC_REAP_LANDED=1' 'WT_GC_UNBORN_DAYS=|unborn|WT_GC_REAP_UNBORN=1' \
    'WT_GC_UNBORN_DAYS=abc|unborn|WT_GC_REAP_UNBORN=1'; do
    nv_env="${nv_row%%|*}"
    nv_rest="${nv_row#*|}"
    nv_step="${nv_rest%%|*}"
    nv_on="${nv_rest#*|}"
    rt "$nv_on" "$nv_env" -- --force
    chk_rc "NV1 $nv_env" 1
    log_has "step $nv_step failed \(rc=1\)" || note_err "$nv_env: step $nv_step did not fail closed"
    log_has "invalid ${nv_env%%=*} '${nv_env#*=}'" || note_err "$nv_env: no invalid-value log"
    [ -d "$(wt_dir nv-landed)" ] || note_err "$nv_env: landed worktree removed"
    [ -d "$(wt_dir nv-unborn)" ] || note_err "$nv_env: unborn worktree removed"
done
[ -z "$(git -C "$ENV_MAIN" for-each-ref refs/wt-gc-archive/)" ] || note_err "a failed step wrote an archive"
rt WT_GC_REAP_LANDED= WT_GC_REAP_UNBORN= WT_GC_REAP_POOL_BRANCHES= WT_GC_REAP_T3_MERGED= -- --force
chk_rc "NV1 empty switches" 0
log_has 'step landed threshold=3d' || note_err "empty WT_GC_REAP_LANDED did not run the step"
log_has 'step unborn threshold=3d' || note_err "empty WT_GC_REAP_UNBORN did not run the step"
log_has 'step pool-branches$' || note_err "empty WT_GC_REAP_POOL_BRANCHES did not run the step"
log_has 'config .*WT_GC_REAP_T3_MERGED=1( |$)' || note_err "empty WT_GC_REAP_T3_MERGED did not default to 1"
finish_case
fi

