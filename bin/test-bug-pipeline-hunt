bpt_run
bpt_log_has "$STUB" transition.log "transition 7 needs_human --release-lease" "r49: terminal transition fires despite post-to-thread failure"
if [ -f "$STUB/dm.args.log" ]; then bpt_ok "r49: DM still sent despite post-to-thread failure"; else bpt_fail "r49: DM not sent when post-to-thread fails"; fi
# Matrix row 22 — the whole point of Phase 10's --fail. Without it curl exits 0 on a 500 and
# the `|| log ...` guard is unreachable dead code that silently swallows the failure. Asserting
# the log line (not just "nothing crashed") is what distinguishes a live guard from a dead one.
bpt_log_has "$STUB" tick.out "escalation follow-up post failed for 7 (continuing)" "r49: the failed post is logged, not swallowed"

# ── Rows 50-55 — reproduce-before-fix gate ─────────────────────────────────────

