[[ $_rc -eq 1 ]] || fail "pr-ready-collapse-guard-usage: bogus-mode exit $_rc want 1"
grep -q '^STOP:' <<<"$_out" || fail "pr-ready-collapse-guard-usage: bogus-mode no STOP:"
end_case pr-ready-collapse-guard-usage

