#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-postplan-arm-conditions — regression guard for the /post-plan blocks
# that must survive being run in their own shell — the Phase 6.5 auto-merge
# conditions, the Phase 2.5 backlog trigger, and the Phase 6 body-marker
# preservation blocks (L20: a body rewrite that drops `Depends-on:` silently
# disarms condition (6)).
# Phase 6.5 conditions call the shared predicate bin/lib/pr-armable.sh
# (conditions (1) Manual-Testing, (5) golden, (6) Depends-on, (8) feat:, (10) pipeline-authored label OR bug-<id> branch name, (11) unresolved >= 80 findings), plus
# condition (3), the Phase-5.0 conformance gate (no predicate; /tmp state only).
#
# Why this exists: those blocks live as separate ```bash blocks inside
# _phase-6.5-arm-auto-merge.md and SKILL.md, and the orchestrator runs each
# block in its OWN shell after Reading those files. A block that relied on a
# hoisted `source` or a shared `PR_JSON` from a preamble would have an UNDEFINED
# predicate function — and for condition (8) that fails OPEN (no BLOCKED line
# emitted → a feat: PR auto-arms). A Phase 2.5 block that emitted no verdict,
# or fell through to `none` on a plan-blind code PR, would silently restore the
# 87%-of-PRs skip this trigger exists to fix. This test runs each block in an
# isolated `bash -c` against a gh shim and asserts the holds, plus a structural
# check that every predicate-using block re-`source`s the lib itself.
#
# Run: bin/test-postplan-arm-conditions  (exit 0 = all pass, 1 = a case failed)

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SKILL="$REPO_ROOT/.claude/skills/post-plan/_phase-6.5-arm-auto-merge.md"
P25_SKILL="$REPO_ROOT/.claude/skills/post-plan/SKILL.md"
P55_SKILL="$REPO_ROOT/.claude/skills/post-plan/_phase-5.5-fidelity.md"
P5_SKILL="$REPO_ROOT/.claude/skills/post-plan/_phase-5-final-verification.md"
PLAN_SKILL="$REPO_ROOT/.claude/skills/plan/SKILL.md"

BASE_TMP="$(mktemp -d)"
trap 'rm -rf "$BASE_TMP"' EXIT
FAILED=0

# A gh shim emulating the only calls the condition blocks make:
#   gh pr diff --name-only               -> $GH_DIFF_FIXTURE contents (or exit 1 if unset/missing)
#   gh pr view <n> --json state          -> predecessor state (#1100 OPEN else MERGED)
#   gh pr view --json <fields> --jq F    -> jq -r F applied to $GH_PR_FIXTURE
#   gh pr edit --body-file|--body       -> appends the body to $GH_EDIT_RECORD
SHIMD="$BASE_TMP/shim"
mkdir -p "$SHIMD"
cat > "$SHIMD/gh" <<'SHIM'
#!/usr/bin/env bash
if [ "$1" = "pr" ] && [ "$2" = "diff" ]; then
  # gh pr diff --name-only -> the fixture path list. An unset/missing fixture
  # emulates a gh failure (no PR, network error), which the Phase 2.5 block must
  # survive with BL_TRIGGER=none rather than aborting.
  [ -n "${GH_DIFF_FIXTURE:-}" ] && [ -f "$GH_DIFF_FIXTURE" ] || exit 1
  cat "$GH_DIFF_FIXTURE"
  exit 0
fi
if [ "$1" = "pr" ] && [ "$2" = "view" ]; then
  if [[ "$3" =~ ^[0-9]+$ ]]; then
    case "$3" in 1100) echo '{"state":"OPEN"}' ;; *) echo '{"state":"MERGED"}' ;; esac
    exit 0
  fi
  filter='.'
  for ((i=1; i<=$#; i++)); do
    if [ "${!i}" = "--jq" ]; then j=$((i+1)); filter="${!j}"; fi
  done
  jq -r "$filter" "$GH_PR_FIXTURE"
  exit 0
fi
if [ "$1" = "pr" ] && [ "$2" = "edit" ]; then
  # Record what post-plan would have written, so a repair write is observable.
  for ((i=1; i<=$#; i++)); do
    if [ "${!i}" = "--body-file" ]; then j=$((i+1)); cat "${!j}" >> "${GH_EDIT_RECORD:-/dev/null}"; fi
    if [ "${!i}" = "--body" ];      then j=$((i+1)); printf '%s' "${!j}" >> "${GH_EDIT_RECORD:-/dev/null}"; fi
  done
  exit 0
fi
exit 1
SHIM
chmod +x "$SHIMD/gh"

# extract_block <literal-marker> [file] — print the first ```bash fenced block
# whose body contains the literal marker substring (e.g. "# condition (8)").
# Uses index() (literal), not regex, so the parens in the marker are matched
# verbatim. File defaults to $SKILL when omitted.
extract_block() {
    awk -v want="$1" '
        /^```bash$/ { inb=1; buf=""; next }
        /^```$/     { if (inb && index(buf, want) > 0) { printf "%s", buf } ; inb=0; next }
        inb         { buf = buf $0 "\n" }
    ' "${2:-$SKILL}"
}

# run_isolated <block> <fixture-json> <golden_changed> <headless> — run the block
# in its OWN fresh shell (the failure model) and echo its stdout.
run_isolated() {
    printf '%s' "$2" > "$BASE_TMP/fixture.json"
    PATH="$SHIMD:$PATH" GH_PR_FIXTURE="$BASE_TMP/fixture.json" \
        GOLDEN_CHANGED="$3" CLAUDE_HEADLESS="$4" \
        bash -c "$1" 2>&1
}

# run_cond3 <block> <marker: yes|no> <bridge: absent|empty|items> — condition (3)
# reads /tmp state rather than gh, so it gets its own runner: the block's
# $DONE_MARK/$BRIDGE defaults are overridden to point into $BASE_TMP.
run_cond3() {
    local mark="$BASE_TMP/done-marker" bridge="$BASE_TMP/bridge"
    rm -f "$mark" "$bridge"
    [ "$2" = "yes" ] && touch "$mark"
    case "$3" in
        empty) : > "$bridge" ;;
        items) echo 'MISSING: ibl5/tests/FooTest.php (matrix planned a test the diff never wrote)' > "$bridge" ;;
        fileitems) echo 'MISSING-FILE: bin/check-plan (plan Critical File never appeared in the diff)' > "$bridge" ;;
    esac
    DONE_MARK="$mark" BRIDGE="$bridge" bash -c "$1" 2>&1
}

run_cond12() {
    local vf="$BASE_TMP/fidelity-verdict.md"
    mk_verdict_fixture "$2" "$vf"
    printf '{"number":2100}' > "$BASE_TMP/fixture.json"
    PATH="$SHIMD:$PATH" GH_PR_FIXTURE="$BASE_TMP/fixture.json" \
        FIDELITY_VERDICT_FILE="$vf" bash -c "$1" 2>&1
}
run_p55() {
    local vf="$BASE_TMP/p55-verdict.md"
    mk_verdict_fixture "$2" "$vf"
    printf '{"number":2100}' > "$BASE_TMP/fixture.json"
    PATH="$SHIMD:$PATH" GH_PR_FIXTURE="$BASE_TMP/fixture.json" \
        FIDELITY_VERDICT_FILE="$vf" bash -c "$1" 2>&1
}
expect_fidelity() {
    if printf '%s' "$3" | grep -qxF "FIDELITY=$2"; then
        echo "ok: $1"
    else
        echo "FAIL: $1 — expected FIDELITY=$2, got: '$3'"
        FAILED=1
    fi
}

expect_block() { # name  BLOCK|NONE  output
    local got_block=0
    [[ "$3" == *BLOCKED* ]] && got_block=1
    if { [ "$2" = "BLOCK" ] && [ "$got_block" -eq 1 ]; } \
        || { [ "$2" = "NONE" ] && [ "$got_block" -eq 0 ]; }; then
        echo "ok: $1"
    else
        echo "FAIL: $1 — expected $2, got: '$3'"
        FAILED=1
    fi
}

# expect_rc0 <name> <predicate call> — assert a pr-armable.sh predicate exits 0 on
# its CLEAR path (found nothing to hold).
#
# Why this is separate from the expect_block cases above: the Phase 6.5 blocks PIPE
# the predicate (`pr_dep_holds ... | while read`), which DISCARDS its exit status —
# so every one of those cases passes against a predicate that returns 1. bin/pr-triage
# is the caller that cares: it CAPTURES the predicate (`deps="$(pr_dep_holds ...)"`)
# under `set -euo pipefail`, where a nonzero rc aborts the whole cross-PR sweep
# mid-loop. pr_dep_holds did exactly that from its introduction until 2026-08-22 (a
# trailing bare `[ "$st" != "MERGED" ] && echo` as the last command in its `while`
# body), silently hiding 25 of 30 open PRs behind a table that looked complete.
# The defect CLASS is "predicate returns nonzero when clear", so assert it for all six.
expect_rc0() { # name  predicate-call
    local script="$BASE_TMP/rc0.sh" out
    {
        echo 'set -euo pipefail'
        echo "source '$REPO_ROOT/bin/lib/pr-armable.sh'"
        # Capture exactly as bin/pr-triage does — the shape that makes rc load-bearing.
        echo "captured=\"\$($2 | tr '\\n' ' ')\""
        echo 'printf "%s" "$captured"'
    } > "$script"
    if out="$(PATH="$SHIMD:$PATH" bash "$script" 2>&1)"; then
        echo "ok: $1"
    else
        echo "FAIL: $1 — predicate exited nonzero on its clear path; captured under"
        echo "      set -euo pipefail this ABORTS bin/pr-triage's sweep. output: '$out'"
        FAILED=1
    fi
}

# expect_mss <name> <mergeStateStatus> <block|arm> — exercise bin/pr-triage's
# mss_blocks_merge allowlist. Extracted rather than sourced because bin/pr-triage is
# an executable script, not a lib; the extraction is anchored on the function's own
# `name() {` .. `}` lines, so a rename fails loudly here instead of silently passing.
expect_mss() { # name  mss  block|arm
    local fn script="$BASE_TMP/mss.sh" rc=0
    fn="$(sed -n '/^mss_blocks_merge() {/,/^}/p' "$REPO_ROOT/bin/pr-triage")"
    if [ -z "$fn" ]; then
        echo "FAIL: $1 — mss_blocks_merge() not found in bin/pr-triage"
        FAILED=1
        return
    fi
    printf '%s\nmss_blocks_merge "%s"\n' "$fn" "$2" > "$script"
    bash "$script" || rc=$?
    if { [ "$3" = "block" ] && [ "$rc" -eq 0 ]; } || { [ "$3" = "arm" ] && [ "$rc" -ne 0 ]; }; then
        echo "ok: $1"
    else
        echo "FAIL: $1 — mergeStateStatus=$2 expected to $3, but mss_blocks_merge returned $rc"
        FAILED=1
    fi
}

assert_self_contained() { # marker name
    local block; block="$(extract_block "$1")"
    if [ -z "$block" ]; then
        echo "FAIL: $2 — no block matching '$1' found in SKILL.md"
        FAILED=1
        return
    fi
    if printf '%s' "$block" | grep -q 'source' && printf '%s' "$block" | grep -q 'pr-armable.sh'; then
        echo "ok: $2 self-sources the predicate"
    else
        echo "FAIL: $2 — block uses the predicate but does NOT source pr-armable.sh in-block (hoisted source = fail-open risk)"
        FAILED=1
    fi
}

# run_p50 <block> <planfile> — run the Phase 5.0 conformance block in its OWN
# shell against an EMPTY changed-file list, so every must-appear entry surfaces
# as a MISSING-FILE line. That makes the block's CLASSIFICATION observable,
# which is what the three-way agreement test compares. The prelude runs in the
# same bash instance as the block, so its $PPID is the block's $PPID.
run_p50() {
    ( cd "$REPO_ROOT" && PLAN_FILE="$2" bash -c ': > "/tmp/post-plan-changed-$PPID"
'"$1"'
rm -f "/tmp/post-plan-changed-$PPID"' 2>&1 )
}

# assert_block_sources <marker> <name> <lib-substring> <file>
# Generalized sibling of assert_self_contained: assert_self_contained is
# hardwired to pr-armable.sh and $SKILL, and its call sites must not change.
assert_block_sources() {
    local block; block="$(extract_block "$1" "$4")"
    if [ -z "$block" ]; then
        echo "FAIL: $2 — no block matching '$1' found in $4"; FAILED=1; return
    fi
    if printf '%s' "$block" | grep -q 'source' && printf '%s' "$block" | grep -qF "$3"; then
        echo "ok: $2 self-sources $3"
    else
        echo "FAIL: $2 — block does NOT source $3 in-block (hoisted source = undefined function = silent fail-open)"
        FAILED=1
    fi
}

# run_p25 <block> <changed-paths|__GHFAIL__> <plan-body|""> <bl-dir> — the Phase 2.5
# block reads `gh pr diff --name-only`, an optional plan file, and $BL_DIR; all
# three are env-overridable in-block, so supply them from $BASE_TMP and run the
# block in its OWN fresh shell (the failure model this whole test guards).
run_p25() {
    local diff_f="$BASE_TMP/p25-diff.txt" plan_f="$BASE_TMP/p25-plan.md"
    rm -f "$diff_f" "$plan_f"
    [ "$2" != "__GHFAIL__" ] && printf '%s' "$2" > "$diff_f"
    [ -n "$3" ] && printf '%s' "$3" > "$plan_f"
    PATH="$SHIMD:$PATH" GH_DIFF_FIXTURE="$diff_f" \
        PLAN_FILE="$plan_f" BL_DIR="$4" \
        bash -c "$1" 2>&1
}

# run_markers <before-body-json> <after-body-json> — run the Phase 6 capture block
# against the body as it stood BEFORE the rewrite, then the verify block against the
# body as it stands AFTER it, sharing one $MARKERS_FILE. Each block gets its OWN
# fresh shell (the failure model). $GH_EDIT_RECORD collects any repair write.
run_markers() {
    local mf="$BASE_TMP/markers" rec="$BASE_TMP/edit-record"
    rm -f "$mf" "$mf".* "$rec"; : > "$rec"
    printf '%s' "$1" > "$BASE_TMP/fixture.json"
    PATH="$SHIMD:$PATH" GH_PR_FIXTURE="$BASE_TMP/fixture.json" MARKERS_FILE="$mf" \
        GH_EDIT_RECORD="$rec" bash -c "$BMC" 2>&1
    printf '%s' "$2" > "$BASE_TMP/fixture.json"
    PATH="$SHIMD:$PATH" GH_PR_FIXTURE="$BASE_TMP/fixture.json" MARKERS_FILE="$mf" \
        GH_EDIT_RECORD="$rec" bash -c "$BMV" 2>&1
}

expect_out() { # name  expected-substring  output
    if [[ "$3" == *"$2"* ]]; then echo "ok: $1"
    else echo "FAIL: $1 — expected '$2' in: '$3'"; FAILED=1; fi
}

# expect_p25 <name> <A|B|C|none> <hit|miss|absent> <output> — assert the verdict,
# the probe state, and that EXACTLY ONE verdict line was printed (a second one
# would mean a fallthrough, and the orchestrator reads only the first).
expect_p25() {
    local v p n
    v="$(printf '%s\n' "$4" | grep -m1 '^BL_TRIGGER=' | cut -d= -f2)"
    p="$(printf '%s\n' "$4" | grep -m1 '^BL_PROBE=' | cut -d= -f2)"
    n="$(printf '%s\n' "$4" | grep -c '^BL_TRIGGER=')"
    [ -z "$p" ] && p="absent"
    if [ "$v" = "$2" ] && [ "$p" = "$3" ] && [ "$n" -eq 1 ]; then
        echo "ok: $1"
    else
        echo "FAIL: $1 — expected trigger=$2 probe=$3 (1 verdict), got trigger='$v' probe='$p' verdicts=$n; output: '$4'"
        FAILED=1
    fi
}

# mk_bl_dir <name> <entry-location> — fixture backlog dir with ONE entry whose
# **Location:** names <entry-location>, plus a README.md and an archive/ entry
# that name the SAME path. The probe must ignore those two.
mk_bl_dir() {
    local d="$BASE_TMP/bl-$1"
    mkdir -p "$d/archive"
    printf $'# X\n\n**Location:** `%s`\n' "$2" > "$d/x-backlog.md"
    printf $'# Index\n\n**Location:** `%s`\n' "$2" > "$d/README.md"
    printf $'# Old\n\n**Location:** `%s`\n' "$2" > "$d/archive/old-backlog.md"
    echo "$d"
}

mk_verdict_fixture() {
    rm -f "$2"
    case "$1" in
        ready)       printf 'Findings: none.\n\nREADY\n\n## DIGEST\n**What changed:** x\n' > "$2" ;;
        notes)       printf 'Findings: two advisory notes.\n\nREADY WITH NOTES\n\n## DIGEST\n**What changed:** x\n' > "$2" ;;
        notready)    printf 'Findings: intent gap on phase 3.\n\nNOT READY\n\n## DIGEST\n**What changed:** x\n' > "$2" ;;
        noverdict)   printf 'Findings: prose only, reviewer never emitted a verdict word.\n\n## DIGEST\n**What changed:** x\n' > "$2" ;;
        digestready) printf 'Findings: intent gap.\n\nNOT READY\n\n## DIGEST\n**What changed:** the READY gate\n' > "$2" ;;
        empty)       : > "$2" ;;
        absent)      ;;
    esac
}

B1="$(extract_block '# condition (1)')"
B3="$(extract_block '# condition (3)')"
B5="$(extract_block '# condition (5)')"
B6="$(extract_block '# condition (6)')"
B8="$(extract_block '# condition (8)')"
B10="$(extract_block '# condition (10)')"
B25="$(extract_block '# phase 2.5 trigger' "$P25_SKILL")"
BMC="$(extract_block '# phase 6 body-marker capture' "$P25_SKILL")"
BMV="$(extract_block '# phase 6 body-marker verify'  "$P25_SKILL")"
B12="$(extract_block '# condition (12)')"
B55="$(extract_block '# phase 5.5 verdict parse' "$P55_SKILL")"
BREB="$(extract_block '# phase 2 rebase' "$P25_SKILL")"

# --- structural: every predicate-using block must source the lib itself ---
assert_self_contained '# condition (1)' "condition (1)"
assert_self_contained '# condition (5)' "condition (5)"
assert_self_contained '# condition (6)' "condition (6)"
assert_self_contained '# condition (8)' "condition (8)"
assert_self_contained '# condition (10)' "condition (10)"
assert_self_contained '# condition (11)' "condition (11)"

# The Phase 2.5 failure model: each /post-plan block runs in its own shell, so a
# block that read Phase 1's $PLAN_FILE without re-deriving it would silently take
# the C branch on EVERY PR, including plan-present ones.
# shellcheck disable=SC2016  # grep patterns match literal ${VAR:-...} text in the block
if [ -z "$B25" ]; then
    echo "FAIL: phase 2.5 — no block matching '# phase 2.5 trigger' in $P25_SKILL"
    FAILED=1
elif printf '%s' "$B25" | grep -q 'PLAN_FILE="${PLAN_FILE:-' \
    && printf '%s' "$B25" | grep -q 'BL_DIR="${BL_DIR:-'; then
    echo "ok: phase 2.5 block re-derives PLAN_FILE and BL_DIR in-block"
else
    echo "FAIL: phase 2.5 block does NOT re-derive PLAN_FILE/BL_DIR in-block (cross-shell state = wrong verdict)"
    FAILED=1
fi

# --- behavioral: each block, run in isolation, holds correctly ---
expect_block "(1) HELD manual rows -> BLOCK" BLOCK \
    "$(run_isolated "$B1" '{"body":"## Manual Testing\n\n- review the new <h1>"}' '' '')"
expect_block "(1) cleared sentinel -> NONE" NONE \
    "$(run_isolated "$B1" '{"body":"## Manual Testing\nNo manual testing needed — automated."}' '' '')"
expect_block "(1) no section (UNKNOWN) -> BLOCK (fail-closed)" BLOCK \
    "$(run_isolated "$B1" '{"body":"hand-made PR, no manual testing heading"}' '' '')"

# condition (3) — the fail-open this gate closed: an empty bridge file is
# byte-identical for "5.0 ran clean" and "5.0 died", so only the done-marker
# distinguishes them. The marker+absent-bridge case is the plan-blind majority
# (Phase 5.0 skipped) — if it ever BLOCKs, nearly every PR stops arming.
expect_block "(3) no done-marker -> BLOCK (indeterminate, fail-closed)" BLOCK \
    "$(run_cond3 "$B3" no empty)"
expect_block "(3) marker + unresolved items -> BLOCK" BLOCK \
    "$(run_cond3 "$B3" yes items)"
expect_block "(3) marker + empty bridge -> NONE (5.0 ran clean)" NONE \
    "$(run_cond3 "$B3" yes empty)"
expect_block "(3) marker + absent bridge -> NONE (5.0 skipped, plan-blind)" NONE \
    "$(run_cond3 "$B3" yes absent)"

# (3) A real MISSING-FILE — the item THIS PR's parser produces — must block
# arming exactly as a MISSING: test item does. Requirement 5.
expect_block "(3) marker + unresolved MISSING-FILE -> BLOCK" BLOCK \
    "$(run_cond3 "$B3" yes fileitems)"

# --- Critical Files parser: structural + three-way behavioral agreement -----
B50="$(extract_block '# Reuses /tmp/post-plan-changed-' "$P5_SKILL")"
assert_block_sources '# Reuses /tmp/post-plan-changed-' "phase 5.0 conformance" \
    'bin/lib/critical-files.sh' "$P5_SKILL"

# No parser may re-inline its own regex — that IS the divergence being deleted.
if grep -qF 'EXEMPT_RE=' "$P5_SKILL"; then
    echo "FAIL: phase 5.0 block still inlines EXEMPT_RE (re-divergence)"; FAILED=1
else
    echo "ok: phase 5.0 block inlines no exempt regex"
fi

# THREE-WAY AGREEMENT. Every shape below is corpus-derived; the indented entry
# pins the leading-whitespace divergence check-plan's old `^- ` awk had.
CF_FIX="$BASE_TMP/cf-agreement.md"
cat > "$CF_FIX" <<'CFEOF'
````bash
# Outer 4-backtick fence: contains a decoy ## Critical Files heading.
# Width-aware fence regression — naive parity toggle would swallow real section.
```text
inner 3-backtick block — fence_len=3 < 4, does NOT close the outer fence
```
## Critical Files

- `decoy01` (reference)
- `decoy02` — decoy must-appear inside fence, must be ignored

````

## Critical Files

- `bin/check-plan` — add gate [F]
- `ibl5/schema.sql` (reference)
- `ibl5/docs/backlog/README.md` (conditional)
- `ibl5/docs/backlog/other.md` (conditional — only if diff touches it)
- `tools/postplan-harness/harness/planfile.py` (read-only reference)
- `ibl5/a.php` — add the context menu helper
- `ibl5/b.php` (reference — pattern to mirror; unchanged)
  - `ibl5/c.php` — indented change target
- `ibl5/d.php` (conditional Phase 4 only)
- `ibl5/e.php` (filename references the affected class)
CFEOF

CF_LIB=$( cd "$REPO_ROOT" && bash -c 'source bin/lib/critical-files.sh && cf_parse_section "$1"' _ "$CF_FIX" \
            | sed -n 's/^MUST_APPEAR://p' )
CF_BLOCK=$( run_p50 "$B50" "$CF_FIX" | sed -n 's/^MISSING-FILE: \([^ ]*\).*/\1/p' )
CF_PY=$( cd "$REPO_ROOT/tools/postplan-harness" && python3 -c '
import sys
from harness.planfile import parse_critical_files
for p, _a, ex in parse_critical_files(open(sys.argv[1]).read()):
    if not ex:
        print(p)
' "$CF_FIX" )

if [ "$CF_LIB" = "$CF_BLOCK" ] && [ "$CF_LIB" = "$CF_PY" ]; then
    echo "ok: three-way parser agreement (lib == phase-5.0 block == planfile.py)"
else
    echo "FAIL: parser divergence"
    echo "  lib:   $(printf '%s' "$CF_LIB"   | tr '\n' ' ')"
    echo "  block: $(printf '%s' "$CF_BLOCK" | tr '\n' ' ')"
    echo "  py:    $(printf '%s' "$CF_PY"    | tr '\n' ' ')"
    FAILED=1
fi

# Negative half: the agreement must be on the RIGHT answer, not merely mutual.
# Five prose/described entries are must-appear; five marked entries are not.
# decoy01/decoy02 (inside the 4-backtick fence) must contribute zero entries.
_want=$(printf 'bin/check-plan\nibl5/a.php\nibl5/c.php\nibl5/d.php\nibl5/e.php')
if [ "$CF_LIB" = "$_want" ]; then
    echo "ok: agreed classification is correct (5 must-appear, 5 exempt)"
else
    echo "FAIL: agreed-but-wrong — expected 5 must-appear, got: $(printf '%s' "$CF_LIB" | tr '\n' ' ')"
    FAILED=1
fi

# ── Matrix extraction must skip fenced rows (feeds conditions (1) and (3)) ────
# Same defect class as the decoy ## Critical Files heading above, on the other
# Phase 5.0 parser: a plan documenting the matrix format carries scaffold rows
# inside a fixture block. Read as declarations they become phantom MISSING: /
# truly-manual items that no diff can resolve, holding the PR forever. Live on
# plan `critical-files-parser-unification` (`tests/X.php`).
MX_FIX="$BASE_TMP/matrix-fence.md"
cat > "$MX_FIX" <<'MXEOF'
## Verification Matrix

````bash
# Outer 4-backtick fence wrapping an inner 3-backtick one: a width-blind parity
# toggle closes here and re-opens at the outer closer, leaking the decoy rows.
```text
inner block
```
| 1 | thing works | PHPUnit | post-impl | `tests/Decoy.php` |
| 2 | looks right | Truly-manual | post-impl | eyeball the decoy |
````

| # | Behavior | Test type | When | Test file |
|---|---|---|---|---|
| 1 | saves row | PHPUnit | post-impl | `ibl5/tests/Unit/RealTest.php` |
MXEOF

MX_PY=$( cd "$REPO_ROOT/tools/postplan-harness" && python3 -c '
import sys
from harness.planfile import parse_matrix
planned, manual = parse_matrix(open(sys.argv[1]).read())
print(",".join(planned) + "|" + str(len(manual)))
' "$MX_FIX" )
if [ "$MX_PY" = "ibl5/tests/Unit/RealTest.php|0" ]; then
    echo "ok: matrix parser skips fenced scaffold rows (planned + truly-manual)"
else
    echo "FAIL: fenced matrix rows leaked into conditions (1)/(3) — got: $MX_PY"
    FAILED=1
fi

# The prose half of the same parser (Phase 5.0 is model-performed for the matrix,
# unlike the Critical Files block which sources the shell lib) has no executable
# host, so pin the instruction itself against silent removal.
if grep -qF 'Skip every row inside a fenced code block' "$P5_SKILL"; then
    echo "ok: phase 5.0 prose instructs skipping fenced matrix rows"
else
    echo "FAIL: phase 5.0 matrix prose lost its fenced-row skip (diverges from planfile.py)"
    FAILED=1
fi

expect_block "(5) golden + headless -> BLOCK" BLOCK \
    "$(run_isolated "$B5" '{"files":[{"path":"engine/internal/sim/testdata/golden.json"}]}' '' '1')"
expect_block "(5) golden + interactive -> NONE (warn-only)" NONE \
    "$(run_isolated "$B5" '{"files":[{"path":"engine/internal/sim/testdata/golden.json"}]}' '' '')"

expect_block "(6) unmerged Depends-on -> BLOCK" BLOCK \
    "$(run_isolated "$B6" '{"body":"x\nDepends-on: #1100"}' '' '')"
expect_block "(6) merged Depends-on -> NONE" NONE \
    "$(run_isolated "$B6" '{"body":"x\nDepends-on: #1071"}' '' '')"

# --- predicate exit-status invariant (the truncation bug) -------------------
# The shim answers OPEN for #1100 and MERGED for every other number, so #1071 is
# the merged predecessor that made pr_dep_holds return 1. `gh api graphql` is not
# shimmed at all, so (11) takes its fail-closed api-error path — which must ALSO
# return 0.
expect_rc0 "rc0: pr_dep_holds, merged predecessor (the pr-triage truncation bug)" \
    "pr_dep_holds \"\$(printf 'x\\nDepends-on: #1071')\""
expect_rc0 "rc0: pr_dep_holds, unmerged predecessor" \
    "pr_dep_holds \"\$(printf 'x\\nDepends-on: #1100')\""
expect_rc0 "rc0: pr_dep_holds, no Depends-on marker" \
    "pr_dep_holds 'a body with no markers'"
expect_rc0 "rc0: pr_manual_testing_clearance, no section" \
    "pr_manual_testing_clearance 'a body with no sections'"
expect_rc0 "rc0: pr_golden_hold, golden untouched" \
    "pr_golden_hold '[]'"
expect_rc0 "rc0: pr_feat_hold, non-feat title" \
    "pr_feat_hold 'fix: a bug' '[]'"
expect_rc0 "rc0: pr_pipeline_authored_hold, neither axis fires" \
    "pr_pipeline_authored_hold '[]' 'feature-x'"
expect_rc0 "rc0: pr_unresolved_findings_hold, gh api unavailable (fail-closed path)" \
    "pr_unresolved_findings_hold 1234"

# --- bin/pr-triage merge-state allowlist ------------------------------------
# BEHIND is the case that shipped wrong: master's protection is strict (branches
# must be up to date), so a BEHIND PR's green checks ran on a SHA GitHub will not
# merge. The old `mss != "DIRTY"` denylist armed it anyway. BLOCKED must stay
# armable — it is the normal "waiting on a required check" state and 28 of 30 open
# PRs sat in it on 2026-08-22, so blocking it would arm nothing, ever.
expect_mss "mss: BEHIND blocks (stale-green, the #1956 bug)" BEHIND block
expect_mss "mss: DRAFT blocks" DRAFT block
expect_mss "mss: UNKNOWN blocks" UNKNOWN block
expect_mss "mss: DIRTY blocks" DIRTY block
expect_mss "mss: unrecognised enum value blocks (fail-closed)" WIDGET block
expect_mss "mss: empty value blocks (fail-closed)" "" block
expect_mss "mss: BLOCKED still arms (28/30 PRs live here)" BLOCKED arm
expect_mss "mss: CLEAN still arms" CLEAN arm
expect_mss "mss: UNSTABLE still arms (non-required checks only)" UNSTABLE arm
expect_mss "mss: HAS_HOOKS still arms" HAS_HOOKS arm

# The truncation guard itself: a mid-loop `set -e` abort exits BEFORE any check
# placed after the loop, so only an EXIT trap can report it. Structural, because
# reproducing an abort would require breaking a predicate on purpose.
if grep -qF 'trap triage_exit_guard EXIT' "$REPO_ROOT/bin/pr-triage"; then
    echo "ok: pr-triage installs the EXIT trap that reports a truncated sweep"
else
    echo "FAIL: pr-triage has no EXIT trap — a mid-loop abort reverts to reporting"
    echo "      a partial table with an empty stderr (the 5-of-30 failure mode)"
    FAILED=1
fi

# The fail-open this whole test exists to catch:
expect_block "(8) feat: no label -> BLOCK (fail-open guard)" BLOCK \
    "$(run_isolated "$B8" '{"title":"feat: shiny","labels":[]}' '' '')"
expect_block "(8) feat: + human-approved -> NONE" NONE \
    "$(run_isolated "$B8" '{"title":"feat: shiny","labels":[{"name":"human-approved"}]}' '' '')"
expect_block "(8) fix: title -> NONE" NONE \
    "$(run_isolated "$B8" '{"title":"fix: bug","labels":[]}' '' '')"

expect_block "(10) pipeline-authored label -> BLOCK" BLOCK \
    "$(run_isolated "$B10" '{"labels":[{"name":"pipeline-authored"}],"headRefName":"feature-x"}' '' '')"
expect_block "(10) no pipeline label -> NONE" NONE \
    "$(run_isolated "$B10" '{"labels":[],"headRefName":"feature-x"}' '' '')"
expect_block "(10) bug-<id> branch, no label -> BLOCK (label-timing fail-open guard)" BLOCK \
    "$(run_isolated "$B10" '{"labels":[],"headRefName":"bug-2-odd-one-here"}' '' '')"
expect_block "(10) bare bug-<id> branch -> BLOCK" BLOCK \
    "$(run_isolated "$B10" '{"labels":[],"headRefName":"bug-7"}' '' '')"
expect_block "(10) bug-pipeline-* human branch -> NONE (digit anchor)" NONE \
    "$(run_isolated "$B10" '{"labels":[],"headRefName":"bug-pipeline-reproduce-gate"}' '' '')"

