#!/usr/bin/env bash
# shellcheck shell=bash
# One-time setup for the scheduled merged-worktree GC cron (ADR-0165).
#
# Installs a Mac-local launchd LaunchAgent (com.ibl5.wt-gc) that fires the
# bash driver bin/wt-gc-tick every 3600s via StartInterval. The tick decides
# whether a sweep runs (HID-idle gate, 6h min-interval stamp). The plist
# Program/WorkingDirectory point at the durable MAIN checkout (never a
# worktree, which gets torn down).
#
# INSTALL ONLY AFTER THIS LANDS ON master — the launchd Program points at
# the main checkout's bin/wt-gc-tick, which must exist there.
#
# Usage:
#   bin/wt-gc-cron-setup --print-schedule      # emit the plist to stdout (no side effect)
#   bin/wt-gc-cron-setup --install-schedule    # install + load the LaunchAgent
#   bin/wt-gc-cron-setup --uninstall-schedule  # unload + remove the LaunchAgent

set -euo pipefail

# launchd and `env -i` runs may lack HOME.
if [ -z "${HOME:-}" ]; then HOME="$(cd ~ 2>/dev/null && pwd)"; export HOME; fi

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=bin/lib/launchd-sched.sh
. "$REPO_ROOT/bin/lib/launchd-sched.sh"
ACTION=""

while [ $# -gt 0 ]; do
  case "$1" in
    --install-schedule)   ACTION="install";   shift ;;
    --uninstall-schedule) ACTION="uninstall"; shift ;;
    --print-schedule)     ACTION="print";     shift ;;
    -h|--help) awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; exit 0 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

[ -n "$ACTION" ] || { echo "No action given. See --help." >&2; exit 1; }

# ── Durable MAIN-checkout derivation ─────────────────────────────────────────
# Program/WorkingDirectory MUST point at the main checkout, never this worktree
# (a worktree gets torn down — the LaunchAgent would then point at a dead path).
# The first `git worktree list` entry is the main working tree.
MAIN_WT="$(lsched_main_wt "$REPO_ROOT")"

PLIST_LABEL="com.ibl5.wt-gc"
PLIST_PATH="$HOME/Library/LaunchAgents/${PLIST_LABEL}.plist"
LOG_DIR="$HOME/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/wt-gc"
PROGRAM="$MAIN_WT/bin/wt-gc-tick"

# Single source of truth for the plist — used by both --print-schedule and
# --install-schedule, so the MAIN-checkout derivation is exercised by tests.
plist_body() {
  lsched_key_string Label "$PLIST_LABEL"
  lsched_program_arguments "$PROGRAM"
  cat <<PLIST
	<!-- Hourly poll; bin/wt-gc-tick's HID-idle gate (1800s) and 6h min-interval
	     stamp decide whether a tick sweeps. Hourly fires survive sleep/wake
	     better than a calendar slot, which would land on wake while the
	     operator is present and fail the idle gate. -->
PLIST
  lsched_key_integer StartInterval 3600
  lsched_key_string WorkingDirectory "$MAIN_WT"
  lsched_env_open
  cat <<PLIST
		<!-- launchd agents start with a minimal PATH that omits Homebrew and
		     ~/.local/bin. Every binary the sweep shells out to must resolve
		     here: git (/usr/bin), gh and docker (Homebrew or /usr/local/bin),
		     lsof (/usr/sbin), and ioreg (/usr/sbin, though the tick calls it
		     by absolute path). Add the dir, don't drop a tool.
		     HOME interpolates HERE, at generation time — launchd does NOT expand
		     variables in EnvironmentVariables, so a literal dollar-HOME would
		     bake in a dead path. -->
PLIST
  lsched_key_string PATH "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${HOME}/.local/bin" 2
  lsched_env_close
  lsched_key_string StandardOutPath "${LOG_DIR}/launchd-stdout.log"
  lsched_key_string StandardErrorPath "${LOG_DIR}/launchd-stderr.log"
}

case "$ACTION" in
  print)
    lsched_plist plist_body
    ;;
  install)
    [ -x "$PROGRAM" ] || { echo "Refusing to install: $PROGRAM is missing or not executable (merge to master first)" >&2; exit 1; }
    lsched_install "$PLIST_LABEL" "$PLIST_PATH" plist_body "$LOG_DIR"
    echo "Installed ${PLIST_LABEL} (StartInterval 3600s). Program: $PROGRAM"
    ;;
  uninstall)
    lsched_uninstall "$PLIST_LABEL" "$PLIST_PATH"
    echo "Uninstalled ${PLIST_LABEL}."
    ;;
esac
