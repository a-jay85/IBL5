    run_dm_driver --go >/dev/null 2>&1
HOME="$SCRATCH" bash "$_DM_RUNNER" >/dev/null 2>&1 || true
[[ -f "$_DM_CAPTURE" ]] \
    || fail "dm-marker-absent-rc0-no-stop: no DM sent"
grep -q 'unconfirmed — no verdict marker' "$_DM_CAPTURE" \
    || fail "dm-marker-absent-rc0-no-stop: DM not classified as unconfirmed"
end_case dm-marker-absent-rc0-no-stop

# --- case 48: dm-teardown-order-static ---------------------------------------------------
begin_case
clean_slots; rm -f "$_DM_LOG" "$_DM_MARKER"
POST_PLAN_FLEET_PR_JSON="$_DM_JSON" POST_PLAN_FLEET_DRY_RUN=1 \
    POST_PLAN_FLEET_DISCORD_DM="$_DM_STUB" POST_PLAN_FLEET_CLAUDE="$CLAUDE_STUB" \
    run_dm_driver --go >/dev/null 2>&1
_rm_line="$(grep -Fn 'rm -f "$PLIST"' "$_DM_RUNNER" | head -1 | cut -d: -f1)"
_notify_line="$(grep -n '^notify$' "$_DM_RUNNER" | head -1 | cut -d: -f1)"
_bootout_line="$(grep -Fn 'launchctl bootout' "$_DM_RUNNER" | head -1 | cut -d: -f1)"
[[ -n "$_rm_line" && -n "$_notify_line" && -n "$_bootout_line" ]] \
    || fail "dm-teardown-order-static: runner missing rm/notify/bootout (rm=$_rm_line notify=$_notify_line bootout=$_bootout_line)"
[[ "$_rm_line" -lt "$_notify_line" ]] \
    || fail "dm-teardown-order-static: rm-plist (line $_rm_line) must precede notify (line $_notify_line)"
[[ "$_notify_line" -lt "$_bootout_line" ]] \
    || fail "dm-teardown-order-static: notify (line $_notify_line) must precede bootout (line $_bootout_line)"
end_case dm-teardown-order-static


# --- Phase 9: push-form proof against a local bare origin ---------------------------------
# The Phase 2 fix replaces /pr-ready step 3's bare `--force-with-lease` with an explicit
# refspec plus an explicit lease ref. These cases prove, against a real bare repo, that the
# OLD form publishes nothing on a branch with no upstream (the silent-failure bug), that the
# NEW form publishes, and that the lease still rejects a concurrent third-party push.
# Cases 1, 3 and 5 are Phase 2's NEGATIVE and BOUNDARY requirements: they assert that
# something must NOT happen. Never relax them into positive-only checks.

GITFIX="$SCRATCH/gitfix"
ORIGIN="$GITFIX/origin.git"
W="$GITFIX/work"
W2="$GITFIX/work2"
ZERO="0000000000000000000000000000000000000000"

# Isolated git: no signing, deterministic identity, fixed initial branch name -- so the
# developer's ~/.gitconfig cannot change the outcome, on macOS or on Linux CI.
g() { git -c user.name=t -c user.email=t@example.com -c commit.gpgsign=false \
          -c init.defaultBranch=master -c protocol.file.allow=always "$@"; }

remote_sha() { g -C "$W" ls-remote origin "$1" 2>/dev/null | awk '{print $1}'; }
commit_on()  { echo "$2" > "$1/f-$2.txt"; g -C "$1" add -A >/dev/null 2>&1; \
               g -C "$1" commit -q -m "$2" >/dev/null 2>&1; }

mkdir -p "$GITFIX"
g init --bare -q "$ORIGIN"
g clone -q "$ORIGIN" "$W" >/dev/null 2>&1
commit_on "$W" seed
g -C "$W" push -q origin HEAD:refs/heads/master >/dev/null 2>&1
g clone -q "$ORIGIN" "$W2" >/dev/null 2>&1

# --- case 11: the OLD bare form publishes nothing with no upstream ------------------------
# `bin/wt-new` creates branches WITHOUT -u, so @{upstream} is unset -- the only state in
# which the bug reproduces. Exit status is deliberately NOT asserted: it is push.default-
# dependent, which is precisely why "no error printed" was never evidence of a push.
begin_case
g -C "$W" checkout -q master
g -C "$W" checkout -q -b feat-old
commit_on "$W" old1
before="$(remote_sha feat-old)"
old_out="$(g -C "$W" push --force-with-lease 2>&1)"; old_rc=$?
after="$(remote_sha feat-old)"
[[ -z "$before" ]] || fail "feat-old should start with no remote ref, got '$before'"
[[ "$after" == "$before" ]] || fail "bare --force-with-lease PUBLISHED (remote '$before' -> '$after') -- the Phase 2 premise is wrong"
echo "  observed: bare --force-with-lease exit=$old_rc msg=$(head -1 <<< "$old_out")"
end_case push-old-form-does-not-publish

# --- case 12: the NEW explicit form publishes (3a -> 3b -> 3c) ----------------------------
begin_case
g -C "$W" checkout -q master
g -C "$W" checkout -q -b feat-new
commit_on "$W" new1
g -C "$W" push -q origin feat-new:refs/heads/feat-new >/dev/null 2>&1
commit_on "$W" new2
lease="$(remote_sha feat-new)"                                     # 3a
[[ ${#lease} -eq 40 ]] || fail "3a should read a 40-char SHA, got '$lease'"
new_out="$(g -C "$W" push -u --force-with-lease="feat-new:$lease" origin feat-new:feat-new 2>&1)"; new_rc=$?
[[ $new_rc -eq 0 ]] || fail "new form exited $new_rc, want 0 (out: $new_out)"   # 3b
head_sha="$(g -C "$W" rev-parse HEAD)"                             # 3c
[[ "$(remote_sha feat-new)" == "$head_sha" ]] || fail "3c: remote '$(remote_sha feat-new)' != HEAD '$head_sha'"
end_case push-new-form-publishes

# --- case 13: the lease STILL rejects a concurrent third-party push -----------------------
# The whole point of --force-with-lease. If this case ever passes trivially, the explicit
# lease has been reduced to a plain --force.
begin_case
g -C "$W" checkout -q master
g -C "$W" checkout -q -b feat-lease
commit_on "$W" lease1
g -C "$W" push -q origin feat-lease:refs/heads/feat-lease >/dev/null 2>&1
stale_lease="$(remote_sha feat-lease)"                             # 3a, captured early
g -C "$W2" fetch -q origin >/dev/null 2>&1                         # third party moves the ref
g -C "$W2" checkout -q -B feat-lease origin/feat-lease >/dev/null 2>&1
commit_on "$W2" third
g -C "$W2" push -q origin feat-lease:refs/heads/feat-lease >/dev/null 2>&1
third_sha="$(g -C "$W2" rev-parse HEAD)"
[[ "$(remote_sha feat-lease)" == "$third_sha" ]] || fail "fixture: third-party push did not land"
commit_on "$W" lease2
sl_out="$(g -C "$W" push -u --force-with-lease="feat-lease:$stale_lease" origin feat-lease:feat-lease 2>&1)"; sl_rc=$?
[[ $sl_rc -ne 0 ]] || fail "stale lease was ACCEPTED -- a concurrent push would have been clobbered"
grep -q 'stale info' <<< "$sl_out" || fail "rejection message lacks 'stale info' (out: $sl_out)"
[[ "$(remote_sha feat-lease)" == "$third_sha" ]] || fail "third party's commit was overwritten despite the lease"
end_case push-lease-still-rejects

# --- case 14: the all-zeros lease CREATES a ref that does not exist -----------------------
# 3a prints nothing when the branch has no remote ref; the doc says use 40 zeros.
begin_case
g -C "$W" checkout -q master
g -C "$W" checkout -q -b feat-zero
commit_on "$W" zero1
[[ -z "$(remote_sha feat-zero)" ]] || fail "fixture: feat-zero already has a remote ref"
z_out="$(g -C "$W" push -u --force-with-lease="feat-zero:$ZERO" origin feat-zero:feat-zero 2>&1)"; z_rc=$?
[[ $z_rc -eq 0 ]] || fail "zero-lease create exited $z_rc, want 0 (out: $z_out)"
[[ "$(remote_sha feat-zero)" == "$(g -C "$W" rev-parse HEAD)" ]] || fail "zero-lease did not create the remote ref"
end_case push-zero-lease-creates

# --- case 15: the all-zeros lease is NOT a force wildcard ---------------------------------
# Boundary case. If zeros were treated as "don't care", a copy-pasted 3b from an earlier
# branch would silently clobber an existing ref. A new local commit is required first, or
# git short-circuits with "Everything up-to-date" and never evaluates the lease.
begin_case
commit_on "$W" zero2
existing="$(remote_sha feat-zero)"
[[ ${#existing} -eq 40 ]] || fail "fixture: feat-zero should now have a remote ref"
zw_out="$(g -C "$W" push --force-with-lease="feat-zero:$ZERO" origin feat-zero:feat-zero 2>&1)"; zw_rc=$?
[[ $zw_rc -ne 0 ]] || fail "all-zeros lease ACCEPTED against an existing ref -- it is behaving as a wildcard"
[[ "$(remote_sha feat-zero)" == "$existing" ]] || fail "existing ref moved under an all-zeros lease"
end_case push-zero-lease-not-a-wildcard

# --- shared: review-shared companion surface -------------------------------------------------
# PRD points to the review-shared directory where moved scripts and includes now live.
PRD="$SCRIPT_DIR/../.claude/review-shared"

# --- case: post-plan-fleet aborts when review-shared assets absent --------------------
# Static assertion: verify bin/post-plan-fleet contains the Phase 4d gate that checks for
# review-shared/scripts/digest.sh before running. Behavioral test would need to remove the
# file from the main checkout (ROOT), not the worktree — not safe to do here.
begin_case
grep -qF 'review-shared/scripts/digest.sh' "$SCRIPT_DIR/../bin/post-plan-fleet" \
  || fail "post-plan-fleet: review-shared/scripts/digest.sh gate missing from bin/post-plan-fleet"
grep -qF 'repo may be missing review assets' "$SCRIPT_DIR/../bin/post-plan-fleet" \
  || fail "post-plan-fleet: Phase 4d abort message 'repo may be missing review assets' missing from bin/post-plan-fleet"
end_case post-plan-fleet-digest-gate

# --- case 19: E15 rebase delegate is never told to push ----------------------------------
# The delegate packet runs under ~/.claude/hooks/plan-gate-commit.sh, which denies `git push`
# for sub-agents. Any positive push instruction in the packet is an instant hard-fail.
begin_case
REBASE="$SCRIPT_DIR/../.claude/review-shared/_rebase-and-conflicts.md"
[[ -s "$REBASE" ]] || fail "e15: _rebase-and-conflicts.md missing or empty at $REBASE"

grep -qiE '(NOT|may not|must not) run.*git push' "$REBASE" \
    || fail "e15: delegate hard limits do not prohibit 'git push' (E15 regression)"
[[ "$(grep 'git push' "$REBASE" | grep -cviE '\b(NOT|never|may not|must not|cannot|do not)\b')" -eq 0 ]] \
    || fail "e15: positive 'git push' instruction in the delegate packet (E15 regression)"
end_case e15-delegate-no-push

# --- case 22: new pr-ready companions carry doc-freshness frontmatter --------------------
# bin/check-docs' IN_SCOPE_GLOBS covers .claude/skills/*/SKILL.md but NOT _*.md, so nothing
# else in the repo enforces this. The two PRE-EXISTING companions predate the convention and
# are deliberately excluded rather than retrofitted in an unrelated PR.
begin_case
for _c in _phase65-remediation.md _phase7-verdict.md; do
    head -1 "$PRD/$_c" | grep -qx -- '---' \
        || fail "$_c does not open with a YAML frontmatter fence"
    head -5 "$PRD/$_c" | grep -q '^description: ' \
        || fail "$_c is missing a 'description:' frontmatter key"
    head -5 "$PRD/$_c" | grep -qE '^last_verified: [0-9]{4}-[0-9]{2}-[0-9]{2}$' \
        || fail "$_c is missing a well-formed 'last_verified: YYYY-MM-DD' key"
done
end_case pr-ready-companion-frontmatter


# --- case 27: E22/E23 prevention prose pins -----------------------------------------------
# Pins the load-bearing phrases added by this PR's prevention work so a prose gutting is
# caught immediately rather than discovered in a future /pr-ready Phase 6 review.
begin_case
# 27a: E22 Class B — pre-commit scope-reconciliation step. Removing the numstat command
# from _phase65-remediation.md step 4 makes this fail.
grep -qF 'git diff --numstat HEAD' "$SCRIPT_DIR/../.claude/review-shared/_phase65-remediation.md" \
  || fail "27a: _phase65-remediation.md lost 'git diff --numstat HEAD' — E22 Class B prevention removed"
# 27b: E22 Class B — body correction command. Removing the gh pr edit line from step 4
# makes this fail.
grep -qF 'gh pr edit' "$SCRIPT_DIR/../.claude/review-shared/_phase65-remediation.md" \
  || fail "27b: _phase65-remediation.md lost 'gh pr edit' — E22 Class B prevention removed"
# 27c: E23 — named-constant-volume check (sub-clause 4a). Removing the 4a sub-clause from
# _plan-fidelity-review.md makes this fail.
grep -qF 'inheriting its blocking verdict' "$SCRIPT_DIR/../.claude/review-shared/_plan-fidelity-review.md" \
  || fail "27c: _plan-fidelity-review.md lost 'inheriting its blocking verdict' — E23 4a sub-clause removed"
# 27d: E23 — EXPECTED constant array check. Removing the named-constant prose from 4a
# makes this fail.
grep -qF '`EXPECTED` constant array' "$SCRIPT_DIR/../.claude/review-shared/_plan-fidelity-review.md" \
  || fail "27d: _plan-fidelity-review.md lost '\`EXPECTED\` constant array' — E23 4a sub-clause removed"
# 27e: coupling pin — "all six 6d checks" in 6a and "all six 6d classes" in
# _phase65-remediation.md forbid a 7th 6d class item; changing this count breaks both
# coupling statements and makes this fail.
grep -qF 'all six 6d checks' "$SCRIPT_DIR/../.claude/review-shared/_plan-fidelity-review.md" \
  || fail "27e: _plan-fidelity-review.md lost 'all six 6d checks' — coupling that forbids a 7th 6d class item removed"
end_case e22-e23-prevention-prose-pins

# --- case 28 (pr-ready skill block): merge-digest extraction + body shape ---
# Tests the digest.sh script (Phase 4) and the prose contracts in the four edited files.
# Four arms:
#   28a: a well-formed DIGEST section extracts verbatim (5 lines, correct labels, exact body)
#   28b: missing DIGEST section degrades to 5 placeholders (all "unavailable —", rc=0)
#   28c: 3-line DIGEST degrades wholly — no partial mix of real and placeholder
#   28d–f: label drift, absent/empty file, missing argument
#   28g: assembled-body ordering — ### Merge digest sits between fidelity and remediation,
#        <!-- pr-ready-verdict --> is the last line
#   28h–k: prose pins for the four edited files (DIGEST contract, labels, last_verified)
#   28n–28s: continuation-line fold coverage — six-physical-line digests with wrapped values
#     now parse; a stray labelled sixth line and an over-cap appendix still degrade;
#     MAX_PHYSICAL=10 is the cap boundary that arm 28s pins as inclusive (≤, not <).
# The placeholder uses an em dash (U+2014) — not a hyphen. A hyphen here fails 28b.
begin_case pr-ready-merge-digest-shape

D="$PRD/scripts/digest.sh"
DG="$SCRATCH/digest"; mkdir -p "$DG"

[[ -x "$D" ]] || fail "28: $D missing or not executable — Phase 4 chmod +x skipped"
bash -n "$D" 2>/dev/null || fail "28: digest.sh is not valid bash"

LABELS=( '**What changed:**' '**Why:**' '**Watch:**' '**Touches:**' '**Machine-authored fixes:**' )

# --- 28a: well-formed digest extracts verbatim ---
FIX="$DG/a.md"
cat > "$FIX" <<'FIX_A'
Plan fidelity: the diff matches the plan.

PASS

## DIGEST
**What changed:** Added a five-line merge digest to the pr-ready sticky comment.
**Why:** Prose and one new script; no runtime behavior on the PR itself changes.
**Watch:** .claude/review-shared/** and bin/test-post-plan-fleet.
**Touches:** none.
**Machine-authored fixes:** Digest text is model-authored and unverified against the diff.
FIX_A
out=$(bash "$D" "$FIX" 2>&1); rc=$?
[[ $rc -eq 0 ]] || fail "28a: rc=$rc (expected 0)"
[[ $(printf '%s\n' "$out" | wc -l | tr -d ' ') -eq 5 ]] || fail "28a: expected 5 lines, got $(printf '%s\n' "$out" | wc -l | tr -d ' ')"
for i in 0 1 2 3 4; do
  line=$(printf '%s\n' "$out" | sed -n "$((i+1))p")
  [[ "$line" == "${LABELS[$i]}"* ]] || fail "28a: line $((i+1)) does not start with ${LABELS[$i]}"
done
grep -qF 'Added a five-line merge digest' <<<"$out" || fail "28a: body text not preserved verbatim"
grep -qF 'unavailable' <<<"$out" && fail "28a: placeholder emitted for a valid digest"
grep -qxF 'PASS' <<<"$out" && fail "28a: verdict word leaked into digest output"

# --- 28b: no DIGEST section → 5 unavailable lines ---
FIX="$DG/b.md"
cat > "$FIX" <<'FIX_B'
Plan fidelity: the diff matches the plan.

PASS
FIX_B
out=$(bash "$D" "$FIX" 2>&1); rc=$?
[[ $rc -eq 0 ]] || fail "28b: rc=$rc (expected 0)"
[[ $(printf '%s\n' "$out" | wc -l | tr -d ' ') -eq 5 ]] || fail "28b: expected 5 lines, got $(printf '%s\n' "$out" | wc -l | tr -d ' ')"
for i in 0 1 2 3 4; do
  line=$(printf '%s\n' "$out" | sed -n "$((i+1))p")
  [[ "$line" == "${LABELS[$i]} unavailable"* ]] || fail "28b: line $((i+1)) not a placeholder: $line"
done
grep -qF 'Plan fidelity' <<<"$out" && fail "28b: file content leaked into degrade output"

# --- 28c: 3-line DIGEST degrades wholly (not partially) ---
FIX="$DG/c.md"
cat > "$FIX" <<'FIX_C'
PASS

## DIGEST

**What changed:** Something.
**Why:** Reasons.
**Watch:** Small.
FIX_C
out=$(bash "$D" "$FIX" 2>&1); rc=$?
[[ $rc -eq 0 ]] || fail "28c: rc=$rc (expected 0)"
[[ $(printf '%s\n' "$out" | wc -l | tr -d ' ') -eq 5 ]] || fail "28c: expected 5 lines, got $(printf '%s\n' "$out" | wc -l | tr -d ' ')"
for i in 0 1 2 3 4; do
  line=$(printf '%s\n' "$out" | sed -n "$((i+1))p")
  [[ "$line" == "${LABELS[$i]} unavailable"* ]] || fail "28c: line $((i+1)) not a placeholder: $line"
done
grep -qF 'Something.' <<<"$out" && fail "28c: partial digest emitted — first 3 lines kept real text, last 2 placeholdered"

# --- 28d: label drift → all 5 unavailable ---
FIX="$DG/d.md"
cat > "$FIX" <<'FIX_D'
PASS

## DIGEST
**What changed:** Something.
**Why this is safe:** Drift.
**Watch:** nothing specific.
**Touches:** bin/.
**Machine-authored fixes:** none.
FIX_D
out=$(bash "$D" "$FIX" 2>&1); rc=$?
[[ $rc -eq 0 ]] || fail "28d: rc=$rc (expected 0)"
[[ $(printf '%s\n' "$out" | wc -l | tr -d ' ') -eq 5 ]] || fail "28d: expected 5 lines"
for i in 0 1 2 3 4; do
  line=$(printf '%s\n' "$out" | sed -n "$((i+1))p")
  [[ "$line" == "${LABELS[$i]} unavailable"* ]] || fail "28d: line $((i+1)) not a placeholder: $line"
done

# --- 28e: absent and empty file ---
out=$(bash "$D" "$DG/nope.md" 2>&1); rc=$?
[[ $rc -eq 0 ]] || fail "28e: absent file rc=$rc (expected 0)"
[[ $(printf '%s\n' "$out" | wc -l | tr -d ' ') -eq 5 ]] || fail "28e: absent file expected 5 lines"
for i in 0 1 2 3 4; do
  line=$(printf '%s\n' "$out" | sed -n "$((i+1))p")
  [[ "$line" == "${LABELS[$i]} unavailable"* ]] || fail "28e: absent: line $((i+1)) not a placeholder"
done
: > "$DG/empty.md"
out=$(bash "$D" "$DG/empty.md" 2>&1); rc=$?
[[ $rc -eq 0 ]] || fail "28e: empty file rc=$rc (expected 0)"
[[ $(printf '%s\n' "$out" | wc -l | tr -d ' ') -eq 5 ]] || fail "28e: empty file expected 5 lines"
for i in 0 1 2 3 4; do
  line=$(printf '%s\n' "$out" | sed -n "$((i+1))p")
  [[ "$line" == "${LABELS[$i]} unavailable"* ]] || fail "28e: empty: line $((i+1)) not a placeholder"
done

# --- 28f: missing argument → STOP + exit 1 ---
out=$(bash "$D" 2>&1); rc=$?
[[ $rc -eq 1 ]] || fail "28f: missing arg rc=$rc (expected 1)"
grep -qF 'STOP:' <<<"$out" || fail "28f: missing arg: expected STOP: in output"

# --- 28g: assembled-body ordering ---
BODY="$DG/body.md"
{ printf '### Plan fidelity\nPASS\n\n### Merge digest\n%s\n\n### Remediation\nnone\n\n<!-- pr-ready-verdict -->\n' "$out2"; } > "$BODY"
# Use fixture A output for the digest lines
out_a=$(bash "$D" "$DG/a.md" 2>&1)
{ printf '`covers head 8ec4cd648189 \xc2\xb7 master d9e4478d64a9 \xc2\xb7 written 2026-09-06T22:04Z`\n\n### Plan fidelity\nPASS\n\n### Merge digest\n%s\n\n### Remediation\nnone\n\n<!-- pr-ready-verdict -->\n' "$out_a"; } > "$BODY"
n_fid=$(grep -n '^### Plan fidelity' "$BODY" | head -1 | cut -d: -f1)
n_dig=$(grep -n '^### Merge digest' "$BODY" | head -1 | cut -d: -f1)
n_rem=$(grep -n '^### Remediation' "$BODY" | head -1 | cut -d: -f1)
[[ $n_fid -lt $n_dig ]] || fail "28g: ### Plan fidelity must precede ### Merge digest"
[[ $n_dig -lt $n_rem ]] || fail "28g: ### Merge digest must precede ### Remediation"
n_dig_count=$(grep -c '^### Merge digest' "$BODY" || true)
[[ $n_dig_count -eq 1 ]] || fail "28g: expected exactly 1 ### Merge digest, got $n_dig_count"
[[ "$(tail -1 "$BODY")" == '<!-- pr-ready-verdict -->' ]] || fail "28g: <!-- pr-ready-verdict --> must be last line"
[[ $(grep -c '^<!-- pr-ready-verdict -->$' "$BODY" || true) -eq 1 ]] || fail "28g: expected exactly 1 marker"

# --- 28m: provenance line is the body's first line, above every heading ---
# It must sit above the first `### ` heading, never in or after the digest block:
# bin/digest-dm-build's _digest_labels folds any line lacking a `**Label:**` prefix onto the
# preceding label's value, so a provenance line inside that block corrupts the digest parse.
head -1 "$BODY" | grep -qE '^`covers head [0-9a-f]{12} [^ ]+ master [0-9a-f]{12} [^ ]+ written [0-9T:Z-]+`$' \
  || fail "28m: first body line is not the provenance line: $(head -1 "$BODY")"
n_prov=$(grep -c '^`covers head ' "$BODY" || true)
[[ $n_prov -eq 1 ]] || fail "28m: expected exactly 1 provenance line, got $n_prov"
n_prov_line=$(grep -n '^`covers head ' "$BODY" | head -1 | cut -d: -f1)
n_first_head=$(grep -n '^#' "$BODY" | head -1 | cut -d: -f1)
[[ $n_prov_line -lt $n_first_head ]] || fail "28m: provenance line must precede the first heading"
# The digest block must still fold to exactly the five labels with the provenance line present.
n_lbl=$(sed -n '/^### Merge digest/,/^### /p' "$BODY" | grep -c '^\*\*[^*]*:\*\*' || true)
[[ $n_lbl -eq 5 ]] || fail "28m: digest block folds to $n_lbl labels, expected 5"

# --- 28h: .claude/agents/pr-ready-phase6.md prose pins ---
f="$PRD/../agents/pr-ready-phase6.md"
grep -qF '## DIGEST' "$f" || fail "28h: ## DIGEST missing from pr-ready-phase6.md"
grep -qF '**What changed:**' "$f" || fail "28h: **What changed:** missing from pr-ready-phase6.md"
grep -qF '**Why:**' "$f" || fail "28h: **Why:** missing from pr-ready-phase6.md"
grep -qF '**Watch:**' "$f" || fail "28h: **Watch:** missing from pr-ready-phase6.md"
grep -qF '**Touches:**' "$f" || fail "28h: **Touches:** missing from pr-ready-phase6.md"
grep -qF '**Machine-authored fixes:**' "$f" || fail "28h: **Machine-authored fixes:** missing from pr-ready-phase6.md"
grep -qF 'and nothing after it' "$f" || fail "28h: 'and nothing after it' missing from pr-ready-phase6.md"
# Voice-contract wiring: the on-demand Read and the rewrite-once self-check. Both are prose
# instructions with no runtime signal, so a clause pin is the only mechanical proof they survive.
grep -qF '.claude/review-shared/_prose-voice-contract.md' "$f" \
    || fail "28h: voice-contract Read instruction missing from pr-ready-phase6.md"
grep -qF 'bin/check-digest-prose' "$f" \
    || fail "28h: rewrite-once linter invocation missing from pr-ready-phase6.md"
grep -qF 'rewrite **that line once**' "$f" \
    || fail "28h: rewrite-once discipline clause missing from pr-ready-phase6.md"
grep -qF '.claude/skills/review-shared/' "$f" \
    && fail "28h: pr-ready-phase6.md cites the non-existent .claude/skills/review-shared/ path"
# Floor, not an equality pin (matches 28j below): an exact date makes every later edit to
# pr-ready-phase6.md fail this assertion for bumping the field the doc gate requires it to bump.
lv=$(grep -m1 -oE '^last_verified: [0-9-]+' "$f" | cut -d' ' -f2); [[ "$lv" > "2026-09-03" ]] || fail "28h: last_verified not bumped in pr-ready-phase6.md (got $lv)"
