pr_unresolved_findings_hold 42 > "$out21"
assert_contains "case21: garbage fixture → api-error" "$out21" "unresolved-findings-api-error"
GH_THREADS_FIXTURE="$BASE_TMP/threads.json"

# ── case 22: exactly 100 nodes → cap (not individual findings) ───────────────
fix22="$BASE_TMP/threads22.json"
jq -n '{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":
  [range(100) | {"isResolved":false,"comments":{"nodes":[{"databaseId":.,"body":"Bug <!-- score: 85 -->"}]}}]
}}}}}' > "$fix22"
GH_THREADS_FIXTURE="$fix22"
out22="$BASE_TMP/case22.txt"
pr_unresolved_findings_hold 42 > "$out22"
assert_contains "case22: 100-node cap → unresolved-findings-cap" "$out22" "unresolved-findings-cap"
assert_not_contains "case22: cap suppresses individual finding lines" "$out22" "unresolved-finding:"
GH_THREADS_FIXTURE="$BASE_TMP/threads.json"

# ── case 23: GH_CMD=/bin/false → non-zero exit → api-error ──────────────────
SAVED_GH_CMD="$GH_CMD"
GH_CMD="/bin/false"
out23="$BASE_TMP/case23.txt"
pr_unresolved_findings_hold 42 > "$out23"
assert_contains "case23: GH_CMD=/bin/false → api-error" "$out23" "unresolved-findings-api-error"
GH_CMD="$SAVED_GH_CMD"

# ── case 24: clear path returns 0 under set -euo pipefail ────────────────────
# Must use empty-nodes fixture ($fix19) so findings="" — the clear path where
# [ -n "$findings" ] exits 1. Without return 0 the function would return 1 and
# abort bin/pr-triage's set -euo pipefail loop on every PR with no findings.
( set -euo pipefail; GH_THREADS_FIXTURE="$fix19"; source "$LIB_ARM"; pr_unresolved_findings_hold 42 >/dev/null ) \
    && ok "case24: clear path returns 0 under strict mode" \
    || fail "case24: clear path returned non-zero — pr-triage would abort"

# ── structural: condition (11) block exists and is self-contained ─────────────
COND11_FILE="$REPO_ROOT/.claude/skills/post-plan/_phase-6.5-arm-auto-merge.md"
if grep -q '# condition (11)' "$COND11_FILE" \
    && grep -A4 '# condition (11)' "$COND11_FILE" | grep -q 'bin/lib/pr-armable.sh'; then
    ok "structural: condition (11) block exists and references pr-armable.sh"
else
    fail "structural: condition (11) block missing or does not reference pr-armable.sh in first 4 lines"
fi

# ── structural case 25: every emitter surface forbids hand-writing the comment ──
# Backlog E24: Phase 4B's posting step used to mandate the helper in prose only, so a
# run could compose the comment freehand. The review still happened, but the artifact
# landed outside the helper's envelope and became invisible to 4b-probe.sh (PHASE_4B_RAN
# false-negative), to resolve_review_finding, and to unresolved-findings-hold. Observed
# on PRs #1956 and #2001. The prohibition is prose, so assert it statically — deleting
# it must fail CI rather than silently reopening the hole.
for f in \
    "$REPO_ROOT/.claude/skills/post-plan/_phase-4-review-audit.md" \
    "$REPO_ROOT/.claude/review-shared/_posting-procedure.md"
do
    name="$(basename "$f")"
    if grep -qi 'compose .* by hand' "$f" 2>/dev/null \
        && grep -q '4b-probe\.sh' "$f" 2>/dev/null; then
        ok "case25: $name forbids hand-written review comments and names the 4B probe"
    else
        fail "case25: $name lost the never-hand-write prohibition or the 4b-probe.sh consumer reference — a freehand review comment becomes undetectable again (E24)"
    fi
done

# The two other emitters inherit the prohibition only by reading the shared file.
for f in \
    "$REPO_ROOT/.claude/skills/pr-review/SKILL.md" \
    "$REPO_ROOT/.claude/skills/security-audit/SKILL.md"
do
    name="$(basename "$f")"
    if grep -q '_posting-procedure\.md' "$f" 2>/dev/null; then
        ok "case25: $name still reads _posting-procedure.md"
    else
        fail "case25: $name no longer reads _posting-procedure.md — it stops inheriting the never-hand-write prohibition"
    fi
done

# ── case 25b: 4b-probe.sh's envelope regex still matches what this lib emits ───
# /pr-ready Phase 4B's probe answers "is this hit a real review artifact?" mechanically,
# by testing each comment body against an envelope regex copied from this lib's printf
# calls. If either side is reworded the probe silently reclassifies every genuine review
# as `freehand`, the Phase 6 reviewer is left with suspicion and no positive test, and it
# drifts back to reading the /pulls/<N>/reviews endpoint — which is empty by construction
# here, because post_review_summary posts via `gh pr comment`. That is the PR #2182 false
# `REVIEW-COVERAGE: NONE`. Assert the coupling functionally rather than by eye: pull the
# regex out of the probe itself, then run it over output this lib really produced.
PROBE_SH="$REPO_ROOT/.claude/review-shared/scripts/4b-probe.sh"
ENVELOPE_RE=""
if [ -r "$PROBE_SH" ]; then
    # The probe embeds the regex inside a jq string literal, so its backslashes are
    # doubled there; halve them to recover the regex jq actually compiles.
    ENVELOPE_RE="$(grep -o 'test("<summary>[^"]*")' "$PROBE_SH" | head -1 | sed 's/^test("//; s/")$//; s/\\\\/\\/g')"
    ENVELOPE_HITS="$(grep -c 'test("<summary>[^"]*")' "$PROBE_SH" || true)"
fi
if [ -n "$ENVELOPE_RE" ] && [ "${ENVELOPE_HITS:-0}" -ge 2 ]; then
    ok "case25b: recovered the helper-envelope regex from 4b-probe.sh (present in ${ENVELOPE_HITS} channels)"
elif [ -n "$ENVELOPE_RE" ]; then
    fail "case25b: helper-envelope regex exists but appears in only ${ENVELOPE_HITS} channel(s) in 4b-probe.sh — the reviews-channel copy may have drifted"
else
    fail "case25b: no helper-envelope regex in 4b-probe.sh — the probe lost its discriminator, so every real review reclassifies as freehand (PR #2182 class)"
fi

if [ -n "$ENVELOPE_RE" ]; then
    _C25B_SAVED_COMMENT_OUT="$COMMENT_OUT"
    COMMENT_OUT="$BASE_TMP/c25b-summary.txt"
    : > "$COMMENT_OUT"
    post_review_summary 999 "Code review" "No issues found. Architecture clean." >/dev/null 2>&1
    # `jq -e` exits 1 on a false/null result, so the verdict is the exit status.
    # Do NOT grep for a word here: a "NOMATCH" sentinel contains "MATCH".
    if jq -e -Rs --arg re "$ENVELOPE_RE" 'test($re)' < "$COMMENT_OUT" >/dev/null; then
        ok "case25b: post_review_summary output matches the probe's helper-envelope regex"
    else
        fail "case25b: post_review_summary output NO LONGER matches 4b-probe.sh's envelope regex — a clean review would be labelled freehand; fix both sides together"
    fi
    COMMENT_OUT="$_C25B_SAVED_COMMENT_OUT"
    unset _C25B_SAVED_COMMENT_OUT
fi

# The regex's second alternative covers both post_review_findings channels, which share
# the "Found N issue(s)" opener. Assert that opener still exists rather than re-driving
# the whole partition path a second time.
# shellcheck disable=SC2016  # ${on_count} is a literal in the lib source, not an expansion here
if grep -qF "Found %d issue(s)" "$LIB" && grep -qF 'Found ${on_count} issue(s)' "$LIB"; then
    ok "case25b: both post_review_findings channels still emit the 'Found N issue(s)' opener"
else
    fail "case25b: a post_review_findings channel lost the 'Found N issue(s)' opener that 4b-probe.sh's envelope regex keys on"
fi

# ── case 26: no temp-dir leak under zsh ───────────────────────────────────────
# `trap ... RETURN` is bash-only. /pr-review sources this lib from a zsh shell,
# where the trap command errors ("undefined signal: RETURN") and every call
# leaks its mktemp -d. Observed live on PR #2089's review run. The rest of this
# harness runs under bash, so the bug was structurally invisible to it — this
# case is the only one that exercises the other sourcing shell.
if command -v zsh >/dev/null 2>&1; then
    ZT="$BASE_TMP/zshcase"
    mkdir -p "$ZT/tmpdir" "$ZT/bin"

    # macOS `mktemp -d` ignores TMPDIR, so the leak cannot be observed by
    # sandboxing the temp root. Shim mktemp instead: it forces the dir into
    # $ZT/tmpdir AND records the path, so the assertion below is exact rather
    # than a scan of a shared temp root that other processes also write to.
    # Resolve the real binary FIRST: `command mktemp` inside the shim would not
    # bypass PATH lookup and would re-find the shim, recursing forever.
    REAL_MKTEMP="$(command -v mktemp)"
    cat > "$ZT/bin/mktemp" <<MKTEMP
#!/usr/bin/env bash
d="\$("$REAL_MKTEMP" -d "$ZT/tmpdir/tmp.XXXXXXXX")"
printf '%s\\n' "\$d" >> "$ZT/created.txt"
printf '%s\\n' "\$d"
MKTEMP
    chmod +x "$ZT/bin/mktemp"

    ZERR="$ZT/stderr.txt"
    : > "$ZT/created.txt"
    # -f skips rc files, so the exported PATH survives (a plain `zsh -c` would
    # let a user's ~/.zshenv reset it and the mktemp shim would never be found).
    PATH="$ZT/bin:$PATH" GH_CMD="$SHIMD/gh" COMMENT_OUT="$ZT/comment.out" \
        zsh -f -c "source '$LIB'; post_review_summary 1 'Code review' 'No issues found.'" \
        >/dev/null 2>"$ZERR"

    if grep -qi 'undefined signal' "$ZERR"; then
        fail "case26: post_review_summary emits '$(tr -d '\n' < "$ZERR")' under zsh — the RETURN trap never installs and the temp dir leaks"
    else
        ok "case26: post_review_summary installs its cleanup trap cleanly under zsh"
    fi

    CREATED=$(wc -l < "$ZT/created.txt" | tr -d ' ')
    if [ "$CREATED" -eq 0 ]; then
        fail "case26: mktemp shim never fired — the leak assertion below would be vacuous"
    else
        LEAKED=0
        while IFS= read -r d; do
            [ -n "$d" ] && [ -e "$d" ] && LEAKED=$((LEAKED + 1))
        done < "$ZT/created.txt"
        if [ "$LEAKED" -eq 0 ]; then
            ok "case26: post_review_summary removed all $CREATED temp dir(s) it created under zsh"
        else
            fail "case26: post_review_summary leaked $LEAKED of $CREATED temp dir(s) under zsh"
        fi
    fi

    if grep -q 'no issues found' "$ZT/comment.out" 2>/dev/null; then
        ok "case26: post_review_summary still posts its comment under zsh"
    else
        fail "case26: post_review_summary produced no comment under zsh"
    fi
else
    ok "case26: zsh not installed — skipped"
fi

# ── pin-A: prf_review_threads emits one object per thread with the 8 base keys ─
# Characterization: Phase 2 ADDS authorLogin/authorType; every key here must
# survive that edit unchanged (superset assertion, so the pin stays green-green).
GH_THREADS_FIXTURE="$BASE_TMP/threads.json"
PIN_A="$BASE_TMP/pin-a.jsonl"
prf_review_threads 42 > "$PIN_A"
if [ "$(wc -l < "$PIN_A")" -eq 4 ]; then
    ok "pin-A: 4 thread objects from the 4-node fixture"
else
    fail "pin-A: expected 4 objects, got $(wc -l < "$PIN_A")"
fi
if jq -e 'has("id") and has("isResolved") and has("isOutdated") and has("path")
          and has("line") and has("commentId") and has("score") and has("body")' \
      "$PIN_A" >/dev/null 2>&1; then
    ok "pin-A: every object carries the 8 base keys"
else
    fail "pin-A: a thread object lost a base key"
fi
if jq -s -e '.[0].score == 85 and .[2].score == null and .[3].commentId == null
             and .[2].isOutdated == true' "$PIN_A" >/dev/null 2>&1; then
    ok "pin-A: score parse, null score, ghost commentId, isOutdated preserved"
else
    fail "pin-A: per-thread derived fields drifted"
fi

# ── pin-B: list_open_review_findings TSV is exactly 4 tab-separated columns ───
PIN_B="$BASE_TMP/pin-b.tsv"
list_open_review_findings 42 > "$PIN_B"
if [ -z "$(awk -F'\t' 'NF != 4' "$PIN_B")" ] && [ -s "$PIN_B" ]; then
    ok "pin-B: every row has 4 columns"
else
    fail "pin-B: column drift in list_open_review_findings"
fi

# ── pin-D: authorLogin / authorType come from the ROOT comment, null-safe ──────
PIN_D="$BASE_TMP/pin-d.jsonl"
prf_review_threads 42 > "$PIN_D"
if jq -s -e '.[0].authorLogin == "a-jay85" and .[0].authorType == "User"
             and .[1].authorLogin == "claude[bot]" and .[1].authorType == "Bot"' \
      "$PIN_D" >/dev/null 2>&1; then
    ok "pin-D: User and Bot authors projected from the first comment"
else
    fail "pin-D: author projection wrong: $(jq -c '{authorLogin,authorType}' "$PIN_D" | tr '\n' ' ')"
fi
if jq -s -e '.[2].authorLogin == "" and .[2].authorType == ""
             and .[3].authorLogin == "" and .[3].authorType == ""' \
      "$PIN_D" >/dev/null 2>&1; then
    ok "pin-D: null author and comment-less thread both yield empty strings"
else
    fail "pin-D: null-author guard missing (would break list_trusted_open_threads)"
fi
if [ "$(wc -l < "$PIN_D")" -eq 4 ]; then
    ok "pin-D: author field did not abort the ghost thread"
else
    fail "pin-D: expected 4 objects, got $(wc -l < "$PIN_D")"
fi

# ── pin-E: the GraphQL selection requests author { login __typename } ─────────
if grep -qE 'comments\(first:1\) \{ nodes \{ databaseId body author \{ login __typename \} \} \}' "$LIB"; then
    ok "pin-E: prf_review_threads query selects author.login and author.__typename"
else
    fail "pin-E: author selection missing from prf_review_threads GraphQL query"
fi

# ── trust-1..: list_trusted_open_threads ──────────────────────────────────────
# t1 a-jay85 User, unscored        → listed (owner login)
# t2 "claude" Bot, scored 90       → listed (typename Bot)
# t3 "github-actions[bot]" User    → listed ([bot] suffix alone is enough)
# t4 "stranger" User               → excluded (untrusted)
# t5 a-jay85, isOutdated true      → excluded (outdated never actioned)
# t6 a-jay85, isResolved true      → excluded (already dispositioned)
# t7 "a-jay85-evil" User           → excluded (login is equality, not prefix)
# t8 author null                   → excluded (deleted account is untrusted)
# t9 "bot" User                    → excluded (suffix must be literal "[bot]")
# t10 comments empty (ghost)       → excluded (no commentId), must not abort
fixT="$BASE_TMP/threads-trust.json"
cat > "$fixT" <<'THREADST'
{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":[
  {"id":"PRRT_t1","isResolved":false,"isOutdated":false,"path":"classes/A.php","line":5,
   "comments":{"nodes":[{"databaseId":601,"body":"Unscored from the owner","author":{"login":"a-jay85","__typename":"User"}}]}},
  {"id":"PRRT_t2","isResolved":false,"isOutdated":false,"path":"classes/B.php","line":6,
   "comments":{"nodes":[{"databaseId":602,"body":"Scored bot\n\n<!-- score: 90 -->","author":{"login":"claude","__typename":"Bot"}}]}},
  {"id":"PRRT_t3","isResolved":false,"isOutdated":false,"path":"classes/C.php","line":7,
   "comments":{"nodes":[{"databaseId":603,"body":"Suffix bot","author":{"login":"github-actions[bot]","__typename":"User"}}]}},
  {"id":"PRRT_t4","isResolved":false,"isOutdated":false,"path":"classes/D.php","line":8,
   "comments":{"nodes":[{"databaseId":604,"body":"Stranger","author":{"login":"stranger","__typename":"User"}}]}},
  {"id":"PRRT_t5","isResolved":false,"isOutdated":true,"path":"classes/E.php","line":null,
   "comments":{"nodes":[{"databaseId":605,"body":"Old from the owner","author":{"login":"a-jay85","__typename":"User"}}]}},
  {"id":"PRRT_t6","isResolved":true,"isOutdated":false,"path":"classes/F.php","line":9,
   "comments":{"nodes":[{"databaseId":606,"body":"Done","author":{"login":"a-jay85","__typename":"User"}}]}},
  {"id":"PRRT_t7","isResolved":false,"isOutdated":false,"path":"classes/G.php","line":10,
   "comments":{"nodes":[{"databaseId":607,"body":"Imposter","author":{"login":"a-jay85-evil","__typename":"User"}}]}},
  {"id":"PRRT_t8","isResolved":false,"isOutdated":false,"path":"classes/H.php","line":11,
   "comments":{"nodes":[{"databaseId":608,"body":"No author","author":null}]}},
  {"id":"PRRT_t9","isResolved":false,"isOutdated":false,"path":"classes/I.php","line":12,
   "comments":{"nodes":[{"databaseId":609,"body":"Bare bot","author":{"login":"bot","__typename":"User"}}]}},
  {"id":"PRRT_t10","isResolved":false,"isOutdated":false,"path":null,"line":null,
   "comments":{"nodes":[]}}
]}}}}}
THREADST
GH_THREADS_FIXTURE="$fixT"
TRUST_OUT="$BASE_TMP/trust.jsonl"
list_trusted_open_threads 42 > "$TRUST_OUT"; rcT=$?
[ "$rcT" -eq 0 ] && ok "trust: rc 0 under the cap" || fail "trust: rc $rcT, expected 0"
got=$(jq -r '.commentId' "$TRUST_OUT" | sort | tr '\n' ' ')
if [ "$got" = "601 602 603 " ]; then
    ok "trust: exactly 601 602 603 listed (owner, Bot typename, [bot] suffix)"
else
    fail "trust: expected '601 602 603 ', got '$got'"
fi
assert_not_contains "trust: untrusted user 604 excluded"        "$TRUST_OUT" '"commentId":604'
assert_not_contains "trust: outdated trusted 605 excluded"      "$TRUST_OUT" '"commentId":605'
assert_not_contains "trust: resolved trusted 606 excluded"      "$TRUST_OUT" '"commentId":606'
assert_not_contains "trust: login prefix imposter 607 excluded" "$TRUST_OUT" '"commentId":607'
assert_not_contains "trust: null author 608 excluded"           "$TRUST_OUT" '"commentId":608'
assert_not_contains "trust: bare 'bot' login 609 excluded"      "$TRUST_OUT" '"commentId":609'
assert_not_contains "trust: ghost thread never listed as null"  "$TRUST_OUT" '"commentId":null'
if jq -e 'has("id") and has("path") and has("line") and has("body") and has("score")' \
      "$TRUST_OUT" >/dev/null 2>&1; then
    ok "trust: full thread objects (id/path/line/body/score) pass through"
else
    fail "trust: output lost fields callers need for fix-or-decline"
fi

# ── trust-cap: 100 nodes → nothing on stdout, rc 2 ────────────────────────────
fixTcap="$BASE_TMP/threads-trust-cap.json"
jq -n '{data:{repository:{pullRequest:{reviewThreads:{nodes:
        [range(100) | {id:("PRRT_c"+tostring), isResolved:false, isOutdated:false,
                       path:"classes/Cap.php", line:1,
                       comments:{nodes:[{databaseId:(700+.), body:"cap",
                                         author:{login:"a-jay85", __typename:"User"}}]}}]}}}}}' \
   > "$fixTcap"
GH_THREADS_FIXTURE="$fixTcap"
CAP_OUT="$BASE_TMP/trust-cap.jsonl"
list_trusted_open_threads 42 > "$CAP_OUT" 2>"$BASE_TMP/trust-cap.err"; rcC=$?
if [ "$rcC" -eq 2 ] && [ ! -s "$CAP_OUT" ]; then
    ok "trust-cap: 100 nodes → empty stdout, rc 2 (skip ingestion)"
else
    fail "trust-cap: rc $rcC, stdout $(wc -l < "$CAP_OUT") lines; expected rc 2 and empty"
fi
assert_contains "trust-cap: stderr names the cap" "$BASE_TMP/trust-cap.err" "100-thread page cap"

# ── trust-default: the default fixture yields only thread 111 ─────────────────
GH_THREADS_FIXTURE="$BASE_TMP/threads.json"
DEF_OUT="$BASE_TMP/trust-default.jsonl"
list_trusted_open_threads 42 > "$DEF_OUT"
if [ "$(jq -r '.commentId' "$DEF_OUT" | tr '\n' ' ')" = "111 " ]; then
    ok "trust-default: only 111 (333 is outdated + null author, 222 resolved)"
else
    fail "trust-default: got $(jq -r '.commentId' "$DEF_OUT" | tr '\n' ' ')"
fi

# ── hold-1: score 50 (below the old floor) now holds with its score ───────────
fixH1="$BASE_TMP/threads-hold1.json"
cat > "$fixH1" <<'H1'
{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":[
  {"isResolved":false,"isOutdated":false,"comments":{"nodes":[{"databaseId":801,"body":"Minor\n\n<!-- score: 50 -->"}]}}
]}}}}}
H1
GH_THREADS_FIXTURE="$fixH1"; outH1="$BASE_TMP/hold1.txt"
pr_unresolved_findings_hold 42 > "$outH1"
[ "$(cat "$outH1")" = "unresolved-finding:50" ] \
    && ok "hold-1: score 50 emits unresolved-finding:50" \
    || fail "hold-1: got '$(cat "$outH1")'"

# ── hold-2: unresolved + isOutdated → holds (never actioned, still blocks) ────
fixH2="$BASE_TMP/threads-hold2.json"
cat > "$fixH2" <<'H2'
{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":[
  {"isResolved":false,"isOutdated":true,"comments":{"nodes":[{"databaseId":802,"body":"Stale anchor","author":{"login":"a-jay85","__typename":"User"}}]}}
]}}}}}
H2
GH_THREADS_FIXTURE="$fixH2"; outH2="$BASE_TMP/hold2.txt"
pr_unresolved_findings_hold 42 > "$outH2"
[ "$(cat "$outH2")" = "unresolved-finding:-" ] \
    && ok "hold-2: outdated unresolved thread emits unresolved-finding:-" \
    || fail "hold-2: got '$(cat "$outH2")'"

# ── hold-3: trusted author does NOT exempt the hold ───────────────────────────
fixH3="$BASE_TMP/threads-hold3.json"
cat > "$fixH3" <<'H3'
{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":[
  {"isResolved":false,"isOutdated":false,"comments":{"nodes":[{"databaseId":803,"body":"From a bot","author":{"login":"claude[bot]","__typename":"Bot"}}]}},
  {"isResolved":true,"isOutdated":false,"comments":{"nodes":[{"databaseId":804,"body":"Resolved\n\n<!-- score: 100 -->"}]}}
]}}}}}
H3
GH_THREADS_FIXTURE="$fixH3"; outH3="$BASE_TMP/hold3.txt"
pr_unresolved_findings_hold 42 > "$outH3"
[ "$(cat "$outH3")" = "unresolved-finding:-" ] \
    && ok "hold-3: bot-authored unresolved holds; resolved score-100 does not" \
    || fail "hold-3: got '$(tr '\n' ' ' < "$outH3")'"

# ── hold-4: rc stays 0 under set -e when every thread holds ───────────────────
( set -euo pipefail; GH_THREADS_FIXTURE="$fixH3"; source "$LIB_ARM"; pr_unresolved_findings_hold 42 >/dev/null ) \
    && ok "hold-4: predicate returns 0 with findings present" \
    || fail "hold-4: non-zero exit with findings present"
GH_THREADS_FIXTURE="$BASE_TMP/threads.json"

# ── p45: Phase 4.5 doc blocks exist once, parse, and sit in the right order ────
P4DOC="$REPO_ROOT/.claude/skills/post-plan/_phase-4-review-audit.md"
PPDOC="$REPO_ROOT/.claude/review-shared/_posting-procedure.md"
p45_block() { awk -v m="$1" '$0==m{f=1} f&&/^```$/{exit} f' "$P4DOC"; }
for m in '# phase 4.5 snapshot' '# phase 4.5 remediate' '# phase 4.5 commit-and-resolve'; do
    [ "$(grep -cF "$m" "$P4DOC")" -eq 1 ] && ok "p45: marker '$m' once" || fail "p45: marker '$m' count != 1"
    p45_block "$m" | bash -n 2>/dev/null && ok "p45: block '$m' parses" || fail "p45: block '$m' does not parse"
done
snap_ln=$(grep -nF '# phase 4.5 snapshot' "$P4DOC" | cut -d: -f1)
post_ln=$(grep -nF 'post_review_findings "$PR" "$FULL_SHA" "Code review"' "$P4DOC" | head -1 | cut -d: -f1)
[ "$snap_ln" -lt "$post_ln" ] && ok "p45: snapshot precedes the first posting call" \
    || fail "p45: snapshot ($snap_ln) is not before the first post_review_findings ($post_ln)"
for f in "$P4DOC" "$PPDOC"; do
    assert_contains "p45: $(basename "$f") names list_trusted_open_threads" "$f" "list_trusted_open_threads"
    assert_contains "p45: $(basename "$f") states the decline convention"  "$f" "Declined: "
done
assert_contains "p45: SKILL.md routes 4D -> 4.5 -> 5" "$REPO_ROOT/.claude/skills/post-plan/SKILL.md" "then 4.5, in order"

# ── p45-filter: the remediate block honors the pre-4D snapshot ────────────────
# Default fixture: 111 is trusted+open. Snapshot {111} → 1 work item; snapshot {999} → 0.
run_p45_remediate() { # snapshot-ids-newline-separated
    ( export PR=42; PPID_FAKE=$$; printf '%s\n' "$1" > "/tmp/post-plan-pre4d-thread-ids-$PPID_FAKE.txt"
      p45_block '# phase 4.5 remediate' | sed "s/\$PPID/$PPID_FAKE/g" | bash
      wc -l < "/tmp/post-plan-p45-work-$PPID_FAKE.jsonl" | tr -d ' '
      rm -f /tmp/post-plan-pre4d-thread-ids-$PPID_FAKE.txt /tmp/post-plan-p45-*-$PPID_FAKE.jsonl )
}
[ "$(run_p45_remediate 111 | tail -1)" = "1" ] && ok "p45-filter: pre-existing 111 selected" \
    || fail "p45-filter: expected 1 work item for snapshot {111}"
[ "$(run_p45_remediate 999 | tail -1)" = "0" ] && ok "p45-filter: fresh thread (not in snapshot) skipped" \
    || fail "p45-filter: expected 0 work items for snapshot {999}"
[ "$(run_p45_remediate '' | tail -1)" = "0" ] && ok "p45-filter: empty snapshot acts on nothing" \
    || fail "p45-filter: expected 0 work items for an empty snapshot"

# ── summary ───────────────────────────────────────────────────────────────────
if [ "$FAILED" -eq 0 ]; then
    echo "All post-review-findings checks passed."
else
    echo "Some post-review-findings checks FAILED."
fi
exit "$FAILED"
