#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/merge-line-select — Head-of-line selector for the armed-PR merge line.
#
# A pure decision function over one pullRequests GraphQL snapshot. The line is
# every auto-merge-armed, non-draft PR based on master, in FIFO order of
# autoMergeRequest.enabledAt (PR number breaks ties). The head is the first
# member that is neither conflicted nor red on a required check. It never calls
# update-branch, never posts a comment, never writes to GitHub — the workflows
# act on its output (see .github/workflows/update-behind-prs.yml, ADR-0081).
#
# Portability (gate 17): runs under /bin/bash 3.2 with PATH=/usr/bin:/bin. All
# selection logic is ONE jq program; bash only parses flags and moves bytes.
#
# Exit codes: 0 = ran; 1 = runtime error (fetch failed, bad snapshot, --pr not
#             found); 2 = usage error.

set -euo pipefail

GH_CMD="${GH_CMD:-gh}"

usage() {
    cat <<'EOF'
Usage: bin/merge-line-select (--input <file|-> | --live --repo <owner/name>)
                             [--list | --pr <n>] [--dry-run] [--summary <file>]

Source (exactly one):
  --input <file|->   Read a pullRequests GraphQL response from a file or stdin.
  --live             Fetch the snapshot with one GraphQL call via $GH_CMD (default gh).
  --repo <o/n>       Required with --live. Rejected without it.
Mode (at most one; default is the head-of-line pass):
  --list             Print the armed line as one compact JSON array, FIFO order.
  --pr <n>           Evaluate one named open PR on master (manual dispatch path).
Output:
  --dry-run          Adds dry_run=true and a dry-run banner to the summary.
  --summary <file>   Append a markdown report to <file> (/dev/stdout allowed).
  -h, --help         Show this message.
Exit: 0 ran; 1 runtime error (fetch failed, bad snapshot, --pr not found); 2 usage error.
EOF
}

die_usage() {
    echo "merge-line-select: $1" >&2
    usage >&2
    exit 2
}

INPUT=""
LIVE=0
REPO=""
MODE="pass"
PR_NUM=""
DRY_RUN="false"
SUMMARY=""

while [ $# -gt 0 ]; do
    case "$1" in
        --input)
            [ $# -ge 2 ] || die_usage "--input requires a value"
            INPUT="$2"
            shift 2
            ;;
        --live)
            LIVE=1
            shift
            ;;
        --repo)
            [ $# -ge 2 ] || die_usage "--repo requires a value"
            REPO="$2"
            shift 2
            ;;
        --list)
            [ "$MODE" != "pr" ] || die_usage "--list and --pr are mutually exclusive"
            MODE="list"
            shift
            ;;
        --pr)
            [ $# -ge 2 ] || die_usage "--pr requires a PR number"
            [ "$MODE" != "list" ] || die_usage "--list and --pr are mutually exclusive"
            case "$2" in
                ''|*[!0-9]*) die_usage "--pr must be a number, got: $2" ;;
            esac
            MODE="pr"
            PR_NUM="$2"
            shift 2
            ;;
        --dry-run)
            DRY_RUN="true"
            shift
            ;;
        --summary)
            [ $# -ge 2 ] || die_usage "--summary requires a file"
            SUMMARY="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            die_usage "unknown flag: $1"
            ;;
    esac
done

if [ "$LIVE" = 1 ] && [ -n "$INPUT" ]; then
    die_usage "--input and --live are mutually exclusive"
fi
if [ "$LIVE" = 0 ] && [ -z "$INPUT" ]; then
    die_usage "one of --input or --live is required"
fi
if [ "$LIVE" = 1 ] && [ -z "$REPO" ]; then
    die_usage "--live requires --repo"
fi
if [ "$LIVE" = 0 ] && [ -n "$REPO" ]; then
    die_usage "--repo is only valid with --live"
fi

# The decision program. Semantics are binding (plan: merge-line-head-of-line).
# shellcheck disable=SC2016  # jq program: $-variables are jq's, not the shell's
SELECT_JQ='
def required: ["Tests and Analysis","E2E Tests","human-signoff","Meta checks"];
def ctx_name: (.name // .context // "");
def ctx_red:
  if .__typename == "CheckRun" then
    (.status == "COMPLETED")
    and ((.conclusion // "") as $c | any(["FAILURE","TIMED_OUT","STARTUP_FAILURE"][]; . == $c))
  elif .__typename == "StatusContext" then
    ((.state // "") as $s | any(["FAILURE","ERROR"][]; . == $s))
  else false end;
def is_red:
  [ (.commits.nodes[0].commit.statusCheckRollup.contexts.nodes // [])[]
    | select(ctx_name as $n | any(required[]; . == $n))
    | select(ctx_red) ] | length > 0;
def is_dirty: (.mergeStateStatus == "DIRTY" or .mergeable == "CONFLICTING");
def reason:
  if is_red then "red"
  elif is_dirty then "dirty"
  else null end;
def line:
  .data.repository.pullRequests.nodes
  | map(select((.isDraft | not) and .baseRefName == "master" and .autoMergeRequest != null))
  | sort_by([(.autoMergeRequest.enabledAt // "9999-12-31T23:59:59Z"), .number])
  | map(. + {reason: reason});
def action_of:
  if . == null then "none"
  elif .mergeStateStatus == "BEHIND" then "update"
  elif .mergeStateStatus == "UNKNOWN" then "unknown"
  else "wait" end;
def result($mode; $n):
  line as $l
  | ($l | map(select(.reason == null))) as $ok
  | (if $mode == "pr"
     then (.data.repository.pullRequests.nodes
           | map(select(.baseRefName == "master" and .number == $n))[0])
     else $ok[0] end) as $h
  | (if $mode == "pr" and $h != null and ($h | is_dirty) then "none"
     else ($h | action_of) end) as $action
  | (if $mode == "pr"
     then (if $h != null and ($h | is_dirty) then [{number: $h.number, reason: "dirty"}] else [] end)
     else ($l | map(select(.reason != null) | {number, reason})) end) as $sk
  | { queue_len: ($l | length),
      head: ($h.number // null),
      head_state: ($h.mergeStateStatus // null),
      action: $action,
      skipped: $sk,
      clear: ($ok | map(.number)),
      list: ($l | map(.number)) };
'

# shellcheck disable=SC2016
FORMAT_JQ='
  "queue_len=\(.queue_len)",
  "head=\(.head // "")",
  "head_state=\(.head_state // "")",
  "action=\(.action)",
  "skipped=\(.skipped | map("\(.number):\(.reason)") | join(" "))",
  "clear=\(.clear | map(tostring) | join(" "))",
  "dry_run=\($dry)"
'

# shellcheck disable=SC2016
SUMMARY_JQ='
  "## Merge line (head-of-line)",
  (if $dry == "true" then "Dry run: no branch updated, no comment posted." else empty end),
  "- Queue length: \(.queue_len)",
  (if .head == null then "- Head: none"
   else "- Head: #\(.head) (state \(.head_state // "unknown"), action \(.action))" end),
  (.skipped[] | "- Skipped #\(.number): "
     + (if .reason == "red" then "required check failing on current head"
        else "merge conflict with master" end))
'

# shellcheck disable=SC2016  # GraphQL variables ($owner, $name) are not shell variables
LIVE_QUERY='
query($owner:String!, $name:String!) {
  repository(owner:$owner, name:$name) {
    pullRequests(states:OPEN, baseRefName:"master", first:100) {
      pageInfo { hasNextPage }
      nodes {
        number isDraft baseRefName headRefOid mergeable mergeStateStatus
        autoMergeRequest { enabledAt }
        commits(last:1) { nodes { commit { oid statusCheckRollup { state
          contexts(first:100) { nodes { __typename
            ... on CheckRun { name status conclusion }
            ... on StatusContext { context state } } } } } } }
      }
    }
  }
}'

if [ "$LIVE" = 1 ]; then
    OWNER="${REPO%/*}"
    NAME="${REPO#*/}"
    # $GH_CMD is intentionally unquoted so a test seam can carry arguments.
    # shellcheck disable=SC2086
    if ! SNAPSHOT=$($GH_CMD api graphql -f owner="$OWNER" -f name="$NAME" -f query="$LIVE_QUERY"); then
        echo "merge-line-select: GraphQL fetch failed" >&2
        exit 1
    fi
elif [ "$INPUT" = "-" ]; then
    SNAPSHOT=$(cat)
else
    if [ ! -r "$INPUT" ]; then
        echo "merge-line-select: cannot read input file: $INPUT" >&2
        exit 1
    fi
    SNAPSHOT=$(cat "$INPUT")
fi

# shellcheck disable=SC2016
if ! printf '%s' "$SNAPSHOT" | jq -e \
        '((.errors // null) == null) and (.data.repository.pullRequests.nodes | type == "array")' \
        >/dev/null 2>&1; then
    echo "merge-line-select: snapshot is not a pullRequests GraphQL response" >&2
    exit 1
fi

if [ "$(printf '%s' "$SNAPSHOT" | jq -r '.data.repository.pullRequests.pageInfo.hasNextPage // false')" = "true" ]; then
    echo "warning: more than 100 open PRs; line truncated" >&2
fi

if [ "$MODE" = "pr" ]; then
    # shellcheck disable=SC2016
    if ! printf '%s' "$SNAPSHOT" | jq -e --argjson n "$PR_NUM" \
            '.data.repository.pullRequests.nodes | any(.baseRefName == "master" and .number == $n)' \
            >/dev/null; then
        echo "merge-line-select: PR #$PR_NUM is not open against master" >&2
        exit 1
    fi
fi

# --pr and --list never see a null $n; pass 0 outside --pr mode.
JQ_N="${PR_NUM:-0}"
RESULT=$(printf '%s' "$SNAPSHOT" \
    | jq -c --arg mode "$MODE" --argjson n "$JQ_N" "$SELECT_JQ result(\$mode; \$n)")

if [ -n "$SUMMARY" ]; then
    printf '%s' "$RESULT" | jq -r --arg dry "$DRY_RUN" "$SUMMARY_JQ" >> "$SUMMARY"
fi

if [ "$MODE" = "list" ]; then
    printf '%s' "$RESULT" | jq -c '.list'
else
    printf '%s' "$RESULT" | jq -r --arg dry "$DRY_RUN" "$FORMAT_JQ"
fi
