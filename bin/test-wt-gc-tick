log_has 'closed reaped cl2' || note_err "not reaped"
git -C "$ENV_MAIN" cat-file -e refs/wt-gc-archive/1700000000/wt/cl2:new.txt 2>/dev/null || note_err "untracked file missing from archive"
finish_case
fi

if should_run CL3-under-floor-keeps; then
