<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ibl5.approve-click-tick</string>
	<key>ProgramArguments</key>
	<array>
		<string>@MAIN_WT@/bin/approve-click-tick</string>
		<string>--tick</string>
	</array>
	<key>StartInterval</key>
	<integer>180</integer>
	<key>AbandonProcessGroup</key>
	<true/>
	<key>WorkingDirectory</key>
	<string>@MAIN_WT@</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/opt/mariadb/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:@HOME@/.local/bin</string>
		<key>LANG</key>
		<string>en_US.UTF-8</string>
	</dict>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/approve-click-tick.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/approve-click-tick.log</string>
</dict>
</plist>
