# === Marker-parse and prose-pin cases (skill slice, 28–38) ===============================
_PRD="$SCRIPT_DIR/../.claude/review-shared"
_VM_PR=8801
TMP_LOGS+=("/tmp/pr-ready-marker-${_VM_PR}.txt"
