#!/usr/bin/env bash
# shellcheck disable=SC2317,SC2329
# bin/test-plan-review-seam — end-to-end acceptance test for the plan-review program.
# Landed skipped in discord-plan-review-1-digest; un-skipped by discord-plan-review-3-drain.
#
# Everything here runs against stubs: a stub `ssh` that replays canned curl output,
# a stub `bin/check-plan`, a stub `bin/automouse/queue`, and a stub `bin/discord-dm`.
# No bot, no tunnel, no network, no credentials — safe for CI.

# ===== BEGIN RESOLVED BOT CONTRACT (Phase 1) =====
#   REVIEW_DM_ROUTE:      /discordPlanReviewDM
#   DECISIONS_GET_ROUTE:  /planDecisions
#   ACK_ROUTE:            /planDecisions/ack
#   ACK_VERB:             POST
#   LOOPBACK_BIND:        127.0.0.1:config.express.port
#   REVIEW_DM_BODY:       { slug, digest }
#   DECISIONS_RESPONSE:   object wrapping array; fields: decisions[].id, decisions[].slug, decisions[].action, decisions[].actor, decisions[].ts
#   ACK_BODY:             { ids: string[], outcomes?: { [id: string]: "queued"|"discarded"|"refused"|"rejected" } }  (handleAckDecisions)
#   PLAN_SLUG_RE:         PLAN_SLUG_RE = /^[a-z0-9][a-z0-9-]{0,79}$/
# ===== END RESOLVED BOT CONTRACT (Phase 1) =====

[ "${BASH_VERSINFO[0]:-0}" -ge 4 ] || { printf '%s: bash 4+ required (this is bash %s). Run: brew install bash\n' "${0##*/}" "${BASH_VERSION:-?}" >&2; exit 2; }
set -u
# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

HERE="$(cd "$(dirname "$0")" && pwd)"

# ── CONTRACT-DRIFT CHECK ──────────────────────────────────────────────────────
# Verifies that every route string, response field name, and PLAN_SLUG_RE export
# the drain depends on still exists in the serving sources. Runs off the
# checked-in TypeScript — no bot, no tunnel, no credentials needed (CI-safe).
seam_case_contract_drift() {
    local express_file dm_file express_src dm_src missing token
    express_file="$HERE/../ibl5/IBLbot/src/server/express.ts"
    dm_file="$HERE/../ibl5/IBLbot/src/server/plan-review-dm.ts"
    missing=0

    if [ ! -f "$express_file" ]; then
        seam_fail "contract-drift: express.ts not found at $express_file"
        return
    fi
    if [ ! -f "$dm_file" ]; then
        seam_fail "contract-drift: plan-review-dm.ts not found at $dm_file"
        return
    fi

    express_src="$(cat "$express_file")"
    dm_src="$(cat "$dm_file")"

    # Route strings — must exist in express.ts.  Use the TS-quoted form so that
    # checking '/planDecisions' does not false-match inside '/planDecisions/ack'.
    for token in "'/discordPlanReviewDM'" "'/planDecisions'" "'/planDecisions/ack'"; do
        if ! grep -qF -- "$token" <<< "$express_src"; then
            seam_fail "contract-drift: route $token absent from express.ts"
            missing=$(( missing + 1 ))
        fi
    done

    # Approve-button routes (discord-approve-buttons) — same TS-quoted form.
    for token in "'/discordApproveDM'" "'/approveClicks'" "'/approveClicks/claim'"; do
        if ! grep -qF -- "$token" <<< "$express_src"; then
            seam_fail "contract-drift: route $token absent from express.ts"
            missing=$(( missing + 1 ))
        fi
    done

    # Owner-id drift: the Mac poller and bin/discord-dm must name the same owner.
    if ! grep -qF 'OWNER_DISCORD_ID="283183467804491776"' "$HERE/approve-click-tick"; then
        seam_fail "contract-drift: OWNER_DISCORD_ID in bin/approve-click-tick no longer matches the pinned owner id"
        missing=$(( missing + 1 ))
    fi
    if ! grep -qF 'OWNER_ID="283183467804491776"' "$HERE/discord-dm"; then
        seam_fail "contract-drift: OWNER_ID in bin/discord-dm no longer matches the pinned owner id"
        missing=$(( missing + 1 ))
    fi

    # Response field names the drain consumes + ack body field — must exist in plan-review-dm.ts
    for token in 'decisions' 'slug' 'action' 'ids' 'outcomes' 'PLAN_SLUG_RE'; do
        if ! grep -qF -- "$token" <<< "$dm_src"; then
            seam_fail "contract-drift: token '$token' absent from plan-review-dm.ts"
            missing=$(( missing + 1 ))
        fi
    done

    if [ "$missing" -eq 0 ]; then
        seam_ok "contract-drift: all route strings, field names, and PLAN_SLUG_RE verified"
    fi
}
# ── END CONTRACT-DRIFT CHECK ──────────────────────────────────────────────────

h_tmp SANDBOX
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/usage-test-isolation.sh"; usage_test_isolate "$SANDBOX/usage"

seam_ok() { h_pass "$1"; }
seam_fail() { h_fail "$1"; }

# Assert $2 contains $3; label with $1.
want() {
    if grep -qF -- "$3" <<< "$2"; then
        seam_ok "$1"
    else
        seam_fail "$1 (missing: $3)"
    fi
}

# Assert $2 does NOT contain $3.
want_not() {
    if grep -qF -- "$3" <<< "$2"; then
        seam_fail "$1 (unexpectedly present: $3)"
    else
        seam_ok "$1"
    fi
}

# ── drain test scaffolding ───────────────────────────────────────────────────
DRAIN="$HERE/plan-review-drain"
STUBS="$SANDBOX/stubs"
REPO_STUB="$SANDBOX/repo"
PLANS="$SANDBOX/plans"
STATE="$SANDBOX/attempts.tsv"

export SSH_CALLS="$SANDBOX/ssh-calls.log"
export QUEUE_CALLS="$SANDBOX/queue-calls.log"
export CHECKPLAN_CALLS="$SANDBOX/checkplan-calls.log"
export DM_CALLS="$SANDBOX/dm-calls.log"
export RESP_GET="$SANDBOX/resp-get.txt"
export RESP_ACK="$SANDBOX/resp-ack.txt"

mkdir -p "$STUBS" "$REPO_STUB/bin/automouse" "$PLANS"

# Stub ssh. The drain invokes it as
#   ssh -o BatchMode=yes -o ConnectTimeout=10 HOST '<curl one-liner>'
# so the remote command is the LAST argument. Replays a canned response file
# chosen by the route inside that command; an unknown route yields a 404, which is
# what a bot not serving the drain routes really returns.
cat > "$STUBS/ssh" <<'SSHSTUB'
#!/usr/bin/env bash
cmd=""
for a in "$@"; do cmd="$a"; done
body="$(cat)"
{
    printf 'CALL %s\n' "$cmd"
    printf 'BODY %s\n' "$body"
} >> "$SSH_CALLS"
case "$cmd" in
    *planDecisions/ack*) rf="$RESP_ACK" ;;
    *planDecisions*)     rf="$RESP_GET" ;;
    *)                   rf="" ;;
esac
if [ -n "$rf" ] && [ -f "$rf" ]; then
    cat "$rf"
else
    printf '\nHTTP=404 curl_rc=0\n'
fi
SSHSTUB

cat > "$REPO_STUB/bin/check-plan" <<'CPSTUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "${CHECKPLAN_CALLS:-/dev/null}"
plan=
for a in "$@"; do plan=$a; done
if grep -qF 'CHECKPLAN-FAILS' "$plan" 2>/dev/null; then
    printf 'check-plan: FAILED — fixture is marked CHECKPLAN-FAILS\n'
    exit 1
fi
if [ "${1:-}" = --require-must-preserve ] && grep -qF 'LACKS-MUST-PRESERVE' "$plan" 2>/dev/null; then
    printf '[MP] missing ## Must preserve section (stub)\n'
    exit 1
fi
exit 0
CPSTUB

cat > "$REPO_STUB/bin/automouse/queue" <<'QSTUB'
#!/usr/bin/env bash
printf '%s\n' "$1" >> "$QUEUE_CALLS"
case "$1" in *queuefail*) exit 1 ;; esac
exit 0
QSTUB

cat > "$REPO_STUB/bin/discord-dm" <<'DMSTUB'
#!/usr/bin/env bash
{ printf 'DM '; cat; printf '\n--\n'; } >> "$DM_CALLS"
DMSTUB

chmod +x "$STUBS/ssh" "$REPO_STUB/bin/check-plan" "$REPO_STUB/bin/automouse/queue" "$REPO_STUB/bin/discord-dm"

# Canned curl output: body, then the `-w` status line, then curl's own rc — the
# exact three-part shape bin/plan-review-drain's remote() parses back out.
set_get() { printf '%s\nHTTP=%s curl_rc=%s\n' "$1" "${2:-200}" "${3:-0}" > "$RESP_GET"; }
set_ack() { printf '%s\nHTTP=%s curl_rc=%s\n' "$1" "${2:-200}" "${3:-0}" > "$RESP_ACK"; }

DRAIN_OUT=""
DRAIN_RC=0
run_drain() {
    : > "$SSH_CALLS"
    : > "$QUEUE_CALLS"
    : > "$CHECKPLAN_CALLS"
    : > "$DM_CALLS"
    DRAIN_OUT="$(
        PLAN_REVIEW_SSH_BIN="$STUBS/ssh" \
        PLAN_REVIEW_SSH_HOST=stub-host \
        PLAN_REVIEW_PORT=50000 \
        PLAN_REVIEW_REPO="$REPO_STUB" \
        PLAN_REVIEW_DISCORD_DM="$REPO_STUB/bin/discord-dm" \
        PLAN_REVIEW_STATE="$STATE" \
        PLANS_DIR="$PLANS" \
        NIGHTLY_DIR="$SANDBOX/nightly" \
        "$DRAIN" "$@" 2>&1
    )"
    DRAIN_RC=$?
}

reset_drain_state() {
    rm -f "$STATE"
    rm -rf "$PLANS"
    mkdir -p "$PLANS"
    printf '# ok plan\n' > "$PLANS/valid-plan.md"
    set_get '{"decisions":[]}'
    set_ack '{"acked":0}'
}

ack_body()   { grep '^BODY ' "$SSH_CALLS" | tail -1; }
ack_called() { grep -q 'planDecisions/ack' "$SSH_CALLS"; }

# ── Phase 3 — transport, flags, decision loop ────────────────────────────────
seam_case_flags() {
    reset_drain_state

    run_drain
    [ "$DRAIN_RC" -ne 0 ] \
        && seam_ok "flags: a bare invocation is not a pass (exit $DRAIN_RC)" \
        || seam_fail "flags: a bare invocation must not default to a destructive pass"
    want "flags: bare invocation says which flag to pass" "$DRAIN_OUT" "--drain"

    run_drain --drain=1
    [ "$DRAIN_RC" = 2 ] \
        && seam_ok "flags: --flag=value is rejected (exit 2)" \
        || seam_fail "flags: --flag=value must be rejected (got $DRAIN_RC)"
    want "flags: the rejection names the space form" "$DRAIN_OUT" "space form"

    run_drain --bogus
    [ "$DRAIN_RC" = 2 ] \
        && seam_ok "flags: an unrecognised token is fatal (exit 2)" \
        || seam_fail "flags: an unrecognised token must be fatal (got $DRAIN_RC)"

    run_drain --drain
    [ "$DRAIN_RC" = 0 ] \
        && seam_ok "flags: --drain parses and exits 0 on an empty sink" \
        || seam_fail "flags: --drain should exit 0 on an empty sink (got $DRAIN_RC)"
}

seam_case_empty_list() {
    reset_drain_state
    set_get '{"decisions":[]}'
    run_drain --drain
    want "empty sink: logged as a clean no-op" "$DRAIN_OUT" "no pending decisions"
    if ack_called; then
        seam_fail "empty sink: must not POST an ack"
    else
        seam_ok "empty sink: no ack POST"
    fi
    if [ -s "$DM_CALLS" ]; then
        seam_fail "empty sink: must send no DM (a nightly 'nothing to do' trains the signal away)"
    else
        seam_ok "empty sink: no DM"
    fi
}

seam_case_same_slug_dedupe() {
    reset_drain_state
    set_get '{"decisions":[{"id":"d1","slug":"valid-plan","action":"queue","actor":"u","ts":"t"},{"id":"d2","slug":"valid-plan","action":"discard","actor":"u","ts":"t"}]}'
    run_drain --drain
    want "same-slug dedupe: the second record is skipped, first wins" "$DRAIN_OUT" "duplicate decision for slug 'valid-plan'"
    if [ "$(grep -c . "$QUEUE_CALLS")" = 1 ]; then
        seam_ok "same-slug dedupe: exactly one apply ran"
    else
        seam_fail "same-slug dedupe: expected 1 queue call, got $(grep -c . "$QUEUE_CALLS")"
    fi
    local body; body="$(ack_body)"
    want "same-slug dedupe: the winner is acked" "$body" '"d1"'
    want "same-slug dedupe: the skipped duplicate is acked too" "$body" '"d2"'
    if [ -f "$PLANS/valid-plan.md" ]; then
        seam_ok "same-slug dedupe: the contradictory discard never moved the plan"
    else
        seam_fail "same-slug dedupe: the second (discard) decision was applied — both decisions ran"
    fi
}

seam_case_dry_run() {
    reset_drain_state
    set_get '{"decisions":[{"id":"d1","slug":"valid-plan","action":"queue","actor":"u","ts":"t"}]}'
    run_drain --dry-run
    [ "$DRAIN_RC" = 0 ] \
        && seam_ok "--dry-run: exit 0" \
        || seam_fail "--dry-run: expected exit 0, got $DRAIN_RC"
    want "--dry-run: reports what it would do" "$DRAIN_OUT" "would queue: valid-plan"
    if [ -s "$QUEUE_CALLS" ]; then
        seam_fail "--dry-run: must not invoke bin/automouse/queue"
    else
        seam_ok "--dry-run: no queue invocation"
    fi
    if ack_called; then
        seam_fail "--dry-run: must not ack"
    else
        seam_ok "--dry-run: no ack POST"
    fi
    if [ -f "$PLANS/valid-plan.md" ]; then
        seam_ok "--dry-run: no file moved"
    else
        seam_fail "--dry-run: the plan file moved"
    fi
}

# ── Phase 4 — the slug trust boundary ────────────────────────────────────────
# Every rejection is asserted on BOTH halves: dropped loudly AND still acked.
# Without the ack one hostile record wedges every future pass forever.
reject_case() { # label json-slug expected-rule
    local label="$1" jslug="$2" rule="$3" body
    reset_drain_state
    set_get "{\"decisions\":[{\"id\":\"bad1\",\"slug\":$jslug,\"action\":\"queue\",\"actor\":\"u\",\"ts\":\"t\"}]}"
    run_drain --drain
    want "$label: dropped loudly" "$DRAIN_OUT" "REJECTED"
    want "$label: names the rule that rejected it" "$DRAIN_OUT" "$rule"
    body="$(ack_body)"
    want "$label: still acked" "$body" '"bad1"'
    if [ -s "$QUEUE_CALLS" ]; then
        seam_fail "$label: bin/automouse/queue was invoked with a rejected slug"
    else
        seam_ok "$label: no command line was ever built from the rejected slug"
    fi
}

seam_case_trust_boundary() {
    reject_case "traversal slug"      '"../evil"'      "contains '/'"
    reject_case "dot-dot slug"        '"..evil"'       "contains '..'"
    reject_case "absolute-path slug"  '"/etc/passwd"'  "contains '/'"
    reject_case "leading-dash slug"   '"-rf"'          "begins with '-'"
    reject_case "leading-dot slug"    '".hidden"'      "begins with '.'"
    reject_case "empty slug"          '""'             "empty slug"

    # A slug naming no plan file: shape is fine, existence is not.
    reset_drain_state
    set_get '{"decisions":[{"id":"nf1","slug":"no-such-plan","action":"queue","actor":"u","ts":"t"}]}'
    run_drain --drain
    want "missing plan file: dropped loudly" "$DRAIN_OUT" "no regular plan file"
    want "missing plan file: still acked" "$(ack_body)" '"nf1"'

    # An unknown verb is unactionable in exactly the same way.
    reset_drain_state
    set_get '{"decisions":[{"id":"uv1","slug":"valid-plan","action":"detonate","actor":"u","ts":"t"}]}'
    run_drain --drain
    want "unknown verb: dropped loudly" "$DRAIN_OUT" "unknown action verb 'detonate'"
    want "unknown verb: still acked" "$(ack_body)" '"uv1"'
    if [ -s "$QUEUE_CALLS" ]; then
        seam_fail "unknown verb: something was applied"
    else
        seam_ok "unknown verb: nothing applied"
    fi

    # A newline inside a slug must never forge a log line. jq's @tsv escapes the
    # newline, so the hostile text survives only as part of the single REJECTED
    # line — never as a standalone line that reads like the drain's own output.
    # The assertion is therefore line-ANCHORED: "does the payload appear at the
    # start of a line of its own", not "does the text appear anywhere".
    reset_drain_state
    set_get '{"decisions":[{"id":"nl1","slug":"a\nplan-review-drain: queued '"'"'pwned'"'"'","action":"queue","actor":"u","ts":"t"}]}'
    run_drain --drain
    if grep -q "^plan-review-drain: queued 'pwned'" <<< "$DRAIN_OUT"; then
        seam_fail "newline slug: a forged log line was emitted"
    else
        seam_ok "newline slug: no forged log line (the newline never reaches the log unescaped)"
    fi
    want "newline slug: dropped loudly" "$DRAIN_OUT" "REJECTED"
    want "newline slug: still acked" "$(ack_body)" '"nl1"'

    # POSITIVE CONTROL — the guard rejects attacks, not real slugs.
    reset_drain_state
    printf '# ok\n' > "$PLANS/a-real-hyphenated-slug.md"
    set_get '{"decisions":[{"id":"ok1","slug":"a-real-hyphenated-slug","action":"queue","actor":"u","ts":"t"}]}'
    run_drain --drain
    want "valid hyphenated slug: queued" "$(cat "$QUEUE_CALLS")" "a-real-hyphenated-slug"
    want "valid hyphenated slug: acked" "$(ack_body)" '"ok1"'
    want_not "valid hyphenated slug: not rejected" "$DRAIN_OUT" "REJECTED"
}

# ── Phase 5 — applying a decision ────────────────────────────────────────────
seam_case_checkplan_gates_the_queue() {
    reset_drain_state
    printf '# bad plan\nCHECKPLAN-FAILS\n' > "$PLANS/bad-plan.md"
    set_get '{"decisions":[{"id":"cp1","slug":"bad-plan","action":"queue","actor":"u","ts":"t"}]}'
    run_drain --drain
    if [ -s "$QUEUE_CALLS" ]; then
        seam_fail "ADR-0096: a check-plan FAILED plan reached bin/automouse/queue"
    else
        seam_ok "ADR-0096: check-plan runs FIRST and a FAILED plan never reaches the queue"
    fi
    want "ADR-0096: the refusal is logged" "$DRAIN_OUT" "check-plan FAILED for 'bad-plan'"
    want "ADR-0096: the record is acked (unactionable)" "$(ack_body)" '"cp1"'
    want "ADR-0096: the DM names the slug" "$(cat "$DM_CALLS")" "bad-plan"
    want "ADR-0096: the DM carries the check-plan verdict" "$(cat "$DM_CALLS")" "check-plan: FAILED"
}

seam_case_checkplan_requires_must_preserve() {
    reset_drain_state
    printf '# legacy plan\nLACKS-MUST-PRESERVE\n' > "$PLANS/legacy-plan.md"
    set_get '{"decisions":[{"id":"mp1","slug":"legacy-plan","action":"queue","actor":"u","ts":"t"}]}'
    run_drain --drain
    if [ -s "$QUEUE_CALLS" ]; then
        seam_fail "backlog#1531: a plan lacking Must preserve reached bin/automouse/queue"
    else
        seam_ok "backlog#1531: a plan lacking Must preserve never reaches the queue"
    fi
    want "backlog#1531: drain passes the flag to check-plan" "$(cat "$CHECKPLAN_CALLS")" "require-must-preserve"
    want "backlog#1531: the record is acked, not left pending" "$(ack_body)" '"mp1"'
    want "backlog#1531: the DM carries the [MP] verdict" "$(cat "$DM_CALLS")" "[MP] missing"
}

seam_case_discard_moves() {
    reset_drain_state
    printf '# doomed\n' > "$PLANS/doomed-plan.md"
    set_get '{"decisions":[{"id":"dc1","slug":"doomed-plan","action":"discard","actor":"u","ts":"t"}]}'
    run_drain --drain
    if [ -d "$PLANS/discarded" ]; then
        seam_ok "discard: the discarded/ directory is created on demand"
    else
        seam_fail "discard: discarded/ was not created"
    fi
    if [ -f "$PLANS/discarded/doomed-plan.md" ] && [ ! -e "$PLANS/doomed-plan.md" ]; then
        seam_ok "discard: the plan is MOVED, not deleted"
    else
        seam_fail "discard: the plan was not moved into discarded/"
    fi
    want "discard: acked" "$(ack_body)" '"dc1"'

    # `mv -n` never clobbers: a name collision is a loud FAILED apply, not a
    # silent overwrite of a previously discarded plan.
    reset_drain_state
    mkdir -p "$PLANS/discarded"
    printf '# the FIRST discarded one\n' > "$PLANS/discarded/collide.md"
    printf '# the second one\n' > "$PLANS/collide.md"
    set_get '{"decisions":[{"id":"cl1","slug":"collide","action":"discard","actor":"u","ts":"t"}]}'
    run_drain --drain
    want "discard: a name collision is loud" "$DRAIN_OUT" "refusing to clobber"
    if grep -qF 'the FIRST discarded one' "$PLANS/discarded/collide.md"; then
        seam_ok "discard: the previously discarded plan was not clobbered"
    else
        seam_fail "discard: mv clobbered an existing discarded plan"
    fi
    if [ -f "$PLANS/collide.md" ]; then
        seam_ok "discard: a failed apply leaves the source plan in place"
    else
        seam_fail "discard: the source plan vanished on a failed apply"
    fi
    if ack_called; then
        seam_fail "discard: a failed apply must not be acked on the first pass"
    else
        seam_ok "discard: a failed apply is not acked (it rides the bounded ladder)"
    fi
    want "discard: the failed apply burns exactly one attempt" "$(cat "$STATE" 2>/dev/null)" "cl1"
}

seam_case_quiet_404() {
    reset_drain_state
    rm -f "$RESP_GET"          # unknown route ⇒ the stub answers 404
    run_drain --drain
    [ "$DRAIN_RC" = 0 ] \
        && seam_ok "404 on a drain route: exit 0" \
        || seam_fail "404 on a drain route: expected exit 0, got $DRAIN_RC"
    want "404 on a drain route: the reason is written to the log every time" "$DRAIN_OUT" "not serving the drain routes"
    if [ -s "$DM_CALLS" ]; then
        seam_fail "404 on a drain route: must be silent to Discord"
    else
        seam_ok "404 on a drain route: silent to Discord, loud to the log"
    fi
    if [ -f "$STATE" ]; then
        seam_fail "404 on a drain route: an attempt was consumed"
    else
        seam_ok "404 on a drain route: no attempt consumed"
    fi
}

seam_case_failure_buckets() {
    # 5xx / rc 7 / rc 28 are environmental: REFUND, never burn.
    local code
    for code in "500 0" "000 7" "000 28"; do
        set -- $code
        reset_drain_state
        set_get '{"decisions":[{"id":"rf1","slug":"no-such-plan","action":"queue","actor":"u","ts":"t"}]}'
        set_ack '' "$1" "$2"
        run_drain --drain
        want "ack http=$1 curl_rc=$2: refunded, not burned" "$DRAIN_OUT" "REFUNDED"
        if [ -f "$STATE" ] && grep -q 'rf1' "$STATE"; then
            seam_fail "ack http=$1 curl_rc=$2: an environmental failure burned an attempt"
        else
            seam_ok "ack http=$1 curl_rc=$2: no attempt consumed"
        fi
    done

    # 400 and 403: the bot parsed us and refused. Burn exactly one.
    for code in 400 403; do
        reset_drain_state
        set_get '{"decisions":[{"id":"bn1","slug":"no-such-plan","action":"queue","actor":"u","ts":"t"}]}'
        set_ack '{"error":"nope"}' "$code" 0
        run_drain --drain
        want "ack http=$code: the refusal is loud" "$DRAIN_OUT" "refused"
        if grep -q "^bn1	1$" "$STATE" 2>/dev/null; then
            seam_ok "ack http=$code: burns exactly one attempt"
        else
            seam_fail "ack http=$code: expected the ledger to read 'bn1<TAB>1', got: $(cat "$STATE" 2>/dev/null)"
        fi
    done
}

seam_case_force_ack_dm_is_actionable() {
    # Pre-seed the ledger at MAX_ATTEMPTS-1 so the next failed apply fires the
    # ladder. A real user decision is being dropped here, so the DM must be
    # ACTIONABLE — not merely loud.
    reset_drain_state
    mkdir -p "$PLANS/discarded"
    printf '# first\n' > "$PLANS/discarded/give-up.md"
    printf '# second\n' > "$PLANS/give-up.md"
    printf 'fa1\t2\n' > "$STATE"
    set_get '{"decisions":[{"id":"fa1","slug":"give-up","action":"discard","actor":"u","ts":"t"}]}'
    run_drain --drain

    local dm; dm="$(cat "$DM_CALLS")"
    want "force-ack DM: names the slug"            "$dm" "give-up"
    want "force-ack DM: names the action chosen"   "$dm" "you pressed: discard"
    want "force-ack DM: gives the manual command"  "$dm" "mv $PLANS/give-up.md $PLANS/discarded/"
    want "force-ack: the ledger records FORCED"    "$(cat "$STATE")" "FORCED"

    # A FORCED record is never retried and never re-DM'd.
    run_drain --drain
    want "force-ack: a FORCED record is skipped on later passes" "$DRAIN_OUT" "already force-acked"
    if [ -s "$DM_CALLS" ]; then
        seam_fail "force-ack: a FORCED record re-sent the give-up DM"
    else
        seam_ok "force-ack: no repeat DM for a FORCED record"
    fi
}

# ── Phase 6 — the bin/automouse/run hook ─────────────────────────────────────
# Static assertions against the runner source: running the real runner would fire
# a whole automouse night.
seam_case_runner_hook() {
    local runner src drain_ln loop_ln
    runner="$HERE/automouse/run"
    if [ ! -f "$runner" ]; then
        seam_fail "runner hook: bin/automouse/run not found"
        return
    fi
    src="$(cat "$runner")"

    want "runner hook: the drain is invoked" "$src" 'bin/plan-review-drain" --drain'
    want "runner hook: failure is non-fatal under set -euo pipefail" "$src" '--drain >> "$LOG" 2>&1 || true'
    want "runner hook: output is redirected to \$LOG (the quiet-404 tripwire)" "$src" '>> "$LOG" 2>&1'
    want "runner hook: skipped in single-plan mode" "$src" 'if [ -z "${SINGLE_PLAN:-}" ]; then'

    drain_ln="$(grep -n 'bin/plan-review-drain' "$runner" | head -1 | cut -d: -f1)"
    loop_ln="$(grep -n '^while true; do' "$runner" | head -1 | cut -d: -f1)"
    if [ -n "$drain_ln" ] && [ -n "$loop_ln" ] && [ "$drain_ln" -lt "$loop_ln" ]; then
        seam_ok "runner hook: the drain runs BEFORE the queue loop (line $drain_ln < $loop_ln)"
    else
        seam_fail "runner hook: the drain must precede the queue loop (drain=$drain_ln loop=$loop_ln)"
    fi
}

# ── Phase 6b — the bin/bug-pipeline-tick hook ────────────────────────────────
# The 180s poller is the SECOND drain caller: bin/automouse/run alone leaves a
# Discord button press unapplied until its 03:00 calendar tick. Static assertions
# for the same reason as Phase 6 — running the real tick drives a live pipeline.
seam_case_tick_hook() {
    local tick src drain_ln preflight_ln
    tick="$HERE/bug-pipeline-tick"
    if [ ! -f "$tick" ]; then
        seam_fail "tick hook: bin/bug-pipeline-tick not found"
        return
    fi
    src="$(cat "$tick")"

    want "tick hook: the drain is invoked" "$src" 'plan-review-drain}" --drain'
    want "tick hook: failure is non-fatal" "$src" '--drain 2>&1 || true'
    want "tick hook: kill switch present" "$src" 'BUG_PIPELINE_PLAN_REVIEW_DRAIN_ENABLED:-1'

    # The drain needs no $CLAUDE_BIN, so a missing agent binary (which makes the
    # preflight `return 1`) must not also silence Discord plan review.
    # Anchor on the invocation (not the prose comment) so a move below preflight fails.
    drain_ln="$(grep -n 'plan-review-drain}" --drain' "$tick" | head -1 | cut -d: -f1)"
    preflight_ln="$(grep -n 'not found on PATH' "$tick" | head -1 | cut -d: -f1)"
    if [ -n "$drain_ln" ] && [ -n "$preflight_ln" ] && [ "$drain_ln" -lt "$preflight_ln" ]; then
        seam_ok "tick hook: the drain runs BEFORE the \$CLAUDE_BIN preflight (line $drain_ln < $preflight_ln)"
    else
        seam_fail "tick hook: the drain must precede the \$CLAUDE_BIN preflight (drain=$drain_ln preflight=$preflight_ln)"
    fi
}

# ── Phase 8 — end-to-end + idempotence ───────────────────────────────────────
seam_case_queue_end_to_end() {
    reset_drain_state
    printf '# good\n' > "$PLANS/end-to-end.md"
    set_get '{"decisions":[{"id":"e2e","slug":"end-to-end","action":"queue","actor":"u","ts":"t"}]}'
    run_drain --drain
    [ "$DRAIN_RC" = 0 ] \
        && seam_ok "queue end-to-end: exit 0" \
        || seam_fail "queue end-to-end: expected exit 0, got $DRAIN_RC"
    want "queue end-to-end: bin/automouse/queue got the slug" "$(cat "$QUEUE_CALLS")" "end-to-end"
    want "queue end-to-end: logged" "$DRAIN_OUT" "queued 'end-to-end'"
    want "queue end-to-end: acked" "$(ack_body)" '"e2e"'
    if grep -q 'end-to-end' "$STATE" 2>/dev/null; then
        seam_fail "queue end-to-end: a successful record left a ledger entry behind"
    else
        seam_ok "queue end-to-end: the ledger is cleared on success"
    fi

    # A second drain over already-acked decisions is a no-op: the sink no longer
    # lists them, so nothing is applied and nothing is acked.
    set_get '{"decisions":[]}'
    run_drain --drain
    [ "$DRAIN_RC" = 0 ] \
        && seam_ok "second drain: exit 0" \
        || seam_fail "second drain: expected exit 0, got $DRAIN_RC"
    if [ -s "$QUEUE_CALLS" ]; then
        seam_fail "second drain: re-applied an already-acked decision"
    else
        seam_ok "second drain over acked decisions is a no-op"
    fi
    if ack_called; then
        seam_fail "second drain: acked again"
    else
        seam_ok "second drain: no ack POST"
    fi
}

seam_case_ack_outcomes() {
    # Test queue success → "queued" in outcomes
    reset_drain_state
    printf '# ok\n' > "$PLANS/ack-queue.md"
    set_get '{"decisions":[{"id":"ao1","slug":"ack-queue","action":"queue","actor":"u","ts":"t"}]}'
    run_drain --drain
    local body; body="$(ack_body)"
    want "ack outcomes: queue success → \"queued\" in outcomes" "$body" '"ao1":"queued"'

    # Test discard success → "discarded" in outcomes
    reset_drain_state
    printf '# ok\n' > "$PLANS/ack-discard.md"
    set_get '{"decisions":[{"id":"ao2","slug":"ack-discard","action":"discard","actor":"u","ts":"t"}]}'
    run_drain --drain
    body="$(ack_body)"
    want "ack outcomes: discard success → \"discarded\" in outcomes" "$body" '"ao2":"discarded"'

    # Test check-plan failure → "refused" in outcomes (refusal DM still goes out)
    reset_drain_state
    printf '# bad\nCHECKPLAN-FAILS\n' > "$PLANS/ack-refuse.md"
    set_get '{"decisions":[{"id":"ao3","slug":"ack-refuse","action":"queue","actor":"u","ts":"t"}]}'
    run_drain --drain
    body="$(ack_body)"
    want "ack outcomes: check-plan failure → \"refused\" in outcomes" "$body" '"ao3":"refused"'
    want "ack outcomes: refusal DM still sent" "$(cat "$DM_CALLS")" "ack-refuse"

    # Test shape violation → "rejected" in outcomes
    reset_drain_state
    set_get '{"decisions":[{"id":"ao4","slug":"../evil","action":"queue","actor":"u","ts":"t"}]}'
    run_drain --drain
    body="$(ack_body)"
    want "ack outcomes: shape violation → \"rejected\" in outcomes" "$body" '"ao4":"rejected"'

    # Test payload parses as valid JSON with both ids and outcomes keys
    reset_drain_state
    printf '# ok\n' > "$PLANS/ack-json.md"
    set_get '{"decisions":[{"id":"ao5","slug":"ack-json","action":"queue","actor":"u","ts":"t"}]}'
    run_drain --drain
    body="$(ack_body)"
    # Strip the "BODY " prefix and parse the JSON
    local json_body; json_body="${body#BODY }"
    if jq -e '.ids and (.outcomes | type == "object")' <<< "$json_body" > /dev/null 2>&1; then
        seam_ok "ack outcomes: payload has both ids and outcomes keys as valid JSON"
    else
        seam_fail "ack outcomes: payload missing ids or outcomes key (got: $json_body)"
    fi

    # Test FORCED-earlier-skip: burn a record via set_ack '' 400 first pass, then on second pass assert "rejected"
    reset_drain_state
    printf '# ok\n' > "$PLANS/ack-forced.md"
    set_get '{"decisions":[{"id":"ao6","slug":"ack-forced","action":"queue","actor":"u","ts":"t"}]}'
    # Passes 1..MAX_ATTEMPTS: the ack POST returns 400 (bot refuses), each burns
    # one attempt; the third drives the real ladder to FORCED.
    set_ack '{"error":"nope"}' 400 0
    run_drain --drain
    want "ack outcomes: ladder pass 1 burns one attempt" "$(cat "$STATE" 2>/dev/null)" "ao6	1"
    run_drain --drain
    want "ack outcomes: ladder pass 2 burns a second attempt" "$(cat "$STATE" 2>/dev/null)" "ao6	2"
    run_drain --drain
    want "ack outcomes: ladder pass 3 reaches FORCED" "$(cat "$STATE" 2>/dev/null)" "ao6	FORCED"
    # Second pass: the record is still listed (bot still has it), drain sees FORCED → marks rejected
    set_ack '{"acked":1}' 200 0
    run_drain --drain
    body="$(ack_body)"
    want "ack outcomes: FORCED-earlier-skip → \"rejected\" in outcomes on second pass" "$body" '"ao6":"rejected"'
}

# ── approve-click — bin/approve-click-tick against stub ssh, gh, owner-approve and discord-dm ──
AP_TICK="$HERE/approve-click-tick"
AP_NONCE="0123456789abcdef0123456789abcdef"
AP_SHA="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
AP_SHA2="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
AP_OWNER_JSON='"283183467804491776"'
AP_BIN="$SANDBOX/approve-bin"
AP_LOGS="$SANDBOX/approve-logs"
AP_STATE="$SANDBOX/approve-state"
AP_OUT=""
AP_RC=0

ap_setup() {
    mkdir -p "$AP_BIN" "$AP_LOGS"
    cat > "$AP_BIN/fake-ssh" <<'APSSH'
#!/usr/bin/env bash
cmd=""
for a in "$@"; do cmd="$a"; done
printf 'CALL %s\n' "$cmd" >> "$AP_LOGS/ssh.log"
case "$cmd" in
    *approveClicks/claim*) cat > /dev/null; printf '%s\nHTTP=%s curl_rc=0\n' "$FAKE_CLAIM_BODY" "${FAKE_CLAIM_HTTP:-200}" ;;
    *approveClicks*)       printf '%s\nHTTP=200 curl_rc=0\n' "$FAKE_LIST_BODY" ;;
    *)                     printf '\nHTTP=404 curl_rc=0\n' ;;
esac
APSSH
    cat > "$AP_BIN/fake-gh" <<'APGH'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$AP_LOGS/gh.log"
printf '%s\n' "$FAKE_GH_JSON"
APGH
    cat > "$AP_BIN/fake-oa" <<'APOA'
#!/usr/bin/env bash
printf '%s\n' "$#" > "$AP_LOGS/oa.argc"
printf '[%s]\n' "$@" >> "$AP_LOGS/oa.log"
echo "RESULT: ${FAKE_OA_RESULT:-armed}"
exit "${FAKE_OA_RC:-0}"
APOA
    cat > "$AP_BIN/fake-dm" <<'APDM'
#!/usr/bin/env bash
printf '[%s]\n' "$@" >> "$AP_LOGS/dm.log"
APDM
    # The real gadget calls GitHub, so every case gets a failing stub unless it names its own.
    cat > "$AP_BIN/fake-gadget" <<'APGD'
#!/usr/bin/env bash
exit 1
APGD
    chmod +x "$AP_BIN/fake-ssh" "$AP_BIN/fake-gh" "$AP_BIN/fake-oa" "$AP_BIN/fake-dm" "$AP_BIN/fake-gadget"
    export APPROVE_CLICK_GADGET_BIN="$AP_BIN/fake-gadget"
    export AP_LOGS FAKE_LIST_BODY FAKE_CLAIM_BODY FAKE_CLAIM_HTTP FAKE_GH_JSON FAKE_OA_RC FAKE_OA_RESULT SENTINEL
    export APPROVE_CLICK_SSH_BIN="$AP_BIN/fake-ssh"
    export APPROVE_CLICK_SSH_HOST=stub-host
    export APPROVE_CLICK_PORT=50000
    export APPROVE_CLICK_STATE_DIR="$AP_STATE"
    export APPROVE_OA_BIN="$AP_BIN/fake-oa"
    export APPROVE_DM_BIN="$AP_BIN/fake-dm"
    export APPROVE_GH_BIN="$AP_BIN/fake-gh"
    SENTINEL="$SANDBOX/approve-sentinel"
}

ap_claim_body() { # button condition [actor-json]
    jq -cn --arg nonce "$AP_NONCE" --arg sha "$AP_SHA" --arg btn "$1" --arg cond "$2" \
        --argjson actor "${3:-$AP_OWNER_JSON}" --argjson epoch "$(date +%s)" \
        '{nonce: $nonce, pr: 4242, head_sha: $sha, button: $btn,
          condition: (if $cond == "" then null else $cond end), actor: $actor,
          clicked_at: "2026-11-16T12:00:00.000Z", clicked_at_epoch: $epoch}'
}

ap_reset() {
    rm -rf "$AP_STATE" "$SENTINEL"
    mkdir -p "$AP_STATE"
    rm -f "$AP_LOGS"/*
    : > "$AP_LOGS/ssh.log"; : > "$AP_LOGS/gh.log"; : > "$AP_LOGS/oa.log"; : > "$AP_LOGS/dm.log"
    FAKE_LIST_BODY="$(jq -cn --arg n "$AP_NONCE" '{clicks: [{nonce: $n, pr: 4242, button: "ok"}]}')"
    FAKE_CLAIM_BODY="$(ap_claim_body ok "")"
    FAKE_CLAIM_HTTP=200
    FAKE_GH_JSON="$(jq -cn --arg s "$AP_SHA" '{headRefOid: $s, state: "OPEN"}')"
    FAKE_OA_RC=0
    FAKE_OA_RESULT=armed
}

ap_run() { : > "$AP_LOGS/ssh.log"; AP_OUT="$("$@" 2>&1)"; AP_RC=$?; }
ap_tick() { ap_run env -u CLAUDE_HEADLESS "$AP_TICK" --tick; }

# The runner is detached, so wait for its `reported` marker (written after the outcome DM).
ap_wait_reported() {
    local i=0
    while [ ! -e "$AP_STATE/clicks/$AP_NONCE/reported" ] && [ "$i" -lt 100 ]; do
        sleep 0.1
        i=$(( i + 1 ))
    done
}

ap_eq() { if [ "$2" = "$3" ]; then seam_ok "$1"; else seam_fail "$1 (got: $2)"; fi; }
ap_count() { grep -cF -- "$2" "$1" || true; }

seam_case_approve_valid() {
    local want_argv
    ap_reset
    ap_tick
    ap_wait_reported
    ap_eq "approve-valid: tick exits 0" "$AP_RC" "0"
    want_argv=$'[4242]\n[Discord Approve button pressed by Discord user 283183467804491776 at 2026-11-16T12:00:00.000Z (click 01234567)]\n[--option=Discord button: Approve]'
    ap_eq "approve-valid: owner-approve gets exactly the 3 pinned argv elements" "$(cat "$AP_LOGS/oa.log")" "$want_argv"
    ap_eq "approve-valid: argc is 3" "$(cat "$AP_LOGS/oa.argc" 2>/dev/null)" "3"
    want "approve-valid: outcome DM says armed" "$(cat "$AP_LOGS/dm.log")" "armed for merge"
}

seam_case_approve_stale() {
    ap_reset
    FAKE_GH_JSON="$(jq -cn --arg s "$AP_SHA2" '{headRefOid: $s, state: "OPEN"}')"
    ap_tick
    ap_wait_reported
    ap_eq "approve-stale: owner-approve never ran" "$(cat "$AP_LOGS/oa.log")" ""
    want "approve-stale: a fresh button is requested on the discordApproveDM route" "$(cat "$AP_LOGS/dm.log")" "/discordApproveDM"
    want "approve-stale: the fresh button body holds the new head SHA" "$(cat "$AP_LOGS/dm.log")" "$AP_SHA2"
}

seam_case_approve_dup() {
    ap_reset
    ap_tick
    ap_wait_reported
    ap_tick
    ap_tick
    ap_eq "approve-dup: owner-approve ran once across three ticks" "$(ap_count "$AP_LOGS/oa.log" '[4242]')" "1"
    ap_eq "approve-dup: exactly one seen-again DM" "$(ap_count "$AP_LOGS/dm.log" 'listed again')" "1"
}

seam_case_approve_metachar() {
    local cond
    cond='a b; $(touch "$SENTINEL") | rm -rf x & `id` * '\''q'\'' "d"'
    ap_reset
    FAKE_CLAIM_BODY="$(ap_claim_body fix "$cond")"
    ap_tick
    ap_wait_reported
    ap_eq "approve-metachar: owner-approve argc is 4" "$(cat "$AP_LOGS/oa.argc" 2>/dev/null)" "4"
    ap_eq "approve-metachar: the condition is one literal argv element" "$(sed -n 4p "$AP_LOGS/oa.log")" "[--fix-first=$cond]"
    if [ -e "$SENTINEL" ]; then seam_fail "approve-metachar: the sentinel file was created"; else seam_ok "approve-metachar: the sentinel file was never created"; fi
}

seam_case_approve_headless() {
    ap_reset
    ap_run env CLAUDE_HEADLESS=1 "$AP_TICK" --tick
    ap_eq "approve-headless: CLAUDE_HEADLESS=1 exits 3" "$AP_RC" "3"
    ap_eq "approve-headless: no ssh call on CLAUDE_HEADLESS=1" "$(wc -c < "$AP_LOGS/ssh.log" | tr -d ' ')" "0"
    ap_run env CLAUDE_HEADLESS= "$AP_TICK" --tick
    ap_eq "approve-headless: CLAUDE_HEADLESS set but empty exits 3" "$AP_RC" "3"
    ap_eq "approve-headless: no ssh call on an empty CLAUDE_HEADLESS" "$(wc -c < "$AP_LOGS/ssh.log" | tr -d ' ')" "0"
    FAKE_LIST_BODY='{"clicks":[]}'
    ap_tick
    ap_eq "approve-headless: unset runs and exits 0" "$AP_RC" "0"
}

seam_case_approve_empty_tick() {
    ap_reset
    FAKE_LIST_BODY='{"clicks":[]}'
    ap_tick
    ap_eq "approve-empty-tick: exit 0" "$AP_RC" "0"
    ap_eq "approve-empty-tick: one ssh call" "$(wc -l < "$AP_LOGS/ssh.log" | tr -d ' ')" "1"
    ap_eq "approve-empty-tick: no gh call" "$(wc -c < "$AP_LOGS/gh.log" | tr -d ' ')" "0"
    ap_eq "approve-empty-tick: no owner-approve call" "$(wc -c < "$AP_LOGS/oa.log" | tr -d ' ')" "0"
    ap_eq "approve-empty-tick: no discord-dm call" "$(wc -c < "$AP_LOGS/dm.log" | tr -d ' ')" "0"
}

seam_case_approve_run_twice() {
    ap_reset
    ap_tick
    ap_wait_reported
    # Invocation 2 of the runner after the lock dir is gone: only the started marker stands in the way.
    rm -rf "$AP_STATE/clicks/$AP_NONCE/run.lock"
    ap_run env -u CLAUDE_HEADLESS "$AP_TICK" --run-one="$AP_NONCE"
    rm -rf "$AP_STATE/clicks/$AP_NONCE/run.lock"
    ap_run env -u CLAUDE_HEADLESS "$AP_TICK" --run-one="$AP_NONCE"
    ap_eq "approve-run-twice: owner-approve ran once" "$(ap_count "$AP_LOGS/oa.log" '[4242]')" "1"
}

seam_case_approve_fix_first() {
    ap_reset
    FAKE_CLAIM_BODY="$(ap_claim_body fix "rebase first HTTP=500")"
    FAKE_OA_RC=6
    FAKE_OA_RESULT="fix-first recorded"
    ap_tick
    ap_wait_reported
    want "approve-fix-first: passes --fix-first" "$(cat "$AP_LOGS/oa.log")" "[--fix-first=rebase first HTTP=500]"
    want "approve-fix-first: passes the Fix first option" "$(cat "$AP_LOGS/oa.log")" "[--option=Discord button: Fix first]"
    want "approve-fix-first: the DM names the finish command" "$(cat "$AP_LOGS/dm.log")" "bin/owner-approve 4242 --finish"
}

seam_case_approve_crash() {
    local d
    ap_reset
    FAKE_LIST_BODY='{"clicks":[]}'
    d="$AP_STATE/clicks/$AP_NONCE"
    mkdir -p "$d"
    date +%s > "$d/claimed"
    date +%s > "$d/started"
    ap_claim_body ok "" > "$d/record.json"
    ap_tick
    ap_tick
    ap_eq "approve-crash: one loud DM across two ticks" "$(ap_count "$AP_LOGS/dm.log" 'started but recorded no outcome')" "1"
    ap_eq "approve-crash: owner-approve never re-ran" "$(wc -c < "$AP_LOGS/oa.log" | tr -d ' ')" "0"
}

seam_case_approve_cap() {
    local over exact
    over="$(printf '%0301d' 0 | tr 0 x)"
    exact="$(printf '%0300d' 0 | tr 0 x)"
    ap_reset
    FAKE_CLAIM_BODY="$(ap_claim_body fix "$over")"
    ap_tick
    ap_wait_reported
    ap_eq "approve-cap: a 301-char condition runs nothing" "$(wc -c < "$AP_LOGS/oa.log" | tr -d ' ')" "0"
    want "approve-cap: the refusal names the cap" "$(cat "$AP_LOGS/dm.log")" "longer than 300"
    ap_reset
    FAKE_CLAIM_BODY="$(ap_claim_body fix "$exact")"
    ap_tick
    ap_wait_reported
    ap_eq "approve-cap: a 300-char condition runs" "$(sed -n 4p "$AP_LOGS/oa.log")" "[--fix-first=$exact]"
}

seam_case_approve_cntrl() {
    local bad
    for bad in $'a\tb' $'a\nb'; do
        ap_reset
        FAKE_CLAIM_BODY="$(ap_claim_body fix "$bad")"
        ap_tick
        ap_wait_reported
        ap_eq "approve-cntrl: a condition with a control character runs nothing" "$(wc -c < "$AP_LOGS/oa.log" | tr -d ' ')" "0"
        want "approve-cntrl: the refusal names the cause" "$(cat "$AP_LOGS/dm.log")" "control characters"
    done
}

seam_case_approve_actor() {
    ap_reset
    FAKE_CLAIM_BODY="$(ap_claim_body ok "" 283183467804491776)"
    ap_tick
    ap_wait_reported
    ap_eq "approve-actor: a numeric actor runs nothing" "$(wc -c < "$AP_LOGS/oa.log" | tr -d ' ')" "0"
    ap_reset
    FAKE_CLAIM_BODY="$(ap_claim_body ok "" '"1"')"
    ap_tick
    ap_wait_reported
    ap_eq "approve-actor: a different actor runs nothing" "$(wc -c < "$AP_LOGS/oa.log" | tr -d ' ')" "0"
    want "approve-actor: the refusal names the owner check" "$(cat "$AP_LOGS/dm.log")" "not from the owner"
}

seam_case_approve_claim_409() {
    ap_reset
    FAKE_CLAIM_HTTP=409
    FAKE_CLAIM_BODY='{"error":"already-claimed"}'
    ap_tick
    ap_wait_reported
    ap_eq "approve-claim-409: nothing ran" "$(wc -c < "$AP_LOGS/oa.log" | tr -d ' ')" "0"
    want "approve-claim-409: the refusal names the HTTP status" "$(cat "$AP_LOGS/dm.log")" "HTTP 409"
}

seam_case_approve_send_closed() {
    ap_reset
    FAKE_GH_JSON="$(jq -cn --arg s "$AP_SHA" '{headRefOid: $s, state: "CLOSED"}')"
    ap_run env CLAUDE_HEADLESS=1 "$AP_TICK" --send-button=4242
    ap_eq "approve-send-closed: a CLOSED PR exits 0" "$AP_RC" "0"
    ap_eq "approve-send-closed: a CLOSED PR makes no discordApproveDM call" "$(wc -c < "$AP_LOGS/dm.log" | tr -d ' ')" "0"
    FAKE_GH_JSON="$(jq -cn --arg s "$AP_SHA" '{headRefOid: $s, state: "OPEN"}')"
    ap_run env CLAUDE_HEADLESS=1 "$AP_TICK" --send-button=4242
    want "approve-send-closed: an OPEN PR posts to discordApproveDM even under CLAUDE_HEADLESS" "$(cat "$AP_LOGS/dm.log")" "/discordApproveDM"
    want "approve-send-closed: the body holds the head SHA" "$(cat "$AP_LOGS/dm.log")" "$AP_SHA"
}

# ── status fields on the button DM: --send-button merges the gadget's object under `display` ──
ap_body() { sed -n 's/^\[\({.*}\)\]$/\1/p' "$AP_LOGS/dm.log" | tail -n 1; }
ap_posts() { ap_count "$AP_LOGS/dm.log" '[/discordApproveDM]'; }

# ap_jq <label> <jq filter>: the POST body exists and satisfies the filter.
ap_jq() {
    local body
    body="$(ap_body)"
    if [ -n "$body" ] && jq -e "$2" <<< "$body" > /dev/null 2>&1; then
        seam_ok "$1"
    else
        seam_fail "$1 (body: ${body:0:300})"
    fi
}

# ap_gadget <name>: write the stub gadget whose script body arrives on stdin.
ap_gadget() {
    { printf '#!/usr/bin/env bash\n'; cat; } > "$AP_BIN/$1"
    chmod +x "$AP_BIN/$1"
}

# ap_send <gadget path> [VAR=value...]: run --send-button against that gadget.
ap_send() {
    local gadget="$1"
    shift
    ap_run env APPROVE_CLICK_GADGET_BIN="$gadget" "$@" "$AP_TICK" --send-button=4242
}

ap_plain() { # label
    ap_eq "$1: exit 0" "$AP_RC" "0"
    ap_eq "$1: exactly one POST" "$(ap_posts)" "1"
    ap_jq "$1: the POST is the plain body" 'keys == ["head_sha","pr"]'
}

# ap_display_object: the full gadget object (plus one unknown key) that the stubs print.
ap_display_object() {
    cat > "$AP_BIN/display.json" <<'APJSON'
{"title":"T","size":"3 files, +32 −10","cells":{"tests":{"icon":"✅","text":""},"comments":{"icon":"✅","text":""},"bot_review":{"icon":"✅","text":""},"easy_undo":{"icon":"✅","text":""},"your_ok":{"icon":"","text":"none"}},"verdict":"READY, held for you.","decision":"D","extra":"x"}
APJSON
}

seam_case_approve_send_display_merged() {
    local start took
    ap_reset
    ap_display_object
    ap_gadget gadget-ok <<'APG'
cat "$(dirname "$0")/display.json"
APG
    start=$SECONDS
    ap_send "$AP_BIN/gadget-ok"
    took=$(( SECONDS - start ))
    ap_eq "approve-send-display-merged: exit 0" "$AP_RC" "0"
    ap_eq "approve-send-display-merged: exactly one POST" "$(ap_posts)" "1"
    ap_jq "approve-send-display-merged: pr and head_sha are the sender's" ".pr == 4242 and .head_sha == \"$AP_SHA\""
    ap_jq "approve-send-display-merged: display carries the title" '.display.title == "T"'
    ap_jq "approve-send-display-merged: display carries all five cells" '.display.cells | [.tests, .comments, .bot_review, .easy_undo, .your_ok] | all(has("icon"))'
    ap_jq "approve-send-display-merged: an unknown gadget key never reaches the body" '.display | has("extra") | not'
    want "approve-send-display-merged: gh is asked for the PR fields the gadget reads" "$(cat "$AP_LOGS/gh.log")" "headRefOid,state,title,changedFiles,additions,deletions,body"
    # A watchdog that inherits stdout holds the sender open for the whole 30 s timeout.
    if [ "$took" -lt 10 ]; then
        seam_ok "approve-send-display-merged: a fast gadget returns without waiting on the watchdog"
    else
        seam_fail "approve-send-display-merged: send took ${took}s with a fast gadget"
    fi
}

seam_case_approve_send_gadget_fails() {
    ap_reset
    ap_send "$AP_BIN/fake-gadget"
    ap_plain "approve-send-gadget-fails"
}

seam_case_approve_send_gadget_junk() {
    ap_reset
    ap_gadget gadget-junk <<'APG'
echo 'not json'
APG
    ap_send "$AP_BIN/gadget-junk"
    ap_plain "approve-send-gadget-junk"
    ap_reset
    ap_gadget gadget-array <<'APG'
echo '[1,2]'
APG
    ap_send "$AP_BIN/gadget-array"
    ap_plain "approve-send-gadget-array"
}

seam_case_approve_send_gadget_timeout() {
    local start took
    ap_reset
    ap_display_object
    ap_gadget gadget-hang <<'APG'
sleep 10
cat "$(dirname "$0")/display.json"
APG
    start=$SECONDS
    ap_send "$AP_BIN/gadget-hang" APPROVE_CLICK_GADGET_TIMEOUT=1
    took=$(( SECONDS - start ))
    ap_plain "approve-send-gadget-timeout"
    if [ "$took" -lt 5 ]; then
        seam_ok "approve-send-gadget-timeout: the watchdog cuts a hung gadget in under 5 s"
    else
        seam_fail "approve-send-gadget-timeout: send took ${took}s"
    fi
}

seam_case_approve_send_gadget_oversize() {
    ap_reset
    ap_gadget gadget-big <<'APG'
big=$(printf 'x%.0s' {1..9000})
jq -cn --arg d "$big" '{title: "T", size: "1 file", cells: {}, verdict: "V", decision: $d}'
APG
    ap_send "$AP_BIN/gadget-big"
    ap_plain "approve-send-gadget-oversize"
}

seam_case_approve_send_gadget_pr_override() {
    ap_reset
    ap_gadget gadget-override <<'APG'
echo '{"pr":1,"head_sha":"0000000000000000000000000000000000000000","title":"T"}'
APG
    ap_send "$AP_BIN/gadget-override"
    ap_jq "approve-send-gadget-pr-override: pr and head_sha stay the sender's" ".pr == 4242 and .head_sha == \"$AP_SHA\""
    ap_jq "approve-send-gadget-pr-override: display holds no pr or head_sha" '.display.title == "T" and (.display | (has("pr") or has("head_sha")) | not)'
}

seam_case_approve_send_timeout_env_empty() {
    local value
    ap_display_object
    ap_gadget gadget-onesec <<'APG'
sleep 1
cat "$(dirname "$0")/display.json"
APG
    for value in '' abc; do
        ap_reset
        ap_send "$AP_BIN/gadget-onesec" "APPROVE_CLICK_GADGET_TIMEOUT=$value"
        ap_jq "approve-send-timeout-env: APPROVE_CLICK_GADGET_TIMEOUT='$value' still posts display" '.display.title == "T"'
    done
}

# The next two run the real sibling gadget. Its triage command is stubbed, so nothing calls GitHub.
ap_triage_stub() {
    ap_gadget triage-fail <<'APG'
exit 1
APG
}

seam_case_approve_send_gadget_bin_empty() {
    ap_reset
    ap_triage_stub
    ap_send "" PR_BURNDOWN_TRIAGE_CMD="$AP_BIN/triage-fail"
    ap_eq "approve-send-gadget-bin-empty: exit 0" "$AP_RC" "0"
    ap_jq "approve-send-gadget-bin-empty: an empty APPROVE_CLICK_GADGET_BIN runs the real gadget" '.display.cells.tests.text == "Could not read"'
}

seam_case_approve_send_decision_from_body() {
    local body
    ap_reset
    ap_triage_stub
    body=$'<!-- manual-confirmation:begin -->\n## Manual confirmation needed\n\n> **Decision:** Merge if the new DM looks right.\n<!-- manual-confirmation:end -->\n'
    FAKE_GH_JSON="$(jq -cn --arg s "$AP_SHA" --arg b "$body" '{headRefOid: $s, state: "OPEN", title: "T", changedFiles: 1, additions: 2, deletions: 3, body: $b}')"
    ap_send "" PR_BURNDOWN_TRIAGE_CMD="$AP_BIN/triage-fail"
    ap_jq "approve-send-decision-from-body: the quoted Decision line arrives without its label" '.display.decision == "Merge if the new DM looks right."'
    ap_reset
    FAKE_GH_JSON="$(jq -cn --arg s "$AP_SHA" '{headRefOid: $s, state: "OPEN", title: "T", changedFiles: 1, additions: 2, deletions: 3, body: "## Summary\n\nNo choice to make.\n"}')"
    ap_send "" PR_BURNDOWN_TRIAGE_CMD="$AP_BIN/triage-fail"
    ap_jq "approve-send-decision-from-body: no Decision line gives a null decision" 'has("display") and .display.decision == null'
}

seam_case_approve_send_closed_no_gadget() {
    ap_reset
    ap_gadget gadget-marker <<'APG'
: > "$AP_LOGS/gadget.ran"
exit 1
APG
    FAKE_GH_JSON="$(jq -cn --arg s "$AP_SHA" '{headRefOid: $s, state: "CLOSED"}')"
    ap_send "$AP_BIN/gadget-marker"
    ap_eq "approve-send-closed-no-gadget: no POST" "$(ap_posts)" "0"
    ap_eq "approve-send-closed-no-gadget: the gadget never ran" "$([ -e "$AP_LOGS/gadget.ran" ] && echo ran || echo idle)" "idle"
    FAKE_GH_JSON="$(jq -cn --arg s "$AP_SHA" '{headRefOid: $s, state: "OPEN"}')"
    ap_send "$AP_BIN/gadget-marker"
    ap_eq "approve-send-closed-no-gadget: the same stub does run for an OPEN PR" "$([ -e "$AP_LOGS/gadget.ran" ] && echo ran || echo idle)" "ran"
}

seam_case_approve_schedule() {
    local plist path_line
    plist="$("$HERE/approve-click-cron-setup" --print-schedule 2>&1)"
    path_line="$(grep -A1 '<key>PATH</key>' <<< "$plist" | tail -1)"
    want "approve-schedule: PATH has /opt/homebrew/bin" "$path_line" "/opt/homebrew/bin"
    want "approve-schedule: PATH has /usr/bin" "$path_line" "/usr/bin"
    want_not "approve-schedule: no unexpanded dollar sign" "$plist" '$'
    want_not "approve-schedule: no empty string element" "$plist" '<string></string>'
    want "approve-schedule: StartInterval is 180" "$plist" '<integer>180</integer>'
    want "approve-schedule: AbandonProcessGroup is true" "$(grep -A1 '<key>AbandonProcessGroup</key>' <<< "$plist")" '<true/>'
    want "approve-schedule: the program takes --tick" "$plist" '<string>--tick</string>'
}

seam_case_approve_cron_flag() {
    "$HERE/approve-click-cron-setup" --bogus > /dev/null 2>&1
    ap_eq "approve-cron-flag: an unknown flag exits 2" "$?" "2"
    "$HERE/approve-click-cron-setup" > /dev/null 2>&1
    ap_eq "approve-cron-flag: no flag exits 2" "$?" "2"
}

seam_case_approve_fleet_wiring() {
    local dm_line btn_line
    dm_line="$(grep -nF 'ljob_dm_send post-plan-fleet "$msg"' "$HERE/post-plan-fleet" | tail -1 | cut -d: -f1)"
    btn_line="$(grep -nF '"$_ppf_approve" --send-button="$PR" >/dev/null 2>&1 || true' "$HERE/post-plan-fleet" | tail -1 | cut -d: -f1)"
    if [ -z "$dm_line" ] || [ -z "$btn_line" ]; then
        seam_fail "approve-fleet-wiring: the held DM line or the send-button line is missing from post-plan-fleet"
    elif ! grep -qF '_ppf_approve="$ROOT/bin/approve-click-tick"' "$HERE/post-plan-fleet"; then
        seam_fail "approve-fleet-wiring: the runner must build the button path from \$ROOT, not BASH_SOURCE (the runner runs from /tmp)"
    elif [ "$btn_line" -gt "$dm_line" ]; then
        seam_ok "approve-fleet-wiring: the send-button line follows the held DM line and ends in or-true"
    else
        seam_fail "approve-fleet-wiring: the send-button line must come after the held DM line"
    fi
}

