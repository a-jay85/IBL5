# --- case 27: usage-not-truncated --------------------------------------------------------
# --help output documents all three Phase 8 flags (--pr-attack, --top-n, --wait).
begin_case
out="$(run_driver --help 2>&1)"; rc=$?
[[ $rc -eq 0 ]] || fail "usage-not-truncated: --help exited $rc, want 0"
grep -q -- '--pr-attack' <<< "$out" || fail "usage-not-truncated: --help omits --pr-attack"
grep -q -- '--top-n' <<< "$out" || fail "usage-not-truncated: --help omits --top-n"
grep -q -- '--wait' <<< "$out" || fail "usage-not-truncated: --help omits --wait"
end_case usage-not-truncated

# --- case 28: seam-master-sha-unset-vs-empty ---------------------------------------------
# Both unset and empty PR_READY_NOW_MASTER_SHA trigger the git rev-parse fallback.
# The real master SHA differs from the fixture abc1234, so the staleness gate fires on both.
begin_case
# Unset arm: run_driver does not set PR_READY_NOW_MASTER_SHA → driver uses git → STALE.
err_unset="$(env -u PR_READY_NOW_MASTER_SHA \
    env HOME="$SCRATCH" PATH="$SCRATCH/.local/bin:$PATH" \
        PR_READY_NOW_CLAUDE="$CLAUDE_STUB" \
        PR_READY_NOW_GH_USER=a-jay85 \
        "$DRIVER" --pr-attack "$SCRATCH/attack-fresh.md" 2>&1)"; rc_unset=$?
[[ $rc_unset -ne 0 ]] || fail "seam-master-sha-unset-vs-empty: unset arm exited 0, want STALE exit"
grep -qi 'STALE' <<< "$err_unset" || \
    fail "seam-master-sha-unset-vs-empty: unset arm lacks STALE keyword (out: $err_unset)"
# Empty arm: same fallback via :- operator.
err_empty="$(PR_READY_NOW_MASTER_SHA="" \
    run_driver --pr-attack "$SCRATCH/attack-fresh.md" 2>&1)"; rc_empty=$?
[[ $rc_empty -ne 0 ]] || fail "seam-master-sha-unset-vs-empty: empty arm exited 0, want STALE exit"
grep -qi 'STALE' <<< "$err_empty" || \
    fail "seam-master-sha-unset-vs-empty: empty arm lacks STALE keyword (out: $err_empty)"
end_case seam-master-sha-unset-vs-empty

# --- case 29: seam-wtl-unset-vs-empty ---------------------------------------------------
# Unset PR_READY_NOW_WTL → run_driver's single-dash expansion uses WTL_FIXTURE → WOULD FIRE.
# Empty PR_READY_NOW_WTL="" → driver's :- expansion falls through to git worktree list
# (no fixture branches in the real tree) → all PRs SKIP; no crash.
begin_case
clean_slots
# Unset arm: PR_READY_NOW_WTL not set in harness → run_driver expansion uses WTL_FIXTURE.
out_unset="$(PR_READY_NOW_PR_JSON="$SCRATCH/two-open.json" run_driver 2>&1)"; rc=$?
[[ $rc -eq 0 ]] || fail "seam-wtl-unset-vs-empty: unset arm exit $rc"
grep -q 'WOULD FIRE' <<< "$out_unset" || \
    fail "seam-wtl-unset-vs-empty: unset arm has no WOULD FIRE (WTL_FIXTURE not used)"
# Empty arm: empty string → driver falls back to git worktree list (no fixture branches → all skip).
out_empty="$(PR_READY_NOW_WTL="" PR_READY_NOW_PR_JSON="$SCRATCH/two-open.json" run_driver 2>&1)"; rc=$?
[[ $rc -eq 0 ]] || fail "seam-wtl-unset-vs-empty: empty arm crashed (exit $rc)"
grep -q 'WOULD FIRE' <<< "$out_empty" && \
    fail "seam-wtl-unset-vs-empty: empty arm shows WOULD FIRE (git WTL should skip all)"
end_case seam-wtl-unset-vs-empty

# --- case 30: plist-shape-under-attack-selection -----------------------------------------
# When a PR is selected via --pr-attack, fire_pr writes the same plist structure as
# the default path. field() verifies Label and StandardOutPath are PR-number-keyed.
begin_case
clean_slots
PR_READY_NOW_MASTER_SHA="$ATTACK_SHA" \
    PR_READY_NOW_WTL="$WTL8" \
    PR_READY_NOW_PR_JSON="$SCRATCH/attack-8prs.json" \
    PR_READY_NOW_DRY_RUN=1 \
    run_driver --go --pr-attack "$SCRATCH/attack-fresh.md" --top-n 1 >/dev/null 2>&1
rc=$?
[[ $rc -eq 0 ]] || fail "plist-shape-under-attack-selection: driver exited $rc"
P1910="$SCRATCH/Library/LaunchAgents/com.ibl5.pr-ready-now-1910.plist"
[[ -f "$P1910" ]] || fail "plist-shape-under-attack-selection: plist for PR 1910 not created"
v="$(field "$P1910" "Label")"
[[ "$v" == "com.ibl5.pr-ready-now-1910" ]] || \
    fail "plist-shape-under-attack-selection: Label '$v' != com.ibl5.pr-ready-now-1910"
v="$(field "$P1910" "StandardOutPath")"
[[ "$v" == "/tmp/pr-ready-now-1910.log" ]] || \
    fail "plist-shape-under-attack-selection: StandardOutPath '$v' != /tmp/pr-ready-now-1910.log"
grep -qE '\$\{?HOME|\$\{?ROOT|\$\{?LABEL' "$P1910" && \
    fail "plist-shape-under-attack-selection: plist contains unexpanded shell variable"
end_case plist-shape-under-attack-selection

# --- Phase 9: push-form proof against a local bare origin ---------------------------------
# The Phase 2 fix replaces /pr-ready step 3's bare `--force-with-lease` with an explicit
# refspec plus an explicit lease ref. These cases prove, against a real bare repo, that the
# OLD form publishes nothing on a branch with no upstream (the silent-failure bug), that the
# NEW form publishes, and that the lease still rejects a concurrent third-party push.
# Cases 1, 3 and 5 are Phase 2's NEGATIVE and BOUNDARY requirements: they assert that
# something must NOT happen. Never relax them into positive-only checks.

GITFIX="$SCRATCH/gitfix"
ORIGIN="$GITFIX/origin.git"
W="$GITFIX/work"
W2="$GITFIX/work2"
ZERO="0000000000000000000000000000000000000000"

# Isolated git: no signing, deterministic identity, fixed initial branch name -- so the
# developer's ~/.gitconfig cannot change the outcome, on macOS or on Linux CI.
g() { git -c user.name=t -c user.email=t@example.com -c commit.gpgsign=false \
          -c init.defaultBranch=master -c protocol.file.allow=always "$@"; }

remote_sha() { g -C "$W" ls-remote origin "$1" 2>/dev/null | awk '{print $1}'; }
commit_on()  { echo "$2" > "$1/f-$2.txt"; g -C "$1" add -A >/dev/null 2>&1; \
               g -C "$1" commit -q -m "$2" >/dev/null 2>&1; }

mkdir -p "$GITFIX"
g init --bare -q "$ORIGIN"
g clone -q "$ORIGIN" "$W" >/dev/null 2>&1
commit_on "$W" seed
g -C "$W" push -q origin HEAD:refs/heads/master >/dev/null 2>&1
g clone -q "$ORIGIN" "$W2" >/dev/null 2>&1

# --- case 11: the OLD bare form publishes nothing with no upstream ------------------------
# `bin/wt-new` creates branches WITHOUT -u, so @{upstream} is unset -- the only state in
# which the bug reproduces. Exit status is deliberately NOT asserted: it is push.default-
# dependent, which is precisely why "no error printed" was never evidence of a push.
begin_case
g -C "$W" checkout -q master
g -C "$W" checkout -q -b feat-old
commit_on "$W" old1
before="$(remote_sha feat-old)"
old_out="$(g -C "$W" push --force-with-lease 2>&1)"; old_rc=$?
after="$(remote_sha feat-old)"
[[ -z "$before" ]] || fail "feat-old should start with no remote ref, got '$before'"
[[ "$after" == "$before" ]] || fail "bare --force-with-lease PUBLISHED (remote '$before' -> '$after') -- the Phase 2 premise is wrong"
echo "  observed: bare --force-with-lease exit=$old_rc msg=$(head -1 <<< "$old_out")"
end_case push-old-form-does-not-publish

# --- case 12: the NEW explicit form publishes (3a -> 3b -> 3c) ----------------------------
begin_case
g -C "$W" checkout -q master
g -C "$W" checkout -q -b feat-new
commit_on "$W" new1
g -C "$W" push -q origin feat-new:refs/heads/feat-new >/dev/null 2>&1
commit_on "$W" new2
lease="$(remote_sha feat-new)"                                     # 3a
[[ ${#lease} -eq 40 ]] || fail "3a should read a 40-char SHA, got '$lease'"
new_out="$(g -C "$W" push -u --force-with-lease="feat-new:$lease" origin feat-new:feat-new 2>&1)"; new_rc=$?
[[ $new_rc -eq 0 ]] || fail "new form exited $new_rc, want 0 (out: $new_out)"   # 3b
head_sha="$(g -C "$W" rev-parse HEAD)"                             # 3c
[[ "$(remote_sha feat-new)" == "$head_sha" ]] || fail "3c: remote '$(remote_sha feat-new)' != HEAD '$head_sha'"
end_case push-new-form-publishes

# --- case 13: the lease STILL rejects a concurrent third-party push -----------------------
# The whole point of --force-with-lease. If this case ever passes trivially, the explicit
# lease has been reduced to a plain --force.
begin_case
g -C "$W" checkout -q master
g -C "$W" checkout -q -b feat-lease
commit_on "$W" lease1
g -C "$W" push -q origin feat-lease:refs/heads/feat-lease >/dev/null 2>&1
stale_lease="$(remote_sha feat-lease)"                             # 3a, captured early
g -C "$W2" fetch -q origin >/dev/null 2>&1                         # third party moves the ref
g -C "$W2" checkout -q -B feat-lease origin/feat-lease >/dev/null 2>&1
commit_on "$W2" third
g -C "$W2" push -q origin feat-lease:refs/heads/feat-lease >/dev/null 2>&1
third_sha="$(g -C "$W2" rev-parse HEAD)"
[[ "$(remote_sha feat-lease)" == "$third_sha" ]] || fail "fixture: third-party push did not land"
commit_on "$W" lease2
sl_out="$(g -C "$W" push -u --force-with-lease="feat-lease:$stale_lease" origin feat-lease:feat-lease 2>&1)"; sl_rc=$?
[[ $sl_rc -ne 0 ]] || fail "stale lease was ACCEPTED -- a concurrent push would have been clobbered"
grep -q 'stale info' <<< "$sl_out" || fail "rejection message lacks 'stale info' (out: $sl_out)"
[[ "$(remote_sha feat-lease)" == "$third_sha" ]] || fail "third party's commit was overwritten despite the lease"
end_case push-lease-still-rejects

# --- case 14: the all-zeros lease CREATES a ref that does not exist -----------------------
# 3a prints nothing when the branch has no remote ref; the doc says use 40 zeros.
begin_case
g -C "$W" checkout -q master
g -C "$W" checkout -q -b feat-zero
commit_on "$W" zero1
[[ -z "$(remote_sha feat-zero)" ]] || fail "fixture: feat-zero already has a remote ref"
z_out="$(g -C "$W" push -u --force-with-lease="feat-zero:$ZERO" origin feat-zero:feat-zero 2>&1)"; z_rc=$?
[[ $z_rc -eq 0 ]] || fail "zero-lease create exited $z_rc, want 0 (out: $z_out)"
[[ "$(remote_sha feat-zero)" == "$(g -C "$W" rev-parse HEAD)" ]] || fail "zero-lease did not create the remote ref"
end_case push-zero-lease-creates

# --- case 15: the all-zeros lease is NOT a force wildcard ---------------------------------
# Boundary case. If zeros were treated as "don't care", a copy-pasted 3b from an earlier
# branch would silently clobber an existing ref. A new local commit is required first, or
# git short-circuits with "Everything up-to-date" and never evaluates the lease.
begin_case
commit_on "$W" zero2
existing="$(remote_sha feat-zero)"
[[ ${#existing} -eq 40 ]] || fail "fixture: feat-zero should now have a remote ref"
zw_out="$(g -C "$W" push --force-with-lease="feat-zero:$ZERO" origin feat-zero:feat-zero 2>&1)"; zw_rc=$?
[[ $zw_rc -ne 0 ]] || fail "all-zeros lease ACCEPTED against an existing ref -- it is behaving as a wildcard"
[[ "$(remote_sha feat-zero)" == "$existing" ]] || fail "existing ref moved under an all-zeros lease"
end_case push-zero-lease-not-a-wildcard

# --- case 16: /pr-ready SKILL.md still carries the fixed push form ------------------------
# Line-level greps, so the assertions survive reflowing of the prose.
#
# DEVIATION from the plan text (surfaced in the PR body): the plan asked for ZERO
# occurrences of `ls-remote origin HEAD` and ZERO `--force-with-lease` not followed by `=`.
# The plan's own Phase 2 prose deliberately contains both, as PROHIBITIONS ("Do not use
# `git ls-remote origin HEAD`", "A bare `--force-with-lease` publishes nothing"). Asserting
# zero would forbid the skill from ever documenting the anti-pattern it exists to prevent.
# The assertion is narrowed instead: a bare occurrence is allowed only on a line that
# negates it, and a POSITIVE arm pins the 3b line to the fixed form.
begin_case
SKILL="$SCRIPT_DIR/../.claude/skills/pr-ready/SKILL.md"
if [[ ! -f "$SKILL" ]]; then
    fail "pr-ready SKILL.md not found at $SKILL"
else
    # (a) every bare --force-with-lease sits on a negating line
    while IFS= read -r line; do
        grep -qE '(bare|Do not|Never|never)' <<< "$line" \
            || fail "bare --force-with-lease on a non-negating line: $line"
    done < <(grep -- '--force-with-lease' "$SKILL" | grep -v -- '--force-with-lease=')
    # (b) `ls-remote origin HEAD` only on a "Do not use" line
    while IFS= read -r line; do
        grep -q 'Do not use' <<< "$line" \
            || fail "'ls-remote origin HEAD' on a non-prohibiting line: $line"
    done < <(grep -F 'ls-remote origin HEAD' "$SKILL")
    # (c) POSITIVE arm: 3b names the explicit lease form
    step3b="$(grep -F '3b — push' "$SKILL")"
    [[ -n "$step3b" ]] || fail "SKILL.md has no '3b -- push' step line"
    grep -q -- '--force-with-lease=<branch>:' <<< "$step3b" \
        || fail "the 3b step line does not carry --force-with-lease=<branch>: (fix reverted?)"
    grep -q -- 'origin <branch>:<branch>' <<< "$step3b" \
        || fail "the 3b step line lost its explicit refspec"
    # (d) the fail-closed verify word survives
    [[ "$(grep -c 'PUSH FAILED' "$SKILL")" -ge 1 ]] || fail "SKILL.md lost the PUSH FAILED stop word"
    # (e) the doc was re-verified after the fix
    grep -q '^last_verified: 2026-08-19$' "$SKILL" && fail "last_verified still the pre-fix 2026-08-19"
    # (f) unrelated prose was not collaterally rewritten
    grep -qF 'master is moving faster than this branch can rebase' "$SKILL" \
        || fail "the Phase 4 loop-bound message was lost"
fi
end_case pr-ready-doc-shape

# --- case 17: Phase 5.9 files-changed rewriter -------------------------------------------
begin_case
# The rewriter is a COMMITTED script, not an inline SKILL.md block (PR #1982's pattern),
# so this case exercises the same bytes /pr-ready runs. It takes the PR number as $1;
# every runner below passes 9999, which is what makes the /tmp paths concrete.
RWSRC="$SCRIPT_DIR/../.claude/skills/pr-ready/scripts/files-changed.sh"
RW=/tmp/tprn-rewriter.sh
cp "$RWSRC" "$RW"

# (a) fail-closed source guard
[[ -s "$RW" ]] || fail "scripts/files-changed.sh missing, empty, or moved"
grep -qF 'files-changed:begin' "$RW" || fail "scripts/files-changed.sh lost the block markers"

# (b) doc-shape assertions on the committed script
[[ "$(grep -c '<(' "$RW")" -eq 0 ]] \
    || fail "rewriter must have 0 process substitutions"
grep -qF 'grep -cFx' "$RW" || fail "rewriter missing grep -cFx"
grep -qF 'grep -nFx' "$RW" || fail "rewriter missing grep -nFx"
grep -qF "sed 's/\r\$//'" "$RW" || fail "rewriter missing CRLF normalisation"
grep -qF 'AMBIGUOUS' "$RW"   || fail "rewriter missing AMBIGUOUS arm"
[[ "$(grep -c 'gh pr edit' "$RW")" -eq 1 ]] \
    || fail "rewriter must have exactly 1 'gh pr edit'"
grep -qF '$NF' "$RW" || fail "rewriter missing \$NF (rename-safe awk)"

# (b2) call-site seam. Externalising the block (PR #1982's pattern) split doc from runtime:
# every runner below invokes $RW directly with a hardcoded 9999, so a SKILL.md call line that
# lost its `<N>` argument would pass this case and STOP on the arg guard in every real run.
# This pins the seam the split opened — the one line Phase 5.9 tells the model to run.
_SK="$SCRIPT_DIR/../.claude/skills/pr-ready/SKILL.md"
_CALL=$(grep -F 'pr-ready-filesblock-<N>.sh' "$_SK" | grep -F 'git show' || true)
[[ -n "$_CALL" ]] || fail "SKILL.md Phase 5.9 lost its git-show call line for the rewriter"
grep -qF '.claude/skills/pr-ready/scripts/files-changed.sh' <<< "$_CALL" \
    || fail "SKILL.md call line does not materialise scripts/files-changed.sh"
grep -qF 'test -s /tmp/pr-ready-filesblock-<N>.sh' <<< "$_CALL" \
    || fail "SKILL.md call line lost its 'test -s' non-empty guard"
grep -qE 'bash /tmp/pr-ready-filesblock-<N>\.sh <N>[[:space:]]*$' <<< "$_CALL" \
    || fail "SKILL.md call line must end 'bash /tmp/pr-ready-filesblock-<N>.sh <N>' (arg guard STOPs without it)"

# (c) fixture git repo: origin/master has .claude/x; feat-rewriter adds bin/y + modifies .claude/x
_FIX=$(mktemp -d)
_REMOTE="$_FIX/remote.git"
_LOCAL="$_FIX/local"
g init --bare --quiet "$_REMOTE"
g clone --quiet "$_REMOTE" "$_LOCAL" 2>/dev/null
mkdir -p "$_LOCAL/.claude" "$_LOCAL/bin"
printf 'initial\n' > "$_LOCAL/.claude/x"
g -C "$_LOCAL" add .
g -C "$_LOCAL" commit --quiet -m "init"
g -C "$_LOCAL" push --quiet origin master
g -C "$_LOCAL" checkout --quiet -b feat-rewriter
printf 'modified\n' > "$_LOCAL/.claude/x"
printf 'new\n' > "$_LOCAL/bin/y"
g -C "$_LOCAL" add .
g -C "$_LOCAL" commit --quiet -m "feat"
g -C "$_LOCAL" push --quiet origin feat-rewriter

_BEG='<!-- files-changed:begin -->'
_END='<!-- files-changed:end -->'

# mk_runner: prepend gh() stub to $RW and write runner to $2.sh
mk_runner() {  # $1 = body fixture file, $2 = capture path
    { printf 'gh() { case "$2" in\n'
      printf '  view) cat %q ;;\n' "$1"
      printf '  edit) cp "${@: -1}" %q; echo EDIT >> %q ;;\n' "$2" "$2.log"
      printf 'esac; }\n'
      cat "$RW"
    } > "$2.sh"
}

# --- fixture 1: stale bullets → REPLACED (prose preserved above and below) ---
_F1B=/tmp/tprn-f1.md
printf '%s\n%s\n%s\n%s\n%s\n' \
    'Prose above.' "$_BEG" '- `A` `old/file`' "$_END" 'Prose below.' > "$_F1B"
_F1=/tmp/tprn-f1
mk_runner "$_F1B" "$_F1"
_f1_out=$(cd "$_LOCAL" && bash "$_F1.sh" 9999 2>&1)
grep -qF 'FILES-CHANGED: REPLACED (2 files; +2 -1)' <<< "$_f1_out" \
    || fail "fixture 1: expected REPLACED (2 files; +2 -1), got: $_f1_out"
[[ -f "$_F1.log" ]] || fail "fixture 1: gh edit was not called"
[[ "$(grep -cFx "$_BEG" "$_F1")" -eq 1 ]] || fail "fixture 1: begin-marker count != 1"
[[ "$(grep -cFx "$_END" "$_F1")" -eq 1 ]] || fail "fixture 1: end-marker count != 1"
grep -qF 'Prose above.'       "$_F1" || fail "fixture 1: prose above lost"
grep -qF 'Prose below.'       "$_F1" || fail "fixture 1: prose below lost"
grep -qF -- '- `M` `.claude/x`' "$_F1" || fail "fixture 1: modified file missing"
grep -qF -- '- `A` `bin/y`'     "$_F1" || fail "fixture 1: added file missing"

# --- fixture 2: current block in native git order → UNCHANGED (anti-sort fixture) ---
# native order: M .claude/x before A bin/y (.claude < bin by path in ASCII)
_F2B=/tmp/tprn-f2.md
printf '%s\n%s\n%s\n%s\n' "$_BEG" '- `M` `.claude/x`' '- `A` `bin/y`' "$_END" > "$_F2B"
_F2=/tmp/tprn-f2
mk_runner "$_F2B" "$_F2"
_f2_out=$(cd "$_LOCAL" && bash "$_F2.sh" 9999 2>&1)
grep -qF 'FILES-CHANGED: UNCHANGED (2 files; +0 -0)' <<< "$_f2_out" \
    || fail "fixture 2: expected UNCHANGED (2 files; +0 -0), got: $_f2_out"
[[ ! -f "$_F2.log" ]] || fail "fixture 2: gh edit was called on an already-current block"

# sanity: sorted order (A bin/y first) forces a rewrite — confirms fixture 2 discriminates
_F2SB=/tmp/tprn-f2s.md
printf '%s\n%s\n%s\n%s\n' "$_BEG" '- `A` `bin/y`' '- `M` `.claude/x`' "$_END" > "$_F2SB"
_F2S=/tmp/tprn-f2s
mk_runner "$_F2SB" "$_F2S"
_f2s_out=$(cd "$_LOCAL" && bash "$_F2S.sh" 9999 2>&1)
grep -qF 'FILES-CHANGED: REPLACED (2 files; +0 -0)' <<< "$_f2s_out" \
    || fail "fixture 2 sanity (sorted→native): expected REPLACED (2 files; +0 -0), got: $_f2s_out"

# --- fixture 3: no markers → APPENDED ---
_F3B=/tmp/tprn-f3.md
printf 'Prose only, no markers.\n' > "$_F3B"
_F3=/tmp/tprn-f3
mk_runner "$_F3B" "$_F3"
_f3_out=$(cd "$_LOCAL" && bash "$_F3.sh" 9999 2>&1)
grep -qF 'FILES-CHANGED: APPENDED (2 files; +2 -0)' <<< "$_f3_out" \
    || fail "fixture 3: expected APPENDED (2 files; +2 -0), got: $_f3_out"
[[ -f "$_F3.log" ]] || fail "fixture 3: gh edit was not called"
[[ "$(grep -cFx "$_BEG" "$_F3")" -eq 1 ]] || fail "fixture 3: begin-marker count != 1"
[[ "$(grep -cFx "$_END" "$_F3")" -eq 1 ]] || fail "fixture 3: end-marker count != 1"
grep -qF 'Prose only, no markers.' "$_F3" || fail "fixture 3: original prose lost"

# --- fixture 4: orphan begin marker → APPENDED (begin count 2, end count 1, orphan intact) ---
_F4B=/tmp/tprn-f4.md
printf '%s\n%s\n%s\n' 'Some prose.' "$_BEG" 'More prose.' > "$_F4B"
_F4=/tmp/tprn-f4
mk_runner "$_F4B" "$_F4"
_f4_out=$(cd "$_LOCAL" && bash "$_F4.sh" 9999 2>&1)
grep -qF 'FILES-CHANGED: APPENDED' <<< "$_f4_out" \
    || fail "fixture 4: expected APPENDED, got: $_f4_out"
[[ -f "$_F4.log" ]] || fail "fixture 4: gh edit was not called"
[[ "$(grep -cFx "$_BEG" "$_F4")" -eq 2 ]] \
    || fail "fixture 4: begin-marker count should be 2 (orphan + new)"
[[ "$(grep -cFx "$_END" "$_F4")" -eq 1 ]] || fail "fixture 4: end-marker count should be 1"
grep -qF 'Some prose.' "$_F4" || fail "fixture 4: original prose lost"

# --- fixture 5: duplicate marker pairs → AMBIGUOUS, edit log absent ---
# Layout for nb=2 ne=2 lb=1 le=2: empty first block, then second block with bullet
_F5B=/tmp/tprn-f5.md
printf '%s\n%s\n%s\n%s\n%s\n' "$_BEG" "$_END" "$_BEG" '- `A` `old/file`' "$_END" > "$_F5B"
_F5=/tmp/tprn-f5
mk_runner "$_F5B" "$_F5"
_f5_out=$(cd "$_LOCAL" && bash "$_F5.sh" 9999 2>&1)
grep -qF 'FILES-CHANGED: AMBIGUOUS' <<< "$_f5_out" \
    || fail "fixture 5: expected AMBIGUOUS, got: $_f5_out"
[[ ! -f "$_F5.log" ]] || fail "fixture 5: gh edit was called (body should be left untouched)"

# --- fixture 6: end before begin → AMBIGUOUS, edit log absent ---
# lb=4, le=2 → le < lb → paired=0 → AMBIGUOUS
_F6B=/tmp/tprn-f6.md
printf '%s\n%s\n%s\n%s\n' 'Prose line 1.' "$_END" '- `A` `old/file`' "$_BEG" > "$_F6B"
_F6=/tmp/tprn-f6
mk_runner "$_F6B" "$_F6"
_f6_out=$(cd "$_LOCAL" && bash "$_F6.sh" 9999 2>&1)
grep -qF 'FILES-CHANGED: AMBIGUOUS' <<< "$_f6_out" \
    || fail "fixture 6: expected AMBIGUOUS, got: $_f6_out"
[[ ! -f "$_F6.log" ]] || fail "fixture 6: gh edit was called (body should be left untouched)"

# --- fixture 7: CRLF body with markers → REPLACED, begin-marker count exactly 1 ---
_F7B=/tmp/tprn-f7.md
printf 'Prose above.\r\n%s\r\n- `A` `old/file`\r\n%s\r\nProse below.\r\n' \
    "$_BEG" "$_END" > "$_F7B"
_F7=/tmp/tprn-f7
mk_runner "$_F7B" "$_F7"
_f7_out=$(cd "$_LOCAL" && bash "$_F7.sh" 9999 2>&1)
grep -qF 'FILES-CHANGED: REPLACED (2 files; +2 -1)' <<< "$_f7_out" \
    || fail "fixture 7: expected REPLACED (2 files; +2 -1), got: $_f7_out"
[[ -f "$_F7.log" ]] || fail "fixture 7: gh edit was not called"
[[ "$(grep -cFx "$_BEG" "$_F7")" -eq 1 ]] \
    || fail "fixture 7: begin-marker duplicated — CRLF normalisation not working"

# (c2) self-mutant: replace sed CRLF strip with cat — must produce 2 begin markers
sed "s|sed 's/.r\$//'|cat|" "$RW" > /tmp/tprn-rewriter-mutant.sh
_F7M=/tmp/tprn-f7-mutant
{ printf 'gh() { case "$2" in\n'
  printf '  view) cat %q ;;\n' "$_F7B"
  printf '  edit) cp "${@: -1}" %q; echo EDIT >> %q ;;\n' "$_F7M" "$_F7M.log"
  printf 'esac; }\n'
  cat /tmp/tprn-rewriter-mutant.sh
} > "$_F7M.sh"
(cd "$_LOCAL" && bash "$_F7M.sh" 9999 2>/dev/null) >/dev/null
[[ "$(grep -cF "$_BEG" "$_F7M")" -eq 2 ]] \
    || fail "self-mutant: expected 2 begin markers after CRLF-strip removal, got $(grep -cF "$_BEG" "$_F7M" 2>/dev/null || echo 0)"

# --- fixture 8: rename in diff → REPLACED with R100 bullet naming the new path ---
g -C "$_LOCAL" checkout --quiet master
g -C "$_LOCAL" checkout --quiet -b feat-rename
g -C "$_LOCAL" mv .claude/x .claude/x-new
g -C "$_LOCAL" commit --quiet -m "rename"
g -C "$_LOCAL" push --quiet origin feat-rename
_F8B=/tmp/tprn-f8.md
printf '%s\n%s\n%s\n%s\n%s\n' \
    'Prose above.' "$_BEG" '- `M` `.claude/x`' "$_END" 'Prose below.' > "$_F8B"
_F8=/tmp/tprn-f8
mk_runner "$_F8B" "$_F8"
_f8_out=$(cd "$_LOCAL" && bash "$_F8.sh" 9999 2>&1)
grep -qF 'FILES-CHANGED: REPLACED' <<< "$_f8_out" \
    || fail "fixture 8: expected REPLACED, got: $_f8_out"
[[ -f "$_F8.log" ]] || fail "fixture 8: gh edit was not called"
grep -qF '`.claude/x-new`'  "$_F8" || fail "fixture 8: renamed-to path missing"
grep -qFx -- '- `M` `.claude/x`' "$_F8" && fail "fixture 8: old path still appears as M bullet"
g -C "$_LOCAL" checkout --quiet feat-rewriter

# --- fixture 9: begin marker on line 1 (lb==1 edge; guards head -n 0 on BSD head) ---
_F9B=/tmp/tprn-f9.md
printf '%s\n%s\n%s\n%s\n' "$_BEG" '- `A` `old/file`' "$_END" 'Trailing prose.' > "$_F9B"
_F9=/tmp/tprn-f9
mk_runner "$_F9B" "$_F9"
_f9_out=$(cd "$_LOCAL" && bash "$_F9.sh" 9999 2>&1)
grep -qF 'FILES-CHANGED: REPLACED (2 files; +2 -1)' <<< "$_f9_out" \
    || fail "fixture 9: expected REPLACED (2 files; +2 -1), got: $_f9_out"
[[ -f "$_F9.log" ]] || fail "fixture 9: gh edit was not called"
head -1 "$_F9" | grep -qFx "$_BEG" || fail "fixture 9: begin marker not on line 1 of output"
grep -qF 'Trailing prose.' "$_F9" || fail "fixture 9: trailing prose lost"

# --- fixture 10: end marker on last line (le==last-line edge; guards tail past EOF) ---
_F10B=/tmp/tprn-f10.md
printf '%s\n%s\n%s\n%s' 'Prose above.' "$_BEG" '- `A` `old/file`' "$_END" > "$_F10B"
_F10=/tmp/tprn-f10
mk_runner "$_F10B" "$_F10"
_f10_out=$(cd "$_LOCAL" && bash "$_F10.sh" 9999 2>&1)
grep -qF 'FILES-CHANGED: REPLACED (2 files; +2 -1)' <<< "$_f10_out" \
    || fail "fixture 10: expected REPLACED (2 files; +2 -1), got: $_f10_out"
[[ -f "$_F10.log" ]] || fail "fixture 10: gh edit was not called"
tail -1 "$_F10" | grep -qFx "$_END" || fail "fixture 10: end marker not on last line of output"

end_case pr-ready-files-changed-rewriter

# --- case 18: E14 Monitor commands are substitution-free ---------------------------------
# After E14, every SKILL.md `command:` line is the Write-to-tmp runner, and the stale
# `**Exempt:**` clause that told the reader Monitor was ungated is gone. Assertions are
# unconditional counts (case 17's shape) so a regression fails loudly rather than skipping.
begin_case
SKILL="$SCRIPT_DIR/../.claude/skills/pr-ready/SKILL.md"
[[ -s "$SKILL" ]] || fail "e14: pr-ready SKILL.md missing or empty at $SKILL"

[[ "$(grep -cF '**Exempt:**' "$SKILL")" -eq 0 ]] \
    || fail "e14: SKILL.md still carries an **Exempt:** clause (E14 regression)"
# every `command:` line must be substitution-free
[[ "$(grep 'command:' "$SKILL" | grep -c '\$(\|<(')" -eq 0 ]] \
    || fail "e14: a Monitor command: line contains \$( or <( (E14 regression)"
# ...and must be the Write-to-tmp runner, armed in both Phase 4.5 and Phase 6.5
[[ "$(grep -cF 'command: "bash /tmp/pr-ready-ciwatch-<N>.sh"' "$SKILL")" -eq 2 ]] \
    || fail "e14: expected 2 'command: \"bash /tmp/pr-ready-ciwatch-<N>.sh\"' lines (Phase 4.5 + 6.5)"
[[ "$(grep -c 'command:' "$SKILL")" -eq 2 ]] \
    || fail "e14: unexpected extra command: line in SKILL.md — widen or narrow this assertion"
end_case e14-monitor-subst-free

# --- case 19: E15 rebase delegate is never told to push ----------------------------------
# The delegate packet runs under ~/.claude/hooks/plan-gate-commit.sh, which denies `git push`
# for sub-agents. Any positive push instruction in the packet is an instant hard-fail.
begin_case
REBASE="$SCRIPT_DIR/../.claude/skills/pr-ready/_rebase-and-conflicts.md"
[[ -s "$REBASE" ]] || fail "e15: _rebase-and-conflicts.md missing or empty at $REBASE"

grep -qiE '(NOT|may not|must not) run.*git push' "$REBASE" \
    || fail "e15: delegate hard limits do not prohibit 'git push' (E15 regression)"
[[ "$(grep 'git push' "$REBASE" | grep -cviE '\b(NOT|never|may not|must not|cannot|do not)\b')" -eq 0 ]] \
    || fail "e15: positive 'git push' instruction in the delegate packet (E15 regression)"
end_case e15-delegate-no-push

# --- verdict -----------------------------------------------------------------------------
if [[ $FAILED -ne 0 ]]; then
    echo "test-pr-ready-now: FAILED ($FAILED assertion failure(s))" >&2
    exit 1
fi
echo "test-pr-ready-now: all cases passed"
