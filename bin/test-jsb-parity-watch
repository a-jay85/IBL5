case_fixer_blocker_wakes_fixer() {
    sandbox fixer_wake
    quiet_row
    arm_fixer
    write_blockers '{"active":{"days-empty":{"first":1,"fix":"line one\nline two","bucket":"fixer","dm_sent":false},"frida-missing":{"first":1,"fix":"x","bucket":"owner","dm_sent":true}},"fixer":{}}'
    run_watch
    rc_is "fixer blocker: exit 0" 0
    h_eq "fixer blocker: one fixer POST" 1 "$(posts fixer)"
    h_eq "fixer blocker: no parity POST" 0 "$(posts parity)"
    h_eq "fixer blocker: no DM" 0 "$(cnt discord-dm)"
    h_eq "queue holds the key and a one-line context" "$(printf 'days-empty\tline one line two')" "$(QUEUE)"
    h_absent "the fixer POST records no parity fingerprint" "$S/home/.cache/jsb-parity-watch.last"
    reset_logs
    NOW=$((BASE + 3600)) run_watch
    h_eq "one hour later: no second wake" 0 "$(posts fixer)"
}

