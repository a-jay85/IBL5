#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/lib/plan-checks-block — the PR-body codec for the Plan checks CI job.
# Post-plan encodes a plan's CI-runnable matrix rows and its mutation records
# into a base64 block in the PR body; the Plan checks job decodes and runs them.
# One script owns both sides, so the encoder and the decoder cannot drift.
#
# Usage: bin/lib/plan-checks-block encode <plan>
#        bin/lib/plan-checks-block local <plan>
#        bin/lib/plan-checks-block decode <body-file> <outdir>
#        bin/lib/plan-checks-block needs --body-file F
#        bin/lib/plan-checks-block ci --body-file F --labels-file L
# ---
# encode  print the block on stdout. Rows: the plan's matrix rows that
#         row_runs_in_ci (bin/lib/plan-matrix-rows.sh) sends to CI, deduped.
#         Records: bin/lib/plan-exec-mutations parse output. Exit 3 when the
#         plan has no Verification Matrix or parse fails; exit 5 when the
#         block is over 32768 bytes.
# local   print, in the parse byte format, the mutation records encode
#         leaves out of the block (row_runs_in_ci is false for their check).
#         bin/lib/prefire-verify runs them in its local-mutations stage.
#         Exit 3 as for encode.
# decode  write <outdir>/rows.tsv (num TAB cmd) and <outdir>/records.nul (the
#         exact parse byte format). Exit 0 ok; 4 no begin marker; 3 corrupt.
# needs   print db=, web=, bun=, actionlint=, go= lines (0 or 1): the stacks the
#         block's rows need (row_ci_needs). The workflow gates its stack steps
#         on them. An absent or corrupt block prints five =0 lines. Exit 0.
# ci      the CI driver. The PR is plan-driven when the labels file has a line
#         exactly `plan-checks`. Rewrites localhost URLs (ci_host_rewrite) and
#         fails a row whose stack's IBL_CI_<DB|WEB|BUN|GO>_READY is not 1.
#         Exit 0 pass; 1 fail.
# All five exit 2 on a usage error.

set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CAP=32768
# shellcheck source=bin/lib/plan-matrix-rows.sh
source "$SELF_DIR/plan-matrix-rows.sh"

usage() {
    echo "Usage: bin/lib/plan-checks-block encode <plan>" >&2
    echo "       bin/lib/plan-checks-block local <plan>" >&2
    echo "       bin/lib/plan-checks-block decode <body-file> <outdir>" >&2
    echo "       bin/lib/plan-checks-block needs --body-file F" >&2
    echo "       bin/lib/plan-checks-block ci --body-file F --labels-file L" >&2
    exit 2
}

# The codec. argv: encode <rows.tsv> <records.nul> <cap> | decode <body> <outdir>
codec() {
    python3 -I -c '
import base64, hashlib, json, re, sys, zlib

BEGIN = "<!-- plan-checks:begin -->"
END = "<!-- plan-checks:end -->"
HEADER_RE = re.compile(r"^plan-checks v1 sha256=([0-9a-f]{64}) rows=([0-9]+) mutations=([0-9]+)$")
REC_KEYS = ("row", "file", "check", "match", "replace")


def encode(rows_path, recs_path, cap):
    rows = []
    with open(rows_path, encoding="utf-8") as f:
        for line in f.read().splitlines():
            if not line:
                continue
            num, _, cmd = line.partition("\t")
            rows.append({"num": num, "cmd": cmd})
    mutations = []
    with open(recs_path, "rb") as f:
        raw = f.read()
    for line in raw.split(b"\n"):
        if not line:
            continue
        parts = line.decode("utf-8").split("\0")
        if len(parts) != len(REC_KEYS):
            sys.stderr.write("FAIL parse record has %d fields, wanted 5\n" % len(parts))
            return 3
        mutations.append(dict(zip(REC_KEYS, parts)))
    payload = json.dumps({"v": 1, "rows": rows, "mutations": mutations},
                         sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode("ascii")
    sha = hashlib.sha256(payload).hexdigest()
    b64 = base64.b64encode(zlib.compress(payload, 9)).decode("ascii")
    lines = [b64[i:i + 76] for i in range(0, len(b64), 76)]
    block = "\n".join([
        BEGIN,
        "<details><summary>Plan checks for CI (read by the Plan checks job)</summary>",
        "",
        "```text",
        "plan-checks v1 sha256=%s rows=%d mutations=%d" % (sha, len(rows), len(mutations)),
    ] + lines + [
        "```",
        "",
        "</details>",
        END,
    ]) + "\n"
    size = len(block.encode("ascii"))
    if size > cap:
        sys.stderr.write("FAIL plan-checks block is %d bytes, over the %d cap\n" % (size, cap))
        return 5
    sys.stdout.write(block)
    return 0


def corrupt(reason):
    sys.stdout.write(reason + "\n")
    return 3


def decode(body_path, outdir):
    with open(body_path, encoding="utf-8", errors="replace") as f:
        body = f.read().replace("\r\n", "\n")
    n = body.count(BEGIN)
    if n == 0:
        return 4
    if n != 1:
        return corrupt("begin marker appears %d times" % n)
    b = body.index(BEGIN)
    e = body.find(END)
    if e == -1:
        return corrupt("end marker missing")
    if e < b:
        return corrupt("end marker comes before the begin marker")
    lines = body[b + len(BEGIN):e].split("\n")
    hi = next((i for i, l in enumerate(lines) if l.startswith("plan-checks ")), None)
    if hi is None:
        return corrupt("no plan-checks header line")
    m = HEADER_RE.match(lines[hi].strip())
    if not m:
        return corrupt("header line does not match plan-checks v1 sha256=<64 hex> rows=<n> mutations=<m>")
    data = []
    for l in lines[hi + 1:]:
        if l.strip() == "```":
            break
        data.append(l.strip())
    else:
        return corrupt("payload fence not closed")
    try:
        payload = zlib.decompress(base64.b64decode("".join(data), validate=True))
    except Exception as exc:
        return corrupt("base64 or zlib decoding failed: %s" % exc)
    if hashlib.sha256(payload).hexdigest() != m.group(1):
        return corrupt("sha256 of the payload differs from the header")
    try:
        obj = json.loads(payload.decode("ascii"))
    except Exception as exc:
        return corrupt("payload is not JSON: %s" % exc)
    if not isinstance(obj, dict) or set(obj) != {"v", "rows", "mutations"} or obj["v"] != 1:
        return corrupt("payload is not an object with exactly v=1, rows, mutations")
    if not isinstance(obj["rows"], list) or not isinstance(obj["mutations"], list):
        return corrupt("rows or mutations is not a list")

    def clean(rec, keys, num_key):
        if not isinstance(rec, dict) or set(rec) != set(keys):
            return "an entry has the wrong keys"
        for k in keys:
            v = rec[k]
            if not isinstance(v, str):
                return "field %s is not a string" % k
            if "\0" in v or "\n" in v:
                return "field %s holds a NUL or LF" % k
        if not re.fullmatch(r"[0-9]+", rec[num_key]):
            return "field %s is not all digits" % num_key
        return None

    for r in obj["rows"]:
        why = clean(r, ("num", "cmd"), "num")
        if why:
            return corrupt("row: " + why)
    for r in obj["mutations"]:
        why = clean(r, REC_KEYS, "row")
        if why:
            return corrupt("mutation: " + why)
    if len(obj["rows"]) != int(m.group(2)) or len(obj["mutations"]) != int(m.group(3)):
        return corrupt("a count differs from its header value")
    with open(outdir + "/rows.tsv", "w", encoding="utf-8") as f:
        for r in obj["rows"]:
            f.write("%s\t%s\n" % (r["num"], r["cmd"]))
    with open(outdir + "/records.nul", "wb") as f:
        for r in obj["mutations"]:
            f.write("\0".join(r[k] for k in REC_KEYS).encode("utf-8") + b"\n")
    return 0


if sys.argv[1] == "encode":
    sys.exit(encode(sys.argv[2], sys.argv[3], int(sys.argv[4])))
sys.exit(decode(sys.argv[2], sys.argv[3]))
' "$@"
}

# load_records <plan> <tmpdir> — the one partition encode and local share.
# Reads the plan's matrix rows into MATRIX_ROWS and PLAN_ROW_ALL_CMDS
# (row_runs_in_ci reads the whole row set to tell whether another row reads
# a /tmp file a CI row writes; _tmp_write_scrub in plan-matrix-rows.sh),
# parses the mutation records, and splits them: <tmpdir>/records.ci gets
# each record whose check row_runs_in_ci sends to CI, <tmpdir>/records.local
# gets the rest. Return 3 when the plan has no Verification Matrix or parse fails.
load_records() {
    local plan="$1" tmp="$2" rows_rc recs_rc rrow rfile rcheck rmatch rrepl
    MATRIX_ROWS=$(plan_matrix_rows "$plan"); rows_rc=$?
    if [ "$rows_rc" -eq 2 ]; then
        echo "FAIL plan has no Verification Matrix" >&2
        return 3
    fi
    PLAN_ROW_ALL_CMDS="$MATRIX_ROWS"
    "$SELF_DIR/plan-exec-mutations" parse "$plan" > "$tmp/records.nul"; recs_rc=$?
    if [ "$recs_rc" -ne 0 ]; then
        echo "FAIL plan-exec-mutations parse exited $recs_rc: $(head -1 "$tmp/records.nul" | tr '\0' ' ')" >&2
        return 3
    fi
    : > "$tmp/records.ci"
    : > "$tmp/records.local"
    while IFS= read -r -d '' rrow <&3 \
        && IFS= read -r -d '' rfile <&3 && IFS= read -r -d '' rcheck <&3 \
        && IFS= read -r -d '' rmatch <&3 && IFS= read -r rrepl <&3; do
        if row_runs_in_ci "$rcheck"; then
            printf '%s\0%s\0%s\0%s\0%s\n' "$rrow" "$rfile" "$rcheck" "$rmatch" "$rrepl" >> "$tmp/records.ci"
        else
            printf '%s\0%s\0%s\0%s\0%s\n' "$rrow" "$rfile" "$rcheck" "$rmatch" "$rrepl" >> "$tmp/records.local"
        fi
    done 3< "$tmp/records.nul"
    return 0
}

do_encode() {
    local plan="$1" num cmd tmp prev dup
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/plan-checks.XXXXXX") || return 3
    if ! load_records "$plan" "$tmp"; then
        rm -rf "$tmp"
        return 3
    fi
    : > "$tmp/rows.tsv"
    local seen=()
    while IFS=$'\t' read -r num cmd; do
        [ -n "$num" ] || continue
        row_runs_in_ci "$cmd" || continue
        dup=0
        for prev in ${seen[@]+"${seen[@]}"}; do
            if [ "$prev" = "$cmd" ]; then dup=1; break; fi
        done
        [ "$dup" -eq 0 ] || continue
        seen+=("$cmd")
        printf '%s\t%s\n' "$num" "$cmd" >> "$tmp/rows.tsv"
    done <<< "$MATRIX_ROWS"
    codec encode "$tmp/rows.tsv" "$tmp/records.ci" "$CAP"; rc=$?
    rm -rf "$tmp"
    return "$rc"
}

# do_local <plan> — print the records encode leaves out (load_records).
do_local() {
    local tmp
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/plan-checks.XXXXXX") || return 3
    if ! load_records "$1" "$tmp"; then
        rm -rf "$tmp"
        return 3
    fi
    cat "$tmp/records.local"
    rm -rf "$tmp"
    return 0
}

# ci_stacks_ready <what> <needs tokens> — the readiness guard. Each db, web,
# bun or go token needs IBL_CI_DB_READY, IBL_CI_WEB_READY, IBL_CI_BUN_READY or
# IBL_CI_GO_READY set to
# exactly 1 by the workflow step that started that stack. Unset or empty fails,
# so a row whose stack the job skipped fails red instead of passing by luck.
# (The names avoid the PLAN substring, which PLAN_ROW_LOCAL_RE matches.)
ci_stacks_ready() {
    local what="$1" tok var val
    for tok in $2; do
        case "$tok" in
            db) var=IBL_CI_DB_READY ;;
            web) var=IBL_CI_WEB_READY ;;
            bun) var=IBL_CI_BUN_READY ;;
            go) var=IBL_CI_GO_READY ;;
            *) continue ;;
        esac
        val="${!var:-}"
        if [ "$val" != 1 ]; then
            echo "FAIL $what needs $tok but the job did not start it ($var is not 1)"
            return 1
        fi
    done
    return 0
}

# do_needs <body-file> — print db=, web=, bun=, actionlint=, go= (0 or 1), the union
# of row_ci_needs over the block's rows and mutation check fields. An absent
# or corrupt block prints five =0 lines and exits 0: the ci step reports the
# real failure, and a corrupt block must not start containers.
do_needs() {
    local body="$1" tmp db=0 web=0 bun=0 al=0 gon=0 n c tok
    local rrow rfile rcheck rmatch rrepl
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/plan-checks.XXXXXX") || return 1
    if codec decode "$body" "$tmp" >/dev/null 2>&1; then
        while IFS=$'\t' read -r n c; do
            [ -n "$n" ] || continue
            for tok in $(row_ci_needs "$c"); do
                case "$tok" in db) db=1 ;; web) web=1 ;; bun) bun=1 ;; actionlint) al=1 ;; go) gon=1 ;; esac
            done
        done < "$tmp/rows.tsv"
        while IFS= read -r -d '' rrow <&3 \
            && IFS= read -r -d '' rfile <&3 && IFS= read -r -d '' rcheck <&3 \
            && IFS= read -r -d '' rmatch <&3 && IFS= read -r rrepl <&3; do
            for tok in $(row_ci_needs "$rcheck"); do
                case "$tok" in db) db=1 ;; web) web=1 ;; bun) bun=1 ;; actionlint) al=1 ;; go) gon=1 ;; esac
            done
        done 3< "$tmp/records.nul"
    fi
    rm -rf "$tmp"
    printf 'db=%s\nweb=%s\nbun=%s\nactionlint=%s\ngo=%s\n' "$db" "$web" "$bun" "$al" "$gon"
    return 0
}

do_ci() {
    local body="$1" labels="$2" out drc reason labelled=0 nrows=0 nmut=0 num cmd log rc root
    grep -qxF 'plan-checks' "$labels" && labelled=1
    out=$(mktemp -d "${TMPDIR:-/tmp}/plan-checks.XXXXXX") || return 1
    reason=$(codec decode "$body" "$out"); drc=$?
    if [ "$drc" -eq 4 ]; then
        rm -rf "$out"
        if [ "$labelled" -eq 1 ]; then
            echo "FAIL plan-driven PR (label plan-checks) has no plan-checks block in its body"
            return 1
        fi
        echo "PASS no plan-checks block and no plan-checks label: ad-hoc PR, nothing to run"
        return 0
    fi
    if [ "$drc" -ne 0 ]; then
        rm -rf "$out"
        echo "FAIL plan-checks block is corrupt: ${reason:-decode exited $drc}"
        return 1
    fi
    root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "FAIL plan-checks ci must run inside the repo"; rm -rf "$out"; return 1; }
    cd "$root" || { rm -rf "$out"; return 1; }
    # COMPOSE_FILE resolves against each row's cwd, so a row that starts with
    # `cd ibl5 &&` would miss a relative path. Pin it to an absolute path.
    if [ -n "${COMPOSE_FILE:-}" ]; then
        case "$COMPOSE_FILE" in /*) ;; *) COMPOSE_FILE="$root/$COMPOSE_FILE" ;; esac
        export COMPOSE_FILE
    fi
    # Host rewrite before any row runs: the row commands and only the check
    # field of each mutation record. match:/replace: hold source text and
    # stay byte-exact. A miss leaves the original host and the row fails red.
    : > "$out/rows.ci.tsv"
    while IFS=$'\t' read -r num cmd; do
        [ -n "$num" ] || continue
        printf '%s\t%s\n' "$num" "$(ci_row_rewrite "$cmd")" >> "$out/rows.ci.tsv"
    done < "$out/rows.tsv"
    : > "$out/records.ci.nul"
    local rrow rfile rcheck rmatch rrepl allchecks=""
    while IFS= read -r -d '' rrow <&3 \
        && IFS= read -r -d '' rfile <&3 && IFS= read -r -d '' rcheck <&3 \
        && IFS= read -r -d '' rmatch <&3 && IFS= read -r rrepl <&3; do
        rcheck=$(ci_row_rewrite "$rcheck")
        allchecks="$allchecks $(row_ci_needs "$rcheck")"
        printf '%s\0%s\0%s\0%s\0%s\n' "$rrow" "$rfile" "$rcheck" "$rmatch" "$rrepl" >> "$out/records.ci.nul"
    done 3< "$out/records.nul"
    log="$out/row.log"
    local needs compose_php="$PLAN_ROW_COMPOSE_PHP"
    while IFS=$'\t' read -r num cmd; do
        [ -n "$num" ] || continue
        nrows=$((nrows + 1))
        needs=$(row_ci_needs "$cmd")
        echo "plan-checks: matrix row $num [needs: ${needs:-none}]: $cmd"
        if ! ci_stacks_ready "matrix row $num" "$needs"; then rm -rf "$out"; return 1; fi
        timeout 900 bash -c "$cmd" </dev/null > "$log" 2>&1; rc=$?
        if [ "$rc" -ne 0 ]; then
            echo "FAIL matrix row $num exited $rc: $cmd"
            tail -n 30 "$log"
            rm -rf "$out"
            return 1
        fi
        if [[ "$cmd" == *"$compose_php"* ]]; then
            # The container runs as root; hand its new files back to the
            # runner user so later git-based rows do not trip on them.
            if ! docker compose exec -T php find /var/www/html/ibl5 -xdev -user 0 -not -path '*/vendor/*' \
                -exec chown "$(id -u):$(id -g)" {} + </dev/null >> "$log" 2>&1; then
                echo "FAIL chown after matrix row $num"
                tail -n 30 "$log"
                rm -rf "$out"
                return 1
            fi
        fi
    done < "$out/rows.ci.tsv"
    if [ -s "$out/records.ci.nul" ]; then
        if ! ci_stacks_ready "mutation rows" "$allchecks"; then rm -rf "$out"; return 1; fi
        # Count newline-terminated records. GNU grep treats the NUL field
        # separators as line ends and overcounts, so use wc -l.
        nmut=$(( $(wc -l < "$out/records.ci.nul") ))
        bin/lib/plan-exec-mutations recover; rc=$?
        if [ "$rc" -ne 0 ]; then
            echo "FAIL plan-checks mutation recover exited $rc"
            rm -rf "$out"
            return 1
        fi
        bin/lib/plan-exec-mutations run --records "$out/records.ci.nul" --timeout 30 --max-timeout 300 --scale 2 --budget 1800; rc=$?
        if [ "$rc" -ne 0 ]; then
            echo "FAIL plan-checks mutation run exited $rc"
            rm -rf "$out"
            return 1
        fi
    fi
    rm -rf "$out"
    echo "PASS plan-checks: $nrows rows, $nmut mutation rows TRIPPED"
    return 0
}

MODE="${1:-}"
[ $# -gt 0 ] && shift
case "$MODE" in
    encode)
        [ $# -eq 1 ] && [ -r "$1" ] || usage
        do_encode "$1"; exit $?
        ;;
    decode)
        [ $# -eq 2 ] && [ -r "$1" ] && [ -d "$2" ] || usage
        codec decode "$1" "$2"; exit $?
        ;;
    needs)
        BODY=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --body-file) [ $# -ge 2 ] || usage; BODY="$2"; shift 2 ;;
                *) echo "plan-checks-block: unknown argument '$1'" >&2; usage ;;
            esac
        done
        [ -n "$BODY" ] && [ -r "$BODY" ] || usage
        do_needs "$BODY"; exit $?
        ;;
    ci)
        BODY="" LABELS=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --body-file) [ $# -ge 2 ] || usage; BODY="$2"; shift 2 ;;
                --labels-file) [ $# -ge 2 ] || usage; LABELS="$2"; shift 2 ;;
                *) echo "plan-checks-block: unknown argument '$1'" >&2; usage ;;
            esac
        done
        [ -n "$BODY" ] && [ -r "$BODY" ] && [ -n "$LABELS" ] && [ -r "$LABELS" ] || usage
        do_ci "$BODY" "$LABELS"; exit $?
        ;;
    local)
        [ "$#" -eq 1 ] || usage  # local takes one plan path
        [ -r "$1" ] || usage  # local: unreadable plan or a flag
        do_local "$1"; exit $?
        ;;
    *) usage ;;
esac
