#!/usr/bin/env bash
# Local runner for the per-PR Infection job (.github/workflows/mutation-pr.yml).
# Runs the coverage step and the Infection step on the host, from ibl5/, with
# CI's flags. diff.relative stays unset; see the comment above the Infection call.
#
# Usage: bin/mutation-diff [--force] [<base-ref>]

set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
Usage: bin/mutation-diff [--force] [<base-ref>]

Run the per-PR mutation gate locally. Runs the coverage and Infection steps
of .github/workflows/mutation-pr.yml with the same flags, against the diff
from <base-ref> (default: origin/master) to the working tree. Unlike CI, it
leaves diff.relative unset: with it set, Infection finds no changed file.

When Infection matches no source file although the diff adds lines to
classes/**/*.php files, the run exits 5, so an empty run never reads as a pass.

Runs on the host, from the invoking checkout's ibl5/. The host needs php with
pcov, and the main-stack ibl5-mariadb container running. Tests use the
sibling database ibl5_test on that container, reset by
bin/db-test-up --no-run from this checkout's migrations and db-seed.sql.

Skips (exit 0) when the diff has no added or modified classes/**/*.php
files, as CI does. Also skips (exit 0) when the changed class files only
lose lines, since Infection has no added line to mutate. Untracked new
classes are marked intent-to-add so Infection sees them.

Runs only after CI's required check "Infection PHP (per-PR diff)" has
failed on the open PR for the current branch. CI scores every PR; this
runner is for fixing the mutants that check reported. It refuses (exit 6)
when:
  - HEAD is detached
  - gh is missing (GH_BIN overrides the gh path) or a gh call fails
  - the branch has no open PR, or more than one
  - the PR head has no run of that check
  - the newest run is queued, in progress, or concluded anything other
    than failure (success, skipped, cancelled, neutral, timed_out,
    action_required)
--force skips this check (humans only). With CLAUDE_HEADLESS set to any
non-empty value, --force exits 2.

A lock at /tmp/ibl5-mutation-diff.lock keeps two runs from sharing
ibl5_test. Override the path with MUTATION_DIFF_LOCK_DIR.

Exit codes:
  0  passed, or skipped (no changed classes, or class lines only deleted)
  2  usage error, or <base-ref> does not resolve
  3  prerequisite missing: pcov, docker, ibl5-mariadb, or bin/db-test-up failed
  4  lock held by another run
  5  Infection matched no source files although the diff adds classes/**/*.php lines
  6  refused: CI's Infection check has not failed on this branch's PR (see --force)
  other  the phpunit or Infection exit code, passed through
EOF
    exit 0
fi

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=bin/lib/db-helpers.sh
source "$REPO_ROOT/bin/lib/db-helpers.sh"
source "$REPO_ROOT/bin/lib/claim-file.sh"

BASE=""
NPOS=0
FORCE=0
for arg in "$@"; do
    case "$arg" in
        --force) FORCE=1 ;;
        -*)
            echo "Error: unknown option: $arg" >&2
            exit 2
            ;;
        *)
            NPOS=$((NPOS + 1))
            if [ "$NPOS" -gt 1 ]; then
                echo "Error: expected at most one <base-ref>" >&2
                exit 2
            fi
            BASE="$arg"
            ;;
    esac
done
BASE="${BASE:-origin/master}"
if [ "$FORCE" = 1 ] && [ -n "${CLAUDE_HEADLESS:-}" ]; then
    echo "Error: --force is for humans; CLAUDE_HEADLESS is set, so this run cannot skip the CI-state check. Push and let CI's \"Infection PHP (per-PR diff)\" check score the PR." >&2
    exit 2
fi

cd "$REPO_ROOT/ibl5"
if ! git rev-parse --verify --quiet "$BASE^{commit}" >/dev/null; then
    echo "Error: base ref '$BASE' does not resolve to a commit. Fix: git fetch origin, or pass an existing ref." >&2
    exit 2
fi

# Infection's --git-diff-* reads `git diff`, which cannot see untracked files.
UNTRACKED="$(git ls-files --others --exclude-standard -- 'classes/**/*.php')"
if [ -n "$UNTRACKED" ]; then
    NUNTRACKED=0
    while IFS= read -r f; do
        git add --intent-to-add -- "$f"
        NUNTRACKED=$((NUNTRACKED + 1))
    done <<EOF
$UNTRACKED
EOF
    echo "Notice: marked $NUNTRACKED untracked class file(s) intent-to-add so Infection sees them."
fi

# Mirrors CI's skip=true. Diffing the merge-base against the working tree also
# counts uncommitted work, which is what an implementation session has.
MB="$(git merge-base "$BASE" HEAD)"
CHANGED="$(git diff --name-only --diff-filter=AM "$MB" -- 'classes/**/*.php')"
if [ -z "$CHANGED" ]; then
    echo "SKIP: no added or modified classes/**/*.php files vs $BASE; CI skips the mutation job for this diff too."
    exit 0
fi

# Deletion-only skip: when no changed class gains a line, Infection's
# --git-diff-lines filter has nothing to mutate, and the empty-filter guard
# below would exit 5 on a correct diff. The sum is per diff, so one class with
# an added line keeps the run going. numstat prints "-" for a binary file;
# count it as added so the run fails closed.
NUMSTAT="$(git diff --numstat --diff-filter=AM "$MB" -- 'classes/**/*.php')" || {
    echo "Error: git diff --numstat failed against the merge-base of '$BASE'." >&2
    exit 2
}
ADDED="$(awk -F'\t' '$1 == "-" { n++; next } { n += $1 } END { print n + 0 }' <<<"$NUMSTAT")"
if [ "$ADDED" -eq 0 ]; then
    echo "SKIP: the diff vs $BASE only deletes lines from classes/**/*.php files, so nothing is mutable."
    exit 0
fi

# CI-state gate: CI's required check scores every PR, and a local run exists
# only to fix mutants that check already reported. Sits after the SKIP exits
# (nothing to mutate needs no gh call) and before pcov, docker and the lock.
CHECK_NAME='Infection PHP (per-PR diff)'
refuse_ci() {
    echo "Refused: $1." >&2
    echo "CI's required check \"$CHECK_NAME\" scores mutation testing on every PR; bin/mutation-diff works only after that check has failed on this branch's open PR." >&2
    echo "Fix: push and let CI score the PR. If CI's check fails, fix the mutants it reports, then rerun bin/mutation-diff. A human can override with bin/mutation-diff --force [<base-ref>]." >&2
    exit 6
}
if [ "$FORCE" = 1 ]; then
    echo "WARN: --force skips the CI-state check; CI's \"$CHECK_NAME\" check still scores this PR." >&2
else
    : "${GH_BIN:=gh}"
    command -v "$GH_BIN" >/dev/null 2>&1 || refuse_ci "gh is not installed or not on PATH (GH_BIN=$GH_BIN)"
    BRANCH="$(git symbolic-ref --quiet --short HEAD)" || refuse_ci "HEAD is detached, so no branch names a PR"
    PRS="$("$GH_BIN" pr list --head "$BRANCH" --state open --json number,headRefOid \
        --jq '.[] | "\(.number) \(.headRefOid)"' 2>/dev/null)" \
        || refuse_ci "gh could not list PRs for branch $BRANCH (not authenticated, or offline)"
    NPRS="$(printf '%s\n' "$PRS" | grep -c '[^[:space:]]' || true)"
    [ "$NPRS" -ge 1 ] || refuse_ci "branch $BRANCH has no open PR"
    [ "$NPRS" -eq 1 ] || refuse_ci "branch $BRANCH has $NPRS open PRs; expected exactly one"
    PR_NUM="${PRS%% *}"
    PR_SHA="${PRS#* }"
    RUN="$("$GH_BIN" api --method GET "repos/{owner}/{repo}/commits/$PR_SHA/check-runs" \
        -f check_name="$CHECK_NAME" -f per_page=100 \
        --jq '.check_runs | sort_by(.id) | last | if . == null then "" else "\(.status) \(.conclusion // "none")" end' 2>/dev/null)" \
        || refuse_ci "gh could not read check runs for PR #$PR_NUM head $PR_SHA"
    case "$RUN" in
        "completed failure")
            echo "CI's \"$CHECK_NAME\" check failed on PR #$PR_NUM; continuing so you can fix the reported mutants." >&2 ;;
        "") refuse_ci "PR #$PR_NUM head $PR_SHA has no \"$CHECK_NAME\" check run yet" ;;
        *) refuse_ci "\"$CHECK_NAME\" reports \"$RUN\" on PR #$PR_NUM" ;;
    esac
fi

mods=""
if command -v php >/dev/null 2>&1; then
    mods="$(php -m)"
fi
if ! grep -qx pcov <<<"$mods"; then
    echo "Error: host php has no pcov extension; CI's coverage step needs it. Fix: pecl install pcov" >&2
    exit 3
fi

if ! command -v docker >/dev/null 2>&1; then
    echo "Error: docker not found on PATH." >&2
    exit 3
fi
if ! state="$(docker inspect -f '{{.State.Running}}' ibl5-mariadb 2>&1)" || [ "$state" != "true" ]; then
    echo "Error: main-stack DB container ibl5-mariadb is not running (127.0.0.1:3306 is where DatabaseTestCase connects). Fix: run docker compose up -d in the main checkout, then re-run." >&2
    exit 3
fi

# md_lock_stale <lockdir>: rc 0 when the lock's pid file names a dead process.
md_lock_stale() { local p; p=$(cat "$1/pid" 2>/dev/null) || p=""; [ -n "$p" ] && ! kill -0 "$p" 2>/dev/null; }

LOCK_DIR="${MUTATION_DIFF_LOCK_DIR:-/tmp/ibl5-mutation-diff.lock}"
LOCK_HELD=0
trap 'if [ -n "${INFECTION_LOG:-}" ]; then rm -f "$INFECTION_LOG"; fi; if [ "${LOCK_HELD:-0}" = 1 ]; then rm -rf "$LOCK_DIR"; fi' EXIT
if mkdir "$LOCK_DIR" 2>/dev/null && claim_file "$LOCK_DIR/pid" printf '%s\n' "$$"; then
    LOCK_HELD=1
else
    pid=""
    if [ -f "$LOCK_DIR/pid" ]; then
        pid="$(cat "$LOCK_DIR/pid")"
    fi
    if [ -z "$pid" ]; then
        echo "Error: $LOCK_DIR exists with no pid file. If no run is active, remove it with rm -rf $LOCK_DIR." >&2
        exit 4
    fi
    if kill -0 "$pid" 2>/dev/null; then
        echo "Error: another bin/mutation-diff run holds $LOCK_DIR (pid $pid). Re-run after it finishes." >&2
        exit 4
    fi
    echo "Notice: reclaiming stale lock $LOCK_DIR (pid $pid is not running)."
    if ! claim_reclaim "$LOCK_DIR" pid md_lock_stale printf '%s\n' "$$"; then
        echo "Error: could not take $LOCK_DIR after reclaiming it." >&2
        exit 4
    fi
    LOCK_HELD=1
fi

rc=0
"$REPO_ROOT/bin/db-test-up" --no-run || rc=$?
if [ "$rc" -ne 0 ]; then
    echo "Error: bin/db-test-up --no-run failed (exit $rc); see its output above." >&2
    exit 3
fi

export DB_HOST=127.0.0.1 DB_USER="$DB_ROOT_USER" DB_PASS="$DB_ROOT_PASS" DB_NAME=ibl5_test
mkdir -p coverage
rc=0
vendor/bin/phpunit \
    --configuration=phpunit-mutation.xml \
    --coverage-clover coverage/clover.xml \
    --coverage-xml coverage/coverage-xml \
    --log-junit coverage/junit.xml \
    --no-progress || rc=$?
if [ "$rc" -ne 0 ]; then
    echo "Error: coverage run failed; Infection needs a green suite." >&2
    exit "$rc"
fi

# Infection joins each `git diff --name-only` path to `git rev-parse
# --show-toplevel`, the repo root. CI's `git config diff.relative true` makes
# git print paths relative to ibl5/ (classes/X.php), so the join names a file
# that does not exist, and Infection reports "No source file found" and exits
# 0. Leaving diff.relative unset keeps the paths repo-root-relative
# (the ibl5/ prefix stays on), which the join resolves in the main checkout
# and in a worktree alike.
INFECTION_LOG="$(mktemp "${TMPDIR:-/tmp}/mutation-diff-infection.XXXXXX")"
set +e
vendor/bin/infection \
    --configuration=infection.json5 \
    --coverage=coverage \
    --git-diff-base="$BASE" \
    --git-diff-lines \
    --map-source-class-to-test \
    --only-covering-test-cases \
    --skip-initial-tests \
    --show-mutations \
    --no-progress \
    --min-msi=100 \
    --ignore-msi-with-no-mutations 2>&1 | tee "$INFECTION_LOG"
rc=${PIPESTATUS[0]}
set -e

# Infection exits 0 when its git filter matches nothing. Here CHANGED is
# non-empty and at least one changed class gains a line (both skips above exit
# otherwise), so an empty filter means no class in this diff was mutated.
# Report that as a failure, never as a pass.
if [ "$rc" -eq 0 ] && grep -qE 'No source file found|Could not find any modified (files|lines)' "$INFECTION_LOG"; then
    {
        echo "Error: Infection matched no source files, but the diff changes these classes:"
        while IFS= read -r f; do
            echo "  $f"
        done <<<"$CHANGED"
        echo "No mutant ran, so this run proves nothing."
        echo "If every class listed is in source.excludes in ibl5/infection.json5, nothing here is mutable and exit 5 is expected."
        echo "Otherwise Infection's git filter missed them. Check that git config --get diff.relative prints nothing."
    } >&2
    exit 5
fi
exit "$rc"
