assert_match  "S1 status fetched per_page=100" 'commits/0+70/status\?per_page=100' "$(cat "$FIX/calls.log")"
assert_status "S1 exit 0"                 0           "$ST"

# Real combined-status payload, captured 2026-10-25 with:
#   gh api 'repos/a-jay85/IBL5/commits/<sha>/status?per_page=100' \
#     | jq -c 'del(.repository) | .statuses |= map(del(.creator))'
# Only the repository and creator blocks are elided. Replay fixture for the live-service
# boundary: proves the parser reads GitHub's real field names, not a hand-written shape.
REAL_STATUS_JSON="$(cat <<'JSON'
{"state":"success","statuses":[{"url":"https://api.github.com/repos/a-jay85/IBL5/statuses/202002002cd3ddd9a9b0a2d29024cbf83e7269a0","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","id":57186147701,"node_id":"SC_kwDODhWJRc8AAAANUI9ddQ","state":"success","description":"PASS: 29 check-run(s) settled green on 202002002cd3ddd9a9b0a2d29024cbf83e7269a0 (anchors settled: Tests and Analysis, E2E Tests, Meta checks","target_url":"https://github.com/a-jay85/IBL5/actions/runs/40152590911","context":"All checks settled","created_at":"2026-10-25T02:02:43Z","updated_at":"2026-10-25T02:02:43Z"}],"sha":"202002002cd3ddd9a9b0a2d29024cbf83e7269a0","total_count":1,"commit_url":"https://api.github.com/repos/a-jay85/IBL5/commits/202002002cd3ddd9a9b0a2d29024cbf83e7269a0","url":"https://api.github.com/repos/a-jay85/IBL5/commits/202002002cd3ddd9a9b0a2d29024cbf83e7269a0/status"}
JSON
)"

# --- S2: REAL payload + all check-runs green, under --arm -> ARMABLE and ARMED ---
FIX="$(mktemp -d -p "$TMP")"
protection_json "${PROT_REQ[@]}" > "$FIX/protection.json"
checks_json success success success > "$FIX/checks-$(printf '%040d' 71).json"
printf '%s\n' "$REAL_STATUS_JSON" > "$FIX/status-$(printf '%040d' 71).json"
pr_json 71 BLOCKED "$BODY_CLEAR" | jq -s . > "$FIX/prs.json"
