#!/usr/bin/env bash
# One-time setup for the automouse morning-digest cron (launchd LaunchAgent).
#
# Installs a Mac-local launchd LaunchAgent (com.ibl5.automouse-morning-digest)
# that fires bin/automouse/morning-digest once daily at 07:00 local time via
# StartCalendarInterval — host-durable, calendar-scheduled.  The plist
# ProgramArguments / WorkingDirectory point at the durable MAIN checkout
# (never a worktree, which gets torn down after its PR merges).
#
# This script prints no secrets and needs no masking: DISCORD_DM_TO (optional)
# is embedded only when set and is not a secret, and HOME is required but is
# not sensitive. No DB passwords or API keys are involved.
#
# Usage:
#   bin/automouse/morning-digest-cron-setup --print-schedule      # emit the plist to stdout (no side effect)
#   bin/automouse/morning-digest-cron-setup --install-schedule    # install + load the LaunchAgent
#   bin/automouse/morning-digest-cron-setup --uninstall-schedule  # unload + remove the LaunchAgent
#
# Install AFTER this lands on master — the launchd ProgramArguments point at the
# main checkout's bin/automouse/morning-digest, which must exist there.
#
# Environment variables read at generation time:
#   HOME            (required) — interpolated into EnvironmentVariables PATH at generation time
#   DISCORD_DM_TO   (optional) — embedded in the plist EnvironmentVariables when set; omitted otherwise

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
ACTION=""

while [ $# -gt 0 ]; do
  case "$1" in
    --install-schedule)   ACTION="install";   shift ;;
    --uninstall-schedule) ACTION="uninstall"; shift ;;
    --print-schedule)     ACTION="print";     shift ;;
    -h|--help) awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; exit 0 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

[ -n "$ACTION" ] || { echo "No action given. See --help." >&2; exit 1; }

# --- Durable MAIN-checkout derivation -----------------------------------------
# ProgramArguments/WorkingDirectory MUST point at the main checkout, never this
# worktree (a worktree gets torn down — the LaunchAgent would then point at a
# dead path). The first `git worktree list` entry is the main working tree.
# Split across two statements deliberately. Folding the substitution into a
# `${MAIN_WT:-$(...)}` default makes the fallback below DEAD CODE: outside a git
# tree `git worktree list` exits 128, pipefail propagates that to the pipeline,
# the assignment fails, and `set -e` aborts before the `||` on the next line can
# run. `|| true` inside the substitution keeps the status zero so we reach it.
if [ -z "${MAIN_WT:-}" ]; then
  MAIN_WT="$(git -C "$REPO_ROOT" worktree list --porcelain 2>/dev/null | awk '/^worktree / {print $2; exit}' || true)"
fi
[ -n "$MAIN_WT" ] || MAIN_WT="$REPO_ROOT"   # fallback: not in a git tree

PLIST_LABEL="com.ibl5.automouse-morning-digest"
PLIST_PATH="$HOME/Library/LaunchAgents/${PLIST_LABEL}.plist"
PROGRAM="$MAIN_WT/bin/automouse/morning-digest"

# Single source of truth for the plist — used by both --print-schedule and
# --install-schedule, so the MAIN-checkout derivation is exercised by tests.
build_plist() {
  # Build optional DISCORD_DM_TO block — emit only when the var is set and non-empty.
  local discord_block=""
  if [ -n "${DISCORD_DM_TO:-}" ]; then
    discord_block="		<key>DISCORD_DM_TO</key>
		<string>${DISCORD_DM_TO:-}</string>"
  fi

  cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>${PLIST_LABEL}</string>
	<key>ProgramArguments</key>
	<array>
		<string>${PROGRAM}</string>
	</array>
	<key>WorkingDirectory</key>
	<string>${MAIN_WT}</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- launchd agents start with a minimal PATH that omits Homebrew; discord-dm and git
		     must resolve. The repo bin/ dir is prepended so morning-digest can reach its
		     sibling tools. The Claude Code native installer puts the claude binary under
		     .local/bin — omitting it causes rc=127 inside launchd. HOME interpolates at
		     generation time; launchd does NOT expand environment variable references, so any
		     unexpanded reference would bake in a dead path for every invocation. -->
		<key>PATH</key>
		<string>${MAIN_WT}/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${HOME}/.local/bin</string>
${discord_block}
	</dict>
	<key>StandardOutPath</key>
	<string>${MAIN_WT}/../automouse-digest.log</string>
	<key>StandardErrorPath</key>
	<string>${MAIN_WT}/../automouse-digest-err.log</string>
</dict>
</plist>
PLIST
}

case "$ACTION" in
  print)
    build_plist
    ;;
  install)
    # Refusal 1: must be run from the main checkout — worktrees are torn down after
    # their PR merges; a plist pointing into one silently stops working.
    if [ "$REPO_ROOT" != "$MAIN_WT" ]; then
      echo "Error: --install-schedule must be run from the main checkout (${MAIN_WT})." >&2
      echo "Current location: ${REPO_ROOT}" >&2
      echo "cd to ${MAIN_WT} and re-run." >&2
      exit 1
    fi
    # Refusal 2: HOME must be set — it is interpolated into the PATH at generation
    # time; a missing HOME would silently bake an empty PATH component.
    if [ -z "${HOME:-}" ]; then
      echo "Error: HOME is unset — cannot generate a valid plist (HOME is interpolated into PATH)." >&2
      exit 1
    fi
    mkdir -p "$HOME/Library/LaunchAgents"
    launchctl bootout "gui/$(id -u)/${PLIST_LABEL}" 2>/dev/null || true  # idempotent: ignore "not loaded"
    build_plist > "$PLIST_PATH"
    launchctl bootstrap "gui/$(id -u)" "$PLIST_PATH"
    echo "Installed ${PLIST_LABEL} (StartCalendarInterval Hour=7 Minute=0). Program: $PROGRAM"
    ;;
  uninstall)
    launchctl bootout "gui/$(id -u)/${PLIST_LABEL}" 2>/dev/null || true  # idempotent
    rm -f "$PLIST_PATH"                                                    # idempotent: no error if absent
    echo "Uninstalled ${PLIST_LABEL}."
    ;;
esac
