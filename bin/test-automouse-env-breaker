#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-automouse-env-breaker — regression test for the impl environmental-
# failure breaker decision in bin/automouse/run (should_impl_env_stop).
#
# The breaker refunds the attempt and STOPS the loop when a usage/rate limit,
# auth error, or transient kills the impl agent — leaving the queue intact. The
# load-bearing negative (the bug this locks): a LEGITIMATE disposition (already-merged
# → done/, stale-plan/ambiguity/missing-info → skipped/) exits fast with no handoff
# but moves the plan OUT of queue/ (in_queue=0). It must NOT be misread as
# environmental, or one fast skip stops the whole run (this happened 2026-06-20:
# god-class-split-standingsview skipped in 57s → false env-stop → 5 plans stranded).
#
# A bin/wt-new failure is a THIRD shape: the plan stays in queue/ (in_queue=1),
# exits fast, and the agent drops a queue/<plan>.wt-fail sentinel (wt_fail=1).
# It must NOT env-stop (that would refund + halt the loop on every collision);
# it falls through as a counted attempt bounded by MAX_ATTEMPTS.
#
# should_impl_env_stop <handoff> <in_queue> <env_err> <stalled> <fast> [wt_fail]  (each 0/1; wt_fail defaults 0)
#   returns 0 (env-stop) ONLY when: handoff=0 AND in_queue=1 AND wt_fail=0 AND (env_err|stalled|fast)
#
# We extract the predicate from bin/automouse/run rather than copy it, so the test
# can never drift from the implementation. The function is self-contained (it
# reads only its five positional args), so eval'ing its definition is safe and
# does not run the runner's top-level loop.
#
# Run: bin/test-automouse-env-breaker  (exit 0 = all pass, 1 = a case failed)

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
RUNNER="$SCRIPT_DIR/automouse/run"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

if [ ! -f "$RUNNER" ]; then
    echo "FAIL: cannot find $RUNNER"
    exit 1
fi

ok()            { echo "ok: $1"; }
fail()          { echo "FAIL: $1"; FAILED=1; }
assert_eq()     { local d="$1" g="$2" e="$3"
                  if [ "$g" = "$e" ]; then ok "$d"
                  else fail "$d — expected [$e], got [$g]"; fi; }
assert_present(){ local d="$1" p="$2"
                  if [ -e "$p" ] || [ -L "$p" ]; then ok "$d"
                  else fail "$d — missing: $p"; fi; }
assert_absent() { local d="$1" p="$2"
                  if [ -e "$p" ] || [ -L "$p" ]; then fail "$d — unexpected: $p"
                  else ok "$d"; fi; }
want()          { local d="$1" h="$2" n="$3"
                  case "$h" in *"$n"*) ok "$d" ;;
                  *) fail "$d — missing token [$n]"; esac; }
want_absent()   { local d="$1" h="$2" n="$3"
                  case "$h" in *"$n"*) fail "$d — unexpected token [$n]" ;;
                  *) ok "$d"; esac; }

# Extract `should_impl_env_stop() { ... }` (from its definition line to the first
# line that is a lone `}`) and define it in this shell.
FN_SRC="$(awk '
    /^should_impl_env_stop\(\) \{/ { capture = 1 }
    capture { print }
    capture && /^\}/ { exit }
' "$RUNNER")"

if [ -z "$FN_SRC" ]; then
    echo "FAIL: could not extract should_impl_env_stop from $RUNNER"
    exit 1
fi
eval "$FN_SRC"

FAILED=0

# assert <name> <handoff> <in_queue> <env_err> <stalled> <fast> <wt_fail> <expect: stop|continue>
assert() {
    name="$1"; h="$2"; q="$3"; e="$4"; s="$5"; f="$6"; wf="$7"; want="$8"
    if should_impl_env_stop "$h" "$q" "$e" "$s" "$f" "$wf"; then
        got="stop"
    else
        got="continue"
    fi
    if [ "$got" != "$want" ]; then
        echo "FAIL: $name — expected '$want', got '$got' (h=$h q=$q e=$e s=$s f=$f wf=$wf)"
        FAILED=1
    else
        echo "ok: $name ($got)"
    fi
}

# --- The bug: legitimate skips left queue/ (in_queue=0) → NEVER env-stop ---
# A fast skip with no handoff is the exact 2026-06-20 case.
assert "skip-fast"           0 0 0 0 1 0 continue
assert "skip-fast-and-stalled" 0 0 0 1 1 0 continue
assert "skip-with-env-sig"   0 0 1 0 0 0 continue   # even a stray log signature can't stop a deliberate disposition

# --- Genuine environmental kills: no outcome, plan still in queue/ → STOP ---
assert "env-signature"       0 1 1 0 0 0 stop
assert "stall-kill"          0 1 0 1 0 0 stop
assert "sub-minute-exit"     0 1 0 0 1 0 stop
assert "all-signals"         0 1 1 1 1 0 stop

# --- Genuine plan failure: slow, no signature, still queued → NOT env-stop ---
# (falls through to the genuine-failure path: attempt kept, eventual poison-pill)
assert "slow-failure"        0 1 0 0 0 0 continue

# --- Success: handoff written → never env-stop, regardless of other signals ---
assert "handoff-success"     1 1 0 0 0 0 continue
assert "handoff-despite-fast" 1 1 0 0 1 0 continue
assert "handoff-despite-env" 1 1 1 1 1 0 continue

# --- wt-new failure: plan STAYS in queue/, sentinel present → counted attempt, NEVER env-stop ---
assert "wt-fail-fast"             0 1 0 0 1 1 continue   # the exact post-fix shape (Phase 1b printed stop for this without wf)
assert "wt-fail-with-env-sig"     0 1 1 0 1 1 continue   # sentinel is authoritative over a stray log signature
assert "wt-fail-stalled"          0 1 0 1 0 1 continue
assert "wt-fail-but-handoff"      1 1 0 0 0 1 continue
# Control: same shape WITHOUT the sentinel is still a genuine env-stop (guard is scoped to wt_fail only)
assert "no-wt-fail-fast-control"  0 1 0 0 1 0 stop

# --- Backward compatibility: a five-arg call defaults wt_fail=0 ---
if should_impl_env_stop 0 1 0 0 1; then got="stop"; else got="continue"; fi
if [ "$got" != "stop" ]; then
    echo "FAIL: five-arg-default — expected 'stop', got '$got' (wt_fail default must be 0)"
    FAILED=1
else
    echo "ok: five-arg-default ($got)"
fi

# --- Contract: prompt-impl and run agree on the sentinel, and wt-new failure no longer skips ---
PROMPT="$SCRIPT_DIR/automouse/prompt-impl"
if grep -qF 'touch "$NIGHTLY_DIR/queue/$PLAN_FILE.wt-fail"' "$PROMPT"; then
    echo "ok: contract-prompt-writes-sentinel"
else
    echo "FAIL: contract-prompt-writes-sentinel — prompt-impl no longer tells the agent to touch queue/\$PLAN_FILE.wt-fail"; FAILED=1
fi
if grep -qF 'WT_FAIL_FILE="$QUEUE_DIR/${PLAN_NAME}.wt-fail"' "$RUNNER"; then
    echo "ok: contract-runner-reads-sentinel"
else
    echo "FAIL: contract-runner-reads-sentinel — run no longer reads queue/\${PLAN_NAME}.wt-fail"; FAILED=1
fi
if grep -E 'If bin/wt-new fails' "$PROMPT" | grep -q 'skipped/'; then
    echo "FAIL: contract-no-skip-on-wt-fail — prompt-impl's wt-new failure line still moves the plan to skipped/"; FAILED=1
else
    echo "ok: contract-no-skip-on-wt-fail"
fi

# ── Section 2: run-loop wt-fail cases (macOS-only — requires caffeinate) ─────

if [ "$(uname)" != "Darwin" ]; then
    echo ""
    echo "# Section 2: skipping macOS-only run-loop cases (uname=$(uname))"
    echo "SKIP: run-loop cases skipped on non-Darwin"
    echo ""
    echo "# Results: $FAILED failed"
    exit "$FAILED"
fi

echo ""
echo "# Section 2: run-loop wt-fail cases (macOS-only)"

# ── Runner isolation recipe (from bin/test-automouse-depends-on §4.1) ─────────
E2_ROOT="$TMP/e2"
E2_NDIR="$E2_ROOT/automouse"
E2_PLANS="$E2_ROOT/plans"
E2_STUB="$E2_ROOT/stub"
mkdir -p "$E2_NDIR/queue" "$E2_NDIR/handoff" "$E2_NDIR/logs" \
         "$E2_NDIR/reports" "$E2_NDIR/done" "$E2_NDIR/skipped" \
         "$E2_PLANS" "$E2_STUB"

# Symlink prompt files so the runner cat succeeds under set -e
ln -sf "$REPO_ROOT/bin/automouse/prompt-impl"    "$E2_ROOT/prompt-impl"
ln -sf "$REPO_ROOT/bin/automouse/prompt-postplan" "$E2_ROOT/prompt-postplan"
# The runner also sources $SELF_DIR/lib-queue-order (queue_entries_ordered).
ln -sf "$REPO_ROOT/bin/automouse/lib-queue-order" "$E2_ROOT/lib-queue-order"

# Rewritten runner: NIGHTLY_DIR→temp, REPO→worktree root, PATH→stub first
E2_RUNNER="$E2_ROOT/run"
sed \
    -e "s#^NIGHTLY_DIR=.*#NIGHTLY_DIR=\"$E2_NDIR\"#" \
    -e "s#^REPO=.*#REPO=\"$REPO_ROOT\"#" \
    -e "s#^export PATH=.*#export PATH=\"$E2_STUB:/usr/local/bin:/opt/homebrew/bin:\$PATH\"#" \
    "$REPO_ROOT/bin/automouse/run" > "$E2_RUNNER"
chmod +x "$E2_RUNNER"

E2_TRACE="$E2_ROOT/trace"
: > "$E2_TRACE"

# Usage gate (ADR-0143): the runner asks the gate before every impl. Use a private state
# dir and a `security` shim that finds no token, so no case reads the real keychain, cache
# or markers; no usage data fails open.
GATE_LIB="$REPO_ROOT/bin/lib/usage-gate.sh"
E2_GATE="$E2_ROOT/gate"
export IBL5_USAGE_GATE_STATE_DIR="$E2_GATE"
mkdir -p "$E2_GATE"
# usage_session_started seam: an empty projects dir means every session looks "not started".
# Tests that need a transcript create a file under this dir before the --resume-paused call.
E2_PROJECTS="$E2_ROOT/projects"
mkdir -p "$E2_PROJECTS/default"
export IBL5_USAGE_CLAUDE_PROJECTS="$E2_PROJECTS"
printf '#!/bin/sh\nexit 1\n' > "$E2_STUB/security"
chmod +x "$E2_STUB/security"
E2_ARGS="$E2_ROOT/stub-args"
: > "$E2_ARGS"

# P6 post-plan pause: the impl hands off to this worktree, and the post-plan-now stub
# (the runner calls "$SELF_DIR/../post-plan-now", so it sits beside $E2_ROOT) writes a
# post-plan-now marker whose resume_cwd is the worktree, then exits 75.
E2_PP_WT="$E2_ROOT/pp-worktree"
E2_PP_SID="cccccccc-3333-4333-8333-cccccccccccc"
mkdir -p "$E2_PP_WT"
printf '#!/bin/sh\nexit 0\n' > "$E2_PP_WT/post-plan-now"
chmod +x "$E2_PP_WT/post-plan-now"
cat > "$E2_ROOT/../post-plan-now" <<PPSTUB
#!/usr/bin/env bash
. "$GATE_LIB"
usage_marker_write "$E2_PP_SID" post-plan-now "$E2_PP_WT/post-plan-now" usage-pause drain 94 five_hour ""
exit 75
PPSTUB
chmod +x "$E2_ROOT/../post-plan-now"

# Stub claude: keyed on PLAN_FILE= in the prompt text.
# wtfail.md  — touches the wt-fail sentinel, writes no handoff, exits 0.
# fastfail.md — writes nothing, exits 0 (a genuine fast-no-outcome shape).
cat > "$E2_STUB/claude" <<CLAUDE
#!/usr/bin/env bash
set -u
NDIR="$E2_NDIR"
TRACE="$E2_TRACE"
printf 'ARGS %s\n' "\$*" >> "$E2_ARGS"
sid=""; prev=""
for a in "\$@"; do [ "\$prev" = "--session-id" ] && sid="\$a"; prev="\$a"; done
case "\${STUB_MODE:-}" in
    marker)
        . "$GATE_LIB"
        usage_marker_write "\$sid" automouse "$E2_RUNNER" usage-pause drain 94 five_hour ""
        exit 0 ;;
    limit) echo "You've hit your weekly limit" >&2; echo "You've hit your weekly limit"; exit 1 ;;
    auth)  echo "API Error: 401" >&2; echo "API Error: 401"; exit 1 ;;
    ppause)
        plan="\$(printf '%s\n' "\$*" | grep -oE 'PLAN_FILE=[^[:space:]]+' | tail -1 | cut -d= -f2)"
        printf '{"slug":"stub","worktree":"%s","branch":"stub","plan_file":"%s","plan_title":"stub","completed_at":"2026-01-01T00:00:00Z"}\n' \
            "$E2_PP_WT" "\$plan" > "\$NDIR/handoff/\$plan.json"
        printf '{"type":"result","subtype":"success","stop_reason":"end_turn","num_turns":1,"duration_ms":100,"total_cost_usd":0.001,"usage":{"input_tokens":1,"output_tokens":1}}\n'
        exit 0 ;;
esac
plan="\$(printf '%s\n' "\$*" | grep -oE 'PLAN_FILE=[^[:space:]]+' | tail -1 | cut -d= -f2)"
if [ -n "\$plan" ]; then
    case "\$plan" in
        wtfail.md)
            touch "\$NDIR/queue/\$plan.wt-fail"
            ;;
        fastfail.md)
            ;;
        *)
            ;;
    esac
    printf '%s impl\n' "\$plan" >> "\$TRACE"
fi
printf '{"type":"result","subtype":"success","stop_reason":"end_turn","num_turns":1,"duration_ms":100,"total_cost_usd":0.001,"usage":{"input_tokens":1,"output_tokens":1}}\n'
exit 0
CLAUDE
chmod +x "$E2_STUB/claude"

write_e2_plan() {
    local name="$1"
    { echo '---'; echo 'impl_model: sonnet'; echo '---'; echo "# $name"; } \
        > "$E2_PLANS/$name.md"
    ln -sf "$E2_PLANS/$name.md" "$E2_NDIR/queue/$name.md"
}

# bin/automouse/run writes one logs/<date>-<pid>.log per process, and each
# run_e2 call is a new process, so read every per-runner log together. The
# log dir is private to this test; globbing all dates keeps a run that
# crosses local midnight from missing the logs written after it.
e2_logtxt() { cat "$E2_NDIR/logs/"*.log 2>/dev/null || true; }

reset_e2() {
    rm -f "$E2_NDIR/queue"/*.md "$E2_NDIR/queue"/*.attempts \
          "$E2_NDIR/queue"/*.depends-hold "$E2_NDIR/queue"/*.wt-fail \
          "$E2_NDIR/queue"/*.failure "$E2_NDIR/handoff"/*.json \
          "$E2_NDIR/done"/*.md "$E2_TRACE"
    : > "$E2_TRACE"
    rm -f "$E2_NDIR/logs"/*.log
    rm -rf "$E2_NDIR/queue"/*.lock "$E2_GATE"
    mkdir -p "$E2_GATE"
    : > "$E2_ARGS"
}

run_e2() {
    NIGHTLY_DIR="$E2_NDIR" PLANS_DIR="$E2_PLANS" CLAUDE_HEADLESS=1 \
    CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 \
    timeout 30 "$E2_RUNNER" 2>&1 || true
}

# ── W1: wt-fail is a counted, kept, deferred attempt ─────────────────────────
echo ""
echo "# W1: wt-fail counted, kept, deferred"
reset_e2
write_e2_plan "wtfail"
run_e2 > /dev/null 2>&1
W1_LOG="$(e2_logtxt)"
W1_ATTEMPTS="$(cat "$E2_NDIR/queue/wtfail.md.attempts" 2>/dev/null || echo '')"
assert_present "W1: queue/wtfail.md still in queue/"    "$E2_NDIR/queue/wtfail.md"
assert_absent  "W1: skipped/wtfail.md absent"           "$E2_NDIR/skipped/wtfail.md"
assert_eq      "W1: attempts = 1"                        "$W1_ATTEMPTS" "1"
assert_absent  "W1: queue/wtfail.md.wt-fail absent (cleared by 3d)" \
                "$E2_NDIR/queue/wtfail.md.wt-fail"
assert_absent  "W1: queue/wtfail.md.failure absent"     "$E2_NDIR/queue/wtfail.md.failure"
want           "W1: log has WT-NEW FAILURE"              "$W1_LOG" "WT-NEW FAILURE"
want_absent    "W1: log has no Environmental failure"    "$W1_LOG" "Environmental failure during impl"
want           "W1: log has deferred drain message"      "$W1_LOG" \
               "Deferred to the next run (cap-refunded or wt-new failure): wtfail.md"
assert_eq      "W1: exactly one impl trace line"         \
               "$(grep -c 'wtfail.md impl' "$E2_TRACE" 2>/dev/null || echo 0)" "1"

# ── W2: control — fast exit with no sentinel still env-stops ─────────────────
echo ""
echo "# W2: fast exit without sentinel → env-stop"
reset_e2
write_e2_plan "fastfail"
run_e2 > /dev/null 2>&1
W2_LOG="$(e2_logtxt)"
want           "W2: log has Environmental failure"       "$W2_LOG" "Environmental failure during impl"
assert_absent  "W2: queue/fastfail.md.attempts absent (refunded)" \
               "$E2_NDIR/queue/fastfail.md.attempts"
want_absent    "W2: log has no WT-NEW FAILURE"           "$W2_LOG" "WT-NEW FAILURE"

# ── W3: stale sentinel does not misclassify ───────────────────────────────────
echo ""
echo "# W3: stale pre-seeded wt-fail sentinel does not misclassify fastfail"
reset_e2
write_e2_plan "fastfail"
touch "$E2_NDIR/queue/fastfail.md.wt-fail"
run_e2 > /dev/null 2>&1
W3_LOG="$(e2_logtxt)"
want           "W3: log has Environmental failure (same as W2)" "$W3_LOG" "Environmental failure during impl"
assert_absent  "W3: queue/fastfail.md.attempts absent (refunded)" \
               "$E2_NDIR/queue/fastfail.md.attempts"
want_absent    "W3: log has no WT-NEW FAILURE"           "$W3_LOG" "WT-NEW FAILURE"
assert_absent  "W3: stale sentinel cleared by 3b (rm before attempt)" \
               "$E2_NDIR/queue/fastfail.md.wt-fail"

# ── Usage-gate pause cases (ADR-0143) ─────────────────────────────────────────
run_e2_mode() { # $1 = STUB_MODE
    STUB_MODE="$1" run_e2 > /dev/null 2>&1
}
stub_sid() { grep -oE -- '--session-id [0-9a-f-]{36}' "$E2_ARGS" | head -1 | awk '{print $2}'; }
gate_marker_count() { find "$E2_GATE/markers" -name '*.json' 2>/dev/null | wc -l | tr -d ' '; }

echo ""
echo "# P1: a marker written mid-run pauses the impl (no env-stop, attempt refunded, lock held)"
reset_e2
write_e2_plan "pausey"
run_e2_mode marker
P1_LOG="$(e2_logtxt)"
P1_SID="$(stub_sid)"
[ -n "$P1_SID" ] && echo "ok: P1: the impl was launched with --session-id $P1_SID" \
    || fail "P1: the impl call carried no --session-id <uuid>"
want           "P1: log says the impl paused"            "$P1_LOG" "Impl paused (usage gate)"
want_absent    "P1: no env-stop"                         "$P1_LOG" "Environmental failure"
assert_eq      "P1: paused-held names the impl session"  "$(cat "$E2_NDIR/queue/pausey.md.lock/paused-held" 2>/dev/null)" "$P1_SID"
assert_absent  "P1: attempt refunded"                    "$E2_NDIR/queue/pausey.md.attempts"
assert_present "P1: plan stays queued"                   "$E2_NDIR/queue/pausey.md"
assert_present "P1: runs/<sid>.plan exists"              "$E2_GATE/runs/$P1_SID.plan"
assert_present "P1: marker survives for the coordinator" "$E2_GATE/markers/$P1_SID.json"

echo ""
echo "# P2: a weekly-limit message pauses with reason=limit-hit"
reset_e2
write_e2_plan "limity"
run_e2_mode limit
P2_LOG="$(e2_logtxt)"
want           "P2: log says the impl paused"            "$P2_LOG" "Impl paused (usage gate)"
want_absent    "P2: no env-stop"                         "$P2_LOG" "Environmental failure"
assert_eq      "P2: one marker"                          "$(gate_marker_count)" "1"
assert_eq      "P2: marker reason is limit-hit"          "$(jq -r .reason "$E2_GATE"/markers/*.json 2>/dev/null)" "limit-hit"

echo ""
echo "# P3: API Error 401 stays on the env-stop path"
reset_e2
write_e2_plan "authy"
run_e2_mode auth
P3_LOG="$(e2_logtxt)"
want           "P3: env-stop report path"                "$P3_LOG" "Environmental failure during impl"
want_absent    "P3: not paused"                          "$P3_LOG" "Impl paused (usage gate)"
assert_eq      "P3: no marker"                           "$(gate_marker_count)" "0"

echo ""
echo "# P4: --resume-paused continues mid-run pause with --resume (session has a transcript)"
reset_e2
write_e2_plan "pausey"
run_e2_mode marker
P4_SID="$(stub_sid)"
assert_eq      "P4 setup: paused-held holds the sid"     "$(cat "$E2_NDIR/queue/pausey.md.lock/paused-held" 2>/dev/null)" "$P4_SID"
# Create a fake transcript so usage_session_started returns true -> uses --resume
touch "$E2_PROJECTS/default/$P4_SID.jsonl"
: > "$E2_ARGS"
NIGHTLY_DIR="$E2_NDIR" PLANS_DIR="$E2_PLANS" CLAUDE_HEADLESS=1 CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 \
    timeout 30 "$E2_RUNNER" --resume-paused "$P4_SID" > /dev/null 2>&1 || true
rm -f "$E2_PROJECTS/default/$P4_SID.jsonl"
P4_ARGS="$(cat "$E2_ARGS")"
want           "P4: the impl got --resume <sid>"         "$P4_ARGS" "--resume $P4_SID"
want           "P4: the impl got the continue prompt"    "$P4_ARGS" "Continue the implementation from where it stopped"
assert_absent  "P4: the pause marker is gone"            "$E2_GATE/markers/$P4_SID.json"
assert_absent  "P4: no paused-held left"                 "$E2_NDIR/queue/pausey.md.lock/paused-held"

echo ""
echo "# P4b: --resume-paused of pre-start pause uses --session-id; resume_count carries through clear"
reset_e2
write_e2_plan "pausey"
# Seed a drain-zone usage cache so the prestart gate fires on the first run
printf '{"five_hour":{"utilization":95,"resets_at":null},"seven_day":{"utilization":30,"resets_at":null},"fetched_at":%s}\n' \
    "$(date +%s)" > "$E2_GATE/cache.json"
run_e2
P4B_SID="$(cat "$E2_NDIR/queue/pausey.md.lock/paused-held" 2>/dev/null)"
[ -n "$P4B_SID" ] && echo "ok: P4b setup: prestart gate paused with sid $P4B_SID" \
    || fail "P4b setup: no paused-held after prestart pause"
assert_present "P4b setup: prestart pause marker exists"   "$E2_GATE/markers/$P4B_SID.json"
assert_eq      "P4b setup: resume_count starts at 0"       "$(jq -r .resume_count "$E2_GATE/markers/$P4B_SID.json" 2>/dev/null)" "0"
# Simulate the coordinator bumping the count before it resumes the session
# shellcheck source=/dev/null
( . "$GATE_LIB"; IBL5_USAGE_GATE_STATE_DIR="$E2_GATE" usage_marker_bump_resume "$P4B_SID" ) > /dev/null 2>&1
# Clear the drain-zone cache so the resumed run's prestart gate passes
rm -f "$E2_GATE/cache.json"
: > "$E2_ARGS"
# No transcript exists — usage_session_started returns false — runner must use --session-id
# STUB_MODE=marker causes the resumed impl to re-pause, so we can verify resume_count carried
STUB_MODE=marker NIGHTLY_DIR="$E2_NDIR" PLANS_DIR="$E2_PLANS" CLAUDE_HEADLESS=1 \
    CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 \
    timeout 30 "$E2_RUNNER" --resume-paused "$P4B_SID" > /dev/null 2>&1 || true
P4B_ARGS="$(cat "$E2_ARGS")"
want           "P4b: impl used --session-id (no transcript)"   "$P4B_ARGS" "--session-id $P4B_SID"
want_absent    "P4b: impl did NOT use --resume"                "$P4B_ARGS" "--resume $P4B_SID"
want_absent    "P4b: no continue prompt"                       "$P4B_ARGS" "Continue the implementation from where it stopped"
# The stub re-paused: verify resume_count=1 was carried through the clear
assert_present "P4b: new marker written after re-pause"        "$E2_GATE/markers/$P4B_SID.json"
assert_eq      "P4b: resume_count=1 carried through clear"     "$(jq -r .resume_count "$E2_GATE/markers/$P4B_SID.json" 2>/dev/null)" "1"

echo ""
echo "# P5: --resume-paused rejects bad input with exit 2"
reset_e2
p5_rc() { NIGHTLY_DIR="$E2_NDIR" PLANS_DIR="$E2_PLANS" CLAUDE_HEADLESS=1 timeout 30 "$E2_RUNNER" "$@" > /dev/null 2>&1; echo $?; }
assert_eq      "P5: no sid"                              "$(p5_rc --resume-paused)" "2"
assert_eq      "P5: two sids"                            "$(p5_rc --resume-paused a b)" "2"
assert_eq      "P5: path-like sid"                       "$(p5_rc --resume-paused ../x)" "2"
P5_SID="bbbbbbbb-2222-4222-8222-bbbbbbbbbbbb"
# shellcheck source=/dev/null
( . "$GATE_LIB"; usage_marker_write "$P5_SID" plan-now "$E2_RUNNER" usage-pause drain 94 five_hour ""; usage_argv_save "$P5_SID" ) > /dev/null 2>&1
assert_eq      "P5: marker belongs to plan-now"          "$(p5_rc --resume-paused "$P5_SID")" "2"

echo ""
echo "# P6: post-plan-now exit 75 holds the claim lock for its session and refunds the attempt"
reset_e2
write_e2_plan "ppausey"
run_e2_mode ppause
P6_LOG="$(e2_logtxt)"
want           "P6: post-plan ran and exited 75"         "$P6_LOG" "post-plan-now exited code=75"
want           "P6: log says post-plan paused"           "$P6_LOG" "Post-plan paused (usage gate)"
want_absent    "P6: no env-stop"                         "$P6_LOG" "Environmental failure"
assert_eq      "P6: paused-held names the post-plan session" \
               "$(cat "$E2_NDIR/queue/ppausey.md.lock/paused-held" 2>/dev/null)" "$E2_PP_SID"
assert_absent  "P6: attempt refunded"                    "$E2_NDIR/queue/ppausey.md.attempts"
assert_present "P6: plan stays queued"                   "$E2_NDIR/queue/ppausey.md"
assert_present "P6: post-plan marker survives"           "$E2_GATE/markers/$E2_PP_SID.json"

if [ "$FAILED" -ne 0 ]; then
    echo "RESULT: FAILED"
    exit 1
fi
echo "RESULT: all passed"
exit 0
