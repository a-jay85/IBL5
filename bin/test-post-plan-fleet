_SQEDIT="$SCRATCH/cg-sqedit.sh"
printf '#!/bin/sh\nawk '"'"'NR>1 && /^pick /{sub(/^pick /,"squash ")}1'"'"' "$1" > "$1.tmp" && mv "$1.tmp" "$1"\n' \
  > "$_SQEDIT" && chmod +x "$_SQEDIT"

# arm: usage errors — zero-arg, missing branch, bogus mode all exit 1 with STOP: line
