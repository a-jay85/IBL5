#!/usr/bin/env bash
# test-pr-cycle-tick — behaviour tests for bin/pr-cycle-tick.
#
# Builds a sealed fixture: a scratch git repo that holds a copy of bin/pr-cycle-tick and
# bin/lib/, so the tick derives ROOT from its own location and `git worktree list` plus
# both harness out dirs are fixture-controlled. gh, launchctl, security and claude are
# shims on a scratch PATH dir; bin/pr-cycle and bin/discord-dm are replaced through the
# tick's PR_CYCLE_TICK_*_CMD seams. Nothing here touches a real PR, a real launchd job,
# the keychain, or any path outside the scratch dir, so it runs identically on macOS and
# Linux CI. There is deliberately no platform skip.
#
# Usage: bin/test-pr-cycle-tick

set -uo pipefail

# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SRC_TICK="$SCRIPT_DIR/pr-cycle-tick"
[[ -x "$SRC_TICK" ]] || { echo "FAIL: $SRC_TICK missing or not executable" >&2; exit 1; }
REAL_TOP="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || true)"

SCRATCH="$(mktemp -d)"
trap 'rm -rf "$SCRATCH"; h_cleanup' EXIT

CASE_BASE=0
fail() { h_fail "$*"; }
begin_case() { CASE_BASE=$H_FAIL; }
end_case() {  # $1 = case name; prints "<name> OK" only if the case added no failures
    # The tick must never spend: every case, pass or fail, proves the claude shim stayed cold.
    [[ ! -e "$SCRATCH/claude.log" ]] || fail "$1: claude was invoked"
    if [[ $H_FAIL -eq $CASE_BASE ]]; then h_pass "$1"; else echo "$1 FAILED" >&2; fi
}

# --- fixture repo --------------------------------------------------------------------------
REPO="$SCRATCH/repo"
WT="$SCRATCH/wt-one"
HOME_DIR="$SCRATCH/home"
STATE_DIR="$HOME_DIR/.ibl5-pr-cycle-watch"
SHIMS="$SCRATCH/shims"
TICK="$REPO/bin/pr-cycle-tick"
mkdir -p "$REPO/bin" "$HOME_DIR" "$SHIMS"
cp "$SRC_TICK" "$TICK"
cp "$SCRIPT_DIR/pr-cycle-tick-cron-setup" "$REPO/bin/pr-cycle-tick-cron-setup"
cp -R "$SCRIPT_DIR/lib" "$REPO/bin/lib"
git -C "$REPO" init -q 2>/dev/null
git -C "$REPO" config user.email t@t.invalid
git -C "$REPO" config user.name t
git -C "$REPO" add -A >/dev/null 2>&1
git -C "$REPO" commit -qm seed >/dev/null 2>&1
git -C "$REPO" worktree add -q -b branch-one "$WT" >/dev/null 2>&1
# git reports the physical path (macOS: /private/var/...), and the sweep cases name $WT in
# fake ps and lsof rows that must match it. Resolve it once, here.
WT="$(cd "$WT" && pwd -P)"

# --- shims ---------------------------------------------------------------------------------
cat > "$SHIMS/gh" <<GH_EOF
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "$SCRATCH/gh.log"
if [[ "\${1:-}" == "pr" && "\${2:-}" == "list" ]]; then
    st=""; prev=""
    for a in "\$@"; do [[ "\$prev" == "--state" ]] && st="\$a"; prev="\$a"; done
    if [[ "\$st" == "open" ]]; then
        cat "$SCRATCH/prs.json"
    else
        jq -s 'add' "$SCRATCH/prs.json" "$SCRATCH/prs-closed.json"
    fi
    exit 0
fi
if [[ "\${1:-}" == "api" ]]; then
    # The endpoint is the first repos/ argument: a DELETE puts --method before it.
    ep=""
    for a in "\$@"; do [[ -z "\$ep" && "\$a" == repos/* ]] && ep="\$a"; done
    case "\$ep" in
        repos/*/issues/*/timeline*)
            n="\${ep#*/issues/}"; n="\${n%%/*}"
            [[ ! -e "$SCRATCH/timeline-fail-\$n" ]] || exit 1
            [[ -f "$SCRATCH/timeline-\$n.json" ]] || exit 1
            expr=""; prev=""
            for a in "\$@"; do [[ "\$prev" == "--jq" ]] && expr="\$a"; prev="\$a"; done
            if [[ -n "\$expr" ]]; then jq -r "\$expr" "$SCRATCH/timeline-\$n.json"; else cat "$SCRATCH/timeline-\$n.json"; fi
            exit 0 ;;
        repos/*/issues/*/labels/*)
            n="\${ep#*/issues/}"; n="\${n%%/*}"; lbl="\${ep##*/labels/}"
            printf '%s %s %s\n' "\$(printf '%s ' "\$@" | grep -oE -- '--method [A-Z]+' | cut -d' ' -f2)" "\$n" "\$lbl" >> "$SCRATCH/gh-label.log"
            [[ ! -e "$SCRATCH/delete-fail-\$n" ]] || exit 1
            exit 0 ;;
        repos/*/commits/*/check-runs*)
            sha="\${ep#*/commits/}"; sha="\${sha%%/*}"
            [[ -f "$SCRATCH/checks-\$sha.json" ]] || exit 1
            cat "$SCRATCH/checks-\$sha.json"
            exit 0 ;;
    esac
fi
echo "gh shim: unexpected args: \$*" >&2
exit 1
GH_EOF

# The 6000-line filler is load-bearing: a SIGPIPE regression (`launchctl list | grep -q`
# under pipefail) only reproduces when the writer still has queued output after the reader
# exits, and the filler exceeds the 64KB pipe buffer.
cat > "$SHIMS/launchctl" <<LC_EOF
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "$SCRATCH/launchctl.log"
[[ ! -e "$SCRATCH/launchctl-fail" ]] || exit 1
if [[ "\${1:-}" == "list" && \$# -eq 1 ]]; then
    cat "$SCRATCH/launchctl-list.txt"
    i=0
    while [[ \$i -lt 6000 ]]; do
        printf -- '-\t0\tcom.apple.filler.service.number.%s\n' "\$i"
        i=\$((i + 1))
    done
fi
exit 0
LC_EOF

# security: the live usage read asks the keychain for an OAuth token. No token means
# "no-token" and a fail-open zone, with no network and no real keychain access.
cat > "$SHIMS/security" <<SEC_EOF
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "$SCRATCH/security.log"
exit 44
SEC_EOF

cat > "$SHIMS/claude" <<CL_EOF
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "$SCRATCH/claude.log"
exit 0
CL_EOF

cat > "$SHIMS/ps" <<PS_EOF
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "$SCRATCH/ps.log"
[[ ! -e "$SCRATCH/ps-fail" ]] || exit 1
cat "$SCRATCH/ps.txt"
exit 0
PS_EOF

cat > "$SHIMS/lsof" <<LS_EOF
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "$SCRATCH/lsof.log"
[[ ! -e "$SCRATCH/lsof-fail" ]] || exit 1
cat "$SCRATCH/lsof.txt"
exit 0
LS_EOF

# git: passes through, except `git worktree list` fails while the flag file exists.
REAL_GIT="$(command -v git)"
cat > "$SHIMS/git" <<GIT_EOF
#!/usr/bin/env bash
if [[ -e "$SCRATCH/git-worktree-fail" && "\${1:-}" != "" ]]; then
    for a in "\$@"; do
        if [[ "\$a" == worktree ]]; then exit 128; fi
    done
fi
exec "$REAL_GIT" "\$@"
GIT_EOF

cat > "$SCRATCH/pr-cycle-stub" <<PC_EOF
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "$SCRATCH/pr-cycle.log"
printf '%s\n' "\${PR_CYCLE_SKIP_NOTES-UNSET}" > "$SCRATCH/pr-cycle-skip-notes-env"
if [[ -n "\${PR_CYCLE_SKIP_NOTES:-}" && -f "\$PR_CYCLE_SKIP_NOTES" ]]; then
    cp "\$PR_CYCLE_SKIP_NOTES" "$SCRATCH/pr-cycle-skip-notes-copy"
fi
# The real worker writes its result file at the end. A case stages the file with set_result.
if [[ -n "\${PR_CYCLE_RESULT_FILE:-}" && -f "$SCRATCH/result-canned" ]]; then
    mkdir -p "\$(dirname "\$PR_CYCLE_RESULT_FILE")"
    cp "$SCRATCH/result-canned" "\$PR_CYCLE_RESULT_FILE"
fi
exit "\${STUB_RC:-0}"
PC_EOF

# A DM can span lines (the paste line sits on its own line). Flatten each newline to the two
# characters \n so one DM stays one dm.log line for dm_count and the line-count assertions.
cat > "$SCRATCH/dm-stub" <<DM_EOF
#!/usr/bin/env bash
msg="\$*"; nl=\$'\n'
printf '%s\n' "\${msg//\$nl/\\\\n}" >> "$SCRATCH/dm.log"
exit 0
DM_EOF
# pad40 <sha>: the fixture's patch-id for a head. Fixture SHAs are 7 hex chars and the
# tick's pcw_patch_id accepts only 40 hex, so the identity seam pads with 0 to 40.
# This is the ONE definition; the shim and key_of both call it.
cat > "$SCRATCH/pad40" <<'PAD_EOF'
#!/usr/bin/env bash
s="$1"; z="0000000000000000000000000000000000000000"
[[ "$s" =~ ^[0-9a-f]{1,40}$ ]] || exit 1
printf '%s%s\n' "$s" "${z:${#s}}"
PAD_EOF
# Default PR_CYCLE_PATCH_ID_CMD: patch-id == pad40(current head SHA of PR $1).
cat > "$SCRATCH/patchid-identity" <<PID_EOF
#!/usr/bin/env bash
s="\$(jq -r --argjson n "\$1" '.[] | select(.number == \$n) | .headRefOid' "$SCRATCH/prs.json" 2>/dev/null)"
[[ -n "\$s" ]] || exit 1
exec "$SCRATCH/pad40" "\$s"
PID_EOF
# patchid-file: per-PR controllable patch-id; prints $SCRATCH/key-<pr>, fails when absent.
cat > "$SCRATCH/patchid-file" <<PF_EOF
#!/usr/bin/env bash
cat "$SCRATCH/key-\$1" 2>/dev/null
PF_EOF
printf '#!/usr/bin/env bash\nexit 1\n' > "$SCRATCH/patchid-fail"
printf '#!/usr/bin/env bash\necho not-a-patch-id\n' > "$SCRATCH/patchid-junk"
# mastertip-file: controllable origin/master tip; prints $SCRATCH/master-tip, fails when absent.
cat > "$SCRATCH/mastertip-file" <<MT_EOF
#!/usr/bin/env bash
cat "$SCRATCH/master-tip" 2>/dev/null
MT_EOF
printf '#!/usr/bin/env bash\nexit 0\n' > "$SCRATCH/mastertip-empty"
printf '#!/usr/bin/env bash\necho not-a-sha\n' > "$SCRATCH/mastertip-junk"
chmod +x "$SHIMS"/* "$SCRATCH/pr-cycle-stub" "$SCRATCH/dm-stub" "$SCRATCH/pad40" "$SCRATCH/patchid-identity" "$SCRATCH/patchid-file" "$SCRATCH/patchid-fail" "$SCRATCH/patchid-junk" "$SCRATCH/mastertip-file" "$SCRATCH/mastertip-empty" "$SCRATCH/mastertip-junk"

# --- per-case state ------------------------------------------------------------------------
UNSET="__UNSET__"
E_ZONE=normal; E_STOP="$UNSET"; E_STATE="$UNSET"
E_PRCMD="$SCRATCH/pr-cycle-stub"; E_DMCMD="$SCRATCH/dm-stub"
E_HOME="set"; E_STUB_RC=0
E_PATCHID="$SCRATCH/patchid-identity"
E_MASTERTIP="$SCRATCH/mastertip-file"

reset() {
    rm -f "$SCRATCH"/*.log "$SCRATCH/prs.json" "$SCRATCH"/checks-*.json "$SCRATCH/result-canned"
    rm -f "$SCRATCH/pr-cycle-skip-notes-env" "$SCRATCH/pr-cycle-skip-notes-copy"
    rm -f "$SCRATCH"/key-*
    rm -f "$SCRATCH/prs-closed.json" "$SCRATCH"/timeline-*.json "$SCRATCH"/timeline-fail-* \
        "$SCRATCH"/delete-fail-* "$SCRATCH/ps-fail" "$SCRATCH/lsof-fail" \
        "$SCRATCH/launchctl-fail" "$SCRATCH/lsof.txt"
    rm -rf "$HOME_DIR" "$REPO/tools" "$WT/tools" "$SCRATCH/usage-gate" "$SCRATCH/watch-state"
    mkdir -p "$HOME_DIR"
    : > "$SCRATCH/launchctl-list.txt"
    echo '[]' > "$SCRATCH/prs.json"
    echo '[]' > "$SCRATCH/prs-closed.json"
    printf '%s\n' '1 /sbin/launchd' '77 /usr/bin/login -fp t' > "$SCRATCH/ps.txt"
    : > "$SCRATCH/lsof.txt"
    rm -f "$SCRATCH/git-worktree-fail" "$REPO/bin/pr-cycle-tick-mut"
    TICK_OVERRIDE=""
    E_ZONE=normal; E_STOP="$UNSET"; E_STATE="$UNSET"
    E_PRCMD="$SCRATCH/pr-cycle-stub"; E_DMCMD="$SCRATCH/dm-stub"
    E_HOME="set"; E_STUB_RC=0
    E_PATCHID="$SCRATCH/patchid-identity"
    E_MASTERTIP="$SCRATCH/mastertip-file"
    "$SCRATCH/pad40" e0001 > "$SCRATCH/master-tip"
}

# set_prs "<num>|<branch>|<sha>|<mergeStateStatus>|<isDraft>[|<baseRefName>]" ...
set_prs() {
    local e out="[]" n b s m d base
    for e in "$@"; do
        IFS='|' read -r n b s m d base <<< "$e"
        out="$(jq -c --argjson n "$n" --arg b "$b" --arg s "$s" --arg m "$m" --argjson d "$d" --arg base "${base:-master}" \
            '. + [{number:$n, headRefName:$b, headRefOid:$s, mergeStateStatus:$m, isDraft:$d, baseRefName:$base}]' <<< "$out")"
    done
    printf '%s\n' "$out" > "$SCRATCH/prs.json"
}

# set_checks <sha> green|pending|red|none
set_checks() {
    local f="$SCRATCH/checks-$1.json"
    case "$2" in
        green)   echo '{"total_count":1,"check_runs":[{"name":"ci","status":"completed","conclusion":"success","completed_at":"2026-10-03T00:00:00Z"}]}' > "$f" ;;
        pending) echo '{"total_count":1,"check_runs":[{"name":"ci","status":"in_progress","conclusion":null,"started_at":"2026-10-03T00:00:00Z"}]}' > "$f" ;;
        red)     echo '{"total_count":1,"check_runs":[{"name":"ci","status":"completed","conclusion":"failure","completed_at":"2026-10-03T00:00:00Z"}]}' > "$f" ;;
        none)    echo '{"total_count":0,"check_runs":[]}' > "$f" ;;
        signoff) echo '{"total_count":2,"check_runs":[{"name":"ci","status":"completed","conclusion":"success","completed_at":"2026-10-03T00:00:00Z"},{"name":"human-signoff","status":"completed","conclusion":"failure","completed_at":"2026-10-03T00:00:00Z"}]}' > "$f" ;;
        signoff-red) echo '{"total_count":2,"check_runs":[{"name":"ci","status":"completed","conclusion":"failure","completed_at":"2026-10-03T00:00:00Z"},{"name":"human-signoff","status":"completed","conclusion":"failure","completed_at":"2026-10-03T00:00:00Z"}]}' > "$f" ;;
    esac
}

# set_jobs <pid> <label> ...: launchctl-list rows (tab separated: PID, status, label)
set_jobs() {
    : > "$SCRATCH/launchctl-list.txt"
    while [[ $# -ge 2 ]]; do
        printf '%s\t0\t%s\n' "$1" "$2" >> "$SCRATCH/launchctl-list.txt"
        shift 2
    done
}

# set_labels <num> <label>...: sets .labels on the prs.json entry. PRs never given a call
# carry no labels key, which the sweep must tolerate.
set_labels() {
    local n="$1" names
    shift
    names="$(printf '%s\n' "$@" | jq -R '{name: .}' | jq -sc '.')"
    jq -c --argjson n "$n" --argjson l "$names" \
        'map(if .number == $n then . + {labels: $l} else . end)' "$SCRATCH/prs.json" > "$SCRATCH/prs.json.tmp" \
        && mv "$SCRATCH/prs.json.tmp" "$SCRATCH/prs.json"
}

# set_closed_prs "<num>|<branch>|<sha>|<state>|<isDraft>": the PRs a call without
# `--state open` would also see.
set_closed_prs() {
    local e out="[]" n b s m d
    for e in "$@"; do
        IFS='|' read -r n b s m d <<< "$e"
        out="$(jq -c --argjson n "$n" --arg b "$b" --arg s "$s" --arg m "$m" --argjson d "$d" \
            '. + [{number:$n, headRefName:$b, headRefOid:$s, mergeStateStatus:$m, isDraft:$d, baseRefName:"master"}]' <<< "$out")"
    done
    printf '%s\n' "$out" > "$SCRATCH/prs-closed.json"
}

# set_label_age <num> <minutes-ago> [extra-older-minutes]: the timeline for PR <num>. With
# the third argument an older labeled event, an unlabeled event and an unrelated labeled
# event precede the last one, so "last labeled event for THIS label wins" is tested.
set_label_age() {
    local n="$1" m="$2" older="${3-}" now t ev
    now="$(date +%s)"
    t="$(jq -rn --argjson t $(( now - m * 60 )) '$t | todate')"
    ev="[]"
    if [[ -n "$older" ]]; then
        local to
        to="$(jq -rn --argjson t $(( now - older * 60 )) '$t | todate')"
        ev="$(jq -nc --arg to "$to" '[
            {event:"labeled", label:{name:"post-plan-running"}, created_at:$to},
            {event:"unlabeled", label:{name:"post-plan-running"}, created_at:$to},
            {event:"labeled", label:{name:"auto-mergeable"}, created_at:$to}]')"
    fi
    jq -c --arg t "$t" '. + [{event:"labeled", label:{name:"post-plan-running"}, created_at:$t}]' <<< "$ev" \
        > "$SCRATCH/timeline-$n.json"
}
set_closed_labels() {  # <num> <label>...: set_labels, pointed at prs-closed.json
    local n="$1" names
    shift
    names="$(printf '%s\n' "$@" | jq -R '{name: .}' | jq -sc '.')"
    jq -c --argjson n "$n" --argjson l "$names" \
        'map(if .number == $n then . + {labels: $l} else . end)' "$SCRATCH/prs-closed.json" > "$SCRATCH/prs-closed.json.tmp" \
        && mv "$SCRATCH/prs-closed.json.tmp" "$SCRATCH/prs-closed.json"
}
set_git_worktree_fail() { touch "$SCRATCH/git-worktree-fail"; }
set_timeline_fail() { touch "$SCRATCH/timeline-fail-$1"; }
set_delete_fail() { touch "$SCRATCH/delete-fail-$1"; }

# set_ps <line>...: the `ps -axww -o pid=,command=` output the ps shim prints.
set_ps() { printf '%s\n' "$@" > "$SCRATCH/ps.txt"; }
set_ps_fail() { touch "$SCRATCH/ps-fail"; }
set_lsof() { printf '%s\n' "$@" > "$SCRATCH/lsof.txt"; }
set_lsof_fail() { touch "$SCRATCH/lsof-fail"; }
set_launchctl_fail() { touch "$SCRATCH/launchctl-fail"; }

# _stamp_at <epoch>: touch -t stamp. The one platform branch in this harness: BSD date -r
# on macOS, GNU date -d @ on Linux CI.
_stamp_at() { date -r "$1" +%Y%m%d%H%M.%S 2>/dev/null || date -d "@$1" +%Y%m%d%H%M.%S; }
set_out_root() { mkdir -p "$REPO/tools/postplan-harness/out"; }
# set_live_dir <branch> <minutes-ago> [wt]: a harness run dir with one file, both back-dated.
set_live_dir() {
    local branch="$1" m="$2" base="$REPO" run st
    [[ -z "${3-}" ]] || base="$WT"
    run="$base/tools/postplan-harness/out/live-$branch-20261018-000000"
    mkdir -p "$run"
    : > "$run/phase.log"
    st="$(_stamp_at $(( $(date +%s) - m * 60 )))"
    touch -t "$st" "$run/phase.log" "$run"
}
label_log() { cat "$SCRATCH/gh-label.log" 2>/dev/null || true; }

_DROP=(); _SET=()
_envv() { if [[ "$2" == "$UNSET" ]]; then _DROP+=(-u "$1"); else _SET+=("$1=$2"); fi; }

# Run the tick in a sealed environment. Seam variables default per reset(); a value of
# $UNSET drops the variable entirely, so unset and empty are separately testable.
OUT=""; ERR=""; RC=0
run_tick() {
    _DROP=(); _SET=()
    _envv PR_CYCLE_TICK_USAGE_ZONE "$E_ZONE"
    _envv PR_CYCLE_STOP_FILE "$E_STOP"
    _envv PR_CYCLE_WATCH_STATE_DIR "$E_STATE"
    _envv PR_CYCLE_TICK_PR_CYCLE_CMD "$E_PRCMD"
    _envv PR_CYCLE_TICK_DM_CMD "$E_DMCMD"
    _envv PR_CYCLE_PATCH_ID_CMD "$E_PATCHID"
    _envv PR_CYCLE_MASTER_TIP_CMD "$E_MASTERTIP"
    if [[ "$E_HOME" == "set" ]]; then _SET+=("HOME=$HOME_DIR"); else _DROP+=(-u HOME); fi
    ERR="$SCRATCH/last.err"
    OUT="$(cd "$SCRATCH" && env ${_DROP[@]+"${_DROP[@]}"} ${_SET[@]+"${_SET[@]}"} \
        PATH="$SHIMS:$PATH" \
        IBL5_USAGE_GATE_STATE_DIR="$SCRATCH/usage-gate" \
        STUB_RC="$E_STUB_RC" \
        "${TICK_OVERRIDE:-$TICK}" "$@" 2>"$ERR")"
    RC=$?
    return 0
}

out_has() { grep -qF -- "$1" <<< "$OUT"; }
err_has() { grep -qF -- "$1" "$ERR"; }
no_file() { [[ ! -e "$1" ]]; }
# True when gh was never called, or only for reads the tick makes on the way to a launch: the
# stale-label sweep's `pr list ... isDraft,labels`, the rescue path's `pr list ...
# isDraft,baseRefName`, and its `api repos/.../commits/<sha>/check-runs?per_page=100`. Any
# other call (a timeline read, a label DELETE) is not accepted.
gh_sweep_only() {
    [[ ! -e "$SCRATCH/gh.log" ]] && return 0
    ! grep -vE '^(pr list .*isDraft,(labels|baseRefName)|api repos/[^ ]*/commits/[^ ]+/check-runs\?per_page=100)$' \
        "$SCRATCH/gh.log" | grep -q .
}
# Stricter: gh was never called, or only for the stale-label sweep's `pr list ... isDraft,labels`.
# For the early-exit cases (usage pause, live worker), which must stop before the rescue path's
# `isDraft,baseRefName` list and `check-runs` read.
gh_stale_label_only() {
    [[ ! -e "$SCRATCH/gh.log" ]] && return 0
    ! grep -vE '^pr list .*isDraft,labels$' "$SCRATCH/gh.log" | grep -q .
}
attempt() { cat "$STATE_DIR/attempts/$1" 2>/dev/null; }
pending_count() { find "$STATE_DIR/pending" -type f 2>/dev/null | wc -l | tr -d ' '; }
dm_count() { if [[ -f "$SCRATCH/dm.log" ]]; then wc -l < "$SCRATCH/dm.log" | tr -d ' '; else echo 0; fi; }
launch_count() { if [[ -f "$SCRATCH/pr-cycle.log" ]]; then wc -l < "$SCRATCH/pr-cycle.log" | tr -d ' '; else echo 0; fi; }
strikes() { cat "$STATE_DIR/strikes/$1" 2>/dev/null; }
conflict_hold() { cat "$STATE_DIR/conflict-hold/$1" 2>/dev/null; }
retries() { cat "$STATE_DIR/retries/$1" 2>/dev/null; }
set_tip() { "$SCRATCH/pad40" "$1" > "$SCRATCH/master-tip"; }
key_of() { "$SCRATCH/pad40" "$1"; }
set_key() { printf '%s\n' "$2" > "$SCRATCH/key-$1"; }
pr_refs() { git -C "$REPO" for-each-ref refs/pr-cycle; }
# set_result "<pr>\t<status>\t<outcome>\t<reason>" ...: the file the stub hands the tick.
set_result() {
    { echo "# pr-cycle-result v1"; printf '%b\n' "$@"; } > "$SCRATCH/result-canned"
}
RED101='101|branch-one|aaa1111|BLOCKED|false'

# ===========================================================================================
reset; begin_case
run_tick --help
[[ $RC -eq 0 ]] || fail "help: rc $RC, want 0"
out_has '1800' || fail "help: output omits 1800"
end_case help

reset; begin_case
run_tick --bogus
[[ $RC -eq 2 ]] || fail "unknown-flag: rc $RC, want 2"
err_has 'unknown option' || fail "unknown-flag: no usage message on stderr"
no_file "$SCRATCH/gh.log" || fail "unknown-flag: gh was called"
end_case unknown-flag

reset; begin_case
touch "$HOME_DIR/.ibl5-pr-cycle.stop"
set_prs "$RED101"; set_checks aaa1111 red
run_tick
[[ $RC -eq 0 ]] || fail "stop-file: rc $RC, want 0"
out_has 'stop file present' || fail "stop-file: no 'stop file present' line: $OUT"
no_file "$SCRATCH/gh.log" || fail "stop-file: gh was called"
no_file "$SCRATCH/pr-cycle.log" || fail "stop-file: pr-cycle was launched"
end_case stop-file

reset; begin_case
touch "$HOME_DIR/.ibl5-pr-cycle.stop"
E_STOP=""
run_tick
[[ $RC -eq 0 ]] || fail "stop-file-env-empty: rc $RC, want 0"
