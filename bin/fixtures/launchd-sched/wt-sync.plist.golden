<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ibl5.wt-sync</string>
	<key>Program</key>
	<string>@MAIN_WT@/bin/wt-sync-tick</string>
	<!-- StartInterval: the correct launchd primitive for a 15-min poll.
	     Do NOT "fix" this to a calendar-interval key — that is calendar-only. -->
	<key>StartInterval</key>
	<integer>900</integer>
	<key>WorkingDirectory</key>
	<string>@MAIN_WT@</string>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- launchd agents start with a minimal PATH that omits Homebrew and
		     ~/.local/bin (where the Claude Code native installer puts claude).
		     Every binary the tick shells out to must resolve here: git, lsof,
		     and ioreg — ioreg lives in /usr/sbin, which an earlier revision of
		     this list omitted, silently fail-closing every tick. bin/test-wt-sync-tick
		     asserts this PATH resolves all three; add the dir, don't drop a tool.
		     HOME interpolates HERE, at generation time — launchd does NOT expand
		     variables in EnvironmentVariables, so a literal @HOME@ would bake in
		     a dead path. -->
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:@HOME@/.local/bin</string>
	</dict>
	<key>StandardOutPath</key>
	<string>@HOME@/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/wt-sync/launchd-stdout.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/wt-sync/launchd-stderr.log</string>
</dict>
</plist>
