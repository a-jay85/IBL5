#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-plan-now — pins how bin/plan-now identifies the plan a headless run
# produced, i.e. the PLAN_FILE: marker contract (.claude/rules/headless-marker-contract.md).
#
# Why this test exists: every plan-now run up to 2026-07-28 logged `RESULT
# unconfirmed` and never reached its check-plan gate, because the coda asked for the
# marker BEFORE the plan was written and `claude -p` (default --output-format text)
# emits only the model's final message. The stub below emulates exactly that — it is
# the run's final message and nothing else — so the "no marker" case IS the original
# bug, and the decorated cases pin the tolerant parse that keeps prose deviation from
# reproducing it.
#
# No launchd: PLAN_NOW_DRY_RUN=1 makes plan-now write its runner and stop, and the
# test executes that runner directly. Synchronous, no background jobs, no cleanup debt.
# PLAN_NOW_CLAUDE / PLAN_NOW_PLANS_DIR are the seams plan-now already documents.
#
# Run: bin/test-plan-now  (exit 0 = all pass, 1 = a case failed)

set -u

ROOT=$(cd "$(dirname "$0")/.." && pwd)
PLAN_NOW="$ROOT/bin/plan-now"
# Read the cap out of the script under test, so bumping RUN_TIMEOUT there cannot
# leave this fixture asserting a retired number.
RUN_TIMEOUT=$(sed -n 's/^RUN_TIMEOUT=\([0-9][0-9]*\)$/\1/p' "$PLAN_NOW" | head -1)
[ -n "$RUN_TIMEOUT" ] || { echo "test-plan-now: could not read RUN_TIMEOUT from $PLAN_NOW" >&2; exit 1; }
FAILS=0

ok()   { printf '  ok   %s\n' "$1"; }
fail() { printf '  FAIL %s\n' "$1"; FAILS=$((FAILS + 1)); }

# A full template, not `mktemp -d -t <prefix>`: GNU mktemp rejects a -t argument
# with too few X's, so the BSD spelling would fail on the Linux CI runner.
TMP=$(mktemp -d "${TMPDIR:-/tmp}/test-plan-now.XXXXXX")
trap 'rm -rf "$TMP"' EXIT

PLANS="$TMP/plans"
mkdir -p "$PLANS"

# Isolate the harness from the live automouse tree — the dup gate reads
# $NIGHTLY_DIR, which without this would default to ~/.claude/…/automouse and
# could trigger false-positive blocks or leave artifacts in the real queue.
# Exporting both dirs ensures plan-dup-check (invoked by plan-now as a
# subprocess) also uses the test trees rather than the defaults.
NDIR="$TMP/automouse"
mkdir -p "$NDIR/queue" "$NDIR/done" "$NDIR/skipped"
export NIGHTLY_DIR="$NDIR"
export PLANS_DIR="$PLANS"

# `caffeinate` is macOS-only and the runner wraps the model call in it. Unshimmed,
# this test cannot run on Linux CI: command-not-found → rc != 0 → every
# identification case falls into the RESULT-failed branch and the marker contract
# goes untested. The shim also keeps a local run from taking a real power assertion.
# It lives in the inherited PATH, which the runner's own PATH prelude only
# *prepends* to, so it is reachable on both platforms.
SHIM="$TMP/bin"
mkdir -p "$SHIM"
cat > "$SHIM/caffeinate" <<'SHIM_EOF'
#!/usr/bin/env bash
while [ $# -gt 0 ]; do case "$1" in -*) shift ;; *) break ;; esac; done
exec "$@"
SHIM_EOF
chmod +x "$SHIM/caffeinate"
export PATH="$SHIM:$PATH"

# ── The DM + queue stubs ─────────────────────────────────────────────────────
# PLAN_NOW_DISCORD_DM and PLAN_NOW_AUTOMOUSE_QUEUE are seams in the same shape as
# PLAN_NOW_CLAUDE. The queue one is not a convenience: the real bin/automouse/queue
# writes to the LIVE queue, so without a stub every case here has to run
# --implement and the queued-vs-not fork — the whole point of the finish DM — is
# structurally unreachable.
DM_LOG="$TMP/dm.txt"
export DM_LOG
# $DM_LOG holds only the case that just ran, so an assertion over it speaks for one
# branch. $DM_ALL accumulates every message the suite ever composed — that is what a
# claim about EVERY outcome (case 11) has to read, and it is never reset.
DM_ALL="$TMP/dm-all.txt"
export DM_ALL
: > "$DM_ALL"
DM_STUB="$TMP/discord-dm"
cat > "$DM_STUB" <<'DM_EOF'
#!/usr/bin/env bash
# Captures the composed message, ignoring the `-` (stdin) argument the runner passes.
tee -a "$DM_ALL" > "$DM_LOG"
# $DM_FAIL emulates an undeliverable DM: the real discord-dm spools and exits 1.
[ -n "${DM_FAIL:-}" ] && exit 1
exit 0
DM_EOF
chmod +x "$DM_STUB"

QUEUE_STUB="$TMP/automouse-queue"
cat > "$QUEUE_STUB" <<'QUEUE_EOF'
#!/usr/bin/env bash
[ -n "${QUEUE_FAIL:-}" ] && { echo "automouse-queue (stub): refused $1" >&2; exit 1; }
[ -n "${QUEUE_ALREADY:-}" ] && { printf 'Already queued (no change): %s\n' "$(basename "$1")"; exit 0; }
printf 'automouse-queue (stub): queued %s\n' "$1"
QUEUE_EOF
chmod +x "$QUEUE_STUB"

# The message the runner composed for the case that just ran.
dm() { cat "$DM_LOG" 2>/dev/null; }

# Every message the suite has composed so far, across all cases.
dm_all() { cat "$DM_ALL" 2>/dev/null; }

# The prompt plan-now is handed. Only the leading /plan line matters to it.
PROMPT="$TMP/prompt.md"
printf '/plan a throwaway task for bin/test-plan-now\n' > "$PROMPT"

# Recovery needs a prompt the runner can read a slug back out of. This is the
# shape real prompts use — see any /tmp/plan-now-*.prompt.
RECOVERY_PROMPT="$TMP/recovery-prompt.md"
{
    printf '/plan a throwaway task for bin/test-plan-now\n'
    printf -- '- Branch slug: `demo-slug`. Base: `master`.\n'
} > "$RECOVERY_PROMPT"

# The negative twin: a prompt with no slug line at all. Both recovery legs need a
# slug, so this is the "no identity available" path — and measured over the 70
# real /tmp/plan-now-*.prompt files on disk, only 15 carry a parseable slug line
# (5 of the 10 most recent), so this is the COMMON shape, not an edge case. Its
# verdict must stay byte-identical to today's.
NOSLUG_PROMPT="$TMP/noslug-prompt.md"
printf '/plan a throwaway task for bin/test-plan-now with no slug line\n' > "$NOSLUG_PROMPT"

# ── The stub model ────────────────────────────────────────────────────────────
# Stands in for `claude -p`: writes a plan file (unless STUB_NO_PLAN), then prints
# ONLY what a text-mode run would emit — the final assistant message. $STUB_TAIL is
# whatever that message ends with.
STUB="$TMP/claude-stub"
cat > "$STUB" <<'STUB_EOF'
#!/usr/bin/env bash
if [ -n "${STUB_PLAN:-}" ] && [ -z "${STUB_NO_PLAN:-}" ]; then
    # $STUB_PLAN_SRC writes a plan that PASSES check-plan; the one-liner fails it.
    # Both are needed — the notify cases below turn on which side of the gate the
    # run lands, and every earlier case relies on the one-liner failing.
    if [ -n "${STUB_PLAN_SRC:-}" ]; then
        cat "$STUB_PLAN_SRC" > "$STUB_PLAN"
    else
        printf '# stub plan\n' > "$STUB_PLAN"
    fi
fi
if [ -n "${STUB_DRAFT:-}" ]; then
    # The runner takes $started with whole-second granularity, and the recovery
    # gate is mtime > started. A real run takes minutes; this stub takes
    # milliseconds, so without this sleep the draft lands in the same second and
    # reads as stale. One second, only when a draft is requested.
    sleep 1
    mkdir -p "$(dirname "$STUB_DRAFT")"
    cat "$STUB_DRAFT_SRC" > "$STUB_DRAFT"
fi
# Leg B (marker omitted from a successful run): the stub creates plan files in
# $PLANS_DIR directly and leaves no draft. No sleep is needed for the first —
# leg B gates on the plan-dir diff, not mtime — but the SECOND file must be
# strictly newer, because "newest wins" is what case 8 exists to pin.
if [ -n "${STUB_PLANFILE:-}" ]; then
    mkdir -p "$(dirname "$STUB_PLANFILE")"
    cat "$STUB_PLANFILE_SRC" > "$STUB_PLANFILE"
fi
if [ -n "${STUB_PLANFILE2:-}" ]; then
    sleep 1
    cat "$STUB_PLANFILE2_SRC" > "$STUB_PLANFILE2"
fi
printf 'Done — the plan is written and check-plan is clean.\n'
[ -n "${STUB_TAIL:-}" ] && printf '%s\n' "$STUB_TAIL"
# $STUB_RC emulates the crashed/timed-out run — rc 124 is the runner's timeout kill.
exit "${STUB_RC:-0}"
STUB_EOF
chmod +x "$STUB"

# run_case <plan-file-the-stub-writes> <final-message-tail>  → transcript on stdout
# $DISP overrides the disposition (default --implement, as every pre-DM case
# assumed); $NODM adds --no-dm. Both are per-case env prefixes, not arguments,
# so the existing call sites keep working unchanged.
run_case() {
    local plan_path="$1" tail_line="$2"
    rm -f "$PLANS"/*.md
    : > "$DM_LOG"
    local dry runner
    dry=$(PLAN_NOW_DRY_RUN=1 PLAN_NOW_CLAUDE="$STUB" PLAN_NOW_PLANS_DIR="$PLANS" \
              PLAN_NOW_DISCORD_DM="$DM_STUB" PLAN_NOW_AUTOMOUSE_QUEUE="$QUEUE_STUB" \
              "$PLAN_NOW" "${DISP:---implement}" ${NODM:+--no-dm} "$PROMPT" 2>&1)
    runner=$(printf '%s\n' "$dry" | sed -n 's/^  runner: //p')
    [ -x "$runner" ] || { printf 'could not get a runner out of plan-now:\n%s\n' "$dry"; return 1; }
    STUB_PLAN="$plan_path" STUB_TAIL="$tail_line" STUB_NO_PLAN="${STUB_NO_PLAN:-}" \
        STUB_PLAN_SRC="${STUB_PLAN_SRC:-}" STUB_RC="${STUB_RC:-0}" \
        QUEUE_FAIL="${QUEUE_FAIL:-}" QUEUE_ALREADY="${QUEUE_ALREADY:-}" DM_FAIL="${DM_FAIL:-}" \
        bash "$runner" 2>&1
    rm -f "$runner"
}

# Every recovery case starts from an empty plan dir. That wipe is `rm -f` against
# a glob, so it is routed through one guarded helper rather than repeated: if
# $PLANS were ever empty the bare form is `rm -f /*.md`, and if it resolved to the
# real ~/claude-plans it would delete live, unqueued, un-backed-up plans. $PLANS
# is a $TMP subdirectory (existing harness, lines 32-36); assert that before
# deleting anything.
plans_reset() {
    case "$PLANS" in
        "$TMP"/*) ;;
        *) echo "test-plan-now: refusing to wipe \$PLANS='$PLANS' — not under \$TMP" >&2
           exit 1 ;;
    esac
    rm -f "$PLANS"/*.md; rm -rf "$PLANS/.drafts"; mkdir -p "$PLANS/.drafts"
}

# Wipe only the automouse disposition dirs — not queue (which the pre-flight
# cases explicitly populate to simulate existing artifacts). Guards against the
# same path-safety hazard as plans_reset.
ndir_reset() {
    case "$NDIR" in
        "$TMP"/*) ;;
        *) echo "test-plan-now: refusing to wipe \$NDIR='$NDIR' — not under \$TMP" >&2
           exit 1 ;;
    esac
    rm -f "$NDIR/queue"/*.md "$NDIR/done"/*.md "$NDIR/skipped"/*.md
}

# run_case_recovery <draft-src-or-empty> <draft-slug> [stale] → transcript
# Fires plan-now with the slug-bearing prompt, no PLAN_FILE: tail, and (unless
# empty) a draft the stub writes mid-run under $PLANS/.drafts/<slug>.draft.md.
run_case_recovery() {
    local src="$1" slug="$2" stale="${3:-}"
    plans_reset
    : > "$DM_LOG"
    local dry runner draft=""
    [ -n "$src" ] && draft="$PLANS/.drafts/$slug.draft.md"
    dry=$(PLAN_NOW_DRY_RUN=1 PLAN_NOW_CLAUDE="$STUB" PLAN_NOW_PLANS_DIR="$PLANS" \
              PLAN_NOW_DISCORD_DM="$DM_STUB" PLAN_NOW_AUTOMOUSE_QUEUE="$QUEUE_STUB" \
              "$PLAN_NOW" "${DISP:---implement}" "$RECOVERY_PROMPT" 2>&1)
    runner=$(printf '%s\n' "$dry" | sed -n 's/^  runner: //p')
    [ -x "$runner" ] || { printf 'no runner:\n%s\n' "$dry"; return 1; }
    if [ -n "$draft" ] && [ "$stale" = stale ]; then
        # Written up front and back-dated, so the stub must not rewrite it.
        mkdir -p "$(dirname "$draft")"; cat "$src" > "$draft"
        touch -t 202001010000 "$draft"
        STUB_NO_PLAN=1 STUB_TAIL="" bash "$runner" 2>&1
    else
        STUB_NO_PLAN=1 STUB_TAIL="" STUB_DRAFT="$draft" STUB_DRAFT_SRC="$src" \
            QUEUE_FAIL="${QUEUE_FAIL:-}" QUEUE_ALREADY="${QUEUE_ALREADY:-}" bash "$runner" 2>&1
    fi
    rm -f "$runner"
}

# Remove any plist/runner that PLAN_NOW_DRY_RUN=1 wrote but the test did not
# execute (e.g., the dup gate declined before the runner was launched). Without
# this, declined pre-flight cases leave RunAtLoad plists in ~/Library/LaunchAgents
# pointing at deleted /tmp runners. $1 is the captured stdout from plan-now.
preflight_cleanup() {
    rm -f "$(printf '%s\n' "$1" | sed -n 's/^  plist:  //p')" \
          "$(printf '%s\n' "$1" | sed -n 's/^  runner: //p')"
}

# run_preflight <prompt-file> [--queue|--implement] [--no-dm]
# Fires plan-now under DRY_RUN=1 with the dup-gate seam active and captures
# exit code (PRE_RC) + stdout+stderr (PRE_OUT). Does NOT reset NDIR — case
# bodies carry explicit touch/ndir_reset calls so the artifact state is clear.
run_preflight() {
    local f="$1"; shift
    : > "$DM_LOG"
    PRE_RC=0
    PRE_OUT=$(PLAN_NOW_PLANS_DIR="$PLANS" NIGHTLY_DIR="$NDIR" PLAN_NOW_DRY_RUN=1 \
        PLAN_NOW_DISCORD_DM="$DM_STUB" PLAN_NOW_AUTOMOUSE_QUEUE="$QUEUE_STUB" \
        "$PLAN_NOW" "$@" "$f" 2>&1) || PRE_RC=$?
    preflight_cleanup "$PRE_OUT"
}

# run_case_recovery_plan <prompt> <src1> <name1> [<src2> <name2>] → transcript
# Leg B's shape: no draft anywhere, no PLAN_FILE: tail, and the stub creates
# <name1> (and optionally a strictly-newer <name2>) directly in $PLANS. The
# prompt is the first argument because one case needs the slugless one.
run_case_recovery_plan() {
    local prompt="$1" src1="$2" name1="$3" src2="${4:-}" name2="${5:-}"
    plans_reset
    : > "$DM_LOG"
    local dry runner
    dry=$(PLAN_NOW_DRY_RUN=1 PLAN_NOW_CLAUDE="$STUB" PLAN_NOW_PLANS_DIR="$PLANS" \
              PLAN_NOW_DISCORD_DM="$DM_STUB" PLAN_NOW_AUTOMOUSE_QUEUE="$QUEUE_STUB" \
              "$PLAN_NOW" "${DISP:---implement}" "$prompt" 2>&1)
    runner=$(printf '%s\n' "$dry" | sed -n 's/^  runner: //p')
    [ -x "$runner" ] || { printf 'no runner:\n%s\n' "$dry"; return 1; }
    STUB_NO_PLAN=1 STUB_TAIL="" \
        STUB_PLANFILE="${name1:+$PLANS/$name1}" STUB_PLANFILE_SRC="$src1" \
        STUB_PLANFILE2="${name2:+$PLANS/$name2}" STUB_PLANFILE2_SRC="$src2" \
        bash "$runner" 2>&1
    rm -f "$runner"
}

want()    { case "$2" in *"$3"*) ok "$1" ;; *) fail "$1 — expected to see: $3" ;; esac; }
want_no() { case "$2" in *"$3"*) fail "$1 — should NOT have seen: $3" ;; *) ok "$1" ;; esac; }

P="$PLANS/demo-slug.md"

GOOD_DRAFT="$TMP/good.draft.md"
cat > "$GOOD_DRAFT" <<'FIXTURE_EOF'
# demo-slug — a throwaway plan for bin/test-plan-now
<!-- PLAN OUTLINE (loop scaffold; dropped at Step 5):
1. Phase 1: touch one comment
2. Critical Files
3. Verification Matrix
-->
---
title: "test-plan-now recovery fixture"
slug: demo-slug
branch: demo-slug
base: master
commit_type: "chore"
auto_merge: false
impl_model: sonnet
last_verified: 2026-07-29
---

## Phase 1: Adjust one comment in `bin/plan-now`

**Tier:** Sonnet — at run model.

Anchor (bin/plan-now, line 210) — match this line and extend the comment above it:

```
# CLAUDE_HEADLESS=1 marks the run unattended (skills branch on it).
```

Reuse the existing heredoc; no new helper, no new file.

### Verification

`bash -n bin/plan-now` exits 0; negative leg below.

## Critical Files

- `bin/plan-now` (the only file this fixture claims to touch)

## Verification Matrix

| # | What to verify | Test type | Timing | Location |
|---|---|---|---|---|
| 1 | `bin/plan-now` still parses | CLI-executable | post-impl | `bash -n bin/plan-now` |
| 2 | negative: no stray marker text added | CLI-executable | post-impl | `grep -c PLAN_FILE bin/plan-now` |

## Automouse Hold Justification

Intrinsic: this fixture exists only inside `bin/test-plan-now` and must never arm auto-merge.
FIXTURE_EOF

PARTIAL_DRAFT="$TMP/partial.draft.md"
printf '# stub\n' > "$PARTIAL_DRAFT"

# Leg B needs a plan file that PASSES check-plan. Rather than author and maintain
# a second ~50-line fixture in promoted form, case 1 hands us one: it promotes
# GOOD_DRAFT with the real promote_draft and then asserts check-plan passed, so
# a copy taken there is clean by construction and can never drift from the
# promoter. It must live outside $PLANS — every recovery runner wipes $PLANS/*.md.
GOOD_PLAN="$TMP/good.plan.md"

echo "── identification: the shapes a model actually emits ──"

out=$(run_case "$P" "PLAN_FILE: $P")
want "bare marker on the last line identifies the plan" "$out" "plan-now: new plan -> $P"

# ★ THE REGRESSION. The one real transcript closed with `**Plan:** ` + a backticked
# path, so bold/backticks are the deviation we have evidence for. The pre-fix regex
# was anchored `^[[:space:]]*PLAN_FILE:` and matched none of the three below.
out=$(run_case "$P" "**PLAN_FILE:** $P")
want "bold-wrapped marker still identifies the plan" "$out" "plan-now: new plan -> $P"

out=$(run_case "$P" "- PLAN_FILE: \`$P\`")
want "list-prefixed + backticked path still identifies the plan" "$out" "plan-now: new plan -> $P"

# Asserting on `RESULT degraded`, NOT on the substring "check-plan": the unconfirmed
# branch prints "check-plan was NOT run", so a substring test there passes whether or
# not the gate ever ran. `degraded` is printed only after check-plan actually executed
# and failed — which it does here, the stub plan being one line of nothing.
out=$(run_case "$P" "PLAN_FILE: $P")
want "an identified plan actually reaches the check-plan gate" "$out" "RESULT degraded"

echo "── fail-safe: a bad marker costs 'unconfirmed', never a wrong green ──"

# This is the original bug verbatim: a clean run, a written plan, and a final message
# with no marker in it (the marker went out early and text mode discarded it).
out=$(run_case "$P" "")
want "no marker → unconfirmed" "$out" "RESULT unconfirmed"
want_no "no marker → check-plan is NOT run" "$out" "plan-now: new plan ->"

out=$(run_case "$P" "PLAN_FILE: /etc/passwd")
want "marker outside \$PLANS_DIR is rejected" "$out" "ignoring PLAN_FILE outside"
want "marker outside \$PLANS_DIR → unconfirmed" "$out" "RESULT unconfirmed"

out=$(STUB_NO_PLAN=1 run_case "$P" "PLAN_FILE: $P")
want "marker naming a nonexistent file is rejected" "$out" "named a file that does not exist"
want "marker naming a nonexistent file → unconfirmed" "$out" "RESULT unconfirmed"

echo "── draft recovery: a backgrounded architect must not cost the whole run ──"

# 1. Recovery success.
out=$(run_case_recovery "$GOOD_DRAFT" demo-slug)
want "fresh draft under this run's slug is recovered"     "$out" "RESULT degraded (recovered)"
want "the recovery names its source draft"                "$out" "recovered from:"
want "the promoted plan is announced"                     "$out" "plan -> $P"
want "recovery is not silently queued under --implement"  "$out" "NOT queued"
[ -f "$P" ] && ok "promoted plan exists on disk" || fail "promoted plan missing at $P"
grep -q '^---$' <(head -1 "$P") && ok "frontmatter was hoisted to line 1" \
    || fail "line 1 of $P is not '---' — the hoist did not fire"
[ -f "$PLANS/.drafts/demo-slug.draft.md" ] \
    && fail "draft should be deleted after a passing check-plan" \
    || ok "draft removed once check-plan passed"
# Harvest the leg-B fixture here and nowhere else: $P was just written by the real
# promoter and check-plan passed on it above, so this copy is clean by
# construction. It must be taken before case 2, whose runner wipes $PLANS/*.md.
# Hard-fail loudly: every leg-B case below feeds on this file, so without this
# guard a single leg-A defect reports as five misleading leg-B failures instead of
# one root cause (exactly how the GNU-stat bug read in CI).
cp "$P" "$GOOD_PLAN" 2>/dev/null \
    || fail "leg-B fixture not harvested from $P — fix case 1 first; every leg-B case below is downstream of this"

# 2. Stale draft — same slug, old mtime.
out=$(run_case_recovery "$GOOD_DRAFT" demo-slug stale)
want    "stale draft is not adopted"          "$out" "RESULT unconfirmed"
want_no "stale draft does not report recovery" "$out" "degraded (recovered)"
[ -f "$P" ] && fail "stale draft must not be promoted" || ok "stale draft left in place"

# 3. No draft — the wording must not have drifted.
out=$(run_case_recovery "" demo-slug)
want "no draft → verbatim line 1" "$out" \
     "plan-now: RESULT unconfirmed — the run printed no usable 'PLAN_FILE:' line,"
want "no draft → verbatim line 2" "$out" \
     "plan-now: so its plan cannot be identified, check-plan was NOT run, and nothing was queued."
want "no draft → verbatim closer" "$out" "plan-now: read the transcript above."
want_no "no draft → no recovery chatter" "$out" "recovery"

# 4. Partial draft that cannot pass check-plan.
out=$(run_case_recovery "$PARTIAL_DRAFT" demo-slug)
want    "partial draft reports an attempted recovery" "$out" "RESULT degraded (recovery attempted)"
want    "a failed recovery is not queued"             "$out" "NOT queued"
want_no "a failed recovery is not reported as recovered" "$out" "RESULT degraded (recovered)"
want    "the draft is kept for a human"               "$out" "The draft is kept at"
[ -f "$PLANS/.drafts/demo-slug.draft.md" ] && ok "failed recovery keeps its draft" \
    || fail "draft was deleted despite a failing check-plan"

# 5. Peer slug — a fresh draft that belongs to somebody else.
out=$(run_case_recovery "$GOOD_DRAFT" other-slug)
want    "a peer run's draft is never adopted" "$out" "RESULT unconfirmed"
want_no "a peer run's draft is not promoted"  "$out" "degraded (recovered)"
want    "an unattributable fresh draft is at least reported" "$out" "cannot be attributed to it"
[ -f "$PLANS/other-slug.md" ] && fail "peer draft must not be promoted" \
    || ok "peer draft left untouched"

# 6. Regression: a valid marker still wins, and recovery never preempts it.
out=$(run_case "$P" "PLAN_FILE: $P")
want    "REGRESSION: marker path still identifies the plan" "$out" "plan-now: new plan -> $P"
want_no "REGRESSION: marker path never enters recovery"     "$out" "recovery"

echo "── marker-omission recovery (leg B): a run that succeeded and forgot PLAN_FILE: ──"

# 7. Leg B success. No draft anywhere; the run created its own plan file and
#    printed a clean closing message without the marker.
out=$(run_case_recovery_plan "$RECOVERY_PROMPT" "$GOOD_PLAN" demo-slug.md)
want    "leg B adopts this run's own plan file"          "$out" "RESULT degraded (recovered)"
want    "leg B names itself in the log"                  "$out" "recovery B —"
want    "leg B announces the adopted plan"               "$out" "plan -> $P"
want_no "leg B invents no source draft"                  "$out" "recovered from:"
want_no "leg B never claims a draft was promoted"        "$out" "recovery A"
want    "leg B is not silently queued under --implement" "$out" "NOT queued"
[ -f "$P" ] && ok "the adopted plan is left on disk untouched" || fail "adopted plan vanished"

# 8. THE TRAP — the whole reason leg B exists in this shape. One run, two files:
#    a SUPERSEDED <slug>.md and the live, newer <slug>-3.md. Measured on the real
#    2026-07-29 12:57 run, the superseded file PASSES check-plan, so check-plan
#    cannot break the tie and an oldest-or-arbitrary pick would confirm — and
#    under --queue implement — a stale plan. Newest must win.
out=$(run_case_recovery_plan "$RECOVERY_PROMPT" "$GOOD_PLAN" demo-slug.md \
                             "$GOOD_PLAN" demo-slug-3.md)
want    "the newest slug match is adopted"        "$out" "plan -> $PLANS/demo-slug-3.md"
want_no "the superseded sibling is NOT adopted"   "$out" "plan -> $P"
want    "the trap case still reports recovered"   "$out" "RESULT degraded (recovered)"

# 9. A file this run created is NOT enough — the basename must be this run's slug
#    as <slug>.md or <slug>-<n>.md. `demo-slug-extra.md` is what a bare
#    <slug>*.md glob would wrongly swallow.
out=$(run_case_recovery_plan "$RECOVERY_PROMPT" "$GOOD_PLAN" demo-slug-extra.md)
want    "a prefix-matching peer slug is never adopted"   "$out" "RESULT unconfirmed"
want_no "a prefix-matching peer reports no recovery"     "$out" "degraded (recovered)"
want    "the pre-existing best-effort guess still prints" "$out" "best-effort guess"

# 10. No slug in the prompt → no identity → the verdict must not change at all.
#     This is the majority shape of real prompts, so it is the regression that
#     matters most.
out=$(run_case_recovery_plan "$NOSLUG_PROMPT" "$GOOD_PLAN" demo-slug.md)
want    "a slugless prompt falls through verbatim" "$out" \
        "plan-now: RESULT unconfirmed — the run printed no usable 'PLAN_FILE:' line,"
want    "a slugless prompt keeps the verbatim closer" "$out" "plan-now: read the transcript above."
want_no "a slugless prompt attempts no leg B"      "$out" "recovery B"

# 11. Adopted plan that fails check-plan → attempted, never queued, and no draft
#     is claimed to be kept, because leg B never had one.
out=$(run_case_recovery_plan "$RECOVERY_PROMPT" "$PARTIAL_DRAFT" demo-slug.md)
want    "a failing adopted plan reports an attempt" "$out" "RESULT degraded (recovery attempted)"
want    "a failing adopted plan is not queued"      "$out" "NOT queued"
want_no "leg B claims no draft it never had"        "$out" "The draft is kept at"

echo "── the finish DM: every terminal outcome pings, and says what to do next ──"

# The reason this section exists: `claude -p` does not stream, so $LOG is empty
# until the run exits and the only way to learn a plan-now run finished was to sit
# on `tail -f`. Every branch of the verdict chain must therefore compose a message,
# and the branch that needs a human most — the one that does NOT queue itself — is
# the one that must say so.

# 1. ok + --queue: check-plan passed and the job queued it. Nothing to do.
out=$(DISP=--queue STUB_PLAN_SRC="$GOOD_PLAN" run_case "$P" "PLAN_FILE: $P")
want "queued run reaches RESULT ok"      "$out" "RESULT ok"
want "queued run DMs the ok icon"        "$(dm)" "✅ plan-now: demo-slug"
want "queued run DMs the verdict"        "$(dm)" "RESULT ok — check-plan PASSED"
want "queued run DMs the next action"    "$(dm)" "queued for automouse"
want "queued run DMs the plan path"      "$(dm)" "$P"
want "queued run DMs the log path"       "$(dm)" "log: /tmp/plan-now-"
want "queued run DMs the elapsed time"   "$(dm)" "s · "

# 2. ok + --implement: the case the user called out by name. It succeeded, and it
#    is sitting there waiting for a human who has no way to know that.
out=$(STUB_PLAN_SRC="$GOOD_PLAN" run_case "$P" "PLAN_FILE: $P")
want "implement run still DMs on success" "$(dm)" "✅ plan-now: demo-slug"
want "implement run says it needs you"    "$(dm)" "--implement — NOT queued, needs you"
want_no "implement run never claims a queue" "$(dm)" "queued for automouse"

# 3. ok, but the queue call itself failed — a green verdict with a red outcome.
#    The icon must follow the OUTCOME, not the check-plan verdict.
out=$(DISP=--queue QUEUE_FAIL=1 STUB_PLAN_SRC="$GOOD_PLAN" run_case "$P" "PLAN_FILE: $P")
want "a failed queue call is still RESULT ok in the log" "$out" "RESULT ok"
want "a failed queue call downgrades the DM icon"        "$(dm)" "⚠️ plan-now: demo-slug"
want "a failed queue call names itself in the DM"        "$(dm)" "automouse-queue FAILED"
want "a failed queue call says a human is needed"        "$(dm)" "NOT queued, needs you"

# 4. check-plan FAILED — the stub's one-line plan, i.e. every earlier case here.
out=$(run_case "$P" "PLAN_FILE: $P")
want "a failed check-plan DMs the warning icon" "$(dm)" "⚠️ plan-now: demo-slug"
want "a failed check-plan DMs its verdict"      "$(dm)" "RESULT degraded — check-plan FAILED"
want "a failed check-plan says a human is needed" "$(dm)" "NOT queued, needs you"

# 5. rc != 0. The plan is unidentified, so the DM falls back to the prompt slug —
#    and $PROMPT carries none, which is the majority shape of real prompts.
out=$(STUB_RC=1 run_case "$P" "PLAN_FILE: $P")
want "a crashed run is still RESULT failed"  "$out" "RESULT failed"
want "a crashed run DMs the failure icon"    "$(dm)" "❌ plan-now:"
want "a crashed run DMs its verdict"         "$(dm)" "RESULT failed — the run did not exit cleanly"
want "a slugless crashed run titles itself"  "$(dm)" "plan-now: (unidentified)"

# 6. rc 124 is the $RUN_TIMEOUT kill, and a DM that just says "failed" would send
#    you to the log to find that out.
out=$(STUB_RC=124 run_case "$P" "PLAN_FILE: $P")
want "a timed-out run names the timeout in the DM" "$(dm)" "failed — killed by the ${RUN_TIMEOUT}s timeout"

# 7. unconfirmed — no marker, no recovery.
out=$(run_case "$P" "")
want "an unconfirmed run DMs the question icon" "$(dm)" "❓ plan-now:"
want "an unconfirmed run DMs its verdict"       "$(dm)" "RESULT unconfirmed — no PLAN_FILE: line"

# 8. Recovery: the DM must report the RECOVERED plan, not silence.
out=$(run_case_recovery "$GOOD_DRAFT" demo-slug)
want "a recovered run DMs the recovery verdict" "$(dm)" "RESULT degraded (recovered) — check-plan PASSED"
want "a recovered run titles itself by the recovered plan" "$(dm)" "plan-now: demo-slug"
want "a recovered run under --implement needs you" "$(dm)" "--implement — NOT queued, needs you"

# 8b. Same, but queued. A recovered plan that passes check-plan is queued like any
#     other, and the DM has to say so — "degraded" alone would read as needing a
#     human when nothing is owed.
out=$(DISP=--queue run_case_recovery "$GOOD_DRAFT" demo-slug)
want "a recovered+queued run keeps the recovery verdict" "$(dm)" "RESULT degraded (recovered) — check-plan PASSED"
want "a recovered+queued run says it queued"             "$(dm)" "queued for automouse"
want_no "a recovered+queued run does not ask for you"    "$(dm)" "needs you"

# 8c. Recovery that could not be salvaged: a promoted draft that still fails
#     check-plan. Distinct from case 4 — the plan EXISTS and is named, so the DM
#     must point at it rather than leave you hunting the log for a path.
out=$(run_case_recovery "$PARTIAL_DRAFT" demo-slug)
want "an attempted recovery DMs its own verdict" "$(dm)" \
     "RESULT degraded (recovery attempted) — check-plan FAILED"
want "an attempted recovery says a human is needed" "$(dm)" "NOT queued, needs you"
want "an attempted recovery names the plan it promoted" "$(dm)" "demo-slug"

# 8d. Recovered, queued, and the queue call failed — the recovery arm's copy of
#     case 3. The verdict must carry BOTH failures, not just the recovery.
out=$(DISP=--queue QUEUE_FAIL=1 run_case_recovery "$GOOD_DRAFT" demo-slug)
want "a recovered run whose queue failed names the queue" "$(dm)" \
     "degraded (recovered) — check-plan PASSED, but automouse-queue FAILED"
want "a recovered run whose queue failed asks for you" "$(dm)" "NOT queued, needs you"

# 9. --no-dm suppresses the send entirely, and nothing else changes.
out=$(NODM=1 STUB_PLAN_SRC="$GOOD_PLAN" run_case "$P" "PLAN_FILE: $P")
want    "--no-dm leaves the verdict alone" "$out" "RESULT ok"
[ -s "$DM_LOG" ] && fail "--no-dm still sent a DM" || ok "--no-dm sends nothing"

# 10. An undeliverable DM is never fatal — discord-dm spools it, and the verdict
#     in the log is the record of last resort. Losing the run over a lost message
#     would be strictly worse than the tail -f this replaces.
out=$(DM_FAIL=1 STUB_PLAN_SRC="$GOOD_PLAN" run_case "$P" "PLAN_FILE: $P")
want "an undeliverable DM is reported in the log" "$out" "DM UNDELIVERED"
want "an undeliverable DM does not change the verdict" "$out" "RESULT ok"

# 11. Every terminal branch sets a verdict. The fallback text exists so a seventh
#     branch added later fails loudly instead of DMing a blank line — if it ever
#     appears in a real run's DM, that is the bug it was put there to catch.
# A want_no over an empty file passes vacuously, so prove the capture ran first.
[ -s "$DM_ALL" ] || fail "the cumulative DM capture is empty — case 11 proves nothing"
want_no "no case DMs the unset-verdict fallback" "$(dm_all)" "the runner set no verdict"

echo "── two back-to-back invocations get unique artifact paths ──"

dry1=$(PLAN_NOW_DRY_RUN=1 PLAN_NOW_CLAUDE="$STUB" PLAN_NOW_PLANS_DIR="$PLANS" \
          PLAN_NOW_DISCORD_DM="$DM_STUB" PLAN_NOW_AUTOMOUSE_QUEUE="$QUEUE_STUB" \
          "$PLAN_NOW" --implement "$PROMPT" 2>&1)
rm -f "$(printf '%s\n' "$dry1" | sed -n 's/^  plist:  //p')"
prompt1=$(printf '%s\n' "$dry1" | sed -n 's/^  prompt: //p')

dry2=$(PLAN_NOW_DRY_RUN=1 PLAN_NOW_CLAUDE="$STUB" PLAN_NOW_PLANS_DIR="$PLANS" \
          PLAN_NOW_DISCORD_DM="$DM_STUB" PLAN_NOW_AUTOMOUSE_QUEUE="$QUEUE_STUB" \
          "$PLAN_NOW" --implement "$PROMPT" 2>&1)
rm -f "$(printf '%s\n' "$dry2" | sed -n 's/^  plist:  //p')"
prompt2=$(printf '%s\n' "$dry2" | sed -n 's/^  prompt: //p')

[ -n "$prompt1" ] || fail "first DRY_RUN produced no prompt: line — extraction failed"
[ -n "$prompt2" ] || fail "second DRY_RUN produced no prompt: line — extraction failed"
[ "$prompt1" != "$prompt2" ] \
    || fail "both DRY_RUN invocations produced identical prompt paths — TS collision: $prompt1"

echo "── pre-flight duplicate gate ──"

# Start from a clean slate.  The DM section may have left plan files in $PLANS
# (e.g., STUB_PLAN_SRC cases write to $P = $PLANS/demo-slug.md).  With
# PLANS_DIR exported, plan-dup-check now checks $PLANS as well as $NDIR, so
# any leftover file there would cause false-positive declines in cases below.
ndir_reset
rm -f "$PLANS"/*.md

# Pre-flight cases share two prompts:
#   $RECOVERY_PROMPT  — slug = "demo-slug" (triggers the gate on any artifact match)
#   $NOSLUG_PROMPT    — no slug line (gate always passes; this is the COMMON shape)
# PRE_RC / PRE_OUT are set by run_preflight; the artifact that plan-now writes
# under DRY_RUN=1 is cleaned up by run_preflight via preflight_cleanup.

# 1. Incident replay: a queue artifact already exists → gate declines (exit 3),
#    output names the artifact path and the recovery command.
touch "$NDIR/queue/demo-slug.md"
run_preflight "$RECOVERY_PROMPT" --queue
[ "$PRE_RC" = 3 ] && ok "incident replay: exits 3" || fail "incident replay: exits 3 (got $PRE_RC)"
want "incident replay: output names queue path"      "$PRE_OUT" "$NDIR/queue/demo-slug.md"
want "incident replay: output names recovery command" "$PRE_OUT" "bin/automouse/queue remove demo-slug"
want_no "incident replay: runner not written on decline" "$PRE_OUT" "runner:"

# 2. No false positive — empty NDIR, no matching plan file → gate passes → plan-now
#    proceeds and writes a runner.
ndir_reset
run_preflight "$RECOVERY_PROMPT" --queue
[ "$PRE_RC" = 0 ] && ok "no false positive: exits 0" || fail "no false positive: exits 0 (got $PRE_RC)"
want "no false positive: runner is written" "$PRE_OUT" "runner:"

# 3. No slug in prompt → gate is skipped even when artifacts exist → proceeds.
touch "$NDIR/queue/demo-slug.md"
run_preflight "$NOSLUG_PROMPT" --queue
[ "$PRE_RC" = 0 ] && ok "no-slug: exits 0 (no false positive)" || fail "no-slug: exits 0 (got $PRE_RC)"
want "no-slug: runner is written" "$PRE_OUT" "runner:"

# 4. --implement disposition → gate is skipped entirely → proceeds (artifact irrelevant).
run_preflight "$RECOVERY_PROMPT" --implement
[ "$PRE_RC" = 0 ] && ok "--implement: gate skipped, exits 0" || fail "--implement: gate skipped (got $PRE_RC)"
want "--implement: runner is written" "$PRE_OUT" "runner:"
ndir_reset

# 5. Plans-file signal: a matching .md already in $PLANS → gate declines (exit 3).
touch "$PLANS/demo-slug.md"
run_preflight "$RECOVERY_PROMPT" --queue
[ "$PRE_RC" = 3 ] && ok "plans-file signal: exits 3" || fail "plans-file signal: exits 3 (got $PRE_RC)"
want "plans-file signal: names the plan path" "$PRE_OUT" "$PLANS/demo-slug.md"
rm -f "$PLANS/demo-slug.md"

# 6. done/ signal: an already-implemented artifact → gate declines.
touch "$NDIR/done/demo-slug.md"
run_preflight "$RECOVERY_PROMPT" --queue
[ "$PRE_RC" = 3 ] && ok "done/ signal: exits 3" || fail "done/ signal: exits 3 (got $PRE_RC)"
want "done/ signal: names the done path" "$PRE_OUT" "$NDIR/done/demo-slug.md"
ndir_reset

# 7. skipped/ signal: a previously-skipped artifact → gate declines.
touch "$NDIR/skipped/demo-slug.md"
run_preflight "$RECOVERY_PROMPT" --queue
[ "$PRE_RC" = 3 ] && ok "skipped/ signal: exits 3" || fail "skipped/ signal: exits 3 (got $PRE_RC)"
want "skipped/ signal: names the skipped path" "$PRE_OUT" "$NDIR/skipped/demo-slug.md"
ndir_reset

# 8. --no-dm suppresses the DM but still declines (exit 3); positive branch
#    confirms the DM IS sent without --no-dm.
touch "$NDIR/queue/demo-slug.md"
DM_BEFORE=$(wc -l < "$DM_ALL")
run_preflight "$RECOVERY_PROMPT" --queue --no-dm
[ "$PRE_RC" = 3 ] && ok "--no-dm: still declines (exit 3)" || fail "--no-dm: still declines (exit 3) (got $PRE_RC)"
DM_AFTER=$(wc -l < "$DM_ALL")
[ "$DM_AFTER" = "$DM_BEFORE" ] && ok "--no-dm: DM stub got no new line" || fail "--no-dm: DM stub got no new line"
run_preflight "$RECOVERY_PROMPT" --queue
want "--dm: DM contains queue artifact path" "$(dm_all)" "$NDIR/queue/demo-slug.md"
ndir_reset

# 9. PLAN_NOW_DUP_CHECK unset → plan-now falls back to the real repo script.
#    The real script reads $NIGHTLY_DIR (exported) and $PLANS_DIR (exported), so
#    it uses the test trees and declines exactly as the stub would.
touch "$NDIR/queue/demo-slug.md"
PRE_RC2=0
PRE_OUT2=$(unset PLAN_NOW_DUP_CHECK; PLAN_NOW_PLANS_DIR="$PLANS" NIGHTLY_DIR="$NDIR" \
    PLAN_NOW_DRY_RUN=1 PLAN_NOW_DISCORD_DM="$DM_STUB" PLAN_NOW_AUTOMOUSE_QUEUE="$QUEUE_STUB" \
    "$PLAN_NOW" --queue "$RECOVERY_PROMPT" 2>&1) || PRE_RC2=$?
[ "$PRE_RC2" = 3 ] && ok "DUP_CHECK unset: repo script declines" || fail "DUP_CHECK unset: repo script declines (got $PRE_RC2)"
want "DUP_CHECK unset: repo script names queue path" "$PRE_OUT2" "$NDIR/queue/demo-slug.md"
preflight_cleanup "$PRE_OUT2"
ndir_reset

# 10. PLAN_NOW_DUP_CHECK set to empty → same as unset; $() falls back to repo script.
touch "$NDIR/queue/demo-slug.md"
PRE_RC3=0
PRE_OUT3=$(PLAN_NOW_DUP_CHECK='' PLAN_NOW_PLANS_DIR="$PLANS" NIGHTLY_DIR="$NDIR" \
    PLAN_NOW_DRY_RUN=1 PLAN_NOW_DISCORD_DM="$DM_STUB" PLAN_NOW_AUTOMOUSE_QUEUE="$QUEUE_STUB" \
    "$PLAN_NOW" --queue "$RECOVERY_PROMPT" 2>&1) || PRE_RC3=$?
[ "$PRE_RC3" = 3 ] && ok "DUP_CHECK empty: repo script declines" || fail "DUP_CHECK empty: repo script declines (got $PRE_RC3)"
want "DUP_CHECK empty: repo script names queue path" "$PRE_OUT3" "$NDIR/queue/demo-slug.md"
preflight_cleanup "$PRE_OUT3"
ndir_reset

# 11. Broken seam (DUP_CHECK not executable) → gate is skipped, plan-now proceeds.
#     A stale/misconfigured path should never block a plan run.
DUP_STUB="$TMP/broken-dup-check"
printf '#!/usr/bin/env bash\nexit 3\n' > "$DUP_STUB"
# Deliberately NOT chmod +x — non-executable, so plan-now's `[ -x ... ]` skips it.
touch "$NDIR/queue/demo-slug.md"
PRE_RC4=0
PRE_OUT4=$(PLAN_NOW_DUP_CHECK="$DUP_STUB" PLAN_NOW_PLANS_DIR="$PLANS" NIGHTLY_DIR="$NDIR" \
    PLAN_NOW_DRY_RUN=1 PLAN_NOW_DISCORD_DM="$DM_STUB" PLAN_NOW_AUTOMOUSE_QUEUE="$QUEUE_STUB" \
    "$PLAN_NOW" --queue "$RECOVERY_PROMPT" 2>&1) || PRE_RC4=$?
[ "$PRE_RC4" = 0 ] && ok "broken seam: gate skipped, exits 0" || fail "broken seam: gate skipped (got $PRE_RC4)"
want "broken seam: runner is written" "$PRE_OUT4" "runner:"
preflight_cleanup "$PRE_OUT4"
ndir_reset

# 11b. Live seam that declines — the mirror of case 11. An EXECUTABLE stub that
#      prints a marker and exits 3 must be honoured end to end: plan-now exits 3,
#      echoes the stub's own output, and forwards it into the DM. Case 11 covers
#      the skip path and case 12 the proceed path; without this one nothing proves
#      a custom PLAN_NOW_DUP_CHECK can decline at all.
DUP_LIVE="$TMP/live-dup-check"
printf '#!/usr/bin/env bash\necho "SEAM-MARKER-11B: duplicate"\nexit 3\n' > "$DUP_LIVE"
chmod +x "$DUP_LIVE"
: > "$DM_LOG"
PRE_RC6=0
PRE_OUT6=$(PLAN_NOW_DUP_CHECK="$DUP_LIVE" PLAN_NOW_PLANS_DIR="$PLANS" NIGHTLY_DIR="$NDIR" \
    PLAN_NOW_DRY_RUN=1 PLAN_NOW_DISCORD_DM="$DM_STUB" PLAN_NOW_AUTOMOUSE_QUEUE="$QUEUE_STUB" \
    "$PLAN_NOW" --queue "$RECOVERY_PROMPT" 2>&1) || PRE_RC6=$?
[ "$PRE_RC6" = 3 ] && ok "live seam: declines with exit 3" || fail "live seam: declines with exit 3 (got $PRE_RC6)"
want "live seam: the stub's marker reaches stdout" "$PRE_OUT6" "SEAM-MARKER-11B"
want "live seam: the decline line is printed"      "$PRE_OUT6" "declined before spending a model run"
want "live seam: the marker reaches the DM"        "$(dm)" "SEAM-MARKER-11B"
want "live seam: the DM says DECLINED"             "$(dm)" "plan-now DECLINED"
want_no "live seam: no runner is ever written"     "$PRE_OUT6" "runner:"
preflight_cleanup "$PRE_OUT6"
ndir_reset

# 12. Non-3 exit from DUP_CHECK (e.g. exit 2 = usage error) → plan-now prints a
#     warning and proceeds; a usage error in the gate should not block a plan run.
DUP_WARN="$TMP/warn-dup-check"
printf '#!/usr/bin/env bash\necho "dup-check: bad args" >&2; exit 2\n' > "$DUP_WARN"
chmod +x "$DUP_WARN"
touch "$NDIR/queue/demo-slug.md"
PRE_RC5=0
PRE_OUT5=$(PLAN_NOW_DUP_CHECK="$DUP_WARN" PLAN_NOW_PLANS_DIR="$PLANS" NIGHTLY_DIR="$NDIR" \
    PLAN_NOW_DRY_RUN=1 PLAN_NOW_DISCORD_DM="$DM_STUB" PLAN_NOW_AUTOMOUSE_QUEUE="$QUEUE_STUB" \
    "$PLAN_NOW" --queue "$RECOVERY_PROMPT" 2>&1) || PRE_RC5=$?
[ "$PRE_RC5" = 0 ] && ok "non-3 exit: warning printed, proceeds" || fail "non-3 exit: warning printed, proceeds (got $PRE_RC5)"
want "non-3 exit: runner is written" "$PRE_OUT5" "runner:"
preflight_cleanup "$PRE_OUT5"
ndir_reset

# 13. Benign re-queue at call site #1, the normal verdict path — the queue stub
#     returns "Already queued (no change)" (QUEUE_ALREADY=1). The run should
#     succeed (exit 0), carry the idempotent message, and — the whole point of
#     the change — never reach the `automouse-queue FAILED` else-branch.
out=$(DISP=--queue STUB_PLAN_SRC="$GOOD_PLAN" QUEUE_ALREADY=1 run_case "$P" "PLAN_FILE: $P")
want "benign re-queue: exit 0 with idempotent message" "$out" "Already queued (no change)"
want "benign re-queue: verdict is ok" "$out" "RESULT ok"
want "benign re-queue: still reports a queue" "$(dm)" "queued for automouse"
want_no "benign re-queue: no false failure in the log" "$out" "automouse-queue FAILED"
want_no "benign re-queue: no false failure in the DM"  "$(dm)" "automouse-queue FAILED"

# 13b. The same benign re-queue at call site #2, the recovery path. It has its
#      own queue call, its own else-branch and its own verdict string, so case 13
#      says nothing about it — without this the recovery arm could still emit the
#      false "automouse-queue FAILED".
out=$(DISP=--queue QUEUE_ALREADY=1 run_case_recovery "$GOOD_DRAFT" demo-slug)
want "benign re-queue (recovery): idempotent message survives" "$out" "Already queued (no change)"
want "benign re-queue (recovery): keeps the recovery verdict" "$(dm)" \
     "RESULT degraded (recovered) — check-plan PASSED"
want "benign re-queue (recovery): says it queued" "$(dm)" "queued for automouse"
want_no "benign re-queue (recovery): no false failure verdict" "$(dm)" "automouse-queue FAILED"

echo "── the coda still tells the model where to put it ──"

dry=$(PLAN_NOW_DRY_RUN=1 PLAN_NOW_CLAUDE="$STUB" PLAN_NOW_PLANS_DIR="$PLANS" \
          "$PLAN_NOW" --implement "$PROMPT" 2>&1)
coda=$(cat "$(printf '%s\n' "$dry" | sed -n 's/^  prompt: //p')" 2>/dev/null)
# This dry-run's runner is never executed, and the runner is what deletes the plist.
# Without this, every test run leaves a RunAtLoad plist in ~/Library/LaunchAgents
# pointing at a /tmp runner that no longer exists.
rm -f "$(printf '%s\n' "$dry" | sed -n 's/^  plist:  //p')"
want "coda demands the FINAL message" "$coda" "FINAL message"
want "coda demands the last line" "$coda" "last line"
# Tolerant parsing is a backstop for prose drift, not a licence to move the
# instruction: under text mode an early-only marker is unreachable, full stop.
want "coda explains why an earlier print is discarded" "$coda" "discarded"
want "coda forbids backgrounding sub-agents"  "$coda" "run_in_background"
want "coda demands foreground sub-agents"     "$coda" "FOREGROUND"
want "coda keeps Agent backticked" "$coda" '`Agent`'

echo
if [ "$FAILS" -eq 0 ]; then
    echo "test-plan-now: all cases passed"
else
    echo "test-plan-now: $FAILS case(s) FAILED"
fi
exit $(( FAILS > 0 ? 1 : 0 ))
