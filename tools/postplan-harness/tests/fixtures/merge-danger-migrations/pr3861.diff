diff --git a/ibl5/tests/JsbParser/Importers/AswImporterTest.php b/ibl5/tests/JsbParser/Importers/AswImporterTest.php
index 15aaa54784..4fb2221093 100644
--- a/ibl5/tests/JsbParser/Importers/AswImporterTest.php
+++ b/ibl5/tests/JsbParser/Importers/AswImporterTest.php
@@ -4,114 +4,25 @@
 
 namespace Tests\JsbParser\Importers;
 
-use JsbParser\AswFileParser;
 use JsbParser\Contracts\JsbImportRepositoryInterface;
 use JsbParser\Importers\AswImporter;
 use PHPUnit\Framework\TestCase;
 
+require_once __DIR__ . '/BuildsAswFixtures.php';
+
 /**
  * @covers \JsbParser\Importers\AswImporter
  */
 final class AswImporterTest extends TestCase
 {
+    use BuildsAswFixtures;
+
     /** @var list<array<string, mixed>> */
