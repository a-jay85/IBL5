srt_ck_has   tick.out "no valid prose.json" "log says no valid prose.json"
srt_case_done "assemble_missing_prose_parks_flaky"

# ── assemble_ignores_model_written_payload_json ───────────────────────────────
srt_reset; srt_claim42
touch "$STUB/record-stdin" "$STUB/write-garbage-payload"
srt_run
srt_ck "exit" 0 "$SRT_RC"
srt_ck_lacks store.stdin "GARBAGE-NOT-JSON" "garbage never stored"
srt_ck "stored payload is the assembled one" "1" "$(jq -r '.games[0].sort_order' "$STUB/store.stdin" 2>/dev/null)"
srt_case_done "assemble_ignores_model_written_payload_json"

# ── assemble_single_missing_mention_keeps_one_id_line ─────────────────────────
srt_reset; srt_claim42
touch "$STUB/record-stdin"
printf '{"ok":true,"cmd":"mention-map","teams":{"Team A":"111111111111111111"}}\n' > "$STUB/resp.mention-map"
