| 14 | Phase 4: corpus diff (master regex vs working tree over PR bodies, local transcripts, and the synthetic block) prints `CORPUS-DIFF OK` and exits 0 with `appeared=0 bad=0 synth_old=8 synth_new=2`; reverting the regex ⇒ `synth_new=8` FAIL; `\d+` in the lookahead ⇒ `synth_new=1` FAIL; removing a lookbehind ⇒ `appeared>0` FAIL; adding `for` to the word list ⇒ `BAD:` lines from real refs. | CLI-executable | post-impl | `python3 -c 'import glob,json,os,re,subprocess,sys,collections,types; L=lambda s,n:(lambda m:(sys.modules.__setitem__(n,m),exec(compile(s,n,"exec"),m.__dict__),m.__dict__)[2])(types.ModuleType(n)); old=L(subprocess.check_output(["git","show","origin/master:bin/check-prose"],text=True),"cp_old"); new=L(open("bin/check-prose").read(),"cp_new"); R=lambda ns:[t for t in ns["TELLS"] if t.name=="bare-hash-ref"][0].regex; ro,rn=R(old),R(new); P=new["prose_lines"]; J=lambda s:(json.loads(s) if s.lstrip().startswith("{") else {}); prs=json.loads(subprocess.check_output(["gh","pr","list","--repo","a-jay85/IBL5","--state","all","--limit","400","--json","number,title,body"],text=True)); texts=[str(p.get("title") or "")+"\n"+str(p.get("body") or "") for p in prs]+[b.get("text") or "" for f in glob.glob(os.path.expanduser("~/.claude/projects/-Users-ajaynicolas-GitHub-IBL5*/*.jsonl")) for o in map(J,open(f,encoding="utf-8",errors="replace")) if o.get("type")=="assistant" for b in ((o.get("message") or {}).get("content") or []) if isinstance(b,dict) and b.get("type")=="text"]; synth=["He was the #1 seed and the #1 pick.","the #3 overall pick","they finished #2 in the West","the #8 seeded team","ranked #4 overall","#1234 seed data","#2 in the queue"]; H=lambda r,ts:collections.Counter((l,m.start()) for t in ts for _,l in P(t) for m in r.finditer(l)); ho,hn,so,sn=H(ro,texts),H(rn,texts),H(ro,synth),H(rn,synth); d=ho-hn; a=hn-ho; W=("seed","pick","overall","rank","in the "); M=lambda l,s:re.compile(r"#\d{1,2}\s+").match(l,s); isrank=lambda l,s:(M(l,s) is not None and l[M(l,s).end():].lower().startswith(W)); bad=[l[s:s+40] for (l,s) in d if not isrank(l,s)]; print("old=%d new=%d disappeared=%d appeared=%d bad=%d synth_old=%d synth_new=%d"%(sum(ho.values()),sum(hn.values()),sum(d.values()),sum(a.values()),len(bad),sum(so.values()),sum(sn.values()))); [print("GONE:",l[max(0,s-20):s+30].strip()) for (l,s) in d]; [print("BAD:",x) for x in bad]; [print("NEW:",l[max(0,s-20):s+30].strip()) for (l,s) in a]; ok=(not bad and not a and sum(so.values())==8 and sum(sn.values())==2); print("CORPUS-DIFF OK" if ok else "CORPUS-DIFF FAIL"); sys.exit(0 if ok else 1)'` |
EOF_PLAN
    if [ "$mode" = "tagged" ]; then
        sed -i.bak -E \
            -e 's/^(\| 12 \| .*) \| CLI-executable \|/\1 (one-time-check: evidence is the exit code of one check-prose run at plan time) | CLI-executable |/' \
            -e 's/^(\| 14 \| .*) \| CLI-executable \|/\1 (one-time-check: corpus diff is a one-shot run over local transcripts) | CLI-executable |/' \
            "$dir/plan.md" && rm -f "$dir/plan.md.bak"
    fi
    cat > "$dir/diff.txt" <<'EOF_DIFF'
diff --git a/.claude/rules/prose-style.md b/.claude/rules/prose-style.md
index aa50c8a7d3..0d8cc19474 100644
--- a/.claude/rules/prose-style.md
+++ b/.claude/rules/prose-style.md
@@ -1,6 +1,6 @@
 ---
 description: The AI-tell sentence shapes ("Claude slop") that must not land in repo prose, PR bodies, or chat replies. Lists each tell with its fix, the on-touch policy, and the escape hatches. Enforced by bin/check-prose in CI and by two hooks.
-last_verified: 2026-09-26
+last_verified: 2026-09-30
 paths: "**/*.md"
 ---
 
@@ -45,7 +45,7 @@ Each row is one regex in the script. The fix column is what the deny message pri
