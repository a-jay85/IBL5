#!/usr/bin/env bash
mkdir -p "$RW/fleetlogs"
printf 'post-plan-fleet: %s\n' outcome=failed reason=kind=test > "$RW/fleetlogs/post-plan-fleet-11.log"
printf 'post-plan-fleet: %s\n' outcome=declined reason=holdrepeat > "$RW/fleetlogs/post-plan-fleet-12.log"
exit 0
RDY_EOF
