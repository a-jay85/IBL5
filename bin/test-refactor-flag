#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-refactor-flag — regression test for bin/refactor-flag's test-coverage
# credit, specifically that a RENAMED test file satisfies coverage.
#
# The gate detects refactor signals under ibl5/classes/** (a rename is a high
# signal) and passes only when the PR also touches tests or carries a bypass
# marker. checkTestCoverage() resolved test changes via --diff-filter=A and =M
# but NOT =R, so renaming a test file (e.g. during the very refactor that fires
# the trigger) failed to credit coverage and the gate flagged the PR spuriously.
# This pins the fix plus two controls so the credit is not over-broadened.
#
# Each case builds a throwaway git repo under mktemp with a committed baseline
# (a classes file + a matching test file), STAGES changes, and runs
# `bin/refactor-flag --staged` from inside. --staged uses `git diff --cached`,
# never calls `gh`, and evaluates coverage before bypass — so no gh stub needed.
#
# Run: bin/test-refactor-flag  (exit 0 = all pass, 1 = a case failed)

set -u
# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REFACTOR_FLAG="$SCRIPT_DIR/refactor-flag"
h_tmp TMP

pass()     { h_pass "$1"; }
failcase() { h_fail "$1"; }

# mk_repo — fresh repo with a committed classes file + matching test file.
mk_repo() {
    local d
    d="$(mktemp -d "$TMP/repo.XXXXXX")"
    h_git_repo "$d" --no-commit >/dev/null
    # Adverse config: rename detection OFF. The fix must still credit a renamed
    # test, because checkTestCoverage uses diffRenames() which forces `-M`. With the
    # old diffNames(_,'R') approach this would regress to exit 1 under this config.
    git -C "$d" config diff.renames false >/dev/null 2>&1
    mkdir -p "$d/ibl5/classes/Foo" "$d/ibl5/tests/Foo"
    printf '<?php\nclass FooService\n{\n    public function run(): void {}\n}\n' \
        > "$d/ibl5/classes/Foo/FooService.php"
    printf '<?php\nclass FooServiceTest\n{\n    public function testRun(): void {}\n}\n' \
        > "$d/ibl5/tests/Foo/FooServiceTest.php"
    git -C "$d" add -A >/dev/null 2>&1
    git -C "$d" commit -qm baseline >/dev/null 2>&1
    echo "$d"
}

# run_flag <repo> — run refactor-flag --staged from inside; echo output, return rc.
run_flag() {
    ( cd "$1" && "$REFACTOR_FLAG" --staged 2>&1 )
}

# assert_rc <name> <want-exit> <repo>
assert_rc() {
    local name="$1" want="$2" d="$3" out rc
    out="$(run_flag "$d")"
    rc=$?
    if [ "$rc" -ne "$want" ]; then
        failcase "$name — expected exit $want, got $rc"
        printf '%s\n' "$out" | sed 's/^/    /'
    else
        pass "$name (exit $rc)"
    fi
}

# ---------------------------------------------------------------------------
# THE FIX: a renamed classes file (trigger) + a renamed test file → coverage is
# credited via --diff-filter=R, so the gate PASSES. (Red before the fix: the
# renamed test appeared under neither A nor M, so the gate flagged exit 1.)
# ---------------------------------------------------------------------------
d="$(mk_repo)"
git -C "$d" mv ibl5/classes/Foo/FooService.php ibl5/classes/Foo/FooServiceRenamed.php >/dev/null 2>&1
git -C "$d" mv ibl5/tests/Foo/FooServiceTest.php ibl5/tests/Foo/FooServiceRenamedTest.php >/dev/null 2>&1
assert_rc "renamed-test-credits-coverage" 0 "$d"

# ---------------------------------------------------------------------------
# CONTROL (gate not neutered): a classes rename trigger with NO test change of
# any kind and no bypass marker → still FAILS (exit 1).
# ---------------------------------------------------------------------------
d="$(mk_repo)"
git -C "$d" mv ibl5/classes/Foo/FooService.php ibl5/classes/Foo/FooServiceRenamed.php >/dev/null 2>&1
assert_rc "trigger-without-any-test-fails" 1 "$d"

# ---------------------------------------------------------------------------
# CONTROL (pre-existing behavior unchanged): a classes rename trigger + a newly
# ADDED test file (--diff-filter=A) → PASSES, as before.
# ---------------------------------------------------------------------------
d="$(mk_repo)"
git -C "$d" mv ibl5/classes/Foo/FooService.php ibl5/classes/Foo/FooServiceRenamed.php >/dev/null 2>&1
printf '<?php\nclass BrandNewTest\n{\n    public function testNew(): void {}\n}\n' \
    > "$d/ibl5/tests/Foo/BrandNewTest.php"
git -C "$d" add ibl5/tests/Foo/BrandNewTest.php >/dev/null 2>&1
assert_rc "trigger-with-added-test-passes" 0 "$d"

# ---------------------------------------------------------------------------
# extractBypassReason characterization (pins the shared gate-common.php core).
# Trigger = classes rename with no test change; body piped via --bypass-from-stdin.
# ---------------------------------------------------------------------------
# bypass_row <name> <want-exit> <body> [<extra-flag>]
bypass_row() {
    local name="$1" want="$2" body="$3" extra="${4---bypass-from-stdin}" d out rc
    d="$(mk_repo)"
    git -C "$d" mv ibl5/classes/Foo/FooService.php \
        ibl5/classes/Foo/FooServiceRenamed.php >/dev/null 2>&1
    out="$(printf '%s' "$body" | ( cd "$d" && "$REFACTOR_FLAG" --staged $extra 2>&1 ))"
    rc=$?
    if [ "$rc" -ne "$want" ]; then
        failcase "$name — expected exit $want, got $rc"; echo "$out" | sed 's/^/    | /'
    else
        pass "$name (exit $rc)"
    fi
    BYPASS_OUT="$out"
}
bypass_row "refactor-bypass-exact-min-length" 0 '<!-- no-refactor-tests: abcdefghijklmnopqrst -->'
case "$BYPASS_OUT" in
    *"PASS (bypass): abcdefghijklmnopqrst"*) pass "refactor-bypass-exact-min-length-reason-trimmed" ;;
    *) failcase "refactor-bypass-exact-min-length-reason-trimmed — no trimmed PASS (bypass) line" ;;
esac
bypass_row "refactor-bypass-one-under-min"       1 '<!-- no-refactor-tests: abcdefghijklmnopqrs -->'
bypass_row "refactor-bypass-trim-before-length"  1 '<!--   no-refactor-tests:     abcdefghijklmnopqrs     -->'
bypass_row "refactor-bypass-multiline"           0 $'<!-- no-refactor-tests:\n  reason line one long\n  line two -->'
bypass_row "refactor-bypass-first-match-only"    1 $'<!-- no-refactor-tests: short -->\n<!-- no-refactor-tests: second marker reason long enough -->'
bypass_row "refactor-bypass-literal-null-body"   1 'null'
bypass_row "refactor-bypass-empty-body"          1 ''
bypass_row "refactor-bypass-adr-marker-rejected" 1 '<!-- no-adr: a reason that is long enough to pass -->'
# --staged WITHOUT --bypass-from-stdin: fetchPrBody returns null outside --pr.
bypass_row "refactor-bypass-staged-ignores-stdin" 1 '<!-- no-refactor-tests: a reason that is long enough -->' ""

# ---------------------------------------------------------------------------
# fetchPrBody characterization (--pr mode, gh shim recording argv).
# ---------------------------------------------------------------------------
# pr_repo — mk_repo + origin/master at baseline + committed classes rename.
pr_repo() {
    local d
    d="$(mk_repo)"
    git -C "$d" update-ref refs/remotes/origin/master "$(git -C "$d" rev-parse HEAD)"
    git -C "$d" mv ibl5/classes/Foo/FooService.php \
        ibl5/classes/Foo/FooServiceRenamed.php >/dev/null 2>&1
    git -C "$d" commit -qm rename >/dev/null 2>&1
    echo "$d"
}
# recording_gh <exit-code> <body> — echoes the shim dir; logs argv to <dir>/argv.
recording_gh() {
    local g
    g="$(mktemp -d "$TMP/rgh.XXXXXX")"
    printf '%s\n' "$2" > "$g/body"
    { echo '#!/bin/sh'
      echo 'd="$(dirname "$0")"'
      echo 'printf "%s\n" "$@" >> "$d/argv"'
      echo 'cat "$d/body"'
      echo "exit $1"; } > "$g/gh"
    chmod +x "$g/gh"
    echo "$g"
}
REF_STUB_BODY='<!-- no-refactor-tests: stub body reason that is long enough -->'

d="$(pr_repo)"; g="$(recording_gh 0 "$REF_STUB_BODY")"
( cd "$d" && env PATH="$g:$PATH" PR_NUMBER=4242 "$REFACTOR_FLAG" --pr </dev/null >/dev/null 2>&1 )
rc=$?; [ "$rc" -eq 0 ] && pass "refactor-fetch-pr-number-set-bypasses (exit 0)" \
    || failcase "refactor-fetch-pr-number-set-bypasses — expected exit 0, got $rc"
if printf '%s\n' pr view 4242 --json body --jq .body | cmp -s - "$g/argv"; then
    pass "refactor-fetch-pr-number-set-argv"
else
    failcase "refactor-fetch-pr-number-set-argv — gh argv differs"
fi

d="$(pr_repo)"; g="$(recording_gh 0 "$REF_STUB_BODY")"
( cd "$d" && env -u PR_NUMBER PATH="$g:$PATH" "$REFACTOR_FLAG" --pr </dev/null >/dev/null 2>&1 )
if printf '%s\n' pr view --json body --jq .body | cmp -s - "$g/argv"; then
    pass "refactor-fetch-pr-number-unset-argv"
else
    failcase "refactor-fetch-pr-number-unset-argv — gh argv differs"
fi

d="$(pr_repo)"; g="$(recording_gh 1 "$REF_STUB_BODY")"
( cd "$d" && env PATH="$g:$PATH" PR_NUMBER=4242 "$REFACTOR_FLAG" --pr </dev/null >/dev/null 2>&1 )
rc=$?; [ "$rc" -eq 1 ] && pass "refactor-fetch-gh-failure-null-body-rejects (exit 1)" \
    || failcase "refactor-fetch-gh-failure-null-body-rejects — expected exit 1, got $rc"

h_done
