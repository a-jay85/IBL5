#!/usr/bin/env bash
# Harness for bin/lib/claim-file.sh (exclusive file claims for directory locks).
set -uo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=lib/claim-file.sh
. "$ROOT/bin/lib/claim-file.sh"

T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT

FAILED=0
ok() { printf 'ok %s\n' "$1"; }
fail() { printf 'FAIL %s %s\n' "$1" "${2:-}"; FAILED=1; }

# claim_first_wins
if claim_file "$T/a" printf '%s\n' 123 && [ "$(cat "$T/a")" = "123" ]; then
    ok claim_first_wins
else
    fail claim_first_wins "rc/content wrong"
fi

# claim_second_loses
if claim_file "$T/a" printf '%s\n' 456; then
    fail claim_second_loses "second claim won"
elif [ "$(cat "$T/a")" = "123" ]; then
    ok claim_second_loses
else
    fail claim_second_loses "content clobbered: $(cat "$T/a")"
fi

# claim_restores_noclobber
nc_ok=1
set +C
claim_file "$T/nc1" >/dev/null 2>&1
case $- in *C*) nc_ok=0 ;; esac
claim_file "$T/nc1" >/dev/null 2>&1
case $- in *C*) nc_ok=0 ;; esac
set -C
claim_file "$T/nc2" >/dev/null 2>&1
case $- in *C*) ;; *) nc_ok=0 ;; esac
claim_file "$T/nc2" >/dev/null 2>&1
case $- in *C*) ;; *) nc_ok=0 ;; esac
set +C
if [ "$nc_ok" = 1 ]; then ok claim_restores_noclobber; else fail claim_restores_noclobber "noclobber state leaked"; fi

# claim_dir_counts_held
mkdir "$T/d"
if claim_file "$T/d"; then
    fail claim_dir_counts_held "claimed over a directory"
else
    ok claim_dir_counts_held
fi

# ---- two-racer stale-reclaim harness (backlog#1855) ----
# Each racer is a real bash process, so $$ is its own pid. Barrier: both racers judge
# the lock stale, then B waits for A to finish re-taking it before B acts. On the old
# inline pattern B's rm -rf deletes A's fresh lock and B claims too: two owners.
export CLAIM_LIB="$ROOT/bin/lib/claim-file.sh"
cat > "$T/racer.sh" <<'RACER'
#!/usr/bin/env bash
# racer.sh <inline|helper> <A|B> <lockdir> <syncdir>
set -u
. "$CLAIM_LIB"
mode=$1 id=$2 L=$3 S=$4
pid_dead() { local p; p=$(cat "$1/pid" 2>/dev/null) || p=""; [ -n "$p" ] && ! kill -0 "$p" 2>/dev/null; }
wait_for() {
    local i=0
    while [ ! -e "$1" ]; do
        i=$((i + 1))
        if [ "$i" -gt 200 ]; then echo timeout > "$S/result.$id"; : > "$S/done.$id"; exit 2; fi
        sleep 0.05
    done
}
if ! pid_dead "$L"; then echo held > "$S/result.$id"; : > "$S/done.$id"; exit 1; fi
: > "$S/judged.$id"
wait_for "$S/judged.A"
wait_for "$S/judged.B"
[ "$id" = B ] && wait_for "$S/done.A"
if [ "$mode" = inline ]; then
    rm -rf "$L"
    if mkdir "$L" 2>/dev/null && claim_file "$L/pid" printf '%s\n' "$$"; then r=won; else r=lost; fi
else
    if claim_reclaim "$L" pid pid_dead printf '%s\n' "$$"; then r=won; else r=lost; fi
fi
echo "$r" > "$S/result.$id"
: > "$S/done.$id"
i=0; while [ ! -e "$S/release" ] && [ "$i" -lt 200 ]; do i=$((i + 1)); sleep 0.05; done
RACER

# race_reclaim <inline|helper>: seed a lock owned by a dead pid, run racers A and B
# through the barrier, print "<wins> <1 when the pid file names racer A, else 0>".
race_reclaim() {
    local mode=$1 R="$T/race-$1" L dead a_pid b_pid wins i=0 owner_a=0
    L="$R/lock"
    mkdir -p "$R/sync"
    sh -c 'exit 0' & dead=$!
    wait "$dead" 2>/dev/null || true
    mkdir "$L" && printf '%s\n' "$dead" > "$L/pid"
    bash "$T/racer.sh" "$mode" A "$L" "$R/sync" & a_pid=$!
    bash "$T/racer.sh" "$mode" B "$L" "$R/sync" & b_pid=$!
    while { [ ! -e "$R/sync/done.A" ] || [ ! -e "$R/sync/done.B" ]; } && [ "$i" -lt 300 ]; do
        i=$((i + 1)); sleep 0.05
    done
    wins=$(cat "$R/sync/result.A" "$R/sync/result.B" 2>/dev/null | grep -c '^won$')
    [ "$(cat "$L/pid" 2>/dev/null)" = "$a_pid" ] && owner_a=1
    : > "$R/sync/release"
    wait "$a_pid" "$b_pid" 2>/dev/null
    printf '%s %s\n' "$wins" "$owner_a"
}

# reclaim_race_inline_double_owner: the barrier reproduces the bug on the old shape.
rr_inline=$(race_reclaim inline)
if [ "${rr_inline%% *}" = 2 ]; then
    ok reclaim_race_inline_double_owner
else
    fail reclaim_race_inline_double_owner "wins/ownerA=[$rr_inline], expected 2 winners"
fi

t_pid_dead() { local p; p=$(cat "$1/pid" 2>/dev/null) || p=""; [ -n "$p" ] && ! kill -0 "$p" 2>/dev/null; }
# dead_pid: print the pid of a process that has already exited.
dead_pid() { local d; sh -c 'exit 0' & d=$!; wait "$d" 2>/dev/null || true; printf '%s\n' "$d"; }

# reclaim_helper_race_one_owner: same barrier, claim_reclaim yields one winner (racer A).
rr_helper=$(race_reclaim helper)
if [ "$rr_helper" = "1 1" ]; then
    ok reclaim_helper_race_one_owner
else
    fail reclaim_helper_race_one_owner "wins/ownerA=[$rr_helper], expected [1 1]"
fi

# reclaim_absent_lock_claims
L="$T/rc-absent"
if claim_reclaim "$L" pid t_pid_dead printf '%s\n' "$$" \
    && [ "$(cat "$L/pid" 2>/dev/null)" = "$$" ] && [ ! -e "$L.reclaim.lock" ]; then
    ok reclaim_absent_lock_claims
else
    fail reclaim_absent_lock_claims "pid=[$(cat "$L/pid" 2>/dev/null)] mutex=$([ -e "$L.reclaim.lock" ] && echo present || echo absent)"
fi

# reclaim_live_lock_refused
L="$T/rc-live"
mkdir "$L" && printf '%s\n' "$$" > "$L/pid"
claim_reclaim "$L" pid t_pid_dead printf '%s\n' "$$"; rc=$?
if [ "$rc" = 1 ] && [ "$(cat "$L/pid" 2>/dev/null)" = "$$" ] && [ ! -e "$L.reclaim.lock" ]; then
    ok reclaim_live_lock_refused
else
    fail reclaim_live_lock_refused "rc=$rc pid=[$(cat "$L/pid" 2>/dev/null)]"
fi

# reclaim_live_mutex_refused
L="$T/rc-livemutex"
dp=$(dead_pid)
mkdir "$L" && printf '%s\n' "$dp" > "$L/pid"
mkdir "$L.reclaim.lock" && printf '%s\n' "$$" > "$L.reclaim.lock/owner"
claim_reclaim "$L" pid t_pid_dead printf '%s\n' "$$"; rc=$?
if [ "$rc" = 1 ] && [ "$(cat "$L/pid" 2>/dev/null)" = "$dp" ] \
    && [ "$(cat "$L.reclaim.lock/owner" 2>/dev/null)" = "$$" ]; then
    ok reclaim_live_mutex_refused
else
    fail reclaim_live_mutex_refused "rc=$rc pid=[$(cat "$L/pid" 2>/dev/null)] owner=[$(cat "$L.reclaim.lock/owner" 2>/dev/null)]"
fi

# reclaim_dead_mutex_reaped
L="$T/rc-deadmutex"
dp=$(dead_pid)
dp2=$(dead_pid)
mkdir "$L" && printf '%s\n' "$dp" > "$L/pid"
mkdir "$L.reclaim.lock" && printf '%s\n' "$dp2" > "$L.reclaim.lock/owner"
claim_reclaim "$L" pid t_pid_dead printf '%s\n' "$$"; rc=$?
if [ "$rc" = 0 ] && [ "$(cat "$L/pid" 2>/dev/null)" = "$$" ] && [ ! -e "$L.reclaim.lock" ]; then
    ok reclaim_dead_mutex_reaped
else
    fail reclaim_dead_mutex_reaped "rc=$rc pid=[$(cat "$L/pid" 2>/dev/null)]"
fi

# reclaim_old_mutex_reaped
L="$T/rc-oldmutex"
dp=$(dead_pid)
mkdir "$L" && printf '%s\n' "$dp" > "$L/pid"
mkdir "$L.reclaim.lock" && printf '%s\n' "$$" > "$L.reclaim.lock/owner"
touch -t 202001010000 "$L.reclaim.lock"
claim_reclaim "$L" pid t_pid_dead printf '%s\n' "$$"; rc=$?
if [ "$rc" = 0 ] && [ ! -e "$L.reclaim.lock" ]; then
    ok reclaim_old_mutex_reaped
else
    fail reclaim_old_mutex_reaped "rc=$rc mutex=$([ -e "$L.reclaim.lock" ] && echo present || echo absent)"
fi

# reclaim_claim_cmd_content
L="$T/rc-content"
claim_reclaim "$L" at t_pid_dead printf '%s\n' 123; rc=$?
if [ "$rc" = 0 ] && [ "$(cat "$L/at" 2>/dev/null)" = 123 ] && [ ! -e "$L/pid" ]; then
    ok reclaim_claim_cmd_content
else
    fail reclaim_claim_cmd_content "rc=$rc at=[$(cat "$L/at" 2>/dev/null)]"
fi

# reclaim_lying_mkdir_live_mutex_refused
L="$T/rc-lying"
dp=$(dead_pid)
claim_file_lying_mkdir_stub "$T/lm"
mkdir "$L" && printf '%s\n' "$dp" > "$L/pid"
mkdir "$L.reclaim.lock" && printf '%s\n' "$$" > "$L.reclaim.lock/owner"
( PATH="$T/lm:$PATH"; claim_reclaim "$L" pid t_pid_dead printf '%s\n' "$$" ); rc=$?
if [ "$rc" = 1 ] && [ "$(cat "$L/pid" 2>/dev/null)" = "$dp" ]; then
    ok reclaim_lying_mkdir_live_mutex_refused
else
    fail reclaim_lying_mkdir_live_mutex_refused "rc=$rc pid=[$(cat "$L/pid" 2>/dev/null)]"
fi

# claim_reclaim_sites_adopted
ad_missing=""
while IFS='|' read -r ad_file ad_needle; do
    [ -n "$ad_file" ] || continue
    grep -qF -- "$ad_needle" "$ROOT/$ad_file" || ad_missing="$ad_missing [$ad_file: $ad_needle]"
done <<'SITES'
bin/automouse/run|claim_reclaim "$lock" pid _cost_lock_stale
bin/automouse/run|claim_reclaim "$lock" pid _plan_lock_stale
bin/mutation-diff|claim_reclaim "$LOCK_DIR" pid md_lock_stale
bin/burndown-loop|claim_reclaim "$LOCK" pid bl_lock_stale
bin/usage-gate-coordinator|claim_reclaim "$LOCK" at ugc_lock_stale
bin/bug-pipeline-tick|claim_reclaim "$CI_AUTOFIX_LOCK" pid ci_lock_stale
bin/lib/launchd-job.sh|claim_reclaim "$lock" pid ljob_slot_empty
bin/lib/launchd-job.sh|claim_reclaim "$lock" pid ljob_slot_dead
SITES
if [ -z "$ad_missing" ]; then
    ok claim_reclaim_sites_adopted
else
    fail claim_reclaim_sites_adopted "missing:$ad_missing"
fi

# claim_missing_parent_fails_closed
cm_ok=1
if claim_file "$T/nope/x"; then cm_ok=0; fi
(
    set -e
    if claim_file "$T/nope/x"; then :; fi
    exit 0
) || cm_ok=0
if [ "$cm_ok" = 1 ]; then ok claim_missing_parent_fails_closed; else fail claim_missing_parent_fails_closed "claimed or tripped set -e"; fi

# stub_mkdir_lies
claim_file_lying_mkdir_stub "$T/stub"
if PATH="$T/stub:$PATH" mkdir "$T/m" && PATH="$T/stub:$PATH" mkdir "$T/m"; then
    ok stub_mkdir_lies
else
    fail stub_mkdir_lies "stub mkdir exited non-zero"
fi

# claim_race_one_winner
COPIES=8
: > "$T/winners"
i=0
while [ "$i" -lt "$COPIES" ]; do
    (
        PATH="$T/stub:$PATH"
        mkdir "$T/r"
        claim_file "$T/r/pid" printf '%s\n' "$i" && echo "$i" >> "$T/winners"
    ) &
    i=$((i + 1))
done
wait
n=$(wc -l < "$T/winners" | tr -d ' ')
if [ "$n" = 1 ]; then ok claim_race_one_winner; else fail claim_race_one_winner "winners=$n"; fi

exit "$FAILED"
