# The wrapper runs the REAL bin/pr-cycle --worker, synchronously, with fake attack, triage,
# ready and gh tools. 11 fires and its fleet log says failed/kind=test; 12's says declined.
# Tick 2 must read the file the real worker wrote, not one the stub invented.
reset; begin_case
RW="$SCRATCH/rw"; rm -rf "$RW"; mkdir -p "$RW/repo" "$RW/bin" "$RW/home"
