run --dry-run
[[ $RC -eq 0 ]] || fail "dry run exit $RC, want 0"
[[ "$(calls ready)" == "0" ]] || fail "dry run fired $(calls ready) ready calls"
grep -qF 'stage 1 would ready' <<< "$OUT" || fail "dry run did not report stage 1 list"
grep -qF '#201' <<< "$OUT" || fail "dry run did not name a DIRTY rescue candidate"
grep -qF '#203' <<< "$OUT" && fail "dry run listed the DRAFT PR as a rescue candidate"
grep -qF '#204' <<< "$OUT" && fail "dry run listed the out-of-section decoy as a candidate"
RESCUE=0 run --dry-run
grep -qF 'DIRTY rescue: disabled' <<< "$OUT" || fail "dry run did not report the kill switch"
