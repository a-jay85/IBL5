    new_fixture
    set_review "$(fnd "$(alpha_path)" 4 "Alpha::run" bug code 90 "Dry")"
    set_scores 0:90
    csr --dry-run
    expect_eq "dry-run exits 0" 0 "$RC"
    expect_has "would-file line" "$OUT" "--- would file [bug] slice-review: Alpha: Dry"
    expect_has "summary says dry-run" "$OUT" "mode=dry-run would_file=1"
    expect_has "list calls were made" "$(cat "$STUB_DIR/gh.log")" "issue list"
    expect_lacks "no create call" "$(cat "$STUB_DIR/gh.log")" "issue create"
}

