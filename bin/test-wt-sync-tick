# ── Test 22: only: MERGED on diverged clean ───────────────────────────────────
MAIN22="$(new_env)"
WT22="$(add_worktree "$MAIN22" "wt-div22" diverged)"
BRANCH22="$(git -C "$WT22" branch --show-current)"
run_only "$WT22"
assert_eq "only: MERGED stdout" "MERGED" "$ONLY_OUT"
ANCESTOR_COUNT22="$(git -C "$WT22" rev-list --count HEAD ^"origin/$BRANCH22")"
if [ "${ANCESTOR_COUNT22:-0}" -gt 1 ]; then
    pass "only: MERGED HEAD has local+merge commits"
else
    failcase "only: MERGED HEAD count wrong (got ${ANCESTOR_COUNT22:-0}, want >1)"
fi
if git -C "$WT22" merge-base --is-ancestor "origin/$BRANCH22" HEAD 2>/dev/null; then
    pass "only: MERGED origin tip is ancestor of HEAD"
else
    failcase "only: MERGED origin tip is not ancestor of HEAD"
fi

# ── Test 23: only: DIVERGED-CONFLICT aborts ───────────────────────────────────
MAIN23="$(new_env)"
WT23="$(add_worktree "$MAIN23" "wt-dc23" diverged-conflict)"
HEAD23_BEFORE="$(git -C "$WT23" rev-parse HEAD)"
run_only "$WT23"
