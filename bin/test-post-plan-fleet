# --- case 31: verdict-marker-line-not-misclassified ---------------------------------------
# Cross-slice guard: the marker line starts with 'P', which must NOT match
# derive_status's READY pattern (^[[:space:]>*_`-]*READY). If someone widens the
# sentinel prefix to start with "READY|...", this case fails immediately.
begin_case
_log31="/tmp/pr-ready-test-marker-classify-$$.log"
TMP_LOGS+=("$_log31")
printf 'PR-READY-VERDICT-MARKER-V1|pr=%s|verdict=READY|url=-|holds=none\n' \
    "$_VM_PR" > "$_log31"
_st31="$(derive_status "$_log31")"
[[ "$_st31" == "NOT READY" ]] \
    || fail "verdict-marker-line-not-misclassified: derive_status='$_st31' on marker-only log, want 'NOT READY' — sentinel leaked into READY pattern"
end_case verdict-marker-line-not-misclassified

# --- case 35: no-command-substitution-after-worktree -------------------------------------
begin_case
for _f in "$_PRD"/_phase*.md; do
    _enter_line="$(grep -n 'EnterWorktree' "$_f" | head -1 | cut -d: -f1)"
    [[ -n "$_enter_line" ]] || continue
    _range_end="${_enter_line:-$}"
    _hits="$(sed -n "1,${_range_end}p" "$_f" \
        | awk '/^```/{b=!b;next}!b' \
        | grep -Ec '\$\(|<\(')" || true
    [[ "$_hits" -eq 0 ]] \
        || fail "no-command-substitution-after-worktree: $(basename "$_f") has $_hits command-substitution(s) in prose before EnterWorktree"
done
end_case no-command-substitution-after-worktree

