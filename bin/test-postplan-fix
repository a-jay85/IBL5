HR_COMMENT_FP=$(sed -n 's/.*fingerprint \([0-9a-f]\{16\}\).*/\1/p' "$TMP/gh.comment" 2>/dev/null | sed -n 1p)
need "comment carries the fingerprint" test -n "$HR_COMMENT_FP"
need "fingerprint is the ledger's" ledger_has "$HR_COMMENT_FP"
need "comment body has the note" grep -qF "reworded after review" "$TMP/gh.comment"
