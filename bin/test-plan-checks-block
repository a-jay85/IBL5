start_case case_routing_table
RT_OUT=$(
    # shellcheck source=bin/lib/plan-matrix-rows.sh
    source "$REPO_ROOT/bin/lib/plan-matrix-rows.sh"
    while IFS=$'\t' read -r v n cmd; do
        [ -n "$v" ] || continue
        if row_runs_in_ci "$cmd"; then got=CI; else got=LOCAL; fi
        if [ "$got" != "$v" ]; then echo "FAIL want $v got $got: $cmd"; continue; fi
        if [ "$v" = CI ]; then
            gn=$(row_ci_needs "$cmd"); gn="${gn// /,}"; [ -n "$gn" ] || gn=none
            if [ "$gn" != "$n" ]; then echo "FAIL want needs $n got $gn: $cmd"; continue; fi
        elif [ "$n" != - ]; then
            echo "FAIL LOCAL row carries needs $n: $cmd"; continue
        fi
        echo "ok $v: $cmd"
    done < "$RT_FILE"
)
chk "table rows: $(grep -c '' <<< "$RT_OUT") ran" test "$(grep -c '^ok ' <<< "$RT_OUT")" -ge 60
chk "routing mismatch: $(grep -m1 '^FAIL' <<< "$RT_OUT")" lacks "$RT_OUT" "FAIL "
end_case

if [ "$FAILS" -gt 0 ]; then
    echo "test-plan-checks-block: $FAILS case(s) failed"
    exit 1
fi
echo "test-plan-checks-block: all cases passed"
