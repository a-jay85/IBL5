  || fail "pr-ready-bringup-peer-safe (row 12): BRINGUP: SKIP peer-dirty (line ${_skip_ln}) is not before bin/wt-up (line ${_wtup_ln})"
end_case pr-ready-bringup-peer-safe

# --- case pr-ready-bringup-already-up (row 13) -------------------------------------------
# Pins the already-running guard, the localhost URL derivation, and NOT-READY output.
begin_case
grep -qF 'BRINGUP: ALREADY-UP' "$PRD/scripts/wt-bring-up.sh" \
  || fail "pr-ready-bringup-already-up (row 13): 'BRINGUP: ALREADY-UP' absent from wt-bring-up.sh"
grep -qF "docker inspect -f '{{.State.Running}}'" "$PRD/scripts/wt-bring-up.sh" \
  || fail "pr-ready-bringup-already-up (row 13): docker inspect check absent from wt-bring-up.sh"
_alup_ln=$(grep -n 'BRINGUP: ALREADY-UP' "$PRD/scripts/wt-bring-up.sh" | head -1 | cut -d: -f1)
_wtup_ln=$(grep -n 'bin/wt-up' "$PRD/scripts/wt-bring-up.sh" | head -1 | cut -d: -f1)
[[ -n "$_alup_ln" && -n "$_wtup_ln" && "$_alup_ln" -lt "$_wtup_ln" ]] \
  || fail "pr-ready-bringup-already-up (row 13): BRINGUP: ALREADY-UP (line ${_alup_ln}) is not before bin/wt-up (line ${_wtup_ln})"
grep -qF '.localhost' "$PRD/scripts/wt-bring-up.sh" \
  || fail "pr-ready-bringup-already-up (row 13): .localhost not derived from slug variable in wt-bring-up.sh"
[[ "$(grep -cF 'main.localhost' "$PRD/scripts/wt-bring-up.sh")" -eq 0 ]] \
  || fail "pr-ready-bringup-already-up (row 13): literal 'main.localhost' found in wt-bring-up.sh"
grep -qF '/ibl5/' "$PRD/scripts/wt-bring-up.sh" \
  || fail "pr-ready-bringup-already-up (row 13): /ibl5/ path prefix absent from wt-bring-up.sh"
grep -qF 'BRINGUP: NOT-READY' "$PRD/scripts/wt-bring-up.sh" \
  || fail "pr-ready-bringup-already-up (row 13): 'BRINGUP: NOT-READY' absent from wt-bring-up.sh"
end_case pr-ready-bringup-already-up

# --- case pr-ready-rows-classifier-precedence (row 14) -----------------------------------
# Pins all outcome tokens and the SKIP-DONE < SKIP-HUMAN < SKIP-NOURL ordering.
begin_case
for _tok in 'SKIP-DONE' 'SKIP-HUMAN' 'SKIP-NOURL' 'SKIP-AUTH' 'FAIL http-' 'FAIL php-error' 'FAIL missing-literal' 'PASS'; do
    grep -qF "$_tok" "$PRD/scripts/manual-rows.sh" \
      || fail "pr-ready-rows-classifier-precedence (row 14): outcome token '${_tok}' absent from manual-rows.sh"
done
_done_ln=$(grep -n 'SKIP-DONE' "$PRD/scripts/manual-rows.sh" | head -1 | cut -d: -f1)
_human_ln=$(grep -n 'SKIP-HUMAN' "$PRD/scripts/manual-rows.sh" | head -1 | cut -d: -f1)
_nourl_ln=$(grep -n 'SKIP-NOURL' "$PRD/scripts/manual-rows.sh" | head -1 | cut -d: -f1)
[[ -n "$_done_ln" && -n "$_human_ln" && "$_done_ln" -lt "$_human_ln" ]] \
  || fail "pr-ready-rows-classifier-precedence (row 14): SKIP-DONE (line ${_done_ln}) is not before first SKIP-HUMAN (line ${_human_ln})"
[[ -n "$_human_ln" && -n "$_nourl_ln" && "$_human_ln" -lt "$_nourl_ln" ]] \
  || fail "pr-ready-rows-classifier-precedence (row 14): first SKIP-HUMAN (line ${_human_ln}) is not before SKIP-NOURL (line ${_nourl_ln})"
end_case pr-ready-rows-classifier-precedence

# --- case pr-ready-rows-executor-negatives (row 15) --------------------------------------
# Pins: no -L in curl, PHP error pattern present, SKIP-AUTH reached via 3xx+login check.
begin_case
grep -qF 'curl' "$PRD/scripts/manual-rows.sh" \
  || fail "pr-ready-rows-executor-negatives (row 15): curl invocation absent from manual-rows.sh"
if grep 'curl' "$PRD/scripts/manual-rows.sh" | grep -qF ' -L'; then
    fail "pr-ready-rows-executor-negatives (row 15): a curl invocation in manual-rows.sh carries -L flag"
fi
grep -qF 'Fatal error|Parse error|Warning:|Notice:' "$PRD/scripts/manual-rows.sh" \
  || fail "pr-ready-rows-executor-negatives (row 15): PHP error pattern 'Fatal error|Parse error|Warning:|Notice:' absent from manual-rows.sh"
grep -qF "'^3'" "$PRD/scripts/manual-rows.sh" \
  || fail "pr-ready-rows-executor-negatives (row 15): '^3' 3xx status check absent from manual-rows.sh — SKIP-AUTH unreachable from redirect"
grep -qF 'login' "$PRD/scripts/manual-rows.sh" \
  || fail "pr-ready-rows-executor-negatives (row 15): 'login' absent from manual-rows.sh — SKIP-AUTH condition incomplete"
end_case pr-ready-rows-executor-negatives

# --- case pr-ready-tick-zero-pass-no-edit (row 16) ---------------------------------------
# Pins: TICKED: 0 early-return TICK-COMPLETE before first gh pr edit; gh pr view before gh pr edit.
# grep patterns select the actual commands (not comments that name them) by anchoring on
# flags that only the real invocations carry (--body-file for edit; --json for view).
begin_case
grep -qF 'TICKED: 0' "$PRD/scripts/tick-rows.sh" \
  || fail "pr-ready-tick-zero-pass-no-edit (row 16): 'TICKED: 0' absent from tick-rows.sh"
_tc_ln=$(grep -n 'TICK-COMPLETE' "$PRD/scripts/tick-rows.sh" | head -1 | cut -d: -f1)
_edit_ln=$(grep -n 'gh pr edit.*--body-file' "$PRD/scripts/tick-rows.sh" | head -1 | cut -d: -f1)
_view_ln=$(grep -n 'gh pr view.*--json' "$PRD/scripts/tick-rows.sh" | head -1 | cut -d: -f1)
[[ -n "$_tc_ln" && -n "$_edit_ln" && "$_tc_ln" -lt "$_edit_ln" ]] \
  || fail "pr-ready-tick-zero-pass-no-edit (row 16): zero-count TICK-COMPLETE (line ${_tc_ln}) is not before first gh pr edit (line ${_edit_ln})"
[[ -n "$_view_ln" && -n "$_edit_ln" && "$_view_ln" -lt "$_edit_ln" ]] \
  || fail "pr-ready-tick-zero-pass-no-edit (row 16): gh pr view (line ${_view_ln}) is not before gh pr edit (line ${_edit_ln})"
end_case pr-ready-tick-zero-pass-no-edit

# --- verdict -----------------------------------------------------------------------------
if [[ $FAILED -ne 0 ]]; then
    echo "test-pr-ready-now: FAILED ($FAILED assertion failure(s))" >&2
    exit 1
fi
echo "test-pr-ready-now: all cases passed"
