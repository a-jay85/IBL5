# ── Cases: launchd (Phase 7) ──────────────────────────────────────────────────
case_print_schedule() {
    new_fixture
    XENV="HOME=/Users/fixture"
    fcs --print-schedule
    expect_eq "print-schedule exits 0" 0 "$RC"
    expect_has "label" "$OUT" "<string>com.ibl5.finding-class-scan</string>"
    expect_has "weekday 0" "$OUT" "<key>Weekday</key>"$'\n'$'\t\t'"<integer>0</integer>"
    expect_has "hour 9" "$OUT" "<key>Hour</key>"$'\n'$'\t\t'"<integer>9</integer>"
    expect_has "minute 15" "$OUT" "<key>Minute</key>"$'\n'$'\t\t'"<integer>15</integer>"
    expect_has "row 37: PATH holds every binary dir" "$OUT" "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/fixture/.local/bin"
    expect_has "HOME expanded" "$OUT" "<string>/Users/fixture</string>"
    if grep -qE '[$]HOME|[$][{]|<string></string>' <<< "$OUT"; then fail "row 36: unexpanded variable or empty string in the plist"
    else ok "row 36: no unexpanded variable or empty string in the plist"; fi
    XENV="HOME="
    fcs --print-schedule
    expect_eq "print-schedule with empty HOME exits 2" 2 "$RC"
    expect_absent "print-schedule creates nothing" "$FX/home/Library"
}

case_install_refused_outside_main() {
    new_fixture
    local main="$FX/main-repo" wt="$FX/linked-wt"
    mkdir -p "$main/bin"
    git -C "$main" init -q 2>/dev/null
    cp "$FCS" "$main/bin/finding-class-scan"
    git -C "$main" add -A
    git -C "$main" -c user.name=t -c user.email=t@t commit -q -m init
    git -C "$main" worktree add -q "$wt" -b linked 2>/dev/null
    local rc=0 out
    out="$(env HOME="$FX/home" FCS_STATE_DIR="$STATE" FCS_LAUNCHCTL_BIN="$STUBS/launchctl" STUB_DIR="$STUB_DIR" \
        bash "$wt/bin/finding-class-scan" --install-schedule 2>&1)" || rc=$?
    expect_eq "install from a non-main checkout exits 2" 2 "$rc"
    expect_has "install names the main checkout" "$out" "main checkout"
    expect_eq "install never reached launchctl" 0 "$(count_lines launchctl.log bootstrap)"
}

case_verify_schedule() {
    new_fixture
    XENV="STUB_LAUNCHCTL_WRITE=1"
    fcs --verify-schedule
    expect_eq "row 39: verify exits 0 on a summary line" 0 "$RC"
    expect_has "row 39: prints fired ok" "$OUT" "fired ok"
    expect_has "row 39: boots the job out" "$(cat "$STUB_DIR/launchctl.log")" "bootout"
    expect_has "row 39: the label is a -verify- label" "$(cat "$STUB_DIR/launchctl.log")" "-verify-"
    if ls "$STATE"/verify-*.plist >/dev/null 2>&1; then fail "row 39: verify plist left behind"; else ok "row 39: verify plist removed"; fi
    local plist
    plist="$(cat "$STUB_DIR/verify.plist.copy")"
    expect_has "verify plist runs at load" "$plist" "RunAtLoad"
    expect_has "verify plist is a dry run" "$plist" "--dry-run"
    expect_lacks "verify plist has no calendar key" "$plist" "StartCalendarInterval"
    new_fixture
    XENV="FCS_VERIFY_TIMEOUT=3"
    fcs --verify-schedule
    expect_eq "row 39: verify timeout exits 1" 1 "$RC"
    expect_has "row 39: timeout prints FAILED" "$OUT" "FAILED"
    expect_has "row 39: timeout still boots out" "$(cat "$STUB_DIR/launchctl.log")" "bootout"
}

case_ci_wiring() {
    if grep -qF 'bin/test-finding-class-scan' "$REPO_ROOT/.github/workflows/tests.yml"; then ok "row 41: harness wired into tests.yml"
    else fail "row 41: harness not wired into tests.yml"; fi
}

# ── Live exercise (owner runs once before arming the schedule) ────────────────
live_main() {
    h_tmp LT
    mkdir -p "$LT/bin" "$LT/state"
    cat > "$LT/bin/gh" <<SH
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "$LT/gh.log"
case "\$1 \$2" in
    "api graphql"|"issue list"|"issue view") exec "$(command -v gh)" "\$@" ;;
esac
exit 1
SH
    chmod +x "$LT/bin/gh"
    local out rc=0
    out="$(GH_CMD="$LT/bin/gh" FCS_STATE_DIR="$LT/state" bash "$FCS" --dry-run --since="$(jq -rn 'now - 1209600 | strftime("%Y-%m-%d")')" 2>&1)" || rc=$?
    echo "$out"
    expect_eq "live dry-run exits 0" 0 "$rc"
    expect_has "live summary line" "$out" "summary mode=backfill dry_run=1"
    expect_lacks "live run made no issue create" "$(cat "$LT/gh.log")" "issue create"
    expect_lacks "live run made no issue comment" "$(cat "$LT/gh.log")" "issue comment"
}

if [ "${1:-}" = "--live" ]; then
    live_main
else
    for c in $(declare -F | awk '$3 ~ /^case_/ {print $3}'); do
        # FCS_ONLY=<case_name> runs a single case, handy when debugging.
        if [ -n "${FCS_ONLY:-}" ] && [ "$c" != "$FCS_ONLY" ]; then continue; fi
        "$c"
        if [ -n "${FCS_ONLY:-}" ]; then
            printf -- '--- last run: rc=%s\n--- stdout\n%s\n--- stderr\n%s\n' "$RC" "$OUT" "$ERR" >&2
        fi
    done
fi

h_done
