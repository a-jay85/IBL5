end_case report-skip-reason

# --- case 23: report-no-mutation ---------------------------------------------------------
# The driver must never make mutating gh calls (merge, approve, worktree remove, etc.).
# The strict shim exits 1 on any non-list gh call, so exit 0 + correct plist count
# proves no mutation occurred.
begin_case
clean_slots
out="$(POST_PLAN_FLEET_DRY_RUN=1 run_driver --go 2>&1)"; rc=$?
[[ $rc -eq 0 ]] || fail "report-no-mutation: exit $rc — strict shim may have caught a mutating gh call"
[[ "$(plist_count)" -eq 2 ]] || fail "report-no-mutation: plist_count=$(plist_count), want 2"
end_case report-no-mutation

# --- case 27: usage-not-truncated --------------------------------------------------------
# --help output documents all three Phase 8 flags (--pr-attack, --top-n, --wait).
begin_case
out="$(run_driver --help 2>&1)"; rc=$?
[[ $rc -eq 0 ]] || fail "usage-not-truncated: --help exited $rc, want 0"
grep -q -- '--pr-attack' <<< "$out" || fail "usage-not-truncated: --help omits --pr-attack"
grep -q -- '--top-n' <<< "$out" || fail "usage-not-truncated: --help omits --top-n"
grep -q -- '--wait' <<< "$out" || fail "usage-not-truncated: --help omits --wait"
# --stop-all is the last-added header line, so it is the truncation canary. --stop is matched
# with the trailing ` N` because a bare `--stop` would also be satisfied by `--stop-all`.
grep -q -- '--stop N' <<< "$out" || fail "usage-not-truncated: --help omits --stop"
grep -q -- '--stop-all' <<< "$out" || fail "usage-not-truncated: --help omits --stop-all"
grep -q -- '--no-dm' <<< "$out" || fail "usage-not-truncated: --help omits --no-dm"
_help_tail="$(run_driver --help 2>&1 | tail -1)"
[[ "$_help_tail" == "on a real run until it does." ]] \
    || fail "usage-not-truncated: --help tail-1='$_help_tail', want 'on a real run until it does.'"
end_case usage-not-truncated

# --- case 28: seam-master-sha-unset-vs-empty ---------------------------------------------
# Both unset and empty POST_PLAN_FLEET_MASTER_SHA trigger the git rev-parse fallback.
# The real master SHA differs from the fixture abc1234, so the staleness gate fires on both.
begin_case
# Unset arm: run_driver does not set POST_PLAN_FLEET_MASTER_SHA → driver uses git → STALE.
err_unset="$(env -u POST_PLAN_FLEET_MASTER_SHA \
    env HOME="$SCRATCH" PATH="$SCRATCH/.local/bin:$PATH" \
        POST_PLAN_FLEET_CLAUDE="$CLAUDE_STUB" \
        POST_PLAN_FLEET_GH_USER=a-jay85 \
        POST_PLAN_FLEET_ROOT="$SCRIPT_DIR/.." \
        "$DRIVER" --pr-attack "$SCRATCH/attack-fresh.md" 2>&1)"; rc_unset=$?
[[ $rc_unset -ne 0 ]] || fail "seam-master-sha-unset-vs-empty: unset arm exited 0, want STALE exit"
grep -qi 'STALE' <<< "$err_unset" || \
    fail "seam-master-sha-unset-vs-empty: unset arm lacks STALE keyword (out: $err_unset)"
# Empty arm: same fallback via :- operator.
err_empty="$(POST_PLAN_FLEET_MASTER_SHA="" \
    run_driver --pr-attack "$SCRATCH/attack-fresh.md" 2>&1)"; rc_empty=$?
[[ $rc_empty -ne 0 ]] || fail "seam-master-sha-unset-vs-empty: empty arm exited 0, want STALE exit"
grep -qi 'STALE' <<< "$err_empty" || \
    fail "seam-master-sha-unset-vs-empty: empty arm lacks STALE keyword (out: $err_empty)"
end_case seam-master-sha-unset-vs-empty

# --- case 29: seam-wtl-unset-vs-empty ---------------------------------------------------
# Unset POST_PLAN_FLEET_WTL → run_driver's single-dash expansion uses WTL_FIXTURE → WOULD FIRE.
# Empty POST_PLAN_FLEET_WTL="" → driver's :- expansion falls through to git worktree list
# (no fixture branches in the real tree) → all PRs SKIP; no crash.
begin_case
clean_slots
# Unset arm: POST_PLAN_FLEET_WTL not set in harness → run_driver expansion uses WTL_FIXTURE.
out_unset="$(POST_PLAN_FLEET_PR_JSON="$SCRATCH/two-open.json" run_driver 2>&1)"; rc=$?
[[ $rc -eq 0 ]] || fail "seam-wtl-unset-vs-empty: unset arm exit $rc"
grep -q 'WOULD FIRE' <<< "$out_unset" || \
    fail "seam-wtl-unset-vs-empty: unset arm has no WOULD FIRE (WTL_FIXTURE not used)"
# Empty arm: empty string → driver falls back to git worktree list (no fixture branches → all skip).
out_empty="$(POST_PLAN_FLEET_WTL="" POST_PLAN_FLEET_PR_JSON="$SCRATCH/two-open.json" run_driver 2>&1)"; rc=$?
[[ $rc -eq 0 ]] || fail "seam-wtl-unset-vs-empty: empty arm crashed (exit $rc)"
grep -q 'WOULD FIRE' <<< "$out_empty" && \
    fail "seam-wtl-unset-vs-empty: empty arm shows WOULD FIRE (git WTL should skip all)"
end_case seam-wtl-unset-vs-empty

# --- case 30: plist-shape-under-attack-selection -----------------------------------------
# When a PR is selected via --pr-attack, fire_pr writes the same plist structure as
# the default path. field() verifies Label and StandardOutPath are PR-number-keyed.
begin_case
clean_slots
POST_PLAN_FLEET_MASTER_SHA="$ATTACK_SHA" \
    POST_PLAN_FLEET_WTL="$WTL8" \
    POST_PLAN_FLEET_PR_JSON="$SCRATCH/attack-8prs.json" \
    POST_PLAN_FLEET_DRY_RUN=1 \
    run_driver --go --pr-attack "$SCRATCH/attack-fresh.md" --top-n 1 >/dev/null 2>&1
rc=$?
[[ $rc -eq 0 ]] || fail "plist-shape-under-attack-selection: driver exited $rc"
P1910="$SCRATCH/Library/LaunchAgents/com.ibl5.post-plan-fleet-1910.plist"
[[ -f "$P1910" ]] || fail "plist-shape-under-attack-selection: plist for PR 1910 not created"
v="$(field "$P1910" "Label")"
[[ "$v" == "com.ibl5.post-plan-fleet-1910" ]] || \
    fail "plist-shape-under-attack-selection: Label '$v' != com.ibl5.post-plan-fleet-1910"
v="$(field "$P1910" "StandardOutPath")"
[[ "$v" == "/tmp/post-plan-fleet-1910.log" ]] || \
    fail "plist-shape-under-attack-selection: StandardOutPath '$v' != /tmp/post-plan-fleet-1910.log"
grep -qE '\$\{?HOME|\$\{?ROOT|\$\{?LABEL' "$P1910" && \
    fail "plist-shape-under-attack-selection: plist contains unexpanded shell variable"
end_case plist-shape-under-attack-selection

# (case 31 was the L34 characterization: it asserted the buggy reaper freeing a live slot.
#  Deleted with the fix — case 32 is its inverse and is the permanent regression guard.)

# --- case 32: reap-respects-live-process -------------------------------------------------
# 32a: a plist whose process is ALIVE survives the first reap → the wait block actually waits.
# 32b: once that process exits, the next iteration DOES reap it → live_slots reaches 0.
# The 12s stub straddles the wait block's `sleep 20`: iteration 1 (t≈0) preserves, iteration 2
# (t≈20) reaps. A longer stub would loop to CEILING_SECS=7200 and hang the harness.
begin_case
clean_slots
mkdir -p "$SCRATCH/Library/LaunchAgents"
: > "$SCRATCH/Library/LaunchAgents/com.ibl5.post-plan-fleet-9001.plist"
clear_live_labels
( SLEEP_SECS=12 "$SLEEPER" --name com.ibl5.post-plan-fleet-9001 >/dev/null 2>&1 & )
sleep 0.5
pgrep -f "name com.ibl5.post-plan-fleet-9001$" >/dev/null 2>&1 \
    || fail "reap-respects-live-process: sleeper fixture never started"
out="$(POST_PLAN_FLEET_PR_JSON="$SCRATCH/two-open.json" run_driver --go --wait 2>&1)"; rc=$?
pkill -f "name com.ibl5.post-plan-fleet-9001$" 2>/dev/null || true
[[ $rc -eq 0 ]] || fail "reap-respects-live-process: exit $rc (out: $out)"
grep -qE 'waiting for [0-9]+ session' <<< "$out" \
    || fail "32a: reaped a slot whose process was alive — L34 has regressed (out: $out)"
grep -qF 'reaped stale slot com.ibl5.post-plan-fleet-9001' <<< "$out" \
    || fail "32b: never reaped the slot after its process exited (out: $out)"
[[ "$(plist_count)" -eq 0 ]] || fail "32b: drained to $(plist_count) plists, want 0"
clean_slots
end_case reap-respects-live-process

# --- case 32c: reap-fails-closed-on-broken-pgrep -----------------------------------------
# A pgrep that ERRORS (exit 2 — how procps rejects a BSD-only flag) must read as ALIVE.
# Reading an error as "dead" is exactly how a portability slip would silently restore L34.
# Because failing closed means the wait block never drains, the driver is bounded and killed
# rather than waited on; the assertion is on the surviving plist, not on the exit code.
begin_case
clean_slots
mkdir -p "$SCRATCH/Library/LaunchAgents"
: > "$SCRATCH/Library/LaunchAgents/com.ibl5.post-plan-fleet-9001.plist"
clear_live_labels
printf '#!/usr/bin/env bash\necho "pgrep: invalid option" >&2\nexit 2\n' > "$SCRATCH/.local/bin/pgrep"
chmod +x "$SCRATCH/.local/bin/pgrep"
POST_PLAN_FLEET_PR_JSON="$SCRATCH/two-open.json" run_driver --go --wait >/dev/null 2>&1 &
_p=$!
sleep 25
kill "$_p" 2>/dev/null || true
wait "$_p" 2>/dev/null || true
rm -f "$SCRATCH/.local/bin/pgrep"
[[ -e "$SCRATCH/Library/LaunchAgents/com.ibl5.post-plan-fleet-9001.plist" ]] \
    || fail "32c: reaped a slot on a pgrep ERROR exit — the probe is not failing closed"
clean_slots
end_case reap-fails-closed-on-broken-pgrep

# --- case 33: stop-flag-validation -------------------------------------------------------
# Every malformed or mode-conflicting invocation exits nonzero AND says why. A stop verb that
# exits 0 having done nothing is the worst outcome: the operator believes the run is dead.
begin_case
while IFS= read -r bad; do
    [[ -n "$bad" ]] || continue
    # shellcheck disable=SC2086  # word splitting is the mechanism under test
    out="$(run_driver $bad 2>&1)"; rc=$?
    [[ $rc -ne 0 ]] || fail "stop-flag-validation: '$bad' exited 0, want nonzero (out: $out)"
    grep -q 'ERROR' <<< "$out" || fail "stop-flag-validation: '$bad' printed no ERROR (out: $out)"
done <<'BADFORMS'
--stop
--stop 0
--stop abc
--stop 1901 --go
--stop 1901 --dry-run
--stop 1901 --wait
--stop 1901 --pr 1902
--stop 1901 --stop-all
--stop-all --stop 1901
BADFORMS
# `--stop ""` parses cleanly — the empty list has to be caught by the post-loop check, not the
# per-element regex, or the run exits 0 having stopped nothing.
out="$(run_driver --stop "" 2>&1)"; rc=$?
[[ $rc -ne 0 ]] || fail "stop-flag-validation: '--stop \"\"' exited 0, want nonzero (out: $out)"
grep -q 'ERROR' <<< "$out" || fail "stop-flag-validation: '--stop \"\"' printed no ERROR (out: $out)"
end_case stop-flag-validation

# Cases 34-36 use PR numbers 9002/19002/9003, chosen far above the live PR range (~1900),
# because /tmp is NOT scoped by the harness's scratch HOME. A fixture number that collided
# with a real in-flight PR would let the suite delete a real run's state.

# --- case 34: stop-e2e -------------------------------------------------------------------
# The whole point of L34: --stop must kill the process, release the slot exactly once, clear
# the scratch, and preserve the log.
begin_case
clean_slots
mkdir -p "$SCRATCH/Library/LaunchAgents"
: > "$SCRATCH/Library/LaunchAgents/com.ibl5.post-plan-fleet-9002.plist"
printf 'stale baseline\n' > /tmp/post-plan-fleet-scratch-9002.patch
printf 'partial run\n'    > /tmp/post-plan-fleet-9002.log
TMP_LOGS+=("/tmp/post-plan-fleet-scratch-9002.patch" "/tmp/post-plan-fleet-9002.log" "/tmp/post-plan-fleet-9002.log.aborted")
( SLEEP_SECS=120 "$SLEEPER" --name com.ibl5.post-plan-fleet-9002 >/dev/null 2>&1 & )
sleep 0.5
pgrep -f "name com.ibl5.post-plan-fleet-9002$" >/dev/null 2>&1 \
    || fail "stop-e2e: sleeper fixture never started — the case proves nothing"
out="$(run_driver --stop 9002 2>&1)"; rc=$?
[[ $rc -eq 0 ]] || fail "stop-e2e: exit $rc (out: $out)"
pgrep -f "name com.ibl5.post-plan-fleet-9002$" >/dev/null 2>&1 \
    && fail "stop-e2e: the process survived --stop (out: $out)"
[[ ! -e "$SCRATCH/Library/LaunchAgents/com.ibl5.post-plan-fleet-9002.plist" ]] \
    || fail "stop-e2e: plist not removed — the slot was never released"
[[ "$(plist_count)" -eq 0 ]] || fail "stop-e2e: live_slots sees $(plist_count), want 0"
[[ ! -e /tmp/post-plan-fleet-scratch-9002.patch ]] || fail "stop-e2e: /pr-ready scratch not cleared"
[[ -e /tmp/post-plan-fleet-9002.log.aborted ]] || fail "stop-e2e: log not preserved as .aborted"
[[ ! -e /tmp/post-plan-fleet-9002.log ]] || fail "stop-e2e: original log left in place"
pkill -f "name com.ibl5.post-plan-fleet-9002$" 2>/dev/null || true
clean_slots
# fire_pr pre-clear: stale scratch for a DEAD label is cleared; a LIVE label's is preserved.
printf 'stale\n' > /tmp/post-plan-fleet-scratch-1901.patch
printf 'stale\n' > /tmp/post-plan-fleet-scratch-11901.patch
TMP_LOGS+=("/tmp/post-plan-fleet-scratch-1901.patch" "/tmp/post-plan-fleet-scratch-11901.patch")
clean_slots
out="$(POST_PLAN_FLEET_PR_JSON="$SCRATCH/two-open.json" POST_PLAN_FLEET_DRY_RUN=1 run_driver --go 2>&1)"
[[ ! -e /tmp/post-plan-fleet-scratch-1901.patch ]] || fail "stop-e2e/pre-clear: stale scratch survived a fire"
[[ -e /tmp/post-plan-fleet-scratch-11901.patch ]] || fail "stop-e2e/pre-clear: glob is not PR-anchored — it ate 11901"
( SLEEP_SECS=30 "$SLEEPER" --name com.ibl5.post-plan-fleet-1902 >/dev/null 2>&1 & )
sleep 0.5
printf 'live\n' > /tmp/post-plan-fleet-scratch-1902.patch
TMP_LOGS+=("/tmp/post-plan-fleet-scratch-1902.patch")
out="$(POST_PLAN_FLEET_PR_JSON="$SCRATCH/two-open.json" POST_PLAN_FLEET_DRY_RUN=1 run_driver --go 2>&1)"
pkill -f "name com.ibl5.post-plan-fleet-1902$" 2>/dev/null || true
[[ -e /tmp/post-plan-fleet-scratch-1902.patch ]] \
    || fail "stop-e2e/pre-clear: deleted the scratch of a LIVE run"
clean_slots
end_case stop-e2e

# --- case 35: stop-label-anchor ----------------------------------------------------------
# --stop 9002 must NOT touch a live session for PR 19002. Unanchored `pgrep -f "name ...9002"`
# matches 19002 on BOTH BSD and procps (measured) — on the kill path that is a SIGKILL against
# the wrong run mid-publish. Never relax this into a positive-only check.
begin_case
clean_slots
mkdir -p "$SCRATCH/Library/LaunchAgents"
: > "$SCRATCH/Library/LaunchAgents/com.ibl5.post-plan-fleet-19002.plist"
( SLEEP_SECS=60 "$SLEEPER" --name com.ibl5.post-plan-fleet-19002 >/dev/null 2>&1 & )
sleep 0.5
out="$(run_driver --stop 9002 2>&1)"; rc=$?
pgrep -f "name com.ibl5.post-plan-fleet-19002$" >/dev/null 2>&1 \
    || fail "stop-label-anchor: --stop 9002 killed the live PR 19002 session (rc=$rc, out: $out)"
[[ -e "$SCRATCH/Library/LaunchAgents/com.ibl5.post-plan-fleet-19002.plist" ]] \
    || fail "stop-label-anchor: --stop 9002 released PR 19002's slot"
pkill -f "name com.ibl5.post-plan-fleet-19002$" 2>/dev/null || true
clean_slots
end_case stop-label-anchor

# --- case 36: stop-fails-closed ----------------------------------------------------------
# If something survives KILL, --stop must exit nonzero and LEAVE the slot held. Releasing a
# slot we cannot prove is free is the L34 corruption in a new costume.
# Costs ~7s (2s grace + the 5s settle bound); that bound exists so this path terminates.
begin_case
clean_slots
mkdir -p "$SCRATCH/Library/LaunchAgents"
: > "$SCRATCH/Library/LaunchAgents/com.ibl5.post-plan-fleet-9003.plist"
printf 'scratch\n' > /tmp/post-plan-fleet-scratch-9003.patch
TMP_LOGS+=("/tmp/post-plan-fleet-scratch-9003.patch")
printf '#!/usr/bin/env bash\nexit 0\n' > "$SCRATCH/.local/bin/pgrep"   # "always alive"
chmod +x "$SCRATCH/.local/bin/pgrep"
out="$(run_driver --stop 9003 2>&1)"; rc=$?
rm -f "$SCRATCH/.local/bin/pgrep"
[[ $rc -ne 0 ]] || fail "stop-fails-closed: exited 0 with the process still alive (out: $out)"
grep -q 'slot left occupied' <<< "$out" || fail "stop-fails-closed: no fail-closed message (out: $out)"
[[ -e "$SCRATCH/Library/LaunchAgents/com.ibl5.post-plan-fleet-9003.plist" ]] \
    || fail "stop-fails-closed: released the slot without proving the process died"
[[ -e /tmp/post-plan-fleet-scratch-9003.patch ]] \
    || fail "stop-fails-closed: cleared scratch for a run that may still be writing to it"
clean_slots
end_case stop-fails-closed

# === DM-dispatch cases (driver slice, 37–48) =============================================
# Shared setup: PR 9901 with headRefName=branch-live (already in WTL_FIXTURE at line 58),
# a DM-capture stub, a caffeinate shim (strips -s + timeout SECS; execs the remainder),
# and derive_status sourced from the driver for the cross-slice guards in cases 44 and 47.
_DM_PR=9901
_DM_JSON="$SCRATCH/dm-9901.json"
cat > "$_DM_JSON" <<'DMJSON'
[{"number": 9901, "title": "dm-test", "isDraft": false, "headRefName": "branch-live", "author": {"login": "a-jay85"}}]
DMJSON

_DM_CAPTURE="/tmp/pr-ready-test-dm-${_DM_PR}.txt"
_DM_STUB="$SCRATCH/.local/bin/pr-ready-dm-capture"
printf '#!/usr/bin/env bash\ncat >> "%s"\n' "$_DM_CAPTURE" > "$_DM_STUB"
chmod +x "$_DM_STUB"

# Shim: strip -s, then the 'timeout SECS' pair, then exec the remainder.  Avoids any
# dependency on a system timeout binary when the runner is executed manually in tests.
cat > "$SCRATCH/.local/bin/caffeinate" <<'CAFF'
#!/usr/bin/env bash
[ "${1:-}" = "-s" ] && shift
if [ "${1:-}" = "timeout" ]; then shift; shift; fi
exec "$@"
CAFF
chmod +x "$SCRATCH/.local/bin/caffeinate"

_DM_RUNNER="/tmp/post-plan-fleet-runner-${_DM_PR}.sh"
_DM_LOG="/tmp/post-plan-fleet-${_DM_PR}.log"
_DM_MARKER="/tmp/pr-ready-marker-${_DM_PR}.txt"
TMP_LOGS+=("$_DM_CAPTURE" "$_DM_LOG" "$_DM_MARKER" "$_DM_RUNNER"
           "/tmp/post-plan-fleet-prompt-${_DM_PR}.md"
           "/tmp/pr-ready-commenturl-${_DM_PR}.txt")

# run_driver bakes POST_PLAN_FLEET_CLAUDE="$CLAUDE_STUB" unconditionally via env; DM cases
# need their own stubs, so they bypass run_driver and call the driver directly.
run_dm_driver() {
    env HOME="$SCRATCH" \
        PATH="$SCRATCH/.local/bin:$PATH" \
        POST_PLAN_FLEET_GH_USER=a-jay85 \
        POST_PLAN_FLEET_ROOT="$SCRIPT_DIR/.." \
        POST_PLAN_FLEET_WTL="$WTL_FIXTURE" \
        "$DRIVER" "$@"
}

# Source derive_status from the driver for cross-slice guards in cases 44 and 47.
eval "$(sed -n '/^derive_status()/,/^}/p' "$DRIVER")"

# --- case 37: dm-fires-on-marker ----------------------------------------------------------
begin_case
clean_slots; rm -f "$_DM_LOG" "$_DM_MARKER" "$_DM_CAPTURE"
_cs37="$SCRATCH/.local/bin/dm-cs-37"
cat > "$_cs37" <<'STUB'
#!/usr/bin/env bash
printf 'READY\n'
printf 'RESULT: terminal=shipped-armed\n'
STUB
chmod +x "$_cs37"
POST_PLAN_FLEET_PR_JSON="$_DM_JSON" POST_PLAN_FLEET_DRY_RUN=1 \
    POST_PLAN_FLEET_DISCORD_DM="$_DM_STUB" POST_PLAN_FLEET_CLAUDE="$_cs37" \
    run_dm_driver --go >/dev/null 2>&1
HOME="$SCRATCH" bash "$_DM_RUNNER" >/dev/null 2>&1 || true
[[ -f "$_DM_CAPTURE" ]] \
    || fail "dm-fires-on-marker: capture file not created — DM was not sent"
_dm37_count="$(grep -c 'post-plan-fleet: PR #9901' "$_DM_CAPTURE" 2>/dev/null || echo 0)"
[[ "$_dm37_count" -eq 1 ]] \
    || fail "dm-fires-on-marker: expected 1 DM header, got $_dm37_count"
grep -q 'RESULT READY' "$_DM_CAPTURE" \
    || fail "dm-fires-on-marker: DM missing 'RESULT READY'"
end_case dm-fires-on-marker

# --- case 38: dm-fires-on-stop-line -------------------------------------------------------
begin_case
clean_slots; rm -f "$_DM_LOG" "$_DM_MARKER" "$_DM_CAPTURE"
_cs38="$SCRATCH/.local/bin/dm-cs-38"
printf '#!/usr/bin/env bash\nprintf "STOP: xyzzy-test-stop-reason\n"\n' > "$_cs38"
chmod +x "$_cs38"
POST_PLAN_FLEET_PR_JSON="$_DM_JSON" POST_PLAN_FLEET_DRY_RUN=1 \
    POST_PLAN_FLEET_DISCORD_DM="$_DM_STUB" POST_PLAN_FLEET_CLAUDE="$_cs38" \
    run_dm_driver --go >/dev/null 2>&1
HOME="$SCRATCH" bash "$_DM_RUNNER" >/dev/null 2>&1 || true
[[ -f "$_DM_CAPTURE" ]] \
    || fail "dm-fires-on-stop-line: no DM sent"
grep -q 'RESULT STOPPED' "$_DM_CAPTURE" \
    || fail "dm-fires-on-stop-line: DM not classified as STOPPED"
grep -q 'xyzzy-test-stop-reason' "$_DM_CAPTURE" \
    || fail "dm-fires-on-stop-line: DM missing first STOP: line text"
end_case dm-fires-on-stop-line

