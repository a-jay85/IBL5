SETUP="$REPO_ROOT/bin/usage-gate-cron-setup"

test_setup_print_plist_shape() {
    new_env
    local out first
    out=$("$SETUP" --print)
    assert_contains setup_shape:once "$out" "<string>--once</string>"
    assert_contains setup_shape:interval "$(printf '%s\n' "$out" | grep -A1 'StartInterval')" "<integer>60</integer>"
    assert_contains setup_shape:abandon "$(printf '%s\n' "$out" | grep -A1 'AbandonProcessGroup')" "<true/>"
    assert_contains setup_shape:path-usr-bin "$(printf '%s\n' "$out" | grep -A1 '<key>PATH</key>')" "/usr/bin:/bin"
    assert_contains setup_shape:path-local-bin "$(printf '%s\n' "$out" | grep -A1 '<key>PATH</key>')" "/.local/bin"
    first=$(printf '%s\n' "$out" | grep -A2 'ProgramArguments' | tail -1 | sed -e 's/.*<string>//' -e 's/<\/string>.*//')
    case "$first" in
        /*/bin/usage-gate-coordinator) pass setup_shape:program-absolute ;;
        *) fail setup_shape:program-absolute "got [$first]" ;;
    esac
}

test_setup_print_no_unexpanded() {
    new_env
    local out
    out="$("$SETUP" --print)
$("$SETUP" --print-probe)"
    if printf '%s\n' "$out" | grep -qE '\$\{|\$[A-Za-z_]'; then
        fail setup_unexpanded:dollar "found an unexpanded variable"
    else
        pass setup_unexpanded:dollar
    fi
    if printf '%s\n' "$out" | grep -q '<string></string>'; then
        fail setup_unexpanded:empty-string "found an empty <string>"
    else
        pass setup_unexpanded:empty-string
    fi
}

test_setup_print_touches_nothing() {
    new_env
    local h
    h=$(mktemp -d "$TMPROOT/home.XXXXXX")
    HOME="$h" "$SETUP" --print >/dev/null
    HOME="$h" "$SETUP" --print-probe >/dev/null
    assert_no_file setup_touch:no-library "$h/Library"
}

test_setup_rejects_bad_args() {
    new_env
    local rc
    "$SETUP" >/dev/null 2>&1; rc=$?
    assert_eq setup_args:none 2 "$rc"
    "$SETUP" --bogus >/dev/null 2>&1; rc=$?
    assert_eq setup_args:bogus 2 "$rc"
    "$SETUP" --print --install >/dev/null 2>&1; rc=$?
    assert_eq setup_args:two-actions 2 "$rc"
}

test_setup_empty_launchd_env() {
    new_env
    local h out rc
    h=$(mktemp -d "$TMPROOT/home.XXXXXX")
    out=$(env -i HOME="$h" PATH=/usr/bin:/bin "$SETUP" --print 2>&1); rc=$?
    assert_eq setup_launchd_env:rc 0 "$rc"
    assert_contains setup_launchd_env:homebrew "$out" "/opt/homebrew/bin"
}

test_setup_plutil_lint() {
    if ! command -v plutil >/dev/null 2>&1; then
        pass setup_plutil:skipped-no-plutil
        return 0
    fi
    new_env
    "$SETUP" --print | plutil -lint - >/dev/null 2>&1
    assert_eq setup_plutil:coordinator 0 "$?"
    "$SETUP" --print-probe | plutil -lint - >/dev/null 2>&1
    assert_eq setup_plutil:probe 0 "$?"
}

# ---------------------------------------------------------------- Phase 6

# in_env <bash-snippet>: run with the stub dir first on PATH and a private HOME.
in_env() {
    ( export PATH="$STUB:$ORIG_PATH" HOME="$T/home"; mkdir -p "$HOME"; gate_run "$1" )
}

PPN_BIN="$REPO_ROOT/bin/post-plan-now"

test_argv_roundtrip() {
    new_env
    local out
    out=$(gate_run "usage_argv_save $SID_A --auto '' 'a b' --resume; while IFS= read -r -d '' a; do printf '[%s]' \"\$a\"; done < <(usage_argv_load $SID_A)")
    assert_eq argv_roundtrip "[--auto][][a b][--resume]" "$out"
    gate_run "usage_argv_load $SID_B" >/dev/null 2>&1
    assert_eq argv_roundtrip:missing-rc 1 "$?"
}

test_session_started() {
    new_env
    mkdir -p "$T/home/.claude/projects/-some-proj"
    : > "$T/home/.claude/projects/-some-proj/$SID_A.jsonl"
    in_env "usage_session_started $SID_A"
    assert_eq session_started:present 0 "$?"
    in_env "usage_session_started $SID_B"
    assert_eq session_started:absent 1 "$?"
    in_env "usage_session_started ../x"
    assert_eq session_started:bad-sid 1 "$?"
}

