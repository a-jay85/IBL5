CF_NR_OUT="$(cf_decide "$BCFD")"
cf_check cf-not-ready "$CF_NR_OUT" "FIDELITY_GATE=spawn" "FIDELITY_GATE_REASON=prior-verdict-not-terminal" "!CARRY_WORD="

