#!/usr/bin/env bash
# bin/lib/prefire-verify — pre-fire verification gate.
#
# Re-runs two checks on the current working tree before /post-plan fires (ADR-0244):
#   1. every post-impl CLI-executable row of the plan's Verification Matrix
#      (a row whose whole command is one of six whole-suite runs CI covers is skipped; see is_whole_suite_cmd;
#      a row that row_runs_in_ci sends to the Plan checks CI job is skipped too)
#   2. PHPUnit on the tests mapped to the branch's changed files (full suite when a
#      shared test input changed or mapping failed; skipped when no PHPUnit-relevant file changed)
# The Executable Mutations rows (bin/lib/plan-exec-mutations run) run in the Plan checks CI job.
# The exec-mutations stage stays for an implementer who asks for it by name; "all" leaves it out.
# Mutation score is gated by CI's required check "Infection PHP (per-PR diff)" (ADR-0237).
# It trusts no implementer-written ledger. Only this script writes pass records,
# keyed by tree hash, in the per-worktree git dir. It fails closed.
#
# Matrix rows whose command names actionlint or shellcheck run with SHELLCHECK_OPTS
# set from bin/lib/shell-lint-opts.sh, the flags bin/lint-workflows passes, so
# a row fails on the findings CI fails on and passes on the info notes CI ignores.
# A row that sets SHELLCHECK_OPTS inline overrides it.
#
# Usage: bin/lib/prefire-verify [--plan <path>] [--stage matrix|phases|phpunit|pytest|exec-mutations|all]
#                               [--base <ref>] [--bypass <reason>] [--fire-point]
#   --fire-point  exec-mutations only: use the larger limits (300 s per check run, 1800 s
#                 total) instead of the implementer's 120 s / 300 s. The fire point's "all" run
#                 skips that stage, so the flag matters only for a named exec-mutations run.
#                 bin/post-plan-now passes it; a pass under either limit is the same record.
#   --base        base ref for the phpunit and pytest stages' diff (default: git config
#                 branch.<name>.iblBase, else origin/master)
# Exit codes:
#   0  every requested stage passed (fresh run, or a valid pass record for this tree)
#   1  a check failed (the message names the matrix row or the stage)
#      (an exec-mutations row that did not trip, or a mutation revert that failed)
#      (a phases-stage MISSING-PHASE item: a plan phase whose cited files the diff never touched)
#   2  usage error, including --plan with an empty value (omit the flag when there is no plan)
#   3  prerequisite missing: vendor/bin/phpunit, python3 -m pytest, docker, the DB container, gtimeout/timeout
#   4  the checks changed the working tree, so no pass record was written
#
# Test seams (used only by bin/test-prefire-verify):
#   PREFIRE_PHPUNIT_CMD    default vendor/bin/phpunit, run from ibl5/; subset mode appends test paths as arguments
#   PREFIRE_PYTEST_CMD     default python3 -m pytest; "<cmd> --version" is the prerequisite probe; a run goes from tools/postplan-harness/ with -q -p no:xdist -p no:cacheprovider and the test paths
#   PREFIRE_DB_PROBE_CMD   default bin/db-query "SELECT 1", run from the repo root
#   PREFIRE_PHASES_CMD     default python3 -m harness.conformance, run from tools/postplan-harness/ as "<cmd> --phases <plan> <root>"; empty means the default
#   PREFIRE_EXEC_MUTATIONS_LIB  default bin/lib/plan-exec-mutations
#
# Environment:
#   PREFIRE_PHPUNIT_FULL=1  run the full suite; 0, empty or unset maps files to tests and defers unmapped files to CI

set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/lib/plan-matrix-rows.sh
source "$SELF_DIR/plan-matrix-rows.sh"
# shellcheck source=bin/lib/shell-lint-opts.sh
source "$SELF_DIR/shell-lint-opts.sh"

# A matrix row whose command names actionlint or shellcheck as a word runs with
# SHELLCHECK_OPTS set to the shared policy. A boundary excludes letters, digits,
# `_`, `.` and `-`, so bin/lint-workflows, myactionlint and actionlint.sh do not match.
SC_ROW_RE='(^|[^[:alnum:]_.-])(actionlint|shellcheck)($|[^[:alnum:]_.-])'
row_runs_shellcheck() { [[ $1 =~ $SC_ROW_RE ]]; }

say() { printf 'prefire-verify: %s\n' "$*"; }
die() { local rc="$1"; shift; printf 'prefire-verify: %s\n' "$*" >&2; exit "$rc"; }

PLAN=""
STAGE="all"
BASE_OPT=""
BYPASS_REASON=""
BYPASS_SET=0
FIRE_POINT=0

while [ $# -gt 0 ]; do
    case "$1" in
        --plan)   [ $# -ge 2 ] || die 2 "--plan needs a path"
                  [ -n "$2" ] || die 2 "--plan got an empty value; omit the flag when there is no plan"
                  PLAN="$2"; shift 2 ;;
        --stage)  [ $# -ge 2 ] || die 2 "--stage needs a value"; STAGE="$2"; shift 2 ;;
        --base)   [ $# -ge 2 ] || die 2 "--base needs a ref"; BASE_OPT="$2"; shift 2 ;;
        --bypass) [ $# -ge 2 ] || die 2 "--bypass needs a reason"; BYPASS_REASON="$2"; BYPASS_SET=1; shift 2 ;;
        --fire-point) FIRE_POINT=1; shift ;;
        -h|--help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) die 2 "unknown argument '$1'" ;;
    esac
done

case "$STAGE" in
    matrix|phases|phpunit|pytest|exec-mutations|all) : ;;
    infection) die 2 "--stage infection was removed; CI's required check \"Infection PHP (per-PR diff)\" covers mutation testing, so skip this call" ;;
    *) die 2 "--stage must be matrix, phases, phpunit, pytest, exec-mutations, or all (got '$STAGE')" ;;
esac
case "${PREFIRE_PHPUNIT_FULL:-}" in
    ''|0|1) : ;;
    *) die 2 "PREFIRE_PHPUNIT_FULL must be 1, 0, or unset (got '${PREFIRE_PHPUNIT_FULL}')" ;;
esac
if [ "$BYPASS_SET" -eq 1 ] && [ -z "$BYPASS_REASON" ]; then
    die 2 "--bypass needs a non-empty reason"
fi
if [ -n "$PLAN" ] && [ ! -f "$PLAN" ]; then
    die 2 "plan file not found: $PLAN"
fi
# The check above reads --plan from the caller's cwd. The cd below moves to the
# repo root, so pin the path now or a relative plan stops resolving.
if [ -n "$PLAN" ]; then
    PLAN="$(cd "$(dirname "$PLAN")" && pwd)/$(basename "$PLAN")"
fi

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || die 2 "not inside a git work tree"
cd "$ROOT" || die 2 "cannot cd to $ROOT"

prefire_tree_hash() {
    local idx rc
    idx=$(mktemp "${TMPDIR:-/tmp}/prefire-idx.XXXXXX") || return 1
    cp "$(git rev-parse --git-path index)" "$idx" 2>/dev/null || true
    GIT_INDEX_FILE="$idx" git add -A >/dev/null 2>&1 \
        && GIT_INDEX_FILE="$idx" git write-tree
    rc=$?
    rm -f "$idx"
    return $rc
}

XM_LIB="${PREFIRE_EXEC_MUTATIONS_LIB:-$SELF_DIR/plan-exec-mutations}"
# SIGKILL cannot be trapped, so an earlier exec-mutations run may have left a mutation
# applied and journalled. Restore it before the tree hash is taken: no stage may run
# against, or record a pass for, a mutated tree.
"$XM_LIB" pending --root "$ROOT" >/dev/null 2>&1
case $? in
    0)
        _xr=0; "$XM_LIB" recover --root "$ROOT" >/dev/null 2>&1 || _xr=$?
        [ "$_xr" -ne 4 ] || die 3 "another plan-exec-mutations run holds this worktree's exec lock; wait for it to finish, then re-run"
        [ "$_xr" -eq 0 ] \
            || die 1 "an interrupted exec-mutations run left a mutation that recover could not restore; run bin/lib/plan-exec-mutations recover --root $ROOT, check git status, then re-run"
        say "restored a mutation left by an interrupted exec-mutations run" ;;
    1) : ;;
    *) die 3 "cannot read the exec-mutations journal (plan-exec-mutations pending failed)" ;;
esac

TREE=$(prefire_tree_hash) || die 3 "cannot compute the working-tree hash"
TREE7="${TREE:0:7}"
STATE_DIR="$(git rev-parse --git-path prefire-verify)"
mkdir -p "$STATE_DIR" || die 3 "cannot create $STATE_DIR"

# --- escape hatch (human only, logged) -------------------------------------
if [ "$BYPASS_SET" -eq 1 ]; then
    if [ "${CLAUDE_HEADLESS:-0}" = "1" ]; then
        die 2 "--bypass is for a human at a terminal; refused under CLAUDE_HEADLESS"
    fi
    if [ "${#BYPASS_REASON}" -lt 15 ]; then
        die 2 "--bypass needs a reason of at least 15 characters"
    fi
    BYPASS_LOG="$(git rev-parse --git-common-dir)/prefire-verify-bypass.log"
    printf '%s\t%s\t%s\t%s\t%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        "$(git rev-parse --abbrev-ref HEAD)" "$TREE7" "${USER:-unknown}" "$BYPASS_REASON" \
        >> "$BYPASS_LOG"
    printf 'prefire-verify: BYPASSED (logged to %s): %s\n' "$BYPASS_LOG" "$BYPASS_REASON" >&2
    exit 0
fi

# --- pass records -----------------------------------------------------------
record_path() { # <stage> <key>
    if [ -n "$2" ]; then
        printf '%s/%s.%s.%s.pass' "$STATE_DIR" "$TREE" "$1" "$2"
    else
        printf '%s/%s.%s.pass' "$STATE_DIR" "$TREE" "$1"
    fi
}

cache_hit() { # <stage> <key>; prints the cache message on a hit
    local f body at
    f=$(record_path "$1" "$2")
    [ -f "$f" ] || return 1
    body=$(cat "$f")
    case " $body " in *" tree=$TREE "*) : ;; *) return 1 ;; esac
    if [ -n "$2" ]; then
        case " $body " in *" key=$2 "*) : ;; *) return 1 ;; esac
    fi
    at="${body#*at=}"; at="${at%% *}"
    say "$1 pass cached for tree $TREE7 (recorded $at)"
    return 0
}

write_record() { # <stage> <key>
    printf 'stage=%s tree=%s key=%s at=%s by=prefire-verify\n' \
        "$1" "$TREE" "${2:-none}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$(record_path "$1" "$2")"
}

# --- matrix stage -----------------------------------------------------------
# Exit 0 when a matrix row's whole command, after trimming whitespace and an
# optional `cd ibl5 &&` prefix, is exactly a whole-suite run that CI's required
# checks already cover. Exact match only: any filter, path, --group, pipe or
# `&&` chain to another command still runs.
stage_matrix() {
    local plan_sha rows rc num cmd log rows_rc
    if [ -z "$PLAN" ]; then
        say "SKIP matrix: no plan (ad-hoc path); PHPUnit still runs"
        return 0
    fi
    plan_sha=$(git hash-object "$PLAN")
    cache_hit matrix "$plan_sha" && return 0

    rows=$(plan_matrix_rows "$PLAN"); rows_rc=$?
    if [ "$rows_rc" -eq 2 ]; then
        say "FAIL plan has no Verification Matrix; no evidence to check" >&2
        return 1
    fi

    # DB probe, once, before the first DB-touching row.
    local db_re="$PLAN_ROW_DB_RE"
    local first_db_num="" first_db_cmd=""
    while IFS=$'\t' read -r num cmd; do
        [ -n "$num" ] || continue
        if grep -Eq -- "$db_re" <<< "$cmd"; then first_db_num="$num"; first_db_cmd="$cmd"; break; fi
    done <<< "$rows"
    if [ -n "$first_db_num" ]; then
        if [ -n "${PREFIRE_DB_PROBE_CMD:-}" ]; then
            bash -c "$PREFIRE_DB_PROBE_CMD" </dev/null >/dev/null 2>&1; rc=$?
        else
            bin/db-query "SELECT 1" >/dev/null 2>&1; rc=$?
        fi
        if [ "$rc" -ne 0 ]; then
            say "FAIL DB unreachable; matrix row $first_db_num needs it ($first_db_cmd). Start the worktree stack, then re-run" >&2
            return 3
        fi
    fi

    log="$STATE_DIR/$TREE.matrix.log"
    : > "$log"
    # Rows that repeat a command run it once: same command, same tree, same result.
    # A plan with 23 rows of one test file ran it 23 times (about 6 minutes each).
    local ran_cmds=() prev dup
    while IFS=$'\t' read -r num cmd; do
        [ -n "$num" ] || continue
        if is_whole_suite_cmd "$cmd"; then
            say "matrix row $num: skipped, CI covers full-suite runs: $cmd"
            printf '### row %s: skipped, CI covers full-suite runs\n' "$num" >> "$log"
            continue
        fi
        if row_runs_in_ci "$cmd"; then
            say "matrix row $num: runs in CI (Plan checks), skipped locally: $cmd"
            printf '### row %s: runs in CI (Plan checks)\n' "$num" >> "$log"
            continue
        fi
        dup=0
        for prev in ${ran_cmds[@]+"${ran_cmds[@]}"}; do
            if [ "$prev" = "$cmd" ]; then dup=1; break; fi
        done
        if [ "$dup" -eq 1 ]; then
            say "matrix row $num: same command as an earlier row, already passed: $cmd"
            printf '### row %s: same command as an earlier row, already passed\n' "$num" >> "$log"
            continue
        fi
        ran_cmds+=("$cmd")
        say "matrix row $num: $cmd"
        printf '### row %s: %s\n' "$num" "$cmd" >> "$log"
        ( if row_runs_shellcheck "$cmd"; then export SHELLCHECK_OPTS="$IBL5_SC_OPTS"; fi
          exec bash -c "$cmd" ) </dev/null >> "$log" 2>&1; rc=$?
        if [ "$rc" -ne 0 ]; then
            say "FAIL matrix row $num exited $rc: $cmd" >&2
            tail -n 30 "$log" >&2
            return 1
        fi
    done <<< "$rows"
    write_record matrix "$plan_sha"
    say "matrix passed"
    return 0
}

# --- phpunit test selection -------------------------------------------------
# prefire_phpunit_select <list-file> sets PHPUNIT_MODE (subset|full|skip) and
# PHPUNIT_REASON. In subset mode it writes test paths, relative to ibl5/, to
# <list-file>. Every error path calls phpunit_full, so errors run the full suite.
# A changed file with no mapped test, or a shared test input, calls phpunit_defer
# instead: it runs nothing locally, because CI runs the full suite on every push.
# stage_phpunit prints each deferred file on a "phpunit deferred to CI:" line.
PHPUNIT_MODE=""
PHPUNIT_REASON=""
PHPUNIT_DEFERRED=""
PHPUNIT_DEFERRED_N=0
phpunit_full() { PHPUNIT_MODE=full; PHPUNIT_REASON="$1"; }
phpunit_defer() { PHPUNIT_DEFERRED="${PHPUNIT_DEFERRED}$1"$'\n'; PHPUNIT_DEFERRED_N=$((PHPUNIT_DEFERRED_N + 1)); }
phpunit_say_deferred() {
    local d
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        say "phpunit deferred to CI: $d"
    done <<< "$PHPUNIT_DEFERRED"
}

# Base for the diff: --base, else git config branch.<name>.iblBase, else origin/master.
prefire_phpunit_base() {
    local br cfg
    if [ -n "$BASE_OPT" ]; then printf '%s\n' "$BASE_OPT"; return 0; fi
    br=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || br=""
    cfg=$(git config "branch.$br.iblBase" 2>/dev/null) || cfg=""
    if [ -n "$cfg" ]; then printf '%s\n' "$cfg"; return 0; fi
    printf 'origin/master\n'
}

prefire_phpunit_map_source() { # <repo-relative source path> <list-file>
    local src="$1" out="$2" rel name cand rc
    case "$src" in
        ibl5/classes/*) rel="${src#ibl5/classes/}" ;;
        *) rel="PHPStanRules/${src#ibl5/phpstan-rules/}" ;;
    esac
    rel="${rel%.php}"
    name="${rel##*/}"
    for cand in "tests/${rel}Test.php" "tests/DatabaseIntegration/${rel}Test.php"; do
        if [ -f "ibl5/$cand" ]; then printf '%s\n' "$cand" >> "$out"; fi
    done
    (cd ibl5 && git grep -l --untracked -w -F -e "$name" -- 'tests/*Test.php' ':(exclude)tests/PHPStanRules/Fixtures') >> "$out"
    rc=$?
    [ "$rc" -le 1 ]
}

# Succeeds when the changed class is one that other classes build on: it declares
# an abstract class, trait or interface, or another class extends it. Tests of
# the subclasses and users need not name it, so name-matching would skip them.
prefire_phpunit_is_shared_base() { # <repo-relative source path>
    local src="$1" name
    name="${src##*/}"; name="${name%.php}"
    if [ -f "$src" ] && command grep -qE '^[[:space:]]*((abstract|final|readonly)[[:space:]]+)*(abstract[[:space:]]+class|trait|interface)[[:space:]]' "$src"; then
        return 0
    fi
    if [ -d ibl5/classes ] && command grep -rqE --include='*.php' "(extends|implements)[^{]*[[:space:],\\\\]${name}([[:space:],{]|\$)" ibl5/classes; then
        return 0
    fi
    return 1
}

# A path outside ibl5/ adds every test that names it by its repo-relative path.
prefire_phpunit_map_path_ref() { # <repo-relative path> <list-file>
    local rc
    (cd ibl5 && git grep -l --untracked -F -e "$1" -- 'tests/*Test.php' ':(exclude)tests/PHPStanRules/Fixtures') >> "$2"
    rc=$?
    [ "$rc" -le 1 ]
}

prefire_phpunit_select() { # <list-file>
    local out="$1" base mb changed status path before after
    PHPUNIT_MODE=""; PHPUNIT_REASON=""; PHPUNIT_DEFERRED=""; PHPUNIT_DEFERRED_N=0
    if [ "${PREFIRE_PHPUNIT_FULL:-}" = "1" ]; then phpunit_full "PREFIRE_PHPUNIT_FULL=1"; return 0; fi
    base=$(prefire_phpunit_base)
    if ! git rev-parse --verify -q "$base^{commit}" >/dev/null 2>&1; then
        if git rev-parse --verify -q "origin/$base^{commit}" >/dev/null 2>&1; then base="origin/$base"
        else phpunit_full "cannot resolve base '$base'"; return 0; fi
    fi
    mb=$(git merge-base "$base" HEAD 2>/dev/null) || { phpunit_full "no merge-base between $base and HEAD"; return 0; }
    changed=$(mktemp "${TMPDIR:-/tmp}/prefire-changed.XXXXXX") || { phpunit_full "cannot create a temp file"; return 0; }
    if ! git -c core.quotePath=false diff --name-status --no-renames "$mb" -- > "$changed" 2>/dev/null; then
        rm -f "$changed"; phpunit_full "cannot diff the tree against $base"; return 0
    fi
    if ! git -c core.quotePath=false ls-files --others --exclude-standard > "$changed.u" 2>/dev/null; then
        rm -f "$changed" "$changed.u"; phpunit_full "cannot list untracked files"; return 0
    fi
    while IFS= read -r path; do printf 'A\t%s\n' "$path"; done < "$changed.u" >> "$changed"
    rm -f "$changed.u"
    while IFS=$'\t' read -r status path; do
        [ -n "$path" ] || continue
        case "$path" in
            ibl5/phpunit.xml|ibl5/phpunit.xml.dist|ibl5/tests/bootstrap.php|ibl5/composer.json|ibl5/composer.lock)
                phpunit_defer "shared PHPUnit input changed: $path"; continue ;;
            ibl5/tests/e2e/*|*.md) continue ;;
            ibl5/tests/PHPStanRules/Fixtures/*)
                phpunit_defer "PHPStan rule fixture changed: $path"; continue ;;
            ibl5/tests/*Test.php)
                if [ -f "$path" ]; then printf '%s\n' "${path#ibl5/}" >> "$out"
                else phpunit_defer "test file deleted: $path"; fi
                continue ;;
            ibl5/tests/*)
                phpunit_defer "shared test helper or fixture changed: $path"; continue ;;
            ibl5/classes/*.php|ibl5/phpstan-rules/*.php)
                if [ "$status" = D ]; then phpunit_defer "source file deleted: $path"; continue; fi
                if prefire_phpunit_is_shared_base "$path"; then
                    phpunit_defer "shared base (abstract class, trait, interface, or extended class): $path"; continue
                fi
                before=$(wc -l < "$out" | tr -d ' ')
                prefire_phpunit_map_source "$path" "$out" || { phpunit_full "cannot search ibl5/tests for $path"; break; }
                after=$(wc -l < "$out" | tr -d ' ')
                if [ "$after" -le "$before" ]; then phpunit_defer "no test file maps to the changed PHP: $path"; fi
                continue ;;
            ibl5/*)
                phpunit_defer "file under ibl5/ with no test mapping: $path"; continue ;;
            *)
                # Outside ibl5/: Cli tests run scripts such as bin/adr-check by path.
                prefire_phpunit_map_path_ref "$path" "$out" || { phpunit_full "cannot search ibl5/tests for $path"; break; }
                continue ;;
        esac
    done < "$changed"
    rm -f "$changed"
    [ "$PHPUNIT_MODE" = full ] && return 0
    if [ ! -s "$out" ]; then
        PHPUNIT_MODE=skip
        if [ "$PHPUNIT_DEFERRED_N" -gt 0 ]; then
            PHPUNIT_REASON="deferred to CI, which runs the full suite; changed files with no local test: $PHPUNIT_DEFERRED_N"
        else
            PHPUNIT_REASON="no PHPUnit-relevant file changed against $base"
        fi
        return 0
    fi
    sort -u "$out" -o "$out" || { phpunit_full "cannot sort the test list"; return 0; }
    PHPUNIT_MODE=subset
}

# --- pytest test selection --------------------------------------------------
# prefire_pytest_select <list-file> sets PYTEST_MODE (subset|skip) and PYTEST_REASON.
# In subset mode it writes test paths, relative to tools/postplan-harness/, to <list-file>.
# There is no full mode. An error, a shared input, an unmapped file, or a selection
# over PYTEST_CAP defers to CI, whose python-tests.yml runs the whole harness suite.
PYTEST_HOME="tools/postplan-harness"
PYTEST_CAP=25
PYTEST_MODE=""
PYTEST_REASON=""
PYTEST_DEFERRED=""
PYTEST_DEFERRED_N=0
PYTEST_TRIGGERED=0
pytest_defer() { PYTEST_DEFERRED="${PYTEST_DEFERRED}$1"$'\n'; PYTEST_DEFERRED_N=$((PYTEST_DEFERRED_N + 1)); }
pytest_abort() { pytest_defer "$1"; PYTEST_MODE=skip; PYTEST_REASON="deferred to CI: $1"; }
pytest_say_deferred() {
    local d
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        say "pytest deferred to CI: $d"
    done <<< "$PYTEST_DEFERRED"
}

pytest_grep_tests() { # <extended regex> <list-file>; appends top-level tests/test_*.py that match
    local rc
    (cd "$PYTEST_HOME" && git grep -l --untracked -E -e "$1" -- 'tests/test_*.py' ':(exclude)tests/*/*') >> "$2"
    rc=$?
    [ "$rc" -le 1 ]
}

pytest_map_module() { # <path relative to tools/postplan-harness/, ending .py> <list-file>
    local rel="${1%.py}" dotted leaf parent b='([^A-Za-z0-9_]|$)'
    leaf="${rel##*/}"
    case "$rel" in
        */*)
            dotted=$(printf '%s' "$rel" | sed 's/\//\\./g')
            parent=$(printf '%s' "${rel%/*}" | sed 's/\//\\./g')
            pytest_grep_tests "(^|[^A-Za-z0-9_.])${dotted}${b}" "$2" || return 1
            pytest_grep_tests "^[[:space:]]*from[[:space:]]+${parent}[[:space:]]+import(.*[^A-Za-z0-9_])?${leaf}${b}" "$2" ;;
        *)
            pytest_grep_tests "^[[:space:]]*(import|from)[[:space:]]+${leaf}${b}" "$2" ;;
    esac
}

pytest_map_script() { # <repo-relative script path> <list-file>
    local esc
    esc=$(printf '%s' "${1##*/}" | sed 's/[.]/\\./g')
    pytest_grep_tests "(^|[^A-Za-z0-9_.-])${esc}([^A-Za-z0-9_-]|$)" "$2"
}

prefire_pytest_select() { # <list-file>
    local out="$1" base mb changed status path rel n before after
    PYTEST_MODE=""; PYTEST_REASON=""; PYTEST_DEFERRED=""; PYTEST_DEFERRED_N=0; PYTEST_TRIGGERED=0
    base=$(prefire_phpunit_base)
    if ! git rev-parse --verify -q "$base^{commit}" >/dev/null 2>&1; then
        if git rev-parse --verify -q "origin/$base^{commit}" >/dev/null 2>&1; then base="origin/$base"
        else pytest_abort "cannot resolve base '$base'"; return 0; fi
    fi
    mb=$(git merge-base "$base" HEAD 2>/dev/null) || { pytest_abort "no merge-base between $base and HEAD"; return 0; }
    changed=$(mktemp "${TMPDIR:-/tmp}/prefire-pychanged.XXXXXX") || { pytest_abort "cannot create a temp file"; return 0; }
    if ! git -c core.quotePath=false diff --name-status --no-renames "$mb" -- > "$changed" 2>/dev/null; then
        rm -f "$changed"; pytest_abort "cannot diff the tree against $base"; return 0
    fi
    if ! git -c core.quotePath=false ls-files --others --exclude-standard > "$changed.u" 2>/dev/null; then
        rm -f "$changed" "$changed.u"; pytest_abort "cannot list untracked files"; return 0
    fi
    while IFS= read -r path; do printf 'A\t%s\n' "$path"; done < "$changed.u" >> "$changed"
    rm -f "$changed.u"
    while IFS=$'\t' read -r status path; do
        [ -n "$path" ] || continue
        case "$path" in
            *.md) continue ;;
            "$PYTEST_HOME"/tests/test_*.py)
                PYTEST_TRIGGERED=1
                rel="${path#"$PYTEST_HOME"/}"
                case "${rel#tests/}" in */*) pytest_defer "nested test file, CI runs it: $path"; continue ;; esac
                if [ -f "$path" ]; then printf '%s\n' "$rel" >> "$out"
                else pytest_defer "test file deleted: $path"; fi
                continue ;;
            "$PYTEST_HOME"/tests/*)
                PYTEST_TRIGGERED=1; pytest_defer "shared test helper or fixture changed: $path"; continue ;;
            "$PYTEST_HOME"/harness/state.py|"$PYTEST_HOME"/*__init__.py)
                PYTEST_TRIGGERED=1; pytest_defer "shared harness module imported by most tests: $path"; continue ;;
            "$PYTEST_HOME"/harness/*.py|"$PYTEST_HOME"/runner.py)
                PYTEST_TRIGGERED=1
                before=$(wc -l < "$out" | tr -d ' ')
                pytest_map_module "${path#"$PYTEST_HOME"/}" "$out" || { pytest_abort "cannot search $PYTEST_HOME/tests for $path"; break; }
                after=$(wc -l < "$out" | tr -d ' ')
                if [ "$after" -le "$before" ]; then pytest_defer "no harness test imports the changed module: $path"; fi
                continue ;;
            "$PYTEST_HOME"/*)
                PYTEST_TRIGGERED=1; pytest_defer "harness file with no test mapping: $path"; continue ;;
            .github/workflows/python-tests.yml)
                PYTEST_TRIGGERED=1; pytest_defer "harness CI workflow changed: $path"; continue ;;
            bin/lib/pr-armable.sh|bin/lib/post-review-findings.sh|bin/post-plan-now|bin/lib/branch-base.sh|bin/lib/usage-gate.sh|bin/normalize-manual-testing|bin/lib/pr-sticky.sh|bin/lib/current-models|bin/check-*|bin/gate-backtest|.claude/review-shared/scripts/lostwork.sh)
                PYTEST_TRIGGERED=1
                before=$(wc -l < "$out" | tr -d ' ')
                pytest_map_script "$path" "$out" || { pytest_abort "cannot search $PYTEST_HOME/tests for $path"; break; }
                after=$(wc -l < "$out" | tr -d ' ')
                if [ "$after" -le "$before" ]; then pytest_defer "no harness test names the changed script: $path"; fi
                continue ;;
            *) continue ;;
        esac
    done < "$changed"
    rm -f "$changed"
    if [ "$PYTEST_MODE" = skip ]; then return 0; fi
    if [ "$PYTEST_TRIGGERED" -eq 0 ]; then
        PYTEST_MODE=skip; PYTEST_REASON="no harness trigger path changed against $base"; return 0
    fi
    if [ ! -s "$out" ]; then
        PYTEST_MODE=skip
        PYTEST_REASON="deferred to CI, which runs the whole harness suite; changed files with no local test: $PYTEST_DEFERRED_N"
        return 0
    fi
    sort -u "$out" -o "$out" || { pytest_abort "cannot sort the test list"; return 0; }
    n=$(wc -l < "$out" | tr -d ' ')
    if [ "$n" -gt "$PYTEST_CAP" ]; then pytest_abort "$n test files selected, over the local cap of $PYTEST_CAP"; return 0; fi
    PYTEST_MODE=subset
}

# --- phpunit stage ----------------------------------------------------------
stage_phpunit() {
    local log rc key list t cmd="${PREFIRE_PHPUNIT_CMD:-vendor/bin/phpunit}"
    local -a targets
    targets=()
    key=""
    if list=$(mktemp "${TMPDIR:-/tmp}/prefire-phpunit.XXXXXX"); then
        prefire_phpunit_select "$list"
    else
        list=""; phpunit_full "cannot create the test-list file"
    fi
    case "$PHPUNIT_MODE" in
        skip)
            rm -f "$list"
            phpunit_say_deferred
            say "phpunit mode: skipped ($PHPUNIT_REASON)"
            return 0 ;;
        subset)
            while IFS= read -r t; do targets[${#targets[@]}]="$t"; done < "$list"
            key="subset-$(git hash-object "$list" | cut -c1-12)"
            say "phpunit mode: subset (${#targets[@]} test files)"
            if [ "$PHPUNIT_DEFERRED_N" -gt 0 ]; then
                say "phpunit subset covers mapped files only; CI runs the full suite (deferred files: $PHPUNIT_DEFERRED_N)"
                phpunit_say_deferred
            fi ;;
        *)
            PHPUNIT_MODE=full
            say "phpunit mode: full ($PHPUNIT_REASON)" ;;
    esac
    [ -n "$list" ] && rm -f "$list"
    cache_hit phpunit "" && return 0
    if [ -n "$key" ]; then cache_hit phpunit "$key" && return 0; fi
    if [ -z "${PREFIRE_PHPUNIT_CMD:-}" ] && [ ! -x ibl5/vendor/bin/phpunit ]; then
        say "FAIL phpunit prerequisite missing: ibl5/vendor/bin/phpunit; run composer install in ibl5/" >&2
        return 3
    fi
    log="$STATE_DIR/$TREE.phpunit.log"
    if [ "$PHPUNIT_MODE" = subset ]; then
        { printf 'prefire-verify phpunit mode: subset\n'; printf '  %s\n' "${targets[@]}"; } > "$log"
        (cd ibl5 && bash -c "$cmd \"\$@\"" prefire-phpunit "${targets[@]}") >> "$log" 2>&1; rc=$?
    else
        printf 'prefire-verify phpunit mode: full (%s)\n' "$PHPUNIT_REASON" > "$log"
        (cd ibl5 && bash -c "$cmd") >> "$log" 2>&1; rc=$?
    fi
    if [ "$rc" -ne 0 ]; then # phpunit-red
        if [ "$PHPUNIT_MODE" = subset ]; then
            say "FAIL phpunit: subset of ${#targets[@]} test files red (exit $rc); log: $log" >&2
        else
            say "FAIL phpunit: full default suite red (exit $rc); log: $log" >&2
        fi
        tail -n 40 "$log" >&2
        return 1
    fi
    write_record phpunit "$key"
    say "phpunit passed"
    return 0
}

# --- pytest stage -----------------------------------------------------------
stage_pytest() {
    local log rc key list t cmd="${PREFIRE_PYTEST_CMD:-python3 -m pytest}"
    local -a targets
    targets=()
    if list=$(mktemp "${TMPDIR:-/tmp}/prefire-pytest.XXXXXX"); then
        prefire_pytest_select "$list"
    else
        list=""; pytest_abort "cannot create the test-list file"
    fi
    if [ "$PYTEST_MODE" = subset ]; then
        while IFS= read -r t; do targets[${#targets[@]}]="$t"; done < "$list"
        key="subset-$(git hash-object "$list" | cut -c1-12)"
    fi
    [ -n "$list" ] && rm -f "$list"
    if [ "$PYTEST_MODE" != subset ] || [ "${#targets[@]}" -eq 0 ]; then
        pytest_say_deferred
        say "pytest mode: skipped ($PYTEST_REASON)"
        return 0
    fi
    say "pytest mode: subset (${#targets[@]} test files)"
    if [ "$PYTEST_DEFERRED_N" -gt 0 ]; then
        say "pytest subset covers mapped files only; CI runs the whole harness suite (deferred files: $PYTEST_DEFERRED_N)"
        pytest_say_deferred
    fi
    cache_hit pytest "$key" && return 0
    if ! bash -c "$cmd --version" >/dev/null 2>&1; then
        say "FAIL pytest prerequisite missing: '$cmd --version' failed; install pytest for python3" >&2
        return 3
    fi
    log="$STATE_DIR/$TREE.pytest.log"
    { printf 'prefire-verify pytest mode: subset\n'; printf '  %s\n' "${targets[@]}"; } > "$log"
    (cd "$PYTEST_HOME" && PYTHONDONTWRITEBYTECODE=1 bash -c "$cmd -q -p no:xdist -p no:cacheprovider \"\$@\"" prefire-pytest "${targets[@]}") >> "$log" 2>&1; rc=$?
    if [ "$rc" -ne 0 ]; then # pytest-red
        say "FAIL pytest: subset of ${#targets[@]} test files red (exit $rc); log: $log" >&2
        tail -n 40 "$log" >&2
        return 1
    fi
    write_record pytest "$key"
    say "pytest passed"
    return 0
}

# --- exec-mutations stage ---------------------------------------------------
# The short limits fit one 600 s foreground implementer Bash call (prompt-impl Step 6.9):
# a row starts only inside the 300 s budget and can then take at most 120 s baseline + 120 s
# mutated. --fire-point uses the larger limits in DEFAULT_MAX_TIMEOUT and DEFAULT_BUDGET in
# tools/postplan-harness/harness/mutations.py. The Plan checks CI job runs the rows (ADR-0244).
XM_TIMEOUT=30
XM_MAX_TIMEOUT=120
XM_BUDGET=300
if [ "$FIRE_POINT" -eq 1 ]; then
    XM_MAX_TIMEOUT=300
    XM_BUDGET=1800
fi
XM_CHILD=""

xm_cleanup() { # stop a running lib child, then restore any journalled mutation
    if [ -n "$XM_CHILD" ]; then
        kill -TERM "$XM_CHILD" 2>/dev/null
        wait "$XM_CHILD" 2>/dev/null
        XM_CHILD=""
    fi
    "$XM_LIB" recover --root "$ROOT" >/dev/null 2>&1
}

stage_exec_mutations() {
    local xm_key recs log rc
    if [ -z "$PLAN" ]; then
        say "SKIP exec-mutations: no plan (ad-hoc path)"
        return 0
    fi
    xm_key=$(git hash-object "$PLAN")
    cache_hit exec-mutations "$xm_key" && return 0

    recs=$(mktemp "${TMPDIR:-/tmp}/prefire-xm.XXXXXX") || return 3
    "$XM_LIB" parse --root "$ROOT" "$PLAN" > "$recs" 2>&1; rc=$?
    if [ "$rc" -eq 1 ]; then
        say "FAIL exec-mutations: PARSE-FAILED: $(head -1 "$recs"); fix the plan's mutation block" >&2
        rm -f "$recs"; return 1
    elif [ "$rc" -ne 0 ]; then
        say "FAIL exec-mutations: plan-exec-mutations parse exited $rc" >&2
        rm -f "$recs"; return 3
    fi
    if [ ! -s "$recs" ]; then
        rm -f "$recs"
        say "SKIP exec-mutations: the plan has no Executable Mutations rows"
        return 0
    fi
    rm -f "$recs"
    if ! command -v gtimeout >/dev/null 2>&1 && ! command -v timeout >/dev/null 2>&1; then
        say "FAIL exec-mutations prerequisite missing: gtimeout or timeout (brew install coreutils)" >&2
        return 3
    fi

    log="$STATE_DIR/$TREE.exec-mutations.log"
    # The lib traps its own signals and reverts. This stage adds two things: it runs the
    # lib in the background so a signal interrupts `wait` at once (bash defers traps
    # while a foreground child runs), and it forwards the signal and runs recover itself.
    trap 'xm_cleanup' EXIT
    trap 'xm_cleanup; exit 130' INT
    trap 'xm_cleanup; exit 143' TERM
    trap 'xm_cleanup; exit 129' HUP
    "$XM_LIB" run --root "$ROOT" --timeout "$XM_TIMEOUT" --max-timeout "$XM_MAX_TIMEOUT" \
        --scale 2 --budget "$XM_BUDGET" "$PLAN" > "$log" 2>&1 &
    XM_CHILD=$!
    wait "$XM_CHILD"; rc=$?
    XM_CHILD=""
    trap - EXIT INT TERM HUP
    cat "$log"

    if grep -q '^NO-TIMEOUT' "$log"; then
        say "FAIL exec-mutations prerequisite missing: gtimeout or timeout" >&2
        return 3
    fi
    if [ "$rc" -eq 4 ]; then  # EXEC-LOCKED
        say "FAIL exec-mutations: another plan-exec-mutations run holds this worktree's exec lock; wait for it to finish, then re-run" >&2
        return 3
    fi
    if [ "$rc" -eq 3 ]; then
        xm_cleanup
        say "FAIL exec-mutations: a mutation could not be reverted or its backup failed; run bin/lib/plan-exec-mutations recover --root $ROOT, check git status, then re-run" >&2
        return 1
    fi
    if [ "$rc" -gt 1 ]; then
        # The lib died without running its own trap (SIGKILL, OOM), so a mutation may still be
        # applied and no NEXT-STEP line was printed for the row it was on.
        xm_cleanup
        say "FAIL exec-mutations: the mutation script stopped unexpectedly (exit $rc); any planted bug was reverted if recover could. Check git status, then re-run" >&2
        return 1
    fi
    if [ "$rc" -ne 0 ] || grep -qE '^(HELD|BASELINE-FAILED|NOT-APPLIED|UNDECIDED|REVERT-FAILED) row ' "$log"; then
        say "FAIL exec-mutations: a row did not trip (exit $rc); follow the NEXT-STEP line under each failing row. Never edit a row's check command or delete a row to get green" >&2
        return 1
    fi
    write_record exec-mutations "$xm_key"
    say "exec-mutations passed"
    return 0
}

# --- phases stage -----------------------------------------------------------
# Runs conformance's MISSING-PHASE check on the working tree. harness.conformance
# --phases diffs origin/master...HEAD plus uncommitted and untracked paths, the
# same base post-plan Phase 5.0 uses, so this stage takes no --base. Exit 1 only
# when the run printed a MISSING-PHASE: item; any other non-zero result (an
# ImportError also exits 1) means the check could not run, which is exit 3.
stage_phases() {
    local out rc cmd="${PREFIRE_PHASES_CMD:-python3 -m harness.conformance}"
    if [ -z "$PLAN" ]; then # phases ad-hoc skip
        say "SKIP phases: no plan (ad-hoc path)"
        return 0
    fi
    if [ ! -d "$PYTEST_HOME" ]; then
        say "FAIL phases prerequisite missing: $PYTEST_HOME not found" >&2
        return 3
    fi
    out=$(cd "$PYTEST_HOME" && PYTHONDONTWRITEBYTECODE=1 bash -c "$cmd --phases \"\$@\"" prefire-phases "$PLAN" "$ROOT" 2>&1); rc=$?
    if [ "$rc" -eq 0 ]; then
        [ -n "$out" ] && printf '%s\n' "$out"
        say "phases passed"
        return 0
    fi
    if [ "$rc" -eq 1 ] && grep -q '^MISSING-PHASE:' <<< "$out"; then
        printf '%s\n' "$out" >&2
        say "FAIL phases: a plan phase shows no diff; follow the HINT line above, then re-run" >&2
        return 1 # phases-red
    fi
    printf '%s\n' "$out" >&2
    say "FAIL phases could not run (conformance exit $rc); fix the environment or the plan file, then re-run" >&2
    return 3
}

# --- run --------------------------------------------------------------------
case "$STAGE" in
    all) STAGES="phases matrix phpunit pytest" ;;
    *)   STAGES="$STAGE" ;;
esac

for s in $STAGES; do
    "stage_${s//-/_}"; rc=$?
    [ "$rc" -eq 0 ] || exit "$rc"
done

NEW_TREE=$(prefire_tree_hash) || die 3 "cannot recompute the working-tree hash"
if [ "$NEW_TREE" != "$TREE" ]; then
    # Drop every record this run wrote for the old tree.
    rm -f "$STATE_DIR/$TREE".*.pass
    say "FAIL the checks changed the working tree (${TREE:0:7} -> ${NEW_TREE:0:7}); commit or gitignore the generated files, then re-run" >&2
    git status --short | head -n 20 >&2
    exit 4
fi
say "all requested stages passed ($STAGES)"
exit 0
