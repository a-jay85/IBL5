#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-automouse-postplan-disposition — regression test for the loop-side
# terminal disposition after post-plan (automouse_pr_state,
# automouse_branch_for_plan, dispose_plan_done,
# postplan_no_worktree_dispose_if_merged) and the call sites wired
# in bin/automouse/run.
#
# The defect this locks: post-plan agents reading a held-open PR as "not success"
# left the plan in queue/, causing the loop to re-claim and re-post-plan it every
# iteration forever (creating the handoff resets the attempt counter, so
# MAX_ATTEMPTS never retired it). Observed 2026-09-12 06:52 and 07:41.
#
# The load-bearing safety property (group e case e1): the environmental breaker
# keeps strict ordering precedence — a session-limit exit still refunds the attempt
# and stops the run. The disposition check runs strictly AFTER the breaker's break,
# and the static ordering assertion cannot be refactored away.
#
# Predicates are EXTRACTED from bin/automouse/run rather than copied, so the test
# can never drift from the implementation. Each reads only its positional args or
# harness-settable globals (NIGHTLY_DIR, QUEUE_DIR, HANDOFF_DIR, LOG).
#
# Run: bin/test-automouse-postplan-disposition (exit 0 = all pass, 1 = a case failed)

set -u
_USAGE_TMP="$(mktemp -d "${TMPDIR:-/tmp}/usage-iso.XXXXXX")"
[ -n "$(trap -p EXIT)" ] || trap 'rm -rf "$_USAGE_TMP"' EXIT
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/usage-test-isolation.sh"; usage_test_isolate "$_USAGE_TMP"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
RUNNER="${RUNNER:-$SCRIPT_DIR/automouse/run}"
PROMPT="$SCRIPT_DIR/automouse/prompt-postplan"
FAILED=0

for f in "$RUNNER" "$PROMPT"; do
    if [ ! -f "$f" ]; then
        echo "FAIL: cannot find $f"
        exit 1
    fi
done

# --- Extract each function from the runner --------------------------------
# Same awk idiom as the family: from the column-0 definition line to the first
# lone column-0 }.
extract_fn() {
    awk -v fn="$1" '
        $0 ~ "^" fn "\\(\\) \\{" { capture = 1 }
        capture { print }
        capture && /^\}/ { exit }
    ' "$RUNNER"
}

for fn in automouse_pr_state automouse_branch_for_plan dispose_plan_done claim_pr_terminal \
          postplan_cap_timeout should_hold_postplan_disposal notify_postplan_hold \
          postplan_newest_verdict postplan_no_worktree_dispose_if_merged claim_next_plan \
          dispose_resumed_postplan_lock; do
    FN_SRC="$(extract_fn "$fn")"
    if [ -z "$FN_SRC" ]; then
        echo "FAIL: could not extract $fn from $RUNNER"
        FAILED=1
    else
        eval "$FN_SRC"
    fi
done

if [ "$FAILED" -ne 0 ]; then
    echo "RESULT: FAILED (extraction)"
    exit 1
fi

# --- gh stub setup --------------------------------------------------------
STUB_DIR=$(mktemp -d)
STUB_CALLS="$STUB_DIR/calls"
cat > "$STUB_DIR/gh" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$STUB_CALLS"
case "${STUB_MODE:-none}" in
    open)   printf 'OPEN https://example.invalid/pr/1\n' ;;
    merged) printf 'MERGED https://example.invalid/pr/2\n' ;;
    closed) : ;;
    none)   : ;;
    error)  exit 1 ;;
esac
STUB
chmod +x "$STUB_DIR/gh"
export PATH="$STUB_DIR:$PATH"
export STUB_CALLS
trap 'rm -rf "$STUB_DIR"' EXIT

# ---------------------------------------------------------------------------
# Group p — automouse_pr_state (Phase 1)
# ---------------------------------------------------------------------------

# p1: OPEN answer — rc 0, stdout OPEN …
rm -f "$STUB_CALLS"
STUB_MODE=open; export STUB_MODE
p1_out=$(automouse_pr_state some-branch 2>/dev/null); p1_rc=$?
if [ "$p1_rc" -eq 0 ] && [ "$p1_out" = "OPEN https://example.invalid/pr/1" ]; then
    echo "ok: p1-open-rc0-correct-stdout"
else
    echo "FAIL: p1-open-rc0-correct-stdout — rc=$p1_rc out='$p1_out'"
    FAILED=1
fi

# p2: MERGED answer — rc 0, stdout starts MERGED
STUB_MODE=merged; export STUB_MODE
p2_out=$(automouse_pr_state some-branch 2>/dev/null); p2_rc=$?
if [ "$p2_rc" -eq 0 ] && printf '%s\n' "$p2_out" | grep -q '^MERGED '; then
    echo "ok: p2-merged-rc0"
else
    echo "FAIL: p2-merged-rc0 — rc=$p2_rc out='$p2_out'"
    FAILED=1
fi

# p3: CLOSED-only answer — rc 1, stdout empty
STUB_MODE=closed; export STUB_MODE
p3_out=$(automouse_pr_state some-branch 2>/dev/null); p3_rc=$?
if [ "$p3_rc" -ne 0 ] && [ -z "$p3_out" ]; then
    echo "ok: p3-closed-rc1-empty"
else
    echo "FAIL: p3-closed-rc1-empty — rc=$p3_rc out='$p3_out'"
    FAILED=1
fi

# p4: no PR (none mode) — rc 1, stdout empty; also test with STUB_MODE unset
STUB_MODE=none; export STUB_MODE
p4_out=$(automouse_pr_state some-branch 2>/dev/null); p4_rc=$?
if [ "$p4_rc" -ne 0 ] && [ -z "$p4_out" ]; then
    echo "ok: p4-none-rc1-empty"
else
    echo "FAIL: p4-none-rc1-empty — rc=$p4_rc out='$p4_out'"
    FAILED=1
fi
# Same with STUB_MODE unset — ${STUB_MODE:-none} must apply
unset STUB_MODE
p4u_out=$(automouse_pr_state some-branch 2>/dev/null); p4u_rc=$?
if [ "$p4u_rc" -ne 0 ] && [ -z "$p4u_out" ]; then
    echo "ok: p4u-unset-stub-mode-same-as-none"
else
    echo "FAIL: p4u-unset-stub-mode-same-as-none — rc=$p4u_rc out='$p4u_out'"
    FAILED=1
fi
export STUB_MODE=none

# p5: gh exits 1 — subshell with set -euo pipefail must survive
p5_result=$(set -euo pipefail
    STUB_MODE=error; export STUB_MODE
    automouse_pr_state some-branch 2>/dev/null || true
    echo "survived"
)
if printf '%s\n' "$p5_result" | grep -q 'survived'; then
    echo "ok: p5-gh-error-subshell-survives"
else
    echo "FAIL: p5-gh-error-subshell-survives — subshell aborted"
    FAILED=1
fi

# p6: static — extracted body contains --state all AND "OPEN" AND "MERGED" in --jq
p6_body=$(extract_fn automouse_pr_state)
if printf '%s\n' "$p6_body" | grep -q -- '--state all' \
   && printf '%s\n' "$p6_body" | grep -q '"OPEN"' \
   && printf '%s\n' "$p6_body" | grep -q '"MERGED"'; then
    echo "ok: p6-static-state-all-open-merged"
else
    echo "FAIL: p6-static-state-all-open-merged — missing --state all or OPEN/MERGED in jq"
    FAILED=1
fi

# p7: empty branch arg — rc 1, no gh call
rm -f "$STUB_CALLS"
STUB_MODE=open; export STUB_MODE
p7_rc=0; automouse_pr_state "" 2>/dev/null || p7_rc=$?
if [ "$p7_rc" -ne 0 ] && [ ! -s "$STUB_CALLS" ]; then
    echo "ok: p7-empty-branch-rc1-no-gh-call"
else
    echo "FAIL: p7-empty-branch-rc1-no-gh-call — rc=$p7_rc stub_calls=$(cat "$STUB_CALLS" 2>/dev/null)"
    FAILED=1
fi

# ---------------------------------------------------------------------------
# Group b — automouse_branch_for_plan (Phase 2)
# ---------------------------------------------------------------------------

HANDOFF_DIR=$(mktemp -d)
export HANDOFF_DIR

# b1: handoff has branch field — prefer it
printf '{"branch":"real-branch"}\n' > "$HANDOFF_DIR/p.md.json"
b1_out=$(automouse_branch_for_plan p.md p-slug 2>/dev/null)
if [ "$b1_out" = "real-branch" ]; then
    echo "ok: b1-prefers-handoff-branch"
else
    echo "FAIL: b1-prefers-handoff-branch — got '$b1_out'"
    FAILED=1
fi
rm -f "$HANDOFF_DIR/p.md.json"

# b2: no handoff file — falls back to slug
b2_out=$(automouse_branch_for_plan p.md p-slug 2>/dev/null)
if [ "$b2_out" = "p-slug" ]; then
    echo "ok: b2-absent-handoff-slug-fallback"
else
    echo "FAIL: b2-absent-handoff-slug-fallback — got '$b2_out'"
    FAILED=1
fi

# b3: malformed JSON — prints slug, subshell survives under set -euo pipefail
printf 'not json at all\n' > "$HANDOFF_DIR/p.md.json"
b3_result=$(set -euo pipefail
    automouse_branch_for_plan p.md p-slug 2>/dev/null
    echo "survived"
)
b3_out=$(printf '%s\n' "$b3_result" | head -1)
if [ "$b3_out" = "p-slug" ] && printf '%s\n' "$b3_result" | grep -q 'survived'; then
    echo "ok: b3-malformed-json-slug-fallback-survives"
else
    echo "FAIL: b3-malformed-json-slug-fallback-survives — out='$b3_out' result='$b3_result'"
    FAILED=1
fi
rm -f "$HANDOFF_DIR/p.md.json"

# b4: branch-less handoff — prints slug, never literal "null"
printf '{"plan":"p.md"}\n' > "$HANDOFF_DIR/p.md.json"
b4_out=$(automouse_branch_for_plan p.md p-slug 2>/dev/null)
if [ "$b4_out" = "p-slug" ]; then
    echo "ok: b4-branchless-handoff-slug-fallback"
else
    echo "FAIL: b4-branchless-handoff-slug-fallback — got '$b4_out' (literal null?)"
    FAILED=1
fi
rm -f "$HANDOFF_DIR/p.md.json"

# b5: explicit JSON null branch — prints slug
printf '{"branch":null}\n' > "$HANDOFF_DIR/p.md.json"
b5_out=$(automouse_branch_for_plan p.md p-slug 2>/dev/null)
if [ "$b5_out" = "p-slug" ]; then
    echo "ok: b5-json-null-branch-slug-fallback"
else
    echo "FAIL: b5-json-null-branch-slug-fallback — got '$b5_out'"
    FAILED=1
fi
rm -f "$HANDOFF_DIR/p.md.json"

# ---------------------------------------------------------------------------
# Group d — dispose_plan_done (Phase 3)
# ---------------------------------------------------------------------------

make_fixture() {
    local base; base=$(mktemp -d)
    mkdir -p "$base/queue" "$base/done" "$base/reports" "$base/handoff"
    # plan symlink pointing at a real temp file (matches -e semantics)
    local target; target=$(mktemp)
    ln -s "$target" "$base/queue/p.md"
    touch "$base/queue/p.md.attempts" "$base/queue/p.md.failure" "$base/queue/p.md.cap-refunds"
    printf '{"branch":"some-branch"}\n' > "$base/handoff/p.md.json"
    printf '' > "$base/run.log"
    echo "$base"
}

# d1: full side-effect check
D=$(make_fixture)
NIGHTLY_DIR="$D"; QUEUE_DIR="$D/queue"; HANDOFF_DIR="$D/handoff"; LOG="$D/run.log"
export NIGHTLY_DIR QUEUE_DIR HANDOFF_DIR LOG
dispose_plan_done p.md p OPEN https://example.invalid/pr/1 claim-time
today=$(date +%Y-%m-%d)
if [ -e "$D/done/p.md" ] \
   && [ ! -e "$D/queue/p.md" ] \
   && [ ! -f "$D/queue/p.md.attempts" ] \
   && [ ! -f "$D/queue/p.md.failure" ] \
   && [ ! -f "$D/queue/p.md.cap-refunds" ] \
   && [ ! -f "$D/handoff/p.md.json" ] \
   && [ -f "$D/reports/${today}-done-p.md" ] \
   && grep -q 'https://example.invalid/pr/1' "$D/reports/${today}-done-p.md"; then
    echo "ok: d1-all-side-effects"
else
    echo "FAIL: d1-all-side-effects"
    ls -la "$D/queue/" "$D/done/" "$D/reports/" "$D/handoff/" 2>&1 | head -20
    FAILED=1
fi
rm -rf "$D"

# d2: pre-existing report is preserved byte-for-byte
D=$(make_fixture)
NIGHTLY_DIR="$D"; QUEUE_DIR="$D/queue"; HANDOFF_DIR="$D/handoff"; LOG="$D/run.log"
export NIGHTLY_DIR QUEUE_DIR HANDOFF_DIR LOG
printf 'AGENT WROTE THIS\n' > "$D/reports/${today}-done-p.md"
dispose_plan_done p.md p OPEN https://example.invalid/pr/1 claim-time
if grep -q 'AGENT WROTE THIS' "$D/reports/${today}-done-p.md"; then
    echo "ok: d2-report-preserved"
else
    echo "FAIL: d2-report-preserved — agent report was overwritten"
    FAILED=1
fi
rm -rf "$D"

# d3: queue/p.md already absent — rc 0, report still written, no abort under set -euo pipefail
D=$(make_fixture)
rm -f "$D/queue/p.md"
NIGHTLY_DIR="$D"; QUEUE_DIR="$D/queue"; HANDOFF_DIR="$D/handoff"; LOG="$D/run.log"
export NIGHTLY_DIR QUEUE_DIR HANDOFF_DIR LOG
d3_rc=0
(set -euo pipefail
 dispose_plan_done p.md p OPEN https://example.invalid/pr/1 claim-time) || d3_rc=$?
if [ "$d3_rc" -eq 0 ] && [ -f "$D/reports/${today}-done-p.md" ]; then
    echo "ok: d3-already-absent-ok"
else
    echo "FAIL: d3-already-absent-ok — rc=$d3_rc report_exists=$([ -f "$D/reports/${today}-done-p.md" ] && echo yes || echo no)"
    FAILED=1
fi
rm -rf "$D"

# d4: idempotent — second call rc 0, tree unchanged
D=$(make_fixture)
NIGHTLY_DIR="$D"; QUEUE_DIR="$D/queue"; HANDOFF_DIR="$D/handoff"; LOG="$D/run.log"
export NIGHTLY_DIR QUEUE_DIR HANDOFF_DIR LOG
dispose_plan_done p.md p OPEN https://example.invalid/pr/1 claim-time
d4_rc=0
(set -euo pipefail
 dispose_plan_done p.md p OPEN https://example.invalid/pr/1 claim-time) || d4_rc=$?
if [ "$d4_rc" -eq 0 ]; then
    echo "ok: d4-idempotent"
else
    echo "FAIL: d4-idempotent — second call rc=$d4_rc"
    FAILED=1
fi
rm -rf "$D"

# d5: log line with correct site string (claim-time)
D=$(make_fixture)
NIGHTLY_DIR="$D"; QUEUE_DIR="$D/queue"; HANDOFF_DIR="$D/handoff"; LOG="$D/run.log"
export NIGHTLY_DIR QUEUE_DIR HANDOFF_DIR LOG
dispose_plan_done p.md p OPEN https://example.invalid/pr/1 claim-time
log_lines=$(grep 'Loop-side disposition (claim-time)' "$D/run.log" | grep 'https://example.invalid/pr/1' | wc -l)
if [ "$log_lines" -eq 1 ]; then
    echo "ok: d5-log-claim-time"
else
    echo "FAIL: d5-log-claim-time — matching lines=$log_lines"
    cat "$D/run.log"
    FAILED=1
fi
rm -rf "$D"

# d6: site string post-postplan propagates to log and report
D=$(make_fixture)
NIGHTLY_DIR="$D"; QUEUE_DIR="$D/queue"; HANDOFF_DIR="$D/handoff"; LOG="$D/run.log"
export NIGHTLY_DIR QUEUE_DIR HANDOFF_DIR LOG
dispose_plan_done p.md p OPEN https://example.invalid/pr/2 post-postplan
if grep -q 'post-postplan' "$D/run.log" && grep -q 'post-postplan' "$D/reports/${today}-done-p.md"; then
    echo "ok: d6-site-post-postplan"
else
    echo "FAIL: d6-site-post-postplan"
    cat "$D/run.log" "$D/reports/${today}-done-p.md" 2>&1 | head -10
    FAILED=1
fi
rm -rf "$D"

# d7: the moved done/ entry carries a DISPOSITION-time mtime, not the queue symlink's own.
# Asserted with the SAME predicate the digest uses (find -newermt, which lstat()s a symlink
# because -L is absent) so the test cannot pass while the digest still misses the entry.
D=$(make_fixture)
touch -h -t 200001010000 "$D/queue/p.md"
# vacuity guard: prove the fixture really starts OUTSIDE the window, else the assert is empty
if [ -n "$(find "$D/queue" -maxdepth 1 -name p.md -newermt '2020-01-01 00:00:00' 2>/dev/null)" ]; then
    echo "FAIL: d7-vacuity — fixture symlink was not pinned to the past; d7 would prove nothing"
    FAILED=1
fi
NIGHTLY_DIR="$D"; QUEUE_DIR="$D/queue"; HANDOFF_DIR="$D/handoff"; LOG="$D/run.log"
export NIGHTLY_DIR QUEUE_DIR HANDOFF_DIR LOG
dispose_plan_done p.md p OPEN https://example.invalid/pr/1 claim-time
d7_since="$(date -v-1H '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date -d '1 hour ago' '+%Y-%m-%d %H:%M:%S')"
if [ -n "$(find "$D/done" -maxdepth 1 -name p.md -newermt "$d7_since" 2>/dev/null)" ]; then
    echo "ok: d7-disposition-mtime"
else
    echo "FAIL: d7-disposition-mtime — done/p.md kept queue-time mtime; the digest will not see it"
    ls -la "$D/done/"
    FAILED=1
fi
rm -rf "$D"

# ---------------------------------------------------------------------------
# Group c — claim-time call site (Phase 4), static assertions over $RUNNER
# ---------------------------------------------------------------------------

# c1: ordering — Terminal-disposition guard comment < automouse_pr_state "$CLAIM_BRANCH" < attempt counter increment
# Anchor on the unique comment immediately after the depends_on esac (at ~1437), not the first
# bare esac in the file (~line 615), so the ordering assertion targets the correct insertion point.
c1_result=$(awk '
    /# Terminal-disposition guard:/ { e=NR }
    /automouse_pr_state "\$CLAIM_BRANCH"/ { g=NR }
    /# Increment attempt counter$/ { i=NR }
    END { if (e>0 && g>0 && i>0 && e<g && g<i) print "OK"; else print "ORDER-FAIL e="e" g="g" i="i }
' "$RUNNER")
if [ "$c1_result" = "OK" ]; then
    echo "ok: c1-claim-ordering"
else
    echo "FAIL: c1-claim-ordering — $c1_result"
    FAILED=1
fi

# c2: the guard asks claim_pr_terminal, with the PR state it resolved
if grep -qF 'claim_pr_terminal "$PLAN_NAME" "${CLAIM_PR%% *}"' "$RUNNER"; then
    echo "ok: c2-handoff-outer-gate"
else
    echo "FAIL: c2-handoff-outer-gate — guard does not call claim_pr_terminal"
    FAILED=1
fi

# c2b-c2e: claim_pr_terminal. Without a handoff, OPEN and MERGED both end the plan.
# With one, only MERGED does: a resumed post-plan that merged leaves its handoff.
C2D=$(mktemp -d); HANDOFF_DIR="$C2D"
c2_case() {  # <label> <want rc> <plan> <state>
    local rc=0
    claim_pr_terminal "$3" "$4" || rc=$?
    if [ "$rc" -eq "$2" ]; then
        echo "ok: $1"
    else
        echo "FAIL: $1 — rc=$rc, want $2"
        FAILED=1
    fi
}
c2_case c2b-no-handoff-open-terminal 0 p.md OPEN
c2_case c2c-no-handoff-merged-terminal 0 p.md MERGED
printf '{"branch":"b"}\n' > "$C2D/p.md.json"
c2_case c2d-handoff-open-resumes 1 p.md OPEN
c2_case c2e-handoff-merged-terminal 0 p.md MERGED
rm -rf "$C2D"

# c3: guard contains lock release and continue
if grep -qF 'rm -rf "$CURRENT_LOCK" 2>/dev/null || true' "$RUNNER" \
   && grep -qF 'CURRENT_LOCK=""' "$RUNNER" \
   && grep -qF 'continue' "$RUNNER"; then
    echo "ok: c3-lock-release-and-continue"
else
    echo "FAIL: c3-lock-release-and-continue — missing rm CURRENT_LOCK or continue"
    FAILED=1
fi

# c4: guard block contains no break (break stops the whole run, not just this entry)
# Extract the lines from the Terminal-disposition guard comment to the attempt counter increment.
# Using the comment as anchor avoids matching earlier esac lines from helper functions.
c4_region=$(awk '
    /# Terminal-disposition guard:/ { in_region=1; next }
    in_region && /^    echo \$\(\( ATTEMPTS \+ 1 \)\)/ { exit }
    in_region { print }
' "$RUNNER")
if printf '%s\n' "$c4_region" | grep -qw 'break'; then
    echo "FAIL: c4-no-break-in-claim-guard — found break in guard region"
    FAILED=1
else
    echo "ok: c4-no-break-in-claim-guard"
fi

# ---------------------------------------------------------------------------
# Group e — post-postplan call site (Phase 5), static assertions over $RUNNER
# ---------------------------------------------------------------------------

# e1: ordering — write_env_stop_report … postplan < automouse_pr_state "$PP_BRANCH" < if [ ! -e "$NEXT_PLAN" ]
e1_result=$(awk '
    /write_env_stop_report "\$PLAN_NAME" postplan/ { b=NR }
    /automouse_pr_state "\$PP_BRANCH"/ { d=NR }
    /if \[ ! -e "\$NEXT_PLAN" \]/ { c=NR }
    END { if (b>0 && d>0 && c>0 && b<d && d<c) print "OK"; else print "ORDER-FAIL b="b" d="d" c="c }
' "$RUNNER")
if [ "$e1_result" = "OK" ]; then
    echo "ok: e1-postpostplan-ordering-hard-constraint"
else
    echo "FAIL: e1-postpostplan-ordering-hard-constraint — $e1_result"
    FAILED=1
fi

# e2: region between the post-postplan disposition comment and its closing fi contains
# neither continue nor break. Anchored on the unique comment string (same pattern as c4),
# not on indent-level fi, to avoid matching earlier fi lines in the file.
e2_region=$(awk '
    /# Terminal-disposition: the environmental breaker/ { in_region=1; next }
    in_region && /^        fi$/ { exit }
    in_region { print }
' "$RUNNER")
if printf '%s\n' "$e2_region" | grep -qE '^\s*(continue|break)\s*$'; then
    echo "FAIL: e2-no-continue-break-in-postpostplan — found continue or break"
    FAILED=1
else
    echo "ok: e2-no-continue-break-in-postpostplan"
fi

# e3: disposition is guarded by [ -e "$NEXT_PLAN" ]
if grep -qF '[ -e "$NEXT_PLAN" ]' "$RUNNER"; then
    echo "ok: e3-next-plan-guard"
else
    echo "FAIL: e3-next-plan-guard — missing [ -e \"$NEXT_PLAN\" ] gate"
    FAILED=1
fi

# e4: env-breaker is unchanged — phase_env_error and refund_attempt still present inside breaker arm
e4_breaker_err=$(grep -c 'phase_env_error "$PP_LOG_BEFORE"' "$RUNNER" || true)
e4_refund=$(grep -c 'refund_attempt' "$RUNNER" || true)
if [ "$e4_breaker_err" -ge 1 ] && [ "$e4_refund" -ge 1 ]; then
    echo "ok: e4-breaker-unchanged"
else
    echo "FAIL: e4-breaker-unchanged — phase_env_error=$e4_breaker_err refund_attempt=$e4_refund"
    FAILED=1
fi

# e5: call-site ordering — classify < predicate < hold-or-dispose
e5_result=$(awk '
    /postplan_cap_timeout "\$PP_STATUS"/ { cap=NR }
    /should_hold_postplan_disposal "\$PP_CAP"/ { pred=NR }
    /notify_postplan_hold "\$PLAN_NAME"/ { hold=NR }
    /dispose_plan_done "\$PLAN_NAME" "\$PLAN_SLUG"/ { disp=NR }
    END { if (cap>0 && pred>0 && hold>0 && disp>0 && cap<pred && pred<hold && hold<disp) print "OK"
          else print "ORDER-FAIL cap="cap" pred="pred" hold="hold" disp="disp }
' "$RUNNER")
if [ "$e5_result" = "OK" ]; then
    echo "ok: e5-call-site-ordering"
else
    echo "FAIL: e5-call-site-ordering — $e5_result"
    FAILED=1
fi

# e6: call site uses REMAINING_SECS as the budget argument
if grep -cF 'postplan_cap_timeout "$PP_STATUS" "$PP_DUR" "$REMAINING_SECS"' "$RUNNER" | grep -qx 1; then
    echo "ok: e6-call-site-uses-remaining-secs"
else
    echo "FAIL: e6-call-site-uses-remaining-secs — count=$(grep -cF 'postplan_cap_timeout "$PP_STATUS" "$PP_DUR" "$REMAINING_SECS"' "$RUNNER")"
    FAILED=1
fi

# e7: call site does NOT use MAX_PP_SECS as the budget argument
if grep -cF 'postplan_cap_timeout "$PP_STATUS" "$PP_DUR" "$MAX_PP_SECS"' "$RUNNER" | grep -qx 0; then
    echo "ok: e7-call-site-not-max-pp-secs"
else
    echo "FAIL: e7-call-site-not-max-pp-secs — static cap re-used as budget"
    FAILED=1
fi

# e8: discord-dm invoked via SELF_DIR, never hard-coded (postplan-hold DM + login preflight + stop DM)
e8_self=$(grep -cF '"$SELF_DIR/../discord-dm"' "$RUNNER" || true)
e8_hard=$(grep -cF 'bin/discord-dm' "$RUNNER" || true)
if [ "$e8_self" -eq 3 ] && [ "$e8_hard" -eq 0 ]; then
    echo "ok: e8-discord-dm-path-relative"
else
    echo "FAIL: e8-discord-dm-path-relative — self_dir_count=$e8_self hard_count=$e8_hard"
    FAILED=1
fi

# e8b: exactly one of those call sites lives in the anchored stop-DM sender
e8b_count=$(awk '/^# Stop-DM sender:/,/^# End stop-DM sender\./' "$RUNNER" | grep -cF '"$SELF_DIR/../discord-dm"' || true)
if [ "$e8b_count" -eq 1 ]; then
    echo "ok: e8b-stop-dm-site-in-sender"
else
    echo "FAIL: e8b-stop-dm-site-in-sender — count=$e8b_count"
    FAILED=1
fi

# e9: dispose_plan_done call count unchanged (claim-time call site not disturbed)
e9_count=$(grep -cF 'dispose_plan_done "$PLAN_NAME" "$PLAN_SLUG"' "$RUNNER" || true)
if [ "$e9_count" -eq 2 ]; then
    echo "ok: e9-dispose-plan-done-count-unchanged"
else
    echo "FAIL: e9-dispose-plan-done-count-unchanged — count=$e9_count (expected 2)"
    FAILED=1
fi

# e10: impl_cap_timeout does not accept 137 (the new postplan function is not a refactor of it)
e10_137=$(grep -c '\[ "$status" -eq 137 \]' "$RUNNER" || true)
e10_impl_body=$(extract_fn impl_cap_timeout)
if [ "$e10_137" -eq 1 ] && ! printf '%s\n' "$e10_impl_body" | grep -q '137'; then
    echo "ok: e10-impl-cap-timeout-no-137"
else
    echo "FAIL: e10-impl-cap-timeout-no-137 — 137-count=$e10_137 impl-body-has-137=$(printf '%s\n' "$e10_impl_body" | grep -c '137')"
    FAILED=1
fi

# e11: the call site reads the verdict through postplan_newest_verdict (group v tests it)
if grep -cF 'PP_VERDICT_NEWEST=$(postplan_newest_verdict "$PP_PR_NUM")' "$RUNNER" | grep -qx 1; then
    echo "ok: e11-verdict-probe-uses-helper"
else
    echo "FAIL: e11-verdict-probe-uses-helper — call site does not use postplan_newest_verdict"
    FAILED=1
fi

# ---------------------------------------------------------------------------
# Group v — postplan_newest_verdict (dynamic, under the runner's set -euo pipefail)
# ---------------------------------------------------------------------------
# The defect: `ls` exits non-zero when one pattern matches nothing, and inside
# `VAR=$(…)` under set -euo pipefail that killed the runner right after post-plan
# (2026-09-18 00:34 and 01:30). Each case runs in a strict subshell and must reach
# its final echo.

V=$(mktemp -d)
v_probe() {
    ( set -euo pipefail; out=$(postplan_newest_verdict "$1" "$V"); echo "rc0:$out" )
}

# v1: base file only, no -2 — the crash case
touch "$V/post-plan-fidelity-verdict-11.md"
v1=$(v_probe 11)
if [ "$v1" = "rc0:$V/post-plan-fidelity-verdict-11.md" ]; then
    echo "ok: v1-base-only-survives-set-e"
else
    echo "FAIL: v1-base-only-survives-set-e — got '$v1'"
    FAILED=1
fi

# v2: no verdict at all — empty, rc 0
v2=$(v_probe 22)
if [ "$v2" = "rc0:" ]; then
    echo "ok: v2-none-empty"
else
    echo "FAIL: v2-none-empty — got '$v2'"
    FAILED=1
fi

# v3: stale base + newer -2 — newest (-2) wins
touch -t 202001010000 "$V/post-plan-fidelity-verdict-33.md"
touch "$V/post-plan-fidelity-verdict-33-2.md"
v3=$(v_probe 33)
if [ "$v3" = "rc0:$V/post-plan-fidelity-verdict-33-2.md" ]; then
    echo "ok: v3-re-review-newest-wins"
else
    echo "FAIL: v3-re-review-newest-wins — got '$v3'"
    FAILED=1
fi

# v4: -2 only (no base) — also a one-pattern-misses case
touch "$V/post-plan-fidelity-verdict-44-2.md"
v4=$(v_probe 44)
if [ "$v4" = "rc0:$V/post-plan-fidelity-verdict-44-2.md" ]; then
    echo "ok: v4-re-review-only-survives-set-e"
else
    echo "FAIL: v4-re-review-only-survives-set-e — got '$v4'"
    FAILED=1
fi
rm -rf "$V"

# e2 augmented assertions: the anchor region must contain both dispose_plan_done and
# should_hold_postplan_disposal (e2a: non-empty region; e2b: dispose present; e2c: hold present)
e2a_region=$(awk '
    /# Terminal-disposition: the environmental breaker/ { in_region=1; next }
    in_region && /^        fi$/ { exit }
    in_region { print }
' "$RUNNER")
if [ -n "$e2a_region" ]; then
    echo "ok: e2a-anchor-region-non-empty"
else
    echo "FAIL: e2a-anchor-region-non-empty — comment anchor not found or region empty"
    FAILED=1
fi
if printf '%s\n' "$e2a_region" | grep -qF 'dispose_plan_done'; then
    echo "ok: e2b-region-contains-dispose"
else
    echo "FAIL: e2b-region-contains-dispose — dispose_plan_done not in anchor region"
    FAILED=1
fi
if printf '%s\n' "$e2a_region" | grep -qF 'should_hold_postplan_disposal'; then
    echo "ok: e2c-region-contains-hold-predicate"
else
    echo "FAIL: e2c-region-contains-hold-predicate — should_hold_postplan_disposal not in anchor region"
    FAILED=1
fi

# ---------------------------------------------------------------------------
# Group t — budget invariant (static, reads constants from runner)
# ---------------------------------------------------------------------------

t_impl=$(awk -F'[= ]' '/^MAX_IMPL_SECS=/{print $2; exit}' "$RUNNER")
t_pp=$(awk -F'[= ]'   '/^MAX_PP_SECS=/{print $2; exit}'   "$RUNNER")
t_lock=$(awk -F'[= ]' '/^LOCK_TTL_SECS=/{print $2; exit}' "$RUNNER")

# t3: all three parsed non-empty and numeric
if [ -n "$t_impl" ] && [ -n "$t_pp" ] && [ -n "$t_lock" ] \
   && printf '%s\n' "$t_impl" | grep -qE '^[0-9]+$' \
   && printf '%s\n' "$t_pp"   | grep -qE '^[0-9]+$' \
   && printf '%s\n' "$t_lock" | grep -qE '^[0-9]+$'; then
    echo "ok: t3-constants-parsed"
else
    echo "FAIL: t3-constants-parsed — impl='$t_impl' pp='$t_pp' lock='$t_lock'"
    FAILED=1
fi

# t1: lock TTL covers both phase caps plus 30m overhead
if [ "$t_lock" -ge $(( t_impl + t_pp + 1800 )) ]; then
    echo "ok: t1-lock-ttl-covers-both-caps"
else
    echo "FAIL: t1-lock-ttl-covers-both-caps — lock=$t_lock impl=$t_impl pp=$t_pp needed=$(( t_impl + t_pp + 1800 ))"
    FAILED=1
fi

# t2: post-plan cap raised to 5400
if [ "$t_pp" -eq 5400 ]; then
    echo "ok: t2-pp-cap-is-5400"
else
    echo "FAIL: t2-pp-cap-is-5400 — got $t_pp"
    FAILED=1
fi

# ---------------------------------------------------------------------------
# Group k — postplan_cap_timeout and should_hold_postplan_disposal (dynamic)
# ---------------------------------------------------------------------------

CAP_TIMEOUT_TOLERANCE_SECS=$(awk -F'[= ]' '/^CAP_TIMEOUT_TOLERANCE_SECS=/{print $2; exit}' "$RUNNER")

# k1–k3: true for 137, 124, 143 at the wall
if postplan_cap_timeout 137 5400 5400; then echo "ok: k1-status-137-true"
else echo "FAIL: k1-status-137-true"; FAILED=1; fi

if postplan_cap_timeout 124 5400 5400; then echo "ok: k2-status-124-true"
else echo "FAIL: k2-status-124-true"; FAILED=1; fi

if postplan_cap_timeout 143 5400 5400; then echo "ok: k3-status-143-true"
else echo "FAIL: k3-status-143-true"; FAILED=1; fi

# k4: exactly at the tolerance boundary
if postplan_cap_timeout 137 $(( 5400 - CAP_TIMEOUT_TOLERANCE_SECS )) 5400; then
    echo "ok: k4-tolerance-boundary-true"
else
    echo "FAIL: k4-tolerance-boundary-true — tolerance=$CAP_TIMEOUT_TOLERANCE_SECS"
    FAILED=1
fi

# k5: one second inside tolerance — false
if ! postplan_cap_timeout 137 $(( 5400 - CAP_TIMEOUT_TOLERANCE_SECS - 1 )) 5400; then
    echo "ok: k5-one-sec-inside-false"
else
    echo "FAIL: k5-one-sec-inside-false"
    FAILED=1
fi

# k6: ordinary failure at the wall — false
if ! postplan_cap_timeout 1 5400 5400; then echo "ok: k6-status-1-false"
else echo "FAIL: k6-status-1-false"; FAILED=1; fi

# k7: clean exit — false
if ! postplan_cap_timeout 0 5400 5400; then echo "ok: k7-status-0-false"
else echo "FAIL: k7-status-0-false"; FAILED=1; fi

# k8: real PR #2239 numbers — true
if postplan_cap_timeout 137 3159 3146; then echo "ok: k8-pr2239-remaining-secs-true"
else echo "FAIL: k8-pr2239-remaining-secs-true"; FAILED=1; fi

# k9: same run against MAX_PP_SECS — false (proves why REMAINING_SECS is required)
if ! postplan_cap_timeout 137 3159 3600; then echo "ok: k9-pr2239-max-pp-secs-false"
else echo "FAIL: k9-pr2239-max-pp-secs-false"; FAILED=1; fi

# k10: hold direction — cap + OPEN + no verdict
if should_hold_postplan_disposal 1 OPEN 0; then echo "ok: k10-hold-direction-true"
else echo "FAIL: k10-hold-direction-true"; FAILED=1; fi

# k11: review ran — dispose as today
if ! should_hold_postplan_disposal 1 OPEN 1; then echo "ok: k11-review-ran-false"
else echo "FAIL: k11-review-ran-false"; FAILED=1; fi

# k12: MERGED — shipped, never hold
if ! should_hold_postplan_disposal 1 MERGED 0; then echo "ok: k12-merged-false"
else echo "FAIL: k12-merged-false"; FAILED=1; fi

# k13: no cap-timeout
if ! should_hold_postplan_disposal 0 OPEN 0; then echo "ok: k13-no-cap-timeout-false"
else echo "FAIL: k13-no-cap-timeout-false"; FAILED=1; fi

# k14: CLOSED — only OPEN qualifies
if ! should_hold_postplan_disposal 1 CLOSED 0; then echo "ok: k14-closed-false"
else echo "FAIL: k14-closed-false"; FAILED=1; fi

# ---------------------------------------------------------------------------
# Group h — notify_postplan_hold with stubbed discord-dm
# ---------------------------------------------------------------------------

H=$(mktemp -d)
mkdir -p "$H/bin/automouse" "$H/nightly/reports" "$H/nightly/queue"
: > "$H/nightly/queue/my-slug.md"
DM_CALLS="$H/dm-calls.txt"
H_LOG="$H/run.log"
cat > "$H/bin/discord-dm" << 'STUB'
#!/usr/bin/env bash
{ printf 'ARGV: %s\n' "$*"; printf 'STDIN: '; cat; printf '\n'; } >> "$DM_CALLS"
exit "${DM_STUB_RC:-0}"
STUB
chmod +x "$H/bin/discord-dm"
export DM_CALLS
trap 'rm -rf "$H"' EXIT

# Call with SELF_DIR pointing at the stub dir
SELF_DIR="$H/bin/automouse"
NIGHTLY_DIR="$H/nightly"
LOG="$H_LOG"

notify_postplan_hold "p.md" "my-slug" "https://github.com/a-jay85/IBL5/pull/2999" \
    "3159" "3146" "137"

# h1: DM was called
if [ -s "$DM_CALLS" ]; then echo "ok: h1-dm-was-called"
else echo "FAIL: h1-dm-was-called"; FAILED=1; fi

# h2: DM body contains the PR URL
if grep -qF 'https://github.com/a-jay85/IBL5/pull/2999' "$DM_CALLS"; then
    echo "ok: h2-dm-contains-pr-url"
else
    echo "FAIL: h2-dm-contains-pr-url"
    FAILED=1
fi

# h3: DM body contains the slug
if grep -qF 'my-slug' "$DM_CALLS"; then echo "ok: h3-dm-contains-slug"
else echo "FAIL: h3-dm-contains-slug"; FAILED=1; fi

# h4: --attempts 3 is present (loop-blocking bound)
if grep -q 'ARGV:.*--attempts 3' "$DM_CALLS"; then echo "ok: h4-attempts-3"
else echo "FAIL: h4-attempts-3 — $(cat "$DM_CALLS")"; FAILED=1; fi

# h5: report file exists and names the PR URL
h5_report="$NIGHTLY_DIR/reports/$(date +%Y-%m-%d)-postplan-hold-my-slug.md"
if [ -f "$h5_report" ] && grep -qF 'https://github.com/a-jay85/IBL5/pull/2999' "$h5_report"; then
    echo "ok: h5-report-exists-with-url"
else
    echo "FAIL: h5-report-exists-with-url — file=$([ -f "$h5_report" ] && echo present || echo absent)"
    FAILED=1
fi

# h6: log line has full wording
if grep -qF 'Postplan cap-timeout HOLD: PR OPEN' "$H_LOG"; then echo "ok: h6-log-wording"
else echo "FAIL: h6-log-wording — $(cat "$H_LOG" 2>/dev/null)"; FAILED=1; fi

# h7: undeliverable DM still returns 0 and logs spool line
rm -f "$DM_CALLS"
DM_STUB_RC=1 notify_postplan_hold "p.md" "my-slug" "https://github.com/a-jay85/IBL5/pull/2999" \
    "3159" "3146" "137"; h7_rc=$?
if [ "$h7_rc" -eq 0 ] && grep -qF 'Postplan hold DM undeliverable (spooled)' "$H_LOG"; then
    echo "ok: h7-undeliverable-dm-returns-0"
else
    echo "FAIL: h7-undeliverable-dm-returns-0 — rc=$h7_rc log=$(tail -3 "$H_LOG")"
    FAILED=1
fi

# h8: queue file untouched — notify_postplan_hold never moves a symlink
if [ -f "$H/nightly/queue/my-slug.md" ]; then echo "ok: h8-queue-untouched"
else echo "FAIL: h8-queue-untouched"; FAILED=1; fi

# ---------------------------------------------------------------------------
# Group s — bin/automouse/prompt-postplan prose (Phase 6), static
# ---------------------------------------------------------------------------

# s1: HELD appears at least twice
s1_count=$(grep -c 'HELD' "$PROMPT" || true)
if [ "$s1_count" -ge 2 ]; then
    echo "ok: s1-held-named-twice"
else
    echo "FAIL: s1-held-named-twice — count=$s1_count"
    FAILED=1
fi

# s2: skipped/ route for genuine failures still present
if grep -qF 'NIGHTLY_DIR/skipped/' "$PROMPT"; then
    echo "ok: s2-skipped-route-intact"
else
    echo "FAIL: s2-skipped-route-intact — skipped/ route was removed"
    FAILED=1
fi

# s3: code fences are balanced
s3_odd=$(awk '/^```/{n++} END{print n%2}' "$PROMPT")
if [ "$s3_odd" -eq 0 ]; then
    echo "ok: s3-fences-balanced"
else
    echo "FAIL: s3-fences-balanced — odd number of fences"
    FAILED=1
fi

# s4: Step 1 validates the handoff's required keys (same jq -e filter as prompt-impl)
# Both grep -qF fragments are exact text on purpose: the filter must stay identical to
# prompt-impl's, so reformatting those prompt lines should be a deliberate, reviewed change.
# When you reformat them in prompt-postplan, update these two fragments to match.
if grep -qF "jq -e '[.slug, .worktree, .branch, .plan_file]" "$PROMPT" \
   && grep -qF '| all(type == "string" and length > 0)'"'"' "$HF" > /dev/null' "$PROMPT"; then
    echo "ok: s4-handoff-key-filter-present"
else
    echo "FAIL: s4-handoff-key-filter-present — jq required-key filter missing from prompt-postplan"
    FAILED=1
fi

# ---------------------------------------------------------------------------
# Group f — postplan_no_worktree_dispose_if_merged (stubbed collaborators)
# ---------------------------------------------------------------------------
# Each case runs in a subshell under the runner's strict mode (set -euo pipefail)
# so the stubs never leak into other groups and a non-zero return cannot abort
# the harness. Side effects are observed through files in the per-case temp dir.

run_f_case() {  # $1 = automouse_pr_state stub mode: merged | open | error
    local D; D=$(mktemp -d)
    (
        set -euo pipefail
        NIGHTLY_DIR="$D"; QUEUE_DIR="$D/queue"; HANDOFF_DIR="$D/handoff"; LOG="$D/run.log"
        mkdir -p "$QUEUE_DIR" "$HANDOFF_DIR"; : > "$LOG"
        automouse_branch_for_plan() { printf '%s\n' "$*" > "$D/branch-args"; printf 'some-branch\n'; }
        case "$1" in
            merged) automouse_pr_state() { printf '%s\n' "$1" > "$D/pr-branch"; printf 'MERGED https://github.com/a-jay85/IBL5/pull/9\n'; } ;;
            open)   automouse_pr_state() { printf '%s\n' "$1" > "$D/pr-branch"; printf 'OPEN https://github.com/a-jay85/IBL5/pull/9\n'; } ;;
            error)  automouse_pr_state() { printf '%s\n' "$1" > "$D/pr-branch"; return 1; } ;;
        esac
        dispose_plan_done() { printf '%s\n' "$*" > "$D/dispose-called"; }
        rc=0
        postplan_no_worktree_dispose_if_merged p.md p test-site || rc=$?
        printf '%s\n' "$rc" > "$D/rc"
    )
    echo "$D"
}

# f1: MERGED PR — rc 0, dispose called with (p.md p MERGED <url> …), branch plumbed through
D=$(run_f_case merged)
if [ "$(cat "$D/rc" 2>/dev/null)" = "0" ] \
   && [ -f "$D/dispose-called" ] \
   && grep -q '^p\.md p MERGED https://github\.com/a-jay85/IBL5/pull/9' "$D/dispose-called" \
   && [ "$(cat "$D/branch-args" 2>/dev/null)" = "p.md p" ] \
   && [ "$(cat "$D/pr-branch" 2>/dev/null)" = "some-branch" ]; then
    echo "ok: f1-merged-disposes"
else
    echo "FAIL: f1-merged-disposes — rc=$(cat "$D/rc" 2>/dev/null || echo missing) dispose=$(cat "$D/dispose-called" 2>/dev/null || echo not-called) branch-args=$(cat "$D/branch-args" 2>/dev/null) pr-branch=$(cat "$D/pr-branch" 2>/dev/null)"
    FAILED=1
fi

# f2: OPEN PR — rc 1, dispose NOT called (an open PR is not shipped work)
D=$(run_f_case open)
if [ "$(cat "$D/rc" 2>/dev/null)" = "1" ] && [ ! -e "$D/dispose-called" ]; then
    echo "ok: f2-open-no-dispose"
else
    echo "FAIL: f2-open-no-dispose — rc=$(cat "$D/rc" 2>/dev/null || echo missing) dispose=$(cat "$D/dispose-called" 2>/dev/null || echo not-called)"
    FAILED=1
fi

# f3: gh error / no PR (automouse_pr_state rc 1) — rc 1, dispose NOT called, no strict-mode abort
D=$(run_f_case error)
if [ "$(cat "$D/rc" 2>/dev/null)" = "1" ] && [ ! -e "$D/dispose-called" ]; then
    echo "ok: f3-gh-error-no-dispose"
else
    echo "FAIL: f3-gh-error-no-dispose — rc=$(cat "$D/rc" 2>/dev/null || echo missing; ) dispose=$(cat "$D/dispose-called" 2>/dev/null || echo not-called)"
    FAILED=1
fi

# ---------------------------------------------------------------------------
# Group h — claim_next_plan lock handling (stat stubbed; real usage-gate lib)
# ---------------------------------------------------------------------------
# claim_next_plan reads the lock mtime with BSD `stat -f %m`, which GNU stat on
# ubuntu-latest rejects, and the paused-held block in bin/test-automouse-concurrency
# self-skips off macOS. A `stat` shell-function stub lets the real claim_next_plan
# run here against the real usage-gate lib. Knobs (all optional env):
#   H_OWNER=live|dead  H_LOCK_AGE=<secs>  H_SID=<uuid>  H_MARKER=1|0
#   H_CLEARED_AGE=<secs>  H_NO_CLEARED_DIR=1  H_HANDOFF_BRANCH=<b>  H_LOCK_BRANCH=<b>
#   H_PR=open|merged|error  H_LAUNCHCTL=none|inflight|empty|fail|path-unset|path-empty
#   H_CALL=claim|helper|helper-twice  H_GRACE=<secs> (set, even empty, exports
#   RESUMED_POSTPLAN_GRACE_SECS)
H_SID_VAL="cccccccc-3333-4333-8333-cccccccccccc"

run_h_case() {
    local D; D=$(mktemp -d)
    (
        set -euo pipefail
        NIGHTLY_DIR="$D"; QUEUE_DIR="$D/queue"; HANDOFF_DIR="$D/handoff"; LOG="$D/run.log"
        LOCK_TTL_SECS=10800; CAP_DEFERRED=" "
        export IBL5_USAGE_GATE_STATE_DIR="$D/gate"
        mkdir -p "$QUEUE_DIR" "$HANDOFF_DIR" "$D/plans" "$D/gate/markers" "$D/gate/cleared"; : > "$LOG"
        : > "$D/plans/p.md"; ln -s "$D/plans/p.md" "$QUEUE_DIR/p.md"
        touch -h -t 202001010000 "$QUEUE_DIR/p.md"   # old link mtime; proves dispose's touch -h
        lock="$QUEUE_DIR/p.md.lock"
        mkdir "$lock"
        case "${H_OWNER:-dead}" in
            live) echo "$$" > "$lock/pid" ;;
            dead) ( : ) & dead=$!; wait "$dead"; echo "$dead" > "$lock/pid"; echo "$dead" > "$D/deadpid" ;;
        esac
        [ -z "${H_SID:-}" ] || printf '%s\n' "$H_SID" > "$lock/paused-held"
        if [ "${H_MARKER:-0}" = 1 ]; then printf '{"session_id":"%s"}\n' "$H_SID" > "$D/gate/markers/$H_SID.json"; fi
        if [ -n "${H_CLEARED_AGE:-}" ]; then
            printf '%s\n' "$(( $(date +%s) - H_CLEARED_AGE ))" > "$D/gate/cleared/$H_SID"
        fi
        [ -z "${H_NO_CLEARED_DIR:-}" ] || rmdir "$D/gate/cleared"
        [ -z "${H_HANDOFF_BRANCH:-}" ] || printf '{"branch":"%s"}\n' "$H_HANDOFF_BRANCH" > "$HANDOFF_DIR/p.md.json"
        [ -z "${H_LOCK_BRANCH:-}" ] || printf '%s\n' "$H_LOCK_BRANCH" > "$lock/branch"
        case "${H_PR:-open}" in
            open)   automouse_pr_state() { printf '%s\n' "$1" > "$D/pr-branch"; printf 'OPEN https://github.com/a-jay85/IBL5/pull/9\n'; } ;;
            merged) automouse_pr_state() { printf '%s\n' "$1" > "$D/pr-branch"; printf 'MERGED https://github.com/a-jay85/IBL5/pull/9\n'; } ;;
            error)  automouse_pr_state() { printf '%s\n' "$1" > "$D/pr-branch"; return 1; } ;;
        esac
        touch -t 202101010000 "$D/ref"
        {
            printf '#!/usr/bin/env bash\n'
            case "${H_LAUNCHCTL:-none}" in
                none|path-unset|path-empty)
                          printf '%s\n' "printf 'PID\tStatus\tLabel\n-\t0\tcom.apple.unrelated\n'" ;;
                inflight) printf '%s\n' "printf 'PID\tStatus\tLabel\n4242\t0\tcom.ibl5.postplan-now-p-20261010-012345-4242\n'" ;;
                empty)    printf ':\n' ;;
                # A non-empty listing plus a non-zero exit: only the `|| return 1` catches it.
                fail)     printf '%s\n' "printf 'PID\tStatus\tLabel\n-\t0\tcom.apple.unrelated\n'; exit 1" ;;
            esac
        } > "$D/launchctl"
        chmod +x "$D/launchctl"
        case "${H_LAUNCHCTL:-none}" in
            path-unset|path-empty)
                mkdir -p "$D/bin"; mv "$D/launchctl" "$D/bin/launchctl"
                PATH="$D/bin:$PATH"
                if [ "$H_LAUNCHCTL" = path-unset ]; then unset LAUNCHCTL_CMD; else LAUNCHCTL_CMD=""; export LAUNCHCTL_CMD; fi ;;
            *) export LAUNCHCTL_CMD="$D/launchctl" ;;
        esac
        if [ -n "${H_GRACE+set}" ]; then export RESUMED_POSTPLAN_GRACE_SECS="$H_GRACE"; fi
        . "$SCRIPT_DIR/lib/usage-gate.sh"
        queue_entries_ordered() { printf '%s\n' "$QUEUE_DIR/p.md"; }
        stat() {
            if [ "${1:-}" = -f ] && [ "${2:-}" = %m ]; then
                printf '%s\n' "$(( $(date +%s) - ${H_LOCK_AGE:-0} ))"; return 0
            fi
            command stat "$@"
        }
        rc=0
        case "${H_CALL:-claim}" in
            claim)  out=$(claim_next_plan) || rc=$? ;;
            helper) out=$(dispose_resumed_postplan_lock p.md "$lock") || rc=$? ;;
            helper-twice)
                out=$(dispose_resumed_postplan_lock p.md "$lock") || rc=$?
                cksum "$D"/reports/*-done-p.md > "$D/report-1" 2>/dev/null || : > "$D/report-1"
                rc=0
                out=$(dispose_resumed_postplan_lock p.md "$lock") || rc=$?
                cksum "$D"/reports/*-done-p.md > "$D/report-2" 2>/dev/null || : > "$D/report-2" ;;
        esac
        printf '%s\n' "$rc" > "$D/rc"; printf '%s' "$out" > "$D/out"
    )
    echo "$D"
}

# u_untouched: rc 1, empty stdout, plan + handoff kept, nothing disposed or reported.
u_untouched() {  # $1 = case dir, $2 = "handoff" (default) | "nohandoff"
    local D="$1"
    [ "$(cat "$D/rc" 2>/dev/null)" = "1" ] \
        && [ -z "$(cat "$D/out" 2>/dev/null)" ] \
        && [ -e "$D/queue/p.md" ] \
        && { [ "${2:-handoff}" = nohandoff ] || [ -e "$D/handoff/p.md.json" ]; } \
        && [ ! -e "$D/done/p.md" ] \
        && ! compgen -G "$D/reports/*-done-p.md" > /dev/null
}

u_base() {  # run_h_case with the shared u-case base; args: KNOB=value overrides, -KNOB unsets
    (
        export H_CALL=helper H_OWNER=live H_LOCK_AGE=60 H_SID="$H_SID_VAL" H_MARKER=0 \
               H_CLEARED_AGE=600 H_HANDOFF_BRANCH=p H_PR=open H_LAUNCHCTL=none
        local kv
        for kv in "$@"; do
            case "$kv" in
                -*) unset "${kv#-}" ;;
                *)  declare -x "$kv" ;;
            esac
        done
        run_h_case
    )
}

h_state() {  # $1 = case dir; one-line dump for FAIL output
    local D="$1"
    echo "rc=$(cat "$D/rc" 2>/dev/null || echo missing) out=$(cat "$D/out" 2>/dev/null) pid=$(cat "$D/queue/p.md.lock/pid" 2>/dev/null || echo none) held=$(cat "$D/queue/p.md.lock/paused-held" 2>/dev/null || echo none) handoff=$([ -e "$D/handoff/p.md.json" ] && echo yes || echo no) done=$([ -e "$D/done/p.md" ] && echo yes || echo no)"
}

# h1: dead owner, no paused-held → stolen
D=$(H_OWNER=dead H_LOCK_AGE=60 H_PR=open H_LAUNCHCTL=none run_h_case)
if [ "$(cat "$D/rc" 2>/dev/null)" = "0" ] \
   && [ "$(cat "$D/out" 2>/dev/null)" = "$D/queue/p.md" ] \
   && [ "$(cat "$D/queue/p.md.lock/pid" 2>/dev/null)" != "$(cat "$D/deadpid" 2>/dev/null)" ] \
   && grep -q 'stole stale lock for p.md' "$D/run.log"; then
    echo "ok: h1-stale-dead-owner-no-hold-steals"
else
    echo "FAIL: h1-stale-dead-owner-no-hold-steals — $(h_state "$D")"
    FAILED=1
fi

# h2: paused-held with the marker still present → skipped, lock untouched
D=$(H_OWNER=dead H_LOCK_AGE=20000 H_SID="$H_SID_VAL" H_MARKER=1 H_HANDOFF_BRANCH=p H_PR=open H_LAUNCHCTL=none run_h_case)
if [ "$(cat "$D/rc" 2>/dev/null)" = "1" ] \
   && [ -z "$(cat "$D/out" 2>/dev/null)" ] \
   && [ "$(cat "$D/queue/p.md.lock/paused-held" 2>/dev/null)" = "$H_SID_VAL" ] \
   && [ -e "$D/queue/p.md" ] && [ ! -e "$D/done/p.md" ]; then
    echo "ok: h2-paused-held-live-marker-skips"
else
    echo "FAIL: h2-paused-held-live-marker-skips — $(h_state "$D")"
    FAILED=1
fi

# h3: stale paused-held lock, PR lookup fails → plain steal, handoff kept
D=$(H_OWNER=dead H_LOCK_AGE=20000 H_SID="$H_SID_VAL" H_MARKER=0 H_CLEARED_AGE=20000 H_HANDOFF_BRANCH=p H_LOCK_BRANCH=p H_PR=error H_LAUNCHCTL=none run_h_case)
if [ "$(cat "$D/rc" 2>/dev/null)" = "0" ] \
   && [ "$(cat "$D/out" 2>/dev/null)" = "$D/queue/p.md" ] \
   && [ -e "$D/handoff/p.md.json" ] && [ ! -e "$D/done/p.md" ]; then
    echo "ok: h3-stale-hold-pr-lookup-fails-steals"
else
    echo "FAIL: h3-stale-hold-pr-lookup-fails-steals — $(h_state "$D")"
    FAILED=1
fi

# h4: recorded fork — stale lock WITHOUT paused-held, OPEN PR + handoff keeps today's steal.
# cleared/ is removed so the grace check cannot fail on its own (see plan fixture notes).
D=$(H_OWNER=dead H_LOCK_AGE=20000 H_HANDOFF_BRANCH=p H_PR=open H_LAUNCHCTL=none H_NO_CLEARED_DIR=1 run_h_case)
if [ "$(cat "$D/rc" 2>/dev/null)" = "0" ] \
   && [ "$(cat "$D/out" 2>/dev/null)" = "$D/queue/p.md" ] \
   && [ -e "$D/handoff/p.md.json" ] && [ ! -e "$D/done/p.md" ]; then
    echo "ok: h4-stale-no-hold-open-handoff-steals"
else
    echo "FAIL: h4-stale-no-hold-open-handoff-steals — $(h_state "$D")"
    FAILED=1
fi

# h5: live owner, lock age past TTL (stat stub), no paused-held → stolen on age alone
D=$(H_OWNER=live H_LOCK_AGE=20000 H_PR=open H_LAUNCHCTL=none run_h_case)
if [ "$(cat "$D/rc" 2>/dev/null)" = "0" ] \
   && [ "$(cat "$D/out" 2>/dev/null)" = "$D/queue/p.md" ]; then
    echo "ok: h5-stale-live-owner-ttl-steals"
else
    echo "FAIL: h5-stale-live-owner-ttl-steals — $(h_state "$D")"
    FAILED=1
fi

# h6: live owner, fresh lock → skipped, pid unchanged
D=$(H_OWNER=live H_LOCK_AGE=60 H_PR=open H_LAUNCHCTL=none run_h_case)
if [ "$(cat "$D/rc" 2>/dev/null)" = "1" ] \
   && [ -z "$(cat "$D/out" 2>/dev/null)" ] \
   && [ "$(cat "$D/queue/p.md.lock/pid" 2>/dev/null)" = "$$" ]; then
    echo "ok: h6-fresh-live-owner-skips"
else
    echo "FAIL: h6-fresh-live-owner-skips — $(h_state "$D")"
    FAILED=1
fi

# --- dispose_resumed_postplan_lock (called directly; shared base in u_base) ---

u_report() {  # $1 = case name, $2 = case dir, $3 = 0 when the assertions held
    if [ "$3" = 0 ]; then
        echo "ok: $1"
    else
        echo "FAIL: $1 — $(h_state "$2")"
        FAILED=1
    fi
}

# u_disposed: rc 0, empty stdout, done/p.md is a fresh symlink, queue entry + handoff gone,
# lock left for the caller. $2 = expected PR state in the report.
u_disposed() {
    local D="$1" state="$2" r
    r=$(compgen -G "$D/reports/*-done-p.md" | head -n 1)
    [ "$(cat "$D/rc" 2>/dev/null)" = "0" ] \
        && [ -z "$(cat "$D/out" 2>/dev/null)" ] \
        && [ -L "$D/done/p.md" ] \
        && [ -n "$(find "$D/done/p.md" -newer "$D/ref" 2>/dev/null)" ] \
        && [ ! -L "$D/queue/p.md" ] && [ ! -e "$D/handoff/p.md.json" ] \
        && [ -n "$r" ] && grep -q "branch PR is $state" "$r" \
        && [ -d "$D/queue/p.md.lock" ]
}

D=$(u_base)
u_disposed "$D" OPEN \
    && grep -q 'Loop-side disposition (resumed-postplan)' "$D/run.log" \
    && [ "$(cat "$D/pr-branch" 2>/dev/null)" = "p" ]
u_report u1-helper-open-handoff-disposes "$D" $?

D=$(u_base H_MARKER=1)
u_untouched "$D" && [ ! -e "$D/pr-branch" ]
u_report u2-helper-marker-live-untouched "$D" $?

D=$(u_base H_CLEARED_AGE=30)
u_untouched "$D"
u_report u3-helper-grace-not-elapsed-untouched "$D" $?

# Empty is legal and means the 300 s default: a 30 s stamp stays untouched, and a 600 s
# stamp disposes (an empty value read as a number would make `[` fail and leave it).
D=$(u_base H_CLEARED_AGE=30 H_GRACE=)
D2=$(u_base H_CLEARED_AGE=600 H_GRACE=)
u_untouched "$D" && u_disposed "$D2" OPEN
u_report u3b-helper-grace-empty-uses-default "$D" $?

D=$(u_base H_CLEARED_AGE=30 H_GRACE=10)
u_disposed "$D" OPEN
u_report u3c-helper-grace-override-disposes "$D" $?

D=$(u_base H_LAUNCHCTL=inflight)
u_untouched "$D"
u_report u4-helper-launchctl-inflight-untouched "$D" $?

D=$(u_base H_LAUNCHCTL=empty)
u_untouched "$D"
u_report u5-helper-launchctl-empty-untouched "$D" $?

D=$(u_base H_LAUNCHCTL=fail)
u_untouched "$D"
u_report u6-helper-launchctl-fails-untouched "$D" $?

D=$(u_base H_LAUNCHCTL=path-unset)
u_disposed "$D" OPEN
u_report u6b-helper-launchctl-cmd-unset-uses-path "$D" $?

D=$(u_base H_LAUNCHCTL=path-empty)
u_disposed "$D" OPEN
u_report u6c-helper-launchctl-cmd-empty-uses-path "$D" $?

D=$(u_base -H_HANDOFF_BRANCH)
u_untouched "$D" nohandoff && [ ! -e "$D/pr-branch" ]
u_report u7-helper-impl-pause-untouched "$D" $?

D=$(u_base H_PR=error)
u_untouched "$D"
u_report u8-helper-pr-lookup-fails-untouched "$D" $?

D=$(u_base -H_HANDOFF_BRANCH H_LOCK_BRANCH=p-branch H_PR=merged)
u_disposed "$D" MERGED \
    && [ "$(cat "$D/pr-branch" 2>/dev/null)" = "p-branch" ]
u_report u9-helper-breadcrumb-branch-used "$D" $?

D=$(u_base -H_SID -H_CLEARED_AGE H_NO_CLEARED_DIR=1)
u_untouched "$D"
u_report u10-helper-no-paused-held-untouched "$D" $?

# u11: the breadcrumb (not the handoff) is the evidence the second call still sees
D=$(u_base H_CALL=helper-twice H_LOCK_BRANCH=p)
[ "$(cat "$D/rc" 2>/dev/null)" = "0" ] \
    && [ -s "$D/report-1" ] && cmp -s "$D/report-1" "$D/report-2" \
    && [ -L "$D/done/p.md" ]
u_report u11-helper-idempotent "$D" $?

# ---------------------------------------------------------------------------
# Group g — CI wiring guard
# ---------------------------------------------------------------------------

WORKFLOW="$SCRIPT_DIR/../.github/workflows/tests.yml"
# g1: the test is wired into CI
if grep -qF 'bin/test-automouse-postplan-disposition' "$WORKFLOW"; then
    echo "ok: g1-wired-in-ci"
else
    echo "FAIL: g1-wired-in-ci — test not found in $WORKFLOW"
    FAILED=1
fi

# ---------------------------------------------------------------------------
# Tail
# ---------------------------------------------------------------------------

if [ "$FAILED" -ne 0 ]; then
    echo "RESULT: FAILED"
    exit 1
fi
echo "RESULT: all passed"
exit 0
