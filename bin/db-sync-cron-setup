#!/usr/bin/env bash
# One-time setup for the local DB snapshot nightly refresh (local-db-snapshot-freshness plan).
#
# Installs a Mac-local launchd LaunchAgent (com.ibl5.db-sync-nightly) that fires
# ibl5/bin/db-sync-now --from-backup once nightly at 03:20 via StartCalendarInterval.
# The plist Program/WorkingDirectory point at the durable MAIN checkout (never a
# worktree, which gets torn down after its PR merges).
#
# Usage:
#   bin/db-sync-cron-setup --print-schedule      # emit the plist to stdout (no side effect)
#   bin/db-sync-cron-setup --install-schedule    # install + load the LaunchAgent
#   bin/db-sync-cron-setup --uninstall-schedule  # unload + remove the LaunchAgent
#
# Install AFTER this lands on master — the launchd ProgramArguments[0] points at the
# main checkout's ibl5/bin/db-sync-now, which must exist there.
#
# For --install-schedule, PROD_SSH_HOST must be set in .env (repo root) — db-sync-now reads
# it itself at runtime; we validate here so a misconfigured plist does not silently
# fail every night).
#
# No DB credentials are embedded in the plist — ibl5/bin/db-sync-now reads .env (repo root)
# itself. No API-key env var is needed — this script does not spawn claude.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ACTION=""

while [ $# -gt 0 ]; do
  case "$1" in
    --install-schedule)   ACTION="install";   shift ;;
    --uninstall-schedule) ACTION="uninstall"; shift ;;
    --print-schedule)     ACTION="print";     shift ;;
    -h|--help) awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; exit 0 ;;
    *) echo "Unknown option: $1. Use --print-schedule, --install-schedule, or --uninstall-schedule." >&2; exit 2 ;;
  esac
done

if [ -z "$ACTION" ]; then
  echo "Usage: bin/db-sync-cron-setup --print-schedule | --install-schedule | --uninstall-schedule" >&2
  exit 2
fi

# --- Durable MAIN-checkout derivation -----------------------------------------
# ProgramArguments[0]/WorkingDirectory MUST point at the main checkout, never this
# worktree (a worktree gets torn down — the LaunchAgent would then point at a dead path).
# The first `git worktree list` entry is the main working tree.
MAIN_WT="$(git -C "$REPO_ROOT" worktree list --porcelain 2>/dev/null | awk '/^worktree / {print $2; exit}')"
[ -n "$MAIN_WT" ] || MAIN_WT="$REPO_ROOT"   # fallback: not in a git tree

PLIST_LABEL="com.ibl5.db-sync-nightly"
PLIST_PATH="$HOME/Library/LaunchAgents/${PLIST_LABEL}.plist"
LOG_DIR="$HOME/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/sim-recap/logs"
PROGRAM="$MAIN_WT/ibl5/bin/db-sync-now"

# Single source of truth for the plist — used by both --print-schedule and
# --install-schedule, so the MAIN-checkout derivation is exercised by tests.
# Variables expand at generation time (unquoted heredoc): HOME and MAIN_WT
# are baked in so launchd, which does NOT expand env vars in EnvironmentVariables,
# gets the real paths.
build_plist() {
  cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>${PLIST_LABEL}</string>
	<!-- do NOT 'fix' this to StartInterval — StartCalendarInterval fires once at 03:20,
	     not every N seconds; StartInterval would run this every N seconds continuously. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>3</integer>
		<key>Minute</key>
		<integer>20</integer>
	</dict>
	<key>ProgramArguments</key>
	<array>
		<string>${PROGRAM}</string>
		<string>--from-backup</string>
	</array>
	<key>WorkingDirectory</key>
	<string>${MAIN_WT}</string>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- launchd agents start with a minimal PATH that omits Homebrew; ssh, gzip,
		     mariadb-client must resolve. ~/.local/bin is where the Claude Code native
		     installer puts the claude binary (not needed here, but kept for parity with
		     the sim-recap plist so the two PATH strings can be maintained together).
		     HOME is expanded HERE, at generation time — launchd does NOT expand
		     variables in EnvironmentVariables, so a literal \$HOME would be a dead path. -->
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${HOME}/.local/bin</string>
	</dict>
	<key>StandardOutPath</key>
	<string>${LOG_DIR}/db-sync-nightly.out.log</string>
	<key>StandardErrorPath</key>
	<string>${LOG_DIR}/db-sync-nightly.err.log</string>
</dict>
</plist>
PLIST
}

case "$ACTION" in
  print)
    build_plist
    ;;
  install)
    # Validate PROD_SSH_HOST is set in .env — db-sync-now --from-backup needs
    # it to reach the prod host. Without this guard a misconfigured plist silently
    # fails every night with no error until someone checks the log.
    env_file="$MAIN_WT/.env"
    if [ ! -f "$env_file" ]; then
      echo "Error: .env not found at ${env_file}" >&2
      echo "       Set PROD_SSH_HOST there before running --install-schedule." >&2
      exit 1
    fi
    # shellcheck source=/dev/null
    source "$env_file"
    if [ -z "${PROD_SSH_HOST:-}" ]; then
      echo "Error: PROD_SSH_HOST is not set in ${env_file}" >&2
      echo "       Add PROD_SSH_HOST=<host> and re-run --install-schedule." >&2
      exit 1
    fi
    mkdir -p "$HOME/Library/LaunchAgents" "$LOG_DIR"
    build_plist > "$PLIST_PATH"
    launchctl bootout "gui/$(id -u)/${PLIST_LABEL}" 2>/dev/null || true  # idempotent: ignore "not loaded"
    launchctl bootstrap "gui/$(id -u)" "$PLIST_PATH"
    echo "Installed ${PLIST_LABEL} (03:20 nightly). Program: $PROGRAM --from-backup"
    ;;
  uninstall)
    launchctl bootout "gui/$(id -u)/${PLIST_LABEL}" 2>/dev/null || true  # idempotent
    rm -f "$PLIST_PATH"                                                    # idempotent: no error if absent
    echo "Uninstalled ${PLIST_LABEL}."
    ;;
esac
