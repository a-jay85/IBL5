#!/usr/bin/env bash
# shellcheck shell=bash
# Requeue plans that were skipped by the staleness gate and now pass it.
#
# Usage:
#   bin/automouse/self-heal           # requeue eligible plans
#   bin/automouse/self-heal --dry-run # preview without acting
#
# Only plans carrying a <plan>.md.staleness sidecar marker are eligible for
# *recovery* — ambiguity / poison-pill skips are never requeued (already-merged
# plans go to done/, not skipped/).
#
# Tombstone reaping is separate and runs BEFORE that marker gate: a skipped/
# entry whose plan file left PLANS_DIR is dead regardless of why it was skipped,
# so it is deleted, not recovered. Reaping never requeues anything.
#
# Also reaps heartbeat-watcher subshells orphaned by a killed bin/automouse/run
# (PPID 1, argv bin/automouse/run, direct `sleep 60` child, no live heartbeat
# file names it).

set -u

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
Usage: bin/automouse/self-heal [--dry-run]

Requeue automouse plans that were skipped by the staleness gate and now pass it.
Also reaps orphan skipped-dir entries whose plan file has left ~/claude-plans/.
Also reaps heartbeat-watcher subshells orphaned by a killed bin/automouse/run
(PPID 1, argv bin/automouse/run, direct `sleep 60` child, no live heartbeat file
names it).

Options:
  --dry-run   Preview healed / still-stale / reaped counts without making changes.

Only plans with a .staleness sidecar are eligible for recovery. Ambiguity and
poison-pill skips are never requeued. Tombstone reaping runs first and is
independent of the staleness marker.

Exit codes: 0 always (non-fatal; errors are printed but do not abort the run)
EOF
    exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

: "${NIGHTLY_DIR:=$HOME/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/automouse}"
: "${PLANS_DIR:=$HOME/claude-plans}"
: "${STALENESS_GUARD:=$SCRIPT_DIR/../check-plan-staleness}"
# Orphan-watcher sweep knobs. Tests point both at temp-dir fixtures so no test
# run ever scans or signals a real automouse process.
ORPHAN_ARGV_RE_DEFAULT='^[^ ]*bash [^ ]*bin/automouse/run( |$)'
: "${AUTOMOUSE_ORPHAN_ARGV_RE:=$ORPHAN_ARGV_RE_DEFAULT}"
: "${AUTOMOUSE_ORPHAN_PPID:=1}"
# shellcheck source=/dev/null
. "$SCRIPT_DIR/../lib/plan-depends-on"

SKIPPED_DIR="$NIGHTLY_DIR/skipped"
QUEUE_DIR="$NIGHTLY_DIR/queue"

DRY_RUN=0
[ "${1:-}" = "--dry-run" ] && DRY_RUN=1

healed=0
still_stale=0
tombstones=0
healed_names_file="$(mktemp)"
trap 'rm -f "$healed_names_file"' EXIT

holds_cleared=0
holds_waiting=0
holds_reaped=0
orphans_reaped=0
orphans_spared=0

# Clear dependency holds written by bin/automouse/run's depends_on: gate.
# Runs BEFORE the skipped/-empty guard below, because skipped/ is usually empty
# and a hold scan placed after it would never execute.
scan_depends_holds() {
    local sc name plan status dep rest reason
    for sc in "$QUEUE_DIR"/*.md.depends-hold; do
        [ -e "$sc" ] || continue                      # no matches → literal glob
        name="$(basename "$sc" .depends-hold)"        # e.g. foo.md
        plan="$QUEUE_DIR/$name"

        # Orphan reap: the plan left queue/ (a manual `queue remove`, or a
        # disposition move). bin/automouse/queue evicts .staleness/.attempts but
        # knows nothing about .depends-hold, and this PR does not modify it —
        # so the orphan is reaped here or never.
        if [ ! -e "$plan" ] && [ ! -L "$plan" ]; then
            [ "$DRY_RUN" -eq 1 ] || rm -f "$sc"
            holds_reaped=$((holds_reaped + 1))
            continue
        fi

        status="$(plan_depends_on_status "$plan")"
        case "$status" in
            met)
                if [ "$DRY_RUN" -eq 1 ]; then
                    echo "would clear hold: $name (dependency met)"
                else
                    rm -f "$sc"
                    echo "[depends-heal] $name: dep met, cleared hold"
                fi
                holds_cleared=$((holds_cleared + 1))
                ;;
            unmet:*)
                # Silent no-op: still waiting is the normal, expected state and
                # must not generate a line every cycle for every held plan.
                holds_waiting=$((holds_waiting + 1))
                ;;
            *)
                rest="${status#unresolvable:}"
                dep="${rest%%:*}"
                reason="${rest#*:}"
                echo "[depends-heal-warn] $name: still unresolvable — $reason (dep: $dep)"
                holds_waiting=$((holds_waiting + 1))
                ;;
        esac
    done
    echo "self-heal: $holds_cleared hold(s) cleared, $holds_waiting still held, $holds_reaped orphan sidecar(s) reaped."
}

# Reap heartbeat-watcher subshells orphaned by a SIGKILLed bin/automouse/run
# (cleanup_watcher never ran). A candidate must match EVERY clause below; any
# doubt spares it, because killing a live run is worse than leaking a watcher.
sweep_orphan_watchers() {
    local me snap pid ppid pgid uid args kid kpid kppid kargs hb n spare now_ppid now_args
    case "$AUTOMOUSE_ORPHAN_PPID" in ''|*[!0-9]*)
        echo "[orphan-sweep-warn] AUTOMOUSE_ORPHAN_PPID='$AUTOMOUSE_ORPHAN_PPID' is not a pid; sweep disabled"
        return 0 ;;
    esac
    me="$(id -u)"
    snap="$(ps -A -ww -o pid= -o ppid= -o pgid= -o uid= -o args= 2>/dev/null)" \
        || { echo "[orphan-sweep-warn] ps failed; sweep skipped"; return 0; }
    while read -r pid ppid pgid uid args; do
        [ "$uid" = "$me" ] || continue
        [ "$ppid" = "$AUTOMOUSE_ORPHAN_PPID" ] || continue
        [[ "$args" =~ $AUTOMOUSE_ORPHAN_ARGV_RE ]] || continue
        { [ "$pid" != "$$" ] && [ "$pid" != "$PPID" ]; } || continue
        # Only a watcher tick runs `sleep 60` as a direct child of the run script.
        kid=""
        while read -r kpid kppid _ _ kargs; do
            if [ "$kppid" = "$pid" ] && [ "$kargs" = "sleep 60" ]; then kid=$kpid; break; fi
        done <<< "$snap"
        if [ -z "$kid" ]; then orphans_spared=$((orphans_spared + 1)); continue; fi
        # A live run's heartbeat file (.heartbeat-<run pid>-<label>) naming this
        # candidate's pid or pgid spares it.
        spare=0
        for hb in "$NIGHTLY_DIR"/.heartbeat-*; do
            [ -e "$hb" ] || continue
            n="${hb##*/.heartbeat-}"; n="${n%%-*}"
            case "$n" in ''|*[!0-9]*) continue ;; esac
            if { [ "$n" = "$pid" ] || [ "$n" = "$pgid" ]; } && kill -0 "$n" 2>/dev/null; then
                spare=1; break
            fi
        done
        if [ "$spare" -eq 1 ]; then
            echo "[orphan-sweep] spared pid $pid: live heartbeat file names it"
            orphans_spared=$((orphans_spared + 1)); continue
        fi
        if [ "$DRY_RUN" -eq 1 ]; then
            echo "would reap orphan watcher: pid $pid (pgid $pgid)"
            orphans_reaped=$((orphans_reaped + 1)); continue
        fi
        # Re-read right before signalling; any drift spares the candidate.
        read -r now_ppid now_args < <(ps -ww -o ppid= -o args= -p "$pid" 2>/dev/null)
        if [ "${now_ppid:-}" != "$ppid" ] || [ "${now_args:-}" != "$args" ]; then
            echo "[orphan-sweep] spared pid $pid: changed since snapshot"
            orphans_spared=$((orphans_spared + 1)); continue
        fi
        read -r kppid kargs < <(ps -ww -o ppid= -o args= -p "$kid" 2>/dev/null)
        if [ "${kppid:-}" = "$pid" ] && [ "${kargs:-}" = "sleep 60" ]; then
            kill -TERM "$kid" 2>/dev/null || true
        fi
        kill -TERM "$pid" 2>/dev/null || true
        echo "[orphan-sweep] reaped orphan watcher pid $pid (pgid $pgid): $args"
        orphans_reaped=$((orphans_reaped + 1))
    done <<< "$snap"
    echo "self-heal: $orphans_reaped orphan watcher(s) reaped, $orphans_spared spared."
}

scan_depends_holds
sweep_orphan_watchers

if ! ls "$SKIPPED_DIR"/*.md >/dev/null 2>&1; then
    echo "self-heal: skipped/ is empty — nothing else to recover."
    exit 0
fi

for f in "$SKIPPED_DIR"/*.md; do
    [ -e "$f" ] || [ -L "$f" ] || continue        # no matches -> literal glob

    name="$(basename "$f")"
    marker="$SKIPPED_DIR/${name}.staleness"

    # Tombstone reap: the plan file left PLANS_DIR (deleted, or renamed by a
    # re-plan), leaving a dangling symlink here. `-e` dereferences, so the old
    # bare `[ -e "$f" ] || continue` silently skipped these forever -- never
    # healed, never counted as still-stale, never named in any output. Reap
    # them, using the same sidecar list bin/automouse/queue evicts.
    if [ -L "$f" ] && [ ! -e "$f" ]; then
        if [ "$DRY_RUN" -eq 1 ]; then
            echo "would reap tombstone: $name (plan no longer in $PLANS_DIR)"
        else
            rm -f "$f" "$marker" "$SKIPPED_DIR/${name}.attempts" \
                  "$SKIPPED_DIR/${name}.failure" "$SKIPPED_DIR/${name}.cap-refunds"
            echo "reaped tombstone: $name (plan no longer in $PLANS_DIR)"
        fi
        tombstones=$((tombstones + 1))
        continue
    fi

    # Core safety gate: only staleness-marked skips are eligible.
    [ -f "$marker" ] || continue

    # Run the staleness guard quietly against the skipped/ symlink.
    if "$STALENESS_GUARD" "$f" >/dev/null 2>&1; then
        # Guard passes — this plan is eligible for recovery.
        if [ "$DRY_RUN" -eq 1 ]; then
            echo "would heal: $name (staleness guard now passes)"
            healed=$((healed + 1))
            continue
        fi

        # Real mode: requeue via automouse-queue (owns mv + sidecar eviction).
        if NIGHTLY_DIR="$NIGHTLY_DIR" PLANS_DIR="$PLANS_DIR" \
           "$SCRIPT_DIR/queue" "$name" >/dev/null 2>&1; then
            echo "healed: $name (staleness guard now passes — requeued)"
            printf '%s\n' "$name" >> "$healed_names_file"
            healed=$((healed + 1))
        else
            echo "self-heal: requeue failed for $name (left in skipped/)"
        fi
    else
        # Guard still fails — leave the plan in skipped/.
        if [ "$DRY_RUN" -eq 1 ]; then
            echo "still stale: $name (staleness guard still flags it)"
        fi
        still_stale=$((still_stale + 1))
    fi
done

if [ "$DRY_RUN" -eq 1 ]; then
    echo "self-heal (dry-run): $healed would heal, $still_stale still stale, $tombstones tombstone(s) would be reaped. No changes made."
    exit 0
fi

if [ "$healed" -gt 0 ]; then
    mkdir -p "$NIGHTLY_DIR/reports"
    report="$NIGHTLY_DIR/reports/$(date +%Y-%m-%d)-self-heal.md"
    {
        echo "# Automouse Self-Heal Report — $(date +%Y-%m-%d)"
        echo ""
        echo "Plans recovered from staleness skip and requeued:"
        echo ""
        while IFS= read -r n; do
            echo "- $n"
        done < "$healed_names_file"
    } > "$report"
fi

echo "self-heal: $healed plan(s) recovered, $still_stale still stale, $tombstones tombstone(s) reaped."
exit 0
