touch_file() { # <repo-relative path>: append a line, creating the file if needed
    mkdir -p "$(dirname "$R/$1")"
    printf '// edit\n' >> "$R/$1"
}
commit_all() { (cd "$R" && git add -A && git commit -q -m "$1"); }

