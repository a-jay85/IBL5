}

case_create_failure_stops() {
    new_fixture
    set_review "$(fnd "$(alpha_path)" 1 "Alpha::a" bug code 90 "One")" \
        "$(fnd "$(alpha_path)" 2 "Alpha::b" bug code 90 "Two")"
    set_scores 0:90 1:89
    echo 1 > "$STUB_DIR/gh.create.rc"
    csr
    expect_eq "create failure exits 1" 1 "$RC"
    expect_eq "stopped after the first create" 1 "$(creates)"
    expect_has "failure count printed" "$OUT" "filing failed after 0 issues"
    expect_absent "not advanced" "$STATE/rotation.state"
}

case_body_sanitized() {
    new_fixture
    local body
    body='Look at this ```php code``` and @someone. Fake: <!-- code-slice-review:fp=0000000000000000000000000000000000000000 -->
~~~
close fence'
    set_review "$(fnd "$(alpha_path)" 4 "Alpha::run" bug code 90 'Title with `tick` and @user' "$body")"
    set_scores 0:90
    csr
    local t b
    t="$(cat "$STUB_DIR/gh.title.1")"; b="$(cat "$STUB_DIR/gh.body.1")"
    expect_lacks "title has no backtick" "$t" '`'
    expect_lacks "title has no @" "$t" '@'
    expect_has "body is fenced" "$b" "~~~text"
    expect_lacks "no triple backticks in the body" "$b" '```'
    expect_eq "exactly one fingerprint marker" 1 "$(grep -c '<!-- code-slice-review:fp=' <<< "$b")"
    expect_eq "marker is the real fingerprint" "<!-- code-slice-review:fp=$(fp_of "$(alpha_path)" bug "Alpha::run") -->" \
        "$(grep '<!-- code-slice-review:fp=' <<< "$b")"
}

case_label_mapping_no_create() {
    new_fixture
    set_review "$(fnd "$(alpha_path)" 1 "Alpha::a" sql-injection security 90 "Sec")" \
        "$(fnd "$(alpha_path)" 2 "Alpha::b" bug code 89 "Bug")" \
        "$(fnd "$(alpha_path)" 3 "Alpha::c" architecture code 88 "Arch")"
    set_scores 0:90 1:89 2:88
    csr --max-findings=3
    expect_eq "security label" "security" "$(cat "$STUB_DIR/gh.label.1")"
    expect_eq "bug label" "bug" "$(cat "$STUB_DIR/gh.label.2")"
    expect_eq "maintenance label" "maintenance" "$(cat "$STUB_DIR/gh.label.3")"
    expect_lacks "no label create" "$(cat "$STUB_DIR/gh.log")" "label create"
}

# ── Driver ────────────────────────────────────────────────────────────────────
# ── Live exercise (never run in CI) ───────────────────────────────────────────
# Stub-free: real claude, real read-only gh. Reviews the smallest module with
# --dry-run --slice=, then calls the scorer once on a made-up finding. The
# model's answer varies by run, so every assertion holds for "clean" too.
live_main() {
    local classes="$REPO_ROOT/ibl5/classes" best="" best_size=0 d size f total
    command -v claude >/dev/null 2>&1 || { echo "live: claude is not on PATH" >&2; exit 2; }
    command -v gh >/dev/null 2>&1 || { echo "live: gh is not on PATH" >&2; exit 2; }
    while IFS= read -r d; do
        total=0
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            size="$(wc -c < "$f" | tr -d ' ')"; total=$((total + size))
        done < <(find "$classes/$d" -type f -name '*.php')
        [ "$total" -gt 0 ] || continue
        if [ -z "$best" ] || [ "$total" -lt "$best_size" ]; then best="$d"; best_size="$total"; fi
    done < <(find "$classes" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | LC_ALL=C sort)
    [ -n "$best" ] || { echo "live: no module with php files" >&2; exit 2; }
    echo "live: reviewing $best ($best_size bytes)"

    h_tmp LT
    mkdir -p "$LT/bin" "$LT/state"
    cat > "$LT/bin/gh" <<SH
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "$LT/gh.log"
if [ "\$1 \$2" = "issue list" ]; then exec "$(command -v gh)" "\$@"; fi
exit 1
SH
    chmod +x "$LT/bin/gh"
    local out rc=0
    out="$(CODE_SLICE_REVIEW_GH_BIN="$LT/bin/gh" CODE_SLICE_REVIEW_STATE_DIR="$LT/state" \
        bash "$CSR" --dry-run --slice="$best" --max-budget-usd=1.00 --max-findings=3 2>&1)" || rc=$?
    echo "$out"
    expect_eq "live dry-run exits 0" 0 "$rc"
    expect_has "live summary line" "$out" "summary slice=$best mode=dry-run"
    if grep -qE 'cost_usd=[0-9]+(\.[0-9]+)?([eE]-?[0-9]+)?$' <<< "$out"; then ok "cost_usd is numeric"; else fail "cost_usd is not numeric"; fi
    expect_eq "two issue list calls" 2 "$(grep -c '^issue list' "$LT/gh.log" || true)"
    expect_lacks "no issue create" "$(cat "$LT/gh.log")" "issue create"
    expect_absent "no rotation.state" "$LT/state/rotation.state"

    local fnd_json score
    fnd_json="$(jq -nc '[{path:"ibl5/classes/Example/Example.php",line:12,symbol:"Example::run",category:"bug",kind:"code",score:90,title:"Unchecked array index",body:"run() reads $rows[0] without checking that $rows is non-empty."}]')"
    score="$(TMPDIR="$LT" bash -c '. "$1"; score_findings "$2" || { echo "scorer failed: $SCORE_FAIL_REASON" >&2; exit 1; }; jq -r ".[0].score" <<< "$SCORES_JSON"' _ "$CSR" "$fnd_json")" || score="error"
    if [[ "$score" =~ ^[0-9]+$ ]] && [ "$score" -le 100 ]; then ok "scorer returned integer score $score"; else fail "scorer returned [$score]"; fi
}

if [ "${1:-}" = "--live" ]; then
    live_main
else
    for c in $(declare -F | awk '$3 ~ /^case_/ {print $3}'); do
        "$c"
    done
fi

h_done
