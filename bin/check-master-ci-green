#!/bin/bash

# Verifies that all GitHub CI check-runs are green on a given SHA.
# Used by bin/merge-master-to-prod to prevent shipping a red build.
#
# Exit codes: 0 = pass, 1 = CI failure, 2 = usage error.

set -euo pipefail

# shellcheck source=bin/lib/ci-checks-green.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/ci-checks-green.sh"

MIN_REQUIRED_CHECKS="${MIN_REQUIRED_CHECKS:-1}"
GH_API_CMD="${GH_API_CMD:-gh api}"
# Comma-separated EXACT check-run names to ignore. Empty by default: this gate
# stays policy-free, and every caller that needs a skip states it explicitly
# (bin/merge-master-to-prod below, .github/workflows/promote-to-production.yml).
SKIP_CHECKS="${SKIP_CHECKS:-}"
# Comma-separated EXACT check-run names to ignore ONLY while still pending
# (status != completed). A completed run of a listed name still counts, so a
# red or cancelled deploy fails the verdict as before. Empty by default; the
# between-plans canary in bin/automouse/run sets it for the post-merge jobs
# that are always in flight on a just-merged master.
IGNORE_PENDING_CHECKS="${IGNORE_PENDING_CHECKS:-}"

# Comma-separated EXACT check-run names whose FAILURE is ignored: a completed
# run of a listed name with a conclusion outside {success, skipped, neutral} is
# dropped from the verdict. A pending run of a listed name is judged as usual
# ("checks still running"). Empty by default; only the between-plans canary in
# bin/automouse/run sets it, for helper workflows that test no code.
IGNORE_FAILED_CHECKS="${IGNORE_FAILED_CHECKS:-}"

usage() {
    cat <<'EOF'
Usage: bin/check-master-ci-green [SHA] [--skip-ci-check] [--help|-h]

Checks that all GitHub CI check-runs are green on the given SHA
(defaults to origin/master).

Options:
  --skip-ci-check   Emergency bypass — prints a warning and exits 0.
  --help, -h        Show this message.

Environment:
  GH_API_CMD            Override the API command (default: "gh api").
                        For testing: GH_API_CMD='cat /tmp/fixture.json #'
  MIN_REQUIRED_CHECKS   Minimum number of check-runs expected (default: 1).
                        Guards against the post-push race where workflows
                        have not started yet.
  MAX_WALKBACK          How many ancestor commits to check when HEAD has no
                        check-runs (default: 10). Handles path-filtered
                        commits (e.g. Dependabot bumps outside workflow
                        path globs).
  SKIP_CHECKS           Comma-separated EXACT check-run names to ignore
                        (default: none). Matching is exact — a name that
                        merely contains a listed name is NOT skipped.
                        Applied BEFORE the MIN_REQUIRED_CHECKS floor, so
                        skipping everything fails rather than passing.
                        Matched names are echoed to stdout.
  IGNORE_PENDING_CHECKS Comma-separated EXACT check-run names to ignore only
                        while they are still pending (status != completed).
                        A completed run of a listed name is judged as usual,
                        so a red deploy still fails. Applied BEFORE dedupe
                        (an older completed-red run outlives a newer pending
                        re-run of the same name) and BEFORE the
                        MIN_REQUIRED_CHECKS floor (ignoring everything fails
                        rather than passing). Matched pending names are
                        echoed to stdout.
  IGNORE_FAILED_CHECKS  Comma-separated EXACT check-run names whose failure
                        is ignored (completed with a conclusion other than
                        success/skipped/neutral). A pending run of a listed
                        name still blocks as "checks still running". Applied
                        AFTER dedupe (only the newest run per name is judged)
                        and BEFORE the MIN_REQUIRED_CHECKS floor. A HEAD left
                        with no runs falls back to an ancestor, and fails only
                        when none within the walk-back limit has enough runs.
                        Matched names and conclusions are echoed to stdout.

Trade-off: uses an "all-must-pass" model rather than a hardcoded check-name
list. A new optional check that lands red will block. Use --skip-ci-check
as the escape hatch, or SKIP_CHECKS for a named, logged exclusion.

Limitation: fetches one page of check-runs (100 results). IBL5's combined
workflow count is well under 50, so a single page suffices. Results are
deduplicated by check name (most recent run wins), so re-runs of flaky
checks are handled correctly.
Verdict logic is shared with bin/check-pr-checks-green via bin/lib/ci-checks-green.sh.

Exit codes: 0 = pass, 1 = CI failure, 2 = usage error.
EOF
}

SHA=""
SKIP=0

for arg in "$@"; do
    case "$arg" in
        --skip-ci-check)
            SKIP=1
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --*)
            echo "unknown flag: $arg" >&2
            usage >&2
            exit 2
            ;;
        *)
            SHA="$arg"
            ;;
    esac
done

if [ "$SKIP" = "1" ]; then
    echo "BYPASS: --skip-ci-check flag set — skipping CI verification."
    exit 0
fi

if ! gh auth status >/dev/null 2>&1; then
    echo "ERROR: GitHub CLI is not authenticated." >&2
    echo "Run 'gh auth login' to authenticate, then retry." >&2
    exit 2
fi

if [ -z "$SHA" ]; then
    SHA="$(git rev-parse origin/master 2>/dev/null)" || {
        echo "ERROR: cannot resolve origin/master" >&2
        exit 2
    }
fi

REMOTE_URL="$(git remote get-url origin 2>/dev/null)" || {
    echo "ERROR: cannot read origin remote URL" >&2
    exit 2
}

REPO="$(echo "$REMOTE_URL" | sed -E 's#^(https://github\.com/|ssh://git@github\.com/|git@github\.com:)##; s#\.git$##')"
if [ -z "$REPO" ]; then
    echo "ERROR: cannot parse repo slug from origin URL: $REMOTE_URL" >&2
    exit 2
fi

JSON="$(bash -c "$GH_API_CMD \"repos/$REPO/commits/$SHA/check-runs?per_page=100\"" 2>/dev/null)" || {
    echo "ERROR: GitHub API request failed" >&2
    exit 2
}

# Exact-name skip list as a JSON array. "" -> [""] -> [] after the length filter,
# so an unset SKIP_CHECKS is byte-for-byte a no-op.
SKIP_JSON="$(ccg_skip_json "$SKIP_CHECKS")"

if [ "$(printf '%s\n' "$SKIP_JSON" | jq 'length')" -gt 0 ]; then
    MATCHED="$(echo "$JSON" | jq -r --argjson skip "$SKIP_JSON" \
      '[.check_runs[].name] | unique | map(select(IN($skip[]))) | join(", ")')"
    echo "SKIP_CHECKS active — ignoring: ${MATCHED:-<none matched>}"
fi

# Pending-only ignore list, same "" -> [] derivation as SKIP_JSON, so an unset
# or empty IGNORE_PENDING_CHECKS never enters this branch and the JSON that
# reaches ccg_dedupe is byte-for-byte what it was before the var existed.
# Applied BEFORE ccg_dedupe: dedupe keeps the newest run per name, and a
# pending re-run is newer than the completed-red run it would hide.
IGNORE_JSON="$(ccg_skip_json "$IGNORE_PENDING_CHECKS")"
IGNORE_ACTIVE=0

if [ "$(printf '%s\n' "$IGNORE_JSON" | jq 'length')" -gt 0 ]; then
    IGNORE_ACTIVE=1
    IGNORE_MATCHED="$(echo "$JSON" | jq -r --argjson ignore "$IGNORE_JSON" \
      '[.check_runs[] | select((.name | IN($ignore[])) and (.status != "completed")) | .name] | unique | join(", ")')"
    echo "IGNORE_PENDING_CHECKS active — ignoring while pending: ${IGNORE_MATCHED:-<none matched>}"
    JSON="$(echo "$JSON" | ccg_drop_pending "$IGNORE_JSON")"
fi

JSON="$(echo "$JSON" | ccg_dedupe "$SKIP_JSON")"

# Failed-only ignore list. Same "" -> [] derivation as SKIP_JSON, so an unset
# or empty IGNORE_FAILED_CHECKS never enters this branch. Applied AFTER
# ccg_dedupe so only the newest run per name is judged, and BEFORE the TOTAL
# floor. A HEAD left with no runs is treated as path-filtered and inherits the
# verdict of the nearest ancestor with enough runs (the ancestor gets the same
# drop). It fails only when no ancestor within the walk-back limit qualifies.
IGNORE_FAILED_JSON="$(ccg_skip_json "$IGNORE_FAILED_CHECKS")"
IGNORE_FAILED_ACTIVE=0

if [ "$(printf '%s\n' "$IGNORE_FAILED_JSON" | jq 'length')" -gt 0 ]; then
    IGNORE_FAILED_ACTIVE=1
    IGNORE_FAILED_MATCHED="$(echo "$JSON" | jq --argjson ignore "$IGNORE_FAILED_JSON" \
      '{check_runs: [.check_runs[] | select(.name | IN($ignore[]))]}' | ccg_failed)"
    echo "IGNORE_FAILED_CHECKS active — ignoring failed: ${IGNORE_FAILED_MATCHED:-<none matched>}"
    JSON="$(echo "$JSON" | ccg_drop_failed "$IGNORE_FAILED_JSON")"
fi

TOTAL="$(echo "$JSON" | jq '.check_runs | length')"

if [ "$TOTAL" -eq 0 ]; then
    MAX_WALKBACK="${MAX_WALKBACK:-10}"
    FOUND=0
    for ANCESTOR_SHA in $(git log --format=%H "$SHA" --skip=1 --max-count="$MAX_WALKBACK"); do
        ANCESTOR_JSON="$(bash -c "$GH_API_CMD \"repos/$REPO/commits/$ANCESTOR_SHA/check-runs?per_page=100\"" 2>/dev/null)" || continue
        if [ "$IGNORE_ACTIVE" = "1" ]; then
            ANCESTOR_JSON="$(echo "$ANCESTOR_JSON" | ccg_drop_pending "$IGNORE_JSON")"
        fi
        ANCESTOR_JSON="$(echo "$ANCESTOR_JSON" | ccg_dedupe "$SKIP_JSON")"
        if [ "$IGNORE_FAILED_ACTIVE" = "1" ]; then
            ANCESTOR_JSON="$(echo "$ANCESTOR_JSON" | ccg_drop_failed "$IGNORE_FAILED_JSON")"
        fi
        ANCESTOR_TOTAL="$(echo "$ANCESTOR_JSON" | jq '.check_runs | length')"
        if [ "$ANCESTOR_TOTAL" -ge "$MIN_REQUIRED_CHECKS" ]; then
            echo "HEAD ${SHA:0:11} has no check-runs (path-filtered). Falling back to ancestor ${ANCESTOR_SHA:0:11} ($ANCESTOR_TOTAL run(s))."
            JSON="$ANCESTOR_JSON"
            TOTAL="$ANCESTOR_TOTAL"
            SHA="$ANCESTOR_SHA"
            FOUND=1
            break
        fi
    done
    if [ "$FOUND" = "0" ]; then
        echo "FAIL: only 0 check-run(s) found on HEAD and $MAX_WALKBACK ancestors (minimum: $MIN_REQUIRED_CHECKS)." >&2
        echo "Workflows may not have started yet. Wait and retry." >&2
        exit 1
    fi
elif [ "$TOTAL" -lt "$MIN_REQUIRED_CHECKS" ]; then
    echo "FAIL: only $TOTAL check-run(s) found (minimum: $MIN_REQUIRED_CHECKS)." >&2
    echo "Workflows may not have started yet. Wait and retry." >&2
    exit 1
fi

STILL_RUNNING="$(printf '%s' "$JSON" | ccg_pending)"
if [ -n "$STILL_RUNNING" ]; then
    echo "FAIL: checks still running: $STILL_RUNNING" >&2
    exit 1
fi

FAILED="$(printf '%s' "$JSON" | ccg_failed)"
if [ -n "$FAILED" ]; then
    echo "FAIL: checks failed: $FAILED" >&2
    exit 1
fi

echo "PASS: $TOTAL check-run(s) all green on $SHA"
exit 0
