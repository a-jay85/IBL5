need "DM names the hooks dir" dm_has ".claude/hooks"
need "HEAD restored" head_is_tip
need "origin unchanged" origin_is_tip
case_end holdrepeat-refs-and-user-hook

# 49 (launch machinery the launcher sources or execs is a gate path)
for HR_GP in bin/lib/git-helpers.sh bin/lib/new-helper.sh bin/discord-dm bin/post-plan-fail-dm bin/wt-sync-tick; do
    hr_reset
    { cat "$TMP/effects/hr-fix.sh"; printf 'mkdir -p "%s"; printf "x\\n" >> "%s"\n' "$(dirname "$HR_GP")" "$HR_GP"; } > "$TMP/effects/hr-gp.sh"
    export CLAUDE_STUB_REPLY="$TMP/reply-hr-fixed" CLAUDE_STUB_EFFECT="$TMP/effects/hr-gp.sh"
    hr_run
    need "$HR_GP: rc 21" test "$RC" = 21
    need "$HR_GP: final line" final_is "$STDOUT" gave-up-gate-path
    need "$HR_GP: DM names the path" dm_has "$HR_GP"
    need "$HR_GP: origin unchanged" origin_is_tip
    need "$HR_GP: worktree clean" wt_clean
done
case_end holdrepeat-launch-machinery-gate

# 50 (a failed push leaves no plan-edit comment)
hr_reset
printf '#!/bin/sh\nexit 1\n' > "$TMP/origin.git/hooks/pre-receive"; chmod +x "$TMP/origin.git/hooks/pre-receive"
export CLAUDE_STUB_REPLY="$TMP/reply-hr-fixed" CLAUDE_STUB_EFFECT="$TMP/effects/hr-planedit.sh"
hr_run
rm -f "$TMP/origin.git/hooks/pre-receive"
need "rc 21" test "$RC" = 21
need "final line" final_is "$STDOUT" gave-up-push
