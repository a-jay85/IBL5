# ---------------------------------------------------------------------------
# Full queue — 89 entries leave no prefix band; add must fail loudly, never
# write an unnumbered entry that would re-trigger the legacy mtime cutover
# ---------------------------------------------------------------------------
setup
for i in $(seq 1 89); do
    touch "$PDIR/full-$i.md"
    ln -s "$PDIR/full-$i.md" "$NDIR/queue/$(printf '%03d' $((i * 10)))-full-$i.md"
done
mkplan plan-over.md plan-back.md
# A failed add must not evict the plan's done/ link (backlog#1576): eviction
# runs only after append_entry succeeds.
ln -s "$PDIR/plan-over.md" "$NDIR/done/plan-over.md"
touch "$NDIR/done/plan-over.md.staleness"
rq plan-over
assert_not_queued "full queue: overflow plan not queued" plan-over
if [ "$RC" -ne 0 ] && grep -qF "queue is full" <<< "$OUT"; then
    h_pass "full queue — add fails loudly"
else
    h_fail "full queue — add fails loudly (rc=$RC): $OUT"
fi
if [ -L "$NDIR/done/plan-over.md" ] && [ -e "$NDIR/done/plan-over.md.staleness" ]; then
    h_pass "full queue — failed add keeps the done/ link and its sidecar"
else
    h_fail "full queue — failed add keeps the done/ link and its sidecar"
fi
# Same for requeue: a full queue leaves the skipped/ link where it was.
ln -s "$PDIR/plan-back.md" "$NDIR/skipped/plan-back.md"
rq requeue
assert_not_queued "full queue: requeued plan not queued" plan-back
if [ "$RC" -ne 0 ] && [ -L "$NDIR/skipped/plan-back.md" ]; then
    h_pass "full queue — failed requeue keeps the skipped/ link"
else
    h_fail "full queue — failed requeue keeps the skipped/ link (rc=$RC): $OUT"
fi
UNNUMBERED=0
for f in "$NDIR"/queue/-*; do
    if [ -e "$f" ] || [ -L "$f" ]; then UNNUMBERED=1; fi
done
if [ "$UNNUMBERED" -eq 1 ]; then
    h_fail "full queue — no unnumbered entry written"
else
    h_pass "full queue — no unnumbered entry written"
fi

# ---------------------------------------------------------------------------
# NNN- plan names — a plan whose own name starts with three digits and a dash
# would lose those digits in entry_to_slug, so add and requeue refuse it
# ---------------------------------------------------------------------------
setup
mkplan 100-foo.md
rq 100-foo.md
if [ "$RC" -ne 0 ] && grep -qF "reserves for run order" <<< "$OUT" \
    && [ -z "$(qls)" ]; then
    h_pass "NNN- plan name — add refuses and writes no entry"
else
    h_fail "NNN- plan name — add refuses and writes no entry (rc=$RC, queue: $(qls)): $OUT"
fi
setup
mkplan 042-fix.md
ln -s "$PDIR/042-fix.md" "$NDIR/skipped/042-fix.md"
rq requeue
if [ -z "$(qls)" ] && [ -L "$NDIR/skipped/042-fix.md" ] \
    && grep -qF "reserved for run order" <<< "$OUT"; then
    h_pass "NNN- plan name — requeue leaves it in skipped/"
else
    h_fail "NNN- plan name — requeue leaves it in skipped/ (queue: $(qls)): $OUT"
fi

# ---------------------------------------------------------------------------
# renumber_queue past 89 entries — refuses before any rename, so no entry is
# parked in the 9xx band or numbered past 890
# ---------------------------------------------------------------------------
hq_reset
for i in $(seq 1 90); do
    ln -s /dev/null "$HQ/$(printf '%03d' $((i * 10 % 900)))-big-$i.md"
done
BEFORE=$(ls -1 "$HQ" | tr '\n' ' ')
RC=0
renumber_queue "$HQ" 2>/dev/null || RC=$?
if [ "$RC" -ne 0 ] && [ "$(ls -1 "$HQ" | tr '\n' ' ')" = "$BEFORE" ]; then
    h_pass "renumber_queue — 90 entries refused, nothing renamed"
else
    h_fail "renumber_queue — 90 entries refused, nothing renamed (rc=$RC)"
fi

# ---------------------------------------------------------------------------
# icebox — ice moves an entry and its sidecars out, keeps a locked plan, and
# thaw re-appends in icebox order behind what is still queued
# ---------------------------------------------------------------------------
setup
for s in ice-a ice-b ice-c ice-keep; do printf -- '---\nimpl_model: sonnet\n---\n\n# %s\n' "$s" > "$PDIR/$s.md"; done
ln -s "$PDIR/ice-a.md" "$NDIR/queue/010-ice-a.md"
ln -s "$PDIR/ice-b.md" "$NDIR/queue/020-ice-b.md"
ln -s "$PDIR/ice-c.md" "$NDIR/queue/030-ice-c.md"
ln -s "$PDIR/ice-keep.md" "$NDIR/queue/040-ice-keep.md"
echo 2 > "$NDIR/queue/ice-a.md.attempts"
mkdir "$NDIR/queue/ice-c.md.lock"
OUT=$(NIGHTLY_DIR="$NDIR" PLANS_DIR="$PDIR" "$SCRIPT" ice --all-except ice-keep 2>&1)
h_exists "icebox: ice moves the entry with its prefix" "$NDIR/icebox/010-ice-a.md"
h_exists "icebox: ice moves the attempts sidecar" "$NDIR/icebox/ice-a.md.attempts"
h_exists "icebox: a locked plan stays queued" "$NDIR/queue/030-ice-c.md"
h_contains "icebox: the locked plan is named as skipped" "$OUT" "Skipped ice-c.md"
h_exists "icebox: --all-except keeps the named plan" "$NDIR/queue/040-ice-keep.md"
h_absent "icebox: the run lock never moves" "$NDIR/icebox/ice-c.md.lock"
LIST=$(NIGHTLY_DIR="$NDIR" PLANS_DIR="$PDIR" "$SCRIPT" icebox 2>&1)
h_contains "icebox: the listing shows an iced plan" "$LIST" "ice-b.md"
rmdir "$NDIR/queue/ice-c.md.lock"
echo 1700000000 > "$NDIR/icebox/.frozen-resets-at"
NIGHTLY_DIR="$NDIR" PLANS_DIR="$PDIR" "$SCRIPT" thaw >/dev/null 2>&1
h_eq "icebox: thaw appends in icebox order behind the queue" \
    "ice-c.md ice-keep.md ice-a.md ice-b.md" \
    "$(queue_entries "$NDIR/queue" | while IFS= read -r e; do entry_to_name "$e"; done | tr '\n' ' ' | sed 's/ $//')"
h_exists "icebox: thaw brings the sidecar back" "$NDIR/queue/ice-a.md.attempts"
h_absent "icebox: an empty icebox drops the freeze stamp" "$NDIR/icebox/.frozen-resets-at"
ln -s "$PDIR/ice-b.md" "$NDIR/icebox/020-ice-b.md"
NIGHTLY_DIR="$NDIR" PLANS_DIR="$PDIR" "$SCRIPT" remove ice-b >/dev/null 2>&1
NIGHTLY_DIR="$NDIR" PLANS_DIR="$PDIR" "$SCRIPT" ice-b >/dev/null 2>&1
h_absent "icebox: queue add evicts the iced copy" "$NDIR/icebox/020-ice-b.md"

if grep -qE '^MAX_ATTEMPTS=3([[:space:]]|$)' "$SCRIPT_DIR/automouse/run"; then
    h_pass "row-max-attempts-sync"
else
    h_fail "row-max-attempts-sync — bin/automouse/run MAX_ATTEMPTS changed; update STATUS_MAX_ATTEMPTS in bin/automouse/queue"
fi

# ---------------------------------------------------------------------------
# Row 50 — the add path detaches stdin. The check-plan stub reads stdin to EOF,
# and the caller's stdin is a pipe that stays open for 60s. Without the detach
# the stub blocks and `timeout 15` kills the add. The stub writes a marker
# after the read, so a stub that never ran cannot pass.
# ---------------------------------------------------------------------------
setup
mkplan plan-stdin.md
CP_STDIN="$TMP/cp-stdin"
printf '#!/bin/bash\ncat >/dev/null\ntouch "%s/cp-stdin-ran"\nexit 0\n' "$TMP" > "$CP_STDIN"
chmod +x "$CP_STDIN"
rm -f "$TMP/cp-stdin-ran"
RC=0
OUT=$(AUTOMOUSE_CHECK_PLAN="$CP_STDIN" NIGHTLY_DIR="$NDIR" PLANS_DIR="$PDIR" \
    timeout 15 "$SCRIPT" add plan-stdin < <(sleep 60) 2>&1) || RC=$?
h_eq "row50 add exits 0 with an open stdin pipe" "0" "$RC"
assert_present "row50 check-plan stub ran to the end" "$TMP/cp-stdin-ran"
assert_queued "row50 plan queued" plan-stdin.md
h_contains "row50 progress line printed before check-plan" "$OUT" "Checking plan-stdin.md with bin/check-plan"

# ---------------------------------------------------------------------------
# Row 49 (matrix 18) — no prefix leak. A copy of the real runner claims a plan
# whose entry is 040-plan-leak.md and runs impl + post-plan against stubs. The
# claim lock, .attempts, the handoff JSON, the cost rows and every report name
# use the bare plan-leak / plan-leak.md, never 040-plan-leak. The stubs list
# queue/ and handoff/ while they run, because the run removes those sidecars
# before it exits. .failure only appears after a failed impl, which this happy
# run never has; the runner builds it from the same PLAN_NAME as .attempts.
# The run loop needs macOS tools (caffeinate, BSD stat/date), so elsewhere this
# row prints SKIP, like bin/test-automouse-single. AUTOMOUSE_QUEUE_UNAME
# overrides the platform check.
# ---------------------------------------------------------------------------
if [ "${AUTOMOUSE_QUEUE_UNAME:-$(uname)}" != "Darwin" ]; then
    echo "SKIP: row49 (matrix 18, no prefix leak) drives the run loop, which needs macOS."
else
    L_ROOT="$TMP/leak"
    L_NDIR="$L_ROOT/automouse"
    L_PDIR="$L_ROOT/plans"
    L_STUB="$L_ROOT/stub"
    L_TRACE="$L_ROOT/trace"
    mkdir -p "$L_NDIR/queue" "$L_NDIR/handoff" "$L_NDIR/logs" "$L_NDIR/reports" \
             "$L_NDIR/done" "$L_NDIR/skipped" "$L_PDIR" "$L_STUB" "$L_ROOT/wt"
    # shellcheck source=bin/lib/usage-test-isolation.sh
    . "$SCRIPT_DIR/lib/usage-test-isolation.sh"; usage_test_isolate "$L_ROOT/usage"

    # Stub claude: the first call per plan (impl) writes the handoff named by
    # PLAN_FILE=, then lists queue/ and handoff/ into the trace.
    cat > "$L_STUB/claude" <<STUB
#!/usr/bin/env bash
plan="\$(printf '%s\n' "\$*" | grep -oE 'PLAN_FILE=[^[:space:]]+' | tail -1 | cut -d= -f2)"
sleep 2
if [ -n "\$plan" ] && [ ! -f "$L_NDIR/handoff/\$plan.json" ]; then
    printf '{"branch":"x","plan":"%s","worktree":"%s"}\n' "\$plan" "$L_ROOT/wt" > "$L_NDIR/handoff/\$plan.json"
fi
{ echo "impl PLAN_FILE=\$plan"; ls -1A "$L_NDIR/queue" "$L_NDIR/handoff"; } >> "$L_TRACE"
printf '{"type":"result","subtype":"success","stop_reason":"end_turn","num_turns":1,"duration_ms":2000,"total_cost_usd":0.001,"usage":{"input_tokens":1,"output_tokens":1}}\n'
exit 0
STUB
    # Stub post-plan-now: list queue/ and handoff/, then finish the plan.
    cat > "$L_STUB/post-plan-now" <<STUB
#!/usr/bin/env bash
plan="\$(basename "\${3:-}")"
{ echo "postplan --plan \$plan"; ls -1A "$L_NDIR/queue" "$L_NDIR/handoff"; } >> "$L_TRACE"
sleep 2
for e in "$L_NDIR"/queue/[0-9][0-9][0-9]-"\$plan"; do mv "\$e" "$L_NDIR/done/\$plan" 2>/dev/null || true; done
rm -f "$L_NDIR/handoff/\$plan.json" "$L_NDIR/queue/\$plan.attempts"
exit 0
STUB
    printf '#!/usr/bin/env bash\ncat >/dev/null\nexit 0\n' > "$L_STUB/discord-dm"
    chmod +x "$L_STUB/claude" "$L_STUB/post-plan-now" "$L_STUB/discord-dm"
    L_RUNNER="$L_ROOT/run"
    sed -e "s#^NIGHTLY_DIR=.*#NIGHTLY_DIR=\"$L_NDIR\"#" \
        -e "s#^REPO=.*#REPO=\"$REPO_ROOT\"#" \
        -e "s#^SELF_DIR=.*#SELF_DIR=\"$SCRIPT_DIR/automouse\"#" \
        -e "s#^export PATH=.*#export PATH=\"$L_STUB:/usr/local/bin:/opt/homebrew/bin:\$PATH\"#" \
        -e "s#\"\$SELF_DIR/../post-plan-now\"#\"$L_STUB/post-plan-now\"#" \
        -e "s#\"\$SELF_DIR/../discord-dm\"#\"$L_STUB/discord-dm\"#" \
        "$SCRIPT_DIR/automouse/run" > "$L_RUNNER"
    chmod +x "$L_RUNNER"

    printf -- '---\nimpl_model: sonnet\n---\n\n# plan-leak\n' > "$L_PDIR/plan-leak.md"
    ln -s "$L_PDIR/plan-leak.md" "$L_NDIR/queue/040-plan-leak.md"
    L_RC=0
    AUTOMOUSE_LOGIN_PROBE_CMD="echo ok" PLANS_DIR="$L_PDIR" \
        "$L_RUNNER" plan plan-leak > "$L_ROOT/run.out" 2>&1 || L_RC=$?
    h_eq "row49 runner exits 0" "0" "$L_RC"
    assert_present "row49 plan finished" "$L_NDIR/done/plan-leak.md"

    L_TRACE_TXT=$(cat "$L_TRACE" 2>/dev/null)
    # Positive: each sidecar was seen under its bare name, so an empty trace
    # cannot pass the negative check below.
    for n in 'impl PLAN_FILE=plan-leak.md' 'postplan --plan plan-leak.md' \
             'plan-leak.md.lock' 'plan-leak.md.attempts' 'plan-leak.md.json'; do
        grep -qxF -- "$n" <<< "$L_TRACE_TXT" \
            || h_fail "row49 run saw bare $n" "trace: $L_TRACE_TXT"
    done
    L_COSTS=$(cat "$L_NDIR"/logs/*.costs.jsonl "$L_NDIR"/reports/*-costs.md 2>/dev/null)
    grep -qF 'plan-leak.md' <<< "$L_COSTS" \
        || h_fail "row49 a cost row names plan-leak.md" "costs: $L_COSTS"
    L_NAMES=$(find "$L_NDIR" -print | sed 's#.*/##')
    grep -qF 'plan-leak' <<< "$L_NAMES" \
        || h_fail "row49 some output file is named for plan-leak" "files: $L_NAMES"
    # Negative: the 040- prefix appears in none of them. The pattern names the
    # slug, because every report name starts with a date like 2026-10-27.
    L_ALL=$(printf '%s\n%s\n%s\n' "$L_TRACE_TXT" "$L_COSTS" "$(find "$L_NDIR" -path "$L_NDIR/queue" -prune -o -print | sed 's#.*/##')")
    L_LEAKS=$(grep -E '(^|[^0-9])[0-9]{3}-plan-leak' <<< "$L_ALL" | grep -vxF '040-plan-leak.md' || true)
    h_eq "row49 no NNN- prefix in a lock, sidecar, handoff, cost row or report name" "" "$L_LEAKS"
    h_pass "row49 — claimed plan identifiers never carry the NNN- prefix"
fi

h_done
