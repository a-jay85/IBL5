mk_prior_body "READY" "**LATEST VERDICT: READY** — posted 2026-09-26 23:43:51 PDT" "$CF_PLANLINE" "$CF_T"
cf_check cf-harness-banner "$(cf_decide "$BCFD")" "FIDELITY_GATE=skip"
CF_PLAN_POS=audit

# --- terminal-word refusals
