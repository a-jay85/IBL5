#!/usr/bin/env bash
# test-pr-cycle — behaviour tests for bin/pr-cycle.
#
# Covers selection, readying, arming, merge confirmation, ledgering, the caps and stops,
# the dry-run default, artifact generation, and the static guards over the driver's own
# source. Nothing here bootstraps a launchd job, touches a real PR, or writes outside the
# scratch dir, so it runs identically on macOS and Linux CI — there is deliberately no
# platform skip.
#
# Driven entirely through bin/pr-cycle's documented PR_CYCLE_* env seams plus a scratch
# HOME and a scratch git repo standing in for the main checkout.
#
# Usage: bin/test-pr-cycle

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
DRIVER="$SCRIPT_DIR/pr-cycle"
[[ -x "$DRIVER" ]] || { echo "FAIL: $DRIVER missing or not executable" >&2; exit 1; }

SCRATCH="$(mktemp -d)"

# The driver's run directory is /tmp/pr-cycle-<TS>, and TS comes from the PR_CYCLE_TS seam.
# That token MUST be unique per suite run: reset_state rm -rf's the whole /tmp/pr-cycle-<TS>*
# tree between cases, so two concurrent invocations of this suite sharing one token delete
# each other's attack.md mid-iteration and both go red at random. $$ is the cheapest token
# that is unique per process and still stable across every case in one run.
#
# The `tpc` prefix is deliberate and must NOT start with `testfix`. Until this fix is on
# master, other checkouts of this suite still sweep the hardcoded glob /tmp/pr-cycle-testfix*
# -- which a `testfix$$` token matches. A concurrent run from such a checkout would then
# delete this run's directories out from under it, which is the exact failure being fixed.
TSBASE="tpc$$"

_cleanup() { rm -rf "$SCRATCH" "/tmp/pr-cycle-$TSBASE"* ; }
trap _cleanup EXIT

FAILED=0
CASE_BASE=0
fail() { echo "FAIL: $*" >&2; FAILED=$((FAILED + 1)); }
begin_case() { CASE_BASE=$FAILED; }
end_case() {  # $1 = case name; prints "<name> OK" only if the case added no failures
    if [[ $FAILED -eq $CASE_BASE ]]; then echo "$1 OK"; else echo "$1 FAILED" >&2; fi
}

BIN="$SCRATCH/.local/bin"
mkdir -p "$BIN"

# --- the scratch main checkout ------------------------------------------------------------
# A real git repo, because the driver's guard asks git for the toplevel and then requires
# .git to be a DIRECTORY. Resolve the path through git itself: on macOS mktemp hands back
# /var/..., a symlink to /private/var, and a literal string compare would spuriously fail.
REPO="$SCRATCH/repo"
mkdir -p "$REPO"
git -C "$REPO" init -q 2>/dev/null
git -C "$REPO" config user.email t@t.invalid
git -C "$REPO" config user.name t
: > "$REPO/seed"
git -C "$REPO" add -A >/dev/null 2>&1
git -C "$REPO" commit -qm seed >/dev/null 2>&1
MAIN="$(cd "$REPO" && git rev-parse --show-toplevel)"

# A linked worktree of that repo: same tooling, but .git is a FILE. Used to prove the
# guard rejects a worktree even when its path is handed in as the expected checkout.
WT="$SCRATCH/wt"
git -C "$REPO" worktree add -q -b wtbranch "$WT" >/dev/null 2>&1
WT_TOP="$(cd "$WT" && git rev-parse --show-toplevel 2>/dev/null)"

# --- recording shims -----------------------------------------------------------------------
# Each shim appends its argv to <name>.argv (one line per call) and replays canned output.
# Per-call overrides live in <name>-out-<N> / <name>-rc-<N> where N is the 1-based call
# index; the unsuffixed files are the fallback.
mkshim() {  # $1 = shim name
    cat > "$BIN/$1" <<SHIM_EOF
#!/usr/bin/env bash
S="$SCRATCH"
printf '%s\n' "\$(printf '%s' "\$*" | tr '\\n' ' ')" >> "\$S/$1.argv"
N=\$(wc -l < "\$S/$1.argv" | tr -d ' ')
[[ -f "\$S/$1-hook-\$N" ]] && . "\$S/$1-hook-\$N"
[[ -f "\$S/$1-hook" ]] && . "\$S/$1-hook"
if [[ -f "\$S/$1-out-\$N" ]]; then cat "\$S/$1-out-\$N"
elif [[ -f "\$S/$1-out" ]]; then cat "\$S/$1-out"; fi
if [[ -f "\$S/$1-err-\$N" ]]; then cat "\$S/$1-err-\$N" >&2
elif [[ -f "\$S/$1-err" ]]; then cat "\$S/$1-err" >&2; fi
if [[ -f "\$S/$1-rc-\$N" ]]; then exit "\$(cat "\$S/$1-rc-\$N")"
elif [[ -f "\$S/$1-rc" ]]; then exit "\$(cat "\$S/$1-rc")"; fi
exit 0
SHIM_EOF
    chmod +x "$BIN/$1"
}
mkshim attack
mkshim ready
mkshim triage
mkshim dm

# gh shim. `pr view N --json state --jq .state` replays state-N (default OPEN).
cat > "$BIN/gh" <<GH_EOF
#!/usr/bin/env bash
S="$SCRATCH"
printf '%s\n' "\$*" >> "\$S/gh.argv"
num=""
for a in "\$@"; do case "\$a" in [0-9]*) num="\$a"; break ;; esac; done
case "\$*" in
    *"pr list"*"--json number,url,title,state"*)
        [[ -f "\$S/gh-fail-prlist" ]] && exit 5
        [[ -f "\$S/prlist.tsv" ]] && cat "\$S/prlist.tsv" ;;
    *"--json state"*)
        if [[ -f "\$S/state-\$num" ]]; then cat "\$S/state-\$num"; else echo OPEN; fi ;;
    *"--json comments,headRefOid"*)
        # The verdict pre-read. \$S/gh-fail-verdict forces the non-zero
        # exit the driver has to degrade through.
        [[ -f "\$S/gh-fail-verdict" ]] && exit 3
        if [[ -f "\$S/verdictview-\$num.json" ]]; then cat "\$S/verdictview-\$num.json"
        else echo '{"comments":[],"headRefOid":""}'; fi ;;
    *"api repos/"*"/git/commits/"*)
        # \$* is: api repos/{owner}/{repo}/git/commits/<oid> --jq .tree.sha
        # Join into a plain variable FIRST. \${*##pat} applies the removal to each
        # positional parameter separately and only then joins, so it yields "api" here.
        all="\$*"; oid="\${all##*/git/commits/}"; oid="\${oid%% *}"
        # No fixture for this oid = the lookup failed, which is a degrade path the driver
        # owes a test. Exit non-zero rather than printing an empty tree.
        [[ -f "\$S/tree-\$oid" ]] || exit 4
        cat "\$S/tree-\$oid" ;;
esac
exit 0
GH_EOF
chmod +x "$BIN/gh"

# launchctl shim — makes the "already live" guard testable, and testable on Linux CI where
# launchctl does not exist at all. `launchctl list` echoes whatever the current case wrote
# to launchctl-list.txt; everything else is a recorded no-op.
#
# The 6000-line filler is load-bearing, not padding. The bug the guard exists to prevent is
# a SIGPIPE under `set -o pipefail`: it only reproduces when the writer still has queued
# output after the reader exits. Real `launchctl list` prints hundreds of lines; a three-line
# shim would finish writing before grep -q exited and the buggy form would pass anyway. The
# filler follows the fixture labels and exceeds the 64KB pipe buffer, so a match always
# leaves bytes unwritten.
: > "$SCRATCH/launchctl-list.txt"
cat > "$BIN/launchctl" <<LC_EOF
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "$SCRATCH/launchctl.argv"
if [[ "\${1:-}" == "list" && \$# -eq 1 ]]; then
    cat "$SCRATCH/launchctl-list.txt"
    i=0
    while [[ \$i -lt 6000 ]]; do
        printf -- '-\t0\tcom.apple.filler.service.number.%s\n' "\$i"
        i=\$((i + 1))
    done
fi
exit 0
LC_EOF
chmod +x "$BIN/launchctl"

set_live_labels() { printf '%s\n' "$@" > "$SCRATCH/launchctl-list.txt"; }
clear_live_labels() { : > "$SCRATCH/launchctl-list.txt"; }

# --- fixtures ------------------------------------------------------------------------------
# A three-PR plan of attack, in the shape bin/pr-attack emits. The dashed separator row is
# included deliberately: it must never be collected as an orderable PR.
ATTACK_3PR='# Plan of attack

| # | PR | Constraint | Needs you? |
|---|----|-----------|------------|
| 1 | #101 first-slug | none | no |
| 2 | #102 second-slug | none | yes |
| 3 | #103 third-slug | none | no |
'

ATTACK_1PR='# Plan of attack

| # | PR | Constraint | Needs you? |
|---|----|-----------|------------|
| 1 | #101 first-slug | none | no |
'

# A one-PR plan of attack that also carries an ## Excluded section, in the shape bin/pr-attack
# emits it. Four adversarial shapes on purpose: an ordinary DIRTY bullet; a DIRTY bullet whose
# slug is empty (pr-attack's `jq ... // ""`), giving a double space; a DIRTY bullet whose slug
# itself contains a literal " — "; a DRAFT bullet that is excluded but NOT a rescue candidate;
# and a DIRTY-looking decoy in the NEXT section, which a section-scoped parser must not reach.
ATTACK_EXCLUDED='# Plan of attack

| # | PR | Constraint | Needs you? |
|---|----|-----------|------------|
| 1 | #101 first-slug | none | no |

## Excluded

- #201 dirty-slug — DIRTY (merge conflict; rebase before it can be ordered)
- #202  — DIRTY (merge conflict; rebase before it can be ordered)
- #203 draft-slug — DRAFT
- #205 weird — slug — DIRTY (merge conflict; rebase before it can be ordered)

## Hand-resolutions needed

- #204 decoy-slug — DIRTY (merge conflict; rebase before it can be ordered)
'

# The same document with an EMPTY ordered table: the ordered work is drained on the first
# iteration, so the drain-point call site is the only one that can fire.
ATTACK_EXCLUDED_ONLY='# Plan of attack

| # | PR | Constraint | Needs you? |
|---|----|-----------|------------|
'"${ATTACK_EXCLUDED#*| 1 | #101 first-slug | none | no |}"

# Two ordered rows plus DIRTY/DRAFT excluded entries (2xxx PR numbers).
ATTACK_2PR_EXCLUDED='# Plan of attack

| # | PR | Constraint | Needs you? |
|---|----|-----------|------------|
| 1 | #2101 alpha-slug | none | no |
| 2 | #2102 beta-slug | none | no |

## Excluded

- #2201 dirty-slug — DIRTY (merge conflict; rebase before it can be ordered)
- #2202 draft-slug — DRAFT
'

# Four ordered rows (2101-2104) with no excluded section.
ATTACK_4PR='# Plan of attack

| # | PR | Constraint | Needs you? |
|---|----|-----------|------------|
| 1 | #2101 alpha-slug | none | no |
| 2 | #2102 beta-slug | none | no |
| 3 | #2103 gamma-slug | none | no |
| 4 | #2104 delta-slug | none | no |
'

triage_report() {  # $@ = "PR BUCKET ACTION" triples, one per argument
    printf '%-8s %-18s %-24s\n' "PR#" "BUCKET" "NEXT-ACTION"
    printf -- '-------- ------------------ ------------------------\n'
    local t
    for t in "$@"; do
        # shellcheck disable=SC2086
        set -- $t
        printf '%-8s %-18s %-24s\n' "#$1" "$2" "$3"
    done
}

# Two distinct 40-hex tree SHAs. TREE_A is "the tree /pr-ready reviewed"; TREE_B is any
# other tree, used to stage the stale-verdict case.
TREE_A="1111111111111111111111111111111111111111"
TREE_B="2222222222222222222222222222222222222222"

# A sticky /pr-ready verdict comment. $1 = the reviewed-tree SHA recorded on line 1,
# $2 = the verdict line verbatim (default `**READY**`).
#
# The `Phase 6 initial verdict: NOT READY` line is part of the fixture ON PURPOSE, not
# noise: real READY bodies narrate the findings remediation then fixed — PR #2144 carries
# "Phase 6 returned **NOT READY** (one blocking finding F1...)" and PR #2160 carries
# "**Initial verdict: NOT READY**", both above a final READY verdict. A body-wide grep for
# "NOT READY" would reject both. This fixture is what holds the driver to the anchored,
# last-match rule instead.
verdict_comment() {
    local tree="$1" line="${2:-**READY**}"
    cat <<VC_EOF
**Reviewed tree:** $tree
\`covers head e583673dbf0a · master ffb6d1995a95 · written 2026-09-07T22:30Z\`

### Rebase
onto master, no conflicts.

### Plan fidelity
**Phase 6 initial verdict: NOT READY** — one blocking finding, fixed by Phase 6.5.

### Merge digest
**What changed:** the driver landed
**Why:** because the loop was manual
**Watch:** the ledger
**Touches:** bin/pr-cycle
**Machine-authored fixes:** none

---

$line

<!-- pr-ready-verdict -->
VC_EOF
}

# Stage a verdict for PR $1 across the verdict pre-read (`--json comments,headRefOid`)
# plus the head commit's tree lookup.
#   $2 = reviewed-tree SHA recorded in the comment
#   $3 = the head's ACTUAL tree (default: equal to $2, i.e. the verdict is current)
#   $4 = the verdict line (default `**READY**`)
# The oid is derived from the PR number so three PRs in one case get three tree fixtures.
install_verdict() {
    local n="$1" rtree="$2" htree="${3:-$2}" line="${4:-**READY**}" body oid
    oid="deadbeefcafe$(printf '%028d' "$n")"
    body="$(verdict_comment "$rtree" "$line")"
    printf '{"comments":[{"body":%s}],"headRefOid":"%s"}' \
        "$(printf '%s' "$body" | jq -Rs .)" "$oid" > "$SCRATCH/verdictview-$n.json"
    printf '%s\n' "$htree" > "$SCRATCH/tree-$oid"
}

reset_state() {
    rm -f "$SCRATCH"/*.argv "$SCRATCH"/attack-* "$SCRATCH"/ready-* "$SCRATCH"/triage-* \
          "$SCRATCH"/dm-* "$SCRATCH"/state-* \
          "$SCRATCH"/verdictview-*.json "$SCRATCH"/tree-* "$SCRATCH"/gh-fail-verdict \
          "$SCRATCH"/prlist.tsv "$SCRATCH"/gh-fail-prlist
    rm -f "$SCRATCH/.ibl5-pr-cycle.stop"
    rm -rf "/tmp/pr-cycle-$TSBASE"* 2>/dev/null
    rm -f "/tmp/pr-cycle-$TSBASE"*.sh "/tmp/pr-cycle-$TSBASE"*.log 2>/dev/null
    rm -f "$SCRATCH/Library/LaunchAgents"/com.ibl5.pr-cycle-*.plist 2>/dev/null
    clear_live_labels
    : > "$SCRATCH/attack.argv"; : > "$SCRATCH/ready.argv"
    : > "$SCRATCH/triage.argv"; : > "$SCRATCH/dm.argv"
    : > "$SCRATCH/gh.argv";     : > "$SCRATCH/launchctl.argv"
}

# Run the driver in a sealed environment. $1 = cwd, rest = argv.
OUT=""; ERR=""; RC=0
run_in() {
    local cwd="$1"; shift
    # PR_CYCLE_RESCUE is passed through ONLY when the caller set it, so a test can distinguish
    # unset (seam absent) from empty (seam present but blank) — `env VAR=$X` cannot express that.
    local -a extra=()
    [[ -n "${RESCUE+x}" ]] && extra+=("PR_CYCLE_RESCUE=$RESCUE")
    [[ -n "${SKIPARM+x}" ]] && extra+=("PR_CYCLE_SKIP_READY_WHEN_ARMABLE=$SKIPARM")
    ERR="$SCRATCH/last.err"
    OUT="$(cd "$cwd" && env HOME="$SCRATCH" PATH="$BIN:$PATH" "${extra[@]+"${extra[@]}"}" \
        PR_CYCLE_ATTACK_CMD="$BIN/attack" \
        PR_CYCLE_TRIAGE_CMD="$BIN/triage" \
        PR_CYCLE_READY_CMD="$BIN/ready" \
        PR_CYCLE_DM_CMD="$BIN/dm" \
        PR_CYCLE_GH_CMD="$BIN/gh" \
        PR_CYCLE_MAIN_CHECKOUT="${MAIN_OVERRIDE-$MAIN}" \
        PR_CYCLE_STOP_FILE="$SCRATCH/.ibl5-pr-cycle.stop" \
        PR_CYCLE_TS="${TSPIN:-$TSBASE}" \
        "$DRIVER" "$@" 2>"$ERR")"
    RC=$?
    return 0
}
run() { run_in "$REPO" "$@"; }

calls() { wc -l < "$SCRATCH/$1.argv" | tr -d ' '; }
# Poll/reconcile gh calls only. The driver also calls gh to read a PR's sticky verdict, so
# a bare `calls gh` no longer isolates the merge-poll loop the ceiling cases are about.
state_calls() { grep -c -- '--json state' "$SCRATCH/gh.argv" || true; }
# Count of triage invocations that actually ARM. The read-only pre-read shares this shim,
# so a bare `calls triage` no longer distinguishes "did not arm" from "did not run".
arm_calls() { grep -c -- '--arm' "$SCRATCH/triage.argv" 2>/dev/null || true; }
# Confirmed-merge count for the run just made. The ledger file this used to read is gone;
# `ledgered.txt` in the rundir is the same bookkeeping the driver counts $MERGES from, and
# `reset_state` already clears /tmp/pr-cycle-$TSBASE* between cases. `_worker` creates the
# file with `: >`, so "no file" is genuinely zero merges and not a masked error.
merges() {
    grep -oE 'armed [0-9]+' <<< "$OUT" | tail -1 | grep -oE '[0-9]+' || echo 0
}

# ==========================================================================================
# 1 — flag validation
# ==========================================================================================
begin_case
reset_state
run --help
[[ $RC -eq 0 ]] || fail "--help exit $RC"
for f in -- --go --dry-run --stop --no-dm --max-ready --jobs --only --skip --help; do
    [[ "$f" == "--" ]] && continue
    grep -qF -- "$f" <<< "$OUT" || fail "--help omits $f"
done
grep -qF 'PR_CYCLE_SKIP_READY_WHEN_ARMABLE' <<< "$OUT" \
    || fail "--help omits the PR_CYCLE_SKIP_READY_WHEN_ARMABLE seam"
grep -qF 'PR_CYCLE_LOG' <<< "$OUT" \
    || fail "--help truncated: the trailing PR_CYCLE_LOG seam line is missing"
grep -qF 'judged-empty form' <<< "$OUT" \
    || fail "--help omits the gate-nominee handling note"
for bad in "--nope" "--max-ready 0" "--max-ready -1" "--max-ready abc" "--max-ready" \
           "--jobs 0" "--jobs abc" "--jobs" "--max-merges 5" "--go --stop" \
           "--only" "--only abc" "--only 0" "--only 007" "--only -1" "--only 101 --skip 102" \
           "--skip" "--skip abc" "--skip 1,x"; do
    # shellcheck disable=SC2086
    run $bad
    [[ $RC -eq 2 ]] || fail "'$bad' exit $RC, want 2"
done
# Quoted separately: these arguments must reach the driver intact, and `run $bad` above
# word-splits, so a lone `#` or `,` cannot be expressed in that list.
run --only '#'
[[ $RC -eq 2 ]] || fail "'--only #' exit $RC, want 2"
run --only ','
[[ $RC -eq 2 ]] || fail "'--only ,' exit $RC, want 2"
run --only ''
[[ $RC -eq 2 ]] || fail "'--only \"\"' exit $RC, want 2"
# Accepted forms. --help short-circuits before any work, so this asserts parsing only.
for good in "--only 101" "--only 101,102" "--skip 101,102"; do
    # shellcheck disable=SC2086
    run $good --help
    [[ $RC -eq 0 ]] || fail "'$good' exit $RC, want 0"
done
run --only '#101,#102' --help
[[ $RC -eq 0 ]] || fail "'--only #101,#102' exit $RC, want 0"
end_case "case 1 flag validation"

# ==========================================================================================
# 2 — main-checkout-only guard
# ==========================================================================================
begin_case
reset_state
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
run_in "$SCRATCH" --go
[[ $RC -eq 1 ]] || fail "outside any repo: exit $RC, want 1"
run_in "$SCRATCH"
[[ $RC -eq 1 ]] || fail "outside any repo (dry): exit $RC, want 1"

MAIN_OVERRIDE="$SCRATCH/somewhere-else" run_in "$REPO" --go
[[ $RC -eq 1 ]] || fail "toplevel mismatch: exit $RC, want 1"

if [[ -n "$WT_TOP" ]]; then
    MAIN_OVERRIDE="$WT_TOP" run_in "$WT" --go
    [[ $RC -eq 1 ]] || fail "worktree .git file accepted: exit $RC, want 1"
    grep -qF 'main checkout' "$ERR" || fail "worktree rejection lacks explanation"
else
    fail "worktree fixture missing"
fi
unset MAIN_OVERRIDE
end_case "case 2 main-checkout guard"

# ==========================================================================================
# 3 — live-session guard (SIGPIPE regression)
# ==========================================================================================
begin_case
reset_state
set_live_labels "-	0	com.ibl5.post-plan-fleet-20260101-000000"
run --go
[[ $RC -eq 1 ]] || fail "live post-plan-fleet label: exit $RC, want 1"
set_live_labels "-	0	com.ibl5.pr-cycle-20260101-000000"
run --go
[[ $RC -eq 1 ]] || fail "live pr-cycle label: exit $RC, want 1"
# --worker is the running session itself: the liveness guard must NOT fire against its own
# label. Without the WORKER=0 guard the worker exits 1 immediately, making every --go fail.
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 NEEDS-WORK rebase" > "$SCRATCH/triage-out"
run --worker
[[ $RC -eq 0 ]] || fail "--worker with own live label: exit $RC, want 0 (liveness guard must not block the worker)"
clear_live_labels
run --help
[[ $RC -eq 0 ]] || fail "no live label should not block"
end_case "case 3 live-session guard"

# ==========================================================================================
# 4 — --stop
# ==========================================================================================
begin_case
reset_state
echo 3 > "$SCRATCH/ready-rc"
run --stop
[[ $RC -eq 3 ]] || fail "--stop should propagate the ready exit status, got $RC"
[[ -e "$SCRATCH/.ibl5-pr-cycle.stop" ]] || fail "--stop left no stop file after a failing --stop-all"
grep -qx -- '--stop-all' "$SCRATCH/ready.argv" || fail "--stop did not call the ready tool with --stop-all"
end_case "case 4 stop"


# ==========================================================================================
# 6 — gate nominees force a second, exactly-shaped pr-attack call
# ==========================================================================================
begin_case
reset_state
cat > "$SCRATCH/attack-out-1" <<'NOM_EOF'
### #999 dangling-gate
WORK=decoy-must-be-ignored
Nominated for a gate edge; unjudged.
WORK=abc123
NOM_EOF
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out-2"
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
triage_report "101 NEEDS-WORK rebase" "102 NEEDS-WORK rebase" "103 NEEDS-WORK rebase" \
    > "$SCRATCH/triage-out"
run --worker
[[ "$(sed -n '1p' "$SCRATCH/attack.argv")" == "--gate-candidates" ]] \
    || fail "first attack call: $(sed -n '1p' "$SCRATCH/attack.argv")"
[[ "$(sed -n '2p' "$SCRATCH/attack.argv")" == "--work abc123 --gate-edges /dev/null" ]] \
    || fail "second attack call: $(sed -n '2p' "$SCRATCH/attack.argv")"
grep -qF '#999 dangling-gate — ordered with no gate edges (gate nominee, judged-empty)' <<< "$OUT" \
    || fail "gate nominee log line missing or misworded: $(grep -F '#999' <<< "$OUT")"
! grep -qF 'excluded this run' <<< "$OUT" \
    || fail "driver still claims nominees are excluded; --gate-edges /dev/null re-admits every one"
[[ "$(calls ready)" == "1" ]] || fail "want 1 fleet call after nominee re-admission, got $(calls ready)"
_a6="$(sed -n '1p' "$SCRATCH/ready.argv")"
[[ "$_a6" == *'101'*'102'*'103'* ]] || fail "case 6: all 3 PRs not in --pr-list: $_a6"
end_case "case 6 gate nominees"

# ==========================================================================================
# 7 — pr-attack failure handling
# ==========================================================================================
begin_case
reset_state
echo 1 > "$SCRATCH/attack-rc"
run --worker
[[ $RC -eq 1 ]] || fail "attack exit 1 should halt with 1, got $RC"
[[ "$(calls ready)" == "0" ]] || fail "attack exit 1 still readied"
[[ "$(calls triage)" == "0" ]] || fail "attack exit 1 still armed"

reset_state
cat > "$SCRATCH/attack-out" <<'NOM_EOF'
### #999 dangling-gate
WORK=abc123
NOM_EOF
echo 3 > "$SCRATCH/attack-rc-2"
echo 3 > "$SCRATCH/attack-rc-4"
run --worker
[[ $RC -eq 1 ]] || fail "two stale WORKs should halt with 1, got $RC"
[[ "$(calls attack)" == "4" ]] || fail "want 4 attack calls (retried once), got $(calls attack)"
grep -qF 'stale' <<< "$OUT" || fail "stale retry was not reported"
end_case "case 7 attack failures"


# ==========================================================================================
# 10 — a stop file created during readying blocks the arm in that same iteration
# ==========================================================================================
begin_case
reset_state
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
echo ': > "$S/.ibl5-pr-cycle.stop"' > "$SCRATCH/ready-hook-1"
run --worker
[[ $RC -eq 0 ]] || fail "a stop is an intended termination, want 0, got $RC"
[[ "$(calls ready)" == "1" ]] || fail "want 1 ready before the stop, got $(calls ready)"
[[ "$(arm_calls)" == "0" ]] || fail "arm ran despite the stop file"

# stop-before-fire: triage-hook-1 creates stop during precheck => fleet never called
reset_state
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
echo ': > "$S/.ibl5-pr-cycle.stop"' > "$SCRATCH/triage-hook-1"
run --worker
[[ $RC -eq 0 ]] || fail "stop-before-fire: want 0, got $RC"
[[ "$(calls ready)" == "0" ]] || fail "stop-before-fire: fleet called despite stop, got $(calls ready)"
end_case "case 10 stop during readying"

# ==========================================================================================
# 11 — non-ARMABLE and absent buckets skip polling; the separator is never an armed PR
# ==========================================================================================
begin_case
reset_state
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
triage_report "101 NEEDS-WORK rebase" > "$SCRATCH/triage-out"   # 102 and 103 absent entirely
echo MERGED > "$SCRATCH/state-101"
run --worker
[[ $RC -eq 0 ]] || fail "non-armable run exit $RC, want 0"
[[ "$(calls ready)" == "1" ]] || fail "run stopped early or batched wrong: $(calls ready) ready calls"
[[ "$(state_calls)" == "0" ]] || fail "polled despite no ARMABLE row: $(state_calls) state calls"
grep -qE 'armed 0[^0-9]' <<< "$OUT" || fail "absent PRs were counted as armed"
end_case "case 11 non-armable and absent"

# --- rescue: baseline characterization -----------------------------------------------------
# Passes BEFORE the rescue path exists (the driver ignores an unknown seam) and AFTER it
# exists (the kill switch is honored). That dual property is what makes it a characterization.
begin_case
reset_state
printf '%s' "$ATTACK_EXCLUDED" > "$SCRATCH/attack-out"
triage_report "101 NEEDS-WORK rebase" > "$SCRATCH/triage-out"
RESCUE=0 run --worker
[[ $RC -eq 0 ]] || fail "rescue-off run exit $RC, want 0"
[[ "$(calls ready)" == "1" ]] || fail "rescue-off run made $(calls ready) ready calls, want 1"
grep -qF '101' <<< "$(sed -n '1p' "$SCRATCH/ready.argv")" || fail "the one orderable PR was not in --pr-list"
for n in 201 202 203 204 205; do
    grep -qF "$n" <<< "$(sed -n '1p' "$SCRATCH/ready.argv")" \
        && fail "excluded #$n appeared in --pr-list with rescue off"
done
[[ "$(state_calls)" == "0" ]] || fail "polled with no ARMABLE row: $(state_calls) state calls"
end_case "case 11a rescue off leaves excluded PRs untouched"

# ==========================================================================================
# 33 — DIRTY PRs join the stage-1 batch; rescue honours scope and slot guard
# ==========================================================================================
begin_case
reset_state
printf '%s' "$ATTACK_2PR_EXCLUDED" > "$SCRATCH/attack-out"
triage_report "2101 NEEDS-WORK rebase" "2102 NEEDS-WORK rebase" > "$SCRATCH/triage-out"
run --worker
[[ $RC -eq 0 ]] || fail "case 33 baseline exit $RC, want 0"
[[ "$(calls ready)" == "1" ]] || fail "case 33: want 1 fleet call, got $(calls ready)"
# 2101 and 2102 (ordered) + 2201 (DIRTY rescue) — in that order. 2202 (DRAFT) is absent.
grep -qF '2101' <<< "$(sed -n '1p' "$SCRATCH/ready.argv")" || fail "case 33: 2101 missing from --pr-list"
grep -qF '2102' <<< "$(sed -n '1p' "$SCRATCH/ready.argv")" || fail "case 33: 2102 missing from --pr-list"
grep -qF '2201' <<< "$(sed -n '1p' "$SCRATCH/ready.argv")" || fail "case 33: 2201 (DIRTY) missing from --pr-list"
grep -qF '2202' <<< "$(sed -n '1p' "$SCRATCH/ready.argv")" && fail "case 33: 2202 (DRAFT) must not appear"
# Ordered PRs come first in the list; DIRTY rescue appended after.
_a1="$(sed -n '1p' "$SCRATCH/ready.argv")"
[[ "$_a1" == *'2101'*'2102'* ]] || fail "case 33: ordered 2101,2102 must precede 2201"

# With RESCUE=0: only ordered rows.
reset_state
printf '%s' "$ATTACK_2PR_EXCLUDED" > "$SCRATCH/attack-out"
triage_report "2101 NEEDS-WORK rebase" "2102 NEEDS-WORK rebase" > "$SCRATCH/triage-out"
RESCUE=0 run --worker
grep -qF '2201' <<< "$(sed -n '1p' "$SCRATCH/ready.argv")" && fail "case 33 RESCUE=0: 2201 appeared despite rescue off"
_a1r0="$(sed -n '1p' "$SCRATCH/ready.argv")"
grep -qF '2101' <<< "$_a1r0" || fail "case 33 RESCUE=0: 2101 missing"
grep -qF '2102' <<< "$_a1r0" || fail "case 33 RESCUE=0: 2102 missing"

# With 2201 slot live: 2201 absent from the batch; worker logs the slot skip.
# Dry-run is skipped here: the live-session guard blocks non-worker runs when any
# post-plan-fleet slot is active (case 3 tests that property).
reset_state
printf '%s' "$ATTACK_2PR_EXCLUDED" > "$SCRATCH/attack-out"
triage_report "2101 NEEDS-WORK rebase" "2102 NEEDS-WORK rebase" > "$SCRATCH/triage-out"
set_live_labels "-	0	com.ibl5.post-plan-fleet-2201"
run --worker
grep -qF '2201' <<< "$(sed -n '1p' "$SCRATCH/ready.argv")" && fail "case 33 slot: 2201 appeared despite live slot"
grep -qF 'slot already live' <<< "$OUT" || fail "case 33 slot: slot skip not logged in worker output"
clear_live_labels

# With --max-ready 2: 2201 capped out; ordered PRs win.
reset_state
printf '%s' "$ATTACK_2PR_EXCLUDED" > "$SCRATCH/attack-out"
triage_report "2101 NEEDS-WORK rebase" "2102 NEEDS-WORK rebase" > "$SCRATCH/triage-out"
run --worker --max-ready 2
_a1cap="$(sed -n '1p' "$SCRATCH/ready.argv")"
grep -qF '2101' <<< "$_a1cap" || fail "case 33 cap: 2101 missing"
grep -qF '2102' <<< "$_a1cap" || fail "case 33 cap: 2102 missing"
grep -qF '2201' <<< "$_a1cap" && fail "case 33 cap: 2201 should be capped out with --max-ready 2"
end_case "case 33 DIRTY joins the batch"

# --- 11e: only DIRTY is eligible; unset and empty seam values BOTH mean enabled ---------------
begin_case
reset_state
