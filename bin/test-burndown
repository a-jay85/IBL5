    && ok "C25: items length=5" || fail "C25: items length=5"
jq -e '[.items[].status] | all(. == "picked")' "$C25_LEDGER_PATH" >/dev/null 2>&1 \
    && ok "C25: all status=picked" || fail "C25: all status=picked"
jq -e '[.items[].route] | all(. == "")' "$C25_LEDGER_PATH" >/dev/null 2>&1 \
    && ok "C25: all route empty" || fail "C25: all route empty"

