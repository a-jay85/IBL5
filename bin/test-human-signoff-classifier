run_approval synchronize "" not-ui "" "$A" "$REC"; rc=$?
expect "hs_not_ui_passes -> rc 0" 0 "$rc"
want hs_not_ui_passes "$LAST_OUT" "VERDICT=pass"

# hs_ui_without_label_holds: CSS paths flow through ui_decide, then the verdict
# goes to hs_eval_approval with no label.
HS_UI_PATHS="$T/hs-ui-paths.txt"
