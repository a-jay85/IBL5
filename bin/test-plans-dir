#!/usr/bin/env bash
# bin/test-plans-dir — unit tests for plans_dir in bin/lib/plan-resolve.sh, and the
# real resolution lines of its callers.
#
# Run: bin/test-plans-dir

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
export HOME="$TMP/home"; mkdir -p "$HOME"          # env -i has no HOME; set it before sourcing
unset PLAN_DIR PLANS_DIR PLAN_NOW_PLANS_DIR BUG_PIPELINE_PLANS_DIR
# shellcheck source=lib/plan-resolve.sh
source "$ROOT/bin/lib/plan-resolve.sh"
SEAMS="PLAN_DIR PLANS_DIR PLAN_NOW_PLANS_DIR BUG_PIPELINE_PLANS_DIR"
# Fresh subshell with all four seams cleared; each case then sets only what it tests.
clean() { ( unset $SEAMS; "$@" ); }

PASS=0
FAIL=0

check() {
    local name="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        PASS=$((PASS + 1))
        echo "  ok   $name"
    else
        FAIL=$((FAIL + 1))
        echo "  FAIL $name"
        echo "       expected: [$expected]"
        echo "       actual:   [$actual]"
    fi
}

DEFAULT="$HOME/claude-plans"

echo "test-plans-dir"

# --- 1. Preflight: the function exists ---------------------------------------
declare -F plans_dir >/dev/null 2>&1; rc=$?
check "1 plans_dir is defined" "0" "$rc"

# --- 2. No-arg form ignores every seam ---------------------------------------
out="$( for s in $SEAMS; do export "$s=/tmp/junk-$s"; done; plans_dir 2>&1 )"
check "2 no-arg ignores all seams" "$DEFAULT" "$out"

# --- 3-5. Each seam: override, unset, empty -----------------------------------
for s in $SEAMS; do
    out="$( unset $SEAMS; export "$s=/tmp/over-$s"; plans_dir "$s" 2>&1 )"
    check "3 $s overrides" "/tmp/over-$s" "$out"
    out="$( unset $SEAMS; plans_dir "$s" 2>&1 )"
    check "4 $s unset falls back" "$DEFAULT" "$out"
    out="$( unset $SEAMS; export "$s="; plans_dir "$s" 2>&1 )"
    check "5 $s empty falls back" "$DEFAULT" "$out"
done

# --- 6. Isolation, positive ---------------------------------------------------
for s in $SEAMS; do
    out="$( for t in $SEAMS; do export "$t=/tmp/val-$t"; done; plans_dir "$s" 2>&1 )"
    check "6 $s returns only its own value" "/tmp/val-$s" "$out"
done

# --- 7. Isolation, negative (leak check) --------------------------------------
for s in PLAN_NOW_PLANS_DIR BUG_PIPELINE_PLANS_DIR PLAN_DIR; do
    out="$( unset $SEAMS; export PLANS_DIR=/tmp/leak; plans_dir "$s" 2>&1 )"
    check "7 PLANS_DIR does not leak into $s" "$DEFAULT" "$out"
done

# --- 8. Multiple seams: first non-empty wins ----------------------------------
out="$( unset $SEAMS; export PLAN_DIR=/tmp/a PLANS_DIR=/tmp/b; plans_dir PLAN_DIR PLANS_DIR 2>&1 )"
check "8 both set: first wins" "/tmp/a" "$out"
out="$( unset $SEAMS; export PLAN_DIR='' PLANS_DIR=/tmp/b; plans_dir PLAN_DIR PLANS_DIR 2>&1 )"
check "8 first empty: second wins" "/tmp/b" "$out"
out="$( unset $SEAMS; export PLANS_DIR=/tmp/b; plans_dir PLAN_DIR PLANS_DIR 2>&1 )"
check "8 first unset: second wins" "/tmp/b" "$out"
out="$( unset $SEAMS; export PLAN_DIR='' PLANS_DIR=''; plans_dir PLAN_DIR PLANS_DIR 2>&1 )"
check "8 both empty: default" "$DEFAULT" "$out"
out="$( unset $SEAMS; plans_dir PLAN_DIR PLANS_DIR 2>&1 )"
check "8 both unset: default" "$DEFAULT" "$out"

# --- 9. HOME is read at call time ---------------------------------------------
out="$( export HOME="$TMP/h1"; source "$ROOT/bin/lib/plan-resolve.sh"; export HOME="$TMP/h2"; unset $SEAMS; plans_dir 2>&1 )"
check "9 HOME read at call time" "$TMP/h2/claude-plans" "$out"

# --- 10. set -u safety --------------------------------------------------------
out="$( set -u; unset HOME $SEAMS; export PLANS_DIR=/tmp/p; plans_dir PLANS_DIR 2>&1 )"; rc=$?
check "10 HOME unset with seam set: value" "/tmp/p" "$out"
check "10 HOME unset with seam set: rc" "0" "$rc"

# --- 11. Verbatim values ------------------------------------------------------
out="$( unset $SEAMS; export PLANS_DIR='/tmp/a b'; plans_dir PLANS_DIR 2>&1 )"
check "11 space preserved" "/tmp/a b" "$out"
out="$( unset $SEAMS; export PLANS_DIR='/tmp/a/'; plans_dir PLANS_DIR 2>&1 )"
check "11 trailing slash preserved" "/tmp/a/" "$out"

# --- 12. Invalid seam name is a loud error ------------------------------------
for bad in '' 1bad a-b; do
    stdout="$( plans_dir "$bad" 2>"$TMP/err" )"; rc=$?
    check "12 '$bad' rc" "2" "$rc"
    check "12 '$bad' stdout empty" "" "$stdout"
    err="$(cat "$TMP/err")"
    check "12 '$bad' stderr names plans_dir" "plans_dir: invalid seam variable name: $bad" "$err"
done

# --- 13. Bash 3.2 guard -------------------------------------------------------
BODY="$(awk '/^plans_dir\(\) \{/,/^}/' "$ROOT/bin/lib/plan-resolve.sh")"
for banned in 'local -n' 'declare -n' 'declare -A' 'typeset -n'; do
    hit=0; case "$BODY" in *"$banned"*) hit=1 ;; esac
    check "13 body has no '$banned'" "0" "$hit"
done
hit=0; case "$BODY" in *'${!'*) hit=1 ;; esac
check "13 body uses \${! indirection" "1" "$hit"

# --- 14. File-scope pin: PLAN_DIR after sourcing ------------------------------
out="$( env -i PATH="$PATH" HOME="$HOME" bash -c 'source "$1"; printf %s "$PLAN_DIR"' _ "$ROOT/bin/lib/plan-resolve.sh" )"
check "14 PLAN_DIR unset -> default" "$DEFAULT" "$out"
out="$( env -i PATH="$PATH" HOME="$HOME" PLAN_DIR=/tmp/pre bash -c 'source "$1"; printf %s "$PLAN_DIR"' _ "$ROOT/bin/lib/plan-resolve.sh" )"
check "14 PLAN_DIR preset kept" "/tmp/pre" "$out"
out="$( env -i PATH="$PATH" HOME="$HOME" PLAN_DIR= bash -c 'source "$1"; printf %s "$PLAN_DIR"' _ "$ROOT/bin/lib/plan-resolve.sh" )"
check "14 PLAN_DIR empty -> default" "$DEFAULT" "$out"

# --- 15. Static wiring: each caller names its own seam, no old fallback remains ---
for spec in "bin/lib/plan-resolve.sh:plans_dir PLAN_DIR" \
            "bin/plan-dup-check:plans_dir PLANS_DIR" \
            "bin/plan-now:plans_dir PLAN_NOW_PLANS_DIR" \
            "bin/bug-pipeline-tick:plans_dir BUG_PIPELINE_PLANS_DIR"; do
    f="${spec%%:*}"; call="${spec#*:}"
    check "15 $f has one '$call'" "1" "$(grep -cF "$call" "$ROOT/$f")"
    check "15 $f has no old :-/:= \$HOME/claude-plans fallback" "0" \
        "$(grep -cE '[:][-=]\$HOME/claude-plans' "$ROOT/$f")"
done
for f in bin/plan-dup-check bin/plan-now bin/bug-pipeline-tick; do
    check "15 $f sources plan-resolve.sh once" "1" \
        "$(grep -cE '^(\.|source)[[:space:]].*lib/plan-resolve\.sh' "$ROOT/$f")"
done

# --- 16. Line-eval: the shipped resolution line of each caller ------------------
# eval_line FILE SEAM MODE -> prints PLANS_DIR after evaluating the script's real line.
#   MODE: set (SEAM=/tmp/s), unset, empty (SEAM=''), others (SEAM unset, other three junk)
eval_line() {
    local file="$1" seam="$2" mode="$3" line s
    line="$(grep -m1 -E '^PLANS_DIR=' "$ROOT/$file" || true)"
    (
        unset $SEAMS
        case "$mode" in
            set)    export "$seam=/tmp/s" ;;
            empty)  export "$seam=" ;;
            others) for s in $SEAMS; do [ "$s" = "$seam" ] || export "$s=/tmp/junk-$s"; done ;;
        esac
        eval "$line"
        printf '%s\n' "${PLANS_DIR-}"
    )
}
for spec in "bin/plan-dup-check:PLANS_DIR" "bin/plan-now:PLAN_NOW_PLANS_DIR" \
            "bin/bug-pipeline-tick:BUG_PIPELINE_PLANS_DIR"; do
    f="${spec%%:*}"; s="${spec#*:}"
    check "16 $f: $s set wins" "/tmp/s" "$(eval_line "$f" "$s" set)"
    check "16 $f: $s unset -> default" "$DEFAULT" "$(eval_line "$f" "$s" unset)"
    check "16 $f: $s empty -> default" "$DEFAULT" "$(eval_line "$f" "$s" empty)"
    check "16 $f: other seams do not leak" "$DEFAULT" "$(eval_line "$f" "$s" others)"
done

# --- 17. Real bin/plan-dup-check runs ------------------------------------------
printf 'Do a thing.\nbranch slug `demo-slug`\n' > "$TMP/prompt.md"
mkdir -p "$TMP/n" "$TMP/p" "$TMP/home17"
: > "$TMP/p/demo-slug.md"
out="$(env -i PATH="$PATH" HOME="$TMP/home17" NIGHTLY_DIR="$TMP/n" PLANS_DIR="$TMP/p" \
        bash "$ROOT/bin/plan-dup-check" "$TMP/prompt.md" 2>&1)"; rc=$?
check "17a PLANS_DIR holds slug: rc" "3" "$rc"
check "17a PLANS_DIR holds slug: names path" "yes" \
    "$(grep -qF "$TMP/p/demo-slug.md" <<<"$out" && echo yes || echo no)"
out="$(env -i PATH="$PATH" HOME="$TMP/home17" NIGHTLY_DIR="$TMP/n" PLAN_DIR="$TMP/p" \
        PLAN_NOW_PLANS_DIR="$TMP/p" BUG_PIPELINE_PLANS_DIR="$TMP/p" \
        bash "$ROOT/bin/plan-dup-check" "$TMP/prompt.md" 2>&1)"; rc=$?
check "17b other callers' seams ignored: rc" "0" "$rc"
check "17b other callers' seams ignored: stdout" "" "$out"
mkdir -p "$TMP/home17/claude-plans"; : > "$TMP/home17/claude-plans/demo-slug.md"
out="$(env -i PATH="$PATH" HOME="$TMP/home17" NIGHTLY_DIR="$TMP/n" PLANS_DIR= \
        bash "$ROOT/bin/plan-dup-check" "$TMP/prompt.md" 2>&1)"; rc=$?
check "17c empty PLANS_DIR uses HOME default: rc" "3" "$rc"
check "17c empty PLANS_DIR uses HOME default: names path" "yes" \
    "$(grep -qF "$TMP/home17/claude-plans/demo-slug.md" <<<"$out" && echo yes || echo no)"
out="$(env -i PATH="$PATH" NIGHTLY_DIR="$TMP/n" PLANS_DIR="$TMP/p" \
        bash "$ROOT/bin/plan-dup-check" "$TMP/prompt.md" 2>&1)"; rc=$?
check "17d HOME unset with seam set: rc" "3" "$rc"
err="$(env -i PATH="$PATH" HOME="$TMP/home17" bash "$ROOT/bin/plan-dup-check" "$TMP/nope.md" 2>&1 >/dev/null)"; rc=$?
check "17e missing prompt: rc" "2" "$rc"
check "17e missing prompt: usage line" "plan-dup-check: usage: plan-dup-check <prompt-file>" "$err"

# --- 18. bin/plan-now dry run never creates a leaked PLANS_DIR -----------------
printf '#!/bin/sh\nexit 0\n' > "$TMP/stub"; chmod +x "$TMP/stub"
mkdir -p "$TMP/shim"; printf '#!/bin/sh\nexit 1\n' > "$TMP/shim/security"; chmod +x "$TMP/shim/security"
printf '/plan Do a thing.\nbranch slug `demo-slug`\n' > "$TMP/plan-prompt.md"
plan_now_dry() {   # HOME_DIR [extra env assignments...] -> prints runner path
    local home_dir="$1"; shift
    mkdir -p "$home_dir"
    ( cd "$ROOT" && env -i PATH="$TMP/shim:$PATH" HOME="$home_dir" NIGHTLY_DIR="$TMP/n" \
        IBL5_USAGE_GATE_STATE_DIR="$TMP/gate" PLAN_NOW_DRY_RUN=1 PLAN_NOW_CLAUDE="$TMP/stub" \
        PLAN_NOW_DISCORD_DM="$TMP/stub" PLAN_NOW_AUTOMOUSE_QUEUE="$TMP/stub" "$@" \
        bin/plan-now --implement --no-dm "$TMP/plan-prompt.md" 2>&1 )
}
cleanup_runner() { local r="$1"; [ -n "$r" ] && rm -f "${r%.sh}".*; }
dry="$(plan_now_dry "$TMP/home18a" PLAN_NOW_PLANS_DIR="$TMP/pn" PLANS_DIR="$TMP/leak")"; rc=$?
runner="$(sed -n 's/^  runner: //p' <<<"$dry")"
check "18a dry run rc" "0" "$rc"
check "18a PLAN_NOW_PLANS_DIR created" "1" "$([ -d "$TMP/pn" ] && echo 1 || echo 0)"
check "18a PLANS_DIR leak dir not created" "0" "$([ -e "$TMP/leak" ] && echo 1 || echo 0)"
check "18a runner PLANS_DIR= names PLAN_NOW_PLANS_DIR" "1" \
    "$([ -f "$runner" ] && grep '^PLANS_DIR=' "$runner" | grep -cF "$TMP/pn")"
cleanup_runner "$runner"
dry="$(plan_now_dry "$TMP/home18b" PLANS_DIR="$TMP/leak")"; rc=$?
runner="$(sed -n 's/^  runner: //p' <<<"$dry")"
check "18b dry run rc" "0" "$rc"
check "18b HOME default created" "1" "$([ -d "$TMP/home18b/claude-plans" ] && echo 1 || echo 0)"
check "18b PLANS_DIR leak dir not created" "0" "$([ -e "$TMP/leak" ] && echo 1 || echo 0)"
cleanup_runner "$runner"

# --- 19. File-scope guard: sourcing never aborts on an unset HOME ---------------
out="$(env -i PATH="$PATH" bash -c 'set -euo pipefail; source "$1"; printf "%s" "${PLAN_DIR-unset}"' \
        _ "$ROOT/bin/lib/plan-resolve.sh" 2>&1)"; rc=$?
check "19 HOME unset: sourcing rc" "0" "$rc"
check "19 HOME unset: PLAN_DIR empty" "" "$out"
out="$(env -i PATH="$PATH" HOME="$TMP/home" bash -c 'set -euo pipefail; source "$1"; printf "%s" "${PLAN_DIR-unset}"' \
        _ "$ROOT/bin/lib/plan-resolve.sh" 2>&1)"
check "19 HOME set: PLAN_DIR is the default" "$TMP/home/claude-plans" "$out"

# --- 20. Phase 3 wiring: no hardcoded default left outside plans_dir ----------
code_hits() { grep -vE '^[[:space:]]*#' "$ROOT/$1" | grep -cE '\$\{?HOME\}?/claude-plans'; }
for f in bin/post-plan-now bin/docfix-run bin/post-plan-fleet; do
    check "20 $f has no \$HOME/claude-plans code line" "0" "$(code_hits "$f")"
    check "20 $f sources plan-resolve.sh once" "1" \
        "$(grep -cE '^(\.|source)[[:space:]].*lib/plan-resolve\.sh' "$ROOT/$f")"
done
total=0
for f in bin/lib/plan-resolve.sh bin/plan-dup-check bin/plan-now bin/bug-pipeline-tick \
         bin/post-plan-now bin/docfix-run bin/post-plan-fleet; do
    total=$((total + $(code_hits "$f")))
done
check "20 exactly one \$HOME/claude-plans code line across the seven files" "1" "$total"
hit=0; case "$BODY" in *'$HOME/claude-plans'*) hit=1 ;; esac
check "20 that line sits inside plans_dir" "1" "$hit"
check "20 pr-creates-worktree fixture copies plan-resolve.sh" "yes" \
    "$(grep -qF 'plan-resolve.sh' "$ROOT/bin/test-post-plan-now-pr-creates-worktree" && echo yes || echo no)"

# --- 21-24. Line-eval of the Phase 3 callers (no seam: only HOME counts) ---------
junk_seams() { local s; for s in $SEAMS; do export "$s=$TMP/seam"; done; }
mkdir -p "$TMP/seam"; : > "$TMP/seam/demo.md"

line="$(grep -m1 '^PLAN_FILE=' "$ROOT/bin/post-plan-now" || true)"
check "21i PLAN_OVERRIDE wins verbatim" "/tmp/x.md" \
    "$( unset $SEAMS; SLUG=demo PLAN_OVERRIDE=/tmp/x.md; eval "$line"; printf '%s' "$PLAN_FILE" )"
check "21ii PLAN_OVERRIDE unset -> default" "$DEFAULT/demo.md" \
    "$( unset $SEAMS PLAN_OVERRIDE; SLUG=demo; eval "$line"; printf '%s' "$PLAN_FILE" )"
check "21iii PLAN_OVERRIDE empty -> default" "$DEFAULT/demo.md" \
    "$( unset $SEAMS; SLUG=demo PLAN_OVERRIDE=''; eval "$line"; printf '%s' "$PLAN_FILE" )"
check "21iv seam variables ignored" "$DEFAULT/demo.md" \
    "$( unset PLAN_OVERRIDE; junk_seams; SLUG=demo; eval "$line"; printf '%s' "$PLAN_FILE" )"
out="$(env -i PATH="$PATH" SLUG=demo PLAN_OVERRIDE=/tmp/x.md bash -c \
        'set -u; source "$1"; eval "$2"; printf %s "$PLAN_FILE"' _ "$ROOT/bin/lib/plan-resolve.sh" "$line" 2>&1)"; rc=$?
check "21v HOME unset with override: value" "/tmp/x.md" "$out"
check "21v HOME unset with override: rc" "0" "$rc"

line="$(grep -m1 '^PLAN_FILE=' "$ROOT/bin/docfix-run" || true)"
check "22 docfix-run PLAN_FILE default" "$DEFAULT/docs-stale-refresh-20260101.md" \
    "$( unset $SEAMS; SLUG=docs-stale-refresh-20260101; eval "$line"; printf '%s' "$PLAN_FILE" )"
check "22 docfix-run PLAN_FILE ignores seams" "$DEFAULT/docs-stale-refresh-20260101.md" \
    "$( junk_seams; SLUG=docs-stale-refresh-20260101; eval "$line"; printf '%s' "$PLAN_FILE" )"

line="$(grep -m1 -E '^[[:space:]]*rpath=' "$ROOT/bin/post-plan-fleet" || true)"
check "23 fleet report path default" "$DEFAULT/_reports/ibl5/firstpass/pr-firstpass-2026-01-01.md" \
    "$( unset $SEAMS; rpath=''; rdate=2026-01-01; eval "$line"; printf '%s' "$rpath" )"
check "23 fleet report path ignores seams" "$DEFAULT/_reports/ibl5/firstpass/pr-firstpass-2026-01-01.md" \
    "$( junk_seams; rpath=''; rdate=2026-01-01; eval "$line"; printf '%s' "$rpath" )"

line="$(grep -m1 -F 'p=PLAN' "$ROOT/bin/post-plan-fleet" || true)"
mkdir -p "$DEFAULT"; : > "$DEFAULT/demo.md"
check "24 fleet PLAN column: file present" "PLAN" \
    "$( unset $SEAMS; p=''; branch=demo; eval "$line"; printf '%s' "$p" )"
rm -f "$DEFAULT/demo.md"
check "24 fleet PLAN column: file absent" "" \
    "$( unset $SEAMS; p=''; branch=demo; eval "$line"; printf '%s' "$p" )"
check "24 fleet PLAN column: seam-only file ignored" "" \
    "$( junk_seams; p=''; branch=demo; eval "$line"; printf '%s' "$p" )"

# --- 25. Mutation guard: the indirection is load-bearing ---
# Shadow plans_dir with a mutated copy of its own body; the cases above must then fail.
MUT="$(sed 's/\${!_pd_name:-}/${_pd_name:-}/' <<<"$BODY")"
check "25 mutation drops the indirection" "1" "$([ "$MUT" != "$BODY" ] && echo 1 || echo 0)"
out="$( unset $SEAMS; eval "$MUT"; export PLANS_DIR=/tmp/over; plans_dir PLANS_DIR 2>&1 )"
check "25 without indirection the seam value is lost" "no" "$([ "$out" = /tmp/over ] && echo yes || echo no)"

echo ""
echo "$PASS passed, $FAIL failed"
[ "$FAIL" -eq 0 ]
