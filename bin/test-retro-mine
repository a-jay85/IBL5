case_tuneup_runlog_fail() {
    local t
    t="$(rm_tmp)"
    rm_tuneup_stubs "$t"
    echo "plan-now: RESULT failed rc=1" > "$t/tmplogs/plan-now-20260920-100000.log"
    echo "plan-now: RESULT ok" > "$t/tmplogs/plan-now-20260920-110000.log"
    echo "plan-now: RESULT no-plan" > "$t/tmplogs/plan-now-20260920-120000.log"
    echo "plan-now: RESULT failed rc=1" > "$t/tmplogs/plan-now-20260901-100000.log"
    printf 'RESULT: shipped\npostplan-rc=1\n' > "$t/tmplogs/post-plan-now-20260920-100000.log"
    printf 'RESULT: shipped\npostplan-rc=0\n' > "$t/tmplogs/post-plan-now-20260920-110000.log"
    echo "exit: stop_reason=max_turns" > "$t/amlogs/2026-09-20-slug.log"
    echo "exit: stop_reason=end_turn" > "$t/amlogs/2026-09-20-other.log"
    rm_tuneup_run "$t" --dry-run
    rm_has "tuneup_runlog_fail: three failing logs become headless threads" "$RM_OUT" "threads interactive=0 headless=3"
}

case_tuneup_max_threads_cap() {
    local t i
    t="$(rm_tmp)"
    rm_tuneup_stubs "$t"
    for i in $(seq 1 40); do rm_tuneup_thread "$t" "-w$i" "s$i" 3600; done
    rm_tuneup_run "$t" --dry-run
    rm_has "tuneup_max_threads_cap: 40 threads drop nothing" "$RM_OUT" "dropped_by_cap=0"
    rm_lacks "tuneup_max_threads_cap: 40 threads log nothing" "$RM_ERR" "over cap"
    rm_tuneup_thread "$t" "-w41" s41 3600
    rm_tuneup_run "$t" --dry-run
    rm_has "tuneup_max_threads_cap: 41 threads drop one" "$RM_OUT" "dropped_by_cap=1"
    rm_has "tuneup_max_threads_cap: the drop is logged" "$RM_ERR" "1 threads over cap MAX_THREADS=40 dropped"
}

case_tuneup_signature_recur() {
    local t
    t="$(rm_tmp)"
    rm_tuneup_stubs "$t"
    rm_tuneup_thread "$t" "" s1 3600 "PreToolUse:Bash hook error: 12 at /Users/x/a/b"
    rm_tuneup_thread "$t" "-wt" s2 3600 "PreToolUse:Bash hook error: 3456 at /tmp/c/d"
    rm_tuneup_env '{"findings":[]}' 0.1 > "$t/digest-env.json"
    rm_tuneup_run "$t"
    rm_has "tuneup_signature_recur: variants share one signature in 2 threads" \
        "$(cat "$t/state/tuneup/$RM_TDAY/sigs.tsv")" "$(printf 'hook_deny:pretooluse:bash_hook_error:_N_at_P\t2\t2')"
}

case_tuneup_llm_argv() {
    local t a1 a3
    t="$(rm_tmp)"
    rm_tuneup_week "$t"
    rm_tuneup_run "$t"
    a1="$(tr '\n' ' ' < "$t/claude.argv.1")"
    a3="$(tr '\n' ' ' < "$t/claude.argv.3")"
    rm_has "tuneup_llm_argv: no session persistence" "$a1" "[--no-session-persistence]"
    rm_has "tuneup_llm_argv: empty allowedTools" "$a1" "[--allowedTools] []"
    rm_has "tuneup_llm_argv: digest model" "$a1" "[--model] [claude-sonnet-5-5]"
    rm_has "tuneup_llm_argv: digest effort low" "$a1" "[--effort] [low]"
    rm_has "tuneup_llm_argv: rank model" "$a3" "[--model] [opus]"
    rm_has "tuneup_llm_argv: rank effort high" "$a3" "[--effort] [high]"
    rm_has "tuneup_llm_argv: cwd under the state dir" "$(cat "$t/claude.cwd")" "$t/state/"
}

case_tuneup_spend_log() {
    local t
    t="$(rm_tmp)"
    rm_tuneup_week "$t"
    rm_tuneup_run "$t"
    rm_expect_eq "tuneup_spend_log: one spend row per claude call" \
        "$(grep -c . "$t/claude.calls")" "$(grep -c . "$t/state/spend.tsv")"
}

case_tuneup_claude_failure() {
    local t
    t="$(rm_tmp)"
    rm_tuneup_week "$t"
    echo 1 > "$t/claude.rc"
    rm_tuneup_run "$t"
    [ "$RM_RC" -ne 0 ] && rm_ok "tuneup_claude_failure: exits nonzero" || rm_fail "tuneup_claude_failure: exited 0"
    [ ! -e "$t/state/tuneup/$RM_TDAY/digests.jsonl" ] && [ ! -e "$t/dm.1" ] \
        && [ -z "$(ls "$t/reports")" ] && rm_ok "tuneup_claude_failure: no digests, DM or report" \
        || rm_fail "tuneup_claude_failure: an artifact was written"
}

case_tuneup_digest_validation() {
    local t
    t="$(rm_tmp)"
    rm_tuneup_week "$t" 7 1
    rm_tuneup_env "{\"findings\":[{\"signature\":\"$RM_TSIG\",\"summary\":\"Valid.\"},{\"signature\":\"made:up\",\"summary\":\"Unknown.\"},{\"signature\":\"$RM_TSIG\",\"summary\":\"Bad — dash.\"}]}" 0.5 \
        > "$t/digest-env.json"
    rm_tuneup_run "$t"
    rm_has "tuneup_digest_validation: two findings dropped" "$RM_ERR" "dropped 2 digest findings"
    rm_expect_eq "tuneup_digest_validation: the valid finding is kept" 1 \
        "$(jq -s '[.[].findings[]] | length' "$t/state/tuneup/$RM_TDAY/digests.jsonl")"
}

# rm_prior_report <t> <rows> [sig-rows]: last week's report with Filed items and Signal counts.
rm_prior_report() {
    {
        printf '# Weekly tune-up 2026-09-14\n\n## Filed items\n\n'
        printf '| rank | issue | key | signatures | threads | title |\n|---|---|---|---|---|---|\n'
        printf '%s\n' "$2"
        printf '\n## Signal counts\n\n| signature | threads | events |\n|---|---|---|\n'
        printf '%s\n' "${3:-}"
    } > "$1/reports/2026-09-14-tune-up.md"
}

case_tuneup_dedupe_open_prior() {
    local t items
    t="$(rm_tmp)"
    rm_tuneup_week "$t"
    items="[{\"title\":\"Cd guard\",\"summary\":\"S.\",\"proposed_change\":\"C.\",\"signatures\":[\"$RM_TSIG\"]},{\"title\":\"Other\",\"summary\":\"S.\",\"proposed_change\":\"C.\",\"signatures\":[]}]"
    rm_tuneup_env "{\"items\":$items}" 1.0 > "$t/rank-env.json"
    rm_prior_report "$t" "| 1 | [backlog#7](https://github.com/a-jay85/IBL5-backlog/issues/7) | tuneup-0000beef | $RM_TSIG | 2 | Old cd guard |"
    echo '[{"number":7,"title":"Tune-up 2026-09-14: Old cd guard [tuneup-0000beef]","state":"OPEN","labels":["tune-up"]}]' > "$t/issues.json"
    rm_tuneup_run "$t"
    rm_has "tuneup_dedupe_open_prior: logged still open" "$RM_ERR" "still open: backlog#7 Cd guard"
    rm_lacks "tuneup_dedupe_open_prior: not filed" "$(cat "$t/gh.log")" "Cd guard"
    rm_has "tuneup_dedupe_open_prior: unrelated item filed" "$(cat "$t/gh.log")" "Other"
    rm_has "tuneup_dedupe_open_prior: report lists it" "$(cat "$t/reports/$RM_TDAY-tune-up.md")" "backlog#7"
}

case_tuneup_adopted_followup() {
    local t
    t="$(rm_tmp)"
    rm_tuneup_week "$t" 7 1
    rm_prior_report "$t" "$(printf '%s\n%s' \
        "| 1 | [backlog#8](https://github.com/a-jay85/IBL5-backlog/issues/8) | tuneup-0000aaaa | $RM_TSIG | 5 | Cd guard |" \
        "| 2 | [backlog#9](https://github.com/a-jay85/IBL5-backlog/issues/9) | tuneup-0000bbbb | other:sig | 3 | Other |")" \
        "| $RM_TSIG | 5 | 9 |"
    echo '[{"number":8,"title":"x [tuneup-0000aaaa]","state":"CLOSED","labels":["tune-up"]},{"number":9,"title":"y [tuneup-0000bbbb]","state":"OPEN","labels":["tune-up"]}]' > "$t/issues.json"
    rm_tuneup_run "$t"
    rm_has "tuneup_adopted_followup: closed item gets then/now counts" "$(cat "$t/dm.1")" \
        "backlog#8 (closed): signal 5 threads then, 1 now"
    rm_lacks "tuneup_adopted_followup: open item has no follow-up" "$(cat "$t/dm.1")" "backlog#9 (closed)"
}

case_tuneup_rank_validation() {
    local t items
    t="$(rm_tmp)"
    rm_tuneup_week "$t"
    items="[{\"title\":\"Good\",\"summary\":\"S.\",\"proposed_change\":\"C.\",\"signatures\":[\"$RM_TSIG\"]},{\"title\":\"Unknown\",\"summary\":\"S.\",\"proposed_change\":\"C.\",\"signatures\":[\"made:up\"]},{\"title\":\"Dash — here\",\"summary\":\"S.\",\"proposed_change\":\"C.\",\"signatures\":[]}]"
    rm_tuneup_env "{\"items\":$items}" 1.0 > "$t/rank-env.json"
    rm_tuneup_run "$t"
    rm_has "tuneup_rank_validation: two items dropped" "$RM_ERR" "dropped 2 rank items"
    rm_expect_eq "tuneup_rank_validation: one item filed" 1 "$(rm_creates "$t")"
    t="$(rm_tmp)"
    rm_tuneup_week "$t"
    rm_tuneup_env '{"items":[{"title":"Unknown","summary":"S.","proposed_change":"C.","signatures":["made:up"]}]}' 1.0 \
        > "$t/rank-env.json"
    rm_tuneup_run "$t"
    [ "$RM_RC" -ne 0 ] && rm_ok "tuneup_rank_validation: all-invalid exits nonzero" \
        || rm_fail "tuneup_rank_validation: all-invalid exited 0"
    rm_has "tuneup_rank_validation: names the cause" "$RM_ERR" "rank returned no valid items"
}

case_tuneup_files_top5_idempotent() {
    local t
    t="$(rm_tmp)"
    rm_tuneup_week "$t" 7
    rm_tuneup_run "$t"
    rm_expect_eq "tuneup_files_top5_idempotent: 5 creates from 7 items" 5 "$(rm_creates "$t")"
    rm_tuneup_week "$t" 5
    RM_RUN_NOW=$((RM_NOW + 86400)) rm_tuneup_run "$t"
    rm_expect_eq "tuneup_files_top5_idempotent: next-day run over the same items adds 0" 5 "$(rm_creates "$t")"
}

case_tuneup_stage_cache_reuse() {
    local t calls
    t="$(rm_tmp)"
    rm_tuneup_week "$t"
    echo 1 > "$t/dm.rc"
    rm_tuneup_run "$t"
    [ "$RM_RC" -ne 0 ] && rm_ok "tuneup_stage_cache_reuse: DM failure exits nonzero" \
        || rm_fail "tuneup_stage_cache_reuse: DM failure exited 0"
    rm_expect_eq "tuneup_stage_cache_reuse: no report after DM failure" "" "$(ls "$t/reports")"
    calls="$(grep -c . "$t/claude.calls")"
    echo 0 > "$t/dm.rc"
    RM_RUN_NOW=$((RM_NOW + 60)) rm_tuneup_run "$t"
    rm_expect_eq "tuneup_stage_cache_reuse: retry exits 0" 0 "$RM_RC"
    rm_expect_eq "tuneup_stage_cache_reuse: retry makes 0 claude calls" "$calls" "$(grep -c . "$t/claude.calls")"
    rm_expect_eq "tuneup_stage_cache_reuse: retry makes 0 creates" 5 "$(rm_creates "$t")"
    rm_expect_eq "tuneup_stage_cache_reuse: DM carries 5 issue links" 5 \
        "$(grep -c 'IBL5-backlog/issues/' "$t/dm.2")"
}

case_tuneup_dm_prose_clean() {
    local t
    t="$(rm_tmp)"
    rm_tuneup_week "$t"
    rm_tuneup_run "$t"
    if "$SCRIPT_DIR/check-prose" --stdin < "$t/dm.1" >/dev/null 2>&1; then rm_ok "tuneup_dm_prose_clean: check-prose clean"
    else rm_fail "tuneup_dm_prose_clean: check-prose flags the DM"; fi
    rm_lacks "tuneup_dm_prose_clean: check-digest-prose clean" \
        "$("$SCRIPT_DIR/check-digest-prose" "$t/dm.1" 2>/dev/null)" "LINE "
}

case_tuneup_prose_fix_then_fail() {
    local t items fixed
    items='[{"title":"Fix it later","summary":"Happy to help with this.","proposed_change":"C.","signatures":[]}]'
    t="$(rm_tmp)"
    rm_tuneup_week "$t"
    rm_tuneup_env "{\"items\":$items}" 1.0 > "$t/rank-env.json"
    rm_tuneup_env '{"body":"Still, not clean."}' 0.1 > "$t/prosefix-env.json"
    rm_tuneup_run "$t"
    [ "$RM_RC" -ne 0 ] && [ ! -e "$t/dm.1" ] && rm_ok "tuneup_prose_fix_then_fail: dirty rewrite stays unsent" \
        || rm_fail "tuneup_prose_fix_then_fail: dirty rewrite sent or exited 0"
    rm_expect_eq "tuneup_prose_fix_then_fail: one prose fix call" 1 "$(grep -l 'prose fix' "$t"/prompt.* | grep -c .)"
    t="$(rm_tmp)"
    rm_tuneup_week "$t"
    rm_tuneup_env "{\"items\":$items}" 1.0 > "$t/rank-env.json"
    fixed="$(jq -n -c --arg b 'Weekly tune-up. Fix it later.' '{body: $b}')"
    rm_tuneup_env "$fixed" 0.1 > "$t/prosefix-env.json"
    rm_tuneup_run "$t"
    rm_has "tuneup_prose_fix_then_fail: URL-dropping rewrite is refused" "$RM_ERR" "prose fix dropped"
    t="$(rm_tmp)"
    rm_tuneup_week "$t"
    rm_tuneup_env "{\"items\":$items}" 1.0 > "$t/rank-env.json"
    fixed="$(jq -n -c --arg b 'Weekly tune-up. 1. https://github.com/a-jay85/IBL5-backlog/issues/100 Fix it later.' '{body: $b}')"
    rm_tuneup_env "$fixed" 0.1 > "$t/prosefix-env.json"
    rm_tuneup_run "$t"
    rm_expect_eq "tuneup_prose_fix_then_fail: clean rewrite exits 0" 0 "$RM_RC"
    rm_has "tuneup_prose_fix_then_fail: clean rewrite is what gets sent" "$(cat "$t/dm.1")" "Fix it later."
}

case_tuneup_redaction() {
    local t all
    t="$(rm_tmp)"
    rm_tuneup_week "$t"
    rm_tuneup_thread "$t" "-r" s3 3600 "PreToolUse:Bash hook error: mail jo@example.com key sk-ant-api03-abcdefghij"
    rm_tuneup_env '{"items":[{"title":"Mail jo@example.com","summary":"Key sk-ant-api03-abcdefghij leaked.","proposed_change":"C.","signatures":[]}]}' 1.0 \
        > "$t/rank-env.json"
    rm_tuneup_run "$t"
    all="$(cat "$t"/prompt.* "$t"/gh-body.* "$t"/dm.* 2>/dev/null)"
    rm_lacks "tuneup_redaction: no email leaves" "$all" "jo@example.com"
    rm_lacks "tuneup_redaction: no sk-ant token leaves" "$all" "sk-ant-api03"
    rm_lacks "tuneup_redaction: no email in issue titles" "$(cat "$t/gh.log")" "jo@example.com"
}

# The report and issue body are next week's dedupe input, so a signature past 32
# characters must survive the outbound pass that redacts long opaque runs.
case_tuneup_signature_survives_redaction() {
    local t
    t="$(rm_tmp)"
    rm_tuneup_week "$t"
    rm_tuneup_env "$(jq -n -c --arg s "$RM_TSIG" '{items:[{title:"Long signature",summary:"S.",proposed_change:"C.",signatures:[$s]}]}')" 1.0 \
        > "$t/rank-env.json"
    rm_tuneup_run "$t"
    rm_has "tuneup_signature_survives_redaction: report keeps the long signature" "$(cat "$t"/reports/*-tune-up.md)" "$RM_TSIG"
    rm_lacks "tuneup_signature_survives_redaction: report has no redaction mark" "$(cat "$t"/reports/*-tune-up.md)" "[redacted]"
    rm_has "tuneup_signature_survives_redaction: issue body keeps the long signature" "$(cat "$t"/gh-body.* 2>/dev/null)" "$RM_TSIG"
    rm_has "tuneup_signature_survives_redaction: full redactor still drops an opaque run" \
        "$(printf 'x %s y' "$(printf 'A%.0s' {1..40})" | jq -R -s -j -f "$SCRIPT_DIR/lib/retro-mine-signals.jq" \
            --argjson cutoff 0 --argjson heavy 0 --argjson maxex 0 --argjson exch 0 --arg marker m --arg mode text)" "[redacted]"
}

case_tuneup_cap_proposal() {
    local t i
    t="$(rm_tmp)"
    rm_tuneup_week "$t" 1
    for i in 0 1 2 3; do
        rm -f "$t/claude.calls"
        echo '[]' > "$t/issues.json"
        RM_RUN_NOW=$((RM_NOW + i * 7 * 86400)) rm_tuneup_run "$t"
        rm_tuneup_thread "$t" "-n$i" "n$i" $((3600 - (i + 1) * 7 * 86400))
        rm_tuneup_thread "$t" "-m$i" "m$i" $((7200 - (i + 1) * 7 * 86400))
    done
    rm_lacks "tuneup_cap_proposal: run 3 has no proposal" "$(cat "$t/dm.3")" "Proposed weekly cap"
    rm_has "tuneup_cap_proposal: run 4 proposes p75 plus 25 percent" "$(cat "$t/dm.4")" 'Proposed weekly cap: $3.75'
    rm_expect_eq "tuneup_cap_proposal: one ok ledger row per run" 4 "$(grep -c '	ok$' "$t/state/runs.tsv")"
}

case_tuneup_empty_week() {
    local t
    t="$(rm_tmp)"
    rm_tuneup_stubs "$t"
    rm_tuneup_run "$t"
    rm_expect_eq "tuneup_empty_week: exits 0" 0 "$RM_RC"
    [ ! -e "$t/claude.calls" ] && [ ! -e "$t/dm.1" ] && [ ! -e "$t/gh.log" ] && [ -z "$(ls "$t/reports")" ] \
        && rm_ok "tuneup_empty_week: no call, DM, create or report" || rm_fail "tuneup_empty_week: something ran"
}

case_tuneup_already_ran_today() {
    local t calls rep
    t="$(rm_tmp)"
    rm_tuneup_week "$t"
    rm_tuneup_run "$t"
    calls="$(grep -c . "$t/claude.calls")"
    RM_RUN_NOW=$((RM_NOW + 60)) rm_tuneup_run "$t"
    rm_expect_eq "tuneup_already_ran_today: rerun exits 0" 0 "$RM_RC"
    rm_expect_eq "tuneup_already_ran_today: rerun makes no calls" "$calls" "$(grep -c . "$t/claude.calls")"
    rep="$(cat "$t/reports/$RM_TDAY-tune-up.md")"
    rm_has "tuneup_already_ran_today: filed table header" "$rep" "| rank | issue | key | signatures | threads | title |"
    rm_has "tuneup_already_ran_today: signal table header" "$rep" "| signature | threads | events |"
    rm_expect_eq "tuneup_already_ran_today: 5 filed rows" 5 "$(grep -c '^| [0-9] | \[backlog#' <<< "$rep")"
}

case_tuneup_dry_run_no_writes() {
    local t
    t="$(rm_tmp)"
    rm_tuneup_week "$t"
    echo '[{"number":5,"title":"Hand-filed","state":"OPEN"},{"number":6,"title":"t [tuneup-0000cafe]","state":"CLOSED","labels":["tune-up"]}]' > "$t/issues.json"
    rm_tuneup_run "$t" --dry-run
    rm_expect_eq "tuneup_dry_run_no_writes: exits 0" 0 "$RM_RC"
    rm_has "tuneup_dry_run_no_writes: reads only tune-up-labelled issues" "$RM_OUT" "tune-up issues visible=1"
    rm_has "tuneup_dry_run_no_writes: prints the summary" "$RM_OUT" "tune-up dry-run: threads interactive=2"
    [ ! -e "$t/claude.calls" ] && rm_ok "tuneup_dry_run_no_writes: no claude call" || rm_fail "tuneup_dry_run_no_writes: claude called"
    if grep -qv '^issue list ' "$t/gh.log"; then rm_fail "tuneup_dry_run_no_writes: gh did more than list"
    else rm_ok "tuneup_dry_run_no_writes: gh only lists"; fi
    rm_expect_eq "tuneup_dry_run_no_writes: state and report dirs empty" "" \
        "$(find "$t/state" "$t/reports" -type f 2>/dev/null)"
    echo 127 > "$t/gh.rc"
    rm_tuneup_run "$t" --dry-run
    rm_expect_eq "tuneup_dry_run_no_writes: gh 127 still exits 0" 0 "$RM_RC"
}

case_tuneup_replay_real_digest_envelope() {
    local t env th sig
    t="$(rm_tmp)"
    env="$RM_FIXTURE_DIR/tuneup-digest-envelope.json"
    th="$RM_FIXTURE_DIR/tuneup-thread.json"
    rm_has "tuneup_replay_real_digest_envelope: names the model" "$(jq -r '.modelUsage | keys[]' "$env")" "claude-sonnet-5-5"
    (
        export STATE_DIR="$t" REPO_ROOT="$SCRIPT_DIR/.."
        # shellcheck source=/dev/null
        . "$RM_DRIVER"
        set +e
        jq -c . "$th" > "$t/thread.jsonl"
        n="$(tuneup_validate_digest "$(cat "$t/thread.jsonl")" "$(cat "$env")" | jq '.findings | length')"
        [ "$n" -ge 1 ] && echo "ok: tuneup_replay_real_digest_envelope: real findings validate ($n)" \
            || echo "FAIL: tuneup_replay_real_digest_envelope: no finding validated"
        sig="$(jq -c '.events |= map(.sig = "tampered:sig")' "$t/thread.jsonl")"
        n="$(tuneup_validate_digest "$sig" "$(cat "$env")" | jq '.findings | length')"
        [ "$n" -eq 0 ] && echo "ok: tuneup_replay_real_digest_envelope: tampered signatures yield 0" \
            || echo "FAIL: tuneup_replay_real_digest_envelope: tampered signatures kept $n"
    ) > "$t/out" 2>&1
    cat "$t/out"
    if grep -q '^FAIL' "$t/out" || ! grep -q '^ok' "$t/out"; then FAILED=1; fi
}

case_tuneup_replay_real_rank_envelope() {
    local t env
    t="$(rm_tmp)"
    env="$RM_FIXTURE_DIR/tuneup-rank-envelope.json"
    (
        export STATE_DIR="$t" REPO_ROOT="$SCRIPT_DIR/.."
        # shellcheck source=/dev/null
        . "$RM_DRIVER"
        set +e
        n="$(tuneup_validate_rank "$RM_FIXTURE_DIR/tuneup-sigs.tsv" "$(cat "$env")" | grep -c .)"
        [ "$n" -ge 1 ] && [ "$n" -le 8 ] && echo "ok: tuneup_replay_real_rank_envelope: 1 to 8 items ($n)" \
            || echo "FAIL: tuneup_replay_real_rank_envelope: $n items"
        bad="$(jq -c '.structured_output.items[0].title += " — x"' "$env")"
        m="$(tuneup_validate_rank "$RM_FIXTURE_DIR/tuneup-sigs.tsv" "$bad" | grep -c .)"
        [ "$m" -eq $((n - 1)) ] && echo "ok: tuneup_replay_real_rank_envelope: injected em-dash drops one" \
            || echo "FAIL: tuneup_replay_real_rank_envelope: em-dash kept ($m of $n)"
    ) > "$t/out" 2>&1
    cat "$t/out"
    if grep -q '^FAIL' "$t/out" || ! grep -q '^ok' "$t/out"; then FAILED=1; fi
}

case_tuneup_env_i_launchd_path() {
    local t p
    t="$(rm_tmp)"
    rm_tuneup_week "$t"
    mkdir -p "$t/home"
    p="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin"
    RM_OUT="$(env -i PATH="$p" HOME="$t/home" RETRO_MINE_REGISTRY="$t/reg.md" RETRO_MINE_STATE_DIR="$t/state" \
        RETRO_MINE_CLAUDE_BIN="$t/claude" RETRO_MINE_GH_BIN="$t/gh" RETRO_MINE_DM_BIN="$t/dm" \
        RETRO_MINE_PROJECTS_DIR="$t/projects" RETRO_MINE_TMP_LOG_DIR="$t/tmplogs" \
        RETRO_MINE_AUTOMOUSE_LOG_DIR="$t/amlogs" RETRO_MINE_REPORT_DIR="$t/reports" \
        RETRO_MINE_NOW="$RM_NOW" "$RM_DRIVER" --dry-run 2>&1)"
    rm_expect_eq "tuneup_env_i_launchd_path: dry-run exits 0" 0 "$?"
    env -i PATH="$p" HOME="$t/home" RETRO_MINE_REGISTRY="$t/reg.md" RETRO_MINE_STATE_DIR="$t/state" \
        RETRO_MINE_CLAUDE_BIN="$t/claude" RETRO_MINE_GH_BIN="$t/gh" RETRO_MINE_DM_BIN="$t/dm" \
        RETRO_MINE_PROJECTS_DIR="$t/projects" RETRO_MINE_TMP_LOG_DIR="$t/tmplogs" \
        RETRO_MINE_AUTOMOUSE_LOG_DIR="$t/amlogs" RETRO_MINE_REPORT_DIR="$t/reports" \
        RETRO_MINE_NOW="$RM_NOW" "$RM_DRIVER" >/dev/null 2>&1
    rm_expect_eq "tuneup_env_i_launchd_path: full run exits 0" 0 "$?"
    [ -s "$t/dm.1" ] && rm_ok "tuneup_env_i_launchd_path: DM delivered" || rm_fail "tuneup_env_i_launchd_path: no DM"
}

case_zz_isolation_guards() {
    local probe
    if [ -e "$RM_ISO/dm-called" ]; then rm_fail "isolation: a case reached the DM binary"
    else rm_ok "isolation: no case reached the DM binary"; fi
    rm_expect_eq "isolation: repo tree untouched by the suite" "$RM_GIT_BASELINE" \
        "$(git -C "$SCRIPT_DIR/.." status --porcelain --untracked-files=all 2>/dev/null)"
    # Prove the guard bites: a stage dir pointed at $REPO_ROOT/.tuneup must
    # change porcelain, so a leaked write there cannot pass silently.
    probe="$SCRIPT_DIR/../.tuneup"
    if [ -e "$probe" ]; then
        rm_fail "isolation: \$REPO_ROOT/.tuneup already exists"
        return
    fi
    mkdir -p "$probe" && : > "$probe/probe"
    if [ "$(git -C "$SCRIPT_DIR/.." status --porcelain --untracked-files=all 2>/dev/null)" != "$RM_GIT_BASELINE" ]; then
        rm_ok "isolation: a write under \$REPO_ROOT/.tuneup changes porcelain"
    else
        rm_fail "isolation: a write under \$REPO_ROOT/.tuneup went unseen"
    fi
    rm -rf "$probe"
}

# ── Dispatch ──────────────────────────────────────────────────────────────────
RM_ALL_CASES() {
    declare -F | awk '$3 ~ /^case_/ {print $3}'
}

main() {
    local c
    if [ "$#" -gt 0 ]; then
        for c in "$@"; do
            if ! declare -F "$c" >/dev/null 2>&1 || [[ "$c" != case_* ]]; then
                echo "unknown case: $c" >&2
                exit 2
            fi
        done
        for c in "$@"; do "$c"; done
    else
        for c in $(RM_ALL_CASES); do "$c"; done
    fi
    if [ "$FAILED" -ne 0 ]; then
        echo "FAILED"
        exit 1
    fi
    echo "all passed"
}

main "$@"
