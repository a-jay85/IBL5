end_case strikes-survive-rebase

reset; begin_case
E_PATCHID="$SCRATCH/patchid-fail"
set_prs "$RED101"; set_checks aaa1111 red
run_tick
[[ "$(launch_count)" == "1" ]] || fail "patchid-fallback-dm: a failed patch-id stranded the PR (launches: $(launch_count))"
[[ "$(dm_count)" == "1" ]] || fail "patchid-fallback-dm: want 1 fallback DM, got $(dm_count)"
grep -qF 'could not compute its patch-id' "$SCRATCH/dm.log" || fail "patchid-fallback-dm: DM wording: $(cat "$SCRATCH/dm.log" 2>/dev/null)"
out_has 'patch-id unavailable; retry key falls back to head aaa1111' || fail "patchid-fallback-dm: no fallback log line: $OUT"
[[ "$(cat "$STATE_DIR/dm-patchid/101" 2>/dev/null)" == "aaa1111" ]] \
    || fail "patchid-fallback-dm: dm-patchid/101 is '$(cat "$STATE_DIR/dm-patchid/101" 2>/dev/null)'"
grep -qxF "$(printf '101\taaa1111\taaa1111')" "$STATE_DIR"/pending/* \
    || fail "patchid-fallback-dm: pending line key is not the head SHA: $(cat "$STATE_DIR"/pending/* 2>/dev/null)"
run_tick
[[ "$(dm_count)" == "1" ]] || fail "patchid-fallback-dm: fallback DM resent for the same head ($(dm_count))"
set_prs '101|branch-one|fff6666|BLOCKED|false'; set_checks fff6666 red
run_tick
[[ "$(dm_count)" == "2" ]] || fail "patchid-fallback-dm: want one DM per head (2), got $(dm_count)"
end_case patchid-fallback-dm

reset; begin_case
E_PATCHID="$SCRATCH/patchid-junk"
set_prs "$RED101"; set_checks aaa1111 red
run_tick
out_has 'patch-id unavailable' || fail "patchid-nonhex-falls-back: non-hex output was accepted: $OUT"
[[ "$(dm_count)" == "1" ]] || fail "patchid-nonhex-falls-back: want 1 fallback DM, got $(dm_count)"
grep -qxF "$(printf '101\taaa1111\taaa1111')" "$STATE_DIR"/pending/* \
    || fail "patchid-nonhex-falls-back: pending key column is not the head SHA: $(cat "$STATE_DIR"/pending/* 2>/dev/null)"
grep -qF 'not-a-patch-id' "$STATE_DIR"/pending/* && fail "patchid-nonhex-falls-back: junk reached the pending file"
end_case patchid-nonhex-falls-back

begin_case
for mode in unset empty; do
    reset
    if [[ "$mode" == unset ]]; then E_PATCHID="$UNSET"; else E_PATCHID=""; fi
    set_prs "$RED101"; set_checks aaa1111 red
    run_tick
    out_has 'patch-id unavailable' || fail "patchid-default-unset-and-empty ($mode): no fallback log line: $OUT"
    [[ "$(launch_count)" == "1" ]] || fail "patchid-default-unset-and-empty ($mode): want 1 launch, got $(launch_count)"
    [[ "$(dm_count)" == "1" ]] || fail "patchid-default-unset-and-empty ($mode): want 1 DM, got $(dm_count)"
    [[ -z "$(pr_refs)" ]] || fail "patchid-default-unset-and-empty ($mode): left refs/pr-cycle refs: $(pr_refs)"
done
end_case patchid-default-unset-and-empty

# Hand-written state: the point of the legacy cases is reading what the pre-key tick left.
reset; begin_case
E_PATCHID="$SCRATCH/patchid-file"; K1="$(key_of 1111111)"
mkdir -p "$STATE_DIR/pending" "$STATE_DIR/results"
printf '# result=%s started=%s\n101\taaa1111\n' "$STATE_DIR/results/legacy-1.tsv" "$(date +%s)" > "$STATE_DIR/pending/legacy-1"
printf '# pr-cycle-result v1\n101\tfired\tfailed\tkind=test\n' > "$STATE_DIR/results/legacy-1.tsv"
set_prs "$RED101"; set_checks aaa1111 red; set_key 101 "$K1"
run_tick
[[ "$(attempt 101)" == "aaa1111" ]] || fail "legacy-pending-no-key: attempts/101 is '$(attempt 101)', want the head SHA for a keyless line"
[[ "$(pending_count)" == "0" ]] || fail "legacy-pending-no-key: the legacy entry did not settle"
[[ "$(launch_count)" == "0" ]] || fail "legacy-pending-no-key: relaunched a head the legacy record covers"
end_case legacy-pending-no-key

reset; begin_case
E_PATCHID="$SCRATCH/patchid-file"; K1="$(key_of 1111111)"
mkdir -p "$STATE_DIR/attempts"; echo aaa1111 > "$STATE_DIR/attempts/101"
set_prs "$RED101"; set_checks aaa1111 red; set_key 101 "$K1"
run_tick
[[ "$(launch_count)" == "0" ]] || fail "legacy-sha-state-one-reset: the legacy SHA record did not hold the cap on the same head"
set_prs '101|branch-one|fff6666|BLOCKED|false'; set_checks fff6666 red
set_result "101\tfired\tfailed\tkind=test"
run_tick
run_tick
[[ "$(launch_count)" == "1" ]] || fail "legacy-sha-state-one-reset: want one rescue after the push, got $(launch_count)"
[[ "$(attempt 101)" == "$K1" ]] || fail "legacy-sha-state-one-reset: attempts/101 is '$(attempt 101)', want the key"
set_prs '101|branch-one|9999999|BLOCKED|false'; set_checks 9999999 red
run_tick
[[ "$(launch_count)" == "1" ]] || fail "legacy-sha-state-one-reset: the key did not hold the cap after the one reset"
end_case legacy-sha-state-one-reset

reset; begin_case
E_PATCHID="$SCRATCH/patchid-file"; K1="$(key_of 1111111)"
