test_phpunit_deleted_source_runs_full() {
    subset_case
    (cd "$R" && git rm -q ibl5/classes/Foo/Bar.php)
    run_gate --stage phpunit
    want_rc 0
    want_out "phpunit mode: full (source file deleted: ibl5/classes/Foo/Bar.php)"
    want_args "0:"
}

test_phpunit_subset_red_exits_1() {
    subset_case
    touch_file ibl5/classes/Foo/Bar.php
    export STUB_PHPUNIT_RC=1
    run_gate --stage phpunit
    unset STUB_PHPUNIT_RC
    want_rc 1
    want_out "FAIL phpunit: subset of 2 test files red"
    [ -z "$(pass_files '\.phpunit.*\.pass$')" ] || note "a phpunit pass record was written for a red subset"
}

test_phpunit_missing_binary_exits_3() {
    subset_case
    touch_file ibl5/classes/Foo/Bar.php
    unset PREFIRE_PHPUNIT_CMD
    rm "$R/ibl5/vendor/bin/phpunit"
    run_gate --stage phpunit
    want_rc 3
    want_out "prerequisite missing"
}

test_phpunit_subset_cache_hit() {
    subset_case
    touch_file ibl5/classes/Foo/Bar.php
    run_gate --stage phpunit
    want_rc 0
    run_gate --stage phpunit
    want_rc 0
    want_out "phpunit mode: subset"
    want_out "phpunit pass cached"
    want_cnt phpunit 1
}

