#!/usr/bin/env bash
#
# bin/post-plan-now — fire a detached post-plan run on the current worktree's
# branch, replacing the manual "open a new session and hand off" step.
#
# Engine selection: when the compiled post-plan harness is present in the main
# checkout (tools/postplan-harness, see its README) it runs `./run isolated <root>
# --live` — the deterministic phase sequencer with bounded LLM calls (~65-100x
# fewer gross tokens than a skill session). If the harness exits nonzero, or is
# absent on this machine, the same launchd job falls back to the original
# Sonnet 5.5 /post-plan skill session. POST_PLAN_SKILL=1 forces the skill path.
# The harness intentionally omits backlog housekeeping, worktree teardown, the
# E2E verify track, and Phase 10 preview — the skill fallback retains them.
# The harness runs the Phase 5.5 fidelity review itself; there is no partial-run resume, so any harness exit other than 0, 3 or 7 re-runs the full skill.
#
# Either way the run is supervised by launchd (RunAtLoad one-shot), so it
# survives closing Claude Code or the terminal — a plain `nohup … &` launched
# from Claude Code's Bash tool shares the tool-shell's process group and dies
# with it, so launchd is the load-bearing detach mechanism (same reason
# bin/automouse/run uses launchd).
#
# The plan is resolved from the branch slug — by harness Phase 1 (plan-blind if
# absent) or /post-plan skill Phase 1. No handoff file is needed.
#
# Usage:
#   bin/post-plan-now           # you decided to ship: fire unconditionally
#   bin/post-plan-now --auto    # impl agent's closing action: always fires
#                               #   (skips inside a headless/automouse run, which owns
#                               #   post-plan itself, unless IBL5_BURNDOWN_LOOP=1 is set
#                               #   by bin/burndown-loop). post-plan ALWAYS opens the
#                               #   PR; whether auto-merge ARMS is decided later, at
#                               #   /post-plan Phase 6.5 (a plan's `auto_merge: false`
#                               #   holds the merge — it no longer holds post-plan).
#   bin/post-plan-now --foreground   # run the engine in THIS shell instead of
#                               #   detaching via launchd; exits with post-plan's own
#                               #   status. For a supervising caller (bin/automouse/run)
#                               #   that owns its own timeout and logging.
#   bin/post-plan-now --force   # override the "PR already exists and the working set
#                               #   touches no production files" guard (exit 5), which
#                               #   otherwise points you at the cheaper
#                               #   /commit-commands:commit-push-pr. Bare flag only.
#   bin/post-plan-now --allow-test-only  # skip only the test-only exit-5 guard; keeps the
#                               #   in-flight, fleet-slot and holdrepeat (exit 8) guards that
#                               #   --force bypasses. Passed by bin/pr-cycle rescues via
#                               #   bin/post-plan-fleet. Bare flag only.
#   bin/post-plan-now --pr 123  # drive the worktree holding PR 123's head branch,
#                               #   creating it with bin/wt-new --existing when no
#                               #   worktree has that branch. Refuses a fork PR.
#
# Run from anywhere inside the target worktree.
# Exit 7: refused because $ROOT is the main checkout (ADR-0062); nothing was fired.
# Callers key on 7 to tell "wrong tree" apart from a generic failure (exit 1).
# Exit 8: declined because the last run for this slug held on the same structural
# reasons, the repeat DM was already sent, and plan+diff+harness are unchanged
# (harness/holdrepeat.py). Nothing was fired. --force overrides.
#
# --pr <n> drives the worktree that has PR <n>'s head branch checked out, instead
# of the current branch. When no worktree has that branch, --pr creates one via
# bin/wt-new --existing; a fork PR is refused, because post-plan pushes to the head
# branch and this repo has no such branch to push to.
# --pr selects the TREE; --plan selects the PLAN FILE.
# They are orthogonal and may be combined; --plan wins for the plan path only.
# An ambient PLAN_FILE in the caller's environment does not reach the detached child
# (launchd gives the job a minimal environment), so --pr needs no unset.
# POST_PLAN_MAIN_ROOT is a test-only override of the resolved main-checkout path.
# POST_PLAN_SELF_BIN is a test-only override of the bin/ dir used to find wt-new.
# Production never sets either.

# should_fallback <rc> — decide whether to escalate to the /post-plan skill session after the
# compiled harness exits with <rc>. Returns 0 (DO fall back) for a generic harness failure;
# returns 1 (do NOT fall back) for success (0) and the fail-closed sentinel (3) emitted by
# runner.py exit_code_for(). Two kinds reach exit 3: (1) a rebase conflict the auto-resolver
# declined or could not certify (unresolvable conflict class, per-file round cap, or failed
# TREE-EQUIVALENT proof; see ibl5/docs/decisions/0134-harness-conflict-autoresolve.md), and
# (2) a local pre-commit/pre-push gate denial (missing ADR, stale doc, rules byte budget). Both
# are deterministic walls a skill re-run cannot climb, so the fallback is suppressed entirely.
# 7 is this launcher's own main-checkout refusal (the is_in_worktree block further down):
# nothing ran, and the fix is to cd into the right worktree. The harness never emits 7
# (runner.py exit_code_for returns only 0, 1 or 3). Listing 7 keeps one no-fallback
# vocabulary, so a skill re-run can never be spent against the main checkout.
# This function is embedded verbatim into the launchd plist below via `declare -f`, so the
# tested logic here is exactly what runs there.
should_fallback() { case "$1" in 0|3|7) return 1 ;; *) return 0 ;; esac; }

# blocked_ship_block <run-dir> <slug> <root> <log> — the plain-language message for an
# exit-3 stop. The harness writes <run-dir>/blocked-ship.txt (runner.py write_blocked_ship);
# print it as is. `-s` treats an empty file (a failed write) like a missing one and prints
# a generic block of the same shape instead. The file is emitted with cat, never eval'd,
# so its text stays inert. Shipped into the detached job via `declare -f`, like
# should_fallback. bin/automouse/run carries a copy of the generic block; keep the two in
# step (both pinned by tests).
blocked_ship_block() {
    local f="$1/blocked-ship.txt"
    if [ -s "$f" ]; then
        cat -- "$f"
        return 0
    fi
    printf '%s did not ship. No PR opened.\n\n' "$2"
    printf 'Why: the ship step stopped and the log has the reason.\n\n'
    printf 'Fix:\n  1. cd %s\n' "$3"
    printf '  2. Read the log named on the Log line below and fix what it reports\n'
    printf '  3. bin/post-plan-now\n\n'
    printf 'Or open Claude in that folder and ask it to fix the ship block.\n'
    printf 'Log: %s\n' "$4"
}

# shq <string> — single-quote <string> for the FAR side of the launchd boundary.
# Everything this script assembles into $CMD is parsed by a shell a SECOND time, when
# launchd runs `/bin/bash -lc "$CMD"`. Embedding a variable there in DOUBLE quotes leaves
# `…`, $(…), $VAR and \ live at that second parse. That is not theoretical: the prompt's
# literal backticks around <slug>-N.md fired as command substitution in every plan-blind
# run, bash logged `line 10: slug: No such file or directory`, and the backticked span was
# SILENTLY DELETED from the prompt the model received — the plan-disambiguation
# instruction never arrived. Single quotes close the whole class for any future wording.
# Defined in bin/lib/launchd-job.sh (with xml_escape), sourced here above the
# sourced-guard so the unit test can source this script and exercise it.
# shellcheck source=lib/launchd-job.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/lib/launchd-job.sh"
# shellcheck source=lib/usage-gate.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/lib/usage-gate.sh"

# LEGACY: the old sticky "post-plan is running" comment marker. Only used to delete stale
# sticky comments; master's harness still posts them until this change merges.
POSTPLAN_BADGE_MARKER="<!-- postplan-status -->"
# The in-flight signal is now a PR label; a non-zero exit posts a NEW failure comment.
POSTPLAN_RUNNING_LABEL="post-plan-running"
POSTPLAN_FAILURE_MARKER="<!-- postplan-failure -->"
POSTPLAN_STICKY_LIB="${POSTPLAN_STICKY_LIB:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/pr-sticky.sh}"
# shellcheck source=/dev/null
[ -r "$POSTPLAN_STICKY_LIB" ] && source "$POSTPLAN_STICKY_LIB"

# shellcheck disable=SC2016
postplan_failure_body() {   # <rc> <label> <started>
    local rc="$1" label="$2" started="$3" log="${POSTPLAN_LOG_FILE:-}" sha
    printf '%s\n' "$POSTPLAN_FAILURE_MARKER"
    if [ "$rc" = 75 ]; then
        printf '**post-plan paused for usage limit; auto-resumes after reset**\n\n'
    elif [ "$rc" = stale ]; then
        printf '**A previous post-plan run ended without cleaning up**\n\n'
        printf 'The `%s` label was still on this PR, so that run probably crashed or was killed.\n' "$POSTPLAN_RUNNING_LABEL"
    else
        printf '**post-plan did not finish cleanly** (exit %s)\n\n' "$rc"
    fi
    if [ "$rc" != stale ]; then
        case "$rc" in
            75) printf 'Paused for usage limit; auto-resumes after reset.\n' ;;
            3) printf 'The harness hit a fail-closed wall and deliberately did not fall back. Cause: %s\n' "${HARNESS_RESULT:-a rebase conflict, or a local pre-commit/pre-push gate denial; the RESULT line in the log names which}" ;;
            *) printf 'The run ended abnormally — check the log under `/tmp/post-plan-now-*.log`.\n' ;;
        esac
    fi
    printf '\nStarted %s. Ended %s.\n' "${started:-unknown}" "$(date '+%Y-%m-%d %H:%M:%S %Z')"
    sha="$(git rev-parse --short HEAD 2>/dev/null || true)"
    [ -z "$sha" ] || printf 'Head: `%s`\n' "$sha"
    [ -z "$label" ] || printf 'Launchd job: `%s`\n' "$label"
    [ -z "$log" ] || printf 'Log: `%s`\n' "$log"
    if [ "$rc" != stale ] && [ -n "$log" ] && [ -r "$log" ]; then
        printf '\nLast log lines:\n\n~~~\n'
        tail -n 5 "$log" 2>/dev/null || true
        printf '~~~\n'
    fi
    [ "$rc" = 75 ] || printf '\nRe-run with `bin/post-plan-now --auto` once the cause is addressed.\n'
}

# Enumerates loaded launchd jobs and echoes the label of a live post-plan-now run for
# $1 (a SAFE_SLUG), or nothing. This matches by slug: the caller cannot know the peer's timestamp or PID.
# The glob is fully anchored -- the literal "-" after the slug must be followed by
# YYYYmmdd-HHMMSS-<pid>, so slug "foo" can never match a job for slug "foo-bar".
# Process substitution, not a pipe: piping into an early-exiting reader SIGPIPEs the
# writer to 141 under `set -o pipefail` (.claude/rules/shell-pipefail-grep.md).
postplan_inflight_label() {
  local want="$1" _pid _status label
  [ -n "$want" ] || return 0
  while IFS=$'\t' read -r _pid _status label; do
    case "$label" in
      com.ibl5.postplan-now-"$want"-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]-[0-9]*)
        printf '%s\n' "$label"
        return 0
        ;;
    esac
  done < <("${LAUNCHCTL_CMD:-launchctl}" list 2>/dev/null || true)
  return 0
}

# Prints com.ibl5.post-plan-fleet-<PR> when a fleet rescue for branch $1's open PR is loaded,
# else nothing. $2 is the PR number when the caller already knows it (--pr). A fleet rescue
# runs `post-plan-now --pr N --foreground`, which never creates a postplan-now-* label, so
# postplan_inflight_label cannot see it. The gh lookup runs only when some fleet label is
# loaded at all, so the common case costs one launchctl call and no network. A gh failure
# prints nothing (fail-open), the same posture as the open-PR lookup further down.
# Exact string compare on the label column: PR 189 never matches a job for PR 1892.
postplan_fleet_slot_label() {
  local branch="$1" pr="${2-}" snap _pid _status label
  snap=$("${LAUNCHCTL_CMD:-launchctl}" list 2>/dev/null || true)
  case "$snap" in *com.ibl5.post-plan-fleet-[0-9]*) ;; *) return 0 ;; esac
  if [ -z "$pr" ]; then
    pr=$("${GH_CMD:-gh}" pr list --head "$branch" --state open \
         --json number --jq '.[0].number // empty' 2>/dev/null || true)
  fi
  case "$pr" in ''|*[!0-9]*) return 0 ;; esac
  while IFS=$'\t' read -r _pid _status label; do
    if [ "$label" = "com.ibl5.post-plan-fleet-$pr" ]; then
      printf '%s\n' "$label"
      return 0
    fi
  done <<< "$snap"
  return 0
}

postplan_badge_pr_number() {
    "${GH_CMD:-gh}" pr view --json number --jq .number 2>/dev/null || true
}

postplan_label_add() {   # <pr>  -- best-effort, never fails the caller
    local n="$1"
    [ -n "$n" ] || return 0
    "${GH_CMD:-gh}" label create "$POSTPLAN_RUNNING_LABEL" --color FBCA04 \
        --description "post-plan is running on this PR; removed when the run ends" \
        >/dev/null 2>&1 || true
    "${GH_CMD:-gh}" api --method POST "repos/{owner}/{repo}/issues/$n/labels" \
        -f "labels[]=$POSTPLAN_RUNNING_LABEL" >/dev/null 2>&1 || true
    return 0
}

postplan_label_remove() {   # <pr>  -- best-effort, never fails the caller
    local n="$1"
    [ -n "$n" ] || return 0
    "${GH_CMD:-gh}" api --method DELETE \
        "repos/{owner}/{repo}/issues/$n/labels/$POSTPLAN_RUNNING_LABEL" \
        >/dev/null 2>&1 || true
    return 0
}

postplan_label_present() {   # <pr> -> 0 when the running label is on the PR
    local n="$1" out
    [ -n "$n" ] || return 1
    out="$("${GH_CMD:-gh}" pr view "$n" --json labels \
        --jq "any(.labels[]; .name == \"$POSTPLAN_RUNNING_LABEL\")" 2>/dev/null || true)"
    [ "$out" = true ]
}

postplan_failure_comment() {   # <pr> <rc> [label] [started]  -- a NEW comment each time
    local n="$1" rc="$2" label="${3:-}" started="${4:-}" tmpfile
    [ -n "$n" ] || return 0
    tmpfile="$(mktemp)"
    postplan_failure_body "$rc" "$label" "$started" > "$tmpfile" || true
    "${GH_CMD:-gh}" pr comment "$n" --body-file "$tmpfile" >/dev/null 2>&1 || true
    rm -f "$tmpfile"
    return 0
}

post_status_badge() {   # <pr>
    postplan_label_add "${1:-}"
    return 0
}

conclude_status_badge() {   # <rc> [pr]
    local rc="${1:-1}" n="${2:-}"
    if [ "${POSTPLAN_CONCLUDED:-0}" = 1 ]; then return 0; fi
    POSTPLAN_CONCLUDED=1
    [ -n "$n" ] || n="$(postplan_badge_pr_number)"
    [ -n "$n" ] || return 0
    postplan_label_remove "$n"
    # Legacy cleanup: delete any old sticky "running" comment.
    pr_sticky_delete "$n" "$POSTPLAN_BADGE_MARKER" || true
    if [ "$rc" != 0 ]; then
        postplan_failure_comment "$n" "$rc" "${POSTPLAN_LABEL:-}" "${POSTPLAN_STARTED:-}"
    fi
    return 0
}

# No liveness probe: the in-flight guards (postplan_inflight_label / fleet slot, below)
# already refuse a second concurrent run, and this sweep runs before THIS run adds its own
# label. So a running label seen here belongs to a run that is no longer alive.
postplan_sweep_stale_badge() {   # <pr>
    local n="$1"
    [ -n "$n" ] || return 0
    postplan_label_present "$n" || return 0
    postplan_failure_comment "$n" stale "" unknown
    postplan_label_remove "$n"
    return 0
}

# Repeat-hold decline (holdrepeat.py). Returns 0 = DECLINE (prints the reason),
# 1 = proceed. Fails open: a missing harness, python error, or any exit other
# than 10 proceeds. --force (FORCE=1) always proceeds.
postplan_holdrepeat_decline() {
    local harness="$1" slug="$2" plan="$3" root="$4" out rc
    [ "${FORCE:-0}" -eq 0 ] || return 1
    out=$(PYTHONPATH="$harness" python3 -m harness.holdrepeat check \
            --state-dir "${HOLDREPEAT_STATE_DIR:-$harness/out/state}" \
            --slug "$slug" --plan "$plan" --worktree "$root" 2>/dev/null) && rc=0 || rc=$?
    [ "$rc" -eq 10 ] || return 1
    printf '%s\n' "$out"
    return 0
}

# Sourced-guard: the unit test does `source bin/post-plan-now` to load should_fallback, then this
# returns before the body executes. Must sit before `set -euo pipefail` (sourcing must not alter
# the caller's shell options).
[ "${BASH_SOURCE[0]}" != "${0}" ] && return 0

set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
Usage: bin/post-plan-now [--auto] [--force] [--allow-test-only] [--foreground] [--plan <path>] [--pr <n>]

Fire a detached post-plan run on the current worktree's branch. Run from
anywhere inside the target worktree.

Options:
  --auto           Impl agent's closing action: fires unconditionally
                   (skips inside a headless/automouse run that owns post-plan,
                   unless IBL5_BURNDOWN_LOOP=1, which bin/burndown-loop sets).
  --force          Override the "PR already exists and working set touches no
                   production files" guard (exit 5).
  --allow-test-only  Skip only the test-only exit-5 guard. Unlike --force it keeps
                   the in-flight, fleet-slot and holdrepeat (exit 8) guards. Passed
                   by bin/pr-cycle rescues through bin/post-plan-fleet. Bare flag only.
  --foreground     Run the engine in this shell instead of detaching via launchd.
  --plan <path>    Override the plan file path (default: resolved from branch slug).
  --pr <n>         Drive the worktree holding PR <n>'s head branch; creates the
                   worktree via bin/wt-new --existing when absent. Refuses fork PRs.

Exit codes: 0 success, 1 failure, 3 fail-closed wall (no fallback), 5 guard denied,
            7 refused (run from the main checkout, not a worktree).
EOF
    exit 0
fi

AUTO=0
FORCE=0
ALLOW_TEST_ONLY=0
PLAN_OVERRIDE=""
FOREGROUND=0
PR_NUM=""
RESUME_SID=""
RESUME_STARTED=0
# --resume-paused <sid>: the coordinator's entry point. Replays the argv saved when the
# session was first started, under the same session id, so `claude --resume` continues it.
if [ "${1:-}" = "--resume-paused" ]; then
    if [ $# -ne 2 ]; then
        echo "--resume-paused takes exactly one session id" >&2
        exit 2
    fi
    _saved_file=$(mktemp)
    if ! usage_resume_paused_args post-plan-now "$2" > "$_saved_file"; then
        rm -f "$_saved_file"
        exit 2
    fi
    RESUME_SID="$2"
    _saved=()
    while IFS= read -r -d '' _a; do _saved[${#_saved[@]}]="$_a"; done < "$_saved_file"
    rm -f "$_saved_file"
    set -- ${_saved[@]+"${_saved[@]}"}
fi
ORIG_ARGS=("$@")
while [ $# -gt 0 ]; do
    case "$1" in
        --resume-paused) echo "post-plan-now: --resume-paused must be the only argument" >&2; exit 2 ;;
        --auto)   AUTO=1 ; shift ;;
        --force)  FORCE=1 ; shift ;;
        --allow-test-only) ALLOW_TEST_ONLY=1 ; shift ;;
        --foreground) FOREGROUND=1 ; shift ;;
        --plan)   [ $# -ge 2 ] || { echo "post-plan-now: --plan requires a path argument" >&2; exit 1; }
                  PLAN_OVERRIDE="$2" ; shift 2 ;;
        --plan=*) PLAN_OVERRIDE="${1#--plan=}" ; shift ;;
        --pr)     [ $# -ge 2 ] || { echo "post-plan-now: --pr requires a PR number argument" >&2; exit 1; }
                  PR_NUM="$2" ; shift 2 ;;
        --pr=*)   PR_NUM="${1#--pr=}" ; shift ;;
        *)        echo "post-plan-now: unknown argument '$1' (accepts --auto, --force, --allow-test-only, --foreground, --plan <path>, --pr <n>)" >&2
                  exit 1 ;;
    esac
done

if [ -n "$PLAN_OVERRIDE" ]; then
    [ -f "$PLAN_OVERRIDE" ] \
        || { echo "post-plan-now: --plan '$PLAN_OVERRIDE' does not exist — aborting." >&2; exit 1; }
    # launchd runs the job from a different cwd; the plist needs an absolute path.
    PLAN_OVERRIDE="$(cd "$(dirname "$PLAN_OVERRIDE")" && pwd)/$(basename "$PLAN_OVERRIDE")"
fi

# pr_worktree_root <main-root> <branch> — absolute path of the worktree that has <branch>
# checked out, empty when none does. Branch-authoritative, not path arithmetic: slash-bearing
# branch names are not single path components, and a renamed worktree directory no longer
# matches its branch name.
pr_worktree_root() {
    git -C "$1" worktree list --porcelain | awk -v want="refs/heads/$2" '
        /^worktree / { wt = substr($0, 10) }
        /^branch /   { if (substr($0, 8) == want) { print wt; exit } }'
}

# --pr <n>: drive the worktree holding PR <n>'s head branch instead of the current branch.
# This runs BEFORE ROOT/SLUG are computed on purpose — every downstream derivation
# (ROOT, SLUG, SAFE_SLUG, PLAN_FILE, and the plist's own `cd "$ROOT"`) then points at the
# target worktree for free.
if [ -n "$PR_NUM" ]; then
    case "$PR_NUM" in
        ''|0|*[!0-9]*) echo "post-plan-now: --pr needs a positive integer PR number (got '$PR_NUM')" >&2 ; exit 1 ;;
    esac
    command -v gh >/dev/null 2>&1 || { echo "post-plan-now: --pr needs the gh CLI on PATH" >&2 ; exit 1; }
    PR_BRANCH=$(gh pr view "$PR_NUM" --json headRefName --jq .headRefName 2>/dev/null) || PR_BRANCH=""
    [ -n "$PR_BRANCH" ] || { echo "post-plan-now: could not resolve a head branch for PR #$PR_NUM" >&2 ; exit 1; }
    case "$PR_BRANCH" in
        master|main|HEAD) echo "post-plan-now: PR #$PR_NUM head branch is '$PR_BRANCH' — refusing" >&2 ; exit 1 ;;
    esac
    SELF_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "post-plan-now: not inside a git repository" >&2 ; exit 1; }
    # shellcheck source=bin/lib/git-helpers.sh
    . "$SELF_ROOT/bin/lib/git-helpers.sh"
    MAIN_ROOT="${POST_PLAN_MAIN_ROOT:-$(resolve_canonical_root "$SELF_ROOT")}"
    WT_ROOT=$(pr_worktree_root "$MAIN_ROOT" "$PR_BRANCH") || true
    if [ -z "$WT_ROOT" ] || [ ! -d "$WT_ROOT" ]; then
        # No local worktree has this branch. Create one rather than bailing: post-plan must
        # never run in the main checkout (ADR-0062), and bin/wt-new --existing is the repo's
        # one supported way to materialize a worktree for an already-published branch.
        IS_FORK=$(gh pr view "$PR_NUM" --json isCrossRepository --jq .isCrossRepository 2>/dev/null) || IS_FORK=""
        if [ "$IS_FORK" = "true" ]; then
            echo "post-plan-now: PR #$PR_NUM comes from a fork — '$PR_BRANCH' is not a branch of this repo." >&2
            echo "  post-plan commits and pushes to the PR's head branch, which it cannot do on a fork." >&2
            exit 1
        fi
        if [ -z "$IS_FORK" ]; then
            echo "post-plan-now: could not determine whether PR #$PR_NUM is from a fork — refusing to create a worktree." >&2
            exit 1
        fi
        # Same flattening as SAFE_SLUG below: a launchd label and the paths derived from it
        # cannot contain '/', and IBL5-worktrees/<slug> must stay a single path component.
        PR_WT_SLUG=$(printf '%s' "$PR_BRANCH" | tr -cs 'A-Za-z0-9._-' '-')
        echo "post-plan-now: no worktree has '$PR_BRANCH' — creating '$PR_WT_SLUG' via bin/wt-new --existing." >&2
        # Beside THIS script, not under $MAIN_ROOT: a --pr run fired from this feature's own
        # worktree before it merges would otherwise pick master's wt-new, which has no
        # --existing flag. Same reasoning as the session-id.sh source line further down.
        SELF_BIN="${POST_PLAN_SELF_BIN:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)}"
        "$SELF_BIN/wt-new" "$PR_WT_SLUG" --existing "$PR_BRANCH" >&2 \
            || { echo "post-plan-now: bin/wt-new failed for branch '$PR_BRANCH' (slug '$PR_WT_SLUG')" >&2 ; exit 1; }
        WT_ROOT=$(pr_worktree_root "$MAIN_ROOT" "$PR_BRANCH") || true
        if [ -z "$WT_ROOT" ] || [ ! -d "$WT_ROOT" ]; then
            echo "post-plan-now: bin/wt-new succeeded but no worktree has '$PR_BRANCH' checked out." >&2
            exit 1
        fi
    fi
    cd "$WT_ROOT" || { echo "post-plan-now: cannot cd to $WT_ROOT" >&2 ; exit 1; }
    PLAN_SLUG="$PR_BRANCH"
fi

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) \
    || { echo "post-plan-now: not inside a git repo." >&2; exit 1; }
cd "$ROOT"
SLUG=$(git rev-parse --abbrev-ref HEAD)

case "$SLUG" in
    master|main|HEAD)
        echo "post-plan-now: refusing to run on '$SLUG' — switch to the feature branch." >&2
        exit 1 ;;
esac

# ADR-0062: post-plan commits and pushes. It must never do that in the main checkout.
# This is NOT --pr-only: the compiled harness (tools/postplan-harness) never executes
# SKILL.md, so this assertion is the ONLY enforcement on the primary engine path.
# shellcheck source=bin/lib/git-helpers.sh
. "$ROOT/bin/lib/git-helpers.sh"
# Beside THIS script, not under $ROOT. $ROOT is the CALLER's toplevel, so the
# $ROOT form dies whenever post-plan-now is invoked by absolute path from a
# different worktree. Same defect bin/plan-now carried; found by the Phase 7e
# smoke. The git-helpers.sh line above keeps $ROOT deliberately -- it predates
# this feature and is_in_worktree is meant to judge the caller's tree.
# shellcheck source=bin/lib/session-id.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/lib/session-id.sh"
# shellcheck source=bin/lib/plan-resolve.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/lib/plan-resolve.sh"
if ! is_in_worktree "$ROOT"; then
    echo "post-plan-now: refusing to run in the main checkout ($ROOT) — ADR-0062." >&2
    echo "  cd into the branch's worktree (or use --pr <n>) and re-run." >&2
    exit 7
fi

# A branch name may contain "/" (a Dependabot branch is
# `dependabot/composer/...`), but a launchd label and the paths derived from it
# cannot: `$HOME/Library/LaunchAgents/com.ibl5.postplan-now-dependabot/...plist`
# names a directory that does not exist, and the script dies at `cat > "$PLIST"`.
# Flatten every path/label-bound use to this form; $SLUG itself stays the real
# branch name for the master guard, the plan lookup, and human-facing prose.
SAFE_SLUG=$(printf '%s' "$SLUG" | tr -cs 'A-Za-z0-9._-' '-')

PLAN_FILE="${PLAN_OVERRIDE:-$(plans_dir)/$SLUG.md}"

# --auto is the impl agent's automatic closing action. One gate applies only here;
# a bare (human) invocation always fires, because running it by hand IS the
# decision to ship. post-plan ALWAYS opens the PR — a "risky" plan is no longer
# held here; the merge-hold decision now lives at /post-plan Phase 6.5, which
# reads the plan's `auto_merge: false` and refuses to ARM auto-merge (leaving the
# PR open for a human to merge) without ever skipping the post-plan run itself.
if [ "$AUTO" -eq 1 ]; then
    # We're already inside a headless/automouse run — the automouse runner fires
    # post-plan itself, so an auto-fire here would double-run. The
    # workflow-continuity rule that tells the impl agent to call this is
    # globally loaded, so the automouse impl agent sees it too; this is the
    # belt-and-suspenders guard against that.
    # Exception: a bin/burndown-loop batch runs headless (CLAUDE_HEADLESS=1
    # silences Stop hooks) but has no runner that ships for it, so the loop
    # exports IBL5_BURNDOWN_LOOP=1 to opt back in. Only the exact value 1
    # counts; unset, empty and 0 keep the automouse skip.
    if [ "${CLAUDE_HEADLESS:-}" = "1" ]; then
        if [ "${IBL5_BURNDOWN_LOOP:-}" = "1" ]; then
            echo "post-plan-now: CLAUDE_HEADLESS=1 with IBL5_BURNDOWN_LOOP=1 — burndown-loop batch opted in; firing."
        else
            echo "post-plan-now: CLAUDE_HEADLESS=1 — automouse/headless run owns post-plan; skipping auto-fire."
            exit 0
        fi
    fi
fi

# The opt-in is consumed by the guard above. Drop it so no child of this run
# (harness, skill-fallback claude, a nested post-plan-now) inherits it through
# the --foreground exec and re-fires past its own headless guard.
unset IBL5_BURNDOWN_LOOP

# Reap abandoned post-plan-now jobs (loaded but idle, or unloaded, with no live
# process) before adding another. Skipped under the test-only root overrides so a
# test run can never touch the real LaunchAgents dir. Never fatal.
if [ "$FOREGROUND" -eq 0 ] && [ -z "${POST_PLAN_MAIN_ROOT:-}${POST_PLAN_SELF_BIN:-}" ]; then
    _pp_alive() { ljob_pgrep_alive "$1"; }
    ljob_reap_idle com.ibl5.postplan-now- _pp_alive 10 "$(ljob_snapshot)" || true
fi

# In-flight duplicate-run guard. The launchd job for this slug is still loaded, so a peer
# post-plan-now is mid-flight; a second one would race it on the same worktree, the same
# branch and the same PR badge. Exit 6 (the caller-side namespace; see the exit-code table
# in the ENGINE comment) rather than 0, so bin/bug-pipeline-tick and any other caller sees
# a refusal instead of a silent skip. FORCE bypasses it: after a fixable failure a human
# (or the incident's legitimate 14:49:24 re-fire) must be able to re-fire immediately, and
# a job whose process is already gone leaves no label to match, so the common re-fire case
# is not even a bypass -- it is an allow.
if [ "${FORCE:-0}" -eq 0 ]; then
  INFLIGHT_LABEL=$(postplan_inflight_label "$SAFE_SLUG")
  if [ -n "$INFLIGHT_LABEL" ]; then
    echo "post-plan-now: a post-plan run for '$SLUG' is already in flight ($INFLIGHT_LABEL)."
    echo "post-plan-now: refusing to start a second one. Wait for it, or re-run with --force."
    exit 6
  fi
  # A fleet rescue holds com.ibl5.post-plan-fleet-<PR> and runs this script with
  # --foreground. Only a detaching run checks for one: the fleet's own runner is the
  # --foreground caller and must not refuse its own slot.
  if [ "${FOREGROUND:-0}" -eq 0 ]; then
    FLEET_LABEL=$(postplan_fleet_slot_label "$SLUG" "${PR_NUM:-}")
    if [ -n "$FLEET_LABEL" ]; then
      echo "post-plan-now: a fleet rescue for PR #${FLEET_LABEL##*-} is already in flight ($FLEET_LABEL)."
      echo "post-plan-now: refusing to race it. Wait for it, or re-run with --force."
      exit 6
    fi
  fi
fi

# Nothing to ship? Clean tree AND no untracked files AND no commits ahead of origin/master.
# `git diff` ignores untracked files, so a tree whose only change is a new file needs its
# own check.
if git diff --quiet && git diff --cached --quiet \
   && [ -z "$(git ls-files --others --exclude-standard)" ] \
   && [ -z "$(git log --oneline origin/master..HEAD 2>/dev/null)" ]; then
    echo "post-plan-now: nothing to do — clean tree and no commits ahead of master." >&2
    exit 1
fi

# A PR already exists and nothing production-facing changed? /post-plan is the wrong tool —
# /commit-commands:commit-push-pr is cheaper and CI runs the same tests on push.
# The regex below deliberately mirrors _TEST in tools/postplan-harness/harness/classify.py.
# Python is the single source of truth; this is a known duplicate, because HARNESS is not
# assigned until much later in this script. Keep the two in sync.
if [ "${FORCE:-0}" -eq 0 ]; then
    OPEN_PR_NUM=$(gh pr list --head "$(git rev-parse --abbrev-ref HEAD)" --state open \
                 --json number --jq '.[0].number // empty' 2>/dev/null || true)
    if [ -n "$OPEN_PR_NUM" ]; then
        CHANGED=$( { git diff --name-only origin/master...HEAD 2>/dev/null || true
                     git diff --name-only HEAD 2>/dev/null || true
                     git diff --name-only --cached 2>/dev/null || true
                     git ls-files --others --exclude-standard 2>/dev/null || true
                   } | sort -u )
        PROD_FILES=$(printf '%s\n' "$CHANGED" \
            | grep -vE '^ibl5/tests/|\.test\.(ts|js|php)$|\.spec\.(ts|js)$' \
            | grep -v '^$' || true)
        if [ -z "$PROD_FILES" ]; then
            if [ "$ALLOW_TEST_ONLY" -eq 1 ]; then
                echo "post-plan-now: --allow-test-only: PR #$OPEN_PR_NUM working set is test-only; proceeding (rescue caller)" >&2
            else
                echo "post-plan-now: PR #$OPEN_PR_NUM exists and the working set touches no production files." >&2
                echo "  Use /commit-commands:commit-push-pr instead — cheaper, and CI already runs those tests on push." >&2
                echo "  To override: bin/post-plan-now --force" >&2
                exit 5
            fi
        fi
    fi
fi

# Exit 8: declined, repeated hold with unchanged plan+diff+harness (holdrepeat.py).
if postplan_holdrepeat_decline \
     "${HARNESS:-/Users/ajaynicolas/GitHub/IBL5/tools/postplan-harness}" \
     "$SLUG" "${PLAN_OVERRIDE:-}" "$ROOT"; then
  echo "RESULT: post-plan DECLINED — held twice on the same reason and nothing changed" \
       "since; no tokens spent, no PR change. Override: bin/post-plan-now --force"
  exit 8
fi

[ -f "$PLAN_FILE" ] \
    || echo "post-plan-now: warn — no plan at $PLAN_FILE; the harness will try a slug-drift match (<prefix>-$SLUG.md) and otherwise run plan-blind. Pass --plan <abs-path> to name one explicitly." >&2

TS=$(date +%Y%m%d-%H%M%S)-$$
STARTED=$(date '+%Y-%m-%d %H:%M:%S %Z')
LOG="/tmp/post-plan-now-$SAFE_SLUG-$TS.log"
LABEL="com.ibl5.postplan-now-$SAFE_SLUG-$TS"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
# ONE session uuid for this run. $CMD below carries a single `claude -p` invocation
# since the harness absorbed Phase 5.5 and the rc=4 resume leg was removed, so one
# uuid is all there is to pin. Minted here, before the plist is
# written, so the sidecar is on disk before `launchctl bootstrap` can make the label
# visible to bin/fleet-status. Path comes from session_sidecar_path, not string
# surgery: the label says `postplan-now-`, the log says `post-plan-now-`.
if [ -n "$RESUME_SID" ]; then
    SESSION_ID="$RESUME_SID"
else
    SESSION_ID=$(mint_session_id) || {
        echo "post-plan-now: could not mint a session uuid — no uuidgen, no /proc uuid, no python3." >&2
        exit 1
    }
fi
write_session_sidecar "$LOG" "$SESSION_ID" \
    || { echo "post-plan-now: could not write the session sidecar next to $LOG." >&2; exit 1; }
# First line of the log, so a run killed before the harness flushes (SIGKILL, reboot) never
# leaves an empty file. Append, never truncate: launchd opens StandardOutPath for append, and
# the foreground tee below uses -a for the same reason. Not a RESULT: line, so every
# `^RESULT:` reader (HARNESS_RESULT capture, watch-run, bin/automouse/run) skips it.
printf 'post-plan-now: started %s pid=%s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')" "$$" >> "$LOG" || true

# Usage gate (ADR-0143). Save the argv so the coordinator can replay it; --foreground is
# dropped so a resume always goes through the launchd job. In the drain/stop zone a run
# that does not hold the token pauses here, before any plist exists.
_saved_args=()
for _a in ${ORIG_ARGS[@]+"${ORIG_ARGS[@]}"}; do
    [ "$_a" = "--foreground" ] || _saved_args[${#_saved_args[@]}]="$_a"
done
usage_argv_save "$SESSION_ID" ${_saved_args[@]+"${_saved_args[@]}"} || true
_gate_rc=0
usage_prestart_gate post-plan-now "$SESSION_ID" "$ROOT/bin/post-plan-now" || _gate_rc=$?
if [ "$_gate_rc" -eq 10 ]; then
    _gate_zone=$(usage_marker_read "$SESSION_ID" | jq -r '.zone // "unknown"' 2>/dev/null)
    echo "post-plan-now: usage gate ${_gate_zone}; paused before start, auto-resumes after reset."
    exit 75
fi
[ -z "$RESUME_SID" ] || usage_marker_clear "$RESUME_SID"
if [ -n "$RESUME_SID" ] && usage_session_started "$SESSION_ID"; then
    RESUME_STARTED=1
fi

if [ -n "$PLAN_OVERRIDE" ]; then
    PROMPT="Invoke the /post-plan skill now on the current git branch. Use this exact plan file for Phase 1: $PLAN_OVERRIDE — do NOT derive the plan from the branch slug. Then execute every phase. No human is present: never ask questions or wait for input — make the safe choice and continue."
else
    PROMPT="Invoke the /post-plan skill now on the current git branch. Resolve the plan from the branch slug per the skill Phase 1 (highest-numbered \`<slug>-N.md\` variant when several exist), then execute every phase. No human is present: never ask questions or wait for input — make the safe choice and continue."
fi

# Compiled-harness engine (see header). The launchd job runs the harness, captures its exit code,
# and escalates to the skill session ONLY when should_fallback permits it. Exit 3 (the fail-closed
# sentinel from runner.py exit_code_for -- a rebase conflict OR a local gate denial) is NOT a
# fallback trigger: it stops for a human instead of escalating to a
# --dangerously-skip-permissions skill session on an unreviewed tree. Exit 6 is a DIFFERENT
# namespace: it is this script's own in-flight duplicate-run refusal, raised before any harness
# runs, and it never comes from runner.py.
# Overridable ONLY so tools/postplan-harness/tests/test_post_plan_now_fallback.py can
# point the engine-selection branch at a stub and assert the generated $CMD in CI, where
# this absolute path does not exist. Production never sets it. The default must stay the
# MAIN-CHECKOUT absolute path — never $ROOT/tools/... — per ADR-0092: a worktree's own
# harness copy is the one this run is changing, and must not judge its own change.
HARNESS="${HARNESS:-/Users/ajaynicolas/GitHub/IBL5/tools/postplan-harness}"
# Renders the harness's background CI result (harness/ciwatch.py) as one sentence a
# far-side skill session can act on at Phase 7. Phase 8 removed its only call site along
# with the partial-run resume, so nothing embeds it today; the function and its tests stay
# because the skill-fallback arm is the natural next caller.
# Fail-open by design: a missing/garbled file yields the "unknown" clause, and the
# skill then runs its own `gh pr checks --watch` exactly as it does today.
postplan_ci_resume_clause() {
    local run_dir="$1" sha="$2" f
    [ -n "$run_dir" ] && [ -n "$sha" ] || { printf '%s' "CI OUTCOME: unknown (no harness run dir)."; return 0; }
    f="$run_dir/ci-$sha.json"
    if [ ! -f "$f" ]; then
        printf 'CI OUTCOME: unknown — no background result at %s; watch CI yourself at Phase 7.' "$f"
        return 0
    fi
    if grep -q '"status": "success"' "$f"; then
        printf 'CI OUTCOME: SUCCESS for head %s, already measured by the harness (%s). Do NOT run `gh pr checks --watch` again for this SHA.' "$sha" "$f"
        return 0
    fi
    if grep -q '"status": "failure"' "$f"; then
        printf 'CI OUTCOME: FAILURE for head %s (%s). Failing checks: %s. Run the Phase 7 fix loop FIRST, BEFORE spawning the Phase 5.5 fidelity reviewer.' \
            "$sha" "$f" "$(grep -oE '"[^"]+"' "$f" | sed -n '/^"/p' | tr '\n' ' ' | cut -c1-300)"
        return 0
    fi
    printf 'CI OUTCOME: indeterminate for head %s (%s) — the background watch did not settle; watch CI yourself at Phase 7.' "$sha" "$f"
}

BADGE_FN="$(declare -f pr_sticky_find pr_sticky_delete \
    postplan_failure_body postplan_badge_pr_number \
    postplan_label_add postplan_label_remove postplan_label_present \
    postplan_failure_comment post_status_badge conclude_status_badge \
    postplan_sweep_stale_badge \
    postplan_ci_resume_clause || true); "
FALLBACK_FN=""
HARNESS_SEG=""
HARNESS_RUN_DIR=""
GATE_OPEN=""
POST_HARNESS_SEG=""
GATE_CLOSE=""
ENGINE="Sonnet 5.5 /post-plan skill session"
# Usage-gate context for the harness (ADR-0143 addendum). No IBL5_USAGE_GATE=1 here:
# the harness adapter turns the gate on for its own claude children after checking
# this context, so an older harness never gates.
HARNESS_GATE_CTX="IBL5_USAGE_GATE_RUNNER=post-plan-now IBL5_USAGE_GATE_RESUME_BIN=$(shq "$ROOT/bin/post-plan-now") IBL5_USAGE_GATE_SESSION_ID=$(shq "$SESSION_ID") "
if [ "${POST_PLAN_SKILL:-0}" != "1" ] && [ -x "$HARNESS/run" ] && [ "${RESUME_STARTED:-0}" != 1 ]; then
    FALLBACK_FN="$(declare -f should_fallback blocked_ship_block); "
    PLAN_ARG="${PLAN_OVERRIDE:+ --plan $(shq "$PLAN_OVERRIDE")}"
    HARNESS_RUN_DIR="$HARNESS/out/live-$SAFE_SLUG-$TS"
    HARNESS_SEG="CLAUDE_HEADLESS=1 ${HARNESS_GATE_CTX}POSTPLAN_LOG_PATH=\"$LOG\" caffeinate -s \"$HARNESS/run\" isolated \"$ROOT\" \"$HARNESS_RUN_DIR\" --live${PLAN_ARG}; rc=\$?; "
    # Foreground has no plist, so nothing points stdout at $LOG. Without the tee, $LOG
    # never exists: the RESULT capture below comes back empty and the Log line in the
    # rc=3 message points at a missing file. Foreground only:
    # under launchd, stdout already IS $LOG, and a tee there would write every line twice.
    [ "$FOREGROUND" -eq 1 ] \
        && HARNESS_SEG="CLAUDE_HEADLESS=1 ${HARNESS_GATE_CTX}POSTPLAN_LOG_PATH=\"$LOG\" caffeinate -s \"$HARNESS/run\" isolated \"$ROOT\" \"$HARNESS_RUN_DIR\" --live${PLAN_ARG} 2>&1 | tee -a \"$LOG\"; rc=\${PIPESTATUS[0]}; "
    GATE_OPEN="if [ \"\${_sigterm_received:-0}\" -eq 0 ] && should_fallback \"\$rc\" && ! usage_postrun_pause post-plan-now $(shq "$SESSION_ID") $(shq "$ROOT/bin/post-plan-now") \"\$rc\" $(shq "$LOG"); then "
    # The harness has already exited and flushed by the time HARNESS_SEG's `rc=` runs,
    # so $LOG holds its final RESULT: line. The capture now feeds only
    # postplan_failure_body; the exit-3 message comes from blocked_ship_block.
    POST_HARNESS_SEG="HARNESS_RESULT=\$(grep -m1 '^RESULT:' \"$LOG\" 2>/dev/null || true); HARNESS_RESULT=\${HARNESS_RESULT:0:1200}; "
    GATE_CLOSE="; elif [ \"\$rc\" = 3 ]; then msg=\"\$(blocked_ship_block \"$HARNESS_RUN_DIR\" \"$SLUG\" \"$ROOT\" \"$LOG\")\"; printf '%s\n' '=== post-plan blocked ship ===' \"\$msg\" '=== end blocked ship ==='; \"$ROOT/bin/post-plan-fail-dm\" \"$ROOT\" \"$SAFE_SLUG\" \"$LOG\" \"\$msg\" || true; fi"
    ENGINE="compiled post-plan harness (fails CLOSED on a rebase conflict or a local gate denial; falls back to the skill on other failures)"
fi

# launchd runs with a minimal env, so prepend the same PATH bin/automouse/run uses
# (proven to find claude/gh/docker/node for full post-plan runs). CLAUDE_HEADLESS=1
# marks the detached run unattended: /post-plan skips the Phase 10 preview rebuild
# and BLOCKS auto-merge on a golden-snapshot change instead of merely warning.
# caffeinate -s keeps the Mac awake on AC for the run's duration.
# No CLAUDE_CODE_AUTO_COMPACT_WINDOW is set: with no override the run inherits
# the same autoCompactWindow setting an interactive session uses — rationale and
# the tripwire for re-adding an explicit window in bin/automouse/run.
# CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 stops the harness terminating a
# long-running backgrounded sub-AGENT mid-run (see bin/plan-now for the full
# rationale). Applies to the /post-plan skill fallback only. It does NOT extend to a
# backgrounded Bash shell: the sweep's other trigger ignores the ceiling and kills
# `local_bash` tasks once nothing awaitable is left, which is why /post-plan Phase 5
# mandates an in-turn BashOutput drain barrier and bash-guard.sh check 17 denies
# `run_in_background: true` under CLAUDE_HEADLESS.
#
# The command line is assembled as PLAIN shell text first — literal `&&`, and
# whatever `<`/`>`/`&` the prompt happens to carry — then XML-escaped exactly once
# at the single choke point below. Hand-escaping entities inside the heredoc is
# what broke this script before: a prompt containing `<slug>-N.md` made the
# <string> element malformed XML, so `launchctl bootstrap` died with
# "Bootstrap failed: 5: Input/output error" and no log was ever written.
#
# XML escaping is only HALF the boundary. $CMD is also re-parsed as SHELL by
# `/bin/bash -lc` at the far end, so every variable carrying FREE-FORM TEXT — the
# prompt and the --plan path — is quoted with shq() (see its header) rather than
# interpolated inside \"…\". (The rest — $ROOT, $LABEL, $PLIST, $LOG — are values
# this script controls, so \"…\" is fine for them.) Interpolation is what let
# the same `<slug>-N.md` string break a second way — as command substitution that
# silently deleted itself from the prompt. Both hazards, one string, different fixes:
# do not "simplify" either one away.
# $CMD's tail is launch-mechanism-specific. The launchd form is byte-identical to what
# this script has always emitted — do not "unify" the two. The foreground form is the
# only place the exit status and the cost marker can escape: launchctl bootout swallows
# both. HARNESS_RUN_DIR is empty on the skill-only path, hence the :-none default.
if [ "$FOREGROUND" -eq 1 ]; then
    CMD_TAIL="conclude_status_badge \"\$pp_rc\"; echo \"post-plan-now: postplan-rc=\$pp_rc harness-rc=\${rc:-none} harness-run-dir=${HARNESS_RUN_DIR:-none}\"; exit \$pp_rc"
else
    CMD_TAIL="conclude_status_badge \"\$pp_rc\"; rm -f \"$PLIST\"; launchctl bootout gui/\$(id -u)/$LABEL"
fi

# One splice covers both far-side arms (harness and skill fallback).
# Only set when --pr was given (PR_NUM is non-empty), so the bare path stays byte-identical.
PLAN_SLUG_SEG=""
[ -n "${PR_NUM:-}" ] && PLAN_SLUG_SEG="export PLAN_SLUG=$(shq "$PLAN_SLUG"); "

# Sync this worktree before post-plan reads its diff (ADR-0133). A worktree that
# diverged while the impl ran would otherwise be reviewed against a stale base.
PP_VERDICT="$("$ROOT/bin/wt-sync-tick" --only "$ROOT" 2>/dev/null || true)"
case "$PP_VERDICT" in
    DIVERGED-CONFLICT|DIVERGED-DIRTY)
        echo "post-plan-now: worktree '$SLUG' needs manual resolution ($PP_VERDICT)." >&2
        echo "post-plan-now: resolve, then re-run. Nothing was changed." >&2
        exit 1 ;;
    "") : ;;
    *) echo "post-plan-now: wt-sync --only: $PP_VERDICT" ;;
esac

# Every other failed run DMs too. Exit 3 already sent its own DM above; 143 is a
# deliberate SIGTERM. The last log lines carry the cause, e.g. a usage-limit notice.
# $fail_tail is read into a variable, so log text is data and never re-parsed as shell.
FAILDM_SEG="if [ \"\$pp_rc\" != 0 ] && [ \"\$pp_rc\" != 3 ] && [ \"\$pp_rc\" != 143 ] && [ \"\$pp_rc\" != 75 ]; then fail_tail=\$(tail -n 3 \"$LOG\" 2>/dev/null | tr '\n' ' ' | cut -c1-600); msg=\"post-plan-now: run FAILED on branch $SLUG (exit \$pp_rc). Last log lines: \${fail_tail:-none}. Re-run: cd $ROOT && bin/post-plan-now. See $LOG.\"; echo \"\$msg\"; \"$ROOT/bin/post-plan-fail-dm\" \"$ROOT\" \"$SAFE_SLUG\" \"$LOG\" \"\$msg\" || true; fi; "

# A paused run (marker on disk, or a limit-hit log) exits 75 and skips the FAIL-DM; the
# coordinator sends one DM per wave. Placed before FAILDM_SEG so it wins over every other exit.
PAUSE_SEG="if usage_postrun_pause post-plan-now $(shq "$SESSION_ID") $(shq "$ROOT/bin/post-plan-now") \"\$pp_rc\" $(shq "$LOG"); then pp_rc=75; echo 'post-plan-now: RESULT paused (usage gate); auto-resumes after reset.'; fi; "
RELEASE_SEG="usage_token_release $(shq "$SESSION_ID") 2>/dev/null || true; "
# Re-acquire the drain token with this launchd job's pid (\$\$ expands on the far side)
# so usage_token_reclaim_dead keeps it alive while the run is in flight. No-op when the
# session does not hold the token (normal-zone runs never acquire it).
ACQUIRE_SEG="if [ \"\$(usage_token_holder)\" = $(shq "$SESSION_ID") ]; then usage_token_acquire $(shq "$SESSION_ID") \$\$ 2>/dev/null || true; fi; "
GATE_ENV="IBL5_USAGE_GATE=1 IBL5_USAGE_GATE_RUNNER=post-plan-now IBL5_USAGE_GATE_MODEL=claude-sonnet-5-5 IBL5_USAGE_GATE_RESUME_BIN=$(shq "$ROOT/bin/post-plan-now") "
if [ "${RESUME_STARTED:-0}" = 1 ]; then
    SKILL_PROMPT_ARG="$(shq "Continue the /post-plan run from where it stopped. The previous turn was paused by the usage gate.")"
    SKILL_SESSION_ARG="--resume $(shq "$SESSION_ID")"
else
    SKILL_PROMPT_ARG="$(shq "$PROMPT")"
    SKILL_SESSION_ARG="--session-id $(shq "$SESSION_ID")"
fi

CMD="export PATH=\"/usr/local/bin:/opt/homebrew/bin:\$HOME/.bun/bin:\$HOME/.local/bin:/Applications/cmux.app/Contents/Resources/bin:\$PATH\"; ${PLAN_SLUG_SEG}export POSTPLAN_LABEL=$(shq "$LABEL") POSTPLAN_STARTED=$(shq "$STARTED") POSTPLAN_BADGE_MARKER=$(shq "$POSTPLAN_BADGE_MARKER") POSTPLAN_RUNNING_LABEL=$(shq "$POSTPLAN_RUNNING_LABEL") POSTPLAN_FAILURE_MARKER=$(shq "$POSTPLAN_FAILURE_MARKER") POSTPLAN_LOG_FILE=$(shq "$LOG") POSTPLAN_STATUS_LABEL=$(shq "$POSTPLAN_RUNNING_LABEL"); ${BADGE_FN}_sigterm_received=0; trap 'conclude_status_badge \"\${pp_rc:-1}\"' EXIT INT HUP; trap '_sigterm_received=1; conclude_status_badge \"\${pp_rc:-1}\"' TERM; cd \"$ROOT\" && { . \"$ROOT/bin/lib/usage-gate.sh\"; postplan_sweep_stale_badge \"\$(postplan_badge_pr_number)\"; ${ACQUIRE_SEG}${FALLBACK_FN}${HARNESS_SEG}${POST_HARNESS_SEG}${GATE_OPEN}${GATE_ENV}CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 CLAUDE_HEADLESS=1 caffeinate -s claude -p ${SKILL_PROMPT_ARG} --dangerously-skip-permissions --model claude-sonnet-5-5 ${SKILL_SESSION_ARG} --effort high --name \"$LABEL\"${GATE_CLOSE}; }; pp_rc=\$?; if [ \"\${_sigterm_received:-0}\" -eq 1 ]; then pp_rc=143; fi; if [ \"\${rc:-0}\" = 3 ]; then pp_rc=3; fi; ${PAUSE_SEG}${FAILDM_SEG}${RELEASE_SEG}${CMD_TAIL}"

if [ "$FOREGROUND" -eq 1 ]; then
    echo "post-plan-now: foreground mode on branch '$SLUG' — engine: $ENGINE"
    echo "post-plan-now: plan: $PLAN_FILE"
    # exec, not a call: `timeout` signals the whole process group, and a surviving
    # wrapper shell would outlive the SIGTERM its child just took. `/bin/bash -lc`
    # matches the plist's ProgramArguments so both modes parse $CMD identically.
    exec /bin/bash -lc "$CMD"
fi

CMD_XML=$(xml_escape "$CMD")
LABEL_XML=$(xml_escape "$LABEL")
ROOT_XML=$(xml_escape "$ROOT")
LOG_XML=$(xml_escape "$LOG")

cat > "$PLIST" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$LABEL_XML</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-lc</string>
		<string>$CMD_XML</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>WorkingDirectory</key>
	<string>$ROOT_XML</string>
	<key>StandardOutPath</key>
	<string>$LOG_XML</string>
	<key>StandardErrorPath</key>
	<string>$LOG_XML</string>
</dict>
</plist>
PLIST_EOF

ljob_bootstrap "$LABEL" "$PLIST"

echo "post-plan-now: fired a detached post-plan on branch '$SLUG'."
echo "  engine: $ENGINE"
echo "  supervised by launchd — survives closing Claude Code / the terminal"
echo "  notify: Discord DM on finish. Do NOT arm a Monitor or ScheduleWakeup for"
echo "          this run: the DM is the completion signal."
echo "  watch:  $ROOT/bin/watch-run --log $LOG --label $LABEL   (manual use only; never"
echo "          'tail -f' the log, the harness flushes everything at exit)"
echo "  log:    $LOG   (its RESULT: line is the verdict once the run ends)"
echo "  label:  $LABEL   (self-removes when post-plan finishes)"
echo "  PR / code review / CI / auto-merge progress appears on the PR."
echo "  Leave this worktree alone — /post-plan rebuilds its Docker stack for E2E."
