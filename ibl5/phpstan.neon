includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - phpstan-baseline.neon

parameters:
    tmpDir: tmp
    level: max
    paths:
        - classes
        - themes
        - phpstan-rules
        - bin/check-baseline-drift
        - bin/check-boxscore-schedule-run
        - bin/check-coverage
        - bin/check-coverage-regression
        - bin/check-seed-id-uniqueness
        - bin/check-xml-class-refs
        - bin/migrate
        - bin/migrate-seed
        - bin/purge-page-cache
        - bin/rebuild-record-holders-cache
        - bin/refresh-team-season-records
        - bin/rollback-phantom-repair-run
        - bin/validate-schema
        - bin/warm-cache
        - scripts
    excludePaths:
        - classes/Bootstrap/LegacyFunctions.php
        - phpstan-rules/Fixtures
    bootstrapFiles:
        - phpstan-stubs/nuke-globals.stub.php
    phpVersion: 80300
    treatPhpDocTypesAsCertain: false
    featureToggles:
        # bleedingEdge enabled `unnecessaryNullCoalesce` in phpstan 2.2.6. It reports
        # `$arr['key'] ?? null` as redundant using certainty derived from PHPDoc array
        # shapes (`@phpstan-type`) — ignoring `treatPhpDocTypesAsCertain: false` above.
        # Verified: on the same expression, `function.alreadyNarrowedType` IS correctly
        # suppressed by that setting while `nullCoalesce.unnecessary` is not.
        #
        # Our `@phpstan-type` shapes describe the happy path of config files and SELECT
        # rows whose keys can genuinely be absent at runtime, so the `?? null` inside
        # `is_string(...)`/`is_int(...)` guards is load-bearing: PR #1785 removed it and
        # PHP emitted "Undefined array key" warnings, which fail PHPUnit with exit 1.
        #
        # Disabling this toggle restores the repo's stated PHPDoc-certainty policy. The
        # native-type equivalent (`nullCoalesce.offset`) stays on and still catches a
        # genuinely redundant `??`.
        unnecessaryNullCoalesce: false

services:
    -
        class: PHPStanRules\BanNumberFormatRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\RequireStrictTypesRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanDirectNukeGlobalsRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanDirectCommonMysqliInstantiationRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanBeginTransactionInRepositoryRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\RequireEscapedOutputRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\RequireTrustedAnnotationRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanRawSuperglobalsRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanGlobalKeywordRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanInlineCssRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanDeprecatedHtmlTagsRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanRequireOnceRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\RequireMeaningfulAssertionsRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\PageLayoutHeaderBeforeCookieRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanReservedWordColumnsRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanInconsistentColumnNamesRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\OrderByRequiresUniqueTiebreakerRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanNonSnakeCaseColumnsRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanBareTableIdentifierRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanAddslashesRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanFilterSaveArgRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanMysqliInViewClassesRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanDbTouchingCallInViewRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanDbTouchingNewInViewRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\TradingPrefixConventionRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanCastFunctionsRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanDieExitInProductionRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanEchoInNonViewClassesRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanJsonDecodeWithoutThrowFlagRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanServiceExtendsBaseRepositoryRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanRawHtmlEscapeFunctionsRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanDirectHeaderCallRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanHardcodedEnvironmentStringsRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanDirectMysqliQueryRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanSqlStringInterpolationRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanSqlStringConcatenationRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanDuplicateModifierMethodRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanBareColumnIdentifierRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanDirectTimeCallsRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanProcOpenUncheckedExitRule
        tags:
            - phpstan.rules.rule
    -
        class: PHPStanRules\BanUnknownCliOptionRule
        tags:
            - phpstan.rules.rule
