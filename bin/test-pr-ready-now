# --- case pr-ready-bringup-peer-safe (row 12) --------------------------------------------
# Pins the dirty-guard preceding the first bin/wt-up call; deleting it lets this regress.
begin_case
grep -qF 'git -C "$WT" status --porcelain' "$PRD/scripts/wt-bring-up.sh" \
  || fail "pr-ready-bringup-peer-safe (row 12): status --porcelain check absent from wt-bring-up.sh"
