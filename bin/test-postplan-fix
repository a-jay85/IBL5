#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-postplan-fix: cases for bin/postplan-fix (one-command fix entry for a blocked
# post-plan run). claude and gh are stubs; the script runs from a copy inside a temp git
# repo, so nothing in the real checkout or on the network is touched.
#
#   1. --help exits 0 and prints Usage; no tool is called.
#   2. Unknown flag exits 2.
#   3. Unset arg, empty arg, and two args each exit 2.
#   4. Unknown PR exits 1.
#   5. Unknown slug exits 1.
#   6. A prefix of a real branch exits 1 (the worktree match is exact).
#   7. PR path: claude gets cwd = the branch worktree, one argv element, and the newest
#      run's blocked-ship text and the newest post-plan-now-… log under POSTPLAN_LOG_DIR.
#   8. Slug path: result.json under the worktree's own out dir; gh is not called.
#   9. Worktree with no run dir still launches.
#  10. A 5000-byte failure text is capped at 1500 bytes.
#  11. Run from a linked worktree: the main checkout's out dir is still searched.
#  12. env -i probe: no HOME, no Homebrew, bash with pipefail; POSTPLAN_LOG_DIR forwarded.
#  13. POSTPLAN_LOG_DIR unset or empty: the private log dir is not read.
#  14-24. --headless [--dry-run]: flag rejection, dry run, main-checkout refusal, dirty
#      tree, resolve-and-commit, FAILED verdict, leftover markers, moved ref (restored
#      with a reflog message), clean merge, missing harness, env -i.
#      21d-21i: the ref guard covers only the session branch's own two refs. An
#      unrelated master move and an unrelated branch create/delete are kept; an own ref
#      that moves again before the restore is left as is (compare-and-swap); an own ref
#      the session deleted is restored and one it created is removed. A sibling ref
#      under the own remote ref's name does not abort the run.
#      Each prints one "case ok headless-<name>" line.
#
# Run: bin/test-postplan-fix  (exit 0 = all pass, 1 = a case failed)

set -u

# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

ROOT=$(cd "$(dirname "$0")/.." && pwd)

ok()   { h_pass "$1"; }
fail() { h_fail "$@"; }

TMP=$(mktemp -d "${TMPDIR:-/tmp}/test-postplan-fix.XXXXXX")
B_BLOCK="pfx$$-block"; B_JSON="pfx$$-json"; B_NORUN="pfx$$-norun"; B_BIG="pfx$$-big"
B_PREFIX="pfx$$-bloc"
RUNLOG="$TMP/runlog"; mkdir -p "$RUNLOG"
export POSTPLAN_LOG_DIR="$RUNLOG"   # read by bin/postplan-fix; keeps /tmp clean
PNLOG="$RUNLOG/post-plan-now-$B_BLOCK-20261008-120001-9.log"
trap 'rm -rf "$TMP"' EXIT

has()   { case "$2" in *"$3"*) ok "$1" ;; *) fail "$1" "missing '$3'" ;; esac; }
hasnt() { case "$2" in *"$3"*) fail "$1" "unexpected '$3'" ;; *) ok "$1" ;; esac; }
rc_is() { if [ "$2" = "$3" ]; then ok "$1"; else fail "$1" "rc $2, want $3"; fi; }

# --- fixture: a temp repo holding a committed copy of the script and its libs ---
MAIN="$TMP/main"
git init -q "$MAIN"
mkdir -p "$MAIN/bin"
cp "$ROOT/bin/postplan-fix" "$MAIN/bin/postplan-fix"
cp -R "$ROOT/bin/lib" "$MAIN/bin/lib"
git -C "$MAIN" add -A
git -C "$MAIN" -c user.name=t -c user.email=t@t commit -qm init
for B in "$B_BLOCK" "$B_JSON" "$B_NORUN" "$B_BIG"; do
    git -C "$MAIN" worktree add -q -b "$B" "$TMP/wt-$B"
done

# Headless fixture: MAIN is on master with an origin remote. B_CONFLICT changes a.txt to
# "feature"; master commits a.txt as "master" and pushes, so merging origin/master conflicts.
# The denied-tool import needs harness/ under MAIN: only that package is linked, because a
# link to the whole tools/ dir would aim the OUT fixtures below at the real checkout.
git -C "$MAIN" branch -M master
# A user-level rerere would replay case 18's resolution into the later cases.
git -C "$MAIN" config rerere.enabled false
B_CONFLICT="pfx$$-conflict"; B_CLEAN="pfx$$-clean"
GITC=(git -c user.name=t -c user.email=t@t)
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t
mkdir -p "$MAIN/tools/postplan-harness"
ln -s "$ROOT/tools/postplan-harness/harness" "$MAIN/tools/postplan-harness/harness"
git clone -q --bare "$MAIN" "$TMP/origin.git"
git -C "$MAIN" remote add origin "$TMP/origin.git"
git -C "$MAIN" fetch -q origin
INIT_SHA=$(git -C "$MAIN" rev-parse master)
git -C "$MAIN" worktree add -q -b "$B_CONFLICT" "$TMP/wt-$B_CONFLICT" "$INIT_SHA"
printf 'feature\n' > "$TMP/wt-$B_CONFLICT/a.txt"
git -C "$TMP/wt-$B_CONFLICT" add a.txt
"${GITC[@]}" -C "$TMP/wt-$B_CONFLICT" commit -qm feature
printf 'master\n' > "$MAIN/a.txt"
git -C "$MAIN" add a.txt
"${GITC[@]}" -C "$MAIN" commit -qm master-change
git -C "$MAIN" push -q origin master
git -C "$MAIN" worktree add -q -b "$B_CLEAN" "$TMP/wt-$B_CLEAN" master
# A pre-existing remote-tracking ref for the moved-ref case to disturb.
git -C "$MAIN" update-ref "refs/remotes/origin/$B_CONFLICT" "$INIT_SHA"

OUT="$MAIN/tools/postplan-harness/out"
JSON_OUT="$TMP/wt-$B_JSON/tools/postplan-harness/out"
mkdir -p "$OUT/live-$B_BLOCK-20261007-090000-1" "$OUT/live-$B_BLOCK-20261008-120000-2" \
    "$OUT/live-$B_BIG-20261008-120000-4" "$JSON_OUT/live-$B_JSON-20261008-120000-3"
printf '{"terminal":"failed","error_kind":"x","error":"OLDRUN"}' \
    > "$OUT/live-$B_BLOCK-20261007-090000-1/result.json"
printf 'Why: required check failed\nBLOCKMARK\n' \
    > "$OUT/live-$B_BLOCK-20261008-120000-2/blocked-ship.txt"
printf '{"terminal":"failed","error_kind":"gh","error":"gh: gh pr create --title: JSONMARK"}' \
    > "$JSON_OUT/live-$B_JSON-20261008-120000-3/result.json"
{ head -c 5000 /dev/zero | tr '\0' 'x'; printf 'TAILMARK'; } \
    > "$OUT/live-$B_BIG-20261008-120000-4/blocked-ship.txt"
: > "$PNLOG"
SHARED_TMP=/tmp
if [ -e "$SHARED_TMP/$(basename "$PNLOG")" ]; then
    fail "fixture: fake runner log leaked into the shared /tmp"
else
    ok "fixture: fake runner log stays under the private POSTPLAN_LOG_DIR"
fi

STUB="$TMP/stub"; mkdir -p "$STUB"
cat > "$STUB/claude" <<STUBEOF
#!/bin/bash
pwd -P > "$TMP/claude.cwd"
echo "\$#" > "$TMP/claude.argc"
if [ "\$1" = "-p" ]; then cat > "$TMP/claude.prompt"; else printf '%s' "\$1" > "$TMP/claude.prompt"; fi
printf '%s\n' "\$@" >> "$TMP/claude.args"
# CLAUDE_STUB_EFFECT / CLAUDE_STUB_REPLY are test-only: a script to run, a file to print.
if [ -n "\${CLAUDE_STUB_EFFECT-}" ]; then bash "\$CLAUDE_STUB_EFFECT"; fi
if [ -n "\${CLAUDE_STUB_REPLY-}" ]; then cat "\$CLAUDE_STUB_REPLY"; fi
if [ -n "\${CLAUDE_STUB_STDERR-}" ]; then echo "\$CLAUDE_STUB_STDERR" >&2; fi
exit 0
STUBEOF
cat > "$STUB/gh" <<STUBEOF
#!/bin/bash
: > "$TMP/gh.called"
if [ "\$1 \$2 \$3" = "pr view 42" ]; then printf '%s\n' "$B_BLOCK"; exit 0; fi
exit 1
STUBEOF
chmod +x "$STUB/claude" "$STUB/gh"

# run_fix <script> <args...>: sets RC, ERR, STDOUT, PROMPT; clears the stub's records first.
run_fix() {
    local script="$1"; shift
    rm -f "$TMP/claude.cwd" "$TMP/claude.argc" "$TMP/claude.prompt" "$TMP/gh.called" "$TMP/claude.args"
    STDOUT=$(PATH="$STUB:$PATH" bash "$script" "$@" 2>"$TMP/err"); RC=$?
    ERR=$(cat "$TMP/err")
    PROMPT=""; [ -f "$TMP/claude.prompt" ] && PROMPT=$(cat "$TMP/claude.prompt")
}
no_claude() { if [ -e "$TMP/claude.argc" ]; then fail "$1" "claude was called"; else ok "$1"; fi; }

SUT="$MAIN/bin/postplan-fix"

# 1
run_fix "$SUT" --help
rc_is "1: --help exits 0" "$RC" 0
has "1: --help prints Usage" "$STDOUT" "Usage:"
no_claude "1: --help calls no claude"
if [ -e "$TMP/gh.called" ]; then fail "1: --help calls no gh"; else ok "1: --help calls no gh"; fi

# 2
run_fix "$SUT" --bogus
rc_is "2: unknown flag exits 2" "$RC" 2
has "2: unknown flag message" "$ERR" "unknown flag: --bogus"
no_claude "2: unknown flag calls no claude"

# 3
run_fix "$SUT"
rc_is "3: unset arg exits 2" "$RC" 2
has "3: unset arg message" "$ERR" "expected exactly one"
run_fix "$SUT" ""
rc_is "3: empty arg exits 2" "$RC" 2
has "3: empty arg message" "$ERR" "expected exactly one"
run_fix "$SUT" a b
rc_is "3: two args exit 2" "$RC" 2
no_claude "3: bad arg count calls no claude"

# 4
run_fix "$SUT" 999
rc_is "4: unknown PR exits 1" "$RC" 1
has "4: unknown PR message" "$ERR" "PR #999 not found"
no_claude "4: unknown PR calls no claude"

# 5
run_fix "$SUT" nosuch-branch
rc_is "5: unknown slug exits 1" "$RC" 1
has "5: unknown slug message" "$ERR" "no worktree has branch nosuch-branch"
no_claude "5: unknown slug calls no claude"

# 6
run_fix "$SUT" "$B_PREFIX"
rc_is "6: branch prefix exits 1" "$RC" 1
has "6: branch prefix message" "$ERR" "no worktree has branch"
no_claude "6: branch prefix calls no claude"

# 7
run_fix "$SUT" 42
rc_is "7: PR path exits 0" "$RC" 0
WANT_CWD=$(cd "$TMP/wt-$B_BLOCK" && pwd -P)
GOT_CWD=""; [ -f "$TMP/claude.cwd" ] && GOT_CWD=$(cat "$TMP/claude.cwd")
if [ "$GOT_CWD" = "$WANT_CWD" ]; then ok "7: claude runs in the branch worktree"; else fail "7: claude cwd" "got '$GOT_CWD'"; fi
GOT_ARGC=""; [ -f "$TMP/claude.argc" ] && GOT_ARGC=$(cat "$TMP/claude.argc")
if [ "$GOT_ARGC" = "1" ]; then ok "7: claude gets exactly one argv element"; else fail "7: claude argc" "got '$GOT_ARGC'"; fi
for tok in BLOCKMARK "ship blocked (exit 3)" "PR #42" "live-$B_BLOCK-20261008-120000-2" audit.log \
    blocked-ship.txt "$RUNLOG/post-plan-now-$B_BLOCK-" "Do not ship" "untrusted program output"; do
    has "7: prompt names '$tok'" "$PROMPT" "$tok"
done
hasnt "7: newest run wins (no OLDRUN)" "$PROMPT" "OLDRUN"

# 8
run_fix "$SUT" "$B_JSON"
rc_is "8: slug path exits 0" "$RC" 0
if [ -e "$TMP/gh.called" ]; then fail "8: gh not called for a slug"; else ok "8: gh not called for a slug"; fi
has "8: prompt carries the stage" "$PROMPT" "failed / gh"
has "8: prompt carries the error" "$PROMPT" "JSONMARK"
hasnt "8: no blocked-ship.txt line" "$PROMPT" "blocked-ship.txt:"

# 9
run_fix "$SUT" "$B_NORUN"
rc_is "9: no run dir still exits 0" "$RC" 0
has "9: prompt says no run dir" "$PROMPT" "no harness run dir found"
has "9: prompt says cause not recorded" "$PROMPT" "cause not recorded; read audit.log"

# 10
run_fix "$SUT" "$B_BIG"
rc_is "10: big text exits 0" "$RC" 0
hasnt "10: text is capped (no TAILMARK)" "$PROMPT" "TAILMARK"
if [ "${#PROMPT}" -lt 3000 ]; then ok "10: prompt under 3000 bytes"; else fail "10: prompt size" "${#PROMPT}"; fi

# 11
run_fix "$TMP/wt-$B_JSON/bin/postplan-fix" "$B_JSON"
rc_is "11: linked-worktree caller exits 0" "$RC" 0
has "11: worktree's own out dir found" "$PROMPT" "JSONMARK"
run_fix "$TMP/wt-$B_JSON/bin/postplan-fix" "$B_BLOCK"
rc_is "11: main out dir reached from a worktree exits 0" "$RC" 0
has "11: main out dir searched" "$PROMPT" "BLOCKMARK"

# 12
rm -f "$TMP/claude.prompt"
env -i POSTPLAN_LOG_DIR="$POSTPLAN_LOG_DIR" \
    IBL5_USAGE_GATE_STATE_DIR="$IBL5_USAGE_GATE_STATE_DIR" IBL5_USAGE_CLAUDE_PROJECTS="$IBL5_USAGE_CLAUDE_PROJECTS" IBL5_USAGE_GATE_TEST_MODE="$IBL5_USAGE_GATE_TEST_MODE" \
    PATH="$STUB:/usr/bin:/bin" /bin/bash -c 'set -euo pipefail; "$1" "$2"' _ "$SUT" "$B_BLOCK" \
    >/dev/null 2>"$TMP/err"; RC=$?
rc_is "12: env -i probe exits 0" "$RC" 0
PROMPT=""; [ -f "$TMP/claude.prompt" ] && PROMPT=$(cat "$TMP/claude.prompt")
has "12: env -i probe reaches claude with the text" "$PROMPT" "BLOCKMARK"
has "12: env -i probe finds the private runner log" "$PROMPT" "$RUNLOG/post-plan-now-$B_BLOCK-"

# 13
SAVED_RUNLOG_DIR="$POSTPLAN_LOG_DIR"
unset POSTPLAN_LOG_DIR
run_fix "$SUT" "$B_BLOCK"
rc_is "13: unset POSTPLAN_LOG_DIR still exits 0" "$RC" 0
hasnt "13: unset var does not read the private log dir" "$PROMPT" "$RUNLOG"
hasnt "13: unset var finds no shared-/tmp log for this slug" "$PROMPT" "post-plan-now log:"
export POSTPLAN_LOG_DIR=''
run_fix "$SUT" "$B_BLOCK"
rc_is "13: empty POSTPLAN_LOG_DIR still exits 0" "$RC" 0
hasnt "13: empty var does not read the private log dir" "$PROMPT" "$RUNLOG"
export POSTPLAN_LOG_DIR="$SAVED_RUNLOG_DIR"

# --- headless rescue mode (--headless [--dry-run]) ---
# Each case collects its checks with need() and reports once through h_pass as
# "case ok headless-<name>" (or one h_fail naming every failed check).
# Cases 14-24 start from the same state: B_CONFLICT at its feature tip, clean tree, and
# origin/<B_CONFLICT> at the fixture's init commit.
WTC="$TMP/wt-$B_CONFLICT"
TIP=$(git -C "$WTC" rev-parse HEAD)
WTP=$(git -C "$MAIN" worktree list --porcelain | awk -v b="refs/heads/$B_CONFLICT" '
    /^worktree / { p = substr($0, 10) }
    /^branch /   { if (substr($0, 8) == b && !f) { print p; f=1 } }
')
mkdir -p "$TMP/effects"
hl_bad=""
need() { local d="$1"; shift; if ! "$@"; then hl_bad+="$d; "; fi; }
case_end() {
    if [ -z "$hl_bad" ]; then h_pass "case ok $1"; else h_fail "$1" "$hl_bad"; fi
    hl_bad=""
}
has_s() { case "$1" in *"$2"*) return 0 ;; esac; return 1; }
ends_s() { case "$1" in *"$2") return 0 ;; esac; return 1; }
no_args() { [ ! -e "$TMP/claude.args" ]; }
hl_reset() {
    git -C "$WTC" merge --abort >/dev/null 2>&1 || true
    git -C "$WTC" reset -q --hard "$TIP"
    git -C "$WTC" clean -fdq
    git -C "$MAIN" update-ref "refs/remotes/origin/$B_CONFLICT" "$INIT_SHA"
    unset CLAUDE_STUB_REPLY CLAUDE_STUB_EFFECT CLAUDE_STUB_STDERR
}
no_merge() { ! git -C "$WTC" rev-parse -q --verify MERGE_HEAD >/dev/null; }
origin_branch() { git --git-dir="$TMP/origin.git" rev-parse "refs/heads/$B_CONFLICT" 2>/dev/null || echo none; }
printf 'SUMMARY: kept both\nRESOLVED\n' > "$TMP/reply-resolved"
printf 'SUMMARY: gave up\nFAILED\n' > "$TMP/reply-failed"
printf 'printf "feature\\nmaster\\n" > a.txt\ngit add a.txt\n' > "$TMP/effects/resolve.sh"
printf 'git update-ref "refs/remotes/origin/%s" HEAD\n' "$B_CONFLICT" > "$TMP/effects/moveref.sh"
MASTER_TIP=$(git -C "$MAIN" rev-parse refs/heads/master)
REAL_GIT=$(command -v git)
B_GONE="pfx$$-gone"; B_NEW="pfx$$-new"; R_SIB="refs/remotes/origin/$B_CONFLICT-sib"
RESTORE_MSG="postplan-fix: restore after session moved refs"
{ cat "$TMP/effects/resolve.sh"; printf 'git update-ref refs/heads/master %s\n' "$INIT_SHA"; } \
    > "$TMP/effects/move-master.sh"
{ cat "$TMP/effects/resolve.sh"
  printf 'git update-ref refs/heads/%s %s\n' "$B_NEW" "$INIT_SHA"
  printf 'git update-ref -d refs/heads/%s\n' "$B_GONE"
  printf 'git update-ref %s %s\n' "$R_SIB" "$INIT_SHA"; } > "$TMP/effects/branch-churn.sh"
printf 'git update-ref -d "refs/remotes/origin/%s"\n' "$B_CONFLICT" > "$TMP/effects/delref.sh"
# Test-only git shim: just before postplan-fix's restore update-ref runs, move the
# own remote-tracking ref once more, as a concurrent fetch would.
mkdir -p "$TMP/gitshim"
cat > "$TMP/gitshim/git" <<SHIMEOF
#!/bin/bash
case " \$* " in
    *" $RESTORE_MSG "*)
        if [ ! -e "$TMP/race.done" ]; then
            : > "$TMP/race.done"
            "$REAL_GIT" -C "$MAIN" update-ref "refs/remotes/origin/$B_CONFLICT" "$MASTER_TIP"
        fi ;;
esac
exec "$REAL_GIT" "\$@"
SHIMEOF
chmod +x "$TMP/gitshim/git"
printf 'printf "feature\\nmaster\\n" > a.txt\ngit add a.txt\nprintf stray > stray.txt\n' > "$TMP/effects/untracked.sh"

# 14
hl_reset
for args in "--headless=1 x" "--dry-run x" "--bogus"; do
    # shellcheck disable=SC2086
    run_fix "$SUT" $args
    need "rc 2 for '$args'" test "$RC" = 2
    if has_s "$ERR" "unknown flag" || has_s "$ERR" "needs --headless"; then :; else hl_bad+="message for '$args'; "; fi
    need "no stub call for '$args'" no_args
done
case_end headless-reject-forms

# 15
hl_reset
ORIGIN0=$(git --git-dir="$TMP/origin.git" rev-parse refs/heads/master)
REMOTE0=$(git -C "$WTC" rev-parse refs/remotes/origin/master)
run_fix "$SUT" --headless --dry-run "$B_CONFLICT"
need "rc 0" test "$RC" = 0
need "no stub call" no_args
need "origin.git unchanged" test "$(git --git-dir="$TMP/origin.git" rev-parse refs/heads/master)" = "$ORIGIN0"
need "origin/master unchanged" test "$(git -C "$WTC" rev-parse refs/remotes/origin/master)" = "$REMOTE0"
need "no MERGE_HEAD" no_merge
# shellcheck disable=SC2088  # the prompt holds a literal ~/claude-plans/
for tok in "argv:" "--model" "claude-sonnet-5-5" "--disallowedTools" "Bash(git push:*)" "Bash(gh:*)" \
    "Bash(git -C:*)" "--max-budget-usd" "SUMMARY:" "RESOLVED" "FAILED" "Do NOT commit" "~/claude-plans/"; do
    need "stdout has '$tok'" has_s "$STDOUT" "$tok"
done
case_end headless-dry-run

# 16
hl_reset
run_fix "$SUT" --headless master
need "rc 2" test "$RC" = 2
need "message" has_s "$ERR" "refuses the main checkout"
need "no stub call" no_args
need "origin/master unchanged (no fetch)" test "$(git -C "$WTC" rev-parse refs/remotes/origin/master)" = "$REMOTE0"
case_end headless-refuses-main

# 17
hl_reset
printf 'x\n' > "$WTC/untracked.txt"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "message" has_s "$ERR" "worktree is dirty"
need "no MERGE_HEAD" no_merge
need "no stub call" no_args
case_end headless-dirty-tree

# 18
hl_reset
ORIGIN_BR0=$(origin_branch)
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/resolve.sh"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 0 (stderr: $ERR)" test "$RC" = 0
need "merge commit parents" test "$(git -C "$WTC" log -1 --format=%P)" = "$TIP $(git -C "$WTC" rev-parse refs/remotes/origin/master)"
need "origin branch unchanged" test "$(origin_branch)" = "$ORIGIN_BR0"
need "stub cwd is the worktree" test "$(cat "$TMP/claude.cwd" 2>/dev/null)" = "$(cd "$WTC" && pwd -P)"
need "stdout says nothing pushed" has_s "$STDOUT" "nothing pushed"
need "stdout ends with the ship line" ends_s "$STDOUT" "cd $WTP && bin/post-plan-now"
need "a.txt resolved" test "$(cat "$WTC/a.txt")" = "$(printf 'feature\nmaster')"
case_end headless-resolves-and-commits

# 19
hl_reset
export CLAUDE_STUB_REPLY="$TMP/reply-failed"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "no MERGE_HEAD" no_merge
need "HEAD is the branch tip" test "$(git -C "$WTC" rev-parse HEAD)" = "$TIP"
need "a.txt is feature" test "$(cat "$WTC/a.txt")" = "feature"
need "stderr names the verdict" has_s "$ERR" "session ended FAILED"
case_end headless-failed-verdict

# 20
hl_reset
printf 'RESOLVED\n' > "$TMP/reply-bare-resolved"
export CLAUDE_STUB_REPLY="$TMP/reply-bare-resolved"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "stderr names the markers (got: $ERR)" has_s "$ERR" "conflict markers remain"
need "no MERGE_HEAD" no_merge
need "HEAD is the branch tip" test "$(git -C "$WTC" rev-parse HEAD)" = "$TIP"
case_end headless-markers-remain

# 21
hl_reset
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/moveref.sh"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "stderr names moved refs" has_s "$ERR" "session moved refs"
need "ref restored" test "$(git -C "$WTC" rev-parse "refs/remotes/origin/$B_CONFLICT")" = "$INIT_SHA"
need "restore reflog message" test "$(git -C "$WTC" reflog show -1 --format=%gs "refs/remotes/origin/$B_CONFLICT")" = "postplan-fix: restore after session moved refs"
need "no MERGE_HEAD" no_merge
case_end headless-moved-ref

# 21b: a stray untracked file outside the remit aborts the run
hl_reset
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/untracked.sh"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "stderr names the stray path (got: $ERR)" has_s "$ERR" "session touched stray.txt outside its remit"
need "no MERGE_HEAD" no_merge
case_end headless-untracked-outside-remit

# 21c: the prompt arrives on stdin, and stderr noise after RESOLVED does not flip the verdict
hl_reset
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/resolve.sh"
export CLAUDE_STUB_STDERR="warning: late stderr line"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 0 (stderr: $ERR)" test "$RC" = 0
need "prompt read from stdin" has_s "$PROMPT" "Headless remit"
need "prompt is not an argv element" test "$(grep -c 'Headless remit' "$TMP/claude.args")" = 0
case_end headless-stdin-and-stderr

# 21d: another checkout moving refs/heads/master during the session is kept, not rolled back
hl_reset
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/move-master.sh"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 0 (stderr: $ERR)" test "$RC" = 0
need "no session-moved-refs abort" eval '! has_s "$ERR" "session moved refs"'
need "master keeps its new value" test "$(git -C "$MAIN" rev-parse refs/heads/master)" = "$INIT_SHA"
need "no restore entry in master's reflog" eval '! git -C "$MAIN" reflog show -1 --format=%gs refs/heads/master | grep -qF "$RESTORE_MSG"'
git -C "$MAIN" update-ref refs/heads/master "$MASTER_TIP"
case_end headless-unrelated-master-moved

# 21e: an unrelated branch created and another deleted during the session stay that way
hl_reset
git -C "$MAIN" update-ref "refs/heads/$B_GONE" "$INIT_SHA"
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/branch-churn.sh"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 0 (stderr: $ERR)" test "$RC" = 0
need "no session-moved-refs abort" eval '! has_s "$ERR" "session moved refs"'
need "created branch kept" git -C "$MAIN" rev-parse -q --verify "refs/heads/$B_NEW"
need "deleted branch stays deleted" eval '! git -C "$MAIN" rev-parse -q --verify "refs/heads/$B_GONE"'
need "name-prefix sibling ref kept" git -C "$MAIN" rev-parse -q --verify "$R_SIB"
git -C "$MAIN" update-ref -d "refs/heads/$B_NEW"
git -C "$MAIN" update-ref -d "$R_SIB"
case_end headless-unrelated-branch-churn

# 21f: the own ref moves again after REFS1 is read; the CAS restore leaves the new value
hl_reset
rm -f "$TMP/race.done"
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/moveref.sh"
PATH="$TMP/gitshim:$PATH" run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "shim raced the restore" test -e "$TMP/race.done"
need "stderr names moved refs" has_s "$ERR" "session moved refs"
need "stderr names the CAS miss" has_s "$ERR" "moved again after the session; left as is"
need "raced value survives" test "$(git -C "$WTC" rev-parse "refs/remotes/origin/$B_CONFLICT")" = "$MASTER_TIP"
need "no MERGE_HEAD" no_merge
case_end headless-restore-cas

# 21g: the session deleted its own remote-tracking ref; restore recreates it
hl_reset
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/delref.sh"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "stderr names moved refs" has_s "$ERR" "session moved refs"
need "ref recreated" test "$(git -C "$WTC" rev-parse -q --verify "refs/remotes/origin/$B_CONFLICT")" = "$INIT_SHA"
need "restore reflog message" test "$(git -C "$WTC" reflog show -1 --format=%gs "refs/remotes/origin/$B_CONFLICT")" = "$RESTORE_MSG"
case_end headless-own-ref-deleted

# 21h: the session created its own remote-tracking ref; restore deletes it
hl_reset
git -C "$MAIN" update-ref -d "refs/remotes/origin/$B_CONFLICT"
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/moveref.sh"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "stderr names moved refs" has_s "$ERR" "session moved refs"
need "created own ref removed" eval '! git -C "$WTC" rev-parse -q --verify "refs/remotes/origin/$B_CONFLICT"'
case_end headless-own-ref-created

# 21i: a sibling ref under the own remote ref's name is not an own-ref move
hl_reset
git -C "$MAIN" update-ref -d "refs/remotes/origin/$B_CONFLICT"
printf 'git update-ref "refs/remotes/origin/%s/x" %s\n' "$B_CONFLICT" "$INIT_SHA" > "$TMP/effects/sibling.sh"
export CLAUDE_STUB_REPLY="$TMP/reply-failed" CLAUDE_STUB_EFFECT="$TMP/effects/sibling.sh"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "no session-moved-refs abort" eval '! has_s "$ERR" "session moved refs"'
need "stderr names the verdict" has_s "$ERR" "session ended FAILED"
need "sibling ref kept" git -C "$MAIN" rev-parse -q --verify "refs/remotes/origin/$B_CONFLICT/x"
git -C "$MAIN" update-ref -d "refs/remotes/origin/$B_CONFLICT/x"
case_end headless-own-ref-sibling

# 22
hl_reset
run_fix "$SUT" --headless "$B_CLEAN"
need "rc 0" test "$RC" = 0
need "stdout says merges cleanly" has_s "$STDOUT" "merges cleanly"
need "no stub call" no_args
case_end headless-clean-merge

# 23
hl_reset
MAIN2="$TMP/main2"
git init -q "$MAIN2"
mkdir -p "$MAIN2/bin"
cp "$ROOT/bin/postplan-fix" "$MAIN2/bin/postplan-fix"
cp -R "$ROOT/bin/lib" "$MAIN2/bin/lib"
git -C "$MAIN2" add -A
git -C "$MAIN2" commit -qm init
git -C "$MAIN2" worktree add -q -b "$B_CONFLICT" "$TMP/wt2-$B_CONFLICT"
run_fix "$MAIN2/bin/postplan-fix" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "message" has_s "$ERR" "denied-tool list unavailable"
need "no stub call" no_args
case_end headless-no-harness

# 24
hl_reset
mkdir -p "$TMP/home"
env -i PATH=/usr/bin:/bin HOME="$TMP/home" POSTPLAN_LOG_DIR="$RUNLOG" \
    bash -o pipefail "$SUT" --headless --dry-run "$B_CONFLICT" >/dev/null 2>"$TMP/err"; RC=$?
ERR=$(cat "$TMP/err")
need "rc 0 (stderr: $ERR)" test "$RC" = 0
case_end headless-env-i

h_done
