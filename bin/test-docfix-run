    && grep -qF 'docs/b.md' "$OUTF37" \
    && grep -qF 'https://example.com/pull/77' "$OUTF37"; } \
  && ok "(37) lib: docfix_dm_compose rc 0; out-file has PR#, paths, URL" \
  || bad "(37) lib: docfix_dm_compose failed"

