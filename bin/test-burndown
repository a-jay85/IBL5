printf '{}\n' > "$BAD36"
OUT="$(GH_LOG="$T/gh.log" GH_FX_DIR="$T/fx" \
    BACKLOG_GH="$T/gh" BURNDOWN_GIT="$T/git" BURNDOWN_TIER_HINT="$T/tier" \
    HOME="$T/home" "$SCRIPT" burndown-status "$BAD36" 2>&1)"; RC=$?
[ "$RC" -eq 3 ] && ok "C36: bad ledger → exit 3" || fail "C36: bad ledger → exit 3 (got $RC)"
want "C36: bad ledger message" "$OUT" "malformed or missing ledger"
rm -f "$BAD36"

# ── C37: close-merged happy path ─────────────────────────────────────────────
LEDGER37="$T/home/claude-plans/_reports/burndown-batch-20260927T130000.json"
cp "$LEDGER_C33" "$LEDGER37"
rm -f "$T/gh.log"
OUT="$(GH_LOG="$T/gh.log" GH_FX_DIR="$T/fx" \
    BACKLOG_GH="$T/gh" BURNDOWN_GIT="$T/git" BURNDOWN_TIER_HINT="$T/tier" \
    HOME="$T/home" "$SCRIPT" burndown-close-merged "$LEDGER37" 2>&1)"; RC=$?
# Issue close calls: 80 and 81 (also_closes), NOT 82 (plan), NOT 83 (open), NOT 85 (unknown)
grep -qF 'issue close 80' "$T/gh.log" && ok "C37: closes #80" || fail "C37: closes #80"
grep -qF 'issue close 81' "$T/gh.log" && ok "C37: closes #81" || fail "C37: closes #81"
grep -qF 'issue close 82' "$T/gh.log" && fail "C37: no close #82" || ok "C37: no close #82"
grep -qF 'issue close 83' "$T/gh.log" && fail "C37: no close #83" || ok "C37: no close #83"
grep -qF 'issue close 85' "$T/gh.log" && fail "C37: no close #85" || ok "C37: no close #85"
# #80 and #82 should have status=merged in ledger
[ "$(jq -r '.items[] | select(.issue_num==80) | .status' "$LEDGER37")" = "merged" ] \
    && ok "C37: #80 status=merged" || fail "C37: #80 status=merged"
[ "$(jq -r '.items[] | select(.issue_num==82) | .status' "$LEDGER37")" = "merged" ] \
    && ok "C37: #82 status=merged" || fail "C37: #82 status=merged"
[ "$(jq -r '.items[] | select(.issue_num==83) | .status' "$LEDGER37")" = "shipped" ] \
    && ok "C37: #83 stays shipped" || fail "C37: #83 stays shipped"
# #85 is unknown → SKIP → exit 1
[ "$RC" -eq 1 ] && ok "C37: exit 1 (SKIP present)" || fail "C37: exit 1 (SKIP present, got $RC)"
grep -qE 'SKIP #85' <<< "$OUT" && ok "C37: SKIP #85 row" || fail "C37: SKIP #85 row"

# ── C38: idempotent re-run ────────────────────────────────────────────────────
rm -f "$T/gh.log"
OUT="$(GH_LOG="$T/gh.log" GH_FX_DIR="$T/fx" \
    BACKLOG_GH="$T/gh" BURNDOWN_GIT="$T/git" BURNDOWN_TIER_HINT="$T/tier" \
    HOME="$T/home" "$SCRIPT" burndown-close-merged "$LEDGER37" 2>&1)"
CLOSE_COUNT="$(grep 'issue close' "$T/gh.log" 2>/dev/null | wc -l | tr -d ' ')"
[ "$CLOSE_COUNT" -eq 0 ] && ok "C38: idempotent (zero close calls)" \
    || fail "C38: idempotent (zero close calls, got $CLOSE_COUNT)"
rm -f "$LEDGER37"

# ── C39: already-closed issue ────────────────────────────────────────────────
LEDGER39="$T/home/claude-plans/_reports/burndown-batch-20260927T140000.json"
cp "$LEDGER_C33" "$LEDGER39"
# Make issue 81 already CLOSED
printf '{"state":"CLOSED"}\n' > "$T/fx/issue-81.json"
rm -f "$T/gh.log"
OUT="$(GH_LOG="$T/gh.log" GH_FX_DIR="$T/fx" \
    BACKLOG_GH="$T/gh" BURNDOWN_GIT="$T/git" BURNDOWN_TIER_HINT="$T/tier" \
    HOME="$T/home" "$SCRIPT" burndown-close-merged "$LEDGER39" 2>&1)"
grep -qF 'issue close 81' "$T/gh.log" && fail "C39: no close #81 (already CLOSED)" \
    || ok "C39: no close #81 (already CLOSED)"
[ "$(jq -r '.items[] | select(.issue_num==80) | .status' "$LEDGER39")" = "merged" ] \
    && ok "C39: #80 still reaches merged" || fail "C39: #80 still reaches merged"
# Restore issue-81 to OPEN for any further tests
printf '{"state":"OPEN"}\n' > "$T/fx/issue-81.json"
rm -f "$LEDGER39"

# ── C40: partial close failure ────────────────────────────────────────────────
LEDGER40="$T/home/claude-plans/_reports/burndown-batch-20260927T150000.json"
cp "$LEDGER_C33" "$LEDGER40"
rm -f "$T/gh.log"
OUT="$(GH_FAIL_ON="issue close 81" GH_LOG="$T/gh.log" GH_FX_DIR="$T/fx" \
    BACKLOG_GH="$T/gh" BURNDOWN_GIT="$T/git" BURNDOWN_TIER_HINT="$T/tier" \
    HOME="$T/home" "$SCRIPT" burndown-close-merged "$LEDGER40" 2>&1)"; RC=$?
[ "$RC" -eq 1 ] && ok "C40: partial fail exits 1" || fail "C40: partial fail exits 1 (got $RC)"
grep -qE 'FAIL #80' <<< "$OUT" && ok "C40: FAIL #80 row" || fail "C40: FAIL #80 row"
[ "$(jq -r '.items[] | select(.issue_num==80) | .status' "$LEDGER40")" != "merged" ] \
    && ok "C40: #80 ledger unchanged on failure" || fail "C40: #80 ledger unchanged on failure"
rm -f "$LEDGER40"

# ── C47: close-merged characterization pins (guard the Phase 4 extraction) ───
# C47a: literal golden stdout. Literal text, never a captured baseline.
LEDGER47="$T/home/claude-plans/_reports/burndown-batch-20260927T160000.json"
cp "$LEDGER_C33" "$LEDGER47"
rm -f "$T/gh.log"
OUT="$(bd burndown-close-merged "$LEDGER47" 2>/dev/null)"; RC=$?
C47_WANT='DONE #80 closed
DONE #82 plan PR merged
WAIT #83 open
WAIT #84 queued
SKIP #85 unknown (2 PRs for head fix-85)'
[ "$OUT" = "$C47_WANT" ] && ok "C47a: close-merged stdout golden" \
    || fail "C47a: close-merged stdout golden (got: $OUT)"
[ "$RC" -eq 1 ] && ok "C47a: exit 1 with a SKIP row" || fail "C47a: exit 1 (got $RC)"
# C47b: pr_url recorded on merge, both routes
[ "$(jq -r '.items[] | select(.issue_num==80) | .pr_url' "$LEDGER47")" \
    = "https://github.com/a-jay85/IBL5/pull/880" ] \
    && ok "C47b: #80 pr_url recorded" || fail "C47b: #80 pr_url recorded"
[ "$(jq -r '.items[] | select(.issue_num==82) | .pr_url' "$LEDGER47")" \
    = "https://github.com/a-jay85/IBL5/pull/882" ] \
    && ok "C47b: #82 pr_url recorded" || fail "C47b: #82 pr_url recorded"
# C47c: close comment names the calling subcommand
grep -qF 'Closed by bin/backlog burndown-close-merged from burndown-batch-20260927T160000.json' \
    "$T/gh.log" && ok "C47c: close comment names burndown-close-merged" \
    || fail "C47c: close comment names burndown-close-merged"
rm -f "$LEDGER47"

# C47d: pr-closed PR -> WAIT, no close, status unchanged
printf '[{"url":"https://github.com/a-jay85/IBL5/pull/886","state":"CLOSED"}]\n' \
    > "$T/fx/pr-fix-86.json"
LEDGER47D="$T/home/claude-plans/_reports/burndown-batch-20260927T161000.json"
jq '.items = [{"issue_num":86,"also_closes":[],"issue_title":"Fix eighty-six","rank":"P2","tier":"default","cost":1,"paths":["bin/fix86"],"route":"ad-hoc","slug":"fix-86","pr_url":"","status":"shipped"}]' \
    "$LEDGER_C33" > "$LEDGER47D"
rm -f "$T/gh.log"
OUT="$(bd burndown-close-merged "$LEDGER47D" 2>/dev/null)"; RC=$?
[ "$OUT" = "WAIT #86 pr-closed" ] && ok "C47d: pr-closed prints WAIT" \
    || fail "C47d: pr-closed prints WAIT (got: $OUT)"
[ "$RC" -eq 0 ] && ok "C47d: pr-closed exits 0" || fail "C47d: pr-closed exits 0 (got $RC)"
grep -qF 'issue close' "$T/gh.log" && fail "C47d: no close on pr-closed" \
    || ok "C47d: no close on pr-closed"
[ "$(jq -r '.items[0].status' "$LEDGER47D")" = "shipped" ] \
    && ok "C47d: #86 stays shipped" || fail "C47d: #86 stays shipped"
rm -f "$LEDGER47D"

# C47e: gh pr list failure -> SKIP unknown (gh failed), exit 1, nothing closed, ledger byte-identical
LEDGER47E="$T/home/claude-plans/_reports/burndown-batch-20260927T162000.json"
cp "$LEDGER_C33" "$LEDGER47E"
cp "$LEDGER47E" "$T/c47e.before"
rm -f "$T/gh.log"
OUT="$(GH_FAIL_ON="pr list" bd burndown-close-merged "$LEDGER47E" 2>/dev/null)"; RC=$?
[ "$RC" -eq 1 ] && ok "C47e: gh failure exits 1" || fail "C47e: gh failure exits 1 (got $RC)"
grep -qF 'SKIP #80 unknown (gh failed)' <<< "$OUT" && ok "C47e: SKIP #80 unknown" \
    || fail "C47e: SKIP #80 unknown (got: $OUT)"
grep -qF 'issue close' "$T/gh.log" && fail "C47e: no close on unknown" \
    || ok "C47e: no close on unknown"
cmp -s "$T/c47e.before" "$LEDGER47E" && ok "C47e: ledger byte-identical" \
    || fail "C47e: ledger byte-identical"
rm -f "$LEDGER47E" "$T/c47e.before"

# ── C50: burndown-sweep ───────────────────────────────────────────────────────
# Private HOME so the shared $T/home ledgers never leak into the walk.
# BURNDOWN_NOW=1790726400 is 2026-09-30T00:00:00Z, so the zombie cutoff is 2026-09-29T00:00:00.
SW="$T/sw"
SWQ="$SW/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/automouse/queue"
SW_OLD="$SW/claude-plans/_reports/burndown-batch-20260927T100000.json"
SW_NEW="$SW/claude-plans/_reports/burndown-batch-20260929T230000.json"
SW_NOW=1790726400
printf '[{"url":"https://github.com/a-jay85/IBL5/pull/1190","state":"MERGED"}]\n' > "$T/fx/pr-fix-190.json"
printf '[{"url":"https://github.com/a-jay85/IBL5/pull/1196","state":"OPEN"}]\n' > "$T/fx/pr-fix-196.json"
for s in zombie-192 stale-193 live-194 young-197; do printf '[]\n' > "$T/fx/pr-$s.json"; done
printf '{"state":"OPEN"}\n' > "$T/fx/issue-190.json"
printf '{"state":"OPEN"}\n' > "$T/fx/issue-191.json"

sw_reset() {
    rm -rf "$SW"
    mkdir -p "$SW/claude-plans/_reports" "$SWQ"
    cat > "$SW_OLD" <<'JSON'
{
  "schema": 1,
  "created": "2026-09-27T10:00:00",
  "items": [
    {"issue_num":190,"also_closes":[191],"issue_title":"Fix 190","rank":"P1","tier":"default","cost":1,"paths":["bin/a"],"route":"ad-hoc","slug":"fix-190","pr_url":"","status":"shipped"},
    {"issue_num":192,"also_closes":[],"issue_title":"Zombie 192","rank":"P2","tier":"default","cost":1,"paths":["bin/b"],"route":"plan","slug":"zombie-192","pr_url":"","status":"queued"},
    {"issue_num":193,"also_closes":[],"issue_title":"Stale 193","rank":"P2","tier":"default","cost":1,"paths":["bin/c"],"route":"plan","slug":"stale-193","pr_url":"","status":"queued"},
    {"issue_num":194,"also_closes":[],"issue_title":"Live 194","rank":"P2","tier":"default","cost":1,"paths":["bin/d"],"route":"plan","slug":"live-194","pr_url":"","status":"queued"},
    {"issue_num":195,"also_closes":[],"issue_title":"Slugless 195","rank":"P2","tier":"default","cost":1,"paths":["bin/e"],"route":"plan","slug":"","pr_url":"","status":"queued"},
    {"issue_num":196,"also_closes":[],"issue_title":"Fix 196","rank":"P2","tier":"default","cost":1,"paths":["bin/f"],"route":"ad-hoc","slug":"fix-196","pr_url":"","status":"shipped"}
  ],
  "skipped": [],
  "units_used": 5,
  "budget": 5
}
JSON
    cat > "$SW_NEW" <<'JSON'
{
  "schema": 1,
  "created": "2026-09-29T23:00:00",
  "items": [
    {"issue_num":197,"also_closes":[],"issue_title":"Young 197","rank":"P2","tier":"default","cost":1,"paths":["bin/g"],"route":"plan","slug":"young-197","pr_url":"","status":"queued"}
  ],
  "skipped": [],
  "units_used": 1,
  "budget": 5
}
JSON
    touch "$SW/claude-plans/stale-193.md" "$SWQ/live-194.md"
    rm -f "$T/gh.log"
}
sw_item() { jq -r --argjson n "$2" --arg k "$3" '.items[] | select(.issue_num==$n) | .[$k]' "$1"; }

sw_reset
OUT="$(BURNDOWN_NOW=$SW_NOW bd_home "$SW" burndown-sweep 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "C50a: sweep exits 0" || fail "C50a: sweep exits 0 (got $RC: $OUT)"
grep -qF 'issue close 190' "$T/gh.log" && grep -qF 'issue close 191' "$T/gh.log" \
    && grep -qF 'Closed by bin/backlog burndown-sweep from burndown-batch-20260927T100000.json' "$T/gh.log" \
    && ok "C50a: merged ad-hoc issue and also_closes closed by sweep" \
    || fail "C50a: merged ad-hoc issue and also_closes closed by sweep"
[ "$(sw_item "$SW_OLD" 190 status)" = "merged" ] \
    && [ "$(sw_item "$SW_OLD" 190 pr_url)" = "https://github.com/a-jay85/IBL5/pull/1190" ] \
    && ok "C50a: #190 merged with pr_url" || fail "C50a: #190 merged with pr_url"
[ "$(sw_item "$SW_OLD" 192 status)" = "skipped" ] && grep -qF 'ZOMBIE #192' <<< "$OUT" \
    && ok "C50b: zombie flipped to skipped" || fail "C50b: zombie flipped to skipped (got: $OUT)"
[ "$(sw_item "$SW_OLD" 193 status)" = "queued" ] && grep -qF 'STALE-PLAN #193' <<< "$OUT" \
    && ok "C50c: STALE-PLAN reported, not flipped" || fail "C50c: STALE-PLAN reported, not flipped (got: $OUT)"
[ "$(sw_item "$SW_OLD" 194 status)" = "queued" ] && [ "$(sw_item "$SW_OLD" 195 status)" = "queued" ] \
    && [ "$(sw_item "$SW_NEW" 197 status)" = "queued" ] \
    && ok "C50d: queue-entry, slug-less and young items stay queued" \
    || fail "C50d: queue-entry, slug-less and young items stay queued"
[ "$(sw_item "$SW_OLD" 196 pr_url)" = "https://github.com/a-jay85/IBL5/pull/1196" ] \
    && [ "$(sw_item "$SW_OLD" 196 status)" = "shipped" ] \
    && ok "C50e: open PR backfills pr_url, status unchanged" \
    || fail "C50e: open PR backfills pr_url, status unchanged"
L_OLD="$(grep -nF 'ledger burndown-batch-20260927T100000.json' <<< "$OUT" | cut -d: -f1)"
L_NEW="$(grep -nF 'ledger burndown-batch-20260929T230000.json' <<< "$OUT" | cut -d: -f1)"
[ -n "$L_OLD" ] && [ -n "$L_NEW" ] && [ "$L_OLD" -lt "$L_NEW" ] \
    && ok "C50f: ledgers walked oldest to newest" || fail "C50f: ledgers walked oldest to newest"

rm -f "$T/gh.log"
OUT="$(BURNDOWN_NOW=$SW_NOW bd_home "$SW" burndown-sweep 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ! grep -qF 'issue close' "$T/gh.log" \
    && ok "C50g: re-run is idempotent" || fail "C50g: re-run is idempotent (got $RC: $OUT)"

sw_reset
cp "$SW_OLD" "$T/sw-old.before"; cp "$SW_NEW" "$T/sw-new.before"
OUT="$(BURNDOWN_NOW=$SW_NOW GH_FAIL_ON="pr list" bd_home "$SW" burndown-sweep 2>&1)"; RC=$?
[ "$RC" -eq 1 ] && ! grep -qF 'issue close' "$T/gh.log" \
    && cmp -s "$T/sw-old.before" "$SW_OLD" && cmp -s "$T/sw-new.before" "$SW_NEW" \
    && ok "C50h: unknown state exits 1, nothing closed, ledgers untouched" \
    || fail "C50h: unknown state exits 1, nothing closed, ledgers untouched (got $RC: $OUT)"

sw_reset
printf '{"not_items":1}\n' > "$SW/claude-plans/_reports/burndown-batch-20260930T000000.json"
cp "$SW_OLD" "$T/sw-old.before"
OUT="$(BURNDOWN_NOW=$SW_NOW bd_home "$SW" burndown-sweep 2>&1)"; RC=$?
[ "$RC" -eq 3 ] && grep -qF 'malformed ledger' <<< "$OUT" && [ ! -s "$T/gh.log" ] \
    && cmp -s "$T/sw-old.before" "$SW_OLD" \
    && ok "C50i: malformed newest ledger exits 3 before any gh call" \
    || fail "C50i: malformed newest ledger exits 3 before any gh call (got $RC: $OUT)"

mkdir -p "$T/sw-empty/claude-plans/_reports"
OUT="$(BURNDOWN_NOW=$SW_NOW bd_home "$T/sw-empty" burndown-sweep 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && grep -qF 'sweep: no burndown ledgers' <<< "$OUT" \
    && ok "C50j: no ledgers exits 0 with a note" || fail "C50j: no ledgers exits 0 with a note (got $RC: $OUT)"

sw_reset
OUT="$( (unset BURNDOWN_NOW; bd_home "$SW" burndown-sweep) 2>&1)"; RC=$?
[ "$(sw_item "$SW_OLD" 192 status)" = "skipped" ] \
    && ok "C50k-unset: unset BURNDOWN_NOW uses the real clock" \
    || fail "C50k-unset: unset BURNDOWN_NOW uses the real clock (got $RC: $OUT)"
sw_reset
# A colon-less default (${BURNDOWN_NOW-}) would keep the empty string, fail the numeric check and die 3.
OUT="$(BURNDOWN_NOW="" bd_home "$SW" burndown-sweep 2>&1)"; RC=$?
[ "$(sw_item "$SW_OLD" 192 status)" = "skipped" ] \
    && ok "C50k-empty: empty BURNDOWN_NOW uses the real clock" \
    || fail "C50k-empty: empty BURNDOWN_NOW uses the real clock (got $RC: $OUT)"

sw_reset
cp "$SW_OLD" "$T/sw-old.before"; cp "$SW_NEW" "$T/sw-new.before"
OUT="$(BURNDOWN_NOW=abc bd_home "$SW" burndown-sweep 2>&1)"; RC=$?
[ "$RC" -eq 3 ] && grep -qF 'BURNDOWN_NOW' <<< "$OUT" && [ ! -s "$T/gh.log" ] \
    && cmp -s "$T/sw-old.before" "$SW_OLD" && cmp -s "$T/sw-new.before" "$SW_NEW" \
    && ok "C50l: non-numeric BURNDOWN_NOW exits 3 before any gh call" \
    || fail "C50l: non-numeric BURNDOWN_NOW exits 3 before any gh call (got $RC: $OUT)"

# C50m: the 24h boundary is strict (created == cutoff is not a zombie)
sw_reset
jq '.created = "2026-09-29T00:00:00"' "$SW_OLD" > "$T/sw-tmp.json" && cp "$T/sw-tmp.json" "$SW_OLD"
BURNDOWN_NOW=$SW_NOW bd_home "$SW" burndown-sweep >/dev/null 2>&1
S_AT="$(sw_item "$SW_OLD" 192 status)"
sw_reset
jq '.created = "2026-09-28T23:59:59"' "$SW_OLD" > "$T/sw-tmp.json" && cp "$T/sw-tmp.json" "$SW_OLD"
BURNDOWN_NOW=$SW_NOW bd_home "$SW" burndown-sweep >/dev/null 2>&1
S_BEFORE="$(sw_item "$SW_OLD" 192 status)"
[ "$S_AT" = "queued" ] && [ "$S_BEFORE" = "skipped" ] \
    && ok "C50m: 24h boundary is strict" || fail "C50m: 24h boundary is strict (at=$S_AT before=$S_BEFORE)"

# C50n: a ledger without .created is never a zombie
sw_reset
jq 'del(.created)' "$SW_OLD" > "$T/sw-tmp.json" && cp "$T/sw-tmp.json" "$SW_OLD"
BURNDOWN_NOW=$SW_NOW bd_home "$SW" burndown-sweep >/dev/null 2>&1
[ "$(sw_item "$SW_OLD" 192 status)" = "queued" ] \
    && ok "C50n: missing .created is never a zombie" || fail "C50n: missing .created is never a zombie"
rm -rf "$SW" "$T/sw-empty" "$T/sw-old.before" "$T/sw-new.before" "$T/sw-tmp.json"

OUT="$(bd burndown-sweep extra 2>&1)"; RC=$?
[ "$RC" -eq 2 ] && ok "C50o: burndown-sweep with an argument exits 2" \
    || fail "C50o: burndown-sweep with an argument exits 2 (got $RC)"

# ── Phase 6: env-seam cases ───────────────────────────────────────────────────

# Restore C14 fixture for C41/C42
cat > "$T/fx/issues.json" <<'JSON'
[
  {"number":100,"title":"Hundred","body":"bin/a:1 title thing","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":101,"title":"Hundred-one","body":"bin/b:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":102,"title":"Hundred-two","body":"bin/c:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":103,"title":"Hundred-three","body":"bin/d:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":104,"title":"Hundred-four","body":"bin/e:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":105,"title":"Hundred-five","body":"bin/f:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]}
]
JSON
echo '[]' > "$T/fx/prs-open.json"
touch "$T/fx/worktrees.txt"

# ── C41: BURNDOWN_TIER_HINT unset — real bin/plan-tier-hint runs ──────────────
rm -f "$T/home/claude-plans/_reports"/burndown-batch-[0-9]*.json
OUT="$(env -u BURNDOWN_TIER_HINT GH_LOG="$T/gh.log" GH_FX_DIR="$T/fx" \
    BACKLOG_GH="$T/gh" BURNDOWN_GIT="$T/git" \
    HOME="$T/home" "$SCRIPT" burndown 2>&1)"; RC=$?
C41_LEDGER_LINE="$(grep '^LEDGER: ' <<< "$OUT" | tail -1)"
C41_LEDGER="${C41_LEDGER_LINE#LEDGER: }"
if [ -n "$C41_LEDGER" ] && [ -f "$C41_LEDGER" ]; then
    C41_BAD="$(jq -r '.items[].tier' "$C41_LEDGER" \
        | grep -vE '^(default|sonnet|xhigh)$' || true)"
    [ -z "$C41_BAD" ] && ok "C41: BURNDOWN_TIER_HINT unset: no error tiers" \
        || fail "C41: BURNDOWN_TIER_HINT unset: error tier(s): $C41_BAD"
else
    [ "$RC" -ne 0 ] && fail "C41: BURNDOWN_TIER_HINT unset: rc=$RC out=$OUT" \
        || fail "C41: BURNDOWN_TIER_HINT unset: no ledger found"
fi

# ── C42: BURNDOWN_TIER_HINT="" — empty string falls back to real hint ──────────
rm -f "$T/home/claude-plans/_reports"/burndown-batch-[0-9]*.json
OUT="$(GH_LOG="$T/gh.log" GH_FX_DIR="$T/fx" \
    BACKLOG_GH="$T/gh" BURNDOWN_GIT="$T/git" BURNDOWN_TIER_HINT="" \
    HOME="$T/home" "$SCRIPT" burndown 2>&1)"; RC=$?
C42_LEDGER_LINE="$(grep '^LEDGER: ' <<< "$OUT" | tail -1)"
C42_LEDGER="${C42_LEDGER_LINE#LEDGER: }"
if [ -n "$C42_LEDGER" ] && [ -f "$C42_LEDGER" ]; then
    C42_BAD="$(jq -r '.items[].tier' "$C42_LEDGER" \
        | grep -vE '^(default|sonnet|xhigh)$' || true)"
    [ -z "$C42_BAD" ] && ok "C42: BURNDOWN_TIER_HINT empty: no error tiers" \
        || fail "C42: BURNDOWN_TIER_HINT empty: error tier(s): $C42_BAD"
else
    [ "$RC" -ne 0 ] && fail "C42: BURNDOWN_TIER_HINT empty: rc=$RC out=$OUT" \
        || fail "C42: BURNDOWN_TIER_HINT empty: no ledger found"
fi

# ── C43: BURNDOWN_GIT unset — real git worktree list runs ────────────────────
rm -f "$T/home/claude-plans/_reports"/burndown-batch-[0-9]*.json
OUT="$(env -u BURNDOWN_GIT GH_LOG="$T/gh.log" GH_FX_DIR="$T/fx" \
    BACKLOG_GH="$T/gh" BURNDOWN_TIER_HINT="$T/tier" \
    HOME="$T/home" "$SCRIPT" burndown 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "C43: BURNDOWN_GIT unset: exits 0" || fail "C43: BURNDOWN_GIT unset: exits 0 (got $RC, out: $OUT)"
grep -qF "git worktree list failed" <<< "$OUT" \
    && fail "C43: no git worktree list failed" || ok "C43: no git worktree list failed"

# ── C44: BURNDOWN_GIT="" — empty string falls back to real git ───────────────
rm -f "$T/home/claude-plans/_reports"/burndown-batch-[0-9]*.json
OUT="$(GH_LOG="$T/gh.log" GH_FX_DIR="$T/fx" \
    BACKLOG_GH="$T/gh" BURNDOWN_TIER_HINT="$T/tier" BURNDOWN_GIT="" \
    HOME="$T/home" "$SCRIPT" burndown 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "C44: BURNDOWN_GIT empty: exits 0" || fail "C44: BURNDOWN_GIT empty: exits 0 (got $RC, out: $OUT)"
grep -qF "git worktree list failed" <<< "$OUT" \
    && fail "C44: no git worktree list failed" || ok "C44: no git worktree list failed"

# ── Phase 7: drift guards ─────────────────────────────────────────────────────

SKILL_FILE="$(cd "$(dirname "$0")/.." && pwd)/.claude/skills/burndown/SKILL.md"

# ── C45: subcommand drift guard ───────────────────────────────────────────────
if [ -f "$SKILL_FILE" ]; then
    LIB_FILE="$(cd "$(dirname "$0")" && pwd)/lib/burndown.sh"
    SKILL_SUBCMDS="$(grep -oE 'bin/backlog burndown[a-z-]*' "$SKILL_FILE" \
        | sed 's/bin\/backlog //' | sort -u)"
    C45_FAIL=0
    while IFS= read -r subcmd; do
        [ -n "$subcmd" ] || continue
        grep -qE "^ *${subcmd}\)" "$LIB_FILE" \
            || { fail "C45: $subcmd in skill but not in bd_main case"; C45_FAIL=1; }
    done <<< "$SKILL_SUBCMDS"
    [ "$C45_FAIL" -eq 0 ] && ok "C45: skill subcommands match bd_main case"
else
    fail "C45: SKILL.md not found at $SKILL_FILE"
fi

# ── C46: post-plan boundary ───────────────────────────────────────────────────
if [ -f "$SKILL_FILE" ]; then
    HAS_ALLOWED=0
    HAS_NEVER=0
    while IFS= read -r line; do
        grep -qF 'post-plan-now' <<< "$line" || continue
        if grep -qE 'cd .+ && bin/post-plan-now --auto' <<< "$line"; then
            HAS_ALLOWED=1
        elif grep -qF 'Never run' <<< "$line"; then
            HAS_NEVER=1
        else
            fail "C46: post-plan-now line not in allowed form: $line"
        fi
    done < "$SKILL_FILE"
    [ "$HAS_ALLOWED" -eq 1 ] && ok "C46: has allowed post-plan-now line" \
        || fail "C46: no allowed post-plan-now line found"
    [ "$HAS_NEVER" -eq 1 ] && ok "C46: has Never run line" \
        || fail "C46: no Never run line found"
else
    fail "C46: SKILL.md not found at $SKILL_FILE"
fi

# ══ Skip-label region: isolated HOME + fixtures ($T/lbl) ══════════════════════
mkdir -p "$T/lbl/home/claude-plans/_reports" "$T/lbl/fx"
echo '[]' > "$T/lbl/fx/prs-open.json"
touch "$T/lbl/fx/worktrees.txt"
cat > "$T/lbl/home/claude-plans/_reports/backlog-triage-2026-09-26.md" <<'REPORT'
# Backlog triage 2026-09-26

## P2 (6)

- [#40](u40) Forty — r40
- [#41](u41) Forty-one — r41
- [#42](u42) Forty-two — r42
- [#43](u43) Forty-three — r43
- [#44](u44) Forty-four — r44
- [#45](u45) Forty-five — r45

## Notes

- [#99](u99) unranked note — should not rank
REPORT
touch -t 202609260000 "$T/lbl/home/claude-plans/_reports/backlog-triage-2026-09-26.md"

# lbl_issues <labels40> <labels41> [upd40] [labels44] — writes five open issues
# #40-#44 plus #45 (ranked, updated after the report).
lbl_issues() {
    local l40="$1" l41="$2" u40="${3:-2026-09-20T00:00:00Z}" l44="${4:-[]}"
    [ -n "$u40" ] || u40="2026-09-20T00:00:00Z"
    [ -n "$l44" ] || l44="[]"
    cat > "$T/lbl/fx/issues.json" <<JSON
[
  {"number":40,"title":"Forty","body":"bin/a.sh:1","url":"u40","updatedAt":"$u40","labels":$l40},
  {"number":41,"title":"Forty-one","body":"bin/b.sh:1","url":"u41","updatedAt":"2026-09-20T00:00:00Z","labels":$l41},
  {"number":42,"title":"Forty-two","body":"bin/c.sh:1","url":"u42","updatedAt":"2026-09-20T00:00:00Z","labels":[]},
  {"number":43,"title":"Forty-three","body":"bin/d.sh:1","url":"u43","updatedAt":"2026-09-20T00:00:00Z","labels":[]},
  {"number":44,"title":"Forty-four","body":"bin/e.sh:1","url":"u44","updatedAt":"2026-09-20T00:00:00Z","labels":$l44},
  {"number":45,"title":"Forty-five","body":"bin/f.sh:1","url":"u45","updatedAt":"2026-09-28T00:00:00Z","labels":[]}
]
JSON
}

# bdl_b [args] — burndown with any prior ledger removed (a queued ledger would
# make its items in-flight on the next run)
# shellcheck disable=SC2120
bdl_b() {
    rm -f "$T/lbl/home/claude-plans/_reports"/burndown-batch-[0-9]*.json
    bdl burndown "$@"
}

# ── L1: characterization — unlabeled issues are picked (must stay green) ──────
lbl_issues '[]' '[]'
OUT="$(bdl_b 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "L1: unlabeled run exits 0" || fail "L1: unlabeled run exits 0 (got $RC)"
grep -qE '^PICK +#40 ' <<< "$OUT" && ok "L1: #40 PICK" || fail "L1: #40 PICK (got: $OUT)"
grep -qE '^PICK +#41 ' <<< "$OUT" && ok "L1: #41 PICK" || fail "L1: #41 PICK"
grep -qE '^PICK +#42 ' <<< "$OUT" && ok "L1: #42 PICK" || fail "L1: #42 PICK"
want "L1: units count the picks" "$OUT" "units: 5/5"

# ── L2: characterization — delta lists updated #45, omits ranked #40 ──────────
OUT="$(bdl burndown-delta 2>/dev/null)"; RC=$?
[ "$RC" -eq 0 ] && ok "L2: delta exits 0" || fail "L2: delta exits 0 (got $RC)"
NUMS="$(jq -c '[.issues[].number]' <<< "$OUT" 2>/dev/null)"
[ "$NUMS" = "[45]" ] && ok "L2: delta issues are [45]" || fail "L2: delta issues are [45] (got $NUMS)"

# ── L3: labeled primaries are skipped, unlabeled #42 still picked ─────────────
lbl_issues '[{"name":"blocked"}]' '[{"name":"out-of-repo"}]'
OUT="$(bdl_b 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "L3: labeled run exits 0" || fail "L3: labeled run exits 0 (got $RC)"
want "L3: #40 blocked row" "$OUT" "skip-label: blocked (PR unknown)"
want "L3: #41 out-of-repo row" "$OUT" "skip-label: out-of-repo"
want "L3: #42 PICK" "$OUT" "PICK  #42"
if grep -qF "PICK  #40" <<< "$OUT"; then fail "L3: #40 must not PICK"; else ok "L3: #40 not PICKed"; fi
if grep -qF "PICK  #41" <<< "$OUT"; then fail "L3: #41 must not PICK"; else ok "L3: #41 not PICKed"; fi
want "L3: units 3/5" "$OUT" "units: 3/5"

# ── L4: boundary — label check beats stale-rank ───────────────────────────────
lbl_issues '[{"name":"blocked"}]' '[]' '2026-09-28T00:00:00Z'
OUT="$(bdl_b 2>&1)"; RC=$?
ROW40="$(grep -E '^SKIP +#40 ' <<< "$OUT")"
want "L4: #40 shows skip-label" "$ROW40" "skip-label: blocked"
if grep -qF "stale-rank" <<< "$ROW40"; then fail "L4: #40 row must not say stale-rank"; else ok "L4: #40 row not stale-rank"; fi

# ── L5: labeled pair partner ──────────────────────────────────────────────────
lbl_issues '[]' '[]' '' '[{"name":"out-of-repo"}]'
OUT="$(bdl_b --pair 43,44 2>&1)"; RC=$?
want "L5: partner row" "$OUT" "pair: #44 skip-label: out-of-repo"
want "L5: primary row" "$OUT" "pair: with #43"
if grep -qF "PICK  #43" <<< "$OUT"; then fail "L5: #43 must not PICK"; else ok "L5: #43 not PICKed"; fi

# ── L6: unranked labeled issue ────────────────────────────────────────────────
lbl_issues '[]' '[]'
jq '. + [{"number":46,"title":"Forty-six","body":"bin/g.sh:1","url":"u46","updatedAt":"2026-09-20T00:00:00Z","labels":[{"name":"out-of-repo"}]}]' \
    "$T/lbl/fx/issues.json" > "$T/lbl/fx/issues.tmp" && mv "$T/lbl/fx/issues.tmp" "$T/lbl/fx/issues.json"
OUT="$(bdl_b 2>&1)"; RC=$?
ROW46="$(grep -E '^SKIP +#46 ' <<< "$OUT")"
want "L6: #46 skip-label row" "$ROW46" "skip-label: out-of-repo"
if grep -qF "unranked (run burndown-delta" <<< "$ROW46"; then fail "L6: #46 must not get unranked advice"; else ok "L6: #46 no unranked advice"; fi

# ── L7: delta drops skip-labeled issues (updated #40, unranked #46) ───────────
lbl_issues '[{"name":"blocked"}]' '[]' '2026-09-28T00:00:00Z'
jq '. + [{"number":46,"title":"Forty-six","body":"bin/g.sh:1","url":"u46","updatedAt":"2026-09-20T00:00:00Z","labels":[{"name":"out-of-repo"}]},
         {"number":47,"title":"Forty-seven","body":"bin/h.sh:1","url":"u47","updatedAt":"2026-09-20T00:00:00Z","labels":[]}]' \
    "$T/lbl/fx/issues.json" > "$T/lbl/fx/issues.tmp" && mv "$T/lbl/fx/issues.tmp" "$T/lbl/fx/issues.json"
OUT="$(bdl burndown-delta 2>/dev/null)"; RC=$?
NUMS="$(jq -r '.issues[].number' <<< "$OUT" 2>/dev/null | tr '\n' ' ')"
if grep -qwF 40 <<< "$NUMS"; then fail "L7: delta must omit labeled #40 (got $NUMS)"; else ok "L7: delta omits labeled #40"; fi
if grep -qwF 46 <<< "$NUMS"; then fail "L7: delta must omit labeled #46 (got $NUMS)"; else ok "L7: delta omits labeled #46"; fi
grep -qwF 45 <<< "$NUMS" && ok "L7: delta keeps #45" || fail "L7: delta keeps #45 (got $NUMS)"
grep -qwF 47 <<< "$NUMS" && ok "L7: delta keeps #47" || fail "L7: delta keeps #47 (got $NUMS)"

# ── L8: refresh demands only what delta lists (#45, #47) ──────────────────────
RANKS_L8="$T/lbl/ranks.md"
cat > "$RANKS_L8" <<'RANKS'
## P2 (2)
- [#45](https://github.com/a-jay85/IBL5-backlog/issues/45) Forty-five — re-ranked
- [#47](https://github.com/a-jay85/IBL5-backlog/issues/47) Forty-seven — now ranked
RANKS
OUT="$(bdl burndown-refresh "$RANKS_L8" 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "L8: refresh exits 0" || fail "L8: refresh exits 0 (got $RC)"
if grep -qF "omits delta issue #40" <<< "$OUT"; then fail "L8: refresh must not demand labeled #40"; else ok "L8: refresh does not demand #40"; fi
# refresh wrote a dated report into the isolated HOME; drop it so the fixture report stays newest-by-name
L8_REPORT="$(tail -1 <<< "$OUT")"; L8_REPORT="${L8_REPORT#REPORT: }"
[ ! -f "$L8_REPORT" ] || unlink "$L8_REPORT"

# ── L9: burndown-record reason= / blocked_by= ─────────────────────────────────
lbl_issues '[]' '[]'
OUT="$(bdl_b 2>&1)"
L="$(grep '^LEDGER: ' <<< "$OUT" | sed 's/^LEDGER: //')"
if [ -f "$L" ]; then ok "L9: ledger created"; else fail "L9: ledger created (got: $OUT)"; fi
SNAP="$T/lbl/ledger.snap"
cp "$L" "$SNAP"
: > "$T/lbl/gh.log"
OUT="$(bdl burndown-record "$L" 42 status=skipped reason=blocked blocked_by=77 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "L9: reason=blocked record exits 0" || fail "L9: reason=blocked record exits 0 (got $RC: $OUT)"
[ "$(jq -r '.items[] | select(.issue_num==42) | .skip_label' "$L")" = "blocked" ] \
    && ok "L9: #42 skip_label=blocked" || fail "L9: #42 skip_label=blocked"
[ "$(jq -r '.items[] | select(.issue_num==42) | .blocked_by' "$L")" = "77" ] \
    && ok "L9: #42 blocked_by=77" || fail "L9: #42 blocked_by=77"
OUT="$(bdl burndown-record "$L" 43 status=skipped reason=out-of-repo 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "L9: reason=out-of-repo record exits 0" || fail "L9: reason=out-of-repo record exits 0 (got $RC: $OUT)"
[ "$(jq -r '.items[] | select(.issue_num==43) | .skip_label' "$L")" = "out-of-repo" ] \
    && ok "L9: #43 skip_label=out-of-repo" || fail "L9: #43 skip_label=out-of-repo"
[ "$(jq '.items[] | select(.issue_num==43) | has("blocked_by")' "$L")" = "false" ] \
    && ok "L9: #43 has no blocked_by" || fail "L9: #43 has no blocked_by"

# ── L10: rejected forms leave the ledger byte-identical and make no tag call ──
cp "$SNAP" "$L"
: > "$T/lbl/gh.log"
l10_reject() {
    local label="$1"; shift
    local out rc
    out="$(bdl burndown-record "$L" "$@" 2>&1)"; rc=$?
    [ "$rc" -eq 2 ] && ok "L10: $label exits 2" || fail "L10: $label exits 2 (got $rc: $out)"
    cmp -s "$L" "$SNAP" && ok "L10: $label ledger unchanged" || fail "L10: $label ledger unchanged"
}
l10_reject "blocked without blocked_by" 42 status=skipped reason=blocked
l10_reject "out-of-repo with blocked_by" 42 status=skipped reason=out-of-repo blocked_by=77
l10_reject "blocked_by alone" 42 status=skipped blocked_by=77
l10_reject "bogus reason" 42 status=skipped reason=bogus
l10_reject "non-numeric blocked_by" 42 status=skipped reason=blocked blocked_by=abc
l10_reject "reason on a picked item" 42 reason=out-of-repo
OUT="$(bdl burndown-record "$L" 999 status=skipped reason=out-of-repo 2>&1)"; RC=$?
[ "$RC" -eq 2 ] && ok "L10: unknown item exits 2" || fail "L10: unknown item exits 2 (got $RC)"
want "L10: unknown item message" "$OUT" "no item #999"
cmp -s "$L" "$SNAP" && ok "L10: unknown item ledger unchanged" || fail "L10: unknown item ledger unchanged"
if grep -qE 'label create|issue edit|issue comment' "$T/lbl/gh.log"; then
    fail "L10: rejected forms made a tag gh call"
else
    ok "L10: rejected forms made no tag gh call"
fi

# ── L11: record with reason= tags the issue and posts one marker comment ──────
cp "$SNAP" "$L"
: > "$T/lbl/gh.log"
OUT="$(bdl burndown-record "$L" 42 status=skipped reason=blocked blocked_by=77 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "L11: tag record exits 0" || fail "L11: tag record exits 0 (got $RC: $OUT)"
GHLOG="$(cat "$T/lbl/gh.log")"
want "L11: label create blocked" "$GHLOG" "label create blocked"
want "L11: label create --force" "$GHLOG" "--force"
want "L11: --add-label blocked" "$GHLOG" "--add-label blocked"
want "L11: marker in comment" "$GHLOG" "<!-- burndown-blocked-by: 77 -->"
[ "$(grep -c 'issue comment' "$T/lbl/gh.log")" -eq 1 ] && ok "L11: exactly one comment" || fail "L11: exactly one comment"
want "L11: stdout says comment posted" "$OUT" "comment posted"

# ── L12: idempotency — an equivalent marker means no new comment ──────────────
l12_case() {
    local label="$1" want_n="$2"; shift 2
    cp "$SNAP" "$L"
    : > "$T/lbl/gh.log"
    local out rc n
    out="$(bdl burndown-record "$L" "$@" 2>&1)"; rc=$?
    L12_OUT="$out"
    n="$(grep -c 'issue comment' "$T/lbl/gh.log")"
    [ "$rc" -eq 0 ] && [ "$n" -eq "$want_n" ] && ok "L12: $label" || fail "L12: $label (rc=$rc comments=$n want=$want_n: $out)"
}
printf '%s' '{"comments":[{"body":"x\n\n<!-- burndown-blocked-by: 77 -->"}]}' > "$T/lbl/fx/issue-42-comments.json"
l12_case "same PR marker posts nothing" 0 42 status=skipped reason=blocked blocked_by=77
want "L12: same PR marker posts nothing: stdout says comment already present" "$L12_OUT" "(comment already present)"
l12_case "different PR posts one" 1 42 status=skipped reason=blocked blocked_by=78
printf '%s' '{"comments":[{"body":"<!-- burndown-blocked-by: 78 -->"},{"body":"<!-- burndown-blocked-by: 77 -->"}]}' > "$T/lbl/fx/issue-42-comments.json"
l12_case "last marker wins (77)" 0 42 status=skipped reason=blocked blocked_by=77
want "L12: last marker wins (77): stdout says comment already present" "$L12_OUT" "(comment already present)"
l12_case "last marker wins (78 re-posts)" 1 42 status=skipped reason=blocked blocked_by=78
rm -f "$T/lbl/fx/issue-42-comments.json"
printf '%s' '{"comments":[{"body":"x\n\n<!-- burndown-out-of-repo -->"}]}' > "$T/lbl/fx/issue-43-comments.json"
l12_case "out-of-repo marker posts nothing" 0 43 status=skipped reason=out-of-repo
want "L12: out-of-repo marker posts nothing: stdout says comment already present" "$L12_OUT" "(comment already present)"
rm -f "$T/lbl/fx/issue-43-comments.json"

# ── L13: gh failures exit 3 and the ledger keeps its record ───────────────────
l13_case() {
    local fail_on="$1"
    cp "$SNAP" "$L"
    : > "$T/lbl/gh.log"
    local out rc n st
    out="$(GH_FAIL_ON="$fail_on" bdl burndown-record "$L" 42 status=skipped reason=blocked blocked_by=77 2>&1)"; rc=$?
    n="$(grep -c 'issue comment' "$T/lbl/gh.log")"
    st="$(jq -r '.items[] | select(.issue_num==42) | .status' "$L")"
    [ "$rc" -eq 3 ] && ok "L13: $fail_on failure exits 3" || fail "L13: $fail_on failure exits 3 (got $rc: $out)"
    [ "$st" = "skipped" ] && ok "L13: $fail_on failure keeps status=skipped" || fail "L13: $fail_on failure keeps status=skipped (got $st)"
    L13_N="$n"
}
l13_case "label create"
[ "$L13_N" -eq 0 ] && ok "L13: label create failure posts no comment" || fail "L13: label create failure posts no comment"
l13_case "--json comments"
[ "$L13_N" -eq 0 ] && ok "L13: comments read failure posts no comment" || fail "L13: comments read failure posts no comment"
l13_case "issue comment"

# ── L14: burndown-tag needs no ledger; rejected forms make no gh call ─────────
rm -f "$T/lbl/home/claude-plans/_reports"/burndown-batch-[0-9]*.json
: > "$T/lbl/gh.log"
OUT="$(bdl burndown-tag 268 reason=out-of-repo 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "L14: burndown-tag exits 0" || fail "L14: burndown-tag exits 0 (got $RC: $OUT)"
GHLOG="$(cat "$T/lbl/gh.log")"
want "L14: --add-label out-of-repo" "$GHLOG" "--add-label out-of-repo"
want "L14: out-of-repo marker" "$GHLOG" "<!-- burndown-out-of-repo -->"
if ls "$T/lbl/home/claude-plans/_reports"/burndown-batch-*.json >/dev/null 2>&1; then
    fail "L14: burndown-tag must not create a ledger"
else
    ok "L14: burndown-tag creates no ledger"
fi
l14_reject() {
    local label="$1"; shift
    : > "$T/lbl/gh.log"
    local out rc
    out="$(bdl burndown-tag "$@" 2>&1)"; rc=$?
    [ "$rc" -eq 2 ] && ok "L14: $label exits 2" || fail "L14: $label exits 2 (got $rc: $out)"
    [ ! -s "$T/lbl/gh.log" ] && ok "L14: $label makes no gh call" || fail "L14: $label makes no gh call"
}
l14_reject "no args"
l14_reject "issue alone" 268
l14_reject "non-numeric issue" abc reason=out-of-repo
l14_reject "blocked without PR" 1233 reason=blocked
l14_reject "unknown key" 1 foo=bar

# ── L15-L19: auto-clear of blocked labels at selection time ───────────────────
l15_setup() {
    lbl_issues '[{"name":"blocked"}]' '[{"name":"out-of-repo"}]'
    printf '%s' '{"comments":[{"body":"<!-- burndown-blocked-by: 900 -->"}]}' > "$T/lbl/fx/issue-40-comments.json"
    rm -f "$T/lbl/fx/pr-view-900.json"
    : > "$T/lbl/gh.log"
}
l15_pr_state() { printf '{"state":"%s"}' "$1" > "$T/lbl/fx/pr-view-900.json"; }
l15_count() { grep -cF -e "$1" "$T/lbl/gh.log" || true; }

for ST in MERGED CLOSED; do
    l15_setup; l15_pr_state "$ST"
    OUT="$(bdl_b 2>&1)"; RC=$?
    GHLOG="$(cat "$T/lbl/gh.log")"
    [ "$RC" -eq 0 ] && ok "L15: $ST exits 0" || fail "L15: $ST exits 0 (got $RC: $OUT)"
    want "L15: $ST pr view call" "$GHLOG" "pr view 900 --repo a-jay85/IBL5"
    want "L15: $ST --remove-label" "$GHLOG" "--remove-label blocked"
    want "L15: $ST cleared line" "$OUT" "cleared blocked on #40"
    want "L15: $ST #40 PICK" "$OUT" "PICK  #40"
done

l15_setup; l15_pr_state OPEN
OUT="$(bdl_b 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "L17: OPEN exits 0" || fail "L17: OPEN exits 0 (got $RC: $OUT)"
want "L17: OPEN row names the PR" "$OUT" "skip-label: blocked (PR #900)"
[ "$(l15_count '--remove-label')" -eq 0 ] && ok "L17: OPEN keeps the tag" || fail "L17: OPEN keeps the tag"

l15_setup; l15_pr_state OPEN
OUT="$(GH_FAIL_ON="pr view" bdl_b 2>&1)"; RC=$?
[ "$RC" -eq 1 ] && ok "L18: pr view failure exits 1" || fail "L18: pr view failure exits 1 (got $RC: $OUT)"
want "L18: pr view failure WARN" "$OUT" "WARN"
want "L18: pr view failure keeps PR in row" "$OUT" "skip-label: blocked (PR #900)"
[ "$(l15_count '--remove-label')" -eq 0 ] && ok "L18: pr view failure keeps the tag" || fail "L18: pr view failure keeps the tag"

l15_setup; l15_pr_state MERGED
OUT="$(GH_FAIL_ON="--remove-label" bdl_b 2>&1)"; RC=$?
[ "$RC" -eq 1 ] && ok "L18: remove-label failure exits 1" || fail "L18: remove-label failure exits 1 (got $RC: $OUT)"
want "L18: remove-label failure WARN" "$OUT" "WARN"
if grep -qF "PICK  #40" <<< "$OUT"; then fail "L18: remove-label failure must not PICK #40"; else ok "L18: remove-label failure keeps #40 skipped"; fi

l15_setup; l15_pr_state OPEN
OUT="$(GH_FAIL_ON="--json comments" bdl_b 2>&1)"; RC=$?
[ "$RC" -eq 1 ] && ok "L18: comments failure exits 1" || fail "L18: comments failure exits 1 (got $RC: $OUT)"
want "L18: comments failure row" "$OUT" "skip-label: blocked (PR unknown)"

l15_setup; l15_pr_state OPEN
printf '%s' '{"comments":[{"body":"hand-applied, no marker"}]}' > "$T/lbl/fx/issue-40-comments.json"
OUT="$(bdl_b 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "L18: missing marker exits 0" || fail "L18: missing marker exits 0 (got $RC: $OUT)"
want "L18: missing marker WARN" "$OUT" "no burndown-blocked-by marker"
[ "$(l15_count 'pr view')" -eq 0 ] && ok "L18: missing marker makes no pr view call" || fail "L18: missing marker makes no pr view call"
if grep -qF "PICK  #40" <<< "$OUT"; then fail "L18: missing marker must not PICK #40"; else ok "L18: missing marker keeps #40 skipped"; fi

l15_setup
printf '{}' > "$T/lbl/fx/pr-view-900.json"
OUT="$(bdl_b 2>&1)"; RC=$?
[ "$RC" -eq 1 ] && ok "L18: unrecognized state exits 1" || fail "L18: unrecognized state exits 1 (got $RC: $OUT)"
want "L18: unrecognized state message" "$OUT" "unrecognized PR state"
[ "$(l15_count '--remove-label')" -eq 0 ] && ok "L18: unrecognized state keeps the tag" || fail "L18: unrecognized state keeps the tag"

lbl_issues '[]' '[{"name":"out-of-repo"}]'
: > "$T/lbl/gh.log"
OUT="$(bdl_b 2>&1)"; RC=$?
[ "$(l15_count 'pr view')" -eq 0 ] && ok "L19: out-of-repo never triggers pr view" || fail "L19: out-of-repo never triggers pr view"
want "L19: #41 still skipped" "$OUT" "skip-label: out-of-repo"
rm -f "$T/lbl/fx/issue-40-comments.json" "$T/lbl/fx/pr-view-900.json"

# ══ --after backfill: capacity left by earlier ledgers of the same run ═════════
mkdir -p "$T/lbl/prior"

# af_ledger <name> <items-json> — writes a prior ledger OUTSIDE the reports dir
# (a ledger there would make its queued items in-flight) and echoes its path.
# units_used is deliberately the all-items sum, as bd_record_apply writes it.
af_ledger() {
    local f="$T/lbl/prior/$1.json"
    jq -n --argjson items "$2" \
        '{schema:1,created:"2026-10-01T00:00:00",report:"r",budget:5,
          units_used:([$items[].cost] | add // 0),items:$items,skipped:[]}' > "$f"
    printf '%s' "$f"
}
# af_item <num> <cost> <status> <route> <paths-json>
af_item() {
    jq -nc --argjson n "$1" --argjson c "$2" --arg s "$3" --arg r "$4" --argjson p "$5" \
        '{issue_num:$n,also_closes:[],issue_title:"t",rank:"P2",tier:"default",cost:$c,paths:$p,route:$r,slug:"",pr_url:"",status:$s}'
}
# af_ledger_path <output> — the path on the final LEDGER: line
af_ledger_path() { sed -n 's/^LEDGER: //p' <<< "$1" | tail -1; }

lbl_issues '[]' '[]'

# AF1: reduced capacity (live queued 1-unit item + closed-fixed item)
AF_L="$(af_ledger af1 "[$(af_item 90 1 queued plan '["bin/z.sh"]'),$(af_item 91 1 closed-fixed '' '["bin/y.sh"]')]")"
OUT="$(bdl_b --after "$AF_L" 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "AF1: reduced capacity exits 0" || fail "AF1: reduced capacity exits 0 (got $RC: $OUT)"
want "AF1: units line shows budget 4" "$OUT" "units: 4/4"
AF1_PICKS=$(grep -cE '^PICK' <<< "$OUT" || true)
[ "$AF1_PICKS" -eq 4 ] && ok "AF1: picks up to 4 units" || fail "AF1: picks up to 4 units (got $AF1_PICKS)"
want "AF1: later candidates not reached" "$OUT" "not reached: 2 candidate(s)"
if grep -qF "PICK  #44" <<< "$OUT"; then fail "AF1: #44 must not be picked"; else ok "AF1: #44 not picked (budget 4)"; fi
AF1_LP="$(af_ledger_path "$OUT")"
[ "$(jq '.budget' "$AF1_LP" 2>/dev/null)" = "4" ] && ok "AF1: ledger budget is 4" || fail "AF1: ledger budget is 4"
[ "$(jq -c '.after' "$AF1_LP" 2>/dev/null)" = "[\"$AF_L\"]" ] && ok "AF1: ledger after lists the prior ledger" || fail "AF1: ledger after lists the prior ledger"
if grep -qE '^(PICK|SKIP) +#9[01] ' <<< "$OUT"; then fail "AF1: prior issues must not reappear"; else ok "AF1: prior issues do not reappear"; fi

# AF2: a skipped (no route) issue of a prior ledger is never picked again
AF_L="$(af_ledger af2 "[$(af_item 40 1 skipped '' '["bin/a.sh"]'),$(af_item 90 1 queued plan '["bin/z.sh"]')]")"
OUT="$(bdl_b --after "$AF_L" 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "AF2: exclusion run exits 0" || fail "AF2: exclusion run exits 0 (got $RC: $OUT)"
if grep -qE '^(PICK|SKIP) +#40 ' <<< "$OUT"; then fail "AF2: skipped #40 must not be picked or listed again"; else ok "AF2: skipped #40 is excluded"; fi
want "AF2: other candidates still picked" "$OUT" "PICK  #41"
want "AF2: skipped item freed its unit" "$OUT" "units: 4/4"

# AF3: failed ad-hoc item (route=ad-hoc, status=skipped) keeps its unit
AF_L="$(af_ledger af3 "[$(af_item 90 2 skipped ad-hoc '["bin/z.sh"]')]")"
OUT="$(bdl_b --after "$AF_L" 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "AF3: failed ad-hoc run exits 0" || fail "AF3: failed ad-hoc run exits 0 (got $RC: $OUT)"
want "AF3: ad-hoc cost counts against the budget" "$OUT" "units: 3/3"
[ "$(jq '.budget' "$(af_ledger_path "$OUT")" 2>/dev/null)" = "3" ] && ok "AF3: ledger budget is 3" || fail "AF3: ledger budget is 3"
# the same item with no route frees the units
AF_L="$(af_ledger af3b "[$(af_item 90 2 skipped '' '["bin/z.sh"]')]")"
OUT="$(bdl_b --after "$AF_L" 2>&1)"
want "AF3: skip without ad-hoc route frees the units" "$OUT" "units: 5/5"

# AF4: overlap with a prior live item's paths
AF_L="$(af_ledger af4 "[$(af_item 90 1 queued plan '["bin/a.sh"]')]")"
OUT="$(bdl_b --after "$AF_L" 2>&1)"; RC=$?
ROW40="$(grep -E '^SKIP +#40 ' <<< "$OUT")"
want "AF4: #40 overlaps the prior item" "$ROW40" "overlap with #90 on bin/a.sh"
want "AF4: #41 still picked" "$OUT" "PICK  #41"

# AF5: a live pathless prior item costs only its own units
AF_L="$(af_ledger af5 "[$(af_item 90 1 queued plan '[]')]")"
OUT="$(bdl_b --after "$AF_L" 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "AF5: pathless prior exits 0" || fail "AF5: pathless prior exits 0 (got $RC: $OUT)"
grep -qE '^units: [1-4]/4$' <<< "$OUT" && ok "AF5: units x/4 with one live pathless 1-unit item" \
    || fail "AF5: units x/4 with one live pathless 1-unit item (got: $OUT)"
AF5_LEDGER="$(af_ledger_path "$OUT")"
[ -n "$AF5_LEDGER" ] && [ "$(jq '.budget' "$AF5_LEDGER" 2>/dev/null)" = "4" ] \
    && ok "AF5: ledger budget is 4" || fail "AF5: ledger budget is 4 (got: $OUT)"
grep -qE '^PICK ' <<< "$OUT" && ok "AF5: candidates picked" || fail "AF5: candidates picked (got: $OUT)"
grep -qE '^(PICK|SKIP) +#90 ' <<< "$OUT" && fail "AF5: prior #90 does not reappear" \
    || ok "AF5: prior #90 does not reappear"

# AF6: a pathless candidate joins a batch with a live pathed prior item
jq 'map(if .number == 40 then .body = "no path refs here" else . end)' \
    "$T/lbl/fx/issues.json" > "$T/lbl/fx/issues.tmp" && mv "$T/lbl/fx/issues.tmp" "$T/lbl/fx/issues.json"
AF_L="$(af_ledger af6 "[$(af_item 90 1 queued plan '["bin/z.sh"]')]")"
OUT="$(bdl_b --after "$AF_L" 2>&1)"
grep -qE '^PICK +#40 +[^ ]+ +1 +tier=[^ ]+$' <<< "$OUT" && ok "AF6: pathless #40 picked beside live #90" \
    || fail "AF6: pathless #40 picked beside live #90 (got: $OUT)"
grep -qE '^SKIP +#40 ' <<< "$OUT" && fail "AF6: #40 not skipped" || ok "AF6: #40 not skipped"
lbl_issues '[]' '[]'

# AF7: a --pair with an excluded member is dropped
AF_L="$(af_ledger af7 "[$(af_item 41 1 skipped '' '["bin/b.sh"]'),$(af_item 90 1 queued plan '["bin/z.sh"]')]")"
OUT="$(bdl_b --after "$AF_L" --pair 40,41 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "AF7: dropped pair exits 0" || fail "AF7: dropped pair exits 0 (got $RC: $OUT)"
want "AF7: #40 evaluated alone" "$OUT" "PICK  #40"
if grep -qE 'pair|\+#41' <<< "$OUT"; then fail "AF7: no pair text may remain"; else ok "AF7: no misleading pair row"; fi

# AF8: bad arguments
OUT="$(bdl burndown --after 2>&1)"; RC=$?
[ "$RC" -eq 2 ] && ok "AF8: --after without a value exits 2" || fail "AF8: --after without a value exits 2 (got $RC: $OUT)"
OUT="$(bdl burndown --after "$T/lbl/prior/nope.json" 2>&1)"; RC=$?
[ "$RC" -eq 2 ] && ok "AF8: missing ledger file exits 2" || fail "AF8: missing ledger file exits 2 (got $RC: $OUT)"
printf '{not json' > "$T/lbl/prior/bad.json"
OUT="$(bdl burndown --after "$T/lbl/prior/bad.json" 2>&1)"; RC=$?
[ "$RC" -eq 3 ] && ok "AF8: malformed JSON exits 3" || fail "AF8: malformed JSON exits 3 (got $RC: $OUT)"
want "AF8: malformed message names the ledger" "$OUT" "malformed ledger bad.json"
printf '{"items":"x"}' > "$T/lbl/prior/bad2.json"
OUT="$(bdl burndown --after "$T/lbl/prior/bad2.json" 2>&1)"; RC=$?
[ "$RC" -eq 3 ] && ok "AF8: non-array items exits 3" || fail "AF8: non-array items exits 3 (got $RC: $OUT)"

# AF9: no --after keeps the full budget and records an empty after list
