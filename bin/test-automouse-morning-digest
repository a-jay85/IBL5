#!/usr/bin/env bash
# shellcheck shell=bash
set -u
# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SCRIPT="$SCRIPT_DIR/automouse/morning-digest"
h_tmp TMP
NDIR="$TMP/automouse"; BINSTUB="$TMP/stub"
setup() { rm -rf "$NDIR"; mkdir -p "$NDIR/queue" "$NDIR/skipped" "$NDIR/done" "$NDIR/reports"; }

assert_contains()     { local desc="$1" needle="$2" hay="$3"; case "$hay" in *"$needle"*) ;; *) h_fail "$desc" "missing: $needle" ;; esac; }
assert_not_contains() { local desc="$1" needle="$2" hay="$3"; case "$hay" in *"$needle"*) h_fail "$desc" "unexpected: $needle" ;; esac; }

mkdir -p "$BINSTUB"
# The stub drains stdin like the real discord-dm. Exiting without reading races
# the digest's `printf | discord-dm`: CI ignores SIGPIPE, so a printf that loses
# the race fails with EPIPE and pipefail turns the send into exit 1.
printf '#!/bin/sh\ncat > /dev/null\necho "CALLED $*" >> "%s/dm-calls.log"\n' "$TMP" > "$BINSTUB/discord-dm"
chmod +x "$BINSTUB/discord-dm"
# gh stub: plan-a has a PR, every other slug does not. Ignores its args, the way
# `gh pr list --jq ... @tsv` output looks is all the digest reads.
printf '#!/bin/sh\nprintf "plan-a\\thttps://github.com/o/r/pull/7\\n"\n' > "$BINSTUB/gh"
chmod +x "$BINSTUB/gh"
# pr-triage stub: the real `bin/pr-triage --held` makes several gh calls per open PR
# and takes minutes, so no row may reach it. The stub is fixture-driven through
# files under $TMP (held-out = stdout, held-rc = exit code, held-sleep = seconds to
# sleep first) and logs every call to held-calls.log.
printf '%s\n' '#!/bin/sh' \
  "echo \"HELD \$*\" >> \"$TMP/held-calls.log\"" \
  '[ "$1" = "--held" ] || { echo "stub: expected --held, got $*" >&2; exit 64; }' \
  "[ -f \"$TMP/held-sleep\" ] && sleep \"\$(cat \"$TMP/held-sleep\")\"" \
  "[ -f \"$TMP/held-out\" ] && cat \"$TMP/held-out\"" \
  "exit \"\$(cat \"$TMP/held-rc\" 2>/dev/null || echo 0)\"" > "$BINSTUB/pr-triage"
chmod +x "$BINSTUB/pr-triage"
export MORNING_DIGEST_PR_TRIAGE="$BINSTUB/pr-triage"
held_reset() { rm -f "$TMP/held-out" "$TMP/held-rc" "$TMP/held-sleep" "$TMP/held-calls.log"; }
run_digest() { NIGHTLY_DIR="$NDIR" DISCORD_DM_BIN="$BINSTUB/discord-dm" MORNING_DIGEST_GH="$BINSTUB/gh" "$SCRIPT" "$@"; }

TODAY="$(date +%F)"

# Every fixture file must land INSIDE the digest's collection window
# (prior-date 07:00:00, digest-date 07:00:00].  A bare `touch` stamps mtime=now,
# which falls OUTSIDE that window for any run after 07:00 local — so fixtures are
# pinned to yesterday 23:00, which is inside the window at every hour of the day
# and therefore clock-independent on CI.  `touch -t` creates the file when absent,
# so `pin` is a drop-in for `touch`.
YDAY="$(date -v-1d +%Y%m%d 2>/dev/null || date -d 'yesterday' +%Y%m%d)"
LASTNIGHT="${YDAY}2300"
pin() { touch -t "$LASTNIGHT" "$@"; }

# Shared fixture helper: 3 done, 1 skipped, costs summing 8.9241, with aggregate block
mk_fixture_123() {
  setup
  pin "$NDIR/done/plan-a.md" "$NDIR/done/plan-b.md" "$NDIR/done/plan-c.md"
  pin "$NDIR/skipped/plan-s.md"
  cat > "$NDIR/reports/${TODAY}-costs.md" <<'COSTS'
| Plan | Phase | Model | Tier | Cost ($) | Surcharge est ($) | Peak Ctx (K) | In | Out | Cache-read | CW-5m | CW-1h | Prov |
|------|-------|-------|------|----------|-------------------|------------|-----|-----|-----------|-------|-------|------|
| plan-a.md | impl | claude-sonnet-4-6 | Sonnet | 4.5000 | — | 50 | 100 | 200 | 300 | — | — | real |
| plan-b.md | impl | claude-sonnet-4-6 | Sonnet | 3.9241 | — | 50 | 100 | 200 | 300 | — | — | real |
| plan-c.md | impl | claude-sonnet-4-6 | Sonnet | 0.5000 | — | 50 | 100 | 200 | 300 | — | — | real |

## Weekly aggregate (last 7 days)

| Metric | Value |
|--------|-------|
| **Total** (floor) | 331.2400 |
COSTS
}

# --- row1: dry-run body ---
mk_fixture_123
body=$(run_digest --dry-run)
assert_contains     "row1: plan-a in body"   "plan-a"        "$body"
assert_contains     "row1: plan-b in body"   "plan-b"        "$body"
assert_contains     "row1: plan-c in body"   "plan-c"        "$body"
assert_not_contains "row1: no Completed count" "Completed"     "$body"
assert_contains     "row1: plan-a links its PR" "✅ [plan-a](<https://github.com/o/r/pull/7>)" "$body"
assert_contains     "row1: plan-b has no PR, bare" "✅ plan-b"  "$body"
assert_not_contains "row1: no Next line"     "Next:"          "$body"
assert_not_contains "row1: no Reports line"  "Reports:"       "$body"
assert_not_contains "row1: no automouse label" "label:automouse" "$body"
assert_contains     "row1: Skipped 1"        "⏭ Skipped 1"   "$body"
assert_contains     "row1: spend total"      "8.9241"         "$body"
h_pass "row1 — dry-run body"
# --- row2: dry-run no dm ---
rm -f "$TMP/dm-calls.log"
mk_fixture_123
run_digest --dry-run > /dev/null
[ ! -f "$TMP/dm-calls.log" ] || { h_fail "row2" "dm-calls.log should not exist after --dry-run"; }
h_pass "row2 — dry-run no send"
# --- row3: real send ---
rm -f "$TMP/dm-calls.log"
mk_fixture_123
run_digest > /dev/null 2>&1
status=$?
[ $status -eq 0 ] || { h_fail "row3" "exit status $status"; }
[ -f "$TMP/dm-calls.log" ] || { h_fail "row3" "dm-calls.log not created"; }
dm_line=$(cat "$TMP/dm-calls.log" 2>/dev/null || true)
assert_contains "row3: discord args --chunk" "--chunk" "$dm_line"
assert_contains "row3: discord args dash"    " -"      "$dm_line"
h_pass "row3 — real send"
# --- row4: empty dirs ---
setup
rm -f "$TMP/dm-calls.log"
body=$(run_digest --dry-run)
assert_contains "row4: no-plans body" "no plans ran last night" "$body"
run_digest > /dev/null 2>&1
status=$?
[ $status -eq 0 ] || { h_fail "row4" "exit status $status"; }
[ -f "$TMP/dm-calls.log" ] || { h_fail "row4" "dm-calls.log not created for empty run"; }
h_pass "row4 — empty run"
# --- row5: aggregate not included in spend ---
setup
pin "$NDIR/done/plan-a.md" "$NDIR/done/plan-b.md" "$NDIR/done/plan-c.md"
cat > "$NDIR/reports/${TODAY}-costs.md" <<'COSTS'
| Plan | Phase | Model | Tier | Cost ($) | Surcharge est ($) | Peak Ctx (K) | In | Out | Cache-read | CW-5m | CW-1h | Prov |
|------|-------|-------|------|----------|-------------------|------------|-----|-----|-----------|-------|-------|------|
| plan-a.md | impl | claude-sonnet-4-6 | Sonnet | 4.5000 | — | 50 | 100 | 200 | 300 | — | — | real |
| plan-b.md | impl | claude-sonnet-4-6 | Sonnet | 3.9241 | — | 50 | 100 | 200 | 300 | — | — | real |
| plan-c.md | impl | claude-sonnet-4-6 | Sonnet | 0.5000 | — | 50 | 100 | 200 | 300 | — | — | real |

## Weekly aggregate (last 7 days)

| Metric | Value |
|--------|-------|
| **Total** (floor) | 331.2400 |
COSTS
body=$(run_digest --dry-run)
assert_contains     "row5: spend total"           "8.9241"    "$body"
assert_not_contains "row5: aggregate not in body" "331.2400"  "$body"
h_pass "row5 — aggregate excluded"
# --- row6: unpriced rows reported ---
setup
pin "$NDIR/done/plan-x.md" "$NDIR/done/plan-y.md" "$NDIR/done/plan-z.md" "$NDIR/done/plan-w.md" "$NDIR/done/plan-dash.md"
cat > "$NDIR/reports/${TODAY}-costs.md" <<'COSTS'
| Plan | Phase | Model | Tier | Cost ($) | Surcharge est ($) | Peak Ctx (K) | In | Out | Cache-read | CW-5m | CW-1h | Prov |
|------|-------|-------|------|----------|-------------------|------------|-----|-----|-----------|-------|-------|------|
| plan-x.md | impl | claude-sonnet-4-6 | Sonnet | 4.5000 | — | 50 | 100 | 200 | 300 | — | — | real |
| plan-y.md | impl | claude-sonnet-4-6 | Sonnet | 4.4241 | — | 50 | 100 | 200 | 300 | — | — | real |
| plan-z.md | impl | claude-sonnet-4-6 | Sonnet | ? | — | 50 | 100 | 200 | 300 | — | — | unknown |
| plan-w.md | impl | claude-sonnet-4-6 | Sonnet | ? | — | 50 | 100 | 200 | 300 | — | — | unknown |
| plan-dash.md | impl | claude-sonnet-4-6 | Sonnet | — | — | 50 | 100 | 200 | 300 | — | — | real |
COSTS
body=$(run_digest --dry-run)
assert_contains "row6: excludes unpriced" "excludes 3 unpriced rows" "$body"
spend_line=$(printf '%s\n' "$body" | grep '^Spend:' || true)
assert_not_contains "row6: spend line no question mark" "?" "$spend_line"
h_pass "row6 — unpriced rows"
# --- row7: no costs file ---
setup
pin "$NDIR/done/plan-a.md"
body=$(run_digest --dry-run)
assert_contains     "row7: spend unavailable" "Spend: unavailable" "$body"
assert_not_contains "row7: no zero spend"     '$0.00'              "$body"
h_pass "row7 — no costs file"
# --- row8: time window ---
setup
pin "$NDIR/done/plan-fresh.md"
touch -t 202601010000 "$NDIR/done/plan-stale.md"
cat > "$NDIR/reports/${TODAY}-costs.md" <<'COSTS'
| Plan | Phase | Model | Tier | Cost ($) | Surcharge est ($) | Peak Ctx (K) | In | Out | Cache-read | CW-5m | CW-1h | Prov |
|------|-------|-------|------|----------|-------------------|------------|-----|-----|-----------|-------|-------|------|
| plan-fresh.md | impl | claude-sonnet-4-6 | Sonnet | 8.9241 | — | 50 | 100 | 200 | 300 | — | — | real |

## Weekly aggregate (last 7 days)

| Metric | Value |
|--------|-------|
| **Total** (floor) | 8.9241 |
COSTS
body=$(run_digest --dry-run)
assert_contains     "row8: fresh plan in body"     "plan-fresh" "$body"
assert_not_contains "row8: stale plan not in body" "plan-stale" "$body"
h_pass "row8 — time window"
# --- row9: parked and failed from queue sidecars ---
setup
printf '2' > "$NDIR/queue/alpha.md.attempts"
printf '2' > "$NDIR/queue/beta.md.attempts"
pin "$NDIR/queue/alpha.md.attempts" "$NDIR/queue/beta.md.attempts"
pin "$NDIR/queue/beta.md.failure"
pin "$NDIR/queue/gamma.md.failure"
body=$(run_digest --dry-run)
assert_contains     "row9: alpha parked"              "🅿️ alpha"   "$body"
assert_contains     "row9: beta failed"               "❌ beta"     "$body"
assert_contains     "row9: gamma lonely-failure"      "❌ gamma"    "$body"
assert_not_contains "row9: no sidecar filenames"      ".attempts"  "$body"
h_pass "row9 — parked and failed"
# --- row10: dedup done-queue ---
setup
pin "$NDIR/done/dedup.md"
pin "$NDIR/queue/dedup.md"
printf '1' > "$NDIR/queue/dedup.md.attempts"
pin "$NDIR/queue/dedup.md.attempts"
body=$(run_digest --dry-run)
assert_contains     "row10: dedup completed"     "✅ dedup"  "$body"
assert_not_contains "row10: not double-parked"   "🅿️"        "$body"
h_pass "row10 — dedup done-queue"
# --- row11: unknown option ---
run_digest --bogus > /dev/null 2>"$TMP/err11"
status=$?
err=$(cat "$TMP/err11")
[ $status -eq 1 ] || { h_fail "row11" "expected exit 1, got $status"; }
assert_contains "row11: Unknown option in stderr" "Unknown option" "$err"
h_pass "row11 — unknown option"
# --- row12: NIGHTLY_DIR validation ---
NIGHTLY_DIR="/nonexistent/path/$$" DISCORD_DM_BIN="$BINSTUB/discord-dm" "$SCRIPT" > /dev/null 2>"$TMP/err12a"
status=$?
err=$(cat "$TMP/err12a")
[ $status -eq 1 ] || { h_fail "row12a" "expected exit 1 for nonexistent NIGHTLY_DIR, got $status"; }
assert_contains "row12a: NIGHTLY_DIR not found" "NIGHTLY_DIR not found" "$err"

NIGHTLY_DIR="" DISCORD_DM_BIN="$BINSTUB/discord-dm" "$SCRIPT" > /dev/null 2>"$TMP/err12b"
status=$?
err=$(cat "$TMP/err12b")
[ $status -eq 1 ] || { h_fail "row12b" "expected exit 1 for empty NIGHTLY_DIR, got $status"; }
assert_contains "row12b: empty NIGHTLY_DIR error" "NIGHTLY_DIR" "$err"
h_pass "row12 — NIGHTLY_DIR validation"
# --- row13: invalid --date ---
setup
run_digest --date 2026-9-5 > /dev/null 2>"$TMP/err13a"
status=$?
err=$(cat "$TMP/err13a")
[ $status -eq 1 ] || { h_fail "row13a" "expected exit 1 for invalid date format, got $status"; }
assert_contains "row13a: invalid date message" "Invalid --date" "$err"

run_digest --date > /dev/null 2>"$TMP/err13b"
status=$?
err=$(cat "$TMP/err13b")
[ $status -eq 1 ] || { h_fail "row13b" "expected exit 1 for bare --date, got $status"; }
assert_contains "row13b: bare --date message" "--date requires a value" "$err"
h_pass "row13 — invalid date"
# --- row14: idempotent read-only ---
mk_fixture_123
find "$NDIR" -type f | sort > "$TMP/files_before"
run_digest --dry-run > /dev/null
find "$NDIR" -type f | sort > "$TMP/files_after"
diff "$TMP/files_before" "$TMP/files_after" > /dev/null || { h_fail "row14" "files changed after first run"; }
touch "$TMP/marker14"
run_digest --dry-run > /dev/null
newer=$(find "$NDIR" -type f -newer "$TMP/marker14" 2>/dev/null || true)
[ -z "$newer" ] || { h_fail "row14" "files modified after second run: $newer"; }
h_pass "row14 — idempotent"
# --- row15: PATH contains required dirs ---
SCHEDULE_OUT=$(bin/automouse/morning-digest-cron-setup --print-schedule 2>&1)
status=$?
[ $status -eq 0 ] || { h_fail "row15" "--print-schedule failed with status $status: $SCHEDULE_OUT"; }
assert_contains "row15: /opt/homebrew/bin" "/opt/homebrew/bin" "$SCHEDULE_OUT"
assert_contains "row15: /usr/local/bin" "/usr/local/bin" "$SCHEDULE_OUT"
assert_contains "row15: /usr/bin" "/usr/bin" "$SCHEDULE_OUT"
assert_contains "row15: /bin" "/bin" "$SCHEDULE_OUT"
REPO_BIN_LABEL="$(git worktree list --porcelain 2>/dev/null | awk '/^worktree / && !f {print $2; f=1}')/bin"
assert_contains "row15: repo bin dir" "$REPO_BIN_LABEL" "$SCHEDULE_OUT"
h_pass "row15 — PATH contains required dirs"
# --- row16: no unexpanded variables ---
assert_not_contains "row16: no \${" '${' "$SCHEDULE_OUT"
assert_not_contains "row16: no \$HOME" '$HOME' "$SCHEDULE_OUT"
h_pass "row16 — no unexpanded variables"
# --- row17: no empty string elements ---
assert_not_contains "row17: no empty string" '<string></string>' "$SCHEDULE_OUT"
h_pass "row17 — no empty string elements"
# --- row18: StartCalendarInterval, not StartInterval ---
assert_contains "row18: StartCalendarInterval" "StartCalendarInterval" "$SCHEDULE_OUT"
assert_contains "row18: Hour 7" "<integer>7</integer>" "$SCHEDULE_OUT"
assert_not_contains "row18: no StartInterval" "StartInterval" "$SCHEDULE_OUT"
h_pass "row18 — StartCalendarInterval Hour 7"
# --- row19: bogus flag and install-refusal from worktree ---
bin/automouse/morning-digest-cron-setup --bogus > /dev/null 2>"$TMP/err19a"
status19a=$?
err19a=$(cat "$TMP/err19a")
[ $status19a -eq 1 ] || { h_fail "row19a" "expected exit 1 for --bogus, got $status19a"; }
assert_contains "row19a: Unknown option" "Unknown option" "$err19a"

# Force REPO_ROOT to a worktree path to test the main-checkout refusal
PLIST_FILE="$TMP/com.ibl5.automouse-morning-digest.plist"
REPO_ROOT="$TMP/fake-worktree" MAIN_WT="$TMP/fake-main" bin/automouse/morning-digest-cron-setup --install-schedule > /dev/null 2>"$TMP/err19b"
status19b=$?
[ $status19b -ne 0 ] || { h_fail "row19b" "expected non-zero exit for install from worktree"; }
[ ! -f "$PLIST_FILE" ] || { h_fail "row19b" "plist file created despite refusal"; }
h_pass "row19 — bogus flag and install-refusal"
# --- row20: --date shifts the collection window ---
# Regression guard for the `-mmin -1440` bug: the window was anchored to
# wall-clock NOW, so `--date <past>` collected TODAY's files while reporting the
# past date's spend.  Both directions are asserted — a fix that returned nothing
# for any `--date` would pass the negative assertion alone.
setup
DIG_D="$(date -v-3d +%F 2>/dev/null || date -d '3 days ago' +%F)"
IN_DIG_WINDOW="$(date -v-4d +%Y%m%d 2>/dev/null || date -d '4 days ago' +%Y%m%d)2300"
touch -t "$IN_DIG_WINDOW" "$NDIR/done/plan-backdated.md"   # inside DIG_D's window only
pin "$NDIR/done/plan-lastnight.md"                          # inside TODAY's window only
body=$(run_digest --dry-run --date "$DIG_D")
assert_contains     "row20: backdated plan in --date body"      "plan-backdated" "$body"
assert_not_contains "row20: last-night plan not in --date body" "plan-lastnight" "$body"
body=$(run_digest --dry-run)
assert_contains     "row20: last-night plan in today body"      "plan-lastnight" "$body"
assert_not_contains "row20: backdated plan not in today body"   "plan-backdated" "$body"
h_pass "row20 — --date shifts the collection window"
# --- row21: cron-setup MAIN_WT fallback outside a git tree ---
# Regression guard: `MAIN_WT="${MAIN_WT:-$(git ... | awk ...)}"` under
# `set -euo pipefail` aborted the script here — outside a git tree `git worktree
# list` exits 128, pipefail propagates it, the assignment fails, and -e kills the
# script before the `[ -n "$MAIN_WT" ] ||` fallback on the next line can run.
NOGIT="$TMP/not-a-git-tree"
mkdir -p "$NOGIT"
out21=$(REPO_ROOT="$NOGIT" bin/automouse/morning-digest-cron-setup --print-schedule 2>"$TMP/err21")
status21=$?
[ $status21 -eq 0 ] || { h_fail "row21" "expected exit 0 outside a git tree, got $status21: $(cat "$TMP/err21")"; }
assert_contains "row21: WorkingDirectory falls back to REPO_ROOT" "<string>${NOGIT}</string>" "$out21"
assert_contains "row21: Program path under REPO_ROOT" "${NOGIT}/bin/automouse/morning-digest" "$out21"
h_pass "row21 — MAIN_WT fallback outside a git tree"
# --- row22: duplicate done/ shapes collapse and cost is summed once ---
setup
pin "$NDIR/done/dup-plan.md"
pin "$NDIR/done/${TODAY}-done-dup-plan.md"
cat > "$NDIR/reports/${TODAY}-costs.md" <<'COSTS'
| Plan | Phase | Model | Tier | Cost ($) | Surcharge est ($) | Peak Ctx (K) | In | Out | Cache-read | CW-5m | CW-1h | Prov |
|------|-------|-------|------|----------|-------------------|------------|-----|-----|-----------|-------|-------|------|
| dup-plan.md | impl | claude-sonnet-4-6 | Sonnet | 2.5000 | — | 50 | 100 | 200 | 300 | — | — | real |
COSTS
out=$(run_digest --dry-run)
assert_contains     "row22: one ✅ dup-plan line (dedup collapses two shapes)" "✅ dup-plan" "$out"
[ "$(grep -c '✅ dup-plan' <<< "$out")" = 1 ] || { h_fail "row22" "dup-plan listed more than once"; }
assert_contains     "row22: cost appears in output (normalization join)"           "2.5000"      "$out"
h_pass "row22 — duplicate done/ shapes collapse; cost appears via normalization join"
# --- row23: date-prefixed-only done/ entry joins costs (negative path) ---
setup
pin "$NDIR/done/${TODAY}-done-dup-plan.md"
cat > "$NDIR/reports/${TODAY}-costs.md" <<'COSTS'
| Plan | Phase | Model | Tier | Cost ($) | Surcharge est ($) | Peak Ctx (K) | In | Out | Cache-read | CW-5m | CW-1h | Prov |
|------|-------|-------|------|----------|-------------------|------------|-----|-----|-----------|-------|-------|------|
| dup-plan.md | impl | claude-sonnet-4-6 | Sonnet | 2.5000 | — | 50 | 100 | 200 | 300 | — | — | real |
COSTS
out=$(run_digest --dry-run)
assert_contains     "row23: prefixed name joins costs"  "2.5000"    "$out"
assert_not_contains "row23: not Spend: \$0"             'Spend: $0' "$out"
h_pass "row23 — date-prefixed-only done/ entry joins costs"
# --- row24: StandardOutPath / StandardErrorPath under LOG_DIR ---
# Generated with a throwaway HOME so LOG_DIR is deterministic and nothing touches
# the real ~/Library.  The value is read from the line after each <key>, so a
# path under the wrong key (e.g. stdout/stderr swapped) fails too.
FAKE_HOME24="$TMP/fake-home24"
EXPECT_LOG_DIR="$FAKE_HOME24/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/automouse/logs"
out24=$(HOME="$FAKE_HOME24" bin/automouse/morning-digest-cron-setup --print-schedule 2>"$TMP/err24")
status24=$?
[ $status24 -eq 0 ] || { h_fail "row24" "--print-schedule failed with status $status24: $(cat "$TMP/err24")"; }
plist_value() { printf '%s\n' "$2" | awk -v k="<key>$1</key>" '$0 ~ k {getline; print; exit}'; }
assert_contains "row24: StandardOutPath"   "<string>${EXPECT_LOG_DIR}/morning-digest-stdout.log</string>" "$(plist_value StandardOutPath "$out24")"
assert_contains "row24: StandardErrorPath" "<string>${EXPECT_LOG_DIR}/morning-digest-stderr.log</string>" "$(plist_value StandardErrorPath "$out24")"
h_pass "row24 — StandardOutPath/StandardErrorPath under LOG_DIR"
# --- row25: Held PRs bullets in both body shapes ---
# Report rows follow hp_format_line in bin/lib/held-prs.sh: "#<num>  <url>  <title>
# <reasons>" with two-space columns. The header row and the `hint:` tail must not
# become bullets. Row #15 has a two-space run inside its title.
held_reset
printf '%s\n' \
  'PR  URL  TITLE  REASONS' \
  '#12  https://github.com/o/r/pull/12  Fix thing  needs review; CI red' \
  '#15  https://github.com/o/r/pull/15  Two  spaces title  sticky hold' \
  'hint: gh run rerun 99  # x was CANCELLED on PR #12' > "$TMP/held-out"
mk_fixture_123
body25a=$(run_digest --dry-run)
setup
body25b=$(run_digest --dry-run)
assert_contains "row25: zero-run body is the no-plans shape" "no plans ran last night" "$body25b"
for shape in a b; do
  case "$shape" in a) b25="$body25a" ;; b) b25="$body25b" ;; esac
  assert_contains     "row25$shape: Held PRs (2) header"      "Held PRs (2)" "$b25"
  assert_contains     "row25$shape: row 12 bullet"            "• #12 Fix thing: needs review; CI red <https://github.com/o/r/pull/12>" "$b25"
  assert_contains     "row25$shape: row 15 two-space title"   "• #15 Two  spaces title: sticky hold <https://github.com/o/r/pull/15>" "$b25"
  assert_not_contains "row25$shape: no hint line"             "hint:" "$b25"
  assert_not_contains "row25$shape: no report header row"     "PR  URL" "$b25"
done
pre_spend=${body25a%%Spend:*}
pre_held=${body25a%%Held PRs (2)*}
[ "${#pre_held}" -gt "${#pre_spend}" ] || { h_fail "row25" "Held PRs (2) is not after the Spend: line (offsets ${#pre_held} vs ${#pre_spend})"; }
h_pass "row25 — Held PRs bullets in both body shapes"
# --- row26: zero held PRs ---
held_reset
: > "$TMP/held-out"
mk_fixture_123
body=$(run_digest --dry-run)
assert_contains     "row26: Held PRs: none"     "Held PRs: none" "$body"
assert_not_contains "row26: no Held PRs count"  "Held PRs (" "$body"
h_pass "row26 — zero held PRs"
# --- row27: pr-triage failure renders unavailable, no bullet, digest exits 0 ---
held_reset
printf '%s\n' '#12  https://github.com/o/r/pull/12  Fix thing  needs review' > "$TMP/held-out"
printf '2' > "$TMP/held-rc"
mk_fixture_123
body=$(run_digest --dry-run)
status=$?
[ $status -eq 0 ] || { h_fail "row27" "digest exit status $status, want 0"; }
assert_contains     "row27: unavailable with exit code" "Held PRs: unavailable (pr-triage exit 2)" "$body"
assert_not_contains "row27: no bullet despite stdout row" "• #" "$body"
h_pass "row27 — pr-triage failure"
# --- row28: wall-clock cap ---
held_reset
printf '%s\n' '#12  https://github.com/o/r/pull/12  Fix thing  needs review' > "$TMP/held-out"
printf '30' > "$TMP/held-sleep"
mk_fixture_123
t0=$SECONDS
body=$(MORNING_DIGEST_HELD_TIMEOUT=1 run_digest --dry-run)
elapsed=$((SECONDS - t0))
assert_contains     "row28: timed out after 1s" "Held PRs: unavailable (timed out after 1s)" "$body"
assert_not_contains "row28: no bullet"          "• #" "$body"
[ "$elapsed" -lt 15 ] || { h_fail "row28" "took ${elapsed}s, the 1s cap should end a 30s stub in well under 15s"; }
h_pass "row28 — wall-clock cap"
# --- row29: byte budget and hidden count ---
held_reset
title90=$(printf 'T%.0s' $(seq 1 90))
i=1
: > "$TMP/held-out"
while [ "$i" -le 60 ]; do
  printf '#%s  https://github.com/o/r/pull/%s  %s  needs review\n' "$i" "$i" "$title90" >> "$TMP/held-out"
  i=$((i + 1))
done
mk_fixture_123
body=$(run_digest --dry-run)
bytes=$(printf '%s' "$body" | LC_ALL=C wc -c | tr -d ' ')
[ "$bytes" -le 1900 ] || { h_fail "row29" "body is $bytes bytes, budget is 1900"; }
shown=$(printf '%s\n' "$body" | grep -c '^• #' || true)
[ "$shown" -ge 1 ] || { h_fail "row29" "no bullet shown under the budget"; }
assert_contains "row29: hidden count" "…and $((60 - shown)) more (bin/pr-triage --held)" "$body"
assert_contains "row29: header counts every row" "Held PRs (60)" "$body"
# Boundary: 3 short rows all fit and no "…and" line appears.
held_reset
printf '%s\n' \
  '#1  https://github.com/o/r/pull/1  One  r1' \
  '#2  https://github.com/o/r/pull/2  Two  r2' \
  '#3  https://github.com/o/r/pull/3  Three  r3' > "$TMP/held-out"
body=$(run_digest --dry-run)
assert_not_contains "row29: no …and line for 3 rows" "…and" "$body"
assert_contains     "row29: bullet 1" "• #1 One: r1 <https://github.com/o/r/pull/1>" "$body"
assert_contains     "row29: bullet 2" "• #2 Two: r2 <https://github.com/o/r/pull/2>" "$body"
assert_contains     "row29: bullet 3" "• #3 Three: r3 <https://github.com/o/r/pull/3>" "$body"
h_pass "row29 — byte budget and hidden count"
# --- row30: MORNING_DIGEST_PR_TRIAGE unset and empty both select the default ---
# A sandbox repo makes the default $REPO_ROOT/bin/pr-triage resolve to the stub,
# never the real script.
rm -rf "$TMP/repo"
mkdir -p "$TMP/repo/bin/automouse"
cp "$SCRIPT" "$TMP/repo/bin/automouse/morning-digest"
ln -s "$SCRIPT_DIR/lib" "$TMP/repo/bin/lib"
cp "$BINSTUB/pr-triage" "$TMP/repo/bin/pr-triage"
SANDBOX_DIGEST="$TMP/repo/bin/automouse/morning-digest"
held_reset
mk_fixture_123
body=$(env -u MORNING_DIGEST_PR_TRIAGE NIGHTLY_DIR="$NDIR" DISCORD_DM_BIN="$BINSTUB/discord-dm" MORNING_DIGEST_GH="$BINSTUB/gh" "$SANDBOX_DIGEST" --dry-run)
assert_contains "row30: unset renders none" "Held PRs: none" "$body"
[ "$(cat "$TMP/held-calls.log" 2>/dev/null)" = "HELD --held" ] || { h_fail "row30" "unset: want exactly one 'HELD --held' call, got: $(cat "$TMP/held-calls.log" 2>/dev/null)"; }
held_reset
body=$(MORNING_DIGEST_PR_TRIAGE="" NIGHTLY_DIR="$NDIR" DISCORD_DM_BIN="$BINSTUB/discord-dm" MORNING_DIGEST_GH="$BINSTUB/gh" "$SANDBOX_DIGEST" --dry-run)
assert_contains "row30: empty renders none" "Held PRs: none" "$body"
[ "$(cat "$TMP/held-calls.log" 2>/dev/null)" = "HELD --held" ] || { h_fail "row30" "empty: want exactly one 'HELD --held' call, got: $(cat "$TMP/held-calls.log" 2>/dev/null)"; }
h_pass "row30 — MORNING_DIGEST_PR_TRIAGE unset and empty"
# --- row31: MORNING_DIGEST_HELD_TIMEOUT unset, empty, 0 and non-numeric all select 600 ---
held_reset
printf '%s\n' '#12  https://github.com/o/r/pull/12  Fix thing  needs review' > "$TMP/held-out"
printf '2' > "$TMP/held-sleep"
mk_fixture_123
body=$(env -u MORNING_DIGEST_HELD_TIMEOUT NIGHTLY_DIR="$NDIR" DISCORD_DM_BIN="$BINSTUB/discord-dm" MORNING_DIGEST_GH="$BINSTUB/gh" "$SCRIPT" --dry-run)
assert_contains     "row31 unset: bullet rendered" "• #12" "$body"
assert_not_contains "row31 unset: no timeout"      "timed out" "$body"
for tv in "" 0 abc; do
  body=$(MORNING_DIGEST_HELD_TIMEOUT="$tv" run_digest --dry-run)
  assert_contains     "row31 [$tv]: bullet rendered" "• #12" "$body"
  assert_not_contains "row31 [$tv]: no timeout"      "timed out" "$body"
done
h_pass "row31 — MORNING_DIGEST_HELD_TIMEOUT unset, empty, 0 and non-numeric"
# --- row32: call shape and no send under --dry-run ---
held_reset
printf '%s\n' '#12  https://github.com/o/r/pull/12  Fix thing  needs review' > "$TMP/held-out"
rm -f "$TMP/dm-calls.log"
mk_fixture_123
body=$(run_digest --dry-run)
assert_not_contains "row32: stub accepted --held" "unavailable" "$body"
[ "$(cat "$TMP/held-calls.log" 2>/dev/null)" = "HELD --held" ] || { h_fail "row32" "want exactly one 'HELD --held' call, got: $(cat "$TMP/held-calls.log" 2>/dev/null)"; }
[ ! -f "$TMP/dm-calls.log" ] || { h_fail "row32" "dm-calls.log should not exist after --dry-run"; }
run_digest > /dev/null 2>&1
status=$?
[ $status -eq 0 ] || { h_fail "row32" "real-mode exit status $status"; }
[ "$(grep -c '^CALLED' "$TMP/dm-calls.log" 2>/dev/null)" = 1 ] || { h_fail "row32" "want exactly one CALLED line, got: $(cat "$TMP/dm-calls.log" 2>/dev/null)"; }
assert_contains "row32: real send passes --chunk" "--chunk" "$(cat "$TMP/dm-calls.log" 2>/dev/null)"
h_pass "row32 — call shape and no send"
h_done
