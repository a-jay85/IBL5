test_decide_blind_resets_passed_allows() {
    local PAST out pct
    PAST=$(( $(date +%s) - 60 ))
    blind_setup 95 0 "$PAST" ""
    for pct in 95 99; do
        seed_cache "$(( $(date +%s) - 600 ))" "$(usage_json_resets "$pct" 0 "$PAST" "")"
