}

test_empty_sentinel_env_scoped() {
    local first stale
    new_env
    seed_usage 5 0 1
    mkdir -p "$STATE"
    stale="$STATE/empty-19990101T000000Z"
    : > "$stale"
    queue none-unconfirmed
    IBL5_BURNDOWN_MAX_FAILS=1 run_loop run
    # A leftover from a crashed batch must never vouch for this one.
    assert_contains test_empty_sentinel_env_scoped:failed "$OUT" "batch failed reason=none-selected-unconfirmed"
    assert_no_file test_empty_sentinel_env_scoped:stale-cleared "$stale"
    first=$(head -n 1 "$T/claude.sentinel-env" 2>/dev/null)
    if [[ "$first" =~ ^"$HOME"/\.claude/burndown-loop/empty-[0-9]{8}T[0-9]{6}Z$ ]]; then
        pass test_empty_sentinel_env_scoped:path
    else
        fail test_empty_sentinel_env_scoped:path "got [$first]"
    fi
    assert_eq test_empty_sentinel_env_scoped:none-left 0 \
        "$(find "$STATE" -maxdepth 1 -name 'empty-*' | wc -l | tr -d ' ')"
}

test_empty_sleep_knob() {
    new_env
    seed_usage 5 0 1
    queue none
    stop_on_sleep
    IBL5_BURNDOWN_EMPTY_SLEEP_MIN='' run_loop run
    assert_contains test_empty_sleep_knob:empty "$OUT" "sleep 14400s reason=backlog-empty"

    new_env
    seed_usage 5 0 1
    queue none
    stop_on_sleep
    IBL5_BURNDOWN_EMPTY_SLEEP_MIN=5 run_loop run
    assert_contains test_empty_sleep_knob:five "$OUT" "sleep 300s reason=backlog-empty"

    new_env
    seed_usage 5 0 1
    queue none
    IBL5_BURNDOWN_EMPTY_SLEEP_MIN=0 run_loop run
    assert_eq test_empty_sleep_knob:zero-rc 2 "$RC"
    assert_contains test_empty_sleep_knob:zero-names-var "$OUT" "IBL5_BURNDOWN_EMPTY_SLEEP_MIN"
    assert_eq test_empty_sleep_knob:zero-no-batch 0 "$(calls "$T/claude.calls")"
}

test_empty_streak_survives_reexec() {
    # (a) The carried streak suppresses the DM for the next empty batch.
    new_env
    seed_usage 5 0 1
    queue none
    reexec_handoff 'export IBL5_BURNDOWN_REEXEC_EMPTY_STREAK=1' run
    assert_eq test_empty_streak_survives_reexec:carried-rc 0 "$RC"
    assert_eq test_empty_streak_survives_reexec:carried-no-dm 0 "$(empty_dms)"
    assert_no_file test_empty_streak_survives_reexec:carried-env-unset "$T/claude.reexec-env"

    # (b) A hand-off from older code carries no streak var; the other counters still apply.
    new_env
    seed_usage 5 0 1
    queue none-unconfirmed
    reexec_handoff 'export IBL5_BURNDOWN_REEXEC_FAILS=2 IBL5_BURNDOWN_MAX_FAILS=3' run
    assert_eq test_empty_streak_survives_reexec:absent-rc 1 "$RC"
    assert_contains test_empty_streak_survives_reexec:absent-fails "$OUT" "fails=3/3"
    assert_no_file test_empty_streak_survives_reexec:absent-env-unset "$T/claude.reexec-env"

    # (c) An empty streak value resets nothing.
    new_env
    seed_usage 5 0 1
    queue none-unconfirmed
    reexec_handoff 'export IBL5_BURNDOWN_REEXEC_EMPTY_STREAK="" IBL5_BURNDOWN_REEXEC_FAILS=2 IBL5_BURNDOWN_MAX_FAILS=3' run
    assert_eq test_empty_streak_survives_reexec:blank-rc 1 "$RC"
    assert_contains test_empty_streak_survives_reexec:blank-fails "$OUT" "fails=3/3"
    assert_no_file test_empty_streak_survives_reexec:blank-env-unset "$T/claude.reexec-env"
}

# ---------------------------------------------------------------- runner

TESTS=$(grep -E '^test_[a-z0-9_]+\(\)' "$0" | sed 's/().*//')
if [ "$#" -gt 0 ]; then TESTS="$*"; fi
for t in $TESTS; do
    echo "$t"
    "$t"
done

echo
echo "passed=$PASS failed=$FAIL"
if [ "$FAIL" -ne 0 ]; then
    echo "failed:$FAILED_NAMES"
    exit 1
fi
exit 0
