#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-prune-eligibility — regression harness for bin/prune-vr-galleries
#
# Run: bin/test-prune-eligibility  (exit 0 = all pass, 1 = a case failed)

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
FAILED=0

pass() { echo "PASS: $1"; }
fail() { echo "FAIL: $1 — got $2 want $3"; FAILED=1; }

# ---------------------------------------------------------------------------
# Frozen-clock date stub. Only +%s is answered from $STUB_NOW; everything
# else falls through to the real binary so git and the harness are unaffected.
# ---------------------------------------------------------------------------
mkdir -p "$TMP/stub"
cat > "$TMP/stub/date" <<'STUB'
#!/usr/bin/env bash
# Frozen-clock `date` stub. Only `+%s` is answered from $STUB_NOW; everything
# else falls through to the real binary so git and the harness are unaffected.
if [ "${1:-}" = "+%s" ]; then echo "$STUB_NOW"; else exec /bin/date "$@"; fi
STUB
chmod +x "$TMP/stub/date"

NOW=1750000000

# ---------------------------------------------------------------------------
# Fixture helpers
# ---------------------------------------------------------------------------

# git_init <dir>  — create a git repo with a local identity so CI works
git_init() {
    local d="$1"
    mkdir -p "$d"
    git -C "$d" init -q
    git -C "$d" config user.email test@example.com
    git -C "$d" config user.name Test
}

# git_commit_at <dir> <epoch> <message>  — commit staged changes at a fixed time
git_commit_at() {
    local d="$1" epoch="$2" msg="$3"
    GIT_COMMITTER_DATE="@${epoch}" GIT_AUTHOR_DATE="@${epoch}" \
        git -C "$d" commit -q -m "$msg"
}

# run_prune <repo-dir> [extra args…]  — sets OUT (stdout), ERR (stderr), RC
run_prune() {
    local d="$1"; shift
    OUT="$(cd "$d" && STUB_NOW=$NOW PATH="$TMP/stub:$PATH" \
           "$SCRIPT_DIR/prune-vr-galleries" "$@" 2>"$TMP/run_err")"
    # shellcheck disable=SC2034  # RC available to callers for exit-code assertions
    RC=$?
    ERR="$(cat "$TMP/run_err")"
}

# ---------------------------------------------------------------------------
# Case: older-than-cutoff-prunes
# ---------------------------------------------------------------------------
SHA_OLD="abcdef1234abcdef1234abcdef1234abcdef1234"
REPO="$TMP/case-old"
git_init "$REPO"
mkdir -p "$REPO/$SHA_OLD"
echo "content" > "$REPO/$SHA_OLD/index.html"
git -C "$REPO" add .
git_commit_at "$REPO" $(( NOW - 10*86400 )) "old dir"

run_prune "$REPO" --dry-run --cutoff-days 7
if echo "$OUT" | grep -qF "WOULD PRUNE: ./$SHA_OLD"; then
    pass "older-than-cutoff-prunes"
else
    fail "older-than-cutoff-prunes" "$OUT" "WOULD PRUNE: ./$SHA_OLD in stdout"
fi

# ---------------------------------------------------------------------------
# Case: newer-than-cutoff-keeps
# ---------------------------------------------------------------------------
SHA_NEW="1234567890abcdef1234567890abcdef12345678"
REPO="$TMP/case-new"
git_init "$REPO"
mkdir -p "$REPO/$SHA_NEW"
echo "content" > "$REPO/$SHA_NEW/index.html"
git -C "$REPO" add .
git_commit_at "$REPO" $(( NOW - 2*86400 )) "new dir"

run_prune "$REPO" --dry-run --cutoff-days 7
CASE_PASS=1
if ! echo "$OUT" | grep -qF "KEEP: ./$SHA_NEW"; then CASE_PASS=0; fi
if echo "$OUT" | grep -qF "WOULD PRUNE"; then CASE_PASS=0; fi
if [ "$CASE_PASS" -eq 1 ]; then
    pass "newer-than-cutoff-keeps"
else
    fail "newer-than-cutoff-keeps" "$OUT" "KEEP: ./$SHA_NEW and no WOULD PRUNE"
fi

# ---------------------------------------------------------------------------
# Case: boundary-exact-cutoff-keeps
# ---------------------------------------------------------------------------
SHA_BOUNDARY="cafebabe00cafebabe00cafebabe00cafebabe00"
REPO="$TMP/case-boundary"
git_init "$REPO"
mkdir -p "$REPO/$SHA_BOUNDARY"
echo "content" > "$REPO/$SHA_BOUNDARY/index.html"
git -C "$REPO" add .
git_commit_at "$REPO" $(( NOW - 7*86400 )) "boundary dir"

run_prune "$REPO" --dry-run --cutoff-days 7
CASE_PASS=1
if ! echo "$OUT" | grep -qF "KEEP: ./$SHA_BOUNDARY"; then CASE_PASS=0; fi
if echo "$OUT" | grep -qF "WOULD PRUNE"; then CASE_PASS=0; fi
if [ "$CASE_PASS" -eq 1 ]; then
    pass "boundary-exact-cutoff-keeps"
else
    fail "boundary-exact-cutoff-keeps" "$OUT" "KEEP: ./$SHA_BOUNDARY and no WOULD PRUNE"
fi

# ---------------------------------------------------------------------------
# Case: empty-timestamp-keeps-fail-closed
# ---------------------------------------------------------------------------
SHA_COMMITTED="deadbeef00deadbeef00deadbeef00deadbeef00"
SHA_UNTRACKED="feedface00feedface00feedface00feedface00"
REPO="$TMP/case-empty-ts"
git_init "$REPO"
# Committed dir so the repo has at least one commit (prevents git log exit 128)
mkdir -p "$REPO/$SHA_COMMITTED"
echo "content" > "$REPO/$SHA_COMMITTED/index.html"
git -C "$REPO" add .
git_commit_at "$REPO" $(( NOW - 10*86400 )) "committed dir"
# Untracked 40-hex dir — git log -1 --format=%ct returns empty
mkdir -p "$REPO/$SHA_UNTRACKED"
echo "content" > "$REPO/$SHA_UNTRACKED/index.html"

run_prune "$REPO" --dry-run --cutoff-days 7
CASE_PASS=1
if echo "$OUT" | grep -qF "WOULD PRUNE: ./$SHA_UNTRACKED"; then CASE_PASS=0; fi
if ! echo "$ERR" | grep -qF "no git history"; then CASE_PASS=0; fi
if [ "$CASE_PASS" -eq 1 ]; then
    pass "empty-timestamp-keeps-fail-closed"
else
    fail "empty-timestamp-keeps-fail-closed" \
         "OUT=$OUT ERR=$ERR" \
         "no WOULD PRUNE for untracked dir, stderr has 'no git history'"
fi

# ---------------------------------------------------------------------------
# Case: non-40-hex-never-selected
# ---------------------------------------------------------------------------
SHA_39="abcdef1234abcdef1234abcdef1234abcdef123"    # 39 hex chars
SHA_41="abcdef1234abcdef1234abcdef1234abcdef12345"  # 41 hex chars
REPO="$TMP/case-non40"
git_init "$REPO"
mkdir -p "$REPO/master-scripts" "$REPO/assets" "$REPO/$SHA_39" "$REPO/$SHA_41"
touch "$REPO/index.html"
echo "content" > "$REPO/master-scripts/run.sh"
echo "content" > "$REPO/assets/style.css"
echo "content" > "$REPO/$SHA_39/index.html"
echo "content" > "$REPO/$SHA_41/index.html"
git -C "$REPO" add .
git_commit_at "$REPO" $(( NOW - 10*86400 )) "non-hex dirs"

run_prune "$REPO" --dry-run --cutoff-days 7
CASE_PASS=1
for name in master-scripts assets "$SHA_39" "$SHA_41"; do
    if echo "$OUT" | grep -qF "$name"; then CASE_PASS=0; fi
done
if [ "$CASE_PASS" -eq 1 ]; then
    pass "non-40-hex-never-selected"
else
    fail "non-40-hex-never-selected" \
         "$OUT" \
         "none of master-scripts/assets/39-char/41-char hex dirs in stdout"
fi

# ---------------------------------------------------------------------------
# Case: usage-rejects-unknown-flag
# ---------------------------------------------------------------------------
CASE_PASS=1

# --unknown flag: exit 1, empty stdout, usage on stderr
OUT_U="$(STUB_NOW=$NOW PATH="$TMP/stub:$PATH" \
         "$SCRIPT_DIR/prune-vr-galleries" --unknown 2>"$TMP/ufl_err")"
RC_U=$?
ERR_U="$(cat "$TMP/ufl_err")"
if [ "$RC_U" -ne 1 ]; then CASE_PASS=0; fi
if [ -n "$OUT_U" ]; then CASE_PASS=0; fi
if ! echo "$ERR_U" | grep -qi "usage"; then CASE_PASS=0; fi

# --cutoff-days abc: exit 1, empty stdout
OUT_C="$(STUB_NOW=$NOW PATH="$TMP/stub:$PATH" \
         "$SCRIPT_DIR/prune-vr-galleries" --cutoff-days abc 2>/dev/null)"
RC_C=$?
if [ "$RC_C" -ne 1 ]; then CASE_PASS=0; fi
if [ -n "$OUT_C" ]; then CASE_PASS=0; fi

if [ "$CASE_PASS" -eq 1 ]; then
    pass "usage-rejects-unknown-flag"
else
    fail "usage-rejects-unknown-flag" \
         "RC_U=$RC_U OUT_U='$OUT_U' RC_C=$RC_C" \
         "both exit 1, --unknown has empty stdout and usage on stderr"
fi

# ---------------------------------------------------------------------------
# Case: live-mode-stages-and-counts
# ---------------------------------------------------------------------------
SHA_STALE="aabbccddeeaabbccddeeaabbccddeeaabbccddee"
SHA_FRESH="0011223344556677889900112233445566778899"
REPO="$TMP/case-live"
git_init "$REPO"
mkdir -p "$REPO/$SHA_STALE" "$REPO/$SHA_FRESH"
echo "content" > "$REPO/$SHA_STALE/index.html"
echo "content" > "$REPO/$SHA_FRESH/index.html"
git -C "$REPO" add .
git_commit_at "$REPO" $(( NOW - 10*86400 )) "initial commit"
# Update fresh dir with a new commit so it has a recent timestamp
echo "updated" > "$REPO/$SHA_FRESH/index.html"
git -C "$REPO" add .
git_commit_at "$REPO" $(( NOW - 2*86400 )) "fresh update"

LIVE_OUT="$(cd "$REPO" && STUB_NOW=$NOW PATH="$TMP/stub:$PATH" \
            "$SCRIPT_DIR/prune-vr-galleries" 2>/dev/null)"
STAGED="$(git -C "$REPO" diff --cached --name-only)"

CASE_PASS=1
if ! echo "$STAGED" | grep -qF "$SHA_STALE/"; then CASE_PASS=0; fi
if echo "$STAGED" | grep -qF "$SHA_FRESH/"; then CASE_PASS=0; fi
if [ ! -d "$REPO/$SHA_FRESH" ]; then CASE_PASS=0; fi
if [ "$LIVE_OUT" != "1" ]; then CASE_PASS=0; fi
if [ "$CASE_PASS" -eq 1 ]; then
    pass "live-mode-stages-and-counts"
else
    fail "live-mode-stages-and-counts" \
         "OUT='$LIVE_OUT' STAGED='$STAGED' fresh_exists=$([ -d "$REPO/$SHA_FRESH" ] && echo yes || echo no)" \
         "stale staged only, fresh dir exists on disk, stdout=1"
fi

# ---------------------------------------------------------------------------
# Case: stdout-single-integer-line
# ---------------------------------------------------------------------------
SHA_A="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
SHA_B="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
REPO2="$TMP/case-stdout"
git_init "$REPO2"
mkdir -p "$REPO2/$SHA_A" "$REPO2/$SHA_B"
echo "content" > "$REPO2/$SHA_A/index.html"
echo "content" > "$REPO2/$SHA_B/index.html"
git -C "$REPO2" add .
git_commit_at "$REPO2" $(( NOW - 10*86400 )) "initial commit"
echo "updated" > "$REPO2/$SHA_B/index.html"
git -C "$REPO2" add .
git_commit_at "$REPO2" $(( NOW - 2*86400 )) "fresh update"

OUT_B="$(cd "$REPO2" && STUB_NOW=$NOW PATH="$TMP/stub:$PATH" \
         "$SCRIPT_DIR/prune-vr-galleries" 2>/dev/null)"
LINE_COUNT="$(printf '%s\n' "$OUT_B" | wc -l | tr -d ' ')"

CASE_PASS=1
if [ "$LINE_COUNT" -ne 1 ]; then CASE_PASS=0; fi
if ! printf '%s\n' "$OUT_B" | grep -qE '^[0-9]+$'; then CASE_PASS=0; fi
if [ "$CASE_PASS" -eq 1 ]; then
    pass "stdout-single-integer-line"
else
    fail "stdout-single-integer-line" \
         "OUT='$OUT_B' lines=$LINE_COUNT" \
         "wc -l is 1 and line matches ^[0-9]+$"
fi

# ---------------------------------------------------------------------------
# Case: dry-run-count-matches-would-prune-count
# ---------------------------------------------------------------------------
SHA_P1="1111111111111111111111111111111111111111"
SHA_P2="2222222222222222222222222222222222222222"
SHA_K1="3333333333333333333333333333333333333333"
REPO="$TMP/case-dryrun-count"
git_init "$REPO"
mkdir -p "$REPO/$SHA_P1" "$REPO/$SHA_P2" "$REPO/$SHA_K1"
echo "content" > "$REPO/$SHA_P1/index.html"
echo "content" > "$REPO/$SHA_P2/index.html"
echo "content" > "$REPO/$SHA_K1/index.html"
git -C "$REPO" add .
git_commit_at "$REPO" $(( NOW - 10*86400 )) "two old one fresh"
echo "updated" > "$REPO/$SHA_K1/index.html"
git -C "$REPO" add .
git_commit_at "$REPO" $(( NOW - 2*86400 )) "fresh update"

run_prune "$REPO" --dry-run --cutoff-days 7
WOULD_COUNT="$(printf '%s\n' "$OUT" | grep -c '^WOULD PRUNE:')"
TRAIL="$(printf '%s\n' "$OUT" | tail -1)"

CASE_PASS=1
if ! printf '%s\n' "$TRAIL" | grep -qE '^[0-9]+$'; then CASE_PASS=0; fi
if [ "$TRAIL" != "$WOULD_COUNT" ]; then CASE_PASS=0; fi
if [ "$CASE_PASS" -eq 1 ]; then
    pass "dry-run-count-matches-would-prune-count"
else
    fail "dry-run-count-matches-would-prune-count" \
         "trailing='$TRAIL' would_prune_count='$WOULD_COUNT'" \
         "trailing integer == number of WOULD PRUNE: lines (expected 2)"
fi

exit "$FAILED"
