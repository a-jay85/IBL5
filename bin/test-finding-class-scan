}

case_table_row_cap() {
    local fn rows out i
    fn="$(sed -n '/^threads_table() {/,/^}/p' "$FCS")"
    rows="["
    for i in 1 2 3 4 5; do
        rows="$rows{\"url\":\"https://github.com/a-jay85/IBL5/pull/$i#discussion_r$i\",\"pr\":$i,\"path\":\"a.php\",\"line\":$i,\"resolved\":false},"
    done
    rows="$rows{\"url\":\"https://example.com/bad\",\"pr\":9,\"path\":\"x\",\"line\":1,\"resolved\":false}]"
    out="$(bash -c "clean_inline() { printf '%s' \"\$1\"; }; TABLE_ROW_CAP=3; REPO_SLUG=a-jay85/IBL5; $fn; threads_table '$rows'")"
    expect_eq "cap: three rows listed" 3 "$(grep -c '^| \[thread\]' <<< "$out")"
    expect_has "cap: the overflow counts valid rows only" "$out" "2 more threads are not listed here."
}

case_env_zero_and_dry_run_state_dir() {
    new_fixture
    set_payload "$EMPTY_PAYLOAD"
    local n
    for n in FCS_CLASSIFY_TIMEOUT FCS_VERIFY_TIMEOUT FCS_MAX_BATCHES; do
        XENV="$n=0"
        fcs --dry-run
        expect_eq "env: $n=0 exits 2" 2 "$RC"
    done
    XENV=""
    rm -rf "$STATE"
    fcs --dry-run
    expect_eq "dry run on a missing state dir exits 0" 0 "$RC"
    if [ -e "$STATE" ]; then fail "dry run created the state dir"; else ok "dry run does not create the state dir"; fi
    expect_has "empty batch is logged" "$ALL" "the classifier assigned none of its"
}

