hr_run
need "rc 20" test "$RC" = 20
need "final line" final_is "$STDOUT" skip-live-postplan-now
need "no claude call" no_args
need "no ledger file" no_ledger
printf '124\t0\tcom.ibl5.post-plan-fleet-77\n' > "$TMP/launchctl.list"
export CLAUDE_STUB_REPLY="$TMP/reply-hr-nothing"
hr_run
need "lone fleet label: session ran" test -e "$TMP/claude.args"
need "lone fleet label: not skipped as live" final_is "$STDOUT" gave-up-nothing-to-fix
case_end holdrepeat-live-label
fi

