#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/rebuild-css-if-source-changed — heal a stale compiled Tailwind stylesheet
# after a git operation that the --watch container did not observe.
#
# The `ibl5-tailwind[-<slug>]` container runs `@tailwindcss/cli --watch`, which
# reacts to filesystem events. Editor saves propagate (~1s rebuild), but git
# BULK file replacement (rebase / checkout / merge / pull rewriting a source
# file via rename) is not reliably delivered to @parcel/watcher through the
# macOS→Docker bind mount — so the compiled `themes/IBL/style/style.css` silently
# goes stale relative to `design/**`. `bin/wt-new`/`bin/wt-up` build it once at
# worktree create/up; this heals the gap for every git op AFTER that. After a
# rebuild it also restarts the checkout's watcher, which missed the same events
# and would otherwise overwrite the fresh output from its stale in-memory sources.
#
# Wired (via bin/install-git-hooks) into post-checkout, post-merge, and
# post-rewrite — the git ops that bulk-rewrite the working tree. Safe to call
# unconditionally: all work, including the mtime gate, runs backgrounded under a
# per-checkout mkdir lock, so the two hooks a rebase fires run one after the
# other and the second no-ops when the first already rebuilt.

set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
Usage: bin/rebuild-css-if-source-changed

Rebuild the compiled Tailwind stylesheet when a CSS source file under design/
is newer than the compiled output. No-op if sources are already fresh.

Wired into post-checkout, post-merge, and post-rewrite git hooks.

Arguments: none
EOF
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
IBL5="$REPO_ROOT/ibl5"
INPUT="$IBL5/design/input.css"
OUTPUT="$IBL5/themes/IBL/style/style.css"
DESIGN="$IBL5/design"
[ -f "$INPUT" ] || exit 0   # not an ibl5 checkout (or design/ absent) — nothing to do

LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/ibl5-hooks"
mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/css-rebuild.log"
slug="$(basename "$REPO_ROOT")"

# One lock per checkout serializes the post-checkout + post-rewrite pair that a
# rebase fires. mkdir is atomic on macOS and Linux; macOS ships no flock.
LOCK_DIR="$LOG_DIR/css-rebuild-$slug.lock"
LOCK_WAIT_SECS="${CSS_REBUILD_LOCK_WAIT_SECS:-120}"
case "$LOCK_WAIT_SECS" in *[!0-9]*) LOCK_WAIT_SECS=120 ;; esac

lock_acquire() {
    local waited=0 logged=0 holder
    while ! mkdir "$LOCK_DIR" 2>/dev/null; do
        holder="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
        if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
            echo "$(date): removed stale css lock from dead pid $holder ($slug)" >> "$LOG"
            rm -rf "$LOCK_DIR"
            continue
        fi
        if [ "$logged" = 0 ]; then
            echo "$(date): css lock held by pid ${holder:-unknown}, waiting up to ${LOCK_WAIT_SECS}s ($slug)" >> "$LOG"
            logged=1
        fi
        if [ "$waited" -ge "$LOCK_WAIT_SECS" ]; then
            echo "$(date): css lock wait timed out after ${LOCK_WAIT_SECS}s, taking it over ($slug)" >> "$LOG"
            rm -rf "$LOCK_DIR"
            waited=0
            logged=0
            continue
        fi
        sleep 1
        waited=$((waited + 1))
    done
    # $$ is the hook process, which exits at once. sh's parent is this subshell,
    # so this records the PID that actually holds the lock (bash 3.2 has no BASHPID).
    sh -c 'echo "$PPID"' > "$LOCK_DIR/pid"
    LOCK_PID="$(cat "$LOCK_DIR/pid")"
}

lock_release() {
    if [ "$(cat "$LOCK_DIR/pid" 2>/dev/null || true)" = "${LOCK_PID:-}" ]; then
        rm -rf "$LOCK_DIR"
    fi
}

# Everything, including the mtime gate, runs in the background so the git
# operation returns immediately.
(
    lock_acquire
    trap lock_release EXIT
    # Gate inside the lock: the second run of a rebase pair waits here, then
    # no-ops (and skips the restart) when the first run already rebuilt.
    # Rebuild only when a CSS source under design/ is newer than the compiled
    # output (git sets a rewritten file's mtime to checkout time, so an unchanged
    # op leaves every source older than OUTPUT → no-op). Missing OUTPUT → rebuild.
    if [ -f "$OUTPUT" ] && [ -z "$(find "$DESIGN" -type f -newer "$OUTPUT" -print -quit 2>/dev/null)" ]; then
        echo "$(date): css fresh, skip ($REPO_ROOT)" >> "$LOG"
        exit 0
    fi
    STAMP="$LOCK_DIR/build-start"
    : > "$STAMP"
    built=0
    echo "$(date): css source newer than output — rebuilding ($slug)" >> "$LOG"
    if command -v bunx >/dev/null 2>&1 &&
        (cd "$IBL5" && bunx @tailwindcss/cli -i design/input.css -o themes/IBL/style/style.css) >> "$LOG" 2>&1; then
        echo "$(date): css rebuilt on host ($slug)" >> "$LOG"
        built=1
    else
        # Fallback: the tailwind container always has the toolchain. Worktree
        # stacks are ibl5-tailwind-<slug>; the main stack is ibl5-tailwind.
        # Capture once, then grep the variable: `docker ps | grep -q` can SIGPIPE
        # the producer (141), which pipefail reports as a false failure.
        running="$(docker ps --format '{{.Names}}' 2>/dev/null || true)"
        container="ibl5-tailwind-$slug"
        grep -qx -- "$container" <<< "$running" || container="ibl5-tailwind"
        if grep -qx -- "$container" <<< "$running" &&
            docker exec "$container" bunx @tailwindcss/cli -i design/input.css -o themes/IBL/style/style.css >> "$LOG" 2>&1; then
            echo "$(date): css rebuilt in $container" >> "$LOG"
            built=1
        else
            echo "$(date): css rebuild FAILED — no host bunx and no usable tailwind container ($slug)" >> "$LOG"
        fi
    fi

    # Backdate OUTPUT to build start. A source that git rewrites mid-build then stays
    # newer than OUTPUT, so the next hook run rebuilds instead of skipping.
    if [ "$built" = 1 ]; then touch -c -r "$STAMP" "$OUTPUT"; fi

    # Restart this checkout's watcher so it re-reads design/** from disk. It missed
    # the git op's events, so its in-memory copy of the sources is stale. Left
    # running, its next save-triggered rebuild writes that stale copy over the fresh
    # output above, and the result is newer than every source, so the mtime gate
    # then skips on every later git op. Only the watcher whose bind mount is THIS
    # checkout: the main checkout (git dir == common dir) owns ibl5-tailwind.
    if [ "$(git -C "$REPO_ROOT" rev-parse --path-format=absolute --git-dir)" = \
         "$(git -C "$REPO_ROOT" rev-parse --path-format=absolute --git-common-dir)" ]; then
        watcher="ibl5-tailwind"
    else
        watcher="ibl5-tailwind-$slug"
    fi
    running="$(docker ps --format '{{.Names}}' 2>/dev/null || true)"
    if grep -qx -- "$watcher" <<< "$running"; then
        if docker restart "$watcher" >> "$LOG" 2>&1; then
            echo "$(date): restarted $watcher to drop its stale source graph" >> "$LOG"
        else
            echo "$(date): restart of $watcher FAILED" >> "$LOG"
        fi
    fi
) &
disown 2>/dev/null || true

exit 0
