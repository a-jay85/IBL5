#!/usr/bin/env bash
# shellcheck shell=bash
# Cases are dispatched by name (SC2329); PHP fixtures are literal (SC2016).
# shellcheck disable=SC2329,SC2016
#
# bin/test-wt-pool — sandbox harness for bin/wt-new and its warm-standby pool
# (bin/lib/wt-pool.sh, backlog#24).
#
# Every case builds a throwaway origin/main/worktrees trio under mktemp, seeded
# with copies of the real bin/wt-new and bin/lib/*.sh, so nothing real is touched.
# HOME is a sandbox dir, so a launchd plist write never reaches ~/Library.
#
# Run: bin/test-wt-pool                 every case
#      bin/test-wt-pool <case>...       only the named cases (case_<name>)
# Exit 0 = all selected cases pass, 1 = a case failed, 2 = unknown case name.

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SELF="$SCRIPT_DIR/$(basename "$0")"
WTNEW="$SCRIPT_DIR/wt-new"
TMP="$(mktemp -d)"
TMP="$(cd -P "$TMP" && pwd)"
trap 'chmod -R u+w "$TMP" 2>/dev/null; rm -rf "$TMP" 2>/dev/null' EXIT

mkdir -p "$TMP/home"
export HOME="$TMP/home"
export WT_POOL_KICK=none
unset CLAUDE_CODE_SESSION_ID WT_POOL BUNX_FAIL
# Pin a sandbox identity so `env -i` runs and CI runners commit the same way.
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t
export GIT_CONFIG_NOSYSTEM=1

FAILED=0
pass()     { echo "ok: $1"; }
failcase() { echo "FAIL: $1"; FAILED=1; }

# assert_absent <name> <regex> <haystack>
assert_absent() {
    if grep -qE -- "$2" <<< "$3"; then
        failcase "$1 — expected NOT to match: $2"
        printf '%s\n' "$3" | sed 's/^/    /'
    else
        pass "$1"
    fi
}

# assert_match <name> <regex> <haystack>
assert_match() {
    if grep -qE -- "$2" <<< "$3"; then
        pass "$1"
    else
        failcase "$1 — expected to match: $2"
        printf '%s\n' "$3" | sed 's/^/    /'
    fi
}

# assert_eq <name> <expected> <actual>
assert_eq() {
    if [ "$2" = "$3" ]; then pass "$1"; else failcase "$1 — expected '$2', got '$3'"; fi
}

git_q() { git -c user.email=t@t -c user.name=t -c init.defaultBranch=master "$@"; }

canon() { (cd -P "$1" 2>/dev/null && pwd) || printf '%s\n' "$1"; }

# new_pool_env — build <TMP>/env.XXXX/{origin.git,IBL5,IBL5-worktrees,stub-bin}
# shaped like the real main checkout: tracked config examples, a tracked
# docker-compose.yml, and the untracked vendor/node_modules/.env*/config files
# wt-new links or copies. Echoes the env base path.
new_pool_env() {
    local base m
    base="$(mktemp -d "$TMP/env.XXXXXX")"
    m="$base/IBL5"
    git_q init -q --bare "$base/origin.git" >/dev/null 2>&1
    git_q clone -q "$base/origin.git" "$m" >/dev/null 2>&1
    mkdir -p "$m/bin/lib" "$m/ibl5/design" "$m/ibl5/tests" "$base/IBL5-worktrees" "$base/stub-bin"
    cp "$WTNEW" "$m/bin/wt-new"
    cp "$SCRIPT_DIR/wt-status" "$m/bin/wt-status"
    cp "$SCRIPT_DIR"/lib/*.sh "$m/bin/lib/" 2>/dev/null
    chmod +x "$m/bin/wt-new" "$m/bin/wt-status"
    echo 'services: {}' > "$m/docker-compose.yml"
    echo '@import "tailwindcss";' > "$m/ibl5/design/input.css"
    echo '<?php $dbname = "example";' > "$m/ibl5/config.php.example"
    echo '<?php $dbuser = "example";' > "$m/ibl5/config.local.php.example"
    echo '<?php echo "hi";' > "$m/ibl5/index.php"
    : > "$m/ibl5/tests/.keep"
    cat > "$m/.gitignore" <<'EOF'
ibl5/vendor
ibl5/node_modules
ibl5/.env
ibl5/.env.test
ibl5/config.php
ibl5/config.local.php
ibl5/themes/IBL/style/style.css
EOF
    git_q -C "$m" add -A >/dev/null 2>&1
    git_q -C "$m" commit -qm C1 >/dev/null 2>&1
    git_q -C "$m" push -q -u origin master >/dev/null 2>&1

    # Untracked, gitignored state the main checkout carries.
    mkdir -p "$m/ibl5/vendor" "$m/ibl5/node_modules" "$m/ibl5/themes/IBL/style"
    echo '<?php' > "$m/ibl5/vendor/autoload.php"
    : > "$m/ibl5/node_modules/.keep"
    echo 'A=1' > "$m/ibl5/.env"
    echo 'A=2' > "$m/ibl5/.env.test"
    echo '<?php $dbname = "main";' > "$m/ibl5/config.php"
    echo '<?php $dbuser = "main";' > "$m/ibl5/config.local.php"
    echo 'main-css' > "$m/ibl5/themes/IBL/style/style.css"

    # bunx stub: log the call (plus a probe line when the pool readiness marker
    # already exists for this worktree), then write the -o target.
    cat > "$base/stub-bin/bunx" <<EOF
#!/bin/bash
echo "\$PWD \$*" >> "$base/bunx.calls"
gd="\$(git rev-parse --absolute-git-dir 2>/dev/null)" \\
    && [ -f "\$gd/wt-pool-ready" ] && echo marker-present >> "$base/bunx.calls"
[ "\${BUNX_FAIL:-}" = 1 ] && exit 1
out="" prev=""
for a in "\$@"; do [ "\$prev" = "-o" ] && out="\$a"; prev="\$a"; done
[ -n "\$out" ] && echo stub-css > "\$out"
exit 0
EOF
    # launchctl stub: log the args, succeed.
    cat > "$base/stub-bin/launchctl" <<EOF
#!/bin/bash
echo "\$*" >> "$base/launchctl.calls"
exit 0
EOF
    # gh stub: no PRs anywhere.
    printf '#!/bin/bash\nexit 1\n' > "$base/stub-bin/gh"
    chmod +x "$base/stub-bin/bunx" "$base/stub-bin/launchctl" "$base/stub-bin/gh"
    printf '%s\n' "$base"
}

# pool_sh <base> <code> [args...] — run <code> in a bash that sourced the
# sandbox libs, with the wt-new globals set; extra args become $1...
pool_sh() {
    local base="$1"; shift
    (cd "$base/IBL5" && PATH="$base/stub-bin:$PATH" REPO_ROOT="$base/IBL5" \
        WT_PARENT="$base/IBL5-worktrees" MAIN_IBL5="$base/IBL5/ibl5" \
        bash -c '. bin/lib/git-helpers.sh; . bin/lib/launchd-job.sh; . bin/lib/wt-pool.sh
                 code="$1"; shift; eval "$code"' _ "$@" 2>&1)
}

# refill <base> — build the warm slot, output discarded.
refill() { wtnew "$1" --pool-refill >/dev/null; }

# ready_count <base> — number of guarded, ready _pool-* slots.
ready_count() {
    pool_sh "$1" 'n=0; for p in "$WT_PARENT"/_pool-*; do
        [ -d "$p" ] && pool_is_slot "$WT_PARENT" "$p" && pool_is_ready "$p" && n=$((n + 1))
    done; echo "$n"'
}

# hold_lock <base> <pid> <epoch> — plant a pool lock owned by <pid>.
hold_lock() {
    local lock="$1/IBL5/.git/wt-pool.lock"
    rm -rf "$lock"; mkdir -p "$lock"
    printf '%s\n%s\n' "$2" "$3" > "$lock/owner"
}

# slot_ready <base> <path> — 0 when <path> is a guarded, ready slot.
slot_ready() { pool_sh "$1" 'pool_is_slot "$WT_PARENT" "$1" && pool_is_ready "$1"' "$2" >/dev/null; }

# no_pool_dirs <base> — 0 when no _pool-* dir exists.
no_pool_dirs() { ! ls -d "$1"/IBL5-worktrees/_pool-* >/dev/null 2>&1; }

# bunx_calls <base> — number of real bunx invocations (probe lines excluded).
bunx_calls() {
    if [ -f "$1/bunx.calls" ]; then
        grep -vc '^marker-present$' "$1/bunx.calls" || true
    else
        echo 0
    fi
}

# wtnew <base> <args...> — run the sandbox wt-new from the main checkout with
# stub-bin first on PATH; prints combined output, returns wt-new's exit code.
wtnew() {
    local base="$1"; shift
    (cd "$base/IBL5" && PATH="$base/stub-bin:$PATH" "$base/IBL5/bin/wt-new" "$@" 2>&1)
}

# admin_dir <path> — the worktree's absolute git admin dir.
admin_dir() { git -C "$1" rev-parse --absolute-git-dir; }

# wt_postconditions <base> <slug> — the full shape of a finished worktree.
wt_postconditions() {
    local base="$1" slug="$2" wt m name
    wt="$base/IBL5-worktrees/$slug"
    m="$base/IBL5/ibl5"
    assert_eq "$slug: branch == slug" "$slug" "$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>&1)"
    assert_eq "$slug: toplevel" "$(canon "$wt")" "$(canon "$(git -C "$wt" rev-parse --show-toplevel 2>&1)")"
    assert_eq "$slug: clean status" "" "$(git -C "$wt" status --porcelain 2>&1)"
    assert_eq "$slug: iblBase" "master" "$(git -C "$wt" config "branch.$slug.iblBase" 2>&1)"
    for name in vendor node_modules .env .env.test; do
        if [ -L "$wt/ibl5/$name" ] && [ "$(readlink "$wt/ibl5/$name")" = "$m/$name" ]; then
            pass "$slug: ibl5/$name links to main"
        else
            failcase "$slug: ibl5/$name links to main (got '$(readlink "$wt/ibl5/$name" 2>&1)')"
        fi
    done
    for name in config.php config.local.php; do
        if [ -f "$wt/ibl5/$name" ] && [ ! -L "$wt/ibl5/$name" ]; then
            pass "$slug: ibl5/$name is a regular file"
        else
            failcase "$slug: ibl5/$name is a regular file"
        fi
    done
    if [ -e "$m/vendor/vendor" ] || [ -L "$m/vendor/vendor" ] \
        || [ -e "$m/node_modules/node_modules" ] || [ -L "$m/node_modules/node_modules" ]; then
        failcase "$slug: main gained a nested vendor/node_modules link"
    else
        pass "$slug: main has no nested vendor/node_modules link"
    fi
}

# ---------------------------------------------------------------------------
# Cold path (rows 1-4)
# ---------------------------------------------------------------------------

case_cold_postconditions() {
    local base out rc
    base="$(new_pool_env)"
    out="$(CLAUDE_CODE_SESSION_ID=sess-cold wtnew "$base" alpha)"; rc=$?
    assert_eq "cold: exit 0" 0 "$rc"
    [ "$rc" = 0 ] || printf '%s\n' "$out" | sed 's/^/    /'
    wt_postconditions "$base" alpha
    assert_eq "cold: session file" "sess-cold" \
        "$(cat "$(admin_dir "$base/IBL5-worktrees/alpha")/wt-new-session" 2>&1)"
    assert_eq "cold: one bunx call" 1 "$(bunx_calls "$base")"
}

case_cold_session_absent() {
    local base
    base="$(new_pool_env)"
    wtnew "$base" bravo >/dev/null
    CLAUDE_CODE_SESSION_ID='' wtnew "$base" charlie >/dev/null
    if [ -e "$(admin_dir "$base/IBL5-worktrees/bravo")/wt-new-session" ]; then
        failcase "session unset: no wt-new-session"
    else
        pass "session unset: no wt-new-session"
    fi
    if [ -e "$(admin_dir "$base/IBL5-worktrees/charlie")/wt-new-session" ]; then
        failcase "session empty: no wt-new-session"
    else
        pass "session empty: no wt-new-session"
    fi
}

# Re-invokes this harness, so it is excluded from the no-arg run.
case_unknown_case_rejected() {
    local out rc
    out="$("$SELF" no_such_case 2>&1)"; rc=$?
    assert_eq "unknown case: exit 2" 2 "$rc"
    assert_match "unknown case: names it" '^unknown case: no_such_case$' "$out"
}

# ---------------------------------------------------------------------------
# Extracted tail (rows 5-6)
# ---------------------------------------------------------------------------

case_relink_trap() {
    local base m wt
    base="$(new_pool_env)"; m="$base/IBL5/ibl5"; wt="$base/IBL5-worktrees/delta/ibl5"
    wtnew "$base" delta >/dev/null
    pool_sh "$base" 'wt_link_shared "$1" "$MAIN_IBL5"' "$wt" >/dev/null
    if [ -e "$m/vendor/vendor" ] || [ -L "$m/vendor/vendor" ] \
        || [ -e "$m/node_modules/node_modules" ] || [ -L "$m/node_modules/node_modules" ]; then
        failcase "relink: main gained a nested vendor/node_modules link"
    else
        pass "relink: main has no nested vendor/node_modules link"
    fi
    assert_eq "relink: vendor still links to main" "$m/vendor" "$(readlink "$wt/vendor")"
    assert_eq "relink: node_modules still links to main" "$m/node_modules" "$(readlink "$wt/node_modules")"
}

case_css_fallback() {
    local base
    base="$(new_pool_env)"
    BUNX_FAIL=1 wtnew "$base" echo1 >/dev/null
    assert_eq "css fallback: main stylesheet copied" "main-css" \
        "$(cat "$base/IBL5-worktrees/echo1/ibl5/themes/IBL/style/style.css" 2>&1)"
}

# ---------------------------------------------------------------------------
# Pool primitives (rows 7-11)
# ---------------------------------------------------------------------------

case_next_index_skips_collisions() {
    local base m wp
    base="$(new_pool_env)"; m="$base/IBL5"; wp="$base/IBL5-worktrees"
    git_q -C "$m" worktree add -q "$wp/_pool-1" -b wt-pool/1 >/dev/null 2>&1
    git_q -C "$m" worktree move "$wp/_pool-1" "$wp/moved" >/dev/null 2>&1
    git_q -C "$m" branch wt-pool/2 >/dev/null 2>&1
    assert_eq "next index skips dir, branch and admin id" 3 \
        "$(pool_sh "$base" 'pool_next_index "$REPO_ROOT" "$WT_PARENT"')"
}

case_is_slot_rejects_nonslot() {
    local base m wp p
    base="$(new_pool_env)"; m="$base/IBL5"; wp="$base/IBL5-worktrees"
    git_q -C "$m" worktree add -q "$wp/alpha" -b alpha >/dev/null 2>&1
    git_q -C "$m" worktree add -q "$wp/_pool-9" -b feature >/dev/null 2>&1
    mkdir -p "$wp/_pool-8"
    git_q -C "$m" worktree add -q "$wp/_pool-1" -b wt-pool/1 >/dev/null 2>&1
    for p in "$m" "$wp/alpha" "$wp/_pool-9" "$wp/_pool-8"; do
        if pool_sh "$base" 'pool_is_slot "$WT_PARENT" "$1"' "$p" >/dev/null; then
            failcase "is_slot rejects $(basename "$p")"
        else
            pass "is_slot rejects $(basename "$p")"
        fi
    done
    if pool_sh "$base" 'pool_is_slot "$WT_PARENT" "$1"' "$wp/_pool-1" >/dev/null; then
        pass "is_slot accepts _pool-1 on wt-pool/1"
    else
        failcase "is_slot accepts _pool-1 on wt-pool/1"
    fi
}

case_lock_exclusive() {
    local base spid rc
    base="$(new_pool_env)"
    sleep 30 & spid=$!
    hold_lock "$base" "$spid" "$(date +%s)"
    pool_sh "$base" 'pool_lock_acquire "$REPO_ROOT"' >/dev/null; rc=$?
    kill "$spid" 2>/dev/null; wait "$spid" 2>/dev/null
    assert_eq "lock: second acquire is busy" 1 "$rc"
    assert_eq "lock: main tree stays clean" "" "$(git -C "$base/IBL5" status --porcelain)"
}

case_lock_stale_recovered() {
    local base dpid spid out
    base="$(new_pool_env)"
    true & dpid=$!; wait "$dpid"
    hold_lock "$base" "$dpid" "$(date +%s)"
    out="$(pool_sh "$base" 'pool_lock_acquire "$REPO_ROOT" && echo ACQUIRED')"
    assert_match "stale lock (dead pid): acquired" '^ACQUIRED$' "$out"
    assert_match "stale lock (dead pid): recovered" 'recovered stale lock' "$out"
    sleep 30 & spid=$!
    hold_lock "$base" "$spid" "$(( $(date +%s) - 601 ))"
    out="$(pool_sh "$base" 'pool_lock_acquire "$REPO_ROOT" && echo ACQUIRED')"
    kill "$spid" 2>/dev/null; wait "$spid" 2>/dev/null
    assert_match "stale lock (old epoch): acquired" '^ACQUIRED$' "$out"
    assert_match "stale lock (old epoch): recovered" 'recovered stale lock' "$out"
}

case_ready_marker_head_bound() {
    local base slot rc
    base="$(new_pool_env)"; slot="$base/IBL5-worktrees/_pool-1"
    git_q -C "$base/IBL5" worktree add -q "$slot" -b wt-pool/1 >/dev/null 2>&1
    pool_sh "$base" 'pool_mark_ready "$1" && pool_is_ready "$1"' "$slot" >/dev/null; rc=$?
    assert_eq "marker: ready after mark" 0 "$rc"
    git_q -C "$slot" commit -q --allow-empty -m moved >/dev/null 2>&1
    pool_sh "$base" 'pool_is_ready "$1"' "$slot" >/dev/null; rc=$?
    assert_eq "marker: not ready once HEAD moves" 1 "$rc"
}

# ---------------------------------------------------------------------------
# Refill (rows 12-16)
# ---------------------------------------------------------------------------

case_refill_builds_ready_slot() {
    local base slot out rc
    base="$(new_pool_env)"; slot="$base/IBL5-worktrees/_pool-1"
    out="$(CLAUDE_CODE_SESSION_ID=s wtnew "$base" --pool-refill)"; rc=$?
    assert_eq "refill: exit 0" 0 "$rc"
    [ "$rc" = 0 ] || printf '%s\n' "$out" | sed 's/^/    /'
    assert_eq "refill: _pool-1 on wt-pool/1" "wt-pool/1" "$(git -C "$slot" rev-parse --abbrev-ref HEAD 2>&1)"
    if slot_ready "$base" "$slot"; then pass "refill: slot ready"; else failcase "refill: slot ready"; fi
    assert_eq "refill: iblBase" "master" "$(git -C "$slot" config branch.wt-pool/1.iblBase 2>&1)"
    if [ -e "$(admin_dir "$slot")/wt-new-session" ]; then
        failcase "refill: no session file"
    else
        pass "refill: no session file"
    fi
    assert_eq "refill: clean status" "" "$(git -C "$slot" status --porcelain 2>&1)"
    assert_eq "refill: one bunx call" 1 "$(bunx_calls "$base")"
    assert_absent "refill: marker written after the CSS build" '^marker-present$' "$(cat "$base/bunx.calls")"
}

case_refill_reaps_half_built() {
    local base m wp out
    base="$(new_pool_env)"; m="$base/IBL5"; wp="$base/IBL5-worktrees"
    git_q -C "$m" worktree add -q "$wp/_pool-1" -b wt-pool/1 >/dev/null 2>&1
    git_q -C "$m" worktree add -q "$wp/_pool-9" -b feature >/dev/null 2>&1
    out="$(wtnew "$base" --pool-refill)"
    assert_match "reap: half-built slot reaped" 'reaped half-built slot' "$out"
    assert_match "reap: non-slot named" 'skipping non-slot .*_pool-9' "$out"
    assert_eq "reap: one ready slot" 1 "$(ready_count "$base")"
    if [ -d "$wp/_pool-9" ]; then pass "reap: _pool-9 kept"; else failcase "reap: _pool-9 kept"; fi
}

case_refill_full_and_busy() {
    local base base2 c out spid
    base="$(new_pool_env)"
    refill "$base"; c="$(bunx_calls "$base")"
    out="$(wtnew "$base" --pool-refill)"
    assert_match "refill: second run says pool full" 'pool full' "$out"
    assert_eq "refill: pool full builds nothing" "$c" "$(bunx_calls "$base")"
    base2="$(new_pool_env)"
    sleep 30 & spid=$!
    hold_lock "$base2" "$spid" "$(date +%s)"
    out="$(wtnew "$base2" --pool-refill)"
    kill "$spid" 2>/dev/null; wait "$spid" 2>/dev/null
    assert_match "refill: busy lock skips" 'lock busy' "$out"
    if no_pool_dirs "$base2"; then pass "refill: busy lock builds nothing"; else failcase "refill: busy lock builds nothing"; fi
}

case_refill_flag_rejected() {
    local base out rc a
    base="$(new_pool_env)"
    for a in "--pool-refill=x" "--pool-refil" "--pool-refill alpha"; do
        # shellcheck disable=SC2086
        out="$(wtnew "$base" $a)"; rc=$?
        assert_eq "flag '$a': exit 1" 1 "$rc"
        assert_match "flag '$a': error" 'Unknown option|takes no other arguments' "$out"
    done
    if no_pool_dirs "$base"; then pass "flag: nothing built"; else failcase "flag: nothing built"; fi
}

case_wt_pool_env() {
    local base out
    base="$(new_pool_env)"
    out="$(WT_POOL=0 wtnew "$base" --pool-refill)"
    assert_match "WT_POOL=0: disabled" 'disabled' "$out"
    if no_pool_dirs "$base"; then pass "WT_POOL=0: nothing built"; else failcase "WT_POOL=0: nothing built"; fi
    WT_POOL='' wtnew "$base" --pool-refill >/dev/null
    assert_eq "WT_POOL empty: slot built" 1 "$(ready_count "$base")"
}

# ---------------------------------------------------------------------------
# Claim (rows 17-20)
# ---------------------------------------------------------------------------

case_claim_postconditions() {
    local base c out
    base="$(new_pool_env)"
    refill "$base"; c="$(bunx_calls "$base")"
    out="$(CLAUDE_CODE_SESSION_ID=sess-claim wtnew "$base" golf)"
    assert_match "claim: claimed" 'Claimed warm slot _pool-1' "$out"
    wt_postconditions "$base" golf
    assert_eq "claim: session file" "sess-claim" \
        "$(cat "$(admin_dir "$base/IBL5-worktrees/golf")/wt-new-session" 2>&1)"
    if [ -e "$(admin_dir "$base/IBL5-worktrees/golf")/wt-pool-ready" ]; then
        failcase "claim: marker removed"
    else
        pass "claim: marker removed"
    fi
    assert_absent "claim: no _pool-* left registered" '/_pool-[0-9]+$' \
        "$(git -C "$base/IBL5" worktree list --porcelain)"
    assert_eq "claim: CSS reused" "$c" "$(bunx_calls "$base")"
}

# push_origin <base> <path> — commit <path> through a second clone and push it.
push_origin() {
    local pusher="$1/pusher"
    [ -d "$pusher" ] || git_q clone -q "$1/origin.git" "$pusher" >/dev/null 2>&1
    git_q -C "$pusher" pull -q origin master >/dev/null 2>&1
    mkdir -p "$(dirname "$pusher/$2")"
    echo "change $RANDOM" >> "$pusher/$2"
    git_q -C "$pusher" add -A >/dev/null 2>&1
    git_q -C "$pusher" commit -qm "touch $2" >/dev/null 2>&1
    git_q -C "$pusher" push -q origin master >/dev/null 2>&1
}

case_claim_css_rebuild_rule() {
    local base c out
    base="$(new_pool_env)"
    refill "$base"; c="$(bunx_calls "$base")"
    push_origin "$base" ibl5/index.php
    out="$(wtnew "$base" india)"
    assert_match "css rule: india claimed" 'Claimed warm slot' "$out"
    assert_eq "css rule: ibl5 change rebuilds" "$((c + 1))" "$(bunx_calls "$base")"
    assert_eq "css rule: india at origin/master" "$(git -C "$base/IBL5" rev-parse origin/master)" \
        "$(git -C "$base/IBL5-worktrees/india" rev-parse HEAD)"
    refill "$base"; c="$(bunx_calls "$base")"
    push_origin "$base" ibl5/tests/x
    out="$(wtnew "$base" juliet)"
    assert_match "css rule: juliet claimed" 'Claimed warm slot' "$out"
    assert_eq "css rule: tests-only change reuses" "$c" "$(bunx_calls "$base")"
}

case_claim_bypass_no_side_effect() {
    local base m slot out spid
    base="$(new_pool_env)"; m="$base/IBL5"; slot="$base/IBL5-worktrees/_pool-1"
    git_q -C "$m" branch feature-x >/dev/null 2>&1
    git_q -C "$m" push -q origin feature-x >/dev/null 2>&1
    refill "$base"

    out="$(wtnew "$base" k1 --base feature-x)"
    assert_match "bypass --base: printed" 'wt-pool: bypass' "$out"
    if slot_ready "$base" "$slot"; then pass "bypass --base: slot kept"; else failcase "bypass --base: slot kept"; fi

    out="$(WT_POOL=0 wtnew "$base" k2)"
    assert_match "bypass WT_POOL=0: printed" 'wt-pool: bypass' "$out"
    if slot_ready "$base" "$slot"; then pass "bypass WT_POOL=0: slot kept"; else failcase "bypass WT_POOL=0: slot kept"; fi

    out="$(wtnew "$base" --existing feature-x)"
    assert_match "bypass --existing: printed" 'wt-pool: bypass' "$out"
    if slot_ready "$base" "$slot"; then pass "bypass --existing: slot kept"; else failcase "bypass --existing: slot kept"; fi

    git_q -C "$m" branch hotel >/dev/null 2>&1
    out="$(wtnew "$base" hotel)"
    assert_match "bypass branch exists: printed" 'wt-pool: bypass' "$out"
    if slot_ready "$base" "$slot"; then pass "bypass branch exists: slot kept"; else failcase "bypass branch exists: slot kept"; fi

    sleep 30 & spid=$!
    hold_lock "$base" "$spid" "$(date +%s)"
    out="$(wtnew "$base" k3)"
    kill "$spid" 2>/dev/null; wait "$spid" 2>/dev/null
    rm -rf "$m/.git/wt-pool.lock"
    assert_match "bypass lock held: printed" 'wt-pool: bypass' "$out"
    if slot_ready "$base" "$slot"; then pass "bypass lock held: slot kept"; else failcase "bypass lock held: slot kept"; fi
}

case_claim_invalid_slot_falls_back() {
    local base slot out
    base="$(new_pool_env)"
    refill "$base"
    slot="$(pool_sh "$base" 'pool_find_ready "$REPO_ROOT" "$WT_PARENT"')"
    echo junk > "$slot/untracked.txt"
    out="$(wtnew "$base" kdirty)"
    assert_match "dirty slot: bypass" 'bypass \(slot dirty\)' "$out"
    if [ -d "$slot" ]; then failcase "dirty slot: removed"; else pass "dirty slot: removed"; fi
    wt_postconditions "$base" kdirty

    refill "$base"
    slot="$(pool_sh "$base" 'pool_find_ready "$REPO_ROOT" "$WT_PARENT"')"
    git_q -C "$slot" commit -q --allow-empty -m diverge >/dev/null 2>&1
    pool_sh "$base" 'pool_mark_ready "$1"' "$slot" >/dev/null
    out="$(wtnew "$base" kdiv)"
    assert_match "diverged slot: bypass" 'bypass \(slot diverged\)' "$out"
    if [ -d "$slot" ]; then failcase "diverged slot: removed"; else pass "diverged slot: removed"; fi
    wt_postconditions "$base" kdiv
}

# ---------------------------------------------------------------------------
# Refill kick (rows 21-23)
# ---------------------------------------------------------------------------

case_kick_inline_refills() {
    local base out
    base="$(new_pool_env)"
    WT_POOL_KICK=inline wtnew "$base" kilo >/dev/null
    assert_eq "kick inline: cold run leaves one ready slot" 1 "$(ready_count "$base")"
    out="$(WT_POOL_KICK=inline wtnew "$base" lima)"
    assert_match "kick inline: lima claimed" 'Claimed warm slot' "$out"
    if slot_ready "$base" "$base/IBL5-worktrees/_pool-2"; then
        pass "kick inline: claim leaves a ready _pool-2"
    else
        failcase "kick inline: claim leaves a ready _pool-2"
    fi
}

case_kick_env_values() {
    local base out rc spid
    base="$(new_pool_env)"
    WT_POOL_KICK=none wtnew "$base" n1 >/dev/null
    if no_pool_dirs "$base"; then pass "kick none: no slot"; else failcase "kick none: no slot"; fi

    out="$(WT_POOL_KICK=bogus wtnew "$base" n2)"; rc=$?
    assert_eq "kick bogus: exit 0" 0 "$rc"
    assert_match "kick bogus: named" 'unknown WT_POOL_KICK' "$out"
    if no_pool_dirs "$base"; then pass "kick bogus: no slot"; else failcase "kick bogus: no slot"; fi
    if [ -e "$base/launchctl.calls" ]; then failcase "kick bogus: no launchctl"; else pass "kick bogus: no launchctl"; fi

    out="$(WT_POOL_KICK='' wtnew "$base" n3)"
    if [ "$(uname -s)" = Darwin ]; then
        assert_match "kick empty: launchd bootstrap" "bootstrap gui/$(id -u)" "$(cat "$base/launchctl.calls" 2>&1)"
        if [ -f "$HOME/Library/LaunchAgents/com.ibl5.wt-pool-refill.plist" ]; then
            pass "kick empty: plist under sandbox HOME"
        else
            failcase "kick empty: plist under sandbox HOME"
        fi
        rm -f "$base/launchctl.calls"
        sleep 30 & spid=$!
        hold_lock "$base" "$spid" "$(date +%s)"
        out="$(WT_POOL_KICK='' wtnew "$base" n4)"
        kill "$spid" 2>/dev/null; wait "$spid" 2>/dev/null
        rm -rf "$base/IBL5/.git/wt-pool.lock"
        assert_match "kick empty, lock live: already running" 'refill already running' "$out"
        if [ -e "$base/launchctl.calls" ]; then
            failcase "kick empty, lock live: no launchctl"
        else
            pass "kick empty, lock live: no launchctl"
        fi
    else
        assert_match "kick empty: not scheduled off macOS" 'not scheduled on this platform' "$out"
    fi
}

case_plist_generated() {
    local base mike odd bun out
    base="$(new_pool_env)"; mike="$base/IBL5-worktrees/mike"
    wtnew "$base" mike >/dev/null
    out="$(cd "$mike" && PATH="$base/stub-bin:$PATH" WT_POOL_KICK=print "$mike/bin/wt-new" november 2>&1)"
    assert_match "plist: runner is the canonical root" \
        "exec '$base/IBL5/bin/wt-new' --pool-refill" "$out"
    # wt-new's own config notice prints a literal $dbname; check the plist text only.
    out="$(sed -n '/^<?xml/,/<\/plist>/p' <<< "$out")"
    assert_match "plist: emitted" '<key>Label</key><string>com.ibl5.wt-pool-refill</string>' "$out"
    assert_absent "plist: no unexpanded \$" '\$' "$out"
    assert_absent "plist: no empty string" '<string></string>' "$out"

    odd="$TMP/odd"; mkdir -p "$odd"
    cp "$base/stub-bin/bunx" "$odd/bunx"
    out="$(cd "$mike" && PATH="$odd:/usr/bin:/bin" \
        bash -c '. bin/lib/launchd-job.sh; . bin/lib/wt-pool.sh; pool_plist_print "$1"' _ "$base/IBL5" 2>&1)"
    assert_match "plist: odd bunx warned" 'bunx at .* is outside the job PATH' "$out"

    bun="$HOME/.bun/bin"; mkdir -p "$bun"
    cp "$base/stub-bin/bunx" "$bun/bunx"
    out="$(cd "$mike" && PATH="$bun:/usr/bin:/bin" \
        bash -c '. bin/lib/launchd-job.sh; . bin/lib/wt-pool.sh; pool_plist_print "$1"' _ "$base/IBL5" 2>&1)"
    assert_absent "plist: ~/.bun/bin bunx not warned" 'bunx at .* is outside the job PATH' "$out"
    rm -rf "$odd" "$bun"
}

# ---------------------------------------------------------------------------
# Consumers and the bare launchd env (rows 25-27)
# ---------------------------------------------------------------------------

case_consumer_wt_status() {
    local base out rc
    base="$(new_pool_env)"
    refill "$base"
    out="$(cd "$base/IBL5" && PATH="$base/stub-bin:$PATH" bin/wt-status 2>&1)"
    assert_match "wt-status: slot is EMPTY" 'EMPTY +_pool-1 ' "$out"
    out="$(cd "$base/IBL5" && PATH="$base/stub-bin:$PATH" bin/wt-status --stalled-only 2>&1)"; rc=$?
    assert_eq "wt-status --stalled-only: exit 0" 0 "$rc"
    assert_absent "wt-status --stalled-only: slot not named" '_pool-1' "$out"
}

case_consumer_slot_invariants() {
    local base m rc
    base="$(new_pool_env)"; m="$base/IBL5"
    refill "$base"
    assert_match "slot: registered" '/_pool-1$' "$(git -C "$m" worktree list --porcelain)"
    assert_eq "slot: zero own commits" 0 "$(git -C "$m" rev-list --count master..wt-pool/1)"
    git -C "$m" rev-parse --abbrev-ref 'wt-pool/1@{upstream}' >/dev/null 2>&1; rc=$?
    if [ "$rc" != 0 ]; then pass "slot: no upstream"; else failcase "slot: no upstream"; fi
}

case_refill_empty_env() {
    local base out rc
    base="$(new_pool_env)"
    out="$(cd "$base/IBL5" && env -i PATH="$base/stub-bin:/usr/bin:/bin" HOME="$HOME" \
        GIT_CONFIG_NOSYSTEM=1 GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t \
        GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t \
        WT_POOL_KICK=none "$base/IBL5/bin/wt-new" --pool-refill 2>&1)"; rc=$?
    assert_eq "empty env refill: exit 0" 0 "$rc"
    [ "$rc" = 0 ] || printf '%s\n' "$out" | sed 's/^/    /'
    assert_eq "empty env refill: one ready slot" 1 "$(ready_count "$base")"
}

# ---------------------------------------------------------------------------
# Help (row 29)
# ---------------------------------------------------------------------------

case_help_mentions_pool() {
    local out rc
    out="$("$WTNEW" --help 2>&1)"; rc=$?
    assert_eq "help: exit 0" 0 "$rc"
    assert_match "help: --pool-refill" '--pool-refill' "$out"
    assert_match "help: WT_POOL=0" 'WT_POOL=0' "$out"
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

ALL_CASES="cold_postconditions cold_session_absent relink_trap css_fallback
next_index_skips_collisions is_slot_rejects_nonslot lock_exclusive
lock_stale_recovered ready_marker_head_bound refill_builds_ready_slot
refill_reaps_half_built refill_full_and_busy refill_flag_rejected wt_pool_env
claim_postconditions claim_css_rebuild_rule claim_bypass_no_side_effect
claim_invalid_slot_falls_back kick_inline_refills kick_env_values
plist_generated consumer_wt_status consumer_slot_invariants refill_empty_env
help_mentions_pool"

if [ $# -eq 0 ]; then
    # shellcheck disable=SC2086
    set -- $ALL_CASES
fi
for c in "$@"; do
    if ! declare -F "case_$c" >/dev/null; then
        echo "unknown case: $c" >&2
        exit 2
    fi
done
for c in "$@"; do
    echo "== $c"
    "case_$c"
done

exit "$FAILED"
