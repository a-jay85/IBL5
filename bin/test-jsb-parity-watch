    h_eq "queued and idle: kick time is now + 120 s" "schedule 2026-11-23 10:35" "$(slurp "$S/log/automouse-run.argv" | tr -d '\r')"
    h_eq "queued and idle: no DM" 0 "$(cnt discord-dm)"
}

case_queued_running_waits() {
    sandbox queued_running
    : > "$(AM)/queue/010-jsb-port-pl-0001.md"
