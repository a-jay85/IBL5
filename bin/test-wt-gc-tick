# P4 — _gc_resolve_bin: PATH wins over WT_GC_BIN_DIRS; absent prints nothing.
if should_run P4-resolve-bin; then
begin_case P4-resolve-bin
mkdir -p "$CD/a" "$CD/b" "$CD/none"
printf '#!/bin/sh\n' > "$CD/a/tool"; cp "$CD/a/tool" "$CD/b/tool"; chmod +x "$CD/a/tool" "$CD/b/tool"
P4_OUT="$(
    # shellcheck source=bin/lib/wt-gc-reap.sh disable=SC1091
    source "$SCRIPT_DIR/lib/wt-gc-reap.sh"
    printf '1=%s\n' "$(PATH="$CD/none" WT_GC_BIN_DIRS="$CD/b" _gc_resolve_bin tool)"
    printf '2=%s\n' "$(PATH="$CD/a" WT_GC_BIN_DIRS="$CD/b" _gc_resolve_bin tool)"
    printf '3=%s\n' "$(PATH="$CD/none" WT_GC_BIN_DIRS="$CD/none" _gc_resolve_bin tool)"
    printf '4=%s\n' "$(PATH="$CD/none" WT_GC_BIN_DIRS='' _gc_resolve_bin tool)"
)"
[ "$P4_OUT" = "$(printf '1=%s\n2=%s\n3=\n4=' "$CD/b/tool" "$CD/a/tool")" ] || note_err "resolver output: $P4_OUT"
finish_case
fi

