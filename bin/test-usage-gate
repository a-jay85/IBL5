# A runner copy in a temp dir (a test harness) must not park a marker in the real
# state dir. With IBL5_USAGE_GATE_STATE_DIR set, the same resume bin is accepted.
test_marker_temp_bin_needs_own_state_dir() {
    new_env
    local h d rc tbin="$T/automouse/run"
    mkdir -p "$T/automouse"; printf '#!/bin/sh\n' > "$tbin"; chmod +x "$tbin"
    h=$(mktemp -d "$TMPROOT/home.XXXXXX")
    d="$h/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/usage-gate"
    env -u IBL5_USAGE_GATE_STATE_DIR HOME="$h" bash -c ". '$REPO_ROOT/bin/lib/usage-gate.sh'; usage_marker_write $SID_A automouse '$tbin' usage-pause drain 95 seven_day 1790625600"; rc=$?
    assert_eq temp_bin:default-dir-rejected 1 "$rc"
    assert_no_file temp_bin:default-dir-no-marker "$d/markers/$SID_A.json"
    assert_contains temp_bin:log "$(cat "$d/usage-gate.log")" "marker-rejected reason=temp-resume-bin"
    env -u IBL5_USAGE_GATE_STATE_DIR HOME="$h" bash -c ". '$REPO_ROOT/bin/lib/usage-gate.sh'; usage_marker_write $SID_B automouse /bin/sh usage-pause drain 95 seven_day 1790625600"; rc=$?
    assert_eq temp_bin:default-dir-real-bin-ok 0 "$rc"
    assert_file temp_bin:default-dir-real-bin-marker "$d/markers/$SID_B.json"
    gate_run "usage_marker_write $SID_A automouse '$tbin' usage-pause drain 95 seven_day 1790625600"; rc=$?
    assert_eq temp_bin:own-dir-ok 0 "$rc"
    assert_file temp_bin:own-dir-marker "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
}

# ---------------------------------------------------------------- Phase 4

# coord_setup <pct>: env with a fresh cache at <pct>, failing curl stub, a DM stub
# that records each call, and a resume script that touches $T/launched.<sid>.
coord_setup() {
    new_env
    make_stub_bin "$STUB" "" '{}' 1
    seed_cache "$(date +%s)" "$(usage_json "$1" 0)"
    RBIN="$T/resume.sh"
    printf '#!/bin/sh\ntouch "%s/launched.$2"\n' "$T" > "$RBIN"; chmod +x "$RBIN"
    DM="$T/dm"
    printf '#!/bin/sh\necho call >> "%s/dm.calls"\ncat >> "%s/dm.txt"\n' "$T" "$T" > "$DM"; chmod +x "$DM"
}

run_coord() {
    PATH="$STUB:$ORIG_PATH" DISCORD_DM="$DM" NOTIFY=1 "$REPO_ROOT/bin/usage-gate-coordinator" "$@"
}

# coord_marker <sid> <runner> [reason]
coord_marker() {
    gate_run "usage_marker_write $1 $2 '$RBIN' ${3:-usage-pause} drain 95 five_hour 1790625600"
}

# patch_marker <sid> <jq-filter>
patch_marker() {
    local f="$IBL5_USAGE_GATE_STATE_DIR/markers/$1.json"
    jq "$2" "$f" > "$f.x" && mv "$f.x" "$f"
}

# wait_file <path>: the resume launch is detached, so poll up to ~5 s.
wait_file() {
    local i=0
    while [ ! -e "$1" ] && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
    [ -e "$1" ]
}

dm_calls() { if [ -f "$T/dm.calls" ]; then wc -l < "$T/dm.calls" | tr -d ' '; else echo 0; fi; }

test_coord_rejects_bad_args() {
    coord_setup 50
    local rc
    run_coord >/dev/null 2>"$T/err"; rc=$?
    assert_eq coord_args:none 2 "$rc"
    assert_contains coord_args:none-usage "$(cat "$T/err")" "Usage"
    run_coord --dry-run >/dev/null 2>&1; rc=$?
    assert_eq coord_args:dry-alone 2 "$rc"
    run_coord --bogus >/dev/null 2>&1; rc=$?
    assert_eq coord_args:bogus 2 "$rc"
}

test_coord_idle_no_fetch() {
    coord_setup 50
    rm -f "$IBL5_USAGE_GATE_STATE_DIR/cache.json"
    make_stub_bin "$STUB" tok "$BODY_B"
    run_coord --once >/dev/null 2>&1
    assert_eq coord_idle:rc-and-no-calls 0 "$(curl_calls "$STUB")"
}

test_coord_normal_resumes_all() {
    coord_setup 50
    coord_marker $SID_A plan-now; coord_marker $SID_B automouse; coord_marker $SID_C post-plan-now
    run_coord --once >/dev/null 2>&1
    local s
    for s in $SID_A $SID_B $SID_C; do
        wait_file "$T/launched.$s"
        assert_file "coord_normal:launched.$s" "$T/launched.$s"
        assert_eq "coord_normal:count.$s" 1 "$(jq -r .resume_count "$IBL5_USAGE_GATE_STATE_DIR/markers/$s.json")"
    done
    assert_no_file coord_normal:token-cleared "$IBL5_USAGE_GATE_STATE_DIR/drain-token.d"
    assert_eq coord_normal:one-dm 1 "$(dm_calls)"
}

test_coord_dry_run_mutates_nothing() {
    coord_setup 50
    coord_marker $SID_A plan-now; coord_marker $SID_B automouse; coord_marker $SID_C post-plan-now
    local out
    out=$(run_coord --once --dry-run 2>&1)
    assert_contains coord_dry:zone-line "$(printf '%s\n' "$out" | head -1)" "ZONE normal"
    assert_eq coord_dry:three-resumes 3 "$(printf '%s\n' "$out" | grep -c '^ACTION resume')"
    assert_eq coord_dry:one-dm 1 "$(printf '%s\n' "$out" | grep -c '^ACTION dm')"
    sleep 0.3
    assert_eq coord_dry:no-launch 0 "$(find "$T" -maxdepth 1 -name 'launched.*' | wc -l | tr -d ' ')"
    assert_eq coord_dry:count-0 0 "$(jq -r .resume_count "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json")"
    assert_no_file coord_dry:no-dm "$T/dm.calls"
    assert_no_file coord_dry:no-dm-seen "$IBL5_USAGE_GATE_STATE_DIR/dm-seen"
}

test_coord_drain_grants_by_priority() {
    coord_setup 95
    coord_marker $SID_A plan-now; coord_marker $SID_B post-plan-now
    patch_marker $SID_A '.paused_at = 1'; patch_marker $SID_B '.paused_at = 9'
    run_coord --once >/dev/null 2>&1
    wait_file "$T/launched.$SID_B"
    assert_file coord_drain:post-plan-launched "$T/launched.$SID_B"
    assert_no_file coord_drain:plan-now-waits "$T/launched.$SID_A"
    assert_eq coord_drain:holder "$SID_B" "$(gate_run usage_token_holder)"
    local pid
    pid=$(awk '{print $2}' "$IBL5_USAGE_GATE_STATE_DIR/drain-token.d/holder")
    case "$pid" in ''|*[!0-9]*) fail coord_drain:holder-pid "got [$pid]" ;; *) pass coord_drain:holder-pid ;; esac
}

test_coord_drain_holder_alive_noop() {
