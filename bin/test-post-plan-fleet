# --- case: bin/check-digest-prose voice linter -------------------------------------------
begin_case
CDP="$SCRIPT_DIR/check-digest-prose"
[[ -x "$CDP" ]] || fail "check-digest-prose missing or not executable"

# (a) Must-FAIL fixtures — both verbatim samples from the voice contract.
# Assert the NAMED rule, not just "some output" — ensures a deleted rule makes the test fail.
printf '%s\n' "**What changed:** The automated post-plan pipeline now hands its own already-computed 'final checks passed' result across to the follow-up session that decides whether a PR can merge unattended, instead of leaving that session to look for a result nobody wrote." > "$SCRATCH/wc-bad.txt"
out=$("$CDP" "$SCRATCH/wc-bad.txt")
grep -qF 'SENTENCE_TOO_LONG'   <<<"$out" || fail "cdp: What-changed sample not flagged SENTENCE_TOO_LONG"
grep -qF 'DEFINE_BY_NEGATION'  <<<"$out" || fail "cdp: What-changed sample not flagged DEFINE_BY_NEGATION"

printf '%s\n' "**Watch:** The joined write-then-read path cannot execute on this branch because the launcher pins the main-checkout copy of the tooling, so the first real-world confirmation is the next automated run after this lands — and the fail-closed direction (no result written means still blocked) is the property to re-confirm there." > "$SCRATCH/watch-bad.txt"
out=$("$CDP" "$SCRATCH/watch-bad.txt")
grep -qF 'SENTENCE_TOO_LONG'   <<<"$out" || fail "cdp: Watch sample not flagged SENTENCE_TOO_LONG"
grep -qF 'PASSIVE_NOMINALIZED' <<<"$out" || fail "cdp: Watch sample not flagged PASSIVE_NOMINALIZED"
# NOTE: the Watch sample has exactly ONE em-dash, so MULTIPLE_EMDASH correctly does NOT fire.
# Test the two-em-dash rule separately:
printf '%s\n' "**Watch:** Phase 6.5 holds the PR — the result file is absent — and the next run writes it." > "$SCRATCH/emdash-bad.txt"
"$CDP" "$SCRATCH/emdash-bad.txt" | grep -qF 'MULTIPLE_EMDASH' || fail "cdp: two-em-dash line not flagged MULTIPLE_EMDASH"

# (b) Must-PASS fixtures — assert EMPTY output (exit 0 is unconditional so proves nothing here).
printf '%s\n' "**What changed:** /post-plan now writes its final-checks result to the file Phase 6.5 reads. Phase 6.5 previously found no result there and held the PR." > "$SCRATCH/wc-good.txt"
[[ -z "$("$CDP" "$SCRATCH/wc-good.txt")" ]] || fail "cdp: What-changed rewrite flagged (false positive)"

# Watch rewrite contains bare "cannot" — guard on rule 5's narrow shape: widening
# PASSIVE_NOMINALIZED to catch any "cannot" turns this green fixture red.
printf '%s\n' "**Watch:** Phase 6.5 cannot confirm the write-then-read path on this branch. The next automated run confirms it. Re-check the fail-closed direction there." > "$SCRATCH/watch-good.txt"
[[ -z "$("$CDP" "$SCRATCH/watch-good.txt")" ]] || fail "cdp: Watch rewrite flagged (false positive)"

# (c) Must-PASS false-positive fixtures — one per tokenizing exclusion.
# fp-backtick: the 21-token span keeps the sentence at 5 words with the strip;
# removing the strip pushes the count to 26 (SENTENCE_TOO_LONG) — turns this fixture red.
printf '%s\n' "**Touches:** Run \`bin/digest-dm-build one two three four five six seven eight nine ten eleven twelve thirteen fourteen fifteen sixteen seventeen eighteen nineteen twenty\` to build the DM." > "$SCRATCH/fp-backtick.txt"
[[ -z "$("$CDP" "$SCRATCH/fp-backtick.txt")" ]] || fail "cdp: backtick path with period flagged"

# fp-version: period in version number v2.12.2 is not a boundary.
printf '%s\n' "**What changed:** The runner now pins v2.12.2. The old pin drifted." > "$SCRATCH/fp-version.txt"
[[ -z "$("$CDP" "$SCRATCH/fp-version.txt")" ]] || fail "cdp: version number v2.12.2 flagged"

# fp-abbrev: e.g. abbreviation period is not a boundary.
printf '%s\n' "**Why:** Use a codebase name, e.g. Phase 6.5, not a relative clause. That keeps the line short." > "$SCRATCH/fp-abbrev.txt"
[[ -z "$("$CDP" "$SCRATCH/fp-abbrev.txt")" ]] || fail "cdp: e.g. abbreviation flagged"

# (d) Exit-0 proof and stdin seam.
"$CDP" "$SCRATCH/wc-bad.txt" >/dev/null 2>&1; rc=$?
[[ $rc -eq 0 ]] || fail "cdp: exited $rc on a violating file — must always exit 0"
"$CDP" < "$SCRATCH/wc-bad.txt" | grep -qF 'SENTENCE_TOO_LONG' || fail "cdp: stdin seam did not flag the violating sample"
"$CDP" < "$SCRATCH/wc-bad.txt" >/dev/null 2>&1; rc=$?
[[ $rc -eq 0 ]] || fail "cdp: exited $rc on violating stdin — must always exit 0"
: | "$CDP" >/dev/null 2>&1; rc=$?
[[ $rc -eq 0 ]] || fail "cdp: exited $rc on empty stdin"
[[ -z "$(: | "$CDP")" ]] || fail "cdp: emitted output on empty stdin"
"$CDP" "$SCRATCH/does-not-exist.txt" >/dev/null 2>&1; rc=$?
[[ $rc -eq 0 ]] || fail "cdp: exited $rc on a missing file path — must always exit 0"
end_case "check-digest-prose voice linter"

