# (its own line), which per CommonMark does not close a 4-backtick opener. Under
# the old width-blind toggle that 3-backtick line would have closed the fence and
# the CF section would have parsed clean — this fixture is a genuine regression
# test for width-awareness.
assert_viol "cf-unbalanced-fence-rejected" 1 '[F]' "$FM$CF_MATRIX"'
