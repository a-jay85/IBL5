#!/usr/bin/env bash
# test-pr-ready-skip — unit tests for .claude/skills/pr-ready/scripts/skip-review.sh.
#
# Usage: bin/test-pr-ready-skip
#   Run all skip-predicate unit cases.
#   Each case: exits 0, line-1 starts CURRENT-TREE:, last line = expected verdict.
#
# Driven entirely through a scratch git repo and a gh shim — no real PR is touched.
# Runs identically on macOS and Linux CI.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SKIP_SCRIPT="$SCRIPT_DIR/../.claude/skills/pr-ready/scripts/skip-review.sh"
test -s "$SKIP_SCRIPT" || { echo "FAIL: skip-review.sh not found at $SKIP_SCRIPT"; exit 1; }
test -x "$SKIP_SCRIPT" || { echo "FAIL: skip-review.sh not executable"; exit 1; }

SCRATCH="$(mktemp -d)"
# /tmp pr-ready files are PR-9999-keyed; clean them alongside SCRATCH.
_cleanup() {
    rm -rf "$SCRATCH"
    rm -f "/tmp/pr-ready-digest-lines-9999.txt" "/tmp/pr-ready-prior-verdict-9999.md" \
          "/tmp/post-plan-delta-diff-9999"
}
trap _cleanup EXIT

FAILED=0
CASE_BASE=0
fail() { echo "FAIL: $*" >&2; FAILED=$((FAILED + 1)); }
begin_case() { CASE_BASE=$FAILED; }
end_case() {
    if [[ $FAILED -eq $CASE_BASE ]]; then echo "$1 OK"; else echo "$1 FAILED" >&2; fi
}

want() {
    local label="$1" haystack="$2" token="$3"
    printf '%s\n' "$haystack" | grep -qF "$token" || fail "$label: expected '$token' not found in: $haystack"
}

# --- scratch git repo --------------------------------------------------------------------
GIT_REPO="$SCRATCH/repo"
git init -b pr-branch "$GIT_REPO" >/dev/null 2>&1
git -C "$GIT_REPO" config user.email "test@example.com"
git -C "$GIT_REPO" config user.name "Test"
echo "test" > "$GIT_REPO/test.txt"
git -C "$GIT_REPO" add test.txt
git -C "$GIT_REPO" commit -m "init" >/dev/null 2>&1
TREE="$(git -C "$GIT_REPO" rev-parse 'HEAD^{tree}')"

# --- gh shim -----------------------------------------------------------------------------
mkdir -p "$SCRATCH/.local/bin"
cat > "$SCRATCH/.local/bin/gh" << 'SHIM_EOF'
#!/usr/bin/env bash
# Shim: dispatch by subcommand.
# gh api graphql ...        -> serve GH_FIXTURE_GRAPHQL (pre-jq-filtered content)
# gh api repos/... ...      -> serve GH_FIXTURE_COMMIT  (pre-jq-filtered content)
# gh pr view ...            -> serve GH_FIXTURE
if [ "${1:-}" = "api" ]; then
    if [ "${2:-}" = "graphql" ]; then
        [ -n "${GH_FIXTURE_GRAPHQL:-}" ] && { cat "$GH_FIXTURE_GRAPHQL"; exit 0; }
        exit 1
    else
        [ -n "${GH_FIXTURE_COMMIT:-}" ] && { cat "$GH_FIXTURE_COMMIT"; exit 0; }
        exit 1
    fi
fi
[ -n "${GH_FIXTURE:-}" ] && { cat "$GH_FIXTURE"; exit 0; }
exit 1
SHIM_EOF
chmod +x "$SCRATCH/.local/bin/gh"
export PATH="$SCRATCH/.local/bin:$PATH"

# --- delta scratch repo (cases 12-20, carry-forward-preserved, delta-too-large) ------
# Three commits: base (= origin/master), +src.php, +notes.md.
DELTA_REPO="$SCRATCH/delta-repo"
git init -b pr-branch "$DELTA_REPO" >/dev/null 2>&1
git -C "$DELTA_REPO" config user.email "test@example.com"
git -C "$DELTA_REPO" config user.name "Test"
printf 'base\n' > "$DELTA_REPO/base.txt"
git -C "$DELTA_REPO" add base.txt
git -C "$DELTA_REPO" commit -m "base" >/dev/null 2>&1
D_MASTER_SHA="$(git -C "$DELTA_REPO" rev-parse HEAD)"
D_BASE_TREE="$(git -C "$DELTA_REPO" rev-parse 'HEAD^{tree}')"
# Pin origin/master tracking ref to the base commit so git diff origin/master...HEAD works.
git -C "$DELTA_REPO" update-ref refs/remotes/origin/master "$D_MASTER_SHA"
printf '<?php\n' > "$DELTA_REPO/src.php"
git -C "$DELTA_REPO" add src.php
git -C "$DELTA_REPO" commit -m "add src.php" >/dev/null 2>&1
D_MID_TREE="$(git -C "$DELTA_REPO" rev-parse 'HEAD^{tree}')"
printf '# readme\n' > "$DELTA_REPO/notes.md"
git -C "$DELTA_REPO" add notes.md
git -C "$DELTA_REPO" commit -m "add notes.md" >/dev/null 2>&1
D_HEAD_TREE="$(git -C "$DELTA_REPO" rev-parse 'HEAD^{tree}')"

# --- Rung-2 setup: bare origin with a historical commit delta-repo has never seen ---
DELTA_ORIGIN="$SCRATCH/delta-origin.git"
git init --bare "$DELTA_ORIGIN" >/dev/null 2>&1
git -C "$DELTA_ORIGIN" config uploadpack.allowAnySHA1InWant true
git -C "$DELTA_ORIGIN" config uploadpack.allowReachableSHA1InWant true
# Build historical commit in a temp repo; push to bare origin.
DELTA_TEMP="$SCRATCH/delta-temp"
git init "$DELTA_TEMP" >/dev/null 2>&1
git -C "$DELTA_TEMP" config user.email "test@example.com"
git -C "$DELTA_TEMP" config user.name "Test"
printf 'old\n' > "$DELTA_TEMP/old.txt"
git -C "$DELTA_TEMP" add old.txt
git -C "$DELTA_TEMP" commit -m "old" >/dev/null 2>&1
RUNG2_COMMIT="$(git -C "$DELTA_TEMP" rev-parse HEAD)"
RUNG2_TREE="$(git -C "$DELTA_TEMP" rev-parse 'HEAD^{tree}')"
git -C "$DELTA_TEMP" push "file://$DELTA_ORIGIN" HEAD:refs/heads/history >/dev/null 2>&1
# Wire delta-repo's origin to the bare repo; push pr-branch so fetch can succeed.
git -C "$DELTA_REPO" remote add origin "file://$DELTA_ORIGIN"
git -C "$DELTA_REPO" push origin pr-branch >/dev/null 2>&1

# Helper: write a minimal gh-pr-view fixture for delta-repo (headRefName=pr-branch).
# The body's first line must be exactly "**Reviewed tree:** <40hex>".
_mk_delta_fixture() {
    local recorded_tree="$1" out_file="$2"
    local body_json
    body_json="$(printf '**Reviewed tree:** %s\n<!-- pr-ready-verdict -->' "$recorded_tree" \
        | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))')"
    printf '{"comments": [{"body": %s}], "headRefName": "pr-branch"}\n' "$body_json" > "$out_file"
}

# --- case 1: no-verdict-comment ----------------------------------------------------------
# Step-0 stale-state clear: pre-seeded /tmp files must be removed even on this bail path.
begin_case
fixture1="$SCRATCH/fix1.json"
printf '{"comments": [], "headRefName": "pr-branch"}\n' > "$fixture1"
# Pre-create sentinel files that step 0 should clear.
echo "stale-digest" > "/tmp/pr-ready-digest-lines-9999.txt"
echo "stale-verdict" > "/tmp/pr-ready-prior-verdict-9999.md"
OUT1="$(cd "$GIT_REPO" && GH_FIXTURE="$fixture1" bash "$SKIP_SCRIPT" 9999 "")"
STATUS1=$?
FIRST1="$(printf '%s\n' "$OUT1" | head -1)"
LAST1="$(printf '%s\n' "$OUT1" | tail -1)"
[ "$STATUS1" -eq 0 ] || fail "case 1: exit status was $STATUS1, want 0"
printf '%s' "$FIRST1" | grep -q '^CURRENT-TREE: ' || fail "case 1: line 1 not CURRENT-TREE:, got: $FIRST1"
want "no-verdict-comment verdict" "$LAST1" "no-verdict-comment"
[ ! -f "/tmp/pr-ready-digest-lines-9999.txt" ] || fail "case 1: digest file not cleared by step-0"
[ ! -f "/tmp/pr-ready-prior-verdict-9999.md" ] || fail "case 1: prior-verdict file not cleared by step-0"
end_case no-verdict-comment

# --- case 2: comment-no-tree-line --------------------------------------------------------
begin_case
fixture2="$SCRATCH/fix2.json"
cat > "$fixture2" << 'JSON'
{"comments": [{"body": "<!-- pr-ready-verdict -->\nSome body without tree line\n### Merge digest\n**What changed:** x\n**Why:** y\n**Watch:** z\n**Touches:** a\n**Machine-authored fixes:** b"}], "headRefName": "pr-branch"}
JSON
OUT2="$(cd "$GIT_REPO" && GH_FIXTURE="$fixture2" bash "$SKIP_SCRIPT" 9999 "")"
STATUS2=$?
FIRST2="$(printf '%s\n' "$OUT2" | head -1)"
LAST2="$(printf '%s\n' "$OUT2" | tail -1)"
[ "$STATUS2" -eq 0 ] || fail "case 2: exit status was $STATUS2, want 0"
printf '%s' "$FIRST2" | grep -q '^CURRENT-TREE: ' || fail "case 2: line 1 not CURRENT-TREE:, got: $FIRST2"
want "no-tree-line verdict" "$LAST2" "RUN-REVIEW no-tree-line"
end_case comment-no-tree-line

# --- case 3: tree-equal-no-conflicts (SKIP path) -----------------------------------------
# A well-formed sticky comment with matching tree must produce SKIP-REVIEW.
# Also verifies carry-forward files are written.
begin_case
fixture3="$SCRATCH/fix3.json"
# Build body with TREE substituted, then JSON-encode as a single-line string.
BODY3="$(printf '%s\n' \
    "**Reviewed tree:** $TREE" \
    "### Merge digest" \
    "**What changed:** desc" \
    "**Why:** reason" \
    "**Watch:** nothing" \
    "**Touches:** test.txt" \
    "**Machine-authored fixes:** none" \
    "### Verdict" \
    "READY" \
    "<!-- pr-ready-verdict -->")"
# Encode newlines as \n for JSON string value.
BODY3_JSON="$(printf '%s' "$BODY3" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))')"
printf '{"comments": [{"body": %s}], "headRefName": "pr-branch"}\n' "$BODY3_JSON" > "$fixture3"
OUT3="$(cd "$GIT_REPO" && GH_FIXTURE="$fixture3" bash "$SKIP_SCRIPT" 9999 "")"
STATUS3=$?
FIRST3="$(printf '%s\n' "$OUT3" | head -1)"
LAST3="$(printf '%s\n' "$OUT3" | tail -1)"
[ "$STATUS3" -eq 0 ] || fail "case 3: exit status was $STATUS3, want 0"
printf '%s' "$FIRST3" | grep -q '^CURRENT-TREE: ' || fail "case 3: line 1 not CURRENT-TREE:, got: $FIRST3"
want "SKIP-REVIEW verdict" "$LAST3" "SKIP-REVIEW"
want "SKIP-REVIEW contains tree sha" "$LAST3" "$TREE"
# Carry-forward files must exist after SKIP.
[ -f "/tmp/pr-ready-digest-lines-9999.txt" ] || fail "case 3: digest-lines file not written"
DLINE_COUNT="$(wc -l < /tmp/pr-ready-digest-lines-9999.txt | tr -d ' ')"
[ "$DLINE_COUNT" -eq 5 ] || fail "case 3: digest-lines file has $DLINE_COUNT lines, want 5"
[ -s "/tmp/pr-ready-prior-verdict-9999.md" ] || fail "case 3: prior-verdict file missing or empty"
end_case tree-equal-no-conflicts

# --- case 4: tree-differs ----------------------------------------------------------------
# A comment with a mismatched tree must produce RUN-REVIEW tree-changed (not wrong-worktree).
begin_case
fixture4="$SCRATCH/fix4.json"
WRONG_TREE="ffffffffffffffffffffffffffffffffffffffff"
BODY4="$(printf '%s\n' \
    "**Reviewed tree:** $WRONG_TREE" \
    "### Merge digest" \
    "**What changed:** desc" \
    "**Why:** reason" \
    "**Watch:** nothing" \
    "**Touches:** test.txt" \
    "**Machine-authored fixes:** none" \
    "### Verdict" \
    "READY" \
    "<!-- pr-ready-verdict -->")"
BODY4_JSON="$(printf '%s' "$BODY4" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))')"
printf '{"comments": [{"body": %s}], "headRefName": "pr-branch"}\n' "$BODY4_JSON" > "$fixture4"
OUT4="$(cd "$GIT_REPO" && GH_FIXTURE="$fixture4" bash "$SKIP_SCRIPT" 9999 "")"
STATUS4=$?
FIRST4="$(printf '%s\n' "$OUT4" | head -1)"
LAST4="$(printf '%s\n' "$OUT4" | tail -1)"
[ "$STATUS4" -eq 0 ] || fail "case 4: exit status was $STATUS4, want 0"
printf '%s' "$FIRST4" | grep -q '^CURRENT-TREE: ' || fail "case 4: line 1 not CURRENT-TREE:, got: $FIRST4"
want "tree-changed verdict" "$LAST4" "RUN-REVIEW tree-changed"
# Negative pairing: must NOT be wrong-worktree (proves guard order is correct).
printf '%s\n' "$LAST4" | grep -qF "RUN-REVIEW wrong-worktree" && fail "case 4: got wrong-worktree, expected tree-changed"
end_case tree-differs

# --- case 5: tree-equal-with-conflicts ---------------------------------------------------
# Same body as case 3, but conflicts flag non-empty → RUN-REVIEW conflicts-resolved.
begin_case
# Clear any carry-forward from previous cases before running.
rm -f "/tmp/pr-ready-digest-lines-9999.txt" "/tmp/pr-ready-prior-verdict-9999.md"
OUT5="$(cd "$GIT_REPO" && GH_FIXTURE="$fixture3" bash "$SKIP_SCRIPT" 9999 "conflicts")"
STATUS5=$?
FIRST5="$(printf '%s\n' "$OUT5" | head -1)"
LAST5="$(printf '%s\n' "$OUT5" | tail -1)"
[ "$STATUS5" -eq 0 ] || fail "case 5: exit status was $STATUS5, want 0"
printf '%s' "$FIRST5" | grep -q '^CURRENT-TREE: ' || fail "case 5: line 1 not CURRENT-TREE:, got: $FIRST5"
want "conflicts-resolved verdict" "$LAST5" "RUN-REVIEW conflicts-resolved"
# Step 0 clears carry-forward even on conflicts path.
[ ! -f "/tmp/pr-ready-digest-lines-9999.txt" ] || fail "case 5: digest file not cleared by step-0"
[ ! -f "/tmp/pr-ready-prior-verdict-9999.md" ] || fail "case 5: prior-verdict file not cleared by step-0"
end_case tree-equal-with-conflicts

# --- case 6: multiple-sticky-comments ----------------------------------------------------
begin_case
fixture6="$SCRATCH/fix6.json"
cat > "$fixture6" << JSON
{"comments": [{"body": "**Reviewed tree:** $TREE\n<!-- pr-ready-verdict -->"},{"body": "**Reviewed tree:** $TREE\n<!-- pr-ready-verdict -->"}], "headRefName": "pr-branch"}
JSON
OUT6="$(cd "$GIT_REPO" && GH_FIXTURE="$fixture6" bash "$SKIP_SCRIPT" 9999 "")"
STATUS6=$?
FIRST6="$(printf '%s\n' "$OUT6" | head -1)"
LAST6="$(printf '%s\n' "$OUT6" | tail -1)"
[ "$STATUS6" -eq 0 ] || fail "case 6: exit status was $STATUS6, want 0"
printf '%s' "$FIRST6" | grep -q '^CURRENT-TREE: ' || fail "case 6: line 1 not CURRENT-TREE:, got: $FIRST6"
want "multiple-sticky-comments verdict" "$LAST6" "RUN-REVIEW multiple-sticky-comments"
end_case multiple-sticky-comments

# --- case 7: missing-args ----------------------------------------------------------------
# Called with 0 args and with 1 arg must both return RUN-REVIEW missing-args, exit 0.
begin_case
OUT7a="$(cd "$GIT_REPO" && bash "$SKIP_SCRIPT")"
STATUS7a=$?
LAST7a="$(printf '%s\n' "$OUT7a" | tail -1)"
[ "$STATUS7a" -eq 0 ] || fail "case 7a: exit status was $STATUS7a, want 0"
want "0-arg missing-args verdict" "$LAST7a" "RUN-REVIEW missing-args"
OUT7b="$(cd "$GIT_REPO" && bash "$SKIP_SCRIPT" 9999)"
STATUS7b=$?
LAST7b="$(printf '%s\n' "$OUT7b" | tail -1)"
[ "$STATUS7b" -eq 0 ] || fail "case 7b: exit status was $STATUS7b, want 0"
want "1-arg missing-args verdict" "$LAST7b" "RUN-REVIEW missing-args"
end_case missing-args

# --- case 8: wrong-worktree --------------------------------------------------------------
# headRefName in the PR differs from the local branch → RUN-REVIEW wrong-worktree.
begin_case
fixture8="$SCRATCH/fix8.json"
cat > "$fixture8" << JSON
{"comments": [{"body": "**Reviewed tree:** $TREE\n<!-- pr-ready-verdict -->"}], "headRefName": "different-branch"}
JSON
OUT8="$(cd "$GIT_REPO" && GH_FIXTURE="$fixture8" bash "$SKIP_SCRIPT" 9999 "")"
STATUS8=$?
FIRST8="$(printf '%s\n' "$OUT8" | head -1)"
LAST8="$(printf '%s\n' "$OUT8" | tail -1)"
[ "$STATUS8" -eq 0 ] || fail "case 8: exit status was $STATUS8, want 0"
printf '%s' "$FIRST8" | grep -q '^CURRENT-TREE: ' || fail "case 8: line 1 not CURRENT-TREE:, got: $FIRST8"
want "wrong-worktree verdict" "$LAST8" "RUN-REVIEW wrong-worktree"
end_case wrong-worktree

# --- case 9: malformed-tree-value --------------------------------------------------------
# Short hex, uppercase, or the literal 'unavailable' all produce RUN-REVIEW no-tree-line.
begin_case
for BAD_TREE in "abc123" "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" "unavailable"; do
    fixture9="$SCRATCH/fix9-${BAD_TREE:0:10}.json"
    BAD_BODY9="$(printf '%s\n' \
        "**Reviewed tree:** $BAD_TREE" \
        "<!-- pr-ready-verdict -->")"
    BAD_BODY9_JSON="$(printf '%s' "$BAD_BODY9" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))')"
    printf '{"comments": [{"body": %s}], "headRefName": "pr-branch"}\n' "$BAD_BODY9_JSON" > "$fixture9"
    OUT9="$(cd "$GIT_REPO" && GH_FIXTURE="$fixture9" bash "$SKIP_SCRIPT" 9999 "")"
    LAST9="$(printf '%s\n' "$OUT9" | tail -1)"
    printf '%s\n' "$LAST9" | grep -qF "SKIP-REVIEW" \
        && fail "case 9 ($BAD_TREE): malformed tree produced SKIP-REVIEW"
    want "malformed-tree no-tree-line ($BAD_TREE)" "$LAST9" "RUN-REVIEW no-tree-line"
done
end_case malformed-tree-value

# --- case 10: prior-digest-unparseable ---------------------------------------------------
# Matching tree but digest block absent or wrong label count → RUN-REVIEW prior-digest-unparseable.
begin_case
BODY10a="$(printf '%s\n' \
    "**Reviewed tree:** $TREE" \
    "Some prose without a digest block." \
    "READY" \
    "<!-- pr-ready-verdict -->")"
BODY10a_JSON="$(printf '%s' "$BODY10a" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))')"
fixture10a="$SCRATCH/fix10a.json"
printf '{"comments": [{"body": %s}], "headRefName": "pr-branch"}\n' "$BODY10a_JSON" > "$fixture10a"
OUT10a="$(cd "$GIT_REPO" && GH_FIXTURE="$fixture10a" bash "$SKIP_SCRIPT" 9999 "")"
LAST10a="$(printf '%s\n' "$OUT10a" | tail -1)"
want "no-digest-block" "$LAST10a" "RUN-REVIEW prior-digest-unparseable"

BODY10b="$(printf '%s\n' \
    "**Reviewed tree:** $TREE" \
    "### Merge digest" \
    "**What changed:** desc" \
    "**Why:** reason" \
    "**Watch:** nothing" \
    "**Touches:** test.txt" \
    "READY" \
    "<!-- pr-ready-verdict -->")"
BODY10b_JSON="$(printf '%s' "$BODY10b" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))')"
fixture10b="$SCRATCH/fix10b.json"
printf '{"comments": [{"body": %s}], "headRefName": "pr-branch"}\n' "$BODY10b_JSON" > "$fixture10b"
OUT10b="$(cd "$GIT_REPO" && GH_FIXTURE="$fixture10b" bash "$SKIP_SCRIPT" 9999 "")"
LAST10b="$(printf '%s\n' "$OUT10b" | tail -1)"
want "wrong-label-count" "$LAST10b" "RUN-REVIEW prior-digest-unparseable"
end_case prior-digest-unparseable

# --- case 11: carry-forward-files-on-run -------------------------------------------------
# On RUN-REVIEW paths, no carry-forward file is left behind.
begin_case
echo "stale-digest" > "/tmp/pr-ready-digest-lines-9999.txt"
echo "stale-verdict" > "/tmp/pr-ready-prior-verdict-9999.md"
OUT11="$(cd "$GIT_REPO" && GH_FIXTURE="$fixture4" bash "$SKIP_SCRIPT" 9999 "")"
LAST11="$(printf '%s\n' "$OUT11" | tail -1)"
want "carry-forward-clear-on-run verdict" "$LAST11" "RUN-REVIEW"
[ ! -f "/tmp/pr-ready-digest-lines-9999.txt" ] \
    || fail "case 11: digest file not cleared on RUN-REVIEW path"
[ ! -f "/tmp/pr-ready-prior-verdict-9999.md" ] \
    || fail "case 11: prior-verdict file not cleared on RUN-REVIEW path"
end_case carry-forward-files-on-run

# --- case 12: delta resolves via Rung 1 --------------------------------------------------
# RECORDED_TREE = D_BASE_TREE (exists locally) → Rung 1 succeeds → DELTA-STATUS: delta.
begin_case
fix12="$SCRATCH/fix12.json"
_mk_delta_fixture "$D_BASE_TREE" "$fix12"
OUT12="$(cd "$DELTA_REPO" && GH_FIXTURE="$fix12" bash "$SKIP_SCRIPT" --delta 9999 "")"
want "case 12 DELTA-STATUS delta" "$OUT12" "DELTA-STATUS: delta"
want "case 12 DELTA_HAS_PHP true" "$OUT12" "DELTA_HAS_PHP=true"
end_case "case 12 rung1-delta-resolves"

# --- case 13: base-object-missing --------------------------------------------------------
# RECORDED_TREE doesn't exist locally; graphql returns empty timeline → base-object-missing.
begin_case
fix13="$SCRATCH/fix13.json"
FAKE_TREE="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
_mk_delta_fixture "$FAKE_TREE" "$fix13"
fix13_gql="$SCRATCH/fix13-gql.txt"
printf '' > "$fix13_gql"
OUT13="$(cd "$DELTA_REPO" && GH_FIXTURE="$fix13" GH_FIXTURE_GRAPHQL="$fix13_gql" bash "$SKIP_SCRIPT" --delta 9999 "")"
want "case 13 DELTA-STATUS full" "$OUT13" "DELTA-STATUS: full"
want "case 13 DELTA-REASON base-object-missing" "$OUT13" "DELTA-REASON: base-object-missing"
end_case "case 13 base-object-missing"

# --- case 14: Rung 2 recovers via graphql ------------------------------------------------
# RECORDED_TREE not in delta-repo; graphql returns RUNG2_COMMIT; commit API maps to
# RUNG2_TREE; git fetch brings the object in → DELTA-STATUS: delta.
begin_case
fix14="$SCRATCH/fix14.json"
_mk_delta_fixture "$RUNG2_TREE" "$fix14"
fix14_gql="$SCRATCH/fix14-gql.txt"
printf '%s\n' "$RUNG2_COMMIT" > "$fix14_gql"
fix14_commit="$SCRATCH/fix14-commit.txt"
printf '%s\n' "$RUNG2_TREE" > "$fix14_commit"
OUT14="$(cd "$DELTA_REPO" && \
    GH_FIXTURE="$fix14" GH_FIXTURE_GRAPHQL="$fix14_gql" GH_FIXTURE_COMMIT="$fix14_commit" \
    bash "$SKIP_SCRIPT" --delta 9999 "")"
want "case 14 DELTA-STATUS delta" "$OUT14" "DELTA-STATUS: delta"
end_case "case 14 rung2-graphql-recovery"

# --- case 15: conflicts flag → DELTA-STATUS: full even when tree matches ----------------
begin_case
fix15="$SCRATCH/fix15.json"
_mk_delta_fixture "$D_BASE_TREE" "$fix15"
OUT15="$(cd "$DELTA_REPO" && GH_FIXTURE="$fix15" bash "$SKIP_SCRIPT" --delta 9999 "conflicts")"
want "case 15 DELTA-STATUS full" "$OUT15" "DELTA-STATUS: full"
want "case 15 DELTA-REASON conflicts-resolved" "$OUT15" "DELTA-REASON: conflicts-resolved"
end_case "case 15 conflicts-force-full"

# --- case 16: no verdict comment in delta mode → DELTA-STATUS: full ---------------------
begin_case
fix16="$SCRATCH/fix16.json"
printf '{"comments": [], "headRefName": "pr-branch"}\n' > "$fix16"
OUT16="$(cd "$DELTA_REPO" && GH_FIXTURE="$fix16" bash "$SKIP_SCRIPT" --delta 9999 "")"
want "case 16 DELTA-STATUS full" "$OUT16" "DELTA-STATUS: full"
want "case 16 DELTA-REASON no-verdict-comment" "$OUT16" "DELTA-REASON: no-verdict-comment"
end_case "case 16 no-verdict-comment-delta"

# --- case 17: post-rebase content-identical → DELTA-STATUS: delta, empty file set ------
# RECORDED_TREE = current HEAD's tree → diff vs HEAD is empty → DELTA_FILES = "".
begin_case
fix17="$SCRATCH/fix17.json"
_mk_delta_fixture "$D_HEAD_TREE" "$fix17"
OUT17="$(cd "$DELTA_REPO" && GH_FIXTURE="$fix17" bash "$SKIP_SCRIPT" --delta 9999 "")"
want "case 17 DELTA-STATUS delta" "$OUT17" "DELTA-STATUS: delta"
DELTA_FILE17="$(printf '%s\n' "$OUT17" | grep '^DELTA_FILE=' | cut -d= -f2)"
[ -f "$DELTA_FILE17" ] || fail "case 17: DELTA_FILE not written"
DELTA_SIZE17="$(wc -c < "$DELTA_FILE17" | tr -d ' ')"
[ "$DELTA_SIZE17" -eq 0 ] || fail "case 17: expected empty delta artifact, got $DELTA_SIZE17 bytes"
end_case "case 17 post-rebase-identical-empty-delta"

# --- case 18: DELTA_HAS_PHP=false when delta lacks PHP but full set has it -------------
# RECORDED_TREE = D_MID_TREE (after src.php commit); delta diff = notes.md only.
# Full PR diff = src.php + notes.md; intersection = notes.md → DELTA_HAS_PHP=false.
begin_case
fix18="$SCRATCH/fix18.json"
_mk_delta_fixture "$D_MID_TREE" "$fix18"
OUT18="$(cd "$DELTA_REPO" && GH_FIXTURE="$fix18" bash "$SKIP_SCRIPT" --delta 9999 "")"
want "case 18 DELTA-STATUS delta" "$OUT18" "DELTA-STATUS: delta"
want "case 18 DELTA_HAS_PHP false" "$OUT18" "DELTA_HAS_PHP=false"
end_case "case 18 DELTA_HAS_PHP-false"

# --- case 19: delta equals full set → DELTA_* match unprefixed computation --------------
# RECORDED_TREE = D_BASE_TREE: both tree diff and PR diff yield {src.php, notes.md}.
begin_case
fix19="$SCRATCH/fix19.json"
_mk_delta_fixture "$D_BASE_TREE" "$fix19"
OUT19="$(cd "$DELTA_REPO" && GH_FIXTURE="$fix19" bash "$SKIP_SCRIPT" --delta 9999 "")"
want "case 19 DELTA-STATUS delta" "$OUT19" "DELTA-STATUS: delta"
want "case 19 DELTA_HAS_PHP true" "$OUT19" "DELTA_HAS_PHP=true"
want "case 19 DELTA_NON_CODE_ONLY false" "$OUT19" "DELTA_NON_CODE_ONLY=false"
end_case "case 19 delta-equals-full-set"

# --- case 20: --deltaX → non-digit PR → bad-pr-number, no DELTA- lines ----------------
begin_case
OUT20="$(cd "$GIT_REPO" && bash "$SKIP_SCRIPT" --deltaX 9999 "")"
LINE_COUNT20="$(printf '%s\n' "$OUT20" | wc -l | tr -d ' ')"
[ "$LINE_COUNT20" -eq 2 ] || fail "case 20: expected 2 output lines, got $LINE_COUNT20"
want "case 20 RUN-REVIEW bad-pr-number" "$OUT20" "RUN-REVIEW bad-pr-number"
grep -qF "DELTA-" <<< "$OUT20" && fail "case 20: unexpected DELTA- line in output"
end_case "case 20 deltaX-bad-pr-number"

# --- carry-forward-preserved: delta mode skips Step-0, digest file survives -----------
begin_case
fix_cfp="$SCRATCH/fix-cfp.json"
_mk_delta_fixture "$D_BASE_TREE" "$fix_cfp"
printf 'existing-digest\n' > "/tmp/pr-ready-digest-lines-9999.txt"
_cfp_out="$(cd "$DELTA_REPO" && GH_FIXTURE="$fix_cfp" bash "$SKIP_SCRIPT" --delta 9999 "")"
[ -f "/tmp/pr-ready-digest-lines-9999.txt" ] \
    || fail "carry-forward-preserved: digest file was cleared in delta mode"
rm -f "/tmp/pr-ready-digest-lines-9999.txt" "/tmp/post-plan-delta-diff-9999"
end_case "carry-forward-preserved"

# --- delta-too-large: whole-file artifact > 102400 bytes falls back to full -----------
# Add big.php to delta-repo (RECORDED_TREE = D_HEAD_TREE → delta diff = big.php only).
begin_case
python3 -c 'import sys; sys.stdout.write(("xxxxxxxxxx\n") * 11000)' > "$DELTA_REPO/big.php"
git -C "$DELTA_REPO" add big.php
git -C "$DELTA_REPO" commit -m "add big.php" >/dev/null 2>&1
fix_dtl="$SCRATCH/fix-dtl.json"
_mk_delta_fixture "$D_HEAD_TREE" "$fix_dtl"
OUT_DTL="$(cd "$DELTA_REPO" && GH_FIXTURE="$fix_dtl" bash "$SKIP_SCRIPT" --delta 9999 "")"
want "delta-too-large DELTA-STATUS full" "$OUT_DTL" "DELTA-STATUS: full"
want "delta-too-large DELTA-REASON delta-too-large" "$OUT_DTL" "DELTA-REASON: delta-too-large"
end_case "delta-too-large"

# --- mutation check ----------------------------------------------------------------------
# Invert the tree comparison in step 10 and confirm case 4's fixture now produces SKIP-REVIEW.
# Skippable with --skip-mutation for environments where sed -i differs.
if [[ "${1:-}" != "--skip-mutation" ]]; then
    begin_case
    MUTANT="$SCRATCH/skip-review-mutant.sh"
    cp "$SKIP_SCRIPT" "$MUTANT"
    # Anchor on the exact step-10 line to avoid collateral damage.
    sed -i.bak 's/\[ "\$RECORDED_TREE" != "\$CUR" \]/[ "$RECORDED_TREE" = "$CUR" ]/' "$MUTANT"
    grep -qF '"$RECORDED_TREE" = "$CUR"' "$MUTANT" || fail "mutation: substitution did not apply — test has no teeth"
    OUT_MUT="$(cd "$GIT_REPO" && GH_FIXTURE="$fixture4" bash "$MUTANT" 9999 "")"
    LAST_MUT="$(printf '%s\n' "$OUT_MUT" | tail -1)"
    # Mutant with inverted comparison should pass through and produce SKIP-REVIEW for
    # a mismatched tree, proving the real guard actually catches tree changes.
    printf '%s\n' "$LAST_MUT" | grep -qF "SKIP-REVIEW" \
        || fail "mutation: mutant did not produce SKIP-REVIEW for mismatched tree — mutation check is inert"
    rm -f "$MUTANT" "$MUTANT.bak"
    end_case mutation-check
fi

# --- verdict -----------------------------------------------------------------------------
if [[ $FAILED -ne 0 ]]; then
    echo "test-pr-ready-skip: FAILED ($FAILED assertion failure(s))" >&2
    exit 1
fi
echo "test-pr-ready-skip: all cases passed"
