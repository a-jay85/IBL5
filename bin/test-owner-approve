#!/usr/bin/env bash
# Tests bin/owner-approve with a fixture repo and PATH shims for gh, launchctl,
# pgrep and lsof. No case touches GitHub, launchd, or the real repo, except that
# detach_survives_group_kill (run by name only, macOS) submits a stand-in sleep job to the real launchd.
#
# Usage: bin/test-owner-approve [case_name ...]
# With no arguments every case runs; with arguments only the named cases run.
# Prints `PASS <name>` / `FAIL <name>: <why>` per case. Exit 0 iff all pass.
# OA_SRC names another owner-approve to test. OA_CORPUS_DIR writes one file per case
# (exit code, last RESULT line, gh and launchctl calls) so two scripts can be diffed.
[ "${BASH_VERSINFO[0]:-0}" -ge 4 ] || { printf '%s: bash 4+ required (this is bash %s). Run: brew install bash\n' "${0##*/}" "${BASH_VERSION:-?}" >&2; exit 2; }
set -uo pipefail

# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

h_tmp TMP
mkdir -p "$TMP/shims" "$TMP/fx" "$TMP/wt"
export PATH="$TMP/shims:$PATH"
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@example.invalid
export GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.invalid
unset CLAUDE_HEADLESS T3CODE_THREAD_ID CLAUDE_CODE_SESSION_ID OA_DETACHED_CHILD LJOB_LOCK_DIR LAUNCHCTL_CMD

WHY=""      # failure reasons for the current case
OUT=""      # combined stdout+stderr of the last run
RC=0        # exit code of the last run
FX=""       # per-case fixture dir
WT=""       # per-case worktree
H=""        # per-case worktree HEAD
OA="$TMP/fix/bin/owner-approve"
PR=777

note() { WHY="${WHY:+$WHY; }$*"; }
want_rc() { [ "$RC" -eq "$1" ] || note "expected exit $1, got $RC"; }
want_out() { grep -qF -- "$1" <<< "$OUT" || note "output lacks '$1'"; }
refute_out() { if grep -qF -- "$1" <<< "$OUT"; then note "output unexpectedly has '$1'"; fi; }
want_gh() { grep -qF -- "$1" "$FX/gh.log" 2>/dev/null || note "gh.log lacks '$1'"; }
refute_gh() { if grep -qF -- "$1" "$FX/gh.log" 2>/dev/null; then note "gh.log unexpectedly has '$1'"; fi; }
want_posted() { cat "$FX"/posted.*.md 2>/dev/null | grep -qF -- "$1" || note "no posted comment has '$1'"; }
no_gh() { [ ! -e "$FX/gh.log" ] || note "gh ran but should not have"; }
want_order() { # <first> <second>: both in gh.log, first line number lower
    local a b
    a=$(grep -nF -- "$1" "$FX/gh.log" 2>/dev/null | head -n 1 | cut -d: -f1)
    b=$(grep -nF -- "$2" "$FX/gh.log" 2>/dev/null | tail -n 1 | cut -d: -f1)
    if [ -z "$a" ] || [ -z "$b" ]; then note "gh.log lacks '$1' or '$2'"; return 0; fi
    [ "$a" -lt "$b" ] || note "'$1' (line $a) is not before '$2' (line $b)"
}

# ---------------------------------------------------------------------------
# Shims. Every one reads its state from $FX.
# ---------------------------------------------------------------------------
cat > "$TMP/shims/gh" <<'SHIM'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$FX/gh.log"
case "${1:-} ${2:-}" in
    "pr view")
        [ -e "$FX/fail.pr-view" ] && exit 1
        left=0
        [ -f "$FX/pr.live.left" ] && left=$(cat "$FX/pr.live.left")
        if [ "$left" -gt 0 ]; then
            echo $((left - 1)) > "$FX/pr.live.left"
            cat "$FX/pr.live.json"
        else
            cat "$FX/pr.json"
        fi ;;
    "pr comment")
        f=""; prev=""
        for x in "$@"; do
            [ "$prev" = "--body-file" ] && f=$x
            prev=$x
        done
        [ -n "$f" ] || exit 1
        n=$(( $(ls "$FX"/posted.*.md 2>/dev/null | wc -l | tr -d ' ') + 1 ))
        cp "$f" "$FX/posted.$n.md"
        jq -nc --rawfile b "$f" --argjson id "$((4000 + n))" --arg t "$(printf '2026-11-23T10:00:%02dZ' "$n")" \
            '{id:$id,created_at:$t,author_association:"OWNER",user:{login:"owner",type:"User"},body:$b}' >> "$FX/comments.ndjson" ;;
    "pr edit") [ -e "$FX/fail.edit" ] && exit 1; exit 0 ;;
    "pr merge") [ -e "$FX/fail.merge" ] && exit 1; exit 0 ;;
    "api user") echo owner ;;
    "api --paginate")
        [ -e "$FX/fail.comments" ] && exit 1
        jq -s . "$FX/comments.ndjson" ;;
    api\ repos/*/pulls/*)
        # .base.ref reads $FX/base; any other --jq (the PR body) reads $FX/body.
        case " $* " in
            *" .base.ref "*) [ -f "$FX/base" ] && cat "$FX/base" ;;
            *) [ -f "$FX/body" ] && cat "$FX/body" ;;
        esac
        exit 0 ;;
    api\ repos/*) cat "$FX/tree" ;;
    *) exit 0 ;;
esac
SHIM
cat > "$TMP/shims/launchctl" <<'SHIM'
#!/usr/bin/env bash
printf '%q ' "$@" >> "$FX/launchctl.log"; printf '\n' >> "$FX/launchctl.log"
if [ -x "$FX/launchctl.hook" ]; then "$FX/launchctl.hook"; rm -f "$FX/launchctl.hook"; fi
printf 'PID\tStatus\tLabel\n'
left=0
[ -f "$FX/launchctl.left" ] && left=$(cat "$FX/launchctl.left")
if [ "$left" -gt 0 ] && [ -f "$FX/launchctl.out" ]; then
    echo $((left - 1)) > "$FX/launchctl.left"
    cat "$FX/launchctl.out"
fi
exit 0
SHIM
cat > "$TMP/shims/pgrep" <<'SHIM'
#!/usr/bin/env bash
left=0
[ -f "$FX/pgrep.left" ] && left=$(cat "$FX/pgrep.left")
[ "$left" -gt 0 ] || exit 1
out=""
case "${1:-}" in
    -f)
        # `pgrep -f -- <worktree>` matches pgrep.lf lines ("<pid> <command>");
        # a bare `pgrep -f <pattern>` returns the pids in pgrep.f.
        if [ "${2:-}" = "--" ]; then
            out=$(grep -F -- "${3:-}" "$FX/pgrep.lf" 2>/dev/null | cut -d' ' -f1)
        else
            out=$(cat "$FX/pgrep.f" 2>/dev/null)
        fi ;;
esac
[ -n "$out" ] || exit 1
echo $((left - 1)) > "$FX/pgrep.left"
printf '%s\n' "$out"
SHIM
cat > "$TMP/shims/lsof" <<'SHIM'
#!/usr/bin/env bash
case " $* " in
    *" -d cwd "*) cat "$FX/lsof.out" 2>/dev/null ;;
esac
exit 0
SHIM
# ps: `ps -o command= -p <pid>` for a pid in pgrep.lf prints that line's command.
# Every other call (the ppid walks in _oa_mine) goes to the real /bin/ps.
cat > "$TMP/shims/ps" <<'SHIM'
#!/usr/bin/env bash
if [ "${1:-}" = "-o" ] && [ "${2:-}" = "command=" ] && [ "${3:-}" = "-p" ] && [ -f "$FX/pgrep.lf" ]; then
    line=$(grep -E "^${4:-x} " "$FX/pgrep.lf" 2>/dev/null)
    if [ -n "$line" ]; then printf '%s\n' "${line#* }"; exit 0; fi
fi
exec /bin/ps "$@"
SHIM
chmod +x "$TMP/shims/gh" "$TMP/shims/launchctl" "$TMP/shims/pgrep" "$TMP/shims/lsof" "$TMP/shims/ps"

# ---------------------------------------------------------------------------
# Fixture repo: the script under test, bin/lib, and a prefire-verify stub.
# ---------------------------------------------------------------------------
git init -q "$TMP/fix"
git -C "$TMP/fix" symbolic-ref HEAD refs/heads/master
git -C "$TMP/fix" config commit.gpgsign false
mkdir -p "$TMP/fix/bin"
cp "${OA_SRC:-$REPO/bin/owner-approve}" "$TMP/fix/bin/owner-approve"
cp "$REPO/bin/pr-refire-after-job" "$TMP/fix/bin/pr-refire-after-job"
cp -R "$REPO/bin/lib" "$TMP/fix/bin/lib"
mkdir -p "$TMP/fix/tools/postplan-harness"
cp -R "$REPO/tools/postplan-harness/harness" "$TMP/fix/tools/postplan-harness/harness"
cat > "$TMP/fix/bin/lib/prefire-verify" <<'STUB'
#!/bin/sh
git rev-parse HEAD >> "$PF_LOG"
exit "${PF_RC:-0}"
STUB
# post-plan-now stub for the re-fire cases. It logs its args, then by REFIRE_MODE posts a
# new READY or NOT READY sticky (ready|notready) or leaves the comments alone (none).
cat > "$TMP/fix/bin/post-plan-now" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$FX/refire.log"
case "${REFIRE_MODE:-none}" in
    ready) word=READY ;;
    notready) word="NOT READY" ;;
    *) exit "${REFIRE_RC:-0}" ;;
esac
n=$(( $(wc -l < "$FX/comments.ndjson") + 1 ))
body="**$word** · 2026-11-19 · auto-merge held"$'\n'"**Reviewed tree:** $(cat "$FX/tree")"$'\n''<!-- pr-ready-verdict -->'
jq -nc --arg b "$body" --argjson id "$n" \
    '{id:$id,updated_at:"2026-11-19T12:00:00Z",user:{login:"owner"},body:$b}' >> "$FX/comments.ndjson"
exit "${REFIRE_RC:-0}"
STUB
cat > "$TMP/fix/bin/discord-dm" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$FX/dm.log"
STUB
chmod +x "$TMP/fix/bin/lib/prefire-verify" "$TMP/fix/bin/owner-approve" "$TMP/fix/bin/post-plan-now" \
    "$TMP/fix/bin/pr-refire-after-job" "$TMP/fix/bin/discord-dm"
git -C "$TMP/fix" add -A
git -C "$TMP/fix" commit -q -m base

# ---------------------------------------------------------------------------
# Per-case fixture
# ---------------------------------------------------------------------------
A40=$(printf '%040d' 0 | tr 0 a)
B40=$(printf '%040d' 0 | tr 0 b)
C40=$(printf '%040d' 0 | tr 0 c)

write_pr() { # <head> [state] [labels json]
    jq -nc --arg h "$1" --arg b "case/$CASE" --arg s "${2:-OPEN}" --argjson l "${3:-[]}" \
        '{state:$s,headRefOid:$h,headRefName:$b,labels:$l}' > "$FX/pr.json"
}
fresh() { # <case>
    CASE=$1
    FX="$TMP/fx/$CASE"
    mkdir -p "$FX"
    git -C "$TMP/fix" worktree add -q -b "case/$CASE" "$TMP/wt/$CASE" >/dev/null 2>&1
    WT=$(git -C "$TMP/fix" worktree list --porcelain | awk -v b="branch refs/heads/case/$CASE" '/^worktree /{w=substr($0,10)} $0==b {print w}')
    H=$(git -C "$WT" rev-parse HEAD)
    : > "$FX/comments.ndjson"
    printf '%s' "$A40" > "$FX/tree"
    write_pr "$H"
    export FX PF_LOG="$FX/pf.log" PF_RC=0
}
seed_sticky() { # <author> <banner word> [extra lines...]
    local author=$1 word=$2 body
    shift 2
    body="**$word** · 2026-11-12 · auto-merge held"$'\n'
    while [ $# -gt 0 ]; do body="$body$1"$'\n'; shift; done
    body="${body}Reviewer: opus"$'\n''<!-- pr-ready-verdict -->'
    jq -nc --arg u "$author" --arg b "$body" '{user:{login:$u},body:$b}' >> "$FX/comments.ndjson"
}
seed_ready() { seed_sticky owner READY "**Reviewed tree:** $(cat "$FX/tree")"; }
run_oa_env() { OUT=$(cd "$TMP/fix" && env "$@" 2>&1); RC=$?; }
run_oa() { run_oa_env "$OA" "$@"; }
new_commit() { # commits in the case worktree, points pr.json at it
    git -C "$WT" commit -q --allow-empty -m "fix $CASE"
    H=$(git -C "$WT" rev-parse HEAD)
    write_pr "$H"
}
live_flags() { echo "--poll=0 --timeout=30"; }

# ---------------------------------------------------------------------------
# Phase 1 cases
# ---------------------------------------------------------------------------
body_literal() {
    fresh body_literal
    local words='He said "go" for $HOME, ran `ls` and $(id)' want
    run_oa_env T3CODE_THREAD_ID=t3-1 CLAUDE_CODE_SESSION_ID=s-1 "$OA" "$PR" "$words"
    want="Owner approved $(date +%F): \"$words\". Head $H. Conversation: T3 thread t3-1, session s-1."
    [ "$(sed -n 1p "$FX/posted.1.md" 2>/dev/null)" = "$want" ] || note "line 1 is '$(sed -n 1p "$FX/posted.1.md" 2>/dev/null)'"
    want_gh "--body-file"
}
body_option() {
    fresh body_option
    run_oa "$PR" "ok" "--option=Ship it (card B)"
    grep -qF '"ok" (Ship it (card B)). Head' "$FX/posted.1.md" 2>/dev/null || note "option text not in the parentheses: $(sed -n 1p "$FX/posted.1.md" 2>/dev/null)"
}
ids_unset() {
    fresh ids_unset
    run_oa "$PR" "ok"
    grep -qF 'T3 thread unknown, session unknown.' "$FX/posted.1.md" 2>/dev/null || note "ids not unknown"
}
ids_empty() {
    fresh ids_empty
    run_oa_env T3CODE_THREAD_ID= CLAUDE_CODE_SESSION_ID= "$OA" "$PR" "ok"
    grep -qF 'T3 thread unknown, session unknown.' "$FX/posted.1.md" 2>/dev/null || note "empty ids not unknown"
}
headless_refuses() {
    fresh headless_refuses
    run_oa_env CLAUDE_HEADLESS=1 "$OA" "$PR" "ok"
    want_rc 3
    want_out "RESULT: headless"
    no_gh
}
headless_empty_proceeds() {
    fresh headless_empty_proceeds
    run_oa_env CLAUDE_HEADLESS= "$OA" "$PR" "ok"
    [ -f "$FX/posted.1.md" ] || note "no approval comment posted"
}
usage_unknown_flag() {
    fresh usage_unknown_flag
    run_oa "$PR" "ok" --bogus
    want_rc 2
    no_gh
}
usage_space_form() {
    fresh usage_space_form
    run_oa "$PR" --option "card B"
    want_rc 2
    want_out "--option needs =<value>"
    no_gh
}
# Fails when _oa_post writes $OA_ROOT/body.md instead of its mktemp -d file (row 36).
no_repo_writes() {
    fresh no_repo_writes
    seed_ready
    run_oa "$PR" "ok"
    want_rc 0
    [ -z "$(git -C "$TMP/fix" status --porcelain)" ] || note "fixture repo is dirty"
    [ -z "$(git -C "$WT" status --porcelain)" ] || note "case worktree is dirty"
}

# ---------------------------------------------------------------------------
# Phase 2 cases
# ---------------------------------------------------------------------------
live_ok() { # <signal text>
    seed_ready
    run_oa "$PR" "ok" --poll=0 --timeout=30
    want_rc 0
    want_out "waiting 0s: $1"
    want_gh "pr merge $PR -R a-jay85/IBL5 --squash --auto --match-head-commit $H"
}
live_launchd_now() {
    fresh live_launchd_now
    printf '4242\t0\tcom.ibl5.postplan-now-case-live_launchd_now-20261112-101010-4242\n' > "$FX/launchctl.out"
    echo 2 > "$FX/launchctl.left"
    live_ok "launchd label com.ibl5.postplan-now-case-live_launchd_now-20261112-101010-4242"
}
# Fails when _oa_live matches post-plan-fleet-X$OA_PR instead of post-plan-fleet-$OA_PR (row 12).
live_launchd_fleet() {
    fresh live_launchd_fleet
    printf -- '-\t0\tcom.ibl5.post-plan-fleet-%s\n' "$PR" > "$FX/launchctl.out"
    echo 2 > "$FX/launchctl.left"
    live_ok "launchd label com.ibl5.post-plan-fleet-$PR"
}
live_label() {
    fresh live_label
    jq -nc --arg h "$H" --arg b "case/$CASE" '{state:"OPEN",headRefOid:$h,headRefName:$b,labels:[{name:"post-plan-running"}]}' > "$FX/pr.live.json"
    echo 2 > "$FX/pr.live.left"
    live_ok "post-plan-running label"
}
live_pgrep_args() {
    fresh live_pgrep_args
    printf '555 bash bin/post-plan-now --auto %s\n' "$WT" > "$FX/pgrep.lf"
    echo 2 > "$FX/pgrep.left"
    live_ok "a post-plan process names $WT"
}
live_pgrep_cwd() {
    fresh live_pgrep_cwd
    echo 556 > "$FX/pgrep.f"
    printf 'p556\nn%s\n' "$WT" > "$FX/lsof.out"
    echo 2 > "$FX/pgrep.left"
    live_ok "post-plan process 556 runs in $WT"
}
# Fails when a crashed _oa_live reads as "no live run". The copy exits 1 (the old
# "none" status) before it checks anything, so the script must wait, time out, and not arm.
live_crash_fails_closed() {
    fresh live_crash_fails_closed
    sed 's/^_oa_live() {/_oa_live() { exit 1;/' "$OA" > "$TMP/fix/bin/owner-approve-crash"
    chmod +x "$TMP/fix/bin/owner-approve-crash"
    grep -qF '_oa_live() { exit 1;' "$TMP/fix/bin/owner-approve-crash" || note "crash seam did not apply"
    seed_ready
    run_oa_env "$TMP/fix/bin/owner-approve-crash" "$PR" "ok" --poll=0 --timeout=0
    want_rc 5
    want_out "liveness check crashed (exit 1)"
    refute_gh "pr edit"
    refute_gh "pr merge"
}
# Runs the pgrep cases under the running bash (bash 4+; /bin/bash 3.2 is refused by the version guard).
live_ok_bin_bash() { # <signal text>
    seed_ready
    run_oa_env "$BASH" "$OA" "$PR" "ok" --poll=0 --timeout=30
    want_rc 0
    want_out "waiting 0s: $1"
    want_gh "pr merge $PR -R a-jay85/IBL5 --squash --auto --match-head-commit $H"
}
live_pgrep_args_bin_bash() {
    [ -x /bin/bash ] || return 0
    fresh live_pgrep_args_bin_bash
    printf '555 bash bin/post-plan-now --auto %s\n' "$WT" > "$FX/pgrep.lf"
    echo 2 > "$FX/pgrep.left"
    live_ok_bin_bash "a post-plan process names $WT"
}
live_pgrep_cwd_bin_bash() {
    [ -x /bin/bash ] || return 0
    fresh live_pgrep_cwd_bin_bash
    echo 556 > "$FX/pgrep.f"
    printf 'p556\nn%s\n' "$WT" > "$FX/lsof.out"
    echo 2 > "$FX/pgrep.left"
    live_ok_bin_bash "post-plan process 556 runs in $WT"
}
live_near_miss() {
    fresh live_near_miss
    printf '77\t0\tcom.ibl5.postplan-now-case-live_near_miss-old-20261112-101010-77\n-\t0\tcom.ibl5.post-plan-fleet-7770\n' > "$FX/launchctl.out"
    echo 9 > "$FX/launchctl.left"
    seed_ready
    run_oa "$PR" "ok" --poll=0 --timeout=30
    want_rc 0
    refute_out "waiting"
}
live_timeout() {
    fresh live_timeout
    printf -- '-\t0\tcom.ibl5.post-plan-fleet-%s\n' "$PR" > "$FX/launchctl.out"
    echo 99 > "$FX/launchctl.left"
    seed_ready
    run_oa "$PR" "ok" --poll=0 --timeout=0
    want_rc 5
    want_out "RESULT: timeout"
    grep -qF 'still live after 0s' "$FX/posted.2.md" 2>/dev/null || note "posted.2.md lacks 'still live after 0s'"
    refute_gh "pr edit"
    refute_gh "pr merge"
}

# ---------------------------------------------------------------------------
# Phase 3 cases
# ---------------------------------------------------------------------------
verdict_ready_arms() {
    fresh verdict_ready_arms
    seed_ready
    run_oa "$PR" "ok"
    want_rc 0
    want_out "RESULT: armed"
    want_order "pr edit $PR -R a-jay85/IBL5 --add-label human-approved" "pr merge $PR -R a-jay85/IBL5 --squash --auto --match-head-commit $H"
    refute_gh "--admin"
}
verdict_notes_arms() {
    fresh verdict_notes_arms
    seed_sticky owner "READY WITH NOTES" "**Reviewed tree:** $A40"
    run_oa "$PR" "ok"
    want_rc 0
    want_out "RESULT: armed"
    want_gh "pr merge $PR"
}
verdict_stale_tree() {
    fresh verdict_stale_tree
    seed_sticky owner READY "**Reviewed tree:** $B40"
    run_oa "$PR" "ok"
    want_rc 4
    want_posted "covers tree bbbb"
    refute_gh "pr edit"
    refute_gh "pr merge"
}
verdict_none() {
    fresh verdict_none
    run_oa "$PR" "ok"
    want_rc 4
    want_posted "has no post-plan verdict comment"
}
verdict_not_ready() {
    fresh verdict_not_ready
    seed_sticky owner "NOT READY" "**Reviewed tree:** $A40"
    run_oa "$PR" "ok"
    want_rc 4
    want_posted "is NOT READY"
    refute_gh "pr merge"
}
verdict_unrecorded() {
    fresh verdict_unrecorded
    seed_sticky owner READY "**Reviewed tree:** unrecorded"
    run_oa "$PR" "ok"
    want_rc 4
    want_posted "names no reviewed tree"
}
verdict_no_tree_line() {
    fresh verdict_no_tree_line
    seed_sticky owner READY "no tree here"
    run_oa "$PR" "ok"
    want_rc 4
    want_posted "names no reviewed tree"
}
KEPT_HEAD='### Kept new scope (you asked for this)'
KEPT_PHRASE='the only blocking findings are new scope you asked for; each one is listed under Kept new scope'
KEPT_ITEM='- `Add the roster export` (you said: `add the export too`)'
seed_raw() { # <author> <body>: posts the body verbatim
    jq -nc --arg u "$1" --arg b "$2" '{user:{login:$u},body:$b}' >> "$FX/comments.ndjson"
}
kept_sticky() { # <banner word> <tree word> <last line before the marker> [middle lines...]
    local banner=$1 tw=$2 last=$3 body
    shift 3
    body="**$banner** (re-review, round 1) — 2026-11-24 12:00 UTC · auto-merge held"$'\n'
    while [ $# -gt 0 ]; do body="$body$1"$'\n'; shift; done
    body="$body**Reviewed tree:** $B40"$'\n'"**Re-reviewed tree:** $(cat "$FX/tree") ($tw)"$'\n'
    body="$body$last"$'\n''<!-- pr-ready-verdict -->'
    seed_raw owner "$body"
}
kept_refused() { # <case> <posted token> <kept_sticky args...>
    local c=$1 tok=$2
    shift 2
    fresh "$c"
    kept_sticky "$@"
    run_oa "$PR" "ok"
    want_rc 4
    want_posted "$tok"
}
kept_scope_accepts() { # (i)
    fresh kept_scope_accepts
    kept_sticky "READY WITH NOTES" "NOT READY" "READY WITH NOTES — $KEPT_PHRASE" \
        "" "$KEPT_HEAD" "$KEPT_ITEM" ""
    run_oa "$PR" "ok"
    want_rc 0
    want_out "RESULT: armed"
}
kept_scope_no_heading() { # (ii) terminal line, no heading
    kept_refused kept_scope_no_heading "not READY" "READY WITH NOTES" "NOT READY" \
        "READY WITH NOTES — $KEPT_PHRASE" "" "$KEPT_ITEM" ""
}
kept_scope_empty_section() { # (iii) heading with no item line under it
    kept_refused kept_scope_empty_section "not READY" "READY WITH NOTES" "NOT READY" \
        "READY WITH NOTES — $KEPT_PHRASE" "" "$KEPT_HEAD" "" "Some other line"
}
kept_scope_no_phrase() { # (iv) bare READY WITH NOTES banner, heading and items, no terminal line
    kept_refused kept_scope_no_phrase "not READY" "READY WITH NOTES" "NOT READY" \
        "Reviewer: opus" "" "$KEPT_HEAD" "$KEPT_ITEM" ""
}
kept_scope_spoof_fence() { # (v-a) heading only inside a fence and inside an item quote
    kept_refused kept_scope_spoof_fence "not READY" "READY WITH NOTES" "NOT READY" \
        "READY WITH NOTES — $KEPT_PHRASE" "" '```' "$KEPT_HEAD" "$KEPT_ITEM" '```' \
        '- `Note` (you said: `### Kept new scope (you asked for this)`)' ""
}
kept_scope_spoof_not_last() { # (v-b) phrase in an item quote and on a mid-body line, not last
    kept_refused kept_scope_spoof_not_last "not READY" "READY WITH NOTES" "NOT READY" \
        "Reviewer: opus" "" "$KEPT_HEAD" \
        '- `Note` (you said: `READY WITH NOTES — '"$KEPT_PHRASE"'`)' "" \
        "READY WITH NOTES — $KEPT_PHRASE" ""
}
kept_scope_unclosed_fence() { # (v-c) a fence opened before the terminal never closes
    kept_refused kept_scope_unclosed_fence "not READY" "READY WITH NOTES" "NOT READY" \
        "READY WITH NOTES — $KEPT_PHRASE" "" "$KEPT_HEAD" "$KEPT_ITEM" "" '```' "quoted text"
}
kept_scope_word_mismatch() { # (vi-a) banner READY WITH NOTES, terminal READY
    kept_refused kept_scope_word_mismatch "not READY" "READY WITH NOTES" "NOT READY" \
        "READY — $KEPT_PHRASE" "" "$KEPT_HEAD" "$KEPT_ITEM" ""
}
kept_scope_tree_word_near_miss() { # (vi-b) full fingerprint, tree word is not exactly NOT READY
    kept_refused kept_scope_tree_word_near_miss "NOT READY YET" "READY WITH NOTES" "NOT READY YET" \
        "READY WITH NOTES — $KEPT_PHRASE" "" "$KEPT_HEAD" "$KEPT_ITEM" ""
}
kept_scope_terminal_near_miss() { # (vi-c) terminal line carries trailing text
    kept_refused kept_scope_terminal_near_miss "not READY" "READY WITH NOTES" "NOT READY" \
        "READY WITH NOTES — $KEPT_PHRASE." "" "$KEPT_HEAD" "$KEPT_ITEM" ""
}
kept_scope_replay_4214() { # the live PR 4214 sticky's structural line order, generic text
    local body
    fresh kept_scope_replay_4214
    body=$(printf '%s\n' \
        "**READY WITH NOTES** (re-review, round 1) — 2026-11-24 14:07:17 PST · auto-merge held" \
        "" \
        "Auto-merge held:" \
        "- (7) The plan says a person must review and merge this PR." \
        "Any auto-merge already set on this PR is now turned off." \
        "" \
        "### Fixed in this PR" \
        "- [x] [unplanned-scope] A fixed finding." \
        "" \
        "### Still open (non-blocking)" \
        "- [ ] A note that does not block." \
        "" \
        "<details><summary>Reviewer verdict</summary>" \
        "" \
        "PR #4214 is still **NOT READY**. One blocker is left." \
        "" \
        "## FINDINGS" \
        "- [BLOCKING] [unplanned-scope] Add the roster export." \
        "- [NOTE] A note that does not block." \
        "" \
        "</details>" \
        "" \
        "$KEPT_HEAD" \
        "$KEPT_ITEM" \
        '- `Rename the export button` (you said: `call it Download`)' \
        "" \
        "### Merge digest" \
        "**What changed:** Generic summary text." \
        "" \
        "---" \
        "" \
        "<details><summary>Audit trail</summary>" \
        "" \
        "REVIEW-COVERAGE: NONE" \
        "**Reviewed tree:** $B40" \
        "**Reviewed diff:** $B40" \
        "**Hold code:** (7) plan-auto-merge-hold — plan declares auto_merge: false" \
        "**Re-reviewed tree:** $(cat "$FX/tree") (NOT READY)" \
        "**Remediation rounds:** 1. body-only → NOT READY" \
        "**Review 1:** NOT READY, 2 blocking, 1 notes" \
        "" \
        "</details>" \
        "" \
        "READY WITH NOTES — $KEPT_PHRASE" \
        "<!-- pr-ready-verdict -->")
    seed_raw owner "$body"
    run_oa "$PR" "ok"
    want_rc 0
    want_out "RESULT: armed"
}
