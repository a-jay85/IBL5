#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-wt-new-root — regression harness for bin/wt-new's repo-root resolution.
#
# Pins the defect: wt-new derived REPO_ROOT from its OWN script path, so invoking a
# worktree's copy (`bin/wt-new <slug>` typed from inside a worktree) pointed the
# ff-only master sync at that worktree's CHECKED-OUT branch instead of the main
# checkout's master. Harmless while local master was current, but once the worktree's
# branch had diverged — which every squash-merged branch does — the sync aborted with
# "Not possible to fast-forward" and no worktree was created at all.
#
# Both cases run against a throwaway origin/main/worktree trio built under mktemp, so
# nothing real is touched. The negative control re-points REPO_ROOT at the script path
# and asserts the failure DOES reappear — without it, the positive case could pass for
# reasons unrelated to the fix.
#
# Run: bin/test-wt-new-root  (exit 0 = all pass, 1 = a case failed)

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WTNEW="$SCRIPT_DIR/wt-new"
TMP="$(mktemp -d)"
trap 'chmod -R u+w "$TMP" 2>/dev/null; rm -rf "$TMP" 2>/dev/null' EXIT

FAILED=0
pass()     { echo "ok: $1"; }
failcase() { echo "FAIL: $1"; FAILED=1; }

# assert_absent <name> <regex> <haystack>
assert_absent() {
    if printf '%s' "$3" | grep -qE "$2"; then
        failcase "$1 — expected NOT to match: $2"
        printf '%s\n' "$3" | sed 's/^/    /'
    else
        pass "$1"
    fi
}

# assert_match <name> <regex> <haystack>
assert_match() {
    if printf '%s' "$3" | grep -qE "$2"; then
        pass "$1"
    else
        failcase "$1 — expected to match: $2"
        printf '%s\n' "$3" | sed 's/^/    /'
    fi
}

# assert_eq <name> <expected> <actual>
assert_eq() {
    if [ "$2" = "$3" ]; then pass "$1"; else failcase "$1 — expected '$2', got '$3'"; fi
}

git_q() { git -c user.email=t@t -c user.name=t -c init.defaultBranch=master "$@"; }

# new_env — build <TMP>/env.XXXX/{origin.git,IBL5,IBL5-worktrees/feature}:
#   • origin/master is ONE commit ahead of the main checkout's local master
#   • the worktree's branch has its own commit, so it has DIVERGED from origin/master
# Echoes the env base path. This is the exact shape the defect needed.
new_env() {
    local base
    base="$(mktemp -d "$TMP/env.XXXXXX")"
    git_q init -q --bare "$base/origin.git" >/dev/null 2>&1

    # Seed C1 with a copy of the real scripts under test.
    git_q clone -q "$base/origin.git" "$base/IBL5" >/dev/null 2>&1
    mkdir -p "$base/IBL5/bin/lib" "$base/IBL5/ibl5"
    cp "$WTNEW" "$base/IBL5/bin/wt-new"
    cp "$SCRIPT_DIR"/lib/*.sh "$base/IBL5/bin/lib/" 2>/dev/null
    chmod +x "$base/IBL5/bin/wt-new"
    git_q -C "$base/IBL5" add -A >/dev/null 2>&1
    git_q -C "$base/IBL5" commit -qm C1 >/dev/null 2>&1
    git_q -C "$base/IBL5" push -q -u origin master >/dev/null 2>&1

    # C2 lands on origin only — local master is now 1 behind, never fast-forwarded.
    git_q clone -q "$base/origin.git" "$base/pusher" >/dev/null 2>&1
    echo c2 > "$base/pusher/C2.txt"
    git_q -C "$base/pusher" add -A >/dev/null 2>&1
    git_q -C "$base/pusher" commit -qm C2 >/dev/null 2>&1
    git_q -C "$base/pusher" push -q origin master >/dev/null 2>&1
    git_q -C "$base/IBL5" fetch -q origin >/dev/null 2>&1

    # A worktree whose branch carries its own commit → diverged from origin/master.
    mkdir -p "$base/IBL5-worktrees"
    git_q -C "$base/IBL5" worktree add -q "$base/IBL5-worktrees/feature" -b feature master >/dev/null 2>&1
    echo f1 > "$base/IBL5-worktrees/feature/F1.txt"
    git_q -C "$base/IBL5-worktrees/feature" add -A >/dev/null 2>&1
    git_q -C "$base/IBL5-worktrees/feature" commit -qm F1 >/dev/null 2>&1

    printf '%s\n' "$base"
}

# new_env_base_branch — build <TMP>/env.XXXX/{origin.git,IBL5,IBL5-worktrees}:
#   • master in main checkout and on origin is at M2 (checked out, synced)
#   • feature-a exists locally at F1; origin/feature-a is at F2 (1 ahead)
#   • master and origin/feature-a have DIVERGED (M2 is not in feature-a history)
#     → merge --ff-only origin/feature-a from master would abort; fetch must be used
#   • IBL5-worktrees/ sibling dir exists (wt-new will create slug-b inside it)
# Echoes the env base path. Invoked from the main checkout, not a worktree.
new_env_base_branch() {
    local base
    base="$(mktemp -d "$TMP/env.XXXXXX")"
    git_q init -q --bare "$base/origin.git" >/dev/null 2>&1

    # M1: seed origin with scripts under test.
    git_q clone -q "$base/origin.git" "$base/IBL5" >/dev/null 2>&1
    mkdir -p "$base/IBL5/bin/lib" "$base/IBL5/ibl5"
    cp "$WTNEW" "$base/IBL5/bin/wt-new"
    cp "$SCRIPT_DIR"/lib/*.sh "$base/IBL5/bin/lib/" 2>/dev/null
    chmod +x "$base/IBL5/bin/wt-new"
    git_q -C "$base/IBL5" add -A >/dev/null 2>&1
    git_q -C "$base/IBL5" commit -qm M1 >/dev/null 2>&1
    git_q -C "$base/IBL5" push -q -u origin master >/dev/null 2>&1

    # feature-a: branch from M1, commit F1, push to origin (both local and remote at F1).
    git_q -C "$base/IBL5" checkout -qb feature-a >/dev/null 2>&1
    echo f1 > "$base/IBL5/F1.txt"
    git_q -C "$base/IBL5" add -A >/dev/null 2>&1
    git_q -C "$base/IBL5" commit -qm F1 >/dev/null 2>&1
    git_q -C "$base/IBL5" push -q -u origin feature-a >/dev/null 2>&1

    # M2 on master: diverges master from feature-a; push so origin/master is current too.
    git_q -C "$base/IBL5" checkout -q master >/dev/null 2>&1
    echo m2 > "$base/IBL5/M2.txt"
    git_q -C "$base/IBL5" add -A >/dev/null 2>&1
    git_q -C "$base/IBL5" commit -qm M2 >/dev/null 2>&1
    git_q -C "$base/IBL5" push -q origin master >/dev/null 2>&1

    # F2 on origin/feature-a only — local feature-a stays at F1 (1 behind).
    git_q clone -q "$base/origin.git" "$base/pusher-f" >/dev/null 2>&1
    git_q -C "$base/pusher-f" checkout -q feature-a >/dev/null 2>&1
    echo f2 > "$base/pusher-f/F2.txt"
    git_q -C "$base/pusher-f" add -A >/dev/null 2>&1
    git_q -C "$base/pusher-f" commit -qm F2 >/dev/null 2>&1
    git_q -C "$base/pusher-f" push -q origin feature-a >/dev/null 2>&1
    git_q -C "$base/IBL5" fetch -q origin >/dev/null 2>&1

    # Worktrees sibling dir must exist; wt-new will create the slug-b subdir.
    mkdir -p "$base/IBL5-worktrees"

    printf '%s\n' "$base"
}

sha() { git -C "$1" rev-parse "$2" 2>/dev/null; }

echo "== case 1: wt-new invoked through a DIVERGED worktree's own copy"
ENV1="$(new_env)"
ORIGIN_TIP="$(sha "$ENV1/IBL5" origin/master)"
FEATURE_TIP="$(sha "$ENV1/IBL5" feature)"

# wt-new fails later in temp (no real ibl5/ tree to materialize) — irrelevant here.
# The contract under test is the repo-root/sync behaviour, asserted on refs below.
OUT1="$("$ENV1/IBL5-worktrees/feature/bin/wt-new" smoke 2>&1)"

assert_absent "sync does not abort on the diverged branch" "Not possible to fast-forward" "$OUT1"
assert_eq "main checkout's master fast-forwarded to origin/master" \
    "$ORIGIN_TIP" "$(sha "$ENV1/IBL5" master)"
assert_eq "the worktree's own branch is left untouched" \
    "$FEATURE_TIP" "$(sha "$ENV1/IBL5" feature)"
if [ -d "$ENV1/IBL5-worktrees/smoke" ]; then
    pass "the requested worktree is actually created"
else
    failcase "the requested worktree is actually created — $ENV1/IBL5-worktrees/smoke missing"
fi

echo "== case 2: negative control — REPO_ROOT back on the script's own path"
ENV2="$(new_env)"
BEFORE_MASTER="$(sha "$ENV2/IBL5" master)"
# Reintroduce the defect in the worktree's copy only.
perl -0pi -e 's{^REPO_ROOT="\$\(resolve_canonical_root .*\)"$}{REPO_ROOT="\$SCRIPT_ROOT"}m' \
    "$ENV2/IBL5-worktrees/feature/bin/wt-new"
assert_match "control actually re-points REPO_ROOT" 'REPO_ROOT="\$SCRIPT_ROOT"' \
    "$(cat "$ENV2/IBL5-worktrees/feature/bin/wt-new")"

OUT2="$("$ENV2/IBL5-worktrees/feature/bin/wt-new" smoke 2>&1)"
assert_match "defect reappears: sync aborts on the diverged branch" \
    "Not possible to fast-forward|refusing to fetch" "$OUT2"
assert_eq "and master is left stale" "$BEFORE_MASTER" "$(sha "$ENV2/IBL5" master)"
if [ -d "$ENV2/IBL5-worktrees/smoke" ]; then
    failcase "and no worktree is created — $ENV2/IBL5-worktrees/smoke exists"
else
    pass "and no worktree is created"
fi

echo "== case 3: wt-new --base <non-checked-out-branch> from main checkout"
ENV3="$(new_env_base_branch)"
MASTER_TIP3="$(sha "$ENV3/IBL5" master)"
FEATURE_A_ORIGIN_TIP="$(sha "$ENV3/IBL5" origin/feature-a)"

# Invoke wt-new from the MAIN checkout, not a worktree — the fix under test.
# wt-new fails later materializing config / symlinks (no real ibl5 tree); irrelevant.
# Contract: feature-a fast-forwarded, master untouched, no ff-only abort.
OUT3="$("$ENV3/IBL5/bin/wt-new" slug-b --base feature-a 2>&1)"

assert_absent "no fast-forward abort on base branch" "Not possible to fast-forward" "$OUT3"
assert_eq "feature-a fast-forwarded to origin/feature-a" \
    "$FEATURE_A_ORIGIN_TIP" "$(sha "$ENV3/IBL5" feature-a)"
assert_eq "master is left at M2 (unchanged)" \
    "$MASTER_TIP3" "$(sha "$ENV3/IBL5" master)"

echo "== case 3b: unknown flag is rejected loudly"
# The --base flag parsing path is modified; assert the guard for unknown flags still fires.
# Reuse ENV3's IBL5 copy — no env state needed, just exit-code + message shape.
OUT3B="$("$ENV3/IBL5/bin/wt-new" slug-c --bogus-flag 2>&1)" && RC3B=$? || RC3B=$?
assert_match "unknown flag prints usage to stderr" "Unknown option" "$OUT3B"
if [ "$RC3B" -ne 0 ]; then pass "unknown flag exits non-zero"; else
    failcase "unknown flag exits non-zero — expected non-zero, got 0"; fi

echo "== case 4: --existing, no local ref — creates worktree with origin tip"
# new_env_base_branch has feature-a locally at F1 and origin/feature-a at F2.
# Delete the local ref so only origin/feature-a remains.
ENV4="$(new_env_base_branch)"
ORIGIN_FEATURE_A_TIP4="$(sha "$ENV4/IBL5" origin/feature-a)"
git_q -C "$ENV4/IBL5" branch -D feature-a >/dev/null 2>&1
OUT4="$("$ENV4/IBL5/bin/wt-new" --existing feature-a 2>&1)"
assert_match "case 4: output mentions origin/feature-a" "origin/feature-a" "$OUT4"
if [ -d "$ENV4/IBL5-worktrees/feature-a" ]; then
    pass "case 4: IBL5-worktrees/feature-a exists"
else
    failcase "case 4: IBL5-worktrees/feature-a missing"
fi
assert_eq "case 4: worktree HEAD is at origin tip" \
    "$ORIGIN_FEATURE_A_TIP4" "$(sha "$ENV4/IBL5-worktrees/feature-a" HEAD)"
# --track should set upstream
UPSTREAM4="$(git -C "$ENV4/IBL5-worktrees/feature-a" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)" && true
assert_eq "case 4: upstream is origin/feature-a" "origin/feature-a" "$UPSTREAM4"
IBLBASE4="$(git -C "$ENV4/IBL5-worktrees/feature-a" config "branch.feature-a.iblBase" 2>/dev/null)" && true
assert_eq "case 4: iblBase recorded as master" "master" "$IBLBASE4"
MASTER_TIP4="$(sha "$ENV4/IBL5" master)"
assert_eq "case 4: master untouched" "$(sha "$ENV4/IBL5" master)" "$MASTER_TIP4"

echo "== case 5: --existing, stale local ref — fast-forwarded to origin tip"
ENV5="$(new_env_base_branch)"
ORIGIN_TIP5="$(sha "$ENV5/IBL5" origin/feature-a)"
OUT5="$("$ENV5/IBL5/bin/wt-new" --existing feature-a 2>&1)"
assert_match "case 5: output mentions origin/feature-a" "origin/feature-a" "$OUT5"
if [ -d "$ENV5/IBL5-worktrees/feature-a" ]; then
    pass "case 5: worktree dir exists"
else
    failcase "case 5: worktree dir missing"
fi
assert_eq "case 5: local feature-a fast-forwarded to origin" \
    "$ORIGIN_TIP5" "$(sha "$ENV5/IBL5" feature-a)"
assert_absent "case 5: no fast-forward abort message" "Not possible to fast-forward" "$OUT5"

echo "== case 6: --existing with optional positional + --base"
ENV6="$(new_env_base_branch)"
OUT6="$("$ENV6/IBL5/bin/wt-new" --existing feature-a wt-alias --base feature-a 2>&1)"
assert_match "case 6: output mentions origin/feature-a" "origin/feature-a" "$OUT6"
if [ -d "$ENV6/IBL5-worktrees/wt-alias" ]; then
    pass "case 6: IBL5-worktrees/wt-alias exists"
else
    failcase "case 6: IBL5-worktrees/wt-alias missing"
fi
if [ -d "$ENV6/IBL5-worktrees/feature-a" ]; then
    failcase "case 6: IBL5-worktrees/feature-a should NOT exist"
else
    pass "case 6: IBL5-worktrees/feature-a does not exist (correct)"
fi
CHECKEDOUT6="$(git -C "$ENV6/IBL5-worktrees/wt-alias" rev-parse --abbrev-ref HEAD 2>/dev/null)" && true
assert_eq "case 6: checked out branch is feature-a" "feature-a" "$CHECKEDOUT6"
IBLBASE6="$(git -C "$ENV6/IBL5-worktrees/wt-alias" config "branch.feature-a.iblBase" 2>/dev/null)" && true
assert_eq "case 6: iblBase recorded as feature-a" "feature-a" "$IBLBASE6"

echo "== case 7: --existing with absent branch"
ENV7="$(new_env_base_branch)"
OUT7="$("$ENV7/IBL5/bin/wt-new" --existing no-such-branch 2>&1)" && RC7=$? || RC7=$?
if [ "$RC7" -ne 0 ]; then pass "case 7: exits non-zero"; else
    failcase "case 7: exits non-zero — expected non-zero, got 0"; fi
assert_match "case 7: stderr names no such branch on origin" "no such branch on origin" "$OUT7"
if [ -d "$ENV7/IBL5-worktrees/no-such-branch" ]; then
    failcase "case 7: IBL5-worktrees/no-such-branch must not exist"
else
    pass "case 7: no worktree dir created"
fi

echo "== case 8: --existing with branch already checked out elsewhere"
# new_env has the 'feature' branch live in IBL5-worktrees/feature
ENV8="$(new_env)"
OUT8="$("$ENV8/IBL5/bin/wt-new" --existing feature dup 2>&1)" && RC8=$? || RC8=$?
if [ "$RC8" -ne 0 ]; then pass "case 8: exits non-zero"; else
    failcase "case 8: exits non-zero — expected non-zero, got 0"; fi
assert_match "case 8: stderr names already checked out at" "already checked out at" "$OUT8"
assert_match "case 8: stderr contains the existing path" "IBL5-worktrees/feature" "$OUT8"
if [ -d "$ENV8/IBL5-worktrees/dup" ]; then
    failcase "case 8: IBL5-worktrees/dup must not exist"
else
    pass "case 8: no dup worktree created"
fi

echo "== case 9: --existing with diverged local ref"
ENV9="$(new_env_base_branch)"
# Add a local-only commit on feature-a so it has commits not on origin
git_q -C "$ENV9/IBL5" checkout -q feature-a >/dev/null 2>&1
echo "local-only" > "$ENV9/IBL5/local-only.txt"
git_q -C "$ENV9/IBL5" add -A >/dev/null 2>&1
git_q -C "$ENV9/IBL5" commit -qm "local-only" >/dev/null 2>&1
git_q -C "$ENV9/IBL5" checkout -q master >/dev/null 2>&1
SHA_BEFORE9="$(sha "$ENV9/IBL5" feature-a)"
OUT9="$("$ENV9/IBL5/bin/wt-new" --existing feature-a 2>&1)" && RC9=$? || RC9=$?
if [ "$RC9" -ne 0 ]; then pass "case 9: exits non-zero"; else
    failcase "case 9: exits non-zero — expected non-zero, got 0"; fi
assert_match "case 9: stderr names commits not on origin" "commits not on origin/feature-a" "$OUT9"
assert_eq "case 9: local feature-a ref unchanged" "$SHA_BEFORE9" "$(sha "$ENV9/IBL5" feature-a)"
if [ -d "$ENV9/IBL5-worktrees/feature-a" ]; then
    failcase "case 9: no worktree dir should be created"
else
    pass "case 9: no worktree dir created"
fi

echo "== case 10: --existing with no value"
OUT10="$("$ENV7/IBL5/bin/wt-new" --existing 2>&1)" && RC10=$? || RC10=$?
if [ "$RC10" -ne 0 ]; then pass "case 10: exits non-zero"; else
    failcase "case 10: exits non-zero — expected non-zero, got 0"; fi
assert_match "case 10: error names requires a branch name" "requires a branch name" "$OUT10"
assert_absent "case 10: no unbound variable crash" "unbound variable" "$OUT10"

echo "----"
if [ "$FAILED" -eq 0 ]; then echo "ALL PASS"; else echo "FAILURES"; fi
exit "$FAILED"
