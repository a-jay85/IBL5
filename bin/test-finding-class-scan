case_filing_failure_and_success() {
    new_fixture
    printf '2026-10-01T00:00:00Z\n' > "$STATE/watermark"
    cp "$STATE/watermark" "$FX/watermark.before"
    touch "$STUB_DIR/gh.create.fail"
    fcs
    expect_eq "row 35: issue create failure exits 1" 1 "$RC"
    expect_same_file "row 35: watermark byte-identical" "$STATE/watermark" "$FX/watermark.before"
    expect_has "row 35: DM says FAILED" "$(cat "$STUB_DIR/dm.txt")" "FAILED"
    new_fixture
    fcs
    expect_eq "row 35: success exits 0" 0 "$RC"
    expect_eq "row 35: success writes the watermark" "2026-10-12T10:00:00Z" "$(cat "$STATE/watermark")"
    expect_has "row 35: DM says filed 1" "$(cat "$STUB_DIR/dm.txt")" "filed 1"
    expect_has "success summary line" "$OUT" "summary mode=backfill dry_run=0 threads_new=5 filed=1"
    expect_eq "success appends to runs.log" 1 "$(grep -c 'summary ' "$STATE/runs.log")"
    new_fixture
    set_payload "$EMPTY_PAYLOAD"
    local i
    for i in $(seq 1 200); do seed_class "skipped-class-$i" none 80 "k$i-1" "k$i-2" "k$i-3"; done
    fcs
    local size
    size="$(wc -c < "$STUB_DIR/dm.txt" | tr -d ' ')"
    if [ "$size" -le 1800 ]; then ok "row 35: DM stdin is $size bytes for 200 skipped classes"; else fail "row 35: DM stdin is $size bytes"; fi
    expect_has "row 35: DM is marked truncated" "$(cat "$STUB_DIR/dm.txt")" "[truncated]"
}

# 125 trusted threads on one PR give three classifier batches of 60.
many_threads_fixture() {
    jq -c '.data.repository.pullRequests.pageInfo.hasNextPage = false
        | .data.repository.pullRequests.nodes = [
            (.data.repository.pullRequests.nodes[0]
             | .reviewThreads.pageInfo.hasNextPage = false
             | .reviewThreads.nodes = [range(1; 126) as $i
                 | {id: ("M\($i)"), isResolved: false, isOutdated: false, path: "ibl5/classes/Foo/Bar.php", line: 10,
                    comments: {nodes: [{author: {login: "a-jay85", __typename: "User"}, body: "finding body \($i)",
                                        url: "https://github.com/a-jay85/IBL5/pull/101#discussion_r\(1000 + $i)",
                                        createdAt: "2026-10-10T09:00:00Z"}]}}])]' \
        "$STUB_DIR/fx/pr-page-1.json" > "$STUB_DIR/fx/pr-page-1.tmp" && mv "$STUB_DIR/fx/pr-page-1.tmp" "$STUB_DIR/fx/pr-page-1.json"
}

case_batch_cap_holds_the_watermark() {
    new_fixture
    set_payload "$EMPTY_PAYLOAD"
    many_threads_fixture
    printf '2026-10-01T00:00:00Z\n' > "$STATE/watermark"
    cp "$STATE/watermark" "$FX/watermark.before"
    XENV="FCS_MAX_BATCHES=1"
    fcs
    expect_eq "cap: run exits 0" 0 "$RC"
    expect_has "cap: the cap is announced" "$ALL" "batch cap 1 reached"
    expect_eq "cap: one classifier call" 1 "$(count_lines claude.calls call)"
    expect_has "cap: the held watermark is announced" "$ALL" "watermark held"
    expect_same_file "cap: watermark byte-identical" "$STATE/watermark" "$FX/watermark.before"
    new_fixture
    set_payload "$EMPTY_PAYLOAD"
    many_threads_fixture
    printf '2026-10-01T00:00:00Z\n' > "$STATE/watermark"
    XENV="FCS_MAX_BATCHES=3"
    fcs
    expect_eq "no cap: run exits 0" 0 "$RC"
    expect_eq "no cap: three classifier calls" 3 "$(count_lines claude.calls call)"
    expect_eq "no cap: watermark moves" "2026-10-12T10:00:00Z" "$(cat "$STATE/watermark")"
}

case_since_holds_the_watermark() {
    new_fixture
    set_payload "$EMPTY_PAYLOAD"
