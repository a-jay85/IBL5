echo
echo "== J22 the brief size cap =="
# mk_brief <lines> <file>: <lines> lines of 99 bytes; first starts HEAD-SENTINEL,
# last starts TAIL-SENTINEL.
mk_brief() {
    awk -v n="$1" 'BEGIN {
        pad = sprintf("%99s", ""); gsub(/ /, "a", pad)
        for (i = 1; i <= n; i++) {
            l = pad
            if (i == 1) l = substr("HEAD-SENTINEL" pad, 1, 99)
            if (i == n) l = substr("TAIL-SENTINEL" pad, 1, 99)
            print l
        }
    }' > "$2"
}
mk_brief 200 "$BASE_TMP/briefs/big.md"
reset_recorder
run_hint "$BASE_TMP/judge-rec" --brief "$BASE_TMP/briefs/big.md"
J22_DUMP="$(fence_dump)"
expect_eq "J22 long brief keeps head, loses tail" "10" \
    "$(printf '%s\n' "$J22_DUMP" | awk '
        /^HEAD-SENTINEL/ { h = 1 }
        /^TAIL-SENTINEL/ { t = 1 }
        END { printf "%d%d", h, t }')"
expect_match "J22 long brief ends with the truncation marker" \
    '^\[brief truncated: first 16000 of [0-9]+ bytes shown\]$' <(printf '%s\n' "$J22_DUMP" | tail -n 1)
mk_brief 160 "$BASE_TMP/briefs/edge.md"
reset_recorder
run_hint "$BASE_TMP/judge-rec" --brief "$BASE_TMP/briefs/edge.md"
J22_EDGE="$(fence_dump)"
expect_eq "J22 15999-byte brief keeps its last line, no marker" "10" \
    "$(printf '%s\n' "$J22_EDGE" | awk '
        /^TAIL-SENTINEL/ { t = 1 }
        /^\[brief truncated/ { m = 1 }
        END { printf "%d%d", t, m }')"

echo
echo "== J23 a failing judge with a brief still prints default =="
J23_BEFORE="$(awk 'END { print NR }' "$PLAN_TIER_HINT_LOG" 2>/dev/null)"
run_hint "$BASE_TMP/judge-exit3" --brief "$J17_BRIEF"
expect_exit "J23 hint exits 0" 0 "$RC"
expect_eq "J23 prints default" "default" "$(cut -f1 "$OUT")"
expect_eq "J23 logs exactly one new line" "$((J23_BEFORE + 1))" \
    "$(awk 'END { print NR }' "$PLAN_TIER_HINT_LOG" 2>/dev/null)"

echo
echo "== J24 a --brief call never reads stdin =="
reset_recorder
printf 'STDIN-SENTINEL\n' | PLAN_TIER_HINT_CLAUDE="$BASE_TMP/judge-rec" \
    "$HINT" --brief "$J17_BRIEF" >"$OUT" 2>"$ERR"
expect_eq "J24 prompt lacks the stdin text" "0" \
    "$(awk '/STDIN-SENTINEL/ { n++ } END { print n + 0 }' "$BASE_TMP/argv")"

