# Prose assertion 6: B55 (phase 5.5 verdict parse) must contain no rev-parse —
# proof the record block stayed in its own fence and the four existing parse tests
# are still hermetic. A future edit that folds git rev-parse into the parse fence
# would make those tests run git against a fixture path and silently stop being hermetic.
if [ -z "$B55" ]; then
    echo "FAIL: B55 absent — skipping rev-parse hermeticity check"
    FAILED=1
