# ══ ASSEMBLY CASES — payload.json is built by the tick from prose.json ═══════
# Each case emits exactly ONE ok/FAIL line carrying its name; the sub-checks
# accumulate into _SRT_BAD and srt_case_done reports them together.

_SRT_BAD=""
# srt_ck <label> <want> <got> — record a mismatch.
srt_ck() { [ "$2" = "$3" ] || _SRT_BAD="$_SRT_BAD; $1: want [$2] got [$3]"; }
# srt_ck_has / srt_ck_lacks <file-in-STUB> <pattern> <label>
srt_ck_has()   { grep -qF -- "$2" "$STUB/$1" 2>/dev/null || _SRT_BAD="$_SRT_BAD; $3: '$2' absent from $1"; }
srt_ck_lacks() { ! grep -qF -- "$2" "$STUB/$1" 2>/dev/null || _SRT_BAD="$_SRT_BAD; $3: '$2' unexpectedly in $1"; }
# srt_case_done <name> — one ok/FAIL line, then reset.
srt_case_done() {
    if [ -z "$_SRT_BAD" ]; then srt_ok "$1"; else srt_fail "$1 —$_SRT_BAD"; fi
    _SRT_BAD=""
}
# srt_stored_line <n> — line n of the first stored game's recap_text.
srt_stored_line() {
    jq -r '.games[0].recap_text' "$STUB/store.stdin" 2>/dev/null | sed -n "${1}p"
}
_SRT_TWO_GAMES='{"sim":42,"start_date":"2026-01-01","end_date":"2026-01-07","roster":{},"active_injuries":[],"sim_trades":[],"games":[{"key":"g1","season_year":2008,"game_date":"2026-07-23","box_id":null,"game_of_that_day":1,"visitor_teamid":1,"visitor_name":"Team A","visitor_score":101,"home_teamid":2,"home_name":"Team B","home_score":99},{"key":"g2","season_year":2008,"game_date":"2026-07-23","box_id":null,"game_of_that_day":2,"visitor_teamid":3,"visitor_name":"Team C","visitor_score":90,"home_teamid":4,"home_name":"Team D","home_score":88}],"standings":[]}'

# ── assemble_builds_score_header_and_mention_line ─────────────────────────────
srt_reset; srt_claim42
touch "$STUB/record-stdin"
srt_run
srt_ck "exit" 0 "$SRT_RC"
srt_ck "line 1 is the score header" "**Team A 101 @ Team B 99**" "$(srt_stored_line 1)"
if ! srt_stored_line 2 | grep -qE '^<@[0-9]+> · <@[0-9]+>$'; then
    _SRT_BAD="$_SRT_BAD; line 2 not a two-mention line: [$(srt_stored_line 2)]"
fi
srt_ck "line 3 is empty" "" "$(srt_stored_line 3)"
srt_ck "line 4 is the paragraph" "game recap" "$(srt_stored_line 4)"
srt_case_done "assemble_builds_score_header_and_mention_line"

# ── assemble_structural_fields_come_from_context ──────────────────────────────
srt_reset; srt_claim42
touch "$STUB/record-stdin"
printf '%s' '{"intro_text":"intro","outro_text":"outro","recap_text":"recap","themes":["t"],"game_of_that_day":7,"games":{"g1":"game recap"}}' \
    > "$STUB/resp.prose"
srt_run
srt_ck "exit" 0 "$SRT_RC"
srt_ck "game_of_that_day from context" "1" "$(jq -r '.games[0].game_of_that_day' "$STUB/store.stdin" 2>/dev/null)"
srt_ck "sort_order" "1" "$(jq -r '.games[0].sort_order' "$STUB/store.stdin" 2>/dev/null)"
srt_ck "box_id" "null" "$(jq -r '.games[0].box_id' "$STUB/store.stdin" 2>/dev/null)"
srt_ck "visitor_teamid type" "number" "$(jq -r '.games[0].visitor_teamid | type' "$STUB/store.stdin" 2>/dev/null)"
srt_case_done "assemble_structural_fields_come_from_context"

# ── assemble_missing_game_key_parks_flaky ─────────────────────────────────────
srt_reset; srt_claim42
printf '%s\n' "$_SRT_TWO_GAMES" > "$STUB/resp.simRecapContext"
srt_run
