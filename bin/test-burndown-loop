# ---------------------------------------------------------------- re-exec hand-off

# reexec_handoff <extra-env-assignments> <loop-args>: runs the loop as a same-PID
# hand-off (bash -c + exec keeps $$), with the lock pid pre-written. Sets OUT and RC.
reexec_handoff() {
    OUT=$(LOOP="$LOOP" STATE="$STATE" SID_A="$SID_A" T="$T" bash -c '
        mkdir -p "$STATE/lock"; echo $$ > "$STATE/lock/pid"; echo $$ > "$T/handoff.pid"
        export IBL5_BURNDOWN_REEXEC_PID=$$ IBL5_BURNDOWN_REEXEC_SID="$SID_A" \
            IBL5_BURNDOWN_REEXEC_BATCHES=2 IBL5_BURNDOWN_REEXEC_ITEMS=5 \
            IBL5_BURNDOWN_REEXEC_UNITS=0 IBL5_BURNDOWN_REEXEC_FAILS=1 \
            IBL5_BURNDOWN_REEXEC_START=$(( $(date +%s) - 600 ))
        eval "$1"
        shift
        exec "$LOOP" "$@"' _ "$1" "${@:2}" 2>&1)
    RC=$?
}

test_reexec_handoff_adopts_lock() {
    new_env
    seed_usage 5 0 1
    queue drain
    reexec_handoff ':' run
    assert_eq reexec_adopt:rc 0 "$RC"
    assert_contains reexec_adopt:resumed "$OUT" "re-exec resumed pid="
    assert_contains reexec_adopt:totals "$OUT" "finish reason=stopped batches=2 items=5"
    assert_contains reexec_adopt:empty-line "$OUT" "backlog empty (sentinel confirmed first round LEDGER: none); re-check in 240m streak="
    assert_eq reexec_adopt:sid "$SID_A" "$(cat "$STATE/loop.sid")"
    assert_contains reexec_adopt:claude-sid "$(cat "$T/claude.calls")" "SID=$SID_A"
    assert_contains reexec_adopt:elapsed "$(cat "$T/dm.calls" 2>/dev/null)" "elapsed=10m"
    assert_no_file reexec_adopt:lock-released "$STATE/lock"
    assert_no_file reexec_adopt:env-unset "$T/claude.reexec-env"
}

test_reexec_garbage_env_fresh() {
    new_env
    seed_usage 5 0 1
    queue ledger drain
    reexec_handoff 'export IBL5_BURNDOWN_REEXEC_BATCHES=abc IBL5_BURNDOWN_REEXEC_FAILS=-1 IBL5_BURNDOWN_REEXEC_START=x' run
    assert_eq reexec_garbage:rc 0 "$RC"
    assert_contains reexec_garbage:invalid "$OUT" "re-exec state invalid; counters reset"
    assert_contains reexec_garbage:totals "$OUT" "finish reason=stopped batches=1 items=1"
    assert_contains reexec_garbage:empty-line "$OUT" "backlog empty (sentinel confirmed first round LEDGER: none); re-check in 240m streak="
    assert_no_file reexec_garbage:env-unset "$T/claude.reexec-env"
}

test_reexec_stale_env_ignored() {
    new_env
    seed_usage 5 0 1
    queue none
    IBL5_BURNDOWN_REEXEC_PID=1 IBL5_BURNDOWN_REEXEC_BATCHES=7 IBL5_BURNDOWN_REEXEC_SID="$SID_A" run_loop run
    assert_eq reexec_stale:rc 0 "$RC"
    assert_not_contains reexec_stale:no-reexec "$OUT" "re-exec"
    assert_contains reexec_stale:fresh-counters "$OUT" "batches=0 items=0"
    assert_contains reexec_stale:empty-line "$OUT" "backlog empty (sentinel confirmed first round LEDGER: none); re-check in 240m streak="
    if [ "$(cat "$STATE/loop.sid")" != "$SID_A" ]; then pass reexec_stale:fresh-sid; else fail reexec_stale:fresh-sid; fi
    assert_no_file reexec_stale:env-unset "$T/claude.reexec-env"
}

test_reexec_dry_run_ignores_handoff() {
    new_env
    seed_usage 5 0 1
    reexec_handoff ':' run --dry-run
    assert_eq reexec_dry:rc 0 "$RC"
    assert_eq reexec_dry:one-line 1 "$(decision_lines)"
    assert_not_contains reexec_dry:no-resume "$OUT" "re-exec resumed"
    assert_eq reexec_dry:lock-untouched "$(cat "$T/handoff.pid")" "$(cat "$STATE/lock/pid" 2>/dev/null)"
}

# ---------------------------------------------------------------- re-exec in a copied tree
# Shared scenario: batch 1 aborts after writing a ledger and sleeps (the hook fires
# there), batch 2 runs, batch 3 finds nothing, so every run ends stopped (the stub's drain action).

test_reexec_on_code_change() {
    new_env
    seed_usage 5 0 1
    make_tree
    queue ledger-exit3 ledger drain
    command -v shasum >/dev/null || fail reexec:shasum "shasum missing on PATH"
    tree_hook bin/lib/usage-fetch.sh '# changed'
    run_tree_loop run
    assert_eq reexec_change:rc 0 "$RC"
    assert_eq reexec_change:one-exec 1 "$(printf '%s\n' "$OUT" | grep -c 'code changed; re-exec old=')"
    assert_contains reexec_change:resumed "$OUT" "re-exec resumed pid="
    assert_contains reexec_change:counters "$OUT" "batches=1 items=1 fails=1"
    assert_eq reexec_change:calls 3 "$(calls "$T/claude.calls")"
    assert_eq reexec_change:one-sid 1 "$(sed -n 's/.* SID=\([^ ]*\) .*/\1/p' "$T/claude.calls" | sort -u | wc -l | tr -d ' ')"
    assert_eq reexec_change:sid-matches "$(cat "$STATE/loop.sid")" "$(sed -n 's/.* SID=\([^ ]*\) .*/\1/p' "$T/claude.calls" | sort -u)"
    assert_contains reexec_change:totals "$OUT" "finish reason=stopped batches=2 items=2"
    assert_contains reexec_change:empty-line "$OUT" "backlog empty (sentinel confirmed first round LEDGER: none); re-check in 240m streak="
    assert_eq reexec_change:one-dm 1 "$(grep -c 'burndown-loop: finished' "$T/dm.calls")"
    assert_contains reexec_change:dm-totals "$(cat "$T/dm.calls")" "batches=2 items=2"
    assert_no_file reexec_change:lock-released "$STATE/lock"
    assert_no_file reexec_change:env-unset "$T/claude.reexec-env"
}

test_reexec_unchanged_no_exec() {
    new_env
    seed_usage 5 0 1
    make_tree
    queue ledger-exit3 ledger drain
    printf ': > "%s/hook.ran"\n' "$T" > "$T/sleep.hook"
    run_tree_loop run
    assert_eq reexec_same:rc 0 "$RC"
    assert_file reexec_same:slept "$T/hook.ran"
    assert_not_contains reexec_same:no-change "$OUT" "code changed"
    assert_not_contains reexec_same:no-resume "$OUT" "re-exec resumed"
    assert_contains reexec_same:totals "$OUT" "finish reason=stopped batches=2 items=2"
    assert_contains reexec_same:empty-line "$OUT" "backlog empty (sentinel confirmed first round LEDGER: none); re-check in 240m streak="
}

test_reexec_syntax_error_skipped() {
