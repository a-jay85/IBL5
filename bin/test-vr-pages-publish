#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-vr-pages-publish — regression harness for bin/vr-pages-publish
#
# Run: bin/test-vr-pages-publish  (exit 0 = all pass, 1 = a case failed)
# Runs under `env -i PATH=/usr/bin:/bin` (macOS /bin/bash 3.2).

set -u

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
export HOME="${HOME:-$TMP}" GIT_CONFIG_NOSYSTEM=1

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SCRIPT="$SCRIPT_DIR/vr-pages-publish"
FAILED=0
CASE_BAD=0

HEX40="0123456789abcdef0123456789abcdef01234567"

fail() { echo "FAIL: $1 — got $2 want $3"; FAILED=1; CASE_BAD=1; }

# eq <label> <got> <want>
eq() {
    if [ "$2" != "$3" ]; then fail "$1" "$2" "$3"; fi
}

# want <label> <haystack> <needle>
want() {
    if ! grep -qF -- "$3" <<< "$2"; then fail "$1" "$2" "contains '$3'"; fi
}

case_start() { CASE_BAD=0; CASE_NAME="$1"; }
case_end() { if [ "$CASE_BAD" = 0 ]; then echo "ok $CASE_NAME"; fi; }

GIT_ID=(-c user.name=t -c user.email=t@example.com)

# ---------------------------------------------------------------------------
# Seed: a bare remote whose gh-pages holds the pr/ trees under test.
# ---------------------------------------------------------------------------
SEED="$TMP/seed.git"
git init -q --bare -b gh-pages "$SEED"
SEED_WORK="$TMP/seed-work"
git init -q -b gh-pages "$SEED_WORK"
mkdir -p "$SEED_WORK/pr/5/visual-review" "$SEED_WORK/pr/5/meta" \
    "$SEED_WORK/pr/9/meta" "$SEED_WORK/pr/foo" "$SEED_WORK/$HEX40/visual-review"
echo old > "$SEED_WORK/pr/5/visual-review/old.html"
echo blk > "$SEED_WORK/pr/5/meta/block.md"
echo x > "$SEED_WORK/pr/9/meta/x"
echo k > "$SEED_WORK/pr/foo/keep"
echo i > "$SEED_WORK/$HEX40/visual-review/index.html"
git -C "$SEED_WORK" add -A
git -C "$SEED_WORK" "${GIT_ID[@]}" commit -q -m seed
git -C "$SEED_WORK" push -q "$SEED" gh-pages:gh-pages

SEED_TREE="$HEX40/visual-review/index.html
pr/5/meta/block.md
pr/5/visual-review/old.html
pr/9/meta/x
pr/foo/keep"

# new_case <name> — fresh remote copy + fresh clone of its gh-pages
new_case() {
    CASE="$TMP/case-$1"
    rm -rf "$CASE"
    mkdir -p "$CASE"
    cp -R "$SEED" "$CASE/remote.git"
    git clone -q --branch gh-pages "$CASE/remote.git" "$CASE/work"
    REMOTE="$CASE/remote.git"
    WORK="$CASE/work"
}

remote_tree() { git --git-dir="$REMOTE" ls-tree -r --name-only gh-pages; }
remote_tip() { git --git-dir="$REMOTE" rev-parse gh-pages; }

# run_pub <args...> — sets OUT (stdout), ERR (stderr), RC
run_pub() {
    OUT="$(bash "$SCRIPT" "$@" 2>"$CASE/err")"
    RC=$?
    ERR="$(cat "$CASE/err")"
}

# A source dir with a new file and a nested file
make_src() {
    SRC="$CASE/src"
    mkdir -p "$SRC/sub"
    echo new > "$SRC/new.html"
    echo nested > "$SRC/sub/n.txt"
}

# ---------------------------------------------------------------------------
case_start put-replaces-only-dest
new_case put
make_src
TIP0="$(remote_tip)"
run_pub --repo-dir="$WORK" --message=m --put="$SRC:pr/5/visual-review"
eq "put: exit" "$RC" "0"
eq "put: stdout" "$OUT" "changed=1"
eq "put: remote tree" "$(remote_tree)" "$HEX40/visual-review/index.html
pr/5/meta/block.md
pr/5/visual-review/new.html
pr/5/visual-review/sub/n.txt
pr/9/meta/x
pr/foo/keep"
if [ "$(remote_tip)" = "$TIP0" ]; then fail "put: tip advanced" "$TIP0" "a new commit"; fi
case_end

# ---------------------------------------------------------------------------
case_start put-no-change
new_case nochange
make_src
run_pub --repo-dir="$WORK" --message=m --put="$SRC:pr/5/visual-review"
eq "first put: stdout" "$OUT" "changed=1"
TIP1="$(remote_tip)"
run_pub --repo-dir="$WORK" --message=m --put="$SRC:pr/5/visual-review"
eq "re-put: exit" "$RC" "0"
eq "re-put: stdout" "$OUT" "changed=0"
eq "re-put: tip" "$(remote_tip)" "$TIP1"
case_end

# ---------------------------------------------------------------------------
case_start retry-after-reject
new_case retry
make_src
FLAG="$CASE/rejected-once"
printf '#!/bin/sh\nif [ -e "%s" ]; then exit 0; fi\n: > "%s"\nexit 1\n' "$FLAG" "$FLAG" \
    > "$REMOTE/hooks/pre-receive"
chmod +x "$REMOTE/hooks/pre-receive"
run_pub --repo-dir="$WORK" --message=m --put="$SRC:pr/5/visual-review"
eq "retry: exit" "$RC" "0"
eq "retry: stdout" "$OUT" "changed=1"
want "retry: stderr names the rejection" "$ERR" "push rejected (attempt 1/3)"
want "retry: file landed" "$(remote_tree)" "pr/5/visual-review/new.html"
case_end

# ---------------------------------------------------------------------------
case_start exhausted-attempts-fail
new_case exhaust
make_src
printf '#!/bin/sh\nexit 1\n' > "$REMOTE/hooks/pre-receive"
chmod +x "$REMOTE/hooks/pre-receive"
TIP0="$(remote_tip)"
run_pub --repo-dir="$WORK" --message=m --put="$SRC:pr/5/visual-review"
eq "exhausted: exit" "$RC" "1"
eq "exhausted: stdout" "$OUT" ""
want "exhausted: stderr names the failure" "$ERR" "failed after 3 attempts"
want "exhausted: stderr names the last rejection" "$ERR" "push rejected (attempt 3/3)"
eq "exhausted: tip" "$(remote_tip)" "$TIP0"
eq "exhausted: tree" "$(remote_tree)" "$SEED_TREE"
case_end

# ---------------------------------------------------------------------------
case_start delete-pr-dir
new_case delete
run_pub --repo-dir="$WORK" --message=m --delete=pr/5
eq "delete: exit" "$RC" "0"
eq "delete: stdout" "$OUT" "changed=1"
eq "delete: remote tree" "$(remote_tree)" "$HEX40/visual-review/index.html
pr/9/meta/x
pr/foo/keep"
case_end

# ---------------------------------------------------------------------------
case_start sweep-keeps-open
new_case sweep
printf '9\n' > "$CASE/open.txt"
run_pub --repo-dir="$WORK" --message=m --sweep-closed --open-prs="$CASE/open.txt"
eq "sweep: exit" "$RC" "0"
eq "sweep: stdout" "$OUT" "swept=1"
eq "sweep: remote tree" "$(remote_tree)" "$HEX40/visual-review/index.html
pr/9/meta/x
pr/foo/keep"
case_end

# ---------------------------------------------------------------------------
case_start sweep-empty-list-refuses
new_case sweepempty
: > "$CASE/open.txt"
TIP0="$(remote_tip)"
run_pub --repo-dir="$WORK" --message=m --sweep-closed --open-prs="$CASE/open.txt"
eq "empty: exit" "$RC" "0"
eq "empty: stdout" "$OUT" "swept=0"
want "empty: refusing message" "$ERR" "refusing to sweep: open-PR list is empty"
eq "empty: tip" "$(remote_tip)" "$TIP0"
eq "empty: tree" "$(remote_tree)" "$SEED_TREE"
case_end

# ---------------------------------------------------------------------------
case_start sweep-bad-line-exit2
new_case sweepbad
printf '9\n9x\n' > "$CASE/open.txt"
TIP0="$(remote_tip)"
run_pub --repo-dir="$WORK" --message=m --sweep-closed --open-prs="$CASE/open.txt"
eq "bad line: exit" "$RC" "2"
eq "bad line: stdout" "$OUT" ""
eq "bad line: tip" "$(remote_tip)" "$TIP0"
eq "bad line: tree" "$(remote_tree)" "$SEED_TREE"
case_end

# ---------------------------------------------------------------------------
case_start sweep-missing-file-exit2
new_case sweepmissing
TIP0="$(remote_tip)"
run_pub --repo-dir="$WORK" --message=m --sweep-closed --open-prs="$CASE/no-such-file"
eq "missing file: exit" "$RC" "2"
eq "missing file: tip" "$(remote_tip)" "$TIP0"
run_pub --repo-dir="$WORK" --message=m --sweep-closed
eq "no --open-prs: exit" "$RC" "2"
case_end

# ---------------------------------------------------------------------------
case_start dest-grammar-rejects
new_case grammar
make_src
TIP0="$(remote_tip)"
run_pub --repo-dir="$WORK" --message=m --put="$SRC:pr/5/../../x"
eq "put traversal: exit" "$RC" "2"
run_pub --repo-dir="$WORK" --message=m --put="$SRC:abc"
eq "put bare dest: exit" "$RC" "2"
run_pub --repo-dir="$WORK" --message=m --delete=pr/0
eq "delete pr/0: exit" "$RC" "2"
run_pub --repo-dir="$WORK" --message=m --delete=pr
eq "delete pr: exit" "$RC" "2"
run_pub --repo-dir="$WORK" --message=m --delete=pr/5/meta
eq "delete pr/5/meta: exit" "$RC" "2"
run_pub --repo-dir="$WORK" --message=m --sweep-closed --open-prs="$CASE/x" --delete=pr/5
eq "sweep + delete: exit" "$RC" "2"
eq "tip untouched" "$(remote_tip)" "$TIP0"
eq "tree untouched" "$(remote_tree)" "$SEED_TREE"
case_end

# ---------------------------------------------------------------------------
case_start flag-form-rejects
new_case flags
run_pub --repo-dir "$WORK" --message=m --delete=pr/5
eq "space form: exit" "$RC" "2"
run_pub --repo-dir="$WORK" --message=m --delete=pr/5 --bogus=1
eq "unknown flag: exit" "$RC" "2"
eq "tree untouched" "$(remote_tree)" "$SEED_TREE"
case_end

# ---------------------------------------------------------------------------
case_start dry-run-no-push
new_case dry
make_src
TIP0="$(remote_tip)"
run_pub --repo-dir="$WORK" --message=m --dry-run --put="$SRC:pr/5/visual-review"
eq "dry-run: exit" "$RC" "0"
eq "dry-run: stdout" "$OUT" "changed=1"
want "dry-run: stat on stderr" "$ERR" "new.html"
eq "dry-run: tip" "$(remote_tip)" "$TIP0"
eq "dry-run: tree" "$(remote_tree)" "$SEED_TREE"
case_end

if [ "$FAILED" = 0 ]; then
    echo "ALL PASS"
fi
exit "$FAILED"
