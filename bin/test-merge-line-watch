#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-merge-line-watch — regression harness for bin/merge-line-watch.
#
# Drives --once passes against a stub gh (GH_CMD) and a stub selector
# (MERGE_LINE_SELECT_CMD). No network, no credentials.
#
# Run: bin/test-merge-line-watch  (exit 0 = all pass, exit 1 = a case failed)

set -u

# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WATCH="$SCRIPT_DIR/merge-line-watch"
h_tmp TMP

pass()     { h_pass "$1"; }
failcase() { h_fail "$@"; }

assert_match() {
    if grep -qE -- "$2" <<< "$3"; then pass "$1"; else
        failcase "$1 — expected to match: $2"; printf '%s\n' "$3" | sed 's/^/    /'; fi
}
assert_absent() {
    if grep -qE -- "$2" <<< "$3"; then
        failcase "$1 — expected NOT to match: $2"; printf '%s\n' "$3" | sed 's/^/    /'
    else pass "$1"; fi
}

assert_eq() { h_eq "$1" "$2" "$3"; }

GH_LOG="$TMP/gh.log"
cat > "$TMP/gh" <<EOF
#!/bin/sh
echo "\$*" >> "$GH_LOG"
case "\$*" in *update-branch*) [ -n "\${GH_PUT_FAIL:-}" ] && { echo "boom" >&2; exit 1; } ;; esac
echo deadbeefcafe
EOF
chmod +x "$TMP/gh"

# Stub selector: prints whatever $SEL_OUT holds. A counter file lets the
# unknown-retry case flip to a real answer on the Nth call.
cat > "$TMP/select" <<EOF
#!/bin/sh
n=\$(cat "$TMP/calls" 2>/dev/null || echo 0); n=\$((n + 1)); echo \$n > "$TMP/calls"
if [ -n "\${SEL_UNKNOWN_UNTIL:-}" ] && [ \$n -lt "\$SEL_UNKNOWN_UNTIL" ]; then
    printf 'action=unknown\nhead=\n'; exit 0
fi
[ -n "\${SEL_FAIL:-}" ] && { echo "graphql error"; exit 1; }
printf '%s\n' "\$SEL_OUT"
EOF
chmod +x "$TMP/select"

run() {
    rm -f "$GH_LOG" "$TMP/calls"
    : > "$GH_LOG"
    OUT=$(GH_CMD="$TMP/gh" MERGE_LINE_SELECT_CMD="$TMP/select" "$@" 2>&1)
    RC=$?
    GH=$(cat "$GH_LOG")
}

# A: action=update calls update-branch on the head PR.
SEL_OUT=$'action=update\nhead=42' run "$WATCH" --once
assert_match "A: update reported" 'updated PR #42 onto master' "$OUT"
assert_match "A: PUT on head PR" '^api -X PUT repos/a-jay85/IBL5/pulls/42/update-branch$' "$GH"
assert_eq "A: exit 0" 0 "$RC"

# B: --dry-run never calls update-branch.
SEL_OUT=$'action=update\nhead=42' run "$WATCH" --once --dry-run
assert_match "B: dry-run message" 'dry run: would update PR #42' "$OUT"
assert_absent "B: no PUT" 'update-branch' "$GH"

# C: action=none makes no write.
SEL_OUT=$'action=none\nhead=7' run "$WATCH" --once
assert_match "C: no-op message" 'no update needed \(action=none head=7\)' "$OUT"
assert_absent "C: no PUT" 'update-branch' "$GH"

# D: --repo flows into the PUT path.
SEL_OUT=$'action=update\nhead=9' run "$WATCH" --once --repo o/r
assert_match "D: repo honored" '^api -X PUT repos/o/r/pulls/9/update-branch$' "$GH"

# E: unknown retries until the selector answers.
MERGE_LINE_WATCH_RETRY_WAIT=0 SEL_UNKNOWN_UNTIL=2 SEL_OUT=$'action=update\nhead=5' run "$WATCH" --once
assert_match "E: retried then updated" 'updated PR #5' "$OUT"
assert_eq "E: two selector calls" 2 "$(cat "$TMP/calls")"

# F: selector failure is reported, exit 1, no write.
SEL_FAIL=1 run "$WATCH" --once
assert_match "F: failure reported" 'select failed: graphql error' "$OUT"
assert_absent "F: no PUT" 'update-branch' "$GH"
assert_eq "F: exit 1" 1 "$RC"

# G: update-branch failure is surfaced with the error text.
GH_PUT_FAIL=1 SEL_OUT=$'action=update\nhead=3' run "$WATCH" --once
assert_match "G: failure surfaced" 'update-branch FAILED for #3: boom' "$OUT"
assert_eq "G: exit 1" 1 "$RC"

# I: skipped PRs print with readable reasons; unknown reasons pass through.
SEL_OUT=$'action=update\nhead=8\nskipped=12:dirty 13:red 14:weird' run "$WATCH" --once
assert_match "I: skipped line" 'skipped: #12 \(conflict\), #13 \(failing check\), #14 \(weird\)$' "$OUT"
assert_match "I: head still updated" 'updated PR #8' "$OUT"
assert_absent "I: no comment posted" 'comments' "$GH"

# J: empty skipped= prints nothing.
SEL_OUT=$'action=none\nhead=8\nskipped=' run "$WATCH" --once
assert_absent "J: no skipped line" 'skipped:' "$OUT"

# K-V: bin/lib/master-bot-wait.sh, which the watch loop calls after its settle.
# The stub gh runs the helper's real --jq filter over JSON fixtures. Runs-list
# calls read $BOT_RUNS_OPEN_JSON (default runs-open.json) until runs-list call
# number $BOT_OPEN_UNTIL, then runs-clear.json. Jobs-list calls read
# $BOT_JOBS_JSON (default jobs-running.json). BOT_FAIL fails the runs list and
# BOT_JOBS_FAIL the jobs list. Past 20 runs-list calls the stub fails, so a
# mutated helper that never clears ends in a failed case instead of a hang.
command -v jq >/dev/null 2>&1 \
    || failcase "K-V: jq not on PATH; the bot-wait stub runs the helper's jq filters"
BOT_LOG="$TMP/bot.log"
cat > "$TMP/runs-open.json" <<'EOF'
{"workflow_runs":[
 {"id":101,"name":"Tests and Analysis","status":"in_progress"},
 {"id":102,"name":"Tests and Analysis","status":"completed"},
 {"id":103,"name":"Deploy","status":"queued"},
 {"id":104,"name":"Migration Safety","status":"completed"}]}
EOF
cat > "$TMP/runs-clear.json" <<'EOF'
{"workflow_runs":[
 {"id":102,"name":"Tests and Analysis","status":"completed"},
 {"id":104,"name":"Migration Safety","status":"completed"}]}
EOF
cat > "$TMP/runs-ms.json" <<'EOF'
{"workflow_runs":[
 {"id":105,"name":"Migration Safety","status":"queued"},
 {"id":102,"name":"Tests and Analysis","status":"completed"}]}
EOF
cat > "$TMP/jobs-running.json" <<'EOF'
{"jobs":[
 {"name":"Update coverage & PHPStan baselines","status":"in_progress"},
 {"name":"Regenerate codebase-map","status":"completed","conclusion":"success"},
 {"name":"Tests and Analysis","status":"queued"}]}
EOF
cat > "$TMP/jobs-done.json" <<'EOF'
{"jobs":[
 {"name":"Update coverage & PHPStan baselines","status":"completed","conclusion":"success"},
 {"name":"Regenerate codebase-map","status":"completed","conclusion":"skipped"},
 {"name":"Harness tests","status":"in_progress"},
 {"name":"Tests and Analysis","status":"queued"}]}
EOF
cat > "$TMP/jobs-absent.json" <<'EOF'
{"jobs":[
 {"name":"Regenerate codebase-map","status":"completed","conclusion":"success"},
 {"name":"Update coverage baselines","status":"completed","conclusion":"success"},
 {"name":"Harness tests","status":"in_progress"}]}
EOF
cat > "$TMP/botgh" <<EOF
#!/bin/sh
echo "\$1 \$2 \$3" >> "$BOT_LOG"
case "\$2" in
*/jobs*)
    [ -n "\${BOT_JOBS_FAIL:-}" ] && { echo "HTTP 502" >&2; exit 1; }
    exec jq -r "\$4" "\${BOT_JOBS_JSON:-$TMP/jobs-running.json}" ;;
esac
n=\$(grep -cF 'actions/runs?branch=' "$BOT_LOG")
[ "\$n" -gt 20 ] && { echo "stub: runaway poll" >&2; exit 1; }
[ -n "\${BOT_FAIL:-}" ] && { echo "HTTP 502" >&2; exit 1; }
if [ "\$n" -lt "\${BOT_OPEN_UNTIL:-1}" ]; then
    exec jq -r "\$4" "\${BOT_RUNS_OPEN_JSON:-$TMP/runs-open.json}"
fi
exec jq -r "\$4" "$TMP/runs-clear.json"
EOF
chmod +x "$TMP/botgh"

bot_wait() {
    : > "$BOT_LOG"
    OUT=$(
        # shellcheck source=bin/lib/master-bot-wait.sh
        . "$SCRIPT_DIR/lib/master-bot-wait.sh"
        GH_CMD="$TMP/botgh" MASTER_BOT_WAIT_POLL=0 master_bot_wait "$@" 2>&1
    )
    RC=$?
    CALLS=$(wc -l < "$BOT_LOG" | tr -d ' ')
    RUNS_CALLS=$(grep -cF 'actions/runs?branch=' "$BOT_LOG")
    JOBS_CALLS=$(grep -cF '/jobs?per_page=100' "$BOT_LOG")
}

# K: nothing open returns at once, after one call on the branch-wide runs list.
BOT_OPEN_UNTIL=1 bot_wait o/r
assert_match "K: clear message" 'no bot-committing master run open' "$OUT"
assert_eq "K: one API call" 1 "$CALLS"
assert_match "K: master-wide query" '^api repos/o/r/actions/runs\?branch=master&event=push&per_page=100 ' "$(cat "$BOT_LOG")"
assert_eq "K: exit 0" 0 "$RC"

# L: an open run is polled until it finishes.
BOT_OPEN_UNTIL=3 bot_wait o/r
assert_match "L: names the open run" 'waiting on Tests and Analysis' "$OUT"
assert_match "L: then clear" 'no bot-committing master run open' "$OUT"
assert_eq "L: three runs-list calls" 3 "$RUNS_CALLS"
assert_eq "L: two jobs-list calls" 2 "$JOBS_CALLS"

# M: an API failure goes ahead (fail open), exit 0.
BOT_FAIL=1 bot_wait o/r
assert_match "M: failure goes ahead" 'could not list master runs; going ahead' "$OUT"
assert_eq "M: exit 0" 0 "$RC"

# N: the cap ends the wait even while a run is still open.
MASTER_BOT_WAIT_CAP=0 BOT_OPEN_UNTIL=99 bot_wait o/r
assert_match "N: cap goes ahead" 'still open after 0s \(Tests and Analysis\); going ahead' "$OUT"
assert_eq "N: one runs-list call" 1 "$RUNS_CALLS"
assert_eq "N: one jobs-list call" 1 "$JOBS_CALLS"

# O: progress goes through the caller's say command.
tag() { echo "TAG $*"; }
BOT_OPEN_UNTIL=1 bot_wait o/r tag
assert_match "O: custom say used" '^TAG bot-commit wait: no bot-committing' "$OUT"

# P: the watch loop calls the wait between the settle and the pass.
assert_match "P: loop waits before the pass" 'master_bot_wait "\$REPO" say' "$(sed -n '/sleep "\$SETTLE"/,/run_pass/p' "$WATCH")"

# Q: an open run whose two bot jobs are done (one skipped) clears. Only the
# open run's jobs list is read.
BOT_OPEN_UNTIL=99 BOT_JOBS_JSON="$TMP/jobs-done.json" bot_wait o/r
assert_match "Q: clear message" 'no bot-committing master run open' "$OUT"
assert_eq "Q: one runs-list call" 1 "$RUNS_CALLS"
assert_eq "Q: one jobs-list call" 1 "$JOBS_CALLS"
assert_match "Q: jobs query for the open run" '^api repos/o/r/actions/runs/101/jobs\?per_page=100 ' "$(cat "$BOT_LOG")"

# R: a bot job still in progress keeps the run open.
BOT_OPEN_UNTIL=2 BOT_JOBS_JSON="$TMP/jobs-running.json" bot_wait o/r
assert_match "R: waits on the run" 'waiting on Tests and Analysis' "$OUT"
assert_eq "R: two runs-list calls" 2 "$RUNS_CALLS"
assert_eq "R: one jobs-list call" 1 "$JOBS_CALLS"

# S: a bot job missing from the jobs list (needs pending, or renamed) keeps
# the run open, even beside a completed job with a near-miss name.
BOT_OPEN_UNTIL=2 BOT_JOBS_JSON="$TMP/jobs-absent.json" bot_wait o/r
assert_match "S: waits on the run" 'waiting on Tests and Analysis' "$OUT"
assert_eq "S: two runs-list calls" 2 "$RUNS_CALLS"

# T: a jobs-list failure goes ahead (fail open), exit 0.
BOT_OPEN_UNTIL=99 BOT_JOBS_FAIL=1 bot_wait o/r
assert_match "T: failure goes ahead" 'could not list Tests and Analysis jobs; going ahead' "$OUT"
assert_eq "T: one runs-list call" 1 "$RUNS_CALLS"
assert_eq "T: exit 0" 0 "$RC"

# U: Migration Safety stays a whole-run wait and reads no jobs list.
BOT_OPEN_UNTIL=2 BOT_RUNS_OPEN_JSON="$TMP/runs-ms.json" bot_wait o/r
assert_match "U: waits on Migration Safety" 'waiting on Migration Safety' "$OUT"
assert_eq "U: two runs-list calls" 2 "$RUNS_CALLS"
assert_eq "U: no jobs-list call" 0 "$JOBS_CALLS"

# V: name-drift guard. The helper pins two tests.yml job names. Fail when a
# pinned name is missing from tests.yml, when a pinned job no longer runs git
# push, or when any other tests.yml job runs git push.
# MASTER_BOT_TESTS_YML points the guard at another copy (mutation rows).
# Unset or empty both mean the repo's own tests.yml.
TESTS_YML="${MASTER_BOT_TESTS_YML:-$SCRIPT_DIR/../.github/workflows/tests.yml}"
# One line per job under jobs: as "<id><TAB><name><TAB><git push count>". A
# job block runs from its two-space "<id>:" key to the next one. The job name
# is the four-space name: line, so step names (six spaces) never match.
JOBS_AWK='
/^jobs:[[:space:]]*$/ { injobs = 1; next }
injobs && /^[^[:space:]#]/ { injobs = 0 }
!injobs { next }
/^  [A-Za-z0-9_-]+:[[:space:]]*$/ { id = $1; sub(/:$/, "", id); ids[id] = 1; next }
id != "" && /^    name:/ && !(id in names) {
    n = $0; sub(/^    name:[[:space:]]*/, "", n); sub(/[[:space:]]+$/, "", n)
    gsub(/"/, "", n); names[id] = n
}
id != "" && /git push/ { push[id]++ }
END { for (j in ids) printf "%s\t%s\t%d\n", j, names[j], push[j] + 0 }'
if [ ! -f "$TESTS_YML" ]; then
    failcase "V: tests.yml not found at $TESTS_YML"
else
    JOBS=$(awk "$JOBS_AWK" "$TESTS_YML")
    (
        # shellcheck source=bin/lib/master-bot-wait.sh
        . "$SCRIPT_DIR/lib/master-bot-wait.sh"
        printf '%s\n' "${MASTER_BOT_TA_JOBS[@]}"
    ) > "$TMP/pinned"
    printf '%s\n' "$JOBS" > "$TMP/jobs.tsv"
    assert_eq "V: helper pins two bot jobs" 2 "$(grep -c . "$TMP/pinned")"
    while IFS= read -r p; do
        row=$(awk -F'\t' -v n="$p" '$2 == n' "$TMP/jobs.tsv")
        if [ -n "$row" ]; then pass "V: tests.yml has a job named '$p'"
        else failcase "V: tests.yml has no job named '$p'"; fi
        assert_match "V: job '$p' runs git push" $'\t[1-9][0-9]*$' "$row"
    done < "$TMP/pinned"
    STRAY=$(awk -F'\t' 'NR == FNR { pin[$0] = 1; next } $3 > 0 && !($2 in pin) { print $1 }' \
        "$TMP/pinned" "$TMP/jobs.tsv")
    assert_eq "V: no other tests.yml job runs git push" "" "$STRAY"
    assert_eq "V: every git push sits inside a job block" \
        "$(grep -c 'git push' "$TESTS_YML")" \
        "$(awk -F'\t' '{ s += $3 } END { print s + 0 }' "$TMP/jobs.tsv")"
fi

# H: usage errors exit 2.
run "$WATCH" --interval abc
assert_eq "H: bad --interval exits 2" 2 "$RC"
run "$WATCH" --bogus
assert_eq "H: unknown flag exits 2" 2 "$RC"

h_done
