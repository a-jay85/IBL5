#!/usr/bin/env bash
# bin/test-harness-lib — exercises bin/lib/harness.sh.
#
# It cannot judge the lib with the lib, so it keeps its own t_ok/t_bad
# helpers and T_FAIL counter. Each case writes a scenario script that
# sources the lib, runs it under /bin/bash (bash 3.2 on macOS, 5.x on
# Ubuntu), and checks stdout, stderr, and the exit code.

set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB="$SELF_DIR/lib/harness.sh"
BASH_BIN=/bin/bash

T_FAIL=0
t_ok() { printf 'ok: %s\n' "$1"; }
t_bad() { printf 'FAIL: %s\n' "$1"; T_FAIL=$((T_FAIL + 1)); }

WORK=$(mktemp -d "${TMPDIR:-/tmp}/test-harness-lib.XXXXXX")
trap 'rm -rf "$WORK"' EXIT

OUT=""
ERR=""
RC=0

# run_scenario NAME BODY [ENV...]: writes BODY after the lib-sourcing line,
# runs it, and sets OUT, ERR, RC. Extra args are passed to `env` first.
run_scenario() {
    local name="$1" body="$2" script
    shift 2
    script="$WORK/$name.sh"
    {
        printf '. %q\n' "$LIB"
        printf '%s\n' "$body"
    } >"$script"
    RC=0
    if [ "$#" -gt 0 ]; then
        env "$@" "$BASH_BIN" "$script" >"$WORK/$name.out" 2>"$WORK/$name.err" </dev/null || RC=$?
    else
        "$BASH_BIN" "$script" >"$WORK/$name.out" 2>"$WORK/$name.err" </dev/null || RC=$?
    fi
    OUT=$(cat "$WORK/$name.out")
    ERR=$(cat "$WORK/$name.err")
}

has() { grep -qF -- "$2" <<<"$1"; }

case_pass_summary() {
    run_scenario pass_summary 'h_pass a; h_pass b; h_done' "$@"
    if [ "$RC" -eq 0 ] && has "$OUT" "ok: a" &&
        has "$OUT" "RESULT: all passed (2 assertions)"; then
        t_ok "case_pass_summary"
    else
        t_bad "case_pass_summary (rc=$RC out=[$OUT] err=[$ERR])"
    fi
}

case_fail_exits_nonzero() {
    run_scenario fail_exits 'h_pass a; h_fail b detail; h_done'
    if [ "$RC" -eq 1 ] && has "$OUT" "FAIL: b — detail" &&
        has "$OUT" "RESULT: FAILED (1 of 2 assertions failed)"; then
        t_ok "case_fail_exits_nonzero"
    else
        t_bad "case_fail_exits_nonzero (rc=$RC out=[$OUT])"
    fi
}

case_zero_assertions() {
    run_scenario zero 'h_done'
    if [ "$RC" -eq 1 ] && has "$OUT" "no assertions ran"; then
        t_ok "case_zero_assertions"
    else
        t_bad "case_zero_assertions (rc=$RC out=[$OUT])"
    fi
}

case_legacy_failed() {
    run_scenario legacy 'FAILED=1; h_pass a; h_done'
    if [ "$RC" -eq 1 ] && has "$OUT" "legacy FAILED=1"; then
        t_ok "case_legacy_failed"
    else
        t_bad "case_legacy_failed (rc=$RC out=[$OUT])"
    fi
}

case_errexit_safe() {
    run_scenario errexit 'set -euo pipefail
h_fail x
h_eq e 1 2
h_contains c abc zz
echo reached
h_done'
    if [ "$RC" -eq 1 ] && has "$OUT" "reached" &&
        has "$OUT" "RESULT: FAILED (3 of 3 assertions failed)"; then
        t_ok "case_errexit_safe"
    else
        t_bad "case_errexit_safe (rc=$RC out=[$OUT] err=[$ERR])"
    fi
}

case_eq() {
    run_scenario eq 'h_eq l 1 1; h_eq l 1 2; h_done'
    if [ "$RC" -eq 1 ] && has "$OUT" "ok: l" && has "$OUT" "FAIL: l — want [1] got [2]" &&
        has "$OUT" "RESULT: FAILED (1 of 2 assertions failed)"; then
        t_ok "case_eq"
    else
        t_bad "case_eq (rc=$RC out=[$OUT])"
    fi
}

case_contains_fixed_string() {
    run_scenario contains "h_contains regex abc a.c
h_contains bracket 'x[1]y' '[1]'
h_not_contains negated abc b
h_done"
    if [ "$RC" -eq 1 ] && has "$OUT" "FAIL: regex — missing [a.c]" &&
        has "$OUT" "ok: bracket" && has "$OUT" "FAIL: negated — unexpected [b]" &&
        has "$OUT" "RESULT: FAILED (2 of 3 assertions failed)"; then
        t_ok "case_contains_fixed_string"
    else
        t_bad "case_contains_fixed_string (rc=$RC out=[$OUT])"
    fi
}

case_exists_absent() {
    local f="$WORK/present-file" m="$WORK/missing-path"
    : >"$f"
    run_scenario exists "h_exists e1 $(printf '%q' "$f")
h_exists e2 $(printf '%q' "$m")
h_absent a1 $(printf '%q' "$m")
h_absent a2 $(printf '%q' "$f")
h_done"
    if [ "$RC" -eq 1 ] && has "$OUT" "ok: e1" && has "$OUT" "FAIL: e2 — no such path" &&
        has "$OUT" "ok: a1" && has "$OUT" "FAIL: a2 — path exists" &&
        has "$OUT" "RESULT: FAILED (2 of 4 assertions failed)"; then
        t_ok "case_exists_absent"
    else
        t_bad "case_exists_absent (rc=$RC out=[$OUT])"
    fi
}

case_near_inclusive() {
    run_scenario near 'h_near edge 10 15 5; h_near over 10 16 5; h_done'
    if [ "$RC" -eq 1 ] && has "$OUT" "ok: edge" && has "$OUT" "FAIL: over" &&
        has "$OUT" "RESULT: FAILED (1 of 2 assertions failed)"; then
        t_ok "case_near_inclusive"
    else
        t_bad "case_near_inclusive (rc=$RC out=[$OUT])"
    fi
}

case_tmp_trap_cleans() {
    run_scenario tmp_trap 'h_tmp A; h_tmp B
[ -d "$A" ] && [ -d "$B" ] && [ "$A" != "$B" ] && h_pass both-exist
echo "A=$A"; echo "B=$B"
h_done'
    local a b
    a=$(sed -n 's/^A=//p' <<<"$OUT")
    b=$(sed -n 's/^B=//p' <<<"$OUT")
    if [ "$RC" -eq 0 ] && has "$OUT" "ok: both-exist" && [ -n "$a" ] && [ -n "$b" ] &&
        [ ! -e "$a" ] && [ ! -e "$b" ]; then
        t_ok "case_tmp_trap_cleans"
    else
        t_bad "case_tmp_trap_cleans (rc=$RC out=[$OUT] err=[$ERR])"
    fi
}

case_tmp_respects_existing_trap() {
    local d1 d2
    run_scenario tmp_own_trap "trap 'echo mytrap' EXIT
h_tmp D
echo \"D=\$D\"
h_pass a
h_done"
    d1=$(sed -n 's/^D=//p' <<<"$OUT")
    run_scenario tmp_cleanup_trap 'trap h_cleanup EXIT
h_tmp D
echo "D=$D"
h_pass a
h_done'
    d2=$(sed -n 's/^D=//p' <<<"$OUT")
    if has "$(cat "$WORK/tmp_own_trap.out")" "mytrap" && [ -n "$d1" ] && [ -d "$d1" ] &&
        [ -n "$d2" ] && [ ! -e "$d2" ]; then
        t_ok "case_tmp_respects_existing_trap"
    else
        t_bad "case_tmp_respects_existing_trap (d1=[$d1] d2=[$d2] out=[$OUT])"
    fi
    [ -n "$d1" ] && rm -rf "$d1"
}

case_git_repo_default() {
    run_scenario git_default 'h_tmp T
h_git_repo "$T/r"
echo "branch=$(git -C "$T/r" symbolic-ref --short HEAD)"
echo "count=$(git -C "$T/r" rev-list --count HEAD)"
echo "email=$(git -C "$T/r" config --local user.email)"
echo "gpg=$(git -C "$T/r" config --local commit.gpgsign)"
h_pass a
h_done' "$@"
    if [ "$RC" -eq 0 ] && has "$OUT" "branch=master" && has "$OUT" "count=1" &&
        has "$OUT" "email=harness@example.invalid" && has "$OUT" "gpg=false"; then
        t_ok "case_git_repo_default"
    else
        t_bad "case_git_repo_default (rc=$RC out=[$OUT] err=[$ERR])"
    fi
}

case_git_repo_no_commit() {
    run_scenario git_no_commit 'h_tmp T
h_git_repo "$T/r" --no-commit
if git -C "$T/r" rev-parse --verify -q HEAD >/dev/null; then echo head=yes; else echo head=no; fi
echo "ref=$(git -C "$T/r" symbolic-ref HEAD)"
h_pass a
h_done'
    if [ "$RC" -eq 0 ] && has "$OUT" "head=no" && has "$OUT" "ref=refs/heads/master"; then
        t_ok "case_git_repo_no_commit"
    else
        t_bad "case_git_repo_no_commit (rc=$RC out=[$OUT] err=[$ERR])"
    fi
}

case_git_repo_bare_origin() {
    run_scenario git_bare 'h_tmp T
h_git_repo "$T/r" --bare-origin
echo "bare=$(git -C "$H_ORIGIN" rev-parse --is-bare-repository)"
if [ "$(git -C "$H_ORIGIN" rev-parse master)" = "$(git -C "$T/r" rev-parse HEAD)" ]; then echo same=yes; fi
h_pass a
h_done'
    if [ "$RC" -eq 0 ] && has "$OUT" "bare=true" && has "$OUT" "same=yes"; then
        t_ok "case_git_repo_bare_origin"
    else
        t_bad "case_git_repo_bare_origin (rc=$RC out=[$OUT] err=[$ERR])"
    fi
}

case_git_repo_unknown_flag() {
    run_scenario git_bogus 'h_tmp T
h_git_repo "$T/r" --bogus
echo after
h_pass a
h_done'
    if [ "$RC" -eq 2 ] && has "$ERR" "HARNESS-SETUP: h_git_repo: unknown flag --bogus" &&
        ! has "$OUT" "after"; then
        t_ok "case_git_repo_unknown_flag"
    else
        t_bad "case_git_repo_unknown_flag (rc=$RC out=[$OUT] err=[$ERR])"
    fi
}

case_env_i() {
    local before=$T_FAIL
    case_pass_summary -i PATH=/usr/bin:/bin
    case_git_repo_default -i PATH=/usr/bin:/bin
    if [ "$T_FAIL" -eq "$before" ]; then
        t_ok "case_env_i"
    else
        t_bad "case_env_i"
    fi
}

case_double_source() {
    run_scenario double_source "h_pass a
. $(printf '%q' "$LIB")
echo \"count=\$H_PASS\"
h_done"
    if [ "$RC" -eq 0 ] && has "$OUT" "count=1" &&
        has "$OUT" "RESULT: all passed (1 assertions)"; then
        t_ok "case_double_source"
    else
        t_bad "case_double_source (rc=$RC out=[$OUT])"
    fi
}

case_pass_summary
case_fail_exits_nonzero
case_zero_assertions
case_legacy_failed
case_errexit_safe
case_eq
case_contains_fixed_string
case_exists_absent
case_near_inclusive
case_tmp_trap_cleans
case_tmp_respects_existing_trap
case_git_repo_default
case_git_repo_no_commit
case_git_repo_bare_origin
case_git_repo_unknown_flag
case_env_i
case_double_source

if [ "$T_FAIL" -eq 0 ]; then
    echo "test-harness-lib: all cases passed"
else
    echo "test-harness-lib: $T_FAIL case(s) failed"
fi
[ "$T_FAIL" -eq 0 ]
