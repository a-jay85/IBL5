run_dg --diff "$T/dup-cancel.diff"
h_eq "dup-cancel-then-survivor-legacy-key" "strict-mode@bin/foo#4fd4bd77 " "$(keys_of "$OUT")"

cat > "$T/plan-dup-intended.md" <<'PLAN'
# Plan

## Must preserve

- `bin/foo` keeps every other guard in the file

### Intended removals

- `bin/foo` strict-mode: `set -e` — the script now runs under a strict-mode wrapper

## Critical Files
PLAN
run_dg --diff "$T/dup-two-hunk.diff" --plan "$T/plan-dup-intended.md"
h_eq "dup-intended-suppresses-all: exit 0" 0 "$RC"
h_eq "dup-intended-suppresses-all: no REMOVED-GUARD" 0 "$(count_removed "$OUT")"
h_eq "dup-intended-suppresses-all: two INTENDED" 2 "$(grep -c '^INTENDED' <<< "$OUT" || true)"

# --- corpus-diff helper cases -----------------------------------------------

cc_run() {
    CC_FAIL=0; CC_ADDED=0; CC_CHANGED=0
    corpus_compare "$@" > "$T/cc-out"
    CC_OUT="$(cat "$T/cc-out")"
}
# stub_dg <name> <row-file> <rc>: a fake detector that prints a file and exits.
stub_dg() {
    printf '#!/bin/sh\ncat "%s"\nexit %s\n' "$2" "$3" > "$T/$1"
    chmod +x "$T/$1"
}

cc_run "$DG" "$DG" "$T/dup-two-hunk.diff" same
h_eq "corpus-compare-identical: no failures" 0 "$CC_FAIL"
h_eq "corpus-compare-identical: nothing added" 0 "$CC_ADDED"

run_dg --diff "$T/dup-two-hunk.diff"
grep -F '#4fd4bd77' <<< "$OUT" > "$T/cc-one-row"
stub_dg dg-old-one "$T/cc-one-row" 1
cc_run "$T/dg-old-one" "$DG" "$T/dup-two-hunk.diff" dup
h_eq "corpus-compare-added-duplicate-ok: no failures" 0 "$CC_FAIL"
h_eq "corpus-compare-added-duplicate-ok: one row added" 1 "$CC_ADDED"

sed 's/hexdigest()\[:8\]/hexdigest()[1:9]/' "$DG" > "$T/dg-shifted"
chmod +x "$T/dg-shifted"
cc_run "$DG" "$T/dg-shifted" "$T/dup-two-hunk.diff" shifted
h_contains "corpus-compare-lost-key" "$CC_OUT" "CORPUS-FAIL lost shifted"

: > "$T/cc-empty"
stub_dg dg-exit0 "$T/cc-empty" 0
cc_run "$DG" "$T/dg-exit0" "$T/dup-two-hunk.diff" rc
h_contains "corpus-compare-exit-mismatch" "$CC_OUT" "CORPUS-FAIL exit rc old=1 new=0"

sed 's#bin/foo#bin/zzz#g' "$T/cc-one-row" > "$T/cc-zzz-row"
stub_dg dg-old-zzz "$T/cc-zzz-row" 1
cc_run "$T/dg-old-zzz" "$DG" "$T/dup-two-hunk.diff" other
h_contains "corpus-compare-novel-row" "$CC_OUT" "CORPUS-FAIL novel other"

# --- usage errors -----------------------------------------------------------

for args in "" "--diff" "--bogus" "--plan=$T/plan-intended.md --diff $T/php.diff" \
            "--diff $T/missing.diff" "--diff $T/php.diff --plan $T/missing.md"; do
    # shellcheck disable=SC2086  # word-split the arg list on purpose
    run_dg $args
    h_eq "usage-errors-exit-2: [$args]" 2 "$RC"
    h_contains "usage-errors-exit-2: usage line [$args]" "$ERR" "Usage: bin/lib/deleted-guards"
done

