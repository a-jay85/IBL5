#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/run-meta-checks-local — Run CI's hard-gate meta checks locally before post-plan push.
#
# Derives path filters at runtime by parsing .github/workflows/pr-meta-checks.yml.
# Never copies globs into this script; a drifted copy would fail open silently.
# ---
# Pass cache: five slow self-test steps replay PASS when their declared inputs are
# byte-identical (hashed by `bin/ci-memo key --worktree`). A cached step prints
# `PASS  <name> (cached)`, and a `CACHE hits=<n> misses=<n> on=<0|1> dir=<path>`
# line comes just before the `META-CHECKS:` summary. Only passes are recorded.
#   --no-cache              run every step, record nothing.
#   META_CHECKS_NO_CACHE    unset, empty or 0 keeps the cache on; any other value
#                           bypasses both read and write.
#   META_CHECKS_CACHE_DIR   cache directory, default
#                           ${XDG_CACHE_HOME:-$HOME/.cache}/ibl5-meta-checks
# ---
# The 16 unconditional pre-push hard gates run in parallel (queue_step, then
# run_group_end); their results print in table order. Later steps run one by one.
# ---
# Exit codes:
#   0  all hard gates passed
#   1  one or more hard gates failed
#   2  usage error
#   3  could not parse the workflow filters (fail-closed)

set -uo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
    cat <<'EOF'
Usage: bin/run-meta-checks-local [--base <sha>] [--pr <n>] [--body-file <path>]
                                 [--stage pre-push|post-pr] [--print-filters] [--no-cache]
                                 [--self-test-hook <dir>] [--help|-h]

  --base <sha>            Base commit to diff against. Default: merge-base with origin/master.
  --pr <n>                PR number. Required for --stage post-pr.
  --body-file <p>         Planned PR body for check-pr-manual-testing and check-post-merge-recipe before a PR exists.
  --stage <s>             pre-push (default) or post-pr. Selects which step subset runs.
  --print-filters         Print <filter>=true|false per filter and changed-path count, then exit 0.
  --no-cache              Skip the pass cache: run every step, record nothing.
  --self-test-hook <dir>  Override repo root for workflow YAML and bin/ scripts (test seam).
  --help, -h              Show this message.

Environment:
  META_CHECKS_ADVISORY_TIMEOUT  Seconds before an advisory step is abandoned
                               (default 120). Hard gates are never timed out.
                               Ignored when neither gtimeout nor timeout exists.
  META_CHECKS_NO_CACHE         Anything except empty or 0 acts like --no-cache.
  META_CHECKS_CACHE_DIR        Pass-cache directory (default:
                               ${XDG_CACHE_HOME:-$HOME/.cache}/ibl5-meta-checks).

Exit: 0 all hard gates passed  1 one or more hard gates failed
      2 usage error  3 could not parse workflow filters (fail-closed)
EOF
}

BASE=""
PR=""
BODY_FILE=""
STAGE="pre-push"
PRINT_FILTERS=0
HOOK_ROOT=""
CACHE_ON=1
case "${META_CHECKS_NO_CACHE:-}" in ''|0) ;; *) CACHE_ON=0 ;; esac

while [ $# -gt 0 ]; do
    case "$1" in
        --base)
            if [ $# -lt 2 ]; then echo "Error: --base requires a value" >&2; usage >&2; exit 2; fi
            BASE="$2"; shift 2 ;;
        --pr)
            if [ $# -lt 2 ]; then echo "Error: --pr requires a value" >&2; usage >&2; exit 2; fi
            PR="$2"; shift 2 ;;
        --body-file)
            if [ $# -lt 2 ]; then echo "Error: --body-file requires a path" >&2; usage >&2; exit 2; fi
            BODY_FILE="$2"; shift 2 ;;
        --stage)
            if [ $# -lt 2 ]; then echo "Error: --stage requires a value" >&2; usage >&2; exit 2; fi
            STAGE="$2"; shift 2
            if [ "$STAGE" != "pre-push" ] && [ "$STAGE" != "post-pr" ]; then
                echo "Error: --stage must be pre-push or post-pr" >&2; usage >&2; exit 2
            fi ;;
        --print-filters)
            PRINT_FILTERS=1; shift ;;
        --no-cache)
            CACHE_ON=0; shift ;;
        --self-test-hook)
            if [ $# -lt 2 ]; then echo "Error: --self-test-hook requires a directory" >&2; usage >&2; exit 2; fi
            HOOK_ROOT="$2"; shift 2 ;;
        --help|-h)
            usage; exit 0 ;;
        *)
            echo "Error: unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
done

if [ "$STAGE" = "post-pr" ] && [ -z "$PR" ]; then
    echo "Error: --stage post-pr requires --pr <n>" >&2
    usage >&2
    exit 2
fi

ROOT="${HOOK_ROOT:-$REPO_ROOT}"
WORKFLOW="$ROOT/.github/workflows/pr-meta-checks.yml"

# Base resolution — best-effort fetch so offline runs still work.
if [ -z "$BASE" ]; then
    git -C "$ROOT" fetch --quiet origin master 2>/dev/null || true
    BASE=$(git -C "$ROOT" merge-base origin/master HEAD 2>/dev/null) \
        || BASE=$(git -C "$ROOT" merge-base master HEAD 2>/dev/null) \
        || { echo "run-meta-checks-local: cannot resolve a base commit" >&2; exit 3; }
fi

# Changed-path set: committed range + unstaged + staged (matches bin/check-docs --since).
CHANGED=$(
    { git -C "$ROOT" diff --name-only --diff-filter=ACMRT "$BASE"...HEAD
      git -C "$ROOT" diff --name-only --diff-filter=ACMRT HEAD
      git -C "$ROOT" diff --name-only --diff-filter=ACMRT --cached
    } | sort -u
)
CHANGED_COUNT=$(printf '%s\n' "$CHANGED" | { grep -c . || true; } 2>/dev/null)

# ─── Runtime filter parser ────────────────────────────────────────────────────
# Parses the filters: | block from the workflow YAML at runtime (single source).
# Outputs one <filter><TAB><matched> line per filter name, where matched is
# "true" or "false". Exits 3 on any parse failure (fail-closed).
# Rejects !-negation and {brace} expansion with exit 3 rather than mis-translating.
# Takes two args: workflow_path and changed_paths_file.
_parse_and_match_filters() {
    python3 - "$WORKFLOW" "$1" <<'PYEOF'
import sys, re

workflow_path = sys.argv[1]
changed_file  = sys.argv[2]
try:
    text = open(workflow_path).read()
except Exception as e:
    print(f"run-meta-checks-local: cannot read {workflow_path}: {e}", file=sys.stderr)
    sys.exit(3)

lines = text.splitlines()

# Locate "filters: |" line and record its indentation level.
filters_idx = None
filters_indent = None
for i, line in enumerate(lines):
    m = re.match(r'^(\s*)filters:\s*\|\s*$', line)
    if m:
        filters_idx = i
        filters_indent = len(m.group(1))
        break

if filters_idx is None:
    print("run-meta-checks-local: cannot parse filters block in .github/workflows/pr-meta-checks.yml",
          file=sys.stderr)
    sys.exit(3)

# Consume following lines while blank or indented more than filters_indent.
block_lines = []
for line in lines[filters_idx + 1:]:
    if line == '' or line.strip() == '':
        block_lines.append(line)
        continue
    indent = len(line) - len(line.lstrip())
    if indent > filters_indent:
        block_lines.append(line)
    else:
        break

non_blank = [l for l in block_lines if l.strip()]
if not non_blank:
    print("run-meta-checks-local: cannot parse filters block in .github/workflows/pr-meta-checks.yml",
          file=sys.stderr)
    sys.exit(3)

# Strip the common leading indent from the block.
min_indent = min(len(l) - len(l.lstrip()) for l in non_blank)
normalized = [l[min_indent:] if l.strip() else '' for l in block_lines]

# Parse filter keys and glob lists.
# A line starting with # is a comment (skip). Everything else must match a
# key line or a glob line; anything else is a parse anomaly and exits 3.
filters = {}
current = None
for line in normalized:
    if not line.strip():
        continue
    if line.lstrip().startswith('#'):
        continue
    m_key = re.match(r'^(\w[\w-]*):\s*$', line)
    if m_key:
        current = m_key.group(1)
        filters[current] = []
        continue
    m_glob = re.match(r"""^\s*-\s*(?:'([^']*)'|"([^"]*)"|(\S+))\s*$""", line)
    if m_glob:
        if current is None:
            print("run-meta-checks-local: cannot parse filters block in .github/workflows/pr-meta-checks.yml",
                  file=sys.stderr)
            sys.exit(3)
        glob = m_glob.group(1) or m_glob.group(2) or m_glob.group(3)
        # Reject unsupported glob features so drift is loud, not silent.
        if glob.startswith('!') or '{' in glob:
            print(f"run-meta-checks-local: unsupported glob pattern '{glob}' in filters block",
                  file=sys.stderr)
            sys.exit(3)
        filters[current].append(glob)
        continue
    # Unrecognised line — parse anomaly.
    print("run-meta-checks-local: cannot parse filters block in .github/workflows/pr-meta-checks.yml",
          file=sys.stderr)
    sys.exit(3)

if not filters:
    print("run-meta-checks-local: cannot parse filters block in .github/workflows/pr-meta-checks.yml",
          file=sys.stderr)
    sys.exit(3)

# Translate picomatch globs to Python regexes.
# ** crosses directory separators; * does not; ?  matches one non-slash char.
def to_regex(glob):
    out, i = [], 0
    while i < len(glob):
        if glob.startswith('**/', i):
            out.append('(?:.*/)?'); i += 3
        elif glob.startswith('**', i):
            out.append('.*'); i += 2
        elif glob[i] == '*':
            out.append('[^/]*'); i += 1
        elif glob[i] == '?':
            out.append('[^/]'); i += 1
        else:
            out.append(re.escape(glob[i])); i += 1
    return re.compile('^' + ''.join(out) + '$')

with open(changed_file) as cf:
    changed_paths = [l for l in cf.read().splitlines() if l]

for fname, globs in filters.items():
    patterns = [to_regex(g) for g in globs]
    matched = any(any(p.match(path) for p in patterns) for path in changed_paths)
    print(f"{fname}\t{'true' if matched else 'false'}")
PYEOF
}

# Run the parser, writing changed paths to a temp file so the heredoc does not
# steal stdin from the python3 invocation inside the function.
_CHANGED_FILE=$(mktemp)
printf '%s\n' "$CHANGED" > "$_CHANGED_FILE"
FILTER_OUTPUT=$(_parse_and_match_filters "$_CHANGED_FILE")
FILTER_RC=$?
rm -f "$_CHANGED_FILE"
if [ "$FILTER_RC" -ne 0 ]; then
    exit 3
fi

# Filter names may contain characters that are invalid in a shell identifier
# (the filters-block key grammar admits hyphens), so both the setter and the
# getter map a name through the same sanitizer before touching FMAP_*.
_fkey() { printf '%s' "$1" | tr -c '[:alnum:]' '_'; }

# Build per-filter verdict map (bash 3.2 compatible; no declare -A).
# Sets FMAP_<sanitized-name>=true|false for each filter name.
while IFS=$'\t' read -r _fname _fval; do
    _fk=$(_fkey "$_fname")
    eval "FMAP_${_fk}=${_fval}"
done <<< "$FILTER_OUTPUT"

_fmap() { local _k; _k=$(_fkey "$1"); eval "printf '%s' \"\${FMAP_${_k}:-false}\""; }

# ─── --print-filters diagnostic mode ─────────────────────────────────────────
if [ "$PRINT_FILTERS" = 1 ]; then
    while IFS=$'\t' read -r fname fval; do
        printf '%s=%s\n' "$fname" "$fval"
    done <<< "$FILTER_OUTPUT"
    printf 'changed-paths=%s\n' "$CHANGED_COUNT"
    exit 0
fi

# ─── Advisory step timeout ────────────────────────────────────────────────────
# An advisory check is non-blocking by contract, so one that hangs must not hold
# the whole run hostage -- a stalled advisory step is a worse outcome than a
# missing advisory opinion. Hard gates are deliberately left unguarded: silently
# converting a hard gate into a timeout would be a gate weakening.
#
# macOS ships neither `timeout` nor `gtimeout` by default. When neither resolves,
# advisory steps run unguarded, exactly as they did before this wrapper existed.
# META_CHECKS_TIMEOUT_BIN is a test seam -- setting it to the empty string forces
# the unresolved path (note `-` not `:-`, so an explicit empty value wins).
TIMEOUT_BIN="${META_CHECKS_TIMEOUT_BIN-$(command -v gtimeout || command -v timeout || true)}"
ADVISORY_TIMEOUT="${META_CHECKS_ADVISORY_TIMEOUT:-120}"

# ─── Pass cache ───────────────────────────────────────────────────────────────
# A cached step replays PASS for byte-identical inputs. One dir is shared by
# every worktree on purpose: keys are content hashes, so equal content gives an
# equal verdict. It sits outside every git tree, so a run never dirties one.
CACHE_DIR="${META_CHECKS_CACHE_DIR:-${XDG_CACHE_HOME:-${HOME:-/nonexistent}/.cache}/ibl5-meta-checks}"
CACHE_HITS=0
CACHE_MISSES=0
META_PY_VER=""
if [ "$CACHE_ON" = 1 ] && ! mkdir -p "$CACHE_DIR" 2>/dev/null; then
    CACHE_ON=0
    printf 'CACHE disabled (cannot create %s)\n' "$CACHE_DIR"
fi
if [ "$CACHE_ON" = 1 ]; then
    META_PY_VER="$(python3 -c 'import sys; print(sys.version.split()[0])' 2>/dev/null || echo none)"
    find "$CACHE_DIR" -type f -name '*.pass' -mtime +30 -exec rm -f {} + 2>/dev/null || true
fi

# ─── Step execution ───────────────────────────────────────────────────────────
FAILED=""
WARNED=""
DEFERRED=""
SKIP_COUNT=0
HARD_RUN=0

# cache_key <name> <cmd...>: prints ci-memo's hash=/key= lines for a cached
# step, or nothing for an uncached one (no META_INPUTS_<name> declaration) or
# when ci-memo degrades. argv0 shrinks to its basename so absolute worktree
# paths stay out of the key and sibling worktrees share hits.
cache_key() {
    local name="$1" var paths p
    shift
    var="META_INPUTS_$(printf '%s' "$name" | tr '-' '_')"
    paths="${!var:-}"
    [ -n "$paths" ] || return 0
    paths="$paths bin/run-meta-checks-local"
    set -- "$(basename "$1")" "${@:2}"
    local args=()
    for p in $paths; do args+=(--path "$p"); done
    GITHUB_OUTPUT='' CI_MEMO_REPO="$ROOT" "$ROOT/bin/ci-memo" key "meta-$name" --worktree "${args[@]}" \
        --extra "cmd=$*" --extra "py=$META_PY_VER" --fail-open 2>/dev/null
}

# exec_step <outfile> <name> <cmd...>: runs one step, output to <outfile>.
# Returns the step's exit code. Writes <outfile>.cacheable for a cacheable step
# and <outfile>.cached when the pass came from the cache. Touches no counters.
exec_step() {
    local outf="$1" name="$2" memo h1 k1 k2 rc
    shift 2
    k1=""
    if [ "$CACHE_ON" = 1 ]; then
        memo="$(cache_key "$name" "$@")"
        h1="$(printf '%s\n' "$memo" | sed -n 's/^hash=//p')"
        k1="$(printf '%s\n' "$memo" | sed -n 's/^key=//p' | tr -c 'A-Za-z0-9._\n-' '_')"
        [ -n "$k1" ] && : > "$outf.cacheable"
        if [ -n "$k1" ] && [ -f "$CACHE_DIR/$k1.pass" ]; then
            printf 'cached pass, key %s\n' "$k1" > "$outf"
            : > "$outf.cached"
            return 0
        fi
    fi
    "$@" > "$outf" 2>&1 && rc=0 || rc=$?
    if [ "$rc" -eq 0 ] && [ -n "$k1" ]; then
        # Record only when the inputs are unchanged since before the run, so a
        # step that edited its own input never stores a pass for content it
        # never saw. A failed record is non-fatal: the step result stands.
        k2="$(cache_key "$name" "$@" | sed -n 's/^key=//p' | tr -c 'A-Za-z0-9._\n-' '_')"
        if [ "$k1" = "$k2" ]; then
            "$ROOT/bin/ci-memo" record "meta-$name" "$h1" "$CACHE_DIR/$k1.pass" >/dev/null 2>&1 || true
        fi
    fi
    return "$rc"
}

# report_step <name> <gate> <rc> <outfile>: prints the step line and accumulates
# FAILED, WARNED, HARD_RUN and the cache counters. Always returns 0. Never set -e here.
report_step() {
    local name="$1" gate="$2" rc="$3" outf="$4" out
    out="$(cat "$outf")"
    if [ -e "$outf.cached" ]; then
        CACHE_HITS=$((CACHE_HITS + 1))
    elif [ -e "$outf.cacheable" ]; then
        CACHE_MISSES=$((CACHE_MISSES + 1))
    fi
    if [ "$rc" -eq 0 ]; then
        if [ -e "$outf.cached" ]; then
            printf 'PASS  %s (cached)\n' "$name"
        else
            printf 'PASS  %s\n' "$name"
        fi
        [ "$gate" = "hard" ] && HARD_RUN=$((HARD_RUN + 1))
        return 0
    fi
    if [ "$gate" = "advisory" ]; then
        # 124 is timeout(1)'s exit code for "the command hit the deadline";
        # 137 is 128+SIGKILL, what -k reports when TERM was ignored.
        # Distinguished from a real advisory failure because an empty WARN body
        # otherwise reads as a check that ran and simply printed nothing.
        if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
            printf 'WARN  %s (advisory, not blocking) -- timed out after %ss\n' \
                "$name" "$ADVISORY_TIMEOUT"
        else
            printf 'WARN  %s (advisory, not blocking)\n' "$name"
        fi
        printf '%s\n' "$out" | tail -40
        WARNED="$WARNED $name"
        return 0
    fi
    printf 'FAIL  %s\n' "$name"
    printf '%s\n' "$out" | tail -60
    FAILED="$FAILED $name"
    HARD_RUN=$((HARD_RUN + 1))
    return 0
}

# run_step: always returns 0; runs exec_step then report_step. Never set -e here.
run_step() {
    local name="$1" gate="$2" outf rc
    shift 2
    outf="$(mktemp "${TMPDIR:-/tmp}/meta-step.XXXXXX")"
    if [ "$gate" = "advisory" ] && [ -n "$TIMEOUT_BIN" ]; then
        # -k: SIGKILL 10s after the SIGTERM, so a check that traps or ignores
        # TERM still cannot hold the run.
        exec_step "$outf" "$name" "$TIMEOUT_BIN" -k 10 "$ADVISORY_TIMEOUT" "$@"
    else
        exec_step "$outf" "$name" "$@"
    fi
    rc=$?
    report_step "$name" "$gate" "$rc" "$outf"
    rm -f "$outf" "$outf.cacheable" "$outf.cached"
    return 0
}

# run_filtered_step: skips when filter is false; otherwise delegates to run_step.
run_filtered_step() {
    local name="$1" gate="$2" filter="$3"; shift 3
    if [ "$(_fmap "$filter")" = "false" ]; then
        printf 'SKIP  %s (filter %s=false)\n' "$name" "$filter"
        SKIP_COUNT=$((SKIP_COUNT + 1))
        return 0
    fi
    run_step "$name" "$gate" "$@"
}

BIN="$ROOT/bin"

# run_pr_bypass_gate <name> <filter-key> <hard|advisory> <defer-without-pr: 1|0> <cmd...>
# Rows 14-15: the PR-body-bypass gates (adr-check, refactor-flag).
run_pr_bypass_gate() {
    local name="$1" key="$2" severity="$3" defer="$4"
    shift 4
    if [ "$(_fmap "$key")" != "true" ]; then
        printf 'SKIP  %s (filter %s=false)\n' "$name" "$key"
        SKIP_COUNT=$((SKIP_COUNT + 1))
        return 0
    fi
    if [ "$defer" = "1" ] && [ -z "$PR" ]; then
        printf 'DEFER %s (deferred to post-pr for PR bypass check)\n' "$name"
        DEFERRED="$DEFERRED $name"
        return 0
    fi
    run_step "$name" "$severity" "$@"
}

# queue_step starts one step in the background; run_group_end waits for all of
# them and reports in queue order, so output stays grouped and the step order
# matches the table. bash 3.2: indexed arrays and plain wait only.
GRP_N=0
GRP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/meta-checks.XXXXXX")"
trap 'rm -rf "$GRP_DIR"' EXIT
GRP_NAMES=()
GRP_SEV=()
GRP_PIDS=()
queue_step() {  # queue_step <name> <hard|advisory> <cmd...>
    local name="$1" sev="$2"
    shift 2
    GRP_NAMES[$GRP_N]="$name"
    GRP_SEV[$GRP_N]="$sev"
    (
        export GIT_OPTIONAL_LOCKS=0
        exec_step "$GRP_DIR/$GRP_N.out" "$name" "$@" && rc=0 || rc=$?
        printf '%s\n' "$rc" > "$GRP_DIR/$GRP_N.rc"
    ) &
    GRP_PIDS[$GRP_N]=$!
    GRP_N=$((GRP_N + 1))
}
# A missing .rc file counts as rc 1 (fail closed).
run_group_end() {
    local i=0 rc
    while [ "$i" -lt "$GRP_N" ]; do
        wait "${GRP_PIDS[$i]}" 2>/dev/null || true
        rc="$(cat "$GRP_DIR/$i.rc" 2>/dev/null || echo 1)"
        report_step "${GRP_NAMES[$i]}" "${GRP_SEV[$i]}" "$rc" "$GRP_DIR/$i.out"
        rm -f "$GRP_DIR/$i.out" "$GRP_DIR/$i.out.cacheable" "$GRP_DIR/$i.out.cached"
        i=$((i + 1))
    done
    GRP_N=0
}

# ─── Cached-step inputs (one line per cached step) ───────────────────────────
# Repo-relative pathspecs hashed by `bin/ci-memo key --worktree`. cache_key()
# appends bin/run-meta-checks-local to every set. Over-including is safe (it
# only lowers the hit rate); a missing input can replay a stale pass.
META_INPUTS_test_check_model_pins="bin/test-check-model-pins bin/check-model-pins bin/lib/current-models bin/lib/model-pins-allowlist bin/lib/harness.sh bin/lib/usage-test-isolation.sh"
META_INPUTS_test_check_engine_freeze="bin/test-check-engine-freeze bin/check-engine-freeze"
META_INPUTS_test_check_pipefail_grep_q="bin/test-check-pipefail-grep-q bin/check-pipefail-grep-q"
META_INPUTS_test_check_reviewer_eval="bin/test-check-reviewer-eval bin/check-reviewer-eval bin/reviewer-eval bin/lib/harness.sh bin/lib/usage-test-isolation.sh bin/lib/branch-base.sh tools/postplan-harness/harness tools/postplan-harness/fixtures/reviewer-eval .claude/review-shared"
META_INPUTS_reviewer_eval_validate="bin/reviewer-eval bin/lib/branch-base.sh tools/postplan-harness/harness tools/postplan-harness/fixtures/reviewer-eval .claude/review-shared"

# ─── Pre-push step table ──────────────────────────────────────────────────────
if [ "$STAGE" = "pre-push" ]; then
    # Unconditional hard gates (rows 1-6)
    queue_step "check-docs-self-test"          hard "$BIN/check-docs" --self-test
    queue_step "check-docs-no-staleness"       hard "$BIN/check-docs" --no-staleness
    queue_step "check-docs-since"              hard "$BIN/check-docs" "--since=$BASE"
    queue_step "check-prose-self-test"         hard "$BIN/check-prose" --self-test
    queue_step "check-prose-since"             hard "$BIN/check-prose" "--since=$BASE"
    queue_step "check-registry-trigger-rows"   hard "$BIN/check-registry-trigger-rows"
    queue_step "check-model-pins"              hard "$BIN/check-model-pins"
    queue_step "test-check-model-pins"         hard "$BIN/test-check-model-pins"
    queue_step "test-check-engine-freeze"      hard "$BIN/test-check-engine-freeze"
    queue_step "check-engine-freeze"           hard "$BIN/check-engine-freeze" "--since=$BASE"
    queue_step "test-check-pipefail-grep-q"    hard "$BIN/test-check-pipefail-grep-q"
    queue_step "check-pipefail-grep-q"         hard "$BIN/check-pipefail-grep-q" "--since=$BASE"
    queue_step "test-check-shell-portability"  hard "$BIN/test-check-shell-portability"
    queue_step "check-shell-portability"       hard "$BIN/check-shell-portability"
    queue_step "test-check-reviewer-eval"     hard "$BIN/test-check-reviewer-eval"
    queue_step "reviewer-eval-validate"        hard "$BIN/reviewer-eval" validate
    run_group_end
    run_step "test-text-hold-recheck"        hard "$BIN/test-text-hold-recheck"

    # Row 7: pre-push form of manual-testing check
    if [ -n "$BODY_FILE" ]; then
        run_step "check-pr-manual-testing" hard "$BIN/check-pr-manual-testing" --body-file "$BODY_FILE"
    else
        printf 'SKIP  check-pr-manual-testing (no --body-file)\n'
        SKIP_COUNT=$((SKIP_COUNT + 1))
    fi

    # Row 7b: pre-push form of the post-merge recipe check
    if [ -n "$BODY_FILE" ]; then
        run_step "check-post-merge-recipe" hard "$BIN/check-post-merge-recipe" --body-file "$BODY_FILE"
    else
        printf 'SKIP  check-post-merge-recipe (no --body-file)\n'
        SKIP_COUNT=$((SKIP_COUNT + 1))
    fi

    # Row 7c: pre-push form of the reviewer-eval before/after claim check
    if [ -n "$BODY_FILE" ]; then
        run_step "check-reviewer-eval" hard "$BIN/check-reviewer-eval" --body-file "$BODY_FILE" --base "$BASE"
    else
        printf 'SKIP  check-reviewer-eval (no --body-file)\n'
        SKIP_COUNT=$((SKIP_COUNT + 1))
    fi

    # Filtered hard gates (rows 8-11)
    run_filtered_step "check-numbering"            hard "numbering" "$BIN/check-numbering" "--since=$BASE"
    run_filtered_step "check-e2e-hygiene"          hard "e2ehygiene" "$BIN/check-e2e-hygiene" --pr
    run_filtered_step "check-e2e-fa-offers-owner"  hard "e2ehygiene" "$BIN/check-e2e-fa-offers-owner"
    run_filtered_step "check-e2e-mutator-isolation" hard "e2ehygiene" "$BIN/check-e2e-mutator-isolation"

    # Advisory path-gated (rows 12-13)
    run_filtered_step "check-hot-files"  advisory "hotfiles" "$BIN/check-hot-files" --pr
    run_filtered_step "check-orphan-css" advisory "orphancss" "$BIN/check-orphan-css"

    # Rows 14-15: advisory pre-push (hard post-pr); deferred when no PR number.
    run_pr_bypass_gate "adr-check"     adr      advisory 1 "$BIN/adr-check" --pr "--base=$BASE"
    run_pr_bypass_gate "refactor-flag" refactor advisory 1 "$BIN/refactor-flag" --pr
fi

# ─── Post-pr step table ───────────────────────────────────────────────────────
if [ "$STAGE" = "post-pr" ]; then
    # Row 16: live PR body check (hard)
    run_step "check-pr-manual-testing" hard "$BIN/check-pr-manual-testing" --pr "$PR"

    # Row 16b: live PR body post-merge recipe check (hard)
    run_step "check-post-merge-recipe" hard "$BIN/check-post-merge-recipe" --pr "$PR"

    # Row 16c: live PR body reviewer-eval claim check (hard)
    run_step "check-reviewer-eval" hard "$BIN/check-reviewer-eval" --pr "$PR" --base "$BASE"

    # Row 17: advisory collision check
    run_filtered_step "check-pr-collisions" advisory "prcollisions" "$BIN/check-pr-collisions" --pr "$PR"

    # Rows 14-15: hard in post-pr stage
    run_pr_bypass_gate "adr-check"     adr      hard 0 "$BIN/adr-check" --pr "--base=$BASE"
    run_pr_bypass_gate "refactor-flag" refactor hard 0 "$BIN/refactor-flag" --pr

    # Write state file for the Phase 6.5 arming condition to read.
    printf '%s\n' "${FAILED:+FAILED:${FAILED# }}" > "/tmp/ibl5-meta-checks-${PR}.status"
fi

# ─── Summary ─────────────────────────────────────────────────────────────────
for name in $FAILED; do
    printf 'META-CHECK-FAILED: %s\n' "$name"
done
for name in $DEFERRED; do
    printf 'META-CHECK-DEFERRED: %s\n' "$name"
done

FAILED_COUNT=$(echo $FAILED | wc -w | tr -d ' ')
WARNED_COUNT=$(echo $WARNED | wc -w | tr -d ' ')
DEFER_COUNT=$(echo $DEFERRED | wc -w | tr -d ' ')

STATUS="OK"
RC=0
if [ -n "$FAILED" ]; then STATUS="FAILED"; RC=1; fi

printf 'CACHE hits=%s misses=%s on=%s dir=%s\n' \
    "$CACHE_HITS" "$CACHE_MISSES" "$CACHE_ON" "$CACHE_DIR"
printf 'META-CHECKS: %s stage=%s hard=%s failed=%s warn=%s skip=%s defer=%s\n' \
    "$STATUS" "$STAGE" "$HARD_RUN" "$FAILED_COUNT" "$WARNED_COUNT" "$SKIP_COUNT" "$DEFER_COUNT"

exit $RC
