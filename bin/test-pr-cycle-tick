set_result "112\tfired\tdeclined\tholdrepeat"
run_tick
run_tick
[[ "$(cat "$STATE_DIR/declined/112" 2>/dev/null)" == "$K1" ]] \
    || fail "declined-survives-rebase: declined/112 is '$(cat "$STATE_DIR/declined/112" 2>/dev/null)', want the key"
[[ "$(dm_count)" == "1" ]] || fail "declined-survives-rebase: want 1 decline DM, got $(dm_count)"
set_prs '112|b12|fff6666|BLOCKED|false'; set_checks fff6666 red
run_tick
[[ "$(launch_count)" == "1" ]] || fail "declined-survives-rebase: relaunched a declined PR after a rebase"
