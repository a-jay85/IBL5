    > "$FIX/checks-$(printf '%040d' 81).json"
status_json success > "$FIX/status-$(printf '%040d' 81).json"
pr_json 81 BLOCKED "$BODY_CLEAR" | jq -s . > "$FIX/prs.json"
run_triage "$FIX" --arm
assert_match  "S9 green status + red check-run = failing" '^failing$' "$(row_col "$OUT" 81 ALLCHECKS)"
assert_match  "S9 bucket=BLOCKED-CHECK"         '^BLOCKED-CHECK$' "$(row_bucket "$OUT" 81)"
assert_absent "S9 never arms"                   'pr merge'        "$(cat "$FIX/calls.log")"
assert_status "S9 exit 0"                       0                 "$ST"

# --- S10: the reverse direction, check-run success + status failure -> failing ---
FIX="$(mktemp -d -p "$TMP")"
protection_json "${PROT_REQ[@]}" > "$FIX/protection.json"
checks_json success success success | jq '.check_runs += [{name:"All checks settled",status:"completed",conclusion:"success",completed_at:"2026-09-25T00:00:00Z",details_url:"https://github.com/a-jay85/IBL5-test/actions/runs/9"}]' \
    > "$FIX/checks-$(printf '%040d' 82).json"
