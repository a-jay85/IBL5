#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-headless-elapsed-hook — regression tests for
# bin/lib/headless-elapsed-hook.sh and its wiring in settings.json and
# bin/automouse/run.
#
# Run: bin/test-headless-elapsed-hook  (exit 0 = all pass, 1 = a case failed)

set -u
# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
HOOK="$SCRIPT_DIR/lib/headless-elapsed-hook.sh"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
ok()        { h_pass "$1"; }
fail()      { h_fail "$@"; }
assert_eq() { h_eq "$1" "$3" "$2"; }
want()      { h_contains "$1" "$2" "$3"; }
want_absent(){ h_not_contains "$1" "$2" "$3"; }

if [ ! -f "$HOOK" ]; then
    echo "FAIL: cannot find $HOOK"
    exit 1
fi

# ── C1: no env → empty output, exit 0 ────────────────────────────────────────
echo ""
echo "# C1: no env vars → empty output, exit 0"
C1_OUT=$(IBL5_BUDGET_START_EPOCH="" IBL5_BUDGET_SECS="" \
    unset IBL5_BUDGET_START_EPOCH IBL5_BUDGET_SECS 2>/dev/null; \
    env -i IBL5_USAGE_GATE_STATE_DIR="$IBL5_USAGE_GATE_STATE_DIR" IBL5_USAGE_CLAUDE_PROJECTS="$IBL5_USAGE_CLAUDE_PROJECTS" IBL5_USAGE_GATE_TEST_MODE="$IBL5_USAGE_GATE_TEST_MODE" HOME="$HOME" PATH="$PATH" \
    bash "$HOOK" < /dev/null 2>/dev/null)
C1_RC=$?
assert_eq "C1: exit 0"        "$C1_RC" "0"
assert_eq "C1: empty output"  "$C1_OUT" ""

# ── C2: non-numeric env → empty output, exit 0 ───────────────────────────────
echo ""
echo "# C2: non-numeric env vars → empty output, exit 0"
C2_OUT=$(env -i IBL5_USAGE_GATE_STATE_DIR="$IBL5_USAGE_GATE_STATE_DIR" IBL5_USAGE_CLAUDE_PROJECTS="$IBL5_USAGE_CLAUDE_PROJECTS" IBL5_USAGE_GATE_TEST_MODE="$IBL5_USAGE_GATE_TEST_MODE" HOME="$HOME" PATH="$PATH" \
    IBL5_BUDGET_START_EPOCH="notanumber" \
    IBL5_BUDGET_SECS="1000" \
    bash "$HOOK" < /dev/null 2>/dev/null)
C2_RC=$?
assert_eq "C2: exit 0"        "$C2_RC" "0"
assert_eq "C2: empty output"  "$C2_OUT" ""

C2B_OUT=$(env -i IBL5_USAGE_GATE_STATE_DIR="$IBL5_USAGE_GATE_STATE_DIR" IBL5_USAGE_CLAUDE_PROJECTS="$IBL5_USAGE_CLAUDE_PROJECTS" IBL5_USAGE_GATE_TEST_MODE="$IBL5_USAGE_GATE_TEST_MODE" HOME="$HOME" PATH="$PATH" \
    IBL5_BUDGET_START_EPOCH="$(date +%s)" \
    IBL5_BUDGET_SECS="notanumber" \
    bash "$HOOK" < /dev/null 2>/dev/null)
C2B_RC=$?
assert_eq "C2b: exit 0"        "$C2B_RC" "0"
assert_eq "C2b: empty output"  "$C2B_OUT" ""

# ── C3: start=now-100, budget=1000 → elapsed ~100s / 1000s, valid JSON ───────
echo ""
echo "# C3: start=now-100, budget=1000 → elapsed ~100s, valid JSON, PostToolUse"
NOW=$(date +%s)
START_C3=$(( NOW - 100 ))
C3_OUT=$(env -i IBL5_USAGE_GATE_STATE_DIR="$IBL5_USAGE_GATE_STATE_DIR" IBL5_USAGE_CLAUDE_PROJECTS="$IBL5_USAGE_CLAUDE_PROJECTS" IBL5_USAGE_GATE_TEST_MODE="$IBL5_USAGE_GATE_TEST_MODE" HOME="$HOME" PATH="$PATH" \
    IBL5_BUDGET_START_EPOCH="$START_C3" \
    IBL5_BUDGET_SECS="1000" \
    bash "$HOOK" < /dev/null 2>/dev/null)
C3_RC=$?
assert_eq "C3: exit 0" "$C3_RC" "0"
# Validate JSON
if echo "$C3_OUT" | jq . > /dev/null 2>&1; then
    ok "C3: valid JSON"
else
    fail "C3: invalid JSON — got [$C3_OUT]"
fi
# hookEventName must be PostToolUse
C3_EVENT=$(echo "$C3_OUT" | jq -r '.hookSpecificOutput.hookEventName' 2>/dev/null)
assert_eq "C3: hookEventName=PostToolUse" "$C3_EVENT" "PostToolUse"
# Context must start with "elapsed 1" (±1s around 100s)
C3_CTX=$(echo "$C3_OUT" | jq -r '.hookSpecificOutput.additionalContext' 2>/dev/null)
case "$C3_CTX" in
    elapsed\ 9[0-9]s\ /\ 1000s|elapsed\ 10[0-1]s\ /\ 1000s)
        ok "C3: context matches elapsed ~100s / 1000s" ;;
    *)
        fail "C3: context mismatch — got [$C3_CTX]" ;;
esac
want_absent "C3: no 90% warning" "$C3_CTX" "past 90%"

# ── C4: start=now-950, budget=1000 → contains "past 90%" ─────────────────────
echo ""
echo "# C4: start=now-950, budget=1000 → past 90% warning"
NOW=$(date +%s)
START_C4=$(( NOW - 950 ))
C4_OUT=$(env -i IBL5_USAGE_GATE_STATE_DIR="$IBL5_USAGE_GATE_STATE_DIR" IBL5_USAGE_CLAUDE_PROJECTS="$IBL5_USAGE_CLAUDE_PROJECTS" IBL5_USAGE_GATE_TEST_MODE="$IBL5_USAGE_GATE_TEST_MODE" HOME="$HOME" PATH="$PATH" \
    IBL5_BUDGET_START_EPOCH="$START_C4" \
    IBL5_BUDGET_SECS="1000" \
    bash "$HOOK" < /dev/null 2>/dev/null)
C4_RC=$?
assert_eq "C4: exit 0" "$C4_RC" "0"
C4_CTX=$(echo "$C4_OUT" | jq -r '.hookSpecificOutput.additionalContext' 2>/dev/null)
want "C4: context contains 'past 90%'" "$C4_CTX" "past 90%"

# ── C5: settings.json contains exactly one PostToolUse entry for the hook ────
echo ""
echo "# C5: settings.json wires headless-elapsed-hook.sh"
SETTINGS="$REPO_ROOT/.claude/settings.json"
if [ ! -f "$SETTINGS" ]; then
    fail "C5: $SETTINGS not found"
else
    C5_COUNT=$(jq '[.hooks.PostToolUse[]?.hooks[]?.command // empty
                    | select(contains("headless-elapsed-hook.sh"))] | length' \
               "$SETTINGS" 2>/dev/null)
    assert_eq "C5: exactly one PostToolUse command for headless-elapsed-hook.sh" \
              "$C5_COUNT" "1"
fi

# ── C6: bin/automouse/run exports IBL5_BUDGET_SECS="$REMAINING_SECS" ─────────
echo ""
echo "# C6: bin/automouse/run has IBL5_BUDGET_SECS"
RUNNER="$SCRIPT_DIR/automouse/run"
if [ ! -f "$RUNNER" ]; then
    fail "C6: $RUNNER not found"
else
    if grep -qF 'IBL5_BUDGET_SECS="$REMAINING_SECS"' "$RUNNER"; then
        ok 'C6: IBL5_BUDGET_SECS="$REMAINING_SECS" present in bin/automouse/run'
    else
        fail 'C6: IBL5_BUDGET_SECS="$REMAINING_SECS" missing from bin/automouse/run'
    fi
fi

h_done
