parameters:
	ignoreErrors:
		-
			rawMessage: 'PHPDoc tag @param references unknown parameter: $extra'
			identifier: parameter.notFound
			count: 1
			path: tests/DatabaseIntegration/TeamServicePageDataCharacterizationTest.php

		-
			rawMessage: 'Parameter #1 $plrRow of method Player\PlayerDataMapper::fillFromCurrentRow() expects array{pid: int, name: string, nickname: string|null, age: int|null, teamid: int, teamname: string|null, pos: string, stamina: int|null, ..., ...<string, mixed>}, array{pid: int, name: string, nickname: string|null, age: int|null, teamid: int, teamname: string|null, pos: string, stamina: int|null, ..., ...<string, mixed>} given.'
			identifier: argument.type
			count: 1
			path: tests/Player/PlayerDataMapperFieldMapTest.php

		-
			rawMessage: 'Dynamic call to static method PHPUnit\Framework\TestCase::createStub().'
			identifier: staticMethod.dynamicCall
			count: 2
			path: tests/UI/DebugOutputTest.php

