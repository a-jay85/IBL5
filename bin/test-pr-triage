# --- S9: same name from BOTH sources, status success + check-run failure -> failing
# (a green status must never mask a red check-run) ---
FIX="$(mktemp -d -p "$TMP")"
protection_json "${PROT_REQ[@]}" > "$FIX/protection.json"
