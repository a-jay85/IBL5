    tree_hook bin/burndown-loop 'if then'
    run_tree_loop run
    assert_eq reexec_syntax:rc 0 "$RC"
    assert_eq reexec_syntax:logged-once 1 "$(printf '%s\n' "$OUT" | grep -c 're-exec skipped: new code fails syntax check')"
    assert_not_contains reexec_syntax:no-exec "$OUT" "code changed"
    assert_contains reexec_syntax:totals "$OUT" "finish reason=stopped batches=2 items=2"
    assert_contains reexec_syntax:empty-line "$OUT" "backlog empty (sentinel confirmed first round LEDGER: none); re-check in 240m streak="
}

test_reexec_hash_unreadable_no_exec() {
    new_env
    seed_usage 5 0 1
