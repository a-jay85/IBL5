run_prompt --sim=1 --mentions="$_FIX/mentions.json" --themes="$_FIX/themes.json"
srt_log_lacks "$STUB" prompt.out "CURRENT ROSTER CONTEXT" \
    "negative_roster_absent — roster block absent when --roster not provided"

