    && grep -qF -e '-f alert=false' "$CALLS_G"; } \
  && ok "(IF-g) poll tail: launched run suppresses never-ran (dispatch alert=false)" \
  || bad "(IF-g) poll tail: expected one alert=false dispatch, got: $(cat "$CALLS_G" 2>/dev/null)"

# (IF-h) poll tail with a failed docfix-run: never-ran fires, detail carries log paths.
SB="$(build_sandbox)"; CALLS_H="$SB/gh-calls"
SHIM_GH_CALLS="$CALLS_H" SHIM_DOCFIX_RUN_RC=1 SHIM_STALE_JSON="$STALE_ONE" SHIM_ISSUE_OUT="77" \
