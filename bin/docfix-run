#!/usr/bin/env bash
#
# bin/docfix-run <issue-num> <sig> — Mac-side headless doc remediation launcher.
# Fired by bin/docfix-poll (launchd, daily) when the nightly audit has flagged
# stale docs or dead `paths:` globs. Creates a worktree, seeds an auto_merge:docs-only-ready
# hold plan, and launches a detached headless Claude run that fixes the flagged docs
# and commits. After Claude exits, the runner calls bin/docfix-split, which opens an
# auto-merge PR and, for content edits, a held content-review PR.
#
# Detach mechanism cloned in structure from bin/post-plan-now:71-109 (launchd
# RunAtLoad one-shot) — a plain `nohup … &` from the poll dies with it.
#
# Usage: bin/docfix-run <issue-num> <sig>

[ "${BASH_VERSINFO[0]:-0}" -ge 4 ] || { printf '%s: bash 4+ required (this is bash %s). Run: brew install bash\n' "${0##*/}" "${BASH_VERSION:-?}" >&2; exit 2; }
set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
Usage: bin/docfix-run <issue-num> <sig>

Mac-side headless doc remediation launcher. Fired by bin/docfix-poll
(launchd, daily) when the nightly audit has flagged stale docs or dead
paths: globs. Creates a worktree, seeds an auto_merge:docs-only-ready plan,
and launches a detached headless Claude run that fixes flagged docs and
commits. The runner then calls bin/docfix-split, which opens an auto-merge
PR and, for content edits, a held content-review PR.

Arguments:
  <issue-num>  GitHub issue number of the stale-docs audit issue.
  <sig>        Comma-separated repo-relative paths to fix (work list).

Both arguments are required.
EOF
    exit 0
fi

# The prompt reaches claude through a generated runner script that bash parses
# once (section 6). ljob_submit hands launchd only the runner's path, so the
# prompt never passes through launchd and needs no launchd-side escaping. The bash
# parse still needs shq (bin/lib/launchd-job.sh): interpolating $PROMPT inside
# double quotes left its many `backticks` live, so every backticked span was
# EXECUTED and then deleted from what the model received (2026-08-08 run:
# `bin/post-plan-now` actually fired mid-assembly; see the "command not found"
# lines in /tmp/docfix-run-*.log). Twin of the same defect in bin/post-plan-now,
# whose shq() header carries the full rationale.

# --- 1. Validate args (negative path) -----------------------------------------
ISSUE_NUM="${1:-}"
SIG="${2:-}"
if [ -z "$ISSUE_NUM" ] || [ -z "$SIG" ]; then
    echo "docfix-run: usage: bin/docfix-run <issue-num> <sig> (both required)" >&2
    exit 1
fi

# shellcheck source=bin/lib/plan-resolve.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/lib/plan-resolve.sh"
# shellcheck source=bin/lib/launchd-job.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/lib/launchd-job.sh"
# shellcheck source=bin/lib/docfix-dm.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/lib/docfix-dm.sh"   # DOCFIX_REVIEW_BRANCH_PREFIX

# --- 2. Anchor to the CANONICAL main checkout (NOT $0) ------------------------
# The poller invokes us from $MAIN itself, but launchd sets an arbitrary cwd, and
# bin/test-docfix-run needs the IBL5_MAIN override. Anchor to the real main
# checkout — exactly as workflow-continuity says wt-new is run FROM it. IBL5_MAIN
# override lets bin/test-docfix-run point this at its sandbox.
MAIN="${IBL5_MAIN:-/Users/ajaynicolas/GitHub/IBL5}"
cd "$MAIN"
source "$MAIN/bin/lib/git-helpers.sh"   # worktrees_parent_dir

# --- 3. Today's slug + dedupe: never stack duplicate doc-fix runs -------------
SLUG="docs-stale-refresh-$(date +%Y%m%d)"
if [ -n "$(git -C "$MAIN" branch --list "$SLUG")" ]; then
    echo "docfix-run: branch $SLUG already exists — today's run already fired; skipping."
    exit 0
fi
# A same-day review branch means today's run already fired and split.
REV_SLUG="${DOCFIX_REVIEW_BRANCH_PREFIX}$(date +%Y%m%d)"
if [ -n "$(git -C "$MAIN" branch --list "$REV_SLUG")" ]; then
    echo "docfix-run: branch $REV_SLUG already exists — today's run already fired; skipping."
    exit 0
fi
if ! PR_UNARMED="$(gh pr list --state open --json headRefName,autoMergeRequest \
     --jq '.[] | select(.headRefName | startswith("docs-stale-refresh-"))
                | select(.autoMergeRequest == null) | .headRefName' 2>/dev/null)"; then
    echo "docfix-run: could not query open PRs (gh failed) — skipping this cycle (fail-closed)."
    exit 0
fi
if [ -n "$PR_UNARMED" ]; then
    echo "docfix-run: unarmed open PR(s) pending human merge — skipping:"
    printf '  %s\n' $PR_UNARMED
    exit 0
fi

# --- 3b. Files held in open content-review PRs leave the worklist --------------
# A held review PR (bin/docfix-split) waits for the owner and must not block the
# next run, so the query above never names its prefix. Its files, and the old
# path of each rename, are left out of this run so two PRs never edit one doc.
# A failure of either call skips the run (fail-closed), naming the call.
if ! REVIEW_PRS="$(gh pr list --state open --limit 200 --json number,headRefName \
     --jq ".[] | select(.headRefName | startswith(\"$DOCFIX_REVIEW_BRANCH_PREFIX\")) | .number" 2>/dev/null)"; then
    echo "docfix-run: could not list open review PRs (gh pr list failed) — skipping this cycle (fail-closed)."
    exit 0
fi
EXCL_PATHS=""
for n in $REVIEW_PRS; do
    case "$n" in
        ''|*[!0-9]*)
            echo "docfix-run: gh pr list returned a non-numeric review PR '$n' — skipping this cycle (fail-closed)."
            exit 0 ;;
    esac
    if ! PR_FILES="$(gh api "repos/a-jay85/IBL5/pulls/$n/files" --paginate \
         --jq '.[] | .filename, (.previous_filename // empty)' 2>/dev/null)"; then
        echo "docfix-run: could not read the files of review PR #$n (gh api failed) — skipping this cycle (fail-closed)."
        exit 0
    fi
    EXCL_PATHS+="$PR_FILES"$'\n'
done
if ! EXCL_JSON="$(jq -Rnc '[inputs | select(length > 0)] | unique' <<< "$EXCL_PATHS")"; then
    echo "docfix-run: could not build the review-PR exclude list (jq failed) — skipping this cycle (fail-closed)."
    exit 0
fi
EXCL_FILE="${TMPDIR:-/tmp}/docfix-exclude-$SLUG.json"
if [ "$EXCL_JSON" != "[]" ]; then
    KEPT=""
    IFS=',' read -r -a SIG_ITEMS <<< "$SIG"
    for item in "${SIG_ITEMS[@]}"; do
        if jq -e --arg p "$item" 'index($p) != null' <<< "$EXCL_JSON" >/dev/null; then
            echo "docfix-run: $item is held in an open review PR; left out of this run."
            continue
        fi
        KEPT="${KEPT:+$KEPT,}$item"
    done
    if [ -z "$KEPT" ]; then
        echo "docfix-run: every worklist file is held in an open review PR; skipping"
        exit 0
    fi
    SIG="$KEPT"
fi

# --- 4. Create the worktree (base = master) -----------------------------------
bin/wt-new "$SLUG"                                   # cwd is $MAIN (step 2)
WT_ROOT="$(worktrees_parent_dir "$MAIN")/$SLUG"
# Abort cleanup until the detached run is submitted (disarmed in step 6).
# A failed wt-new cleans up after itself (bin/wt-new's own EXIT trap), so this
# arms only once wt-new returned 0. bin/wt-remove --if-empty re-checks emptiness
# at removal time and keeps a worktree with any work; removing an empty one also
# deletes the unpushed branch, so the step-3 dedupe does not skip the whole day.
# A runner left behind would be an orphan in /tmp, so it goes too. The seeded
# plan goes only when the worktree actually went.
docfix_abort_cleanup() {
    local rc=$?
    if [ "$rc" != 0 ]; then
        [ -n "${RUNNER:-}" ] && rm -f "$RUNNER"
        rm -f "$EXCL_FILE"
        cd "$MAIN" 2>/dev/null || cd /
        "$MAIN/bin/wt-remove" "$SLUG" --if-empty || true
        if [ ! -d "$WT_ROOT" ] && [ -n "${PLAN_FILE:-}" ]; then
            rm -f "$PLAN_FILE"
        fi
    fi
    exit "$rc"
}
trap docfix_abort_cleanup EXIT
# The split reads this list after claude exits; the runner removes it.
printf '%s\n' "$EXCL_JSON" > "$EXCL_FILE"

# --- 5. Seed the auto_merge:docs-only-ready plan (resolved by slug at post-plan) ----
# The matrix is what bin/lib/prefire-verify runs before bin/post-plan-now fires. Without
# one the fire is refused, and only a human may bypass that, so this unattended run wedges.
PLAN_FILE="$(plans_dir)/$SLUG.md"
cat > "$PLAN_FILE" <<PLAN_EOF
---
auto_merge: docs-only-ready
---

# Stale-docs auto-refresh ($SLUG)

Runtime-seeded plan for the autonomous doc-fix run. Refreshes the docs the
nightly Doc Freshness Audit flagged (issue #$ISSUE_NUM).
Held for human merge unless Phase 6.5 finds it docs-only, two-way and READY.

## Verification Matrix

| # | What | Type | Timing | Location |
|---|------|------|--------|----------|
| 1 | Every in-scope doc passes the freshness policy | CLI-executable | post-impl | bin/check-docs --no-staleness |
| 2 | No stale doc or dead glob remains | CLI-executable | post-impl | bin/check-docs --staleness-report \| jq -e 'length == 0' |

## Automouse Hold Justification

auto_merge: docs-only-ready. This PR is opened autonomously by a launchd-scheduled
Claude run with no human in the loop. /post-plan Phase 6.5 condition (7) reads this
value and arms auto-merge only when the realized PR passes every docs-refresh
clause: the branch is a docs-stale-refresh-* branch, every changed path is a
documentation file (ibl5/docs/**/*.md, ibl5/classes/*/README.md or README.md;
any .claude/, bin/, workflow, test, code or config path holds), the body's merge
danger line is two-way, and the Phase 5.5 verdict is exactly READY. A failed
clause holds the PR for a human, with the clause named in the hold reason.
PLAN_EOF

# --- 6. Launch the detached headless doc-fix run ------------------------------
TS=$(date +%Y%m%d-%H%M%S)-$$
LOG="/tmp/docfix-run-$SLUG-$TS.log"
LABEL="com.ibl5.docfix-run-$SLUG-$TS"
. "$(dirname "${BASH_SOURCE[0]}")/lib/session-id.sh"
SESSION_ID=$(mint_session_id) || { echo "docfix-run: could not mint a session uuid." >&2; exit 1; }
write_session_sidecar "$LOG" "$SESSION_ID" \
    || { echo "docfix-run: could not write the session sidecar next to $LOG." >&2; exit 1; }
# Local date, never UTC: bin/check-docs compares last_verified against the
# edit's local commit date (editCommitDate / localToday), so a UTC evening
# value reads as tomorrow and fails "last_verified in the future".
TODAY="$(date +%Y-%m-%d)"

PROMPT="You are fixing doc findings with NO human present — never ask questions or wait for input; make the safe choice and continue. The findings are the nightly Doc Freshness Audit set for issue #$ISSUE_NUM. Work ONLY on these paths (comma-separated): $SIG. First run \`bin/check-docs --staleness-report\` and split its JSON with jq into entries whose \`reason\` is \`stale\` and entries whose \`reason\` is \`dead-glob\`; that command is the authoritative finding list, and the body of issue #$ISSUE_NUM shows the same two tables for reference. For each \`stale\` entry: re-verify its content against the current reality of the codebase, correct drifted content, and bump its \`last_verified\` to today ($TODAY). TWO HARD CONSTRAINTS GOVERN EVERY CONTENT CORRECTION. (1) DECISION RECORDS ARE APPEND-ONLY. Files under \`ibl5/docs/decisions/\` record what was true and what was decided AT THE TIME the ADR was written, so 'current reality' is NOT the standard they are judged against. Inside their \`## Context\`, \`## Decision\`, any \`Rationale\` heading, and \`## Alternatives Considered\` sections you MUST NOT overwrite a name, version, count, size or any other figure in place, even when today's codebase plainly disagrees — an in-place rewrite makes the ADR assert a decision that was never taken. You may still repair a dead file path there, and you must still bump \`last_verified\`. When reality has moved away from a figure in one of those sections, LEAVE THE ORIGINAL SENTENCE BYTE-FOR-BYTE UNCHANGED and instead append a new section headed \`## Addendum — TOPIC ($TODAY)\` immediately before \`## Alternatives Considered\` (or before \`## Consequences\` when no such heading exists) stating the original figure, today's figure, and one clause on what changed. The ONE permitted in-place edit to a frozen sentence is appending a bracketed stamp (\`[CORRECTED $TODAY — see § Addendum]\`) and ONLY when \`bin/check-docs\` fails on that exact line because the figure is a retired one; the sentence's own words still never change, and the stamp is never added pre-emptively. (2) NEVER SWAP A FIGURE WITHOUT RE-READING ITS SENTENCE. This applies to every doc, ADR or not. Before replacing any value, re-read the WHOLE surrounding sentence with the new value substituted and confirm the entire sentence is still true: a swap that leaves a comparative or derived claim (\`one-third of\`, \`twice\`, \`the largest\`, \`across N files\`) bound to the old value manufactures a NEW false statement out of a merely stale one. If the sentence cannot survive the substitution, rewrite it as dated history rather than swapping the value. Confirm also that the figure you are about to write measures THE SAME QUANTITY as the one you are replacing — never substitute a file count for a call-site count, or a per-file figure for a total. If you cannot establish the new value with a command whose output you have actually read, leave the sentence alone and say so in the PR body. For each \`dead-glob\` entry: the named file declares a \`paths:\` frontmatter glob matching no tracked file, so that rule can never load — PREFER correcting the glob so it matches the tracked files it was meant to cover, and delete the \`paths:\` entry only when no correction is identifiable. IF you delete a glob you MUST disclose it: add one line per deletion to the commit message body AND to the PR body under a heading reading \`## Dead globs deleted\`, in exactly this form: \`Dead glob deleted: in FILE_PATH, removed paths: entry GLOB — REASON\`, substituting the real repo-relative path, the exact glob text, and one clause saying why no correction was possible, so the maintainer can review the deletion without opening the diff. Never delete a whole file, and never remove a \`paths:\` key that still carries a working glob. IF you change any doc content other than a \`last_verified\` date you MUST disclose it exactly as you would a deleted glob: add one entry per rewritten sentence to the commit message body AND to the PR body under a heading reading \`## Content rewritten\`, in exactly this form: \`Content rewritten: in FILE_PATH — BEFORE: 'OLD SENTENCE' — AFTER: 'NEW SENTENCE' — EVIDENCE\`, quoting both sentences in full and naming in EVIDENCE the file you read or the command you ran to establish the new value, so the maintainer can review every content change without opening the diff. An appended \`## Addendum\` section counts as a content change and is disclosed the same way, with BEFORE reading 'n/a (appended section)'. Before reporting any fix done, run a real check that exercises it: the \`bin/check-docs\` commands named below, reading their output. A check command that failed to start does not count. If a check cannot run here, say which one you did not run and why in the PR body instead of reporting the fix as done. Then run \`bin/check-docs --fix-dates --since=master\` to bump any in-scope doc you changed but did not hand-bump, and re-run \`bin/check-docs --staleness-report\` to confirm every finding you were given is gone. Do NOT touch any doc outside the list above. Commit all of your work, then stop. Leave no uncommitted change and no untracked file. Do not run bin/post-plan-now or bin/docfix-check-veronly, and never open a PR. After you exit, the runner splits your commits into an auto-merge PR and a held content-review PR and opens them. Wherever this prompt says PR body, write it in the commit message body. Issue #$ISSUE_NUM lives in THIS repo (a-jay85/IBL5), not in a-jay85/IBL5-backlog: cite it everywhere as bare \`#$ISSUE_NUM\` and never rewrite it as an IBL5-backlog link, which points at an unrelated issue and closes nothing."
# The job's command lives in a generated runner script; ljob_submit's wrapper
# only runs it. The runner is parsed once, by bash, so the prompt needs shq and
# nothing else.
RUNNER="${LOG%.log}.sh"
case "$RUNNER" in
    *[[:space:]]*)
        echo "docfix-run: runner path '$RUNNER' contains whitespace; refusing to launch it." >&2
        exit 1 ;;
esac
{
    printf '#!/bin/bash\n'
    printf 'rm -f %s\n' "$(shq "$RUNNER")"   # self-delete first; bash keeps the open fd
    printf '%s\n' 'export PATH="/usr/local/bin:/opt/homebrew/bin:$HOME/.bun/bin:$HOME/.local/bin:/Applications/cmux.app/Contents/Resources/bin:$PATH"'
    # Cap the session at 2 hours of wall clock. Stock macOS ships no timeout(1);
    # perl's alarm survives exec, so SIGALRM ends claude (the same fallback as
    # _pf_timeout_argv in bin/postplan-fix).
    printf 'cd %s && CLAUDE_HEADLESS=1 caffeinate -s perl -e "alarm shift; exec @ARGV or exit 127" 7200 claude -p %s --dangerously-skip-permissions --model claude-sonnet-5-5 --session-id %s --effort low --name %s\n' \
        "$(shq "$WT_ROOT")" "$(shq "$PROMPT")" "$SESSION_ID" "$(shq "$LABEL")" # claude-perm-ok: unattended headless docfix run with no human to answer a prompt; edits docs in its worktree
    # After claude exits, split its commits into the auto and review piles and fire
    # each. The trusted copy under MAIN runs, never the copy in the worktree claude
    # edited, and the runner leaves that worktree first so wt-remove can drop it.
    # No set -e: a failed or timed-out claude reaches the else branch.
    printf '%s\n' 'rc=$?'
    printf 'cd %s\n' "$(shq "$MAIN")"
    printf '%s\n' 'if [ "$rc" -eq 0 ]; then'
    printf '    %s %s %s %s\n' "$(shq "$MAIN/bin/docfix-split")" "$(shq "--slug=$SLUG")" \
        "$(shq "--issue=$ISSUE_NUM")" "$(shq "--exclude-file=$EXCL_FILE")"
    printf '%s\n' '    echo "docfix-run: docfix-split exited $?"'
    printf '%s\n' 'else'
    printf '%s\n' '    echo "docfix-run: claude exited $rc; split skipped, worktree left for docfix-poll"'
    printf '%s\n' 'fi'
    printf 'rm -f %s\n' "$(shq "$EXCL_FILE")"
    printf '%s\n' 'exit "$rc"'   # the job's status stays claude's own exit
} > "$RUNNER"
chmod 700 "$RUNNER"

# No plist: ljob_submit launches the runner with no file in ~/Library/LaunchAgents
# (unit 1's ADR on per-run launchd jobs). The runner cds and sets PATH itself.
SUBMIT_RC=0
ljob_submit "$LABEL" "$LOG" "$RUNNER" || SUBMIT_RC=$?
if [ "$SUBMIT_RC" -ne 0 ]; then
    rm -f "$RUNNER"
    echo "ERROR: launchctl submit failed (rc $SUBMIT_RC) for $LABEL; nothing launched." >&2
    exit 1
fi
trap - EXIT   # the detached run owns the worktree from here

echo "docfix-run: fired detached doc-fix run on '$SLUG' (issue #$ISSUE_NUM)."
echo "  worklist: $SIG"
echo "  watch:    $MAIN/bin/watch-run --log $LOG --label $LABEL"
echo "            ^ arm THIS in a Monitor. Self-terminating. Never 'tail -f' the log."
echo "  log:      $LOG"
echo "  label:    $LABEL   (self-removes when the run finishes)"
