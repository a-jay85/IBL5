# --- §5.5 Step 1b carry-forward gate behavioural cases ---------------------------------
# Drives the three Step 1b/1c fences (decision, materialise) in their own shells against
# fixture sticky bodies in the Step 6 layout. The ${VAR:-...} seams on the blocks are the
# only inputs; a live run never sets them. Each case prints "ok: <name>" or "FAIL: <name>".
BCFD="$(extract_block '# phase 5.5 carry-forward decision' "$P55_SKILL")"
BCFM="$(extract_block '# phase 5.5 carry-forward materialise' "$P55_SKILL")"
if [ -z "$BCFD" ] || [ -z "$BCFM" ]; then
    echo "FAIL: cf — carry-forward decision/materialise block missing from $P55_SKILL — marker drifted"
    FAILED=1
else
CF_T="$(printf 'a%.0s' $(seq 40))"
CF_H="$(printf 'b%.0s' $(seq 64))"
CF_PR=999031
CF_BODY="$BASE_TMP/cf-body.md"
CF_DIGEST="$BASE_TMP/cf-digest.txt"
CF_PROBE="$BASE_TMP/cf-probe.txt"
CF_BANNER_DEFAULT="**READY** — 2026-10-01 00:00:00 UTC"
CF_PLAN_POS=audit   # audit | above (plan-hash line above the digest, as the harness writes it)

# mk_prior_body <terminal-line> <banner-line> <plan-hash-line-or-empty> <tree>
mk_prior_body() {
    local term="$1" banner="$2" planline="$3" tree="$4"
    {
        printf '%s\n\n' "$banner"
        printf 'Findings: none.\n\n'
        if [ -n "$planline" ] && [ "$CF_PLAN_POS" = above ]; then printf '%s\n\n' "$planline"; fi
        printf '### Merge digest\n'
        printf '**What changed:** x\n**Why:** x\n**Watch:** x\n**Touches:** x\n**Machine-authored fixes:** none\n'
        printf '\n---\n\n<details><summary>Audit trail</summary>\n\n'
        printf 'REVIEW-COVERAGE: full\n**Reviewed tree:** %s\n' "$tree"
        if [ -n "$planline" ] && [ "$CF_PLAN_POS" = audit ]; then printf '%s\n' "$planline"; fi
        printf '\n</details>\n\n%s\n<!-- pr-ready-verdict -->\n' "$term"
    } > "$CF_BODY"
}
mk_cf_digest() {  # <line-count 4|5>
    printf '**What changed:** x\n**Why:** x\n**Watch:** x\n**Touches:** x\n**Machine-authored fixes:** none\n' \
        | head -n "$1" > "$CF_DIGEST"
}
mk_cf_probe() { printf 'CURRENT-TREE: %s\n%s\n' "$CF_T" "$1" > "$CF_PROBE"; }

# cf_decide <block> [HEAD_TREE] [CUR_PLAN_HASH] [PROBE_OUT] — run the decision block, print stdout.
cf_decide() {
    printf '{"number":%s}' "$CF_PR" > "$BASE_TMP/fixture.json"
    PATH="$SHIMD:$PATH" GH_PR_FIXTURE="$BASE_TMP/fixture.json" \
        PROBE_OUT="${4:-$CF_PROBE}" PRIOR_BODY="$CF_BODY" PRIOR_DIGEST="$CF_DIGEST" \
        CUR_PLAN_HASH="${3:-$CF_H}" HEAD_TREE="${2:-$CF_T}" bash -c "$1" 2>&1
}
# cf_check <name> <output> <line>... — each line must appear whole in the output; a line
# starting with "!" must NOT appear as a line prefix. Prints one ok:/FAIL: for the case.
cf_check() {
    local name="$1" out="$2" l bad=0
    shift 2
    for l in "$@"; do
        if [ "${l:0:1}" = "!" ]; then
            if grep -q "^${l:1}" <<< "$out"; then
                echo "FAIL: $name — unexpected '${l:1}' in: $(tr '\n' '|' <<< "$out")"; bad=1
            fi
        elif ! grep -qxF -- "$l" <<< "$out"; then
            echo "FAIL: $name — missing '$l' in: $(tr '\n' '|' <<< "$out")"; bad=1
        fi
    done
    if [ "$bad" = 0 ]; then echo "ok: $name"; else FAILED=1; fi
}
CF_PLANLINE="**Plan hash:** $CF_H"

# --- happy paths
mk_prior_body "READY" "$CF_BANNER_DEFAULT" "$CF_PLANLINE" "$CF_T"; mk_cf_digest 5; mk_cf_probe "SKIP-REVIEW $CF_T"
cf_check cf-happy-ready "$(cf_decide "$BCFD")" "FIDELITY_GATE=skip" "CARRY_WORD=READY" "CARRY_TREE=$CF_T"

mk_prior_body "READY WITH NOTES" "$CF_BANNER_DEFAULT" "$CF_PLANLINE" "$CF_T"
cf_check cf-happy-ready-with-notes "$(cf_decide "$BCFD")" "FIDELITY_GATE=skip" "CARRY_WORD=READY WITH NOTES"

