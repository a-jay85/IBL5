rt "${E_ON[@]}" STUB_LAUNCHCTL_LIST="$CD/labels2" -- --force
log_has 'unattributable live job com.ibl5.pr-cycle-1-2' || note_err "slug-less label not deferring"
[ -d "$(wt_dir e-old)" ] || note_err "removed"
finish_case
fi

if should_run E5-session-kept; then
