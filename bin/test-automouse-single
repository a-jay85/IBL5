#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-automouse-single — characterization + regression test for the
# bin/automouse/run plan <slug> single-plan mode.
#
# Verifies: selection guard (only the named plan runs), untouched-queue contract,
# self-heal gated OFF in single mode, auto-queue-if-absent, hard-fail on
# unresolvable slug, and already-queued tolerance.
#
# Cases 4 and 6 run on every platform. Cases 1, 2, 3 and 5 drive the run loop,
# which needs macOS tools inside bin/automouse/run (caffeinate, BSD mktemp,
# stat -f, BSD date), so off macOS they print a SKIP line and do not run.
# AUTOMOUSE_SINGLE_UNAME overrides the platform check (default: $(uname)).
#
# Run: bin/test-automouse-single
#   exit 0 = every case that ran passed (off macOS: cases 4 and 6 only)
#   exit 1 = any assertion failed

set -u

# Keep the colon: ${AUTOMOUSE_SINGLE_UNAME-$(uname)} would treat an empty override as non-Darwin.
PLATFORM="${AUTOMOUSE_SINGLE_UNAME:-$(uname)}"

REPO="$(cd "$(dirname "$0")/.." && pwd)"
ROOT="$(mktemp -d)"
trap 'rm -rf "$ROOT"' EXIT

NDIR="$ROOT/automouse"
PDIR="$ROOT/plans"
STUBDIR="$ROOT/stub"
mkdir -p "$NDIR/queue" "$NDIR/handoff" "$NDIR/logs" "$NDIR/reports" \
         "$NDIR/done" "$NDIR/skipped" "$PDIR" "$STUBDIR"

FAILED=0

assert_present() {
    local desc="$1" path="$2"
    if [ ! -e "$path" ] && [ ! -L "$path" ]; then
        echo "FAIL: $desc — expected present: $path"
        FAILED=1
    fi
}

assert_absent() {
    local desc="$1" path="$2"
    if [ -e "$path" ]; then
        echo "FAIL: $desc — expected absent (exists): $path"
        FAILED=1
        return
    fi
    if [ -L "$path" ]; then
        echo "FAIL: $desc — expected absent (dangling symlink): $path"
        FAILED=1
    fi
}

# check <desc> <command...>: print "ok: <desc>" when the command succeeds, else
# "FAIL: <desc>" and set FAILED. A leading "!" argument (right after <desc>)
# inverts the result: the command must fail.
check() {
    local desc="$1" want=0
    shift
    if [ "${1:-}" = "!" ]; then want=1; shift; fi
    "$@" >/dev/null 2>&1
    local rc=$?
    if { [ "$want" -eq 0 ] && [ "$rc" -eq 0 ]; } || { [ "$want" -eq 1 ] && [ "$rc" -ne 0 ]; }; then
        echo "ok: $desc"
    else
        echo "FAIL: $desc"
        FAILED=1
    fi
}

# --- Stub claude ------------------------------------------------------------
# First call per plan (no handoff) = impl: writes handoff JSON.
# Second call (handoff present) = postplan: moves plan to done/, clears handoff.
# Emits a stream-json success result event. sleep 2 keeps runtime above the
# sub-minute fast-fail threshold (MIN_VIABLE_SECS=60) without tripping it:
# impl is safe because the handoff is written (should_impl_env_stop returns 1);
# postplan is safe because the handoff is deleted before the sub-minute check.
cat > "$STUBDIR/claude" <<STUB
#!/usr/bin/env bash
set -u
NDIR="$NDIR"
plan="\$(printf '%s\n' "\$*" | grep -oE 'PLAN_FILE=[^[:space:]]+' | tail -1 | cut -d= -f2)"
sleep 2
if [ -n "\$plan" ]; then
    hf="\$NDIR/handoff/\$plan.json"
    if [ ! -f "\$hf" ]; then
        printf '{"branch":"x","plan":"%s"}\n' "\$plan" > "\$hf"
    else
        mv "\$NDIR/queue/\$plan" "\$NDIR/done/\$plan" 2>/dev/null || true
        rm -f "\$hf" "\$NDIR/queue/\$plan.attempts" 2>/dev/null || true
    fi
fi
printf '{"type":"result","subtype":"success","stop_reason":"end_turn","num_turns":1,"duration_ms":2000,"total_cost_usd":0.001,"usage":{"input_tokens":1,"output_tokens":1}}\n'
exit 0
STUB
chmod +x "$STUBDIR/claude"

# --- Copy real runner; redirect NIGHTLY_DIR + stub PATH --------------------
RUNNER="$ROOT/automouse/run"
sed -e "s#^NIGHTLY_DIR=.*#NIGHTLY_DIR=\"$NDIR\"#" \
    -e "s#^REPO=.*#REPO=\"$REPO\"#" \
    -e "s#^SELF_DIR=.*#SELF_DIR=\"$REPO/bin/automouse\"#" \
    -e "s#^export PATH=.*#export PATH=\"$STUBDIR:/usr/local/bin:/opt/homebrew/bin:\$PATH\"#" \
    "$REPO/bin/automouse/run" > "$RUNNER"
chmod +x "$RUNNER"

# --- Helpers ---------------------------------------------------------------
seed_plan() {
    local slug="$1"
    printf '# %s\n\nimpl_model: sonnet\n' "$slug" > "$PDIR/$slug.md"
    ln -s "$PDIR/$slug.md" "$NDIR/queue/$slug.md"
}

run_single() {
    PLANS_DIR="$PDIR" "$RUNNER" plan "$1" > "$ROOT/run.out" 2>&1
}

reset_state() {
    rm -rf "$NDIR/queue" "$NDIR/handoff" "$NDIR/done" "$NDIR/skipped" \
           "$NDIR/logs" "$NDIR/reports" "$PDIR"
    mkdir -p "$NDIR/queue" "$NDIR/handoff" "$NDIR/logs" "$NDIR/reports" \
             "$NDIR/done" "$NDIR/skipped" "$PDIR"
}

# Case 4 and case 6 must see a runner failure as a value, never as a script
# abort. Save the caller's errexit state, turn it off, and put it back after.
ERREXIT_WAS_ON=0
errexit_off() {
    case $- in *e*) ERREXIT_WAS_ON=1 ;; *) ERREXIT_WAS_ON=0 ;; esac
    set +e
}
errexit_restore() {
    if [ "$ERREXIT_WAS_ON" -eq 1 ]; then set -e; fi
}

# ===========================================================================
# Platform-independent cases (4, 6): these exit before the run loop, so they
# pass on Linux too. They run first on every platform.
# ===========================================================================
# ===========================================================================
# Case 4 — unresolvable slug hard-fails before the loop (Phases 1 & 4)
# ===========================================================================
echo "--- case 4: unresolvable slug hard-fails ---"
reset_state
errexit_off
out=$(PLANS_DIR="$PDIR" "$RUNNER" plan nonexistent-slug 2>&1); exit_code=$?
errexit_restore
[ "$exit_code" -ne 0 ] || { echo "FAIL: case4 expected non-zero exit, got 0"; FAILED=1; }
echo "$out" | grep -qi "cannot resolve\|no such plan\|nonexistent-slug" \
    || { echo "FAIL: case4 expected a loud unresolved-slug message, got: $out"; FAILED=1; }
assert_absent "case4 no no-queue report" \
    "$NDIR/reports/$(date +%Y-%m-%d)-no-queue.md"

# ===========================================================================
# Case 6 — unusable impl_model is disposed WITHOUT burning an attempt (Phase 4)
# ===========================================================================
echo "--- case 6: unusable impl_model disposed, no attempt burned ---"
reset_state
printf -- '---\nimpl_model: claude-sonnet-4.6\n---\n\n# plan-badmodel\n' > "$PDIR/plan-badmodel.md"
ln -s "$PDIR/plan-badmodel.md" "$NDIR/queue/plan-badmodel.md"
errexit_off
PLANS_DIR="$PDIR" "$RUNNER" plan plan-badmodel > "$ROOT/run.out" 2>&1; rc=$?
errexit_restore
[ "$rc" -eq 0 ] || { echo "FAIL: case6 runner aborted (rc=$rc) instead of skipping"; FAILED=1; }
assert_present "case6 disposed to skipped/"     "$NDIR/skipped/plan-badmodel.md"
assert_absent  "case6 left queue"               "$NDIR/queue/plan-badmodel.md"
assert_absent  "case6 no attempts sidecar"      "$NDIR/queue/plan-badmodel.md.attempts"
assert_absent  "case6 no handoff (claude never ran)" "$NDIR/handoff/plan-badmodel.md.json"
assert_absent  "case6 not completed"            "$NDIR/done/plan-badmodel.md"
assert_present "case6 skipped report written"   "$NDIR/reports/$(date +%Y-%m-%d)-skipped-plan-badmodel.md"
grep -qF 'is not a recognized model' "$NDIR/reports/$(date +%Y-%m-%d)-skipped-plan-badmodel.md" \
    || { echo "FAIL: case6 report lacks the rejection reason"; FAILED=1; }

# ===========================================================================
# macOS-only run-loop cases (1, 2, 3, 5)
# ===========================================================================
if [ "$PLATFORM" != "Darwin" ]; then
    echo ""
    echo "SKIP: cases 1, 2, 3, 5, 7, 8, 9 (run loop) need macOS: bin/automouse/run calls caffeinate, BSD mktemp, stat -f and BSD date. macOS coverage for them comes from running bin/test-automouse-single locally on a Mac (there is no macOS CI job). Platform: $PLATFORM."
    if [ "$FAILED" -ne 0 ]; then
        echo "RESULT: FAILED"
    else
        echo "RESULT: cases 4 and 6 passed; cases 1, 2, 3, 5, 7, 8, 9 skipped"
    fi
    exit "$FAILED"
fi

# ===========================================================================
# Case 1 — only the named plan runs; others remain untouched (Phases 2 & 4)
# ===========================================================================
echo "--- case 1: named plan runs, others untouched ---"
reset_state
seed_plan plan-1
seed_plan plan-2
seed_plan plan-3
run_single plan-2

assert_present "case1 plan-2 completed"  "$NDIR/done/plan-2.md"
assert_absent  "case1 plan-2 left queue" "$NDIR/queue/plan-2.md"
for other in plan-1 plan-3; do
    assert_present "case1 $other still queued"    "$NDIR/queue/$other.md"
    assert_absent  "case1 $other not done"        "$NDIR/done/$other.md"
    assert_absent  "case1 $other no lock"         "$NDIR/queue/$other.md.lock"
    assert_absent  "case1 $other no attempts"     "$NDIR/queue/$other.md.attempts"
    assert_absent  "case1 $other no handoff"      "$NDIR/handoff/$other.md.json"
done

# ===========================================================================
# Case 2 — self-heal gated OFF in single mode (Phase 3)
# ===========================================================================
echo "--- case 2: self-heal gated off ---"
reset_state
seed_plan plan-run
# plan-skip: no repo-path tokens → check-plan-staleness exits 0 → self-heal
# would requeue it if not gated. Positive control proves this below.
printf '# plan-skip\n\nimpl_model: sonnet\n' > "$PDIR/plan-skip.md"
ln -s "$PDIR/plan-skip.md" "$NDIR/skipped/plan-skip.md"
touch "$NDIR/skipped/plan-skip.md.staleness"

# Positive control: verify self-heal WOULD requeue plan-skip without the gate.
# Clone the state to a temp copy and run self-heal on it.
CLONE="$ROOT/clone-case2"
cp -r "$NDIR" "$CLONE"
if NIGHTLY_DIR="$CLONE" PLANS_DIR="$PDIR" "$REPO/bin/automouse/self-heal" >/dev/null 2>&1; then
    if [ -e "$CLONE/queue/plan-skip.md" ]; then
        echo "positive-control: self-heal WOULD requeue plan-skip — fixture is non-vacuous."
    else
        echo "WARN: positive-control inconclusive (self-heal ran but plan-skip not in clone queue/)"
    fi
else
    echo "WARN: positive-control self-heal exited non-zero — fixture may be vacuous"
fi
rm -rf "$CLONE"

run_single plan-run
assert_present "case2 plan-run completed"    "$NDIR/done/plan-run.md"
assert_present "case2 skip still skipped"    "$NDIR/skipped/plan-skip.md"
assert_present "case2 staleness marker kept" "$NDIR/skipped/plan-skip.md.staleness"
assert_absent  "case2 skip NOT resurrected"  "$NDIR/queue/plan-skip.md"

# ===========================================================================
# Case 3 — auto-queue-if-absent (Phase 1)
# ===========================================================================
echo "--- case 3: auto-queue-if-absent ---"
reset_state
seed_plan plan-other
printf '# plan-x\n\nimpl_model: sonnet\n' > "$PDIR/plan-x.md"   # NOT in queue/
run_single plan-x

assert_present "case3 plan-x auto-queued+ran" "$NDIR/done/plan-x.md"
assert_present "case3 plan-other untouched"   "$NDIR/queue/plan-other.md"
assert_absent  "case3 plan-other not done"    "$NDIR/done/plan-other.md"
assert_absent  "case3 plan-other no lock"     "$NDIR/queue/plan-other.md.lock"

# ===========================================================================
# Case 5 — already-queued tolerance (Phase 1 pre-check)
# ===========================================================================
echo "--- case 5: already-queued tolerance ---"
reset_state
seed_plan plan-dup            # writes $PDIR/plan-dup.md AND queue/ symlink
run_single plan-dup           # must NOT abort on the already-queued symlink
assert_present "case5 plan-dup completed"  "$NDIR/done/plan-dup.md"
assert_absent  "case5 plan-dup left queue" "$NDIR/queue/plan-dup.md"
grep -qi "already queued" "$ROOT/run.out" \
    && { echo "FAIL: case5 leaked an 'already queued' error"; FAILED=1; }

# ---------------------------------------------------------------------------
# Cases 7-9 — repeated-failure stop (ADR: automouse stop on repeated failure).
# A failing stub claude emits one Bash tool_use + an is_error tool_result whose
# text comes from line N of $NDIR/stub-errors on call N, and never writes a
# handoff, so every attempt is a genuine impl failure. MIN_VIABLE_SECS=0 keeps
# the sub-minute env-stop guard from reclassifying the fast stub as environmental.
# ---------------------------------------------------------------------------
RUNNER_RF="$ROOT/automouse/run-rf"
sed -e 's#^MIN_VIABLE_SECS=[0-9]*#MIN_VIABLE_SECS=0#' "$RUNNER" > "$RUNNER_RF"
chmod +x "$RUNNER_RF"
grep -q '^MIN_VIABLE_SECS=0' "$RUNNER_RF" \
    || { echo "FAIL: case7-9 setup could not zero MIN_VIABLE_SECS"; FAILED=1; }
run_single_rf() {
    PLANS_DIR="$PDIR" "$RUNNER_RF" plan "$1" > "$ROOT/run.out" 2>&1
}
printf '#!/usr/bin/env bash\nNDIR=%q\n' "$NDIR" > "$STUBDIR/claude"
cat >> "$STUBDIR/claude" <<'STUB'
set -u
# Only impl/postplan runs (claude -p) count as attempts; the login preflight
# (claude auth status ...) must neither consume an error line nor a call slot.
[ "${1:-}" = "-p" ] || exit 0
# One line per call holding just the --model value: the multi-line prompt would
# otherwise break line counting, and its prose mentions opus on every call.
model=none; prev=
for a in "$@"; do [ "$prev" = "--model" ] && model=$a; prev=$a; done
n=$(( $(wc -l < "$NDIR/stub-calls" 2>/dev/null || echo 0) + 1 ))
printf '%s\n' "$model" >> "$NDIR/stub-calls"
err=$(sed -n "${n}p" "$NDIR/stub-errors")
printf '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"tu%d","name":"Bash","input":{"command":"vendor/bin/phpunit --filter FooTest"}}]}}\n' "$n"
printf '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"tu%d","is_error":true,"content":"Exit code 1\\n%s"}]}}\n' "$n" "$err"
printf '{"type":"result","subtype":"error_during_execution","stop_reason":"end_turn","num_turns":2,"duration_ms":2000,"total_cost_usd":0.001,"usage":{"input_tokens":1,"output_tokens":1}}\n'
exit 0
STUB
chmod +x "$STUBDIR/claude"

# drive_attempts <slug>: up to 3 single-mode attempts, stopping once the plan leaves queue/
drive_attempts() {
    for _ in 1 2 3; do
        [ -L "$NDIR/queue/$1.md" ] || break
        run_single_rf "$1" || true
    done
}
stub_calls() { wc -l < "$NDIR/stub-calls" 2>/dev/null | tr -d ' '; }
check_present() { check "$1" test -e "$2" -o -L "$2"; }
check_absent() { check "$1" test ! -e "$2" -a ! -L "$2"; }
# seed_plan_sonnet <slug>: seed_plan, then rewrite the plan with a line-1 frontmatter
# impl_model. bin/lib/plan-impl-model reads ONLY a frontmatter block, so the bare
# line seed_plan writes resolves to the Opus default and would never escalate.
seed_plan_sonnet() {
    seed_plan "$1"
    printf -- '---\nimpl_model: sonnet\n---\n\n# %s\n' "$1" > "$PDIR/$1.md"
}
calls_are() { [ "$(stub_calls)" = "$1" ]; }
attempt_is_opus() { sed -n "${1}p" "$NDIR/stub-calls" | grep -q opus; }

# ===========================================================================
# Case 7 — identical failure (differing SHA + timestamp) stops before attempt 3
# ===========================================================================
echo "--- case 7: identical failure stops before a 3rd attempt ---"
reset_state; rm -f "$NDIR/stub-calls" "$NDIR/stub-errors"
printf '%s\n' \
    'fatal: bad object 3f9c2ab71e0d at 2026-10-01T03:12:44Z' \
    'fatal: bad object a81be09c44f2d7e at 2026-10-02T05:40:01Z' \
    'fatal: bad object 0b1c2d3e4f5 at 2026-10-03T01:00:00Z' > "$NDIR/stub-errors"
seed_plan_sonnet plan-rep
drive_attempts plan-rep
RF7_REPORT="$NDIR/reports/$(date +%Y-%m-%d)-skipped-plan-rep.md"
check "case7 exactly 2 stub calls (no 3rd attempt)" calls_are 2
check_present "case7 moved to skipped/"      "$NDIR/skipped/plan-rep.md"
check_absent  "case7 left queue"             "$NDIR/queue/plan-rep.md"
check_absent  "case7 no attempts sidecar"    "$NDIR/queue/plan-rep.md.attempts"
check_absent  "case7 no failure sidecar"     "$NDIR/queue/plan-rep.md.failure"
check_present "case7 skipped report written" "$RF7_REPORT"
check "case7 report names attempts 1 and 2" grep -q 'attempts 1 and 2' "$RF7_REPORT"
check "case7 report quotes the failure signature" grep -q 'fatal: bad object <SHA>' "$RF7_REPORT"
check "case7 log records REPEATED FAILURE" grep -rq 'REPEATED FAILURE' "$NDIR/logs"
check "case7 tool error text absent from logs" ! grep -rq 'fatal: bad object' "$NDIR/logs"

# ===========================================================================
# Case 8 — different failures: the 3rd (Opus) attempt still runs
# ===========================================================================
echo "--- case 8: different failures still get a 3rd (Opus) attempt ---"
reset_state; rm -f "$NDIR/stub-calls" "$NDIR/stub-errors"
printf '%s\n' \
    'fatal: bad object 3f9c2ab71e0d' \
    'PHP Parse error: syntax error, unexpected token in Foo.php:12' \
    'Undefined variable bar in Baz.php:40' > "$NDIR/stub-errors"
seed_plan_sonnet plan-diff
drive_attempts plan-diff
check "case8 exactly 3 stub calls (3rd attempt ran)" calls_are 3
check "case8 attempt 3 is the escalated Opus try" attempt_is_opus 3
check "case8 attempt 2 is not Opus" ! attempt_is_opus 2
check_present "case8 still queued"  "$NDIR/queue/plan-diff.md"
check_absent  "case8 not skipped"   "$NDIR/skipped/plan-diff.md"
check "case8 log has no REPEATED FAILURE" ! grep -rq 'REPEATED FAILURE' "$NDIR/logs"
check "case8 failure sidecar holds attempt-3 signature" grep -q '^failure-signature: .*Undefined variable' "$NDIR/queue/plan-diff.md.failure"

# ===========================================================================
# Case 9 — no extractable signature fails open (never a false stop)
# ===========================================================================
echo "--- case 9: empty signature fails open ---"
reset_state; rm -f "$NDIR/stub-calls" "$NDIR/stub-errors"
printf '%s\n' '' '' '' > "$NDIR/stub-errors"
seed_plan_sonnet plan-none
drive_attempts plan-none
check "case9 exactly 3 stub calls" calls_are 3
check "case9 log records failsig: none" grep -rq 'failsig: none' "$NDIR/logs"
check "case9 log has no REPEATED FAILURE" ! grep -rq 'REPEATED FAILURE' "$NDIR/logs"
check_absent  "case9 not skipped" "$NDIR/skipped/plan-none.md"

# ===========================================================================
echo ""
if [ "$FAILED" -ne 0 ]; then
    echo "RESULT: FAILED"
    exit 1
fi
echo "RESULT: all passed"
exit 0
