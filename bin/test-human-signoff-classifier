# ---- race-fix wiring in human-signoff.yml (static) ----
HS_WF="$REPO_ROOT/.github/workflows/human-signoff.yml"
# hs_job_block <job_id> — the job's lines, up to the next top-level job key.
hs_job_block() { awk -v j="  $1:" '$0 == j {f=1; print; next} f && /^  [A-Za-z0-9_-]+:$/ {f=0} f' "$HS_WF"; }
GATE_BLOCK=$(hs_job_block human-signoff)
WRITE_BLOCK=$(hs_job_block human-approved-fingerprint)
gate_to=$(sed -nE 's/^    timeout-minutes: ([0-9]+)$/\1/p' <<< "$GATE_BLOCK")
write_to=$(sed -nE 's/^    timeout-minutes: ([0-9]+)$/\1/p' <<< "$WRITE_BLOCK")
aw_n=$(sed -nE "s/^          HS_AWAIT_ATTEMPTS: '([0-9]+)'$/\1/p" <<< "$GATE_BLOCK")
aw_s=$(sed -nE "s/^          HS_AWAIT_SLEEP: '([0-9]+)'$/\1/p" <<< "$GATE_BLOCK")
if [ -n "$gate_to" ] && [ -n "$aw_n" ] && [ -n "$aw_s" ] \
   && [ $((aw_n * aw_s * 2)) -le $((gate_to * 60)) ]; then
    h_pass "wf: wait budget fits twice in the gate timeout"
else
    h_fail "wf: wait budget fits twice in the gate timeout" "timeout=[$gate_to] attempts=[$aw_n] sleep=[$aw_s]"
fi
if [ -n "$write_to" ]; then h_pass "wf: write job has timeout-minutes"; else h_fail "wf: write job has timeout-minutes" "none"; fi
# A job-level permissions block zeroes every scope it omits, so the write job's
# checkout of the shared lib needs contents: read.
write_perms=$(awk '/^    permissions:$/ {f=1; next} f && /^      / {print; next} f {exit}' <<< "$WRITE_BLOCK")
if command grep -qxF '      contents: read' <<< "$write_perms"; then
    h_pass "wf: write job grants contents: read for its checkout"
else
    h_fail "wf: write job grants contents: read for its checkout" "permissions=[$write_perms]"
fi
# shellcheck disable=SC2016  # literal workflow text
want "wf: eval step calls hs_await_record" "$GATE_BLOCK" 'hs_await_record "$HS_AWAIT_ATTEMPTS" "$HS_AWAIT_SLEEP" hs_refetch_comments'
# The eval-step guard admits the bounded wait for drop missing and drop mismatch only.
HS_GUARD=$(printf '%s\n' "$GATE_BLOCK" | command grep -E '^[[:space:]]*if .*HS_DROP_REASON' \
    | sed -E 's/^[[:space:]]*if (.*); then$/\1/')
if [ "$(printf '%s\n' "$HS_GUARD" | grep -c .)" = 1 ]; then
    h_pass "guard: exactly one HS_DROP_REASON guard in the eval step"
else
    h_fail "guard: exactly one HS_DROP_REASON guard in the eval step" "got: $HS_GUARD"
fi
guard_says() {
    [ -n "$HS_GUARD" ] || { echo EMPTY; return 0; }
    # shellcheck disable=SC2016  # expands in the child bash
    HS_VERDICT="$1" HS_DROP_REASON="$2" bash -c 'if eval "$1"; then echo ADMIT; else echo SKIP; fi' _ "$HS_GUARD"
}
want "guard: drop missing admits the wait" "$(guard_says drop missing)" "ADMIT"
want "guard: drop mismatch admits the wait" "$(guard_says drop mismatch)" "ADMIT"
want "guard: drop error skips the wait" "$(guard_says drop error)" "SKIP"
want "guard: near-miss reason mismatched skips the wait" "$(guard_says drop mismatched)" "SKIP"
want "guard: keep skips the wait" "$(guard_says keep "")" "SKIP"
# shellcheck disable=SC2016  # literal workflow text
want "wf: eval step reads issue events" "$GATE_BLOCK" '"repos/$GH_REPO/issues/$PR/events"'
# shellcheck disable=SC2016  # literal workflow text
want "wf: write job guards the record" "$WRITE_BLOCK" 'hs_record_write_ok "$APPROVED_AT" "$LABELS_NOW"'
want "wf: gate publishes approved_at" "$GATE_BLOCK" 'approved_at: ${{ steps.eval.outputs.approved_at }}'
# shellcheck disable=SC2016  # literal workflow text
want "wf: drop still deletes the label" "$WRITE_BLOCK" 'gh api --method DELETE "repos/$GH_REPO/issues/$PR/labels/human-approved"'
src_ln=$(command grep -nF 'source bin/lib/human-signoff-classifier.sh' <<< "$WRITE_BLOCK" | cut -d: -f1)
rec_ln=$(command grep -nF 'if [ "$VERDICT" = "record" ]; then' <<< "$WRITE_BLOCK" | cut -d: -f1)
if [ -n "$src_ln" ] && [ -n "$rec_ln" ] && [ "$src_ln" -gt "$rec_ln" ]; then
    h_pass "wf: drop path never sources the lib"
else
    h_fail "wf: drop path never sources the lib" "source line [$src_ln] record-if line [$rec_ln]"
fi

# ---- trusted lib: both jobs load the classifier from the BASE ref ----
# trusted_lib_ok <workflow-file> — rc 0 when the gate sources both libs from
# the .hs-base checkout of base.sha, runs no head-relative bin/ script, and the
# write job checks out base.sha (never head.sha).
trusted_lib_ok() {
    local wf="$1" gate write
    gate=$(awk -v j="  human-signoff:" '$0 == j {f=1; print; next} f && /^  [A-Za-z0-9_-]+:$/ {f=0} f' "$wf")
    write=$(awk -v j="  human-approved-fingerprint:" '$0 == j {f=1; print; next} f && /^  [A-Za-z0-9_-]+:$/ {f=0} f' "$wf")
    # shellcheck disable=SC2016  # literal workflow text
    command grep -qF 'HS_LIB="$GITHUB_WORKSPACE/.hs-base/bin/lib"' <<< "$gate" || return 1
    # shellcheck disable=SC2016  # literal workflow text
    command grep -qF 'source "$HS_LIB/ui-change-classifier.sh"' <<< "$gate" || return 1
    # shellcheck disable=SC2016  # literal workflow text
    command grep -qF 'source "$HS_LIB/human-signoff-classifier.sh"' <<< "$gate" || return 1
    command grep -qE '(source|\.) +"?(\./)?bin/' <<< "$gate" && return 1
    command grep -qE '^[[:space:]]*"?(\./)?bin/' <<< "$gate" && return 1
    command grep -qF 'path: .hs-base' <<< "$gate" || return 1
    # shellcheck disable=SC2016  # literal workflow text
    [ "$(command grep -cF 'ref: ${{ github.event.pull_request.base.sha }}' <<< "$gate")" = 1 ] || return 1
    # shellcheck disable=SC2016  # literal workflow text
    command grep -qF 'ref: ${{ github.event.pull_request.head.sha }}' <<< "$write" && return 1
    # shellcheck disable=SC2016  # literal workflow text
    command grep -qF 'ref: ${{ github.event.pull_request.base.sha }}' <<< "$write" || return 1
    return 0
}
if trusted_lib_ok "$HS_WF"; then
    h_pass "wf: gate and write job load the classifier from base"
else
    h_fail "wf: gate and write job load the classifier from base" "head-sourced lib or no base checkout"
fi
# Negative paths: each scratch copy reintroduces one head-sourced load.
TL_DIR=$(mktemp -d)
# shellcheck disable=SC2016  # literal workflow text
sed 's|source "$HS_LIB/ui-change-classifier.sh"|source bin/lib/ui-change-classifier.sh|' "$HS_WF" > "$TL_DIR/head-ui.yml"
# shellcheck disable=SC2016  # literal workflow text
sed 's|source "$HS_LIB/human-signoff-classifier.sh"|source "$HS_LIB/human-signoff-classifier.sh"; source bin/lib/human-signoff-classifier.sh|' "$HS_WF" > "$TL_DIR/head-hs.yml"
# shellcheck disable=SC2016  # literal workflow text
sed 's|ref: ${{ github.event.pull_request.base.sha }}|ref: ${{ github.event.pull_request.head.sha }}|' "$HS_WF" > "$TL_DIR/head-ref.yml"
for neg in head-ui head-hs head-ref; do
    if trusted_lib_ok "$TL_DIR/$neg.yml"; then
        h_fail "wf: trusted-lib guard rejects $neg" "accepted"
    else
        h_pass "wf: trusted-lib guard rejects $neg"
    fi
done
rm -rf "$TL_DIR"
# A base without the new classifier holds instead of crashing under set -e.
# shellcheck disable=SC2016  # literal workflow text
want "wf: a base without the classifier holds" "$GATE_BLOCK" 'echo "verdict=hold" >> "$GITHUB_OUTPUT"'

# run_write <approved_at> <labels> <events_file> <comments_file> — prints WRITE_RC=<rc>.
run_write() {
    # shellcheck disable=SC2016  # expands in the child bash
    LAST_OUT=$(bash -c 'set -euo pipefail; source "$0"; rc=0; hs_record_write_ok "$@" || rc=$?; echo "WRITE_RC=$rc"' "$LIB" "$@" 2>&1)
}
# run_label_at <events_file> — prints LABEL_AT=<ts> LABEL_RC=<rc>.
run_label_at() {
    # shellcheck disable=SC2016  # expands in the child bash
    LAST_OUT=$(bash -c 'set -euo pipefail; source "$0"; rc=0; v=$(hs_newest_label_at "$1") || rc=$?; echo "LABEL_AT=$v LABEL_RC=$rc"' "$LIB" "$@" 2>&1)
}

# R1-R11: the write-time guard. Approval time is the PR #3685 label event.
wr_mk() { mkdir -p "$T/wr-$1"; printf '[]' > "$T/wr-$1/c.json"; event_json labeled human-approved "$LBL_AT" | jq -s . > "$T/wr-$1/e.json"; }
wr_mk r1
run_write "$LBL_AT" human-approved "$T/wr-r1/e.json" "$T/wr-r1/c.json"
want "write: PR 3685, nothing newer -> write" "$LAST_OUT" "WRITE_RC=0"
wr_mk r2
comment_json "$BOT" Bot "2026-11-02T23:01:00Z" "$(drop_body missing)" | jq -s . > "$T/wr-r2/c.json"
run_write "$LBL_AT" human-approved "$T/wr-r2/e.json" "$T/wr-r2/c.json"
want "write: revoke after approval -> skip" "$LAST_OUT" "WRITE_RC=1"
wr_mk r3
comment_json "$BOT" Bot "$LBL_AT" "$(drop_body missing)" | jq -s . > "$T/wr-r3/c.json"
run_write "$LBL_AT" human-approved "$T/wr-r3/e.json" "$T/wr-r3/c.json"
want "write: revoke same second -> skip" "$LAST_OUT" "WRITE_RC=1"
wr_mk r4
comment_json "$BOT" Bot "2026-11-02T22:50:00Z" "$(drop_body missing)" | jq -s . > "$T/wr-r4/c.json"
run_write "$LBL_AT" human-approved "$T/wr-r4/e.json" "$T/wr-r4/c.json"
want "write: revoke before approval -> write" "$LAST_OUT" "WRITE_RC=0"
wr_mk r5
{ event_json labeled human-approved "$LBL_AT"; event_json labeled human-approved "2026-11-02T23:05:00Z"; } | jq -s . > "$T/wr-r5/e.json"
run_write "$LBL_AT" human-approved "$T/wr-r5/e.json" "$T/wr-r5/c.json"
want "write: newer approval label -> skip" "$LAST_OUT" "WRITE_RC=1"
wr_mk r6
comment_json "$BOT" Bot "2026-11-02T23:01:00Z" "$(record_body "$A")" | jq -s . > "$T/wr-r6/c.json"
run_write "$LBL_AT" human-approved "$T/wr-r6/e.json" "$T/wr-r6/c.json"
want "write: newer record from another run -> write" "$LAST_OUT" "WRITE_RC=0"
wr_mk r7
run_write "$LBL_AT" needs-a-human "$T/wr-r7/e.json" "$T/wr-r7/c.json"
want "write: label removed -> skip" "$LAST_OUT" "WRITE_RC=1"
wr_mk r8
run_write "$LBL_AT" human-approved-x "$T/wr-r8/e.json" "$T/wr-r8/c.json"
want "write: lookalike label only -> skip" "$LAST_OUT" "WRITE_RC=1"
wr_mk r9
run_write "" human-approved "$T/wr-r9/e.json" "$T/wr-r9/c.json"
want "write: empty approved_at -> error" "$LAST_OUT" "WRITE_RC=2"
wr_mk r10
printf '{}' > "$T/wr-r10/c.json"
run_write "$LBL_AT" human-approved "$T/wr-r10/e.json" "$T/wr-r10/c.json"
want "write: comments not an array -> error" "$LAST_OUT" "WRITE_RC=2"
wr_mk r11
comment_json "$BOT" User "2026-11-02T23:01:00Z" "$(drop_body missing)" | jq -s . > "$T/wr-r11/c.json"
run_write "$LBL_AT" human-approved "$T/wr-r11/e.json" "$T/wr-r11/c.json"
want "write: forged non-bot revoke -> write" "$LAST_OUT" "WRITE_RC=0"

# L1-L3: the newest label event.
wr_mk l1
{ event_json labeled human-approved "2026-11-02T23:05:00Z"; event_json labeled human-approved "$LBL_AT"; } | jq -s . > "$T/wr-l1/e.json"
