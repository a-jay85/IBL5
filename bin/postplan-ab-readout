#!/usr/bin/env bash
# Post-plan closer A/B readout. Logic: tools/postplan-harness/harness/ab_readout.py
set -euo pipefail
case "${1:-}" in
    -h|--help)
        cat <<'EOF'
Usage: postplan-ab-readout [--state-dir <path>] [--rows] [--json] [--offline]

Per-arm readout for the post-plan closer A/B: cost, time to merge,
human touches, and reverts for every enrolled PR.

  --state-dir <path>  harness state dir (default: tools/postplan-harness/out/state)
  --rows              print one JSON record per PR
  --json              print the per-arm summary as JSON
  --offline           skip GitHub and git lookups
EOF
        exit 0 ;;
esac
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHONPATH="$ROOT/tools/postplan-harness" exec python3 -m harness.ab_readout "$@"
