#!/usr/bin/env bash
# Usage: bin/after-merge-checklist --pr-number N --pr-url URL --title TITLE --pr-body-file FILE [--comment-out FILE] [--dm-out FILE] [--dry-run]
#   Reads the `## After merge` section of a merged PR's body and, when it carries
#   `- **Row N** — text` bullets, posts them as ONE checkbox comment on the PR and writes
#   a Discord-sized DM. The section ends at `<!-- after-merge:end -->`, the next `## `
#   heading, or EOF; only lines matching `^- (\[ \] )?\*\*Row` are forwarded.
#   --comment-out defaults to /tmp/after-merge-comment.md, --dm-out to /tmp/discord-msg.txt.
#   Prints one `status=<value>` line on stdout, and appends the same line to the file
#   named by $GITHUB_OUTPUT when that variable is set and non-empty:
#     posted    the comment was posted; both files are written
#     skipped   the PR already carries an after-merge-checklist comment (redelivered
#               event); the DM file is removed, nothing is posted
#     absent    no `## After merge` rows; nothing is written or posted
#     dry-run   both files are written, no gh call is made
#   An unknown flag, a missing required flag, or an unreadable body file exits 2 with a
#   message on stderr. A failing gh call exits 1.
#
# Consumed by .github/workflows/merge-digest-notify.yml. Contract and rationale: the
# post-merge-rows plan and its ADR. The flag parser, UTF-8 locale pick and character-wise
# truncation are copied from bin/digest-dm-build.

set -euo pipefail

MARKER='<!-- after-merge-checklist -->'
END_ANCHOR='<!-- after-merge:end -->'
TITLE_MAX=80
ROW_DM_MAX=200
DM_BODY_MAX=1800   # stop adding rows past this; .github/actions/notify-discord truncates at 1900
DM_HARD_MAX=1900

# Character-wise truncation needs a UTF-8 locale; the name differs by platform. See the
# note above _pick_utf8_locale in bin/digest-dm-build. A herestring, not a pipe, so an
# early `return` cannot take SIGPIPE under pipefail (.claude/rules/shell-pipefail-grep.md).
_pick_utf8_locale() {
    local _l
    while IFS= read -r _l; do
        case "$_l" in
            C.UTF-8|C.utf8|en_US.UTF-8|en_US.utf8) printf '%s' "$_l"; return 0 ;;
        esac
    done <<< "$(locale -a 2>/dev/null || true)"
    return 1
}
_LOC="$(_pick_utf8_locale || true)"
if [ -n "$_LOC" ]; then
    export LC_ALL="$_LOC"
fi

PR_NUMBER=""
PR_URL=""
TITLE=""
PR_BODY_FILE=""
COMMENT_OUT="/tmp/after-merge-comment.md"
DM_OUT="/tmp/discord-msg.txt"
DRY_RUN=0

_need_value() {
    if [ "$2" -lt 2 ]; then
        printf 'after-merge-checklist: %s needs a value\n' "$1" >&2
        exit 2
    fi
}
while [ $# -gt 0 ]; do
    case "$1" in
        --pr-number)    _need_value "$1" $#; PR_NUMBER="$2";    shift 2 ;;
        --pr-url)       _need_value "$1" $#; PR_URL="$2";       shift 2 ;;
        --title)        _need_value "$1" $#; TITLE="$2";        shift 2 ;;
        --pr-body-file) _need_value "$1" $#; PR_BODY_FILE="$2"; shift 2 ;;
        --comment-out)  _need_value "$1" $#; COMMENT_OUT="$2";  shift 2 ;;
        --dm-out)       _need_value "$1" $#; DM_OUT="$2";       shift 2 ;;
        --dry-run)      DRY_RUN=1; shift ;;
        -h|--help)
            sed -n '/^# Usage:/,/^#$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)
            printf 'after-merge-checklist: unknown argument: %s\n' "$1" >&2
            exit 2 ;;
    esac
done

if [ -z "$PR_NUMBER" ] || [ -z "$PR_URL" ] || [ -z "$TITLE" ] || [ -z "$PR_BODY_FILE" ]; then
    printf 'after-merge-checklist: --pr-number, --pr-url, --title and --pr-body-file are all required\n' >&2
    exit 2
fi
case "$PR_NUMBER" in
    ''|*[!0-9]*)
        printf 'after-merge-checklist: --pr-number must be digits, got: %s\n' "$PR_NUMBER" >&2
        exit 2 ;;
esac
if [ ! -r "$PR_BODY_FILE" ] || [ -d "$PR_BODY_FILE" ]; then
    printf 'after-merge-checklist: --pr-body-file not readable: %s\n' "$PR_BODY_FILE" >&2
    exit 2
fi

# _emit_status VALUE -- stdout always; $GITHUB_OUTPUT too when set and non-empty.
_emit_status() {
    printf 'status=%s\n' "$1"
    if [ -n "${GITHUB_OUTPUT:-}" ]; then
        printf 'status=%s\n' "$1" >> "$GITHUB_OUTPUT"
    fi
}

# _trunc MAX VALUE -- character-wise; U+2026 replaces the last kept character on a cut.
_trunc() {
    local _m="$1" _v="$2"
    if [ "${#_v}" -le "$_m" ]; then
        printf '%s' "$_v"
        return 0
    fi
    printf '%s…' "${_v:0:$((_m - 1))}"
}

# Section: from `## After merge` to the next `## ` heading, then cut at the end anchor.
# Each stage is a variable assignment fed by a herestring, so no producer can take SIGPIPE.
SECTION="$(sed -n '/^## After merge/,/^## /p' "$PR_BODY_FILE")"
SECTION="$(awk -v a="$END_ANCHOR" 'index($0, a) { exit } { print }' <<< "$SECTION")"
ROWS_RAW="$(grep -E '^- (\[ \] )?\*\*Row' <<< "$SECTION" || true)"

if [ -z "$ROWS_RAW" ]; then
    _emit_status absent
    exit 0
fi

# A zero-width space after each `@`: the text renders but never notifies anyone.
ZWSP="$(printf '\342\200\213')"

ROWS=()
while IFS= read -r line; do
    line="${line%$'\r'}"
    line="${line//@/@$ZWSP}"
    row="${line#- }"
    row="${row#\[ \] }"
    ROWS+=("$row")
done <<< "$ROWS_RAW"

PR_NUMBER_REF="#$PR_NUMBER"
TITLE_SAFE="${TITLE//@/@$ZWSP}"

# Comment file.
{
    printf '%s\n' "$MARKER"
    printf '## After merge checklist for %s\n\n' "$PR_NUMBER_REF"
    printf 'These steps need a person after the merge of %s.\n\n' "$PR_NUMBER_REF"
    for row in "${ROWS[@]}"; do
        printf -- '- [ ] %s\n' "$row"
    done
    printf '\nTick each box as you complete it.\n'
} > "$COMMENT_OUT"

# DM file. Rows stop being added once the body would pass DM_BODY_MAX characters.
DM="After merge: $PR_NUMBER_REF $(_trunc "$TITLE_MAX" "$TITLE_SAFE")"$'\n'"$PR_URL"
TOTAL="${#ROWS[@]}"
ADDED=0
for row in "${ROWS[@]}"; do
    plain="${row//\*\*/}"
    dm_line="• $(_trunc "$ROW_DM_MAX" "$plain")"
    if [ $(( ${#DM} + 1 + ${#dm_line} )) -gt "$DM_BODY_MAX" ]; then
        break
    fi
    DM="$DM"$'\n'"$dm_line"
    ADDED=$((ADDED + 1))
done
if [ "$ADDED" -lt "$TOTAL" ]; then
    DM="$DM"$'\n'"…(+$((TOTAL - ADDED)) more rows in the PR comment)"
fi
# Backstop for an absurdly long URL: never above what notify-discord would cut anyway.
DM="$(_trunc "$DM_HARD_MAX" "$DM")"
printf '%s\n' "$DM" > "$DM_OUT"

if [ "$DRY_RUN" = 1 ]; then
    _emit_status dry-run
    exit 0
fi

# Idempotency: a redelivered merge event must not post twice.
if ! EXISTING="$(gh pr view "$PR_NUMBER" --json comments \
        --jq '[.comments[].body | select(contains("<!-- after-merge-checklist -->"))] | length')"; then
    printf 'after-merge-checklist: gh pr view failed for #%s\n' "$PR_NUMBER" >&2
    exit 1
fi
case "$EXISTING" in
    ''|*[!0-9]*)
        printf 'after-merge-checklist: unexpected gh pr view output: %s\n' "$EXISTING" >&2
        exit 1 ;;
esac
if [ "$EXISTING" -gt 0 ]; then
    rm -f "$DM_OUT"
    _emit_status skipped
    exit 0
fi

if ! gh pr comment "$PR_NUMBER" --body-file "$COMMENT_OUT"; then
    printf 'after-merge-checklist: gh pr comment failed for #%s\n' "$PR_NUMBER" >&2
    exit 1
fi
_emit_status posted
