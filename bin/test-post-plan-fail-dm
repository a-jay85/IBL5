#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-post-plan-fail-dm — cases for bin/post-plan-fail-dm (the exit-3 DM hold).
#
#   1. No live session in the worktree: DM now, no launchd job.
#   2. Live session in the worktree: no DM now, one held job scheduled.
#   3. Live session in a different worktree: DM now.
#   4. Registry unreadable (missing, or malformed JSON): DM now (fail open).
#   5. launchctl submit fails: DM now.
#   6. Held job, newer log for the branch: no DM.
#   7. Held job, no newer log: DM, prefixed so you know nobody re-ran it.
#   8. Held job, newer log for a longer branch name ("foo-bar" vs "foo"): still DMs.
#   9. Static: every DM goes through dm_ping, which passes --ping.
#  10. Live headless session (argv has -p) in the worktree: DM now, no job.
#  11. Live headless session (argv has --print): DM now, no job.
#  12. Live interactive session whose argv only contains "-p" inside other tokens: DM held.
#  13. Headless and interactive sessions in the same worktree: DM held.
#  14. ps cannot read the live pid's argv: DM held (counts as live).
#  16. Generic blocked_ship_block (no blocked-ship.txt) ends with the postplan-fix
#      paste line, and the DM body keeps it as its last line.
#
# 5 (bootstrap) now means ljob_submit fails. Cases named faildm_* cover the submit argv,
# the self-deleting per-run script, and the fallbacks.
#
# launchctl and discord-dm are stubbed; nothing leaves the machine.
# Run: bin/test-post-plan-fail-dm  (exit 0 = all pass, 1 = a case failed)

set -u

# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

ROOT=$(cd "$(dirname "$0")/.." && pwd)
SUT="$ROOT/bin/post-plan-fail-dm"

ok()   { h_pass "$1"; }
fail() { h_fail "$@"; }

TMP=$(mktemp -d "${TMPDIR:-/tmp}/test-post-plan-fail-dm.XXXXXX")
STUBS=""
trap 'kill $STUBS 2>/dev/null; rm -rf "$TMP"' EXIT
# Real-agents-dir leak guard (same idea as unit 1's guard in bin/test-plan-now,
# scoped to the three launchers converted in this unit). Captured before any
# HOME override; compared at the end of the file.
REAL_AGENTS="$HOME/Library/LaunchAgents"
real_agents_names() {
    find "$REAL_AGENTS" -maxdepth 1 -type f \
        \( -name 'com.ibl5.docfix-run-*' -o -name 'com.ibl5.pr-cycle-*' \
           -o -name 'com.ibl5.postplan-faildm-*' \) 2>/dev/null | sort
}
REAL_AGENTS_BEFORE="$(real_agents_names)"
# Sandbox HOME, and a PATH launchctl that records any call that bypasses the
# FAILDM_LAUNCHCTL seam. Submit writes no file, so the agents-dir guard alone
# cannot see a real-launchctl leak; this file can.
export HOME="$TMP/home"
mkdir -p "$HOME/Library/LaunchAgents" "$TMP/leakbin"
printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >> %q\nexit 1\n' "$TMP/launchctl.LEAK" > "$TMP/leakbin/launchctl"
chmod +x "$TMP/leakbin/launchctl"
export PATH="$TMP/leakbin:$PATH"
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/usage-test-isolation.sh"; usage_test_isolate "$TMP/usage"

WT="$TMP/wt"; OTHER="$TMP/other"; LOGS="$TMP/logs"
mkdir -p "$WT" "$OTHER" "$LOGS" "$TMP/bin"
DM_OUT="$TMP/dm.out"; DM_ARGV="$TMP/dm.argv"; LC_OUT="$TMP/lc.out"

cat > "$TMP/bin/dm" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\${*: -1}" >> "$DM_OUT"
printf '%s\n' "\$*" >> "$DM_ARGV"
EOF
cat > "$TMP/bin/lc-ok" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "$LC_OUT"
EOF
printf '#!/usr/bin/env bash\nexit 5\n' > "$TMP/bin/lc-bad"
chmod +x "$TMP/bin/"*

registry() {   # registry <repo> <pid>
    printf '{"x":{"repo":"%s","pid":%s}}\n' "$1" "$2" > "$TMP/reg.json"
}
registry2() {   # registry2 <repo> <pid-a> <pid-b>  (entry a is iterated first)
    printf '{"a":{"repo":"%s","pid":%s},"b":{"repo":"%s","pid":%s}}\n' \
        "$1" "$2" "$1" "$3" > "$TMP/reg.json"
}

# A fake "claude" whose argv ps can read. "sleep 60; :" keeps bash from
# exec-replacing itself with sleep, so the pid keeps the stub's argv.
cat > "$TMP/bin/claude" <<'EOF'
#!/usr/bin/env bash
sleep 60; :
EOF
chmod +x "$TMP/bin/claude"
mkdir -p "$TMP/psbad"
printf '#!/usr/bin/env bash\nexit 1\n' > "$TMP/psbad/ps"
chmod +x "$TMP/psbad/ps"

# spawn_stub <args...>: start the stub, wait until ps shows its argv, set STUB_PID.
spawn_stub() {
    "$TMP/bin/claude" "$@" &
    STUB_PID=$!
    STUBS="$STUBS $STUB_PID"
    local i
    for i in $(seq 1 50); do
        grep -qF -- "$TMP/bin/claude" <<< "$(ps -ww -o command= -p "$STUB_PID" 2>/dev/null)" && return 0
        sleep 0.1
    done
    fail "stub never exposed its argv: $*"
}

LOG="$LOGS/post-plan-now-foo-20260926-182719-111.log"

reset() {
    rm -f "$DM_OUT" "$DM_ARGV" "$LC_OUT" "$LOGS"/* "$TMP/reg.json"
    : > "$LOG"
}

faildm_script() { printf '%s/postplan-faildm-%s.sh' "$LOGS" "$(basename "$LOG" .log | sed 's/^post-plan-now-//')"; }

run() {   # run [--deferred]
    FAILDM_REGISTRY="$TMP/reg.json" FAILDM_DM_CMD="$TMP/bin/dm" \
    FAILDM_LAUNCHCTL="${LC:-$TMP/bin/lc-ok}" \
    FAILDM_LOG_DIR="$LOGS" FAILDM_DELAY="${HOLD_DELAY:-900}" \
        "$SUT" "$@" "$WT" foo "$LOG" "the-msg" >/dev/null 2>&1
}

dm_count() { [ -f "$DM_OUT" ] && wc -l < "$DM_OUT" | tr -d ' ' || echo 0; }
lc_count() { [ -f "$LC_OUT" ] && wc -l < "$LC_OUT" | tr -d ' ' || echo 0; }

echo "post-plan-fail-dm:"

reset; registry "$WT" 999999
run
[ "$(dm_count)" = 1 ] && [ "$(lc_count)" = 0 ] && ok "1 dead session: DM now" || fail "1 dead session: DM now"
grep -qF -- '--ping' <<< "$(cat "$DM_ARGV" 2>/dev/null)" \
    && ok "1b immediate DM carries --ping" || fail "1b immediate DM lacks --ping"
[ "$(tail -n 1 "$DM_ARGV")" = "--ping --quiet --attempts 2 the-msg" ] \
    && ok "1c immediate DM argv is --ping --quiet --attempts 2 <msg>" \
    || fail "1c immediate DM argv: $(tail -n 1 "$DM_ARGV")"

reset; registry "$WT" $$
run
[ "$(dm_count)" = 0 ] && [ "$(lc_count)" = 1 ] && [ -f "$LOG.faildm-stamp" ] \
    && ok "2 live session: DM held" || fail "2 live session: DM held"
# faildm_submit_argv: one recorded call, the submit argv, a self-deleting 0700
# script, and nothing in the sandbox agents dir or the leak shim.
S="$(faildm_script)"
LC_LINE="$(cat "$LC_OUT" 2>/dev/null)"
if [ "$(lc_count)" = 1 ] \
    && grep -qF -- 'submit -l com.ibl5.postplan-faildm-' <<< "$LC_LINE" \
    && grep -qF -- "-o $LOG -e $LOG" <<< "$LC_LINE" \
    && [ -f "$S" ] && [ -x "$S" ] && [ -n "$(find "$S" -perm 700)" ] \
    && [ "$(sed -n 2p "$S")" = "rm -f '$S'" ] \
    && grep -qF -- '--deferred' "$S" \
    && [ -z "$(ls -A "$HOME/Library/LaunchAgents")" ] \
    && [ ! -e "$TMP/launchctl.LEAK" ]; then
    ok "faildm_submit_argv: one submit call, 0700 self-deleting script, no agents-dir file"
else
    fail "faildm_submit_argv: calls=$(lc_count) argv=$LC_LINE script=$S"
fi

reset; registry "$OTHER" $$
run
[ "$(dm_count)" = 1 ] && [ "$(lc_count)" = 0 ] && ok "3 other worktree: DM now" || fail "3 other worktree: DM now"

reset
run
[ "$(dm_count)" = 1 ] && ok "4 no registry: DM now" || fail "4 no registry: DM now"

reset
printf '{"broken": ' > "$TMP/reg.json"
run
[ "$(dm_count)" = 1 ] && [ "$(lc_count)" = 0 ] && ok "4b malformed registry: DM now" || fail "4b malformed registry: DM now"

reset; registry "$WT" $$
LC="$TMP/bin/lc-bad" run
[ "$(dm_count)" = 1 ] && [ ! -f "$LOG.faildm-stamp" ] && [ ! -e "$(faildm_script)" ] \
    && ok "faildm_submit_fail_cleans: 5 submit fails: DM now, no stamp, no script" \
    || fail "faildm_submit_fail_cleans: 5 submit fails: DM now (dm=$(dm_count))"

# faildm_bad_label_falls_back: "+" is outside the label charset, so ljob_submit
# returns 2 before any launchctl call.
SAVED_LOG="$LOG"
LOG="$LOGS/post-plan-now-a+b-20261021-120000-1.log"
reset; registry "$WT" $$
run
[ "$(lc_count)" = 0 ] && [ "$(dm_count)" = 1 ] && [ ! -e "$(faildm_script)" ] \
    && [ ! -f "$LOG.faildm-stamp" ] \
    && ok "faildm_bad_label_falls_back: bad label sends the DM now, leaves no script or stamp" \
    || fail "faildm_bad_label_falls_back: lc=$(lc_count) dm=$(dm_count)"
LOG="$SAVED_LOG"

# faildm_script_runs_once_selfdeletes: run the generated script with no delay.
reset; registry "$WT" $$
HOLD_DELAY=0 run
S="$(faildm_script)"
bash "$S" >/dev/null 2>&1; SRC=$?
if [ "$SRC" = 0 ] && [ "$(dm_count)" = 1 ] && grep -qF -- 'Nobody re-ran it' "$DM_OUT" \
    && [ ! -e "$S" ] && [ ! -f "$LOG.faildm-stamp" ] && [ "$(lc_count)" = 1 ] \
    && [ ! -e "$TMP/launchctl.LEAK" ]; then
    ok "faildm_script_runs_once_selfdeletes: script ran, one DM, script and stamp gone, no extra launchctl"
else
    fail "faildm_script_runs_once_selfdeletes: rc=$SRC dm=$(dm_count) script=$([ -e "$S" ] && echo present || echo gone) lc=$(lc_count)"
fi

# faildm_kill_leaves_no_script: a SIGKILL during the hold leaves no script and no DM.
reset; registry "$WT" $$
HOLD_DELAY=30 run
S="$(faildm_script)"
bash "$S" >/dev/null 2>&1 &
KJOB=$!
for _i in $(seq 1 20); do [ -e "$S" ] || break; sleep 0.1; done
for _i in $(seq 1 20); do KKIDS=$(pgrep -P "$KJOB"); [ -n "$KKIDS" ] && break; sleep 0.1; done
# Kill the script's bash BEFORE its sleep. Killing sleep first lets bash run the
# next line (the --deferred DM) before its own SIGKILL lands. That stray DM then
# reached DM_OUT a moment later and broke case 7 in CI.
kill -9 "$KJOB" 2>/dev/null
wait "$KJOB" 2>/dev/null
# shellcheck disable=SC2086 # KKIDS is a pid list
[ -n "$KKIDS" ] && kill -9 $KKIDS 2>/dev/null
# Give a leaked --deferred run time to write, so a leak fails here, not in case 7.
sleep 0.5
[ ! -e "$S" ] && [ ! -s "$DM_OUT" ] \
    && ok "faildm_kill_leaves_no_script: SIGKILL during the hold leaves no script and no DM" \
    || fail "faildm_kill_leaves_no_script: script=$([ -e "$S" ] && echo present || echo gone) dm=$(dm_count)"

reset; touch -t 202609261800 "$LOG.faildm-stamp"
: > "$LOGS/post-plan-now-foo-20260926-183043-222.log"
run --deferred
[ "$(dm_count)" = 0 ] && [ ! -f "$LOG.faildm-stamp" ] && ok "6 re-fired: no DM" || fail "6 re-fired: no DM"

reset; touch -t 202609261800 "$LOG.faildm-stamp"
touch -t 202609261800 "$LOG"
run --deferred
if [ "$(dm_count)" = 1 ] && grep -q '^Nobody re-ran it within 15 min.*the-msg$' "$DM_OUT"; then
    ok "7 not re-fired: prefixed DM"
else
    fail "7 not re-fired: prefixed DM"
fi
grep -qF -- '--ping' <<< "$(cat "$DM_ARGV" 2>/dev/null)" \
    && ok "7b deferred DM carries --ping" || fail "7b deferred DM lacks --ping"

reset; touch -t 202609261800 "$LOG.faildm-stamp"
: > "$LOGS/post-plan-now-foo-bar-20260926-183043-333.log"
run --deferred
[ "$(dm_count)" = 1 ] && ok "8 other branch log ignored" || fail "8 other branch log ignored"

# Static: the SUT sends only through dm_ping, and dm_ping always passes --ping.
_bare=$(grep -c '^ *"$DM_CMD"' "$SUT")
_via=$(grep -c '^ *dm_ping "$1" --quiet --attempts 2' "$SUT")
_lib=$(grep -cF '"$DM_CMD" --ping "$@" "$msg"' "$(dirname "$SUT")/lib/dm.sh")
[ "$_bare" = 0 ] && [ "$_via" -ge 1 ] && [ "$_lib" = 1 ] \
    && ok "9 every DM goes through dm_ping, which passes --ping" \
    || fail "9 DM path: bare=$_bare via-dm_ping=$_via lib-ping=$_lib"

spawn_stub -p hello;      HP=$STUB_PID
spawn_stub --print hello; HPRINT=$STUB_PID
spawn_stub --resume x-p --permission-mode default; INT=$STUB_PID

reset; registry "$WT" "$HP"
run
[ "$(dm_count)" = 1 ] && [ "$(lc_count)" = 0 ] && [ ! -f "$LOG.faildm-stamp" ] \
    && ok "10 headless -p: DM now" || fail "10 headless -p: DM now"

# Pins the --print token: a SUT whose token tuple is ("-p",) holds the DM and fails here.
reset; registry "$WT" "$HPRINT"
run
[ "$(dm_count)" = 1 ] && [ "$(lc_count)" = 0 ] \
    && ok "11 headless --print: DM now" || fail "11 headless --print: DM now"

reset; registry "$WT" "$INT"
run
[ "$(dm_count)" = 0 ] && [ "$(lc_count)" = 1 ] && [ -f "$LOG.faildm-stamp" ] \
    && ok "12 interactive (-p only inside tokens): DM held" \
    || fail "12 interactive (-p only inside tokens): DM held"

reset; registry2 "$WT" "$HP" "$INT"
run
[ "$(dm_count)" = 0 ] && [ "$(lc_count)" = 1 ] \
    && ok "13 headless + interactive: DM held" || fail "13 headless + interactive: DM held"

reset; registry "$WT" "$HP"
PATH="$TMP/psbad:$PATH" run
[ "$(dm_count)" = 0 ] && [ "$(lc_count)" = 1 ] \
    && ok "14 argv unreadable: DM held" || fail "14 argv unreadable: DM held"

# 15: an empty FAILDM_DM_CMD falls back to $ROOT/bin/discord-dm (:- semantics).
reset; registry "$WT" 999999
mkdir -p "$WT/bin"
cat > "$WT/bin/discord-dm" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "$TMP/default-dm.argv"
EOF
chmod +x "$WT/bin/discord-dm"
rm -f "$TMP/default-dm.argv"
FAILDM_REGISTRY="$TMP/reg.json" FAILDM_DM_CMD="" \
FAILDM_LAUNCHCTL="$TMP/bin/lc-ok" \
FAILDM_LOG_DIR="$LOGS" FAILDM_DELAY=900 \
    "$SUT" "$WT" foo "$LOG" "the-msg" >/dev/null 2>&1
[ "$(wc -l < "$TMP/default-dm.argv" 2>/dev/null | tr -d ' ')" = 1 ] \
    && [ "$(cat "$TMP/default-dm.argv")" = "--ping --quiet --attempts 2 the-msg" ] \
    && ok '15 empty FAILDM_DM_CMD falls back to $ROOT/bin/discord-dm' \
    || fail '15 empty FAILDM_DM_CMD falls back to $ROOT/bin/discord-dm'
rm -rf "${WT:?}/bin" "$TMP/default-dm.argv"

# 16: the generic exit-3 block (no blocked-ship.txt) ends with the postplan-fix paste line,
# and the DM sent through the SUT keeps that line last. Pins bin/post-plan-now's 5th arg.
reset; registry "$WT" 999999
GEN_BLOCK=$(bash -c 'source "$1" >/dev/null 2>&1; blocked_ship_block "$2" "$3" "$4" "$5" "$6"' \
    _ "$ROOT/bin/post-plan-now" "$TMP/no-run-dir" "feat/gen" "$WT" "$LOG" "/main/root")
FAILDM_REGISTRY="$TMP/reg.json" FAILDM_DM_CMD="$TMP/bin/dm" \
FAILDM_LAUNCHCTL="$TMP/bin/lc-ok" \
FAILDM_LOG_DIR="$LOGS" FAILDM_DELAY=900 \
    "$SUT" "$WT" foo "$LOG" "$GEN_BLOCK" >/dev/null 2>&1
[ "$(tail -n 1 "$DM_OUT")" = "/main/root/bin/postplan-fix feat/gen" ] \
    && [ "$(tail -n 2 "$DM_OUT" | head -n 1)" = "Or paste this to have Claude fix it:" ] \
    && [ "$(tail -n 3 "$DM_OUT" | head -n 1)" = "Log: $LOG" ] \
    && ! grep -qF "Or open Claude in that folder" "$DM_OUT" \
    && ok "16 generic block DM ends with the postplan-fix paste line" \
    || fail "16 generic block DM tail: $(tail -n 3 "$DM_OUT" 2>/dev/null)"

# no_plist_word: the launch path names no plist, no XML escaper, no plist dir seam.
grep -qiE 'plist|xml_escape|FAILDM_PLIST_DIR' "$SUT" \
    && fail "no_plist_word: $SUT still mentions plist/xml_escape/FAILDM_PLIST_DIR" \
    || ok "no_plist_word: $SUT has no plist, xml_escape or FAILDM_PLIST_DIR"

if [ -e "$TMP/launchctl.LEAK" ]; then
    echo "FAIL launchctl-leak: unseamed launchctl call: $(cat "$TMP/launchctl.LEAK")"
    exit 1
fi
echo "PASS launchctl-leak"
REAL_AGENTS_NEW="$(comm -13 <(printf '%s\n' "$REAL_AGENTS_BEFORE") <(real_agents_names) | grep -v '^$' || true)"
if [ -n "$REAL_AGENTS_NEW" ]; then
    echo "FAIL real-agents-guard: test wrote into $REAL_AGENTS: $REAL_AGENTS_NEW"
    exit 1
fi
echo "PASS real-agents-guard"

h_done
