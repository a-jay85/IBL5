<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ibl5.finding-class-scan</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-s</string>
		<string>/bin/bash</string>
		<string>@MAIN_WT@/bin/finding-class-scan</string>
	</array>
	<key>WorkingDirectory</key>
	<string>@MAIN_WT@</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>0</integer>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>15</integer>
	</dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:@HOME@/.local/bin</string>
		<key>HOME</key>
		<string>@HOME@</string>
		<key>FCS_STATE_DIR</key>
		<string>@HOME@/.local/state/ibl5-finding-class-scan</string>
	</dict>
	<key>StandardOutPath</key>
	<string>@HOME@/.local/state/ibl5-finding-class-scan/logs/run.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/.local/state/ibl5-finding-class-scan/logs/run.log</string>
</dict>
</plist>
