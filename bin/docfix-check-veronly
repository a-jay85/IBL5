#!/bin/bash
set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
Usage: bin/docfix-check-veronly [<slug>]

Decides whether the worktree's diff is verification-only and, if so, arms the
plan file for auto-merge. Docs under ibl5/docs/ and ibl5/classes/*/README.md
pass on a strictly-advancing last_verified: bump plus optional same-line numeric
edits; .claude/**/*.md, CLAUDE.md and AGENTS.md pass only on a lone frontmatter
last_verified: bump.

Arguments:
  <slug>   worktree branch slug (default: current branch)

Env vars:
  PLAN_FILE        absolute path to the plan file (default: ~/claude-plans/<slug>.md)
  DOCFIX_BASE_REF  base branch for merge-base diff (default: master)

Exit codes: 0 = PASS (plan armed), 1 = HOLD (predicate not met), 2 = usage/env error
EOF
    exit 0
fi

# bin/docfix-check-veronly [<slug>]
#
# Decides whether the worktree's realized diff is verification-only — every
# change is a lone last_verified: date bump, strictly advancing, exactly one
# plus/minus pair per file.  If so, arms the seeded plan file atomically:
#   (a) flips auto_merge: false → true (frontmatter only)
#   (b) deletes the ## Automouse Hold Justification section (to EOF or next ##)
#
# Steering markdown (.claude/**/*.md, CLAUDE.md, AGENTS.md) is held to a stricter tier: see check_steering_date_only.
#
# The predicate is fail-closed: any doubt holds.
#
# Exit codes / verdict lines:
#   0  docfix-check-veronly: PASS — armed <plan-path>
#   1  docfix-check-veronly: HOLD — <specific reason>     (predicate not met)
#   2  docfix-check-veronly: HOLD — <environment reason>  (usage/env failure)
#
# Env overrides (for tests):
#   PLAN_FILE       — absolute path to the plan file (default: ~/claude-plans/<slug>.md)
#   DOCFIX_BASE_REF — base branch for the merge-base diff (default: master)

# --- Env check: must be inside a git repository (before SLUG derivation) -----
if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
    echo "docfix-check-veronly: HOLD — not inside a git repository"
    exit 2
fi

# --- Step 2.1: Resolvable inputs ---------------------------------------------
SLUG="${1:-$(git rev-parse --abbrev-ref HEAD)}"
PLAN_FILE="${PLAN_FILE:-$HOME/claude-plans/$SLUG.md}"
BASE_REF="${DOCFIX_BASE_REF:-master}"

# Date regex (prefix-free — applied after stripping the +/- diff prefix).
# Do NOT quote when used in [[ =~ ]] — quoted RHS matches literally, not ERE.
DATE_RE='^last_verified: [0-9]{4}-[0-9]{2}-[0-9]{2}$'

# Mask all digit-runs with a placeholder.  BRE [0-9][0-9]* (not ERE +) for
# BSD sed.  printf '%s\n' instead of echo to avoid backslash mangling.
mask_numbers() { printf '%s\n' "$1" | sed 's/[0-9][0-9]*/__NUM__/g'; }

# path_tier <repo-relative path> — prints the allowlist tier for one diff row.
#   1  docfix allowlist: ibl5/docs/** or a depth-one ibl5/classes/*/README.md
#      (date bump + optional same-line numeric edits; Step 2.5 pair_hunk path)
#   2  agent-steering markdown: .claude/**/*.md, root CLAUDE.md, root AGENTS.md
#      (lone frontmatter last_verified: bump only; check_steering_date_only path)
#   0  everything else (holds)
# Bash `case` `*` matches `/`, so `.claude/*.md` covers every depth under .claude/
# but only markdown; `.claude/settings.json` or a hook script prints 0.
# CLAUDE.md / AGENTS.md are matched at the repo root only (a nested one prints
# 0): neither is tracked today, and root-only is the fail-closed choice.
path_tier() {
    case "$1" in
        ibl5/docs/*)              echo 1 ;;
        ibl5/classes/*/README.md) echo 1 ;;
        .claude/*.md)             echo 2 ;;
        CLAUDE.md|AGENTS.md)      echo 2 ;;
        *)                        echo 0 ;;
    esac
}

# pair_hunk — called at each @@ boundary and once after the final hunk.
# Reads HUNK_MINUS[0..HM_N-1] / HUNK_PLUS[0..HP_N-1] (diff-prefix already
# stripped).  Writes CONTENT_HOLD, DATE_PAIRS, NUM_PAIRS, OLD_DATE, NEW_DATE
# as globals; resets the buffers on success.
pair_hunk() {
    if [ "$HM_N" -ne "$HP_N" ]; then
        CONTENT_HOLD="unpaired change lines in '$path': hunk has ${HM_N} removed / ${HP_N} added"
        return
    fi
    i=0
    while [ "$i" -lt "$HM_N" ]; do
        a="${HUNK_MINUS[$i]}"
        b="${HUNK_PLUS[$i]}"
        i=$(( i + 1 ))
        # Date branch — classify by the last_verified: PREFIX, not a full regex
        # match.  A malformed date (last_verified: 2026-8-9) has the prefix but
        # fails DATE_RE, so it holds here rather than falling to numeric.
        if [ "${a#last_verified: }" != "$a" ] || [ "${b#last_verified: }" != "$b" ]; then
            if ! [[ "$a" =~ $DATE_RE ]] || ! [[ "$b" =~ $DATE_RE ]]; then
                CONTENT_HOLD="non-date change line in '$path': ${a:0:80}"
                return
            fi
            DATE_PAIRS=$(( DATE_PAIRS + 1 ))
            if [ "$DATE_PAIRS" -gt 1 ]; then
                CONTENT_HOLD="more than 1 last_verified pair in '$path' (found ${DATE_PAIRS})"
                return
            fi
            OLD_DATE="${a#last_verified: }"
            NEW_DATE="${b#last_verified: }"
            if [[ ! "$NEW_DATE" > "$OLD_DATE" ]]; then
                CONTENT_HOLD="date not strictly advancing in '$path': '$OLD_DATE' → '$NEW_DATE' (equal or backwards)"
                return
            fi
        else
            # Numeric branch — guard against the placeholder already present in
            # the raw text (skeleton comparison would be meaningless).
            case "$a" in *__NUM__*)
                CONTENT_HOLD="mask placeholder in change line in '$path': ${a:0:80}"
                return ;;
            esac
            case "$b" in *__NUM__*)
                CONTENT_HOLD="mask placeholder in change line in '$path': ${b:0:80}"
                return ;;
            esac
            skel_a="$(mask_numbers "$a")"
            skel_b="$(mask_numbers "$b")"
            if [ "$skel_a" != "$skel_b" ]; then
                CONTENT_HOLD="non-numeric change line in '$path': ${a:0:80}"
                return
            fi
            if [ "$a" = "$b" ]; then
                CONTENT_HOLD="change line with no numeric difference in '$path': ${a:0:80}"
                return
            fi
            NUM_PAIRS=$(( NUM_PAIRS + 1 ))
        fi
    done
    # Success — reset buffers for the next hunk.
    HM_N=0; HP_N=0
    unset HUNK_MINUS HUNK_PLUS
}

# check_steering_date_only — tier-2 predicate for one status-M steering file.
# Reads $BASE and $path; writes STEERING_HOLD (empty ⇒ PASS for this file).
# PASS requires ALL of:
#   (a) git diff --raw modes are 100644 → 100644 (no mode flip, no symlink);
#   (b) git diff -U0 has exactly one hunk whose header is `@@ -N +N @@` (a
#       one-line replacement; git omits the `,1` count for single lines);
#   (c) that hunk holds exactly one `-` line and one `+` line, both matching
#       DATE_RE, new date strictly greater than old;
#   (d) line N of the BASE blob sits inside its YAML frontmatter: line 1 is
#       `---`, the closing `---` is at line K, and 2 <= N < K.  A `last_verified:`
#       line in a fenced body example (.claude/rules/doc-freshness.md has one)
#       is outside the frontmatter and holds.
# Every other shape holds.  No pipeline exits early (no awk `exit`, no grep -q
# on a pipe) so pipefail can never turn a PASS-shaped file into a silent abort.
check_steering_date_only() {
    STEERING_HOLD=""
    local raw old_mode new_mode hunks minus plus n_old n_new old_line new_line line blob_k old_date new_date

    # (a) mode / type
    raw="$(git diff --raw "$BASE" -- "$path")"
    if [ -z "$raw" ]; then
        STEERING_HOLD="steering file '$path': git diff --raw produced no row"
        return
    fi
    read -r old_mode new_mode _ <<< "$raw"
    old_mode="${old_mode#:}"
    if [ "$old_mode" != "100644" ] || [ "$new_mode" != "100644" ]; then
        STEERING_HOLD="steering file '$path': mode/type is not a regular 100644 file on both sides ($old_mode → $new_mode)"
        return
    fi

    # (b)+(c) exactly one one-line hunk, one -/+ pair
    hunks=0; minus=0; plus=0; n_old=""; n_new=""; old_line=""; new_line=""
    while IFS= read -r line; do
        case "$line" in
            "--- "*|"+++ "*|"diff --git "*|"index "*) continue ;;
            "@@"*)
                hunks=$(( hunks + 1 ))
                if [[ "$line" =~ ^@@\ -([0-9]+)\ \+([0-9]+)\ @@ ]]; then
                    n_old="${BASH_REMATCH[1]}"; n_new="${BASH_REMATCH[2]}"
                else
                    STEERING_HOLD="steering file '$path': hunk is not a one-line replacement: ${line:0:80}"
                    return
                fi
                ;;
            -*) minus=$(( minus + 1 )); old_line="${line#-}" ;;
            +*) plus=$(( plus + 1 ));  new_line="${line#+}" ;;
            *)
                STEERING_HOLD="steering file '$path': unexpected diff line: ${line:0:80}"
                return
                ;;
        esac
    done < <(git diff --no-color -U0 "$BASE" -- "$path")

    if [ "$hunks" -ne 1 ]; then
        STEERING_HOLD="steering file '$path': expected exactly 1 hunk, found $hunks"
        return
    fi
    if [ "$minus" -ne 1 ] || [ "$plus" -ne 1 ]; then
        STEERING_HOLD="steering file '$path': expected exactly one -/+ line pair, found $minus removed / $plus added"
        return
    fi
    if [ "$n_old" != "$n_new" ]; then
        STEERING_HOLD="steering file '$path': hunk moves the line ($n_old → $n_new)"
        return
    fi
    if ! [[ "$old_line" =~ $DATE_RE ]] || ! [[ "$new_line" =~ $DATE_RE ]]; then
        STEERING_HOLD="steering file '$path': change line is not a last_verified date: ${old_line:0:80}"
        return
    fi
    old_date="${old_line#last_verified: }"
    new_date="${new_line#last_verified: }"
    if [[ ! "$new_date" > "$old_date" ]]; then
        STEERING_HOLD="steering file '$path': date not strictly advancing '$old_date' → '$new_date' (equal or backwards)"
        return
    fi

    # (d) frontmatter position in the BASE blob.  awk scans the whole blob (no
    # early exit → no SIGPIPE under pipefail); prints "none" when line 1 is not
    # `---`, else the closing delimiter's line number, or 0 when never closed.
    blob_k="$(git show "$BASE:$path" | awk '
        NR==1 && $0 !~ /^---[[:space:]]*$/ { bad=1 }
        NR>1 && !k && /^---[[:space:]]*$/  { k=NR }
        END { if (bad) print "none"; else print k+0 }')"
    if [ "$blob_k" = "none" ] || [ "$blob_k" -lt 3 ]; then
        STEERING_HOLD="steering file '$path': base blob has no closed YAML frontmatter (line 1 must be ---, closing --- at line >= 3)"
        return
    fi
    if [ "$n_old" -lt 2 ] || [ "$n_old" -ge "$blob_k" ]; then
        STEERING_HOLD="steering file '$path': last_verified line $n_old is outside the frontmatter (closing --- at line $blob_k)"
        return
    fi
}

# --- Step 2.2: Merge-base against working tree -------------------------------
# Compare merge-base..working-tree so that an uncommitted prose edit is visible
# and cannot slip past this predicate into the post-plan commit.
if ! BASE="$(git merge-base "$BASE_REF" HEAD 2>/dev/null)"; then
    echo "docfix-check-veronly: HOLD — could not compute merge-base against '$BASE_REF' (branch not found or no common ancestor)"
    exit 2
fi

# --- Step 2.3: Untracked files — unconditional hold -------------------------
# git diff cannot see untracked files, but post-plan Phase 2's commit step
# picks them up — so they must block here before the diff inspection.
UNTRACKED="$(git ls-files --others --exclude-standard)"
if [ -n "$UNTRACKED" ]; then
    FIRST_UNTRACKED="${UNTRACKED%%$'\n'*}"
    echo "docfix-check-veronly: HOLD — untracked file(s) present (post-plan would commit them): $FIRST_UNTRACKED"
    exit 1
fi

# --- Step 2.4: Name-status gate ----------------------------------------------
# Every changed file must carry status exactly 'M' and classify to tier 1
# (ibl5/docs/**, depth-one ibl5/classes/*/README.md) or tier 2 (.claude/**/*.md,
# root CLAUDE.md, root AGENTS.md); every other path holds.
# An empty diff is not a pass — it would make "every file is M" vacuously true
# with zero rows.
ROW_COUNT=0
NAME_STATUS_HOLD=""

while IFS=$'\t' read -r status path; do
    ROW_COUNT=$(( ROW_COUNT + 1 ))
    if [ "$status" != "M" ]; then
        NAME_STATUS_HOLD="non-M change in diff: status '$status' on '$path'"
        break
    fi
    if [ "$(path_tier "$path")" = "0" ]; then
        NAME_STATUS_HOLD="path outside docfix allowlist: '$path'"
        break
    fi
done < <(git diff "$BASE" --name-status)

if [ -n "$NAME_STATUS_HOLD" ]; then
    echo "docfix-check-veronly: HOLD — $NAME_STATUS_HOLD"
    exit 1
fi

if [ "$ROW_COUNT" -eq 0 ]; then
    echo "docfix-check-veronly: HOLD — diff is empty (no changed files between merge-base and working tree)"
    exit 1
fi

# --- Step 2.5: Per-file content gate -----------------------------------------
# For each M file: diff change lines are buffered hunk-by-hunk and pair_hunk()
# classifies each positionally-paired (-,+) line as either a date bump or a
# same-skeleton numeric correction.  Every change line must fall into one of
# these two categories; anything else holds.  Two-level process substitution:
# outer iterates files, inner reads each diff.
# Tier-2 rows are dispatched to check_steering_date_only first and skip the
# pairing loop.

while IFS=$'\t' read -r _status path; do

    # Tier 2: steering markdown gets the strict lone-frontmatter-date predicate
    # and never enters pair_hunk (no numeric allowance for these files).
    if [ "$(path_tier "$path")" = "2" ]; then
        check_steering_date_only
        if [ -n "$STEERING_HOLD" ]; then
            echo "docfix-check-veronly: HOLD — $STEERING_HOLD"
            exit 1
        fi
        continue
    fi

    DATE_PAIRS=0
    NUM_PAIRS=0
    HM_N=0
    HP_N=0
    OLD_DATE=""
    NEW_DATE=""
    CONTENT_HOLD=""
    unset HUNK_MINUS HUNK_PLUS

    while IFS= read -r line; do
        # Skip diff file-header lines.  Trailing space after --- / +++ is
        # load-bearing: "----" (removed frontmatter delimiter) and "+---"
        # (added delimiter) do NOT have a space in the 4th position, so they
        # correctly fall through to the change-line check below.
        case "$line" in
            "--- "*|"+++ "*) continue ;;
            "diff --git "*|"index "*) continue ;;
            "@@"*) pair_hunk; [ -n "$CONTENT_HOLD" ] && break; continue ;;
            " "*|"") continue ;;  # context lines (leading space) or empty
        esac

        # Remaining lines are change lines (start with + or -).
        case "$line" in
            -*) HUNK_MINUS[$HM_N]="${line#-}"; HM_N=$(( HM_N + 1 )) ;;
            +*) HUNK_PLUS[$HP_N]="${line#+}"; HP_N=$(( HP_N + 1 )) ;;
            *)
                # Unexpected line type — hold; diff format changed or corrupted.
                CONTENT_HOLD="unexpected diff line in '$path': ${line:0:80}"
                break
                ;;
        esac
    done < <(git diff --no-color "$BASE" -- "$path")

    # Flush the final hunk (not preceded by another @@ boundary).
    [ -z "$CONTENT_HOLD" ] && pair_hunk

    if [ -n "$CONTENT_HOLD" ]; then
        echo "docfix-check-veronly: HOLD — $CONTENT_HOLD"
        exit 1
    fi

    # Fail-closed floor: a status-M file that produced zero classified pairs holds
    # rather than passing vacuously.
    if [ "$DATE_PAIRS" -eq 0 ] && [ "$NUM_PAIRS" -eq 0 ]; then
        echo "docfix-check-veronly: HOLD — no recognized change pairs in '$path'"
        exit 1
    fi

    # Numbers must ride along with a re-verification date bump in the same file.
    if [ "$NUM_PAIRS" -gt 0 ] && [ "$DATE_PAIRS" -ne 1 ]; then
        echo "docfix-check-veronly: HOLD — numeric change without a last_verified bump in '$path' (${NUM_PAIRS} numeric pair(s), ${DATE_PAIRS} date pair(s))"
        exit 1
    fi

done < <(git diff "$BASE" --name-status)

# --- Step 2.6: Arm the plan (PASS branch only) --------------------------------
# Predicate passed.  Mutate the plan file atomically via a mktemp sibling + mv.
# Both mutations are idempotent: a second run on an already-armed plan exits 0.

if [ ! -f "$PLAN_FILE" ]; then
    echo "docfix-check-veronly: HOLD — plan file not found: $PLAN_FILE"
    exit 2
fi

TMPFILE="$(mktemp "${PLAN_FILE}.XXXXXX")"
trap 'rm -f "$TMPFILE"' EXIT

awk '
    BEGIN { infm=0; fm_closed=0; in_hold=0 }

    # Open frontmatter (line 1 must be ---)
    NR==1 && /^---[[:space:]]*$/ { infm=1; print; next }

    # Close frontmatter
    infm && /^---[[:space:]]*$/ { infm=0; fm_closed=1; print; next }

    # Inside frontmatter: flip auto_merge: false → true.
    # auto_merge: true already present → no match → printed as-is (idempotent).
    infm {
        if (/^auto_merge:[[:space:]]*false[[:space:]]*$/) {
            print "auto_merge: true"
        } else {
            print
        }
        next
    }

    # Body: delete ## Automouse Hold Justification through EOF or the next ##.
    # If the section was already removed, in_hold never becomes 1 → idempotent.
    fm_closed {
        if (/^## Automouse Hold Justification/) { in_hold=1; next }
        if (in_hold && /^## /) { in_hold=0 }
        if (!in_hold) { print }
        next
    }

    # Lines before frontmatter opens (should not occur in seeded plans).
    { print }
' "$PLAN_FILE" > "$TMPFILE"

mv "$TMPFILE" "$PLAN_FILE"

echo "docfix-check-veronly: PASS — armed $PLAN_FILE"
exit 0
