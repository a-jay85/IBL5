#!/usr/bin/env bash
#
# bin/pr-cycle-tick: scheduled watcher that hands stuck PRs to bin/pr-cycle.
#
# Usage: bin/pr-cycle-tick [--dry-run] [--help]
#   --dry-run   Run every guard and read, print the qualifying set and the exact
#               command, write no state, send no DM, launch nothing.
#   --help      Print this header comment.
# ---
# The tick also removes a post-plan-running label older than PCW_STALE_LABEL_MIN minutes
# when no post-plan run is live; --dry-run prints the would-remove set and removes nothing.
# Fired every 1800s by the LaunchAgent that bin/pr-cycle-tick-cron-setup installs.
# Reads open PRs with gh, drops the ones that do not need a rescue, and passes the rest
# to `bin/pr-cycle --go --only <csv> --max-ready <n>`. An idle tick exits before
# bin/pr-cycle and its _auth_probe, so it makes no Claude call.
#
# Never merges and never arms: arming stays inside bin/pr-cycle Stage 2 via
# bin/pr-triage --arm. Never polls or sleeps. NOT set -e: one PR's failed fetch must not
# abort the tick.
#
# Guards, cheapest first: stop file, usage zone, a live pr-cycle worker, then per PR:
# a needs-a-human label (the PR waits on a human's review, so no rescue touches its
# branch), post-plan in flight, post-plan finished under 30 minutes ago, checks pending or green,
# stacked on another open PR's branch, and a one-rescue-per-patch-id retry cap. At most
# 3 PRs go to one run. Every skipped open PR is written to a results/<id>.skip-notes TSV
# that the launch hands to bin/pr-cycle as PR_CYCLE_SKIP_NOTES for its your-turn DM.
# The retry key is the PR's patch-id (pcw_patch_id), so the rescue's own rebase-and-push
# does not reset the cap and a push that changes the diff does. When the patch-id cannot
# be computed the key is the head SHA, the tick logs it, and one DM per (PR, head) says so.
# A DIRTY PR whose last rescue settled as a rebase conflict may relaunch past the cap when
# the origin/master tip differs from the one at that launch. The tick launches at most
# PCW_CONFLICT_RETRY_DAILY_CAP DIRTY rescues per PR per local day.
#
# A launch is recorded as pending, not as an attempt: the detached worker outlives the tick.
# A later tick with no live worker reads the worker's result file and settles each PR. A run
# that reached post-plan counts as the one rescue. A holdrepeat decline is remembered per key.
# A rescue that never reached post-plan is a strike, and two strikes per key stop the retries.
#
# Gate-timeout rerun: when a red PR's only failure (human-signoff aside) is the "All checks
# green" gate, its newest gate run failed with "TIMEOUT: WAIT: anchors not reported/completed",
# and every anchor that line names is now completed with conclusion success on the same head,
# the tick runs `gh run rerun <id> --failed` in place of a rescue. The rerun goes back
# through the unchanged fail-closed gate. At most PCW_GATE_RERUN_CAP reruns per (PR, head
# SHA), counted in gate-reruns/<pr>, apart from strikes/. A gh read failure skips the PR
# for this tick. --dry-run prints the would-rerun line and writes nothing.
#
# Env seams (unset and empty both take the default):
#   PR_CYCLE_STOP_FILE         default $HOME/.ibl5-pr-cycle.stop (same name bin/pr-cycle reads)
#   PR_CYCLE_WATCH_STATE_DIR   default $HOME/.ibl5-pr-cycle-watch. Holds attempts/, dm-sent/,
#                              pending/, results/, declined/, strikes/, dm-declined/,
#                              dm-strikes/, dm-patchid/, conflict-hold/, retries/ and
#                              gate-reruns/.
#   PR_CYCLE_TICK_PR_CYCLE_CMD default $ROOT/bin/pr-cycle
#   PR_CYCLE_TICK_DM_CMD       default $ROOT/bin/discord-dm
#   PR_CYCLE_PATCH_ID_CMD      default: the git computation in pcw_patch_id (fetch, diff
#                              against the merge-base with origin/master, git patch-id)
#   PR_CYCLE_MASTER_TIP_CMD    default: refs/remotes/origin/master via pcw_master_tip (no
#                              fetch of its own). Unreadable output means no conflict re-try
#   PR_CYCLE_TICK_USAGE_ZONE   empty means read the live usage zone
#
# See the ADR for bin/pr-cycle-tick (ibl5/docs/decisions/) for the design rationale.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

DRY_RUN=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h) awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; exit 0 ;;
        --dry-run) DRY_RUN=1; shift ;;
        *) echo "pr-cycle-tick: unknown option: $1 (try --help)" >&2; exit 2 ;;
    esac
done

# shellcheck source=bin/lib/pr-cycle-watch.sh
source "$SCRIPT_DIR/lib/pr-cycle-watch.sh"
# shellcheck source=bin/lib/dm.sh
source "$SCRIPT_DIR/lib/dm.sh"

log() { printf '[%s] %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*"; }

# ── Env seams ────────────────────────────────────────────────────────────────
if [[ -n "${PR_CYCLE_STOP_FILE:-}" ]]; then
    STOP_FILE="$PR_CYCLE_STOP_FILE"
elif [[ -n "${HOME:-}" ]]; then
    STOP_FILE="$HOME/.ibl5-pr-cycle.stop"
else
    echo "pr-cycle-tick: HOME is unset" >&2; exit 2
fi
STATE="$(pcw_state_dir)" || { echo "pr-cycle-tick: HOME is unset" >&2; exit 2; }
PR_CYCLE_CMD="${PR_CYCLE_TICK_PR_CYCLE_CMD:-$ROOT/bin/pr-cycle}"
DM_CMD="$(dm_bin "$ROOT/bin" PR_CYCLE_TICK_DM_CMD)"

# shellcheck source=bin/lib/usage-gate.sh
source "$SCRIPT_DIR/lib/usage-gate.sh"

# gh api's {owner}/{repo} placeholders resolve from the cwd's git remote.
cd "$ROOT" || { log "cannot cd to $ROOT"; exit 1; }

# ── (a) Stop file ────────────────────────────────────────────────────────────
if [[ -e "$STOP_FILE" ]]; then
    log "stop file present ($STOP_FILE)"; exit 0
fi

# ── (a2) Stale post-plan-running sweep ───────────────────────────────────────
# A run that died leaves the label behind, and bin/merge-line-select skips any PR that
# carries it. This removes the label only when nothing says a run is live. Every probe
# is tri-state (see bin/lib/pr-cycle-watch.sh): 0 keeps, 2 (unevaluable) keeps, and only
# an all-1 verdict removes. It spends no Claude, so it runs ahead of the usage gate. It
# uses `return`, never `exit`: a sweep problem must not stop the rest of the tick.

# Prints the worktree path holding branch $1. rc 0 found, 1 no worktree, 2 list failed.
sweep_worktree_root() {
    local list wt
    list="$(git -C "$ROOT" worktree list --porcelain 2>/dev/null)" || return 2
    wt="$(awk -v want="branch refs/heads/$1" '
        /^worktree / { path = substr($0, 10) }
        $0 == want && !f { print path; f=1 }' <<< "$list")"
    [[ -n "$wt" ]] || return 1
    printf '%s\n' "$wt"
}

stale_label_sweep() {
    local sweep_json labelled snap ps_txt claude_pids crc lsof_txt="" lsof_ok=1
    local pr branch draft labeled_at last age_min wt wrc rc dirs cwd_ev evidence
    sweep_json="$(gh pr list --state open --author @me --limit 200 \
        --json number,headRefName,isDraft,labels 2>/dev/null)" \
        || { log "stale-label: gh pr list failed; sweep skipped"; return 0; }
    labelled="$(jq -r '.[] | select(((.labels // []) | map(.name)) | index("post-plan-running"))
        | [.number, .headRefName, (.isDraft | tostring)] | @tsv' <<< "$sweep_json" 2>/dev/null)" \
        || { log "stale-label: unparseable pr list; sweep skipped"; return 0; }
    [[ -n "$labelled" ]] || return 0

    # Strict reads: ljob_snapshot swallows a launchctl failure and reads as "nothing live".
    snap="$(launchctl list 2>/dev/null)" || snap=""
    [[ -n "$snap" ]] || { log "stale-label: launchctl unreadable; sweep skipped"; return 0; }
    ps_txt="$(ps -axww -o pid=,command= 2>/dev/null)" || ps_txt=""
    [[ -n "$ps_txt" ]] || { log "stale-label: ps unreadable; sweep skipped"; return 0; }
    claude_pids="$(pcw_claude_print_pids "$ps_txt")"; crc=$?
    if [[ "$crc" -eq 0 ]]; then
        lsof_txt="$(lsof -a -d cwd -p "$(paste -sd, - <<< "$claude_pids")" -Fn 2>/dev/null)" \
            || lsof_txt=""
        [[ -n "$lsof_txt" ]] || lsof_ok=0
    fi

    while IFS=$'\t' read -r pr branch draft; do
        [[ -n "$pr" ]] || continue
        age_min="?"
        labeled_at="$(gh api "repos/{owner}/{repo}/issues/$pr/timeline" --paginate \
            --jq '.[] | select(.event=="labeled" and .label.name=="post-plan-running") | .created_at' \
            </dev/null 2>/dev/null)" || labeled_at=""
        last="$(sed -n '$p' <<< "$labeled_at")"
        if [[ -z "$last" ]]; then
            log "stale-label: #$pr held (age ?m): label time unevaluable"; continue
        fi
        pcw_label_too_young "$last"; rc=$?
        age_min="$(pcw_label_age_min "$last")" || age_min="?"
        if [[ "$rc" -eq 0 ]]; then
            log "stale-label: #$pr held (age ${age_min}m): too young"; continue
        elif [[ "$rc" -ne 1 ]]; then
            log "stale-label: #$pr held (age ${age_min}m): label time unparseable"; continue
        fi
        if pcw_inflight "$pr" "$branch" "$snap"; then
            log "stale-label: #$pr held (age ${age_min}m): launchd job live"; continue
        fi
        wt="$(sweep_worktree_root "$branch")"; wrc=$?
        if [[ "$wrc" -eq 2 ]]; then
            log "stale-label: #$pr held (age ${age_min}m): git worktree list unevaluable"; continue
        fi
        # stale-label: argv probe
        pcw_postplan_argv_live "$wt" "$(ljob_safe_slug "$branch")" "$ps_txt" "$$ $PPID"; rc=$?
        if [[ "$rc" -eq 0 ]]; then
            log "stale-label: #$pr held (age ${age_min}m): post-plan process live"; continue
        elif [[ "$rc" -ne 1 ]]; then
            log "stale-label: #$pr held (age ${age_min}m): ps unevaluable"; continue
        fi
        cwd_ev="n/a"
        if [[ "$wrc" -eq 0 ]]; then
            cwd_ev="none"
            if [[ "$lsof_ok" -eq 0 ]]; then
                log "stale-label: #$pr held (age ${age_min}m): lsof unevaluable"; continue
            fi
            if [[ "$crc" -eq 0 ]] && pcw_cwd_in_worktree "$wt" "$lsof_txt"; then
                log "stale-label: #$pr held (age ${age_min}m): headless claude cwd in worktree"; continue
            fi
        fi
        dirs=("$ROOT/tools/postplan-harness/out")
        [[ "$wrc" -ne 0 ]] || dirs+=("$wt/tools/postplan-harness/out")
        pcw_live_out_dir_fresh "$branch" "${dirs[@]}"; rc=$?
        if [[ "$rc" -eq 0 ]]; then
            log "stale-label: #$pr held (age ${age_min}m): out dir written <${PCW_STALE_LABEL_MIN}m ago"; continue
        elif [[ "$rc" -ne 1 ]]; then
            log "stale-label: #$pr held (age ${age_min}m): out dir root missing"; continue
        fi
        evidence="age=${age_min}m launchd=none argv=none claude-cwd=$cwd_ev out-dir=idle>=${PCW_STALE_LABEL_MIN}m draft=$draft"
        if [[ "$DRY_RUN" -eq 1 ]]; then
            log "dry-run: stale-label: would remove post-plan-running from #$pr ($evidence)"; continue
        fi
        # Own gh call, not postplan_label_remove: that helper ends in `|| true` and would
        # hide the failure this log line has to report.
        if gh api --method DELETE "repos/{owner}/{repo}/issues/$pr/labels/post-plan-running" \
            </dev/null >/dev/null 2>&1; then
            log "stale-label: removed post-plan-running from #$pr ($evidence)"
        else
            log "stale-label: DELETE failed for #$pr; label kept ($evidence)"
        fi
    done <<< "$labelled"
    return 0
}
stale_label_sweep

# ── (b) Usage gate ───────────────────────────────────────────────────────────
# Read-only mirror of the first half of usage_prestart_gate. The gate itself writes a
# resumable-session marker, and a tick has no session to resume.
zone="${PR_CYCLE_TICK_USAGE_ZONE:-}"
if [[ -z "$zone" ]]; then
    body="$(usage_fetch 45)"; urc=$?
    if [[ "$urc" -eq 1 || -z "$body" ]]; then
        zone=normal
    else
        stale=0
        if [[ "$urc" -eq 2 ]]; then
            age="$(usage_cache_age)"
            if [[ "$age" -lt 0 || "$age" -ge 300 ]]; then
                usage_blind_trust "$body" "$age" "runner=pr-cycle-tick" || stale=1
            fi
        fi
        if [[ "$stale" -eq 1 ]]; then zone=normal; else zone="$(usage_zone "$body")"; fi
    fi
fi
if [[ "$zone" != "normal" ]]; then
    log "usage zone $zone"; exit 0
fi

# ── (c) Single instance ──────────────────────────────────────────────────────
# Read the snapshot with a here-string, never `| grep -q` (the SIGPIPE trap).
SNAP="$(ljob_snapshot)"
while IFS=$'\t' read -r pid _status label; do
    case "$label" in
        com.ibl5.pr-cycle-[0-9]*)
            if [[ "$pid" =~ ^[0-9]+$ ]]; then
                log "pr-cycle worker running ($label)"; exit 0
            fi ;;
    esac
done <<< "$SNAP"

# ── Reconcile pending launches ───────────────────────────────────────────────
# `pr-cycle --go` detaches a launchd worker and returns, so the launch itself says nothing
# about the outcome. The tick records a pending entry, and the first later tick that finds no
# live worker (guard c) reads the file the worker wrote and settles each PR here.
DECLINED_MSG='pr-cycle-watch: PR #%s on head %s was not rescued: post-plan holdrepeat declines it (held twice on the same reason, nothing changed). Skipping it until its diff changes.'
STRIKE_MSG='pr-cycle-watch: PR #%s on head %s: the rescue never reached post-plan %s times (last: %s %s %s). Skipping it until its diff changes.'
PATCHID_MSG='pr-cycle-watch: PR #%s on head %s: could not compute its patch-id, so its retry cap is keyed on the head SHA for now and a rebase-only push will re-qualify it. See the tick log.'
PROBE_MSG='pr-cycle-watch: PR #%s on head %s: the conflict probe could not run (%s), so the PR re-fires on every new master tip as before, up to the daily cap. See the tick log.'

# strike <pr> <sha> <key> <status> <outcome> <reason>: one no-op rescue; DM once when the cap is hit.
strike() {
    local n msg
    n="$(pcw_add_strike "$STATE" "$1" "$3" "$2")"
    log "PR $1: no-op rescue strike $n/$PCW_STRIKE_CAP (head ${2:0:7}): $4 $5 $6"
    if [[ "$n" -eq "$PCW_STRIKE_CAP" ]] && pcw_kind_dm_due "$STATE" strikes "$1" "$3" "$2"; then
        # shellcheck disable=SC2059  # the message is a fixed printf template
        msg="$(printf "$STRIKE_MSG" "$1" "${2:0:7}" "$PCW_STRIKE_CAP" "$4" "$5" "$6")"
        dm_ping "$msg" || true
        pcw_kind_mark_dm "$STATE" strikes "$1" "$3"
    fi
}

# probe_fallback <pr> <sha> <reason>: the conflict probe could not decide, so the PR re-fires
# on the new master tip exactly as before. Loud by design.
probe_fallback() {
    local msg
    log "WARN PR $1: conflict probe unavailable ($3); re-firing on the new master tip as before"
    pcw_kind_dm_due "$STATE" probe "$1" "$2" || return 0
    # shellcheck disable=SC2059  # the message is a fixed printf template
    msg="$(printf "$PROBE_MSG" "$1" "${2:0:7}" "$3")"
    if [[ "$DRY_RUN" -eq 1 ]]; then
        log "would DM: $DM_CMD --ping $msg"
    else
        dm_ping "$msg" || true
        pcw_kind_mark_dm "$STATE" probe "$1" "$2"
    fi
}
# conflict_files_same <hold-file> <tip> <paths>: is every conflicted path byte-identical on
# <tip> and on the tip recorded in the hold? Same path names are not enough: master can move
# again inside a conflicted file. A path absent on both sides counts as the same.
conflict_files_same() {
    local old p a b
    old="$(sed -n '1p' "$1")"
    [[ "$old" =~ ^[0-9a-f]{40}$ ]] || return 1
    while IFS= read -r p; do
        [[ -n "$p" ]] || continue
        a="$(git -C "$ROOT" rev-parse -q --verify "$old:$p" 2>/dev/null || true)"
        b="$(git -C "$ROOT" rev-parse -q --verify "$2:$p" 2>/dev/null || true)"
        [[ "$a" == "$b" ]] || return 1
    done <<< "$3"
    return 0
}
# conflict_refire <pr> <sha> <tip>: called only when pcw_conflict_retry_due said due and the
# head is attempted. 0 = re-fire. 4 = the conflict is unchanged: skip, with CONFLICT_NP set to
# the path count, and the hold's tip advanced to <tip> (not under --dry-run).
conflict_refire() {
    local pr="$1" sha="$2" tip="$3" rhead held pout prc
    CONFLICT_NP=0
    rhead="$(pcw_conflict_hold_head "$STATE" "$pr")"
    if [[ -n "$rhead" && "$rhead" != "$sha" ]]; then
        log "PR $pr: conflict re-try (head changed ${rhead:0:7} -> ${sha:0:7})"; return 0
    fi
    if ! held="$(pcw_conflict_hold_paths "$STATE" "$pr")"; then
        probe_fallback "$pr" "$sha" "no path set recorded with the hold"; return 0
    fi
    pout="$(pcw_conflict_probe "$ROOT" "$pr" "$tip" "$sha")" && prc=0 || prc=$?
    case "$prc" in
        0) log "PR $pr: conflict re-try (merges clean on master ${tip:0:7})"; return 0 ;;
        1) if [[ "$pout" == "$held" ]] && conflict_files_same "$STATE/conflict-hold/$pr" "$tip" "$held"; then
               CONFLICT_NP="$(grep -c . <<< "$pout")"
               [[ "$DRY_RUN" -eq 1 ]] \
                   || pcw_record_conflict_hold "$STATE" "$pr" "$tip" "$sha" "$pout"
               return 4
           fi
           log "PR $pr: conflict re-try (conflicted paths or their content changed on master: $(grep -c . <<< "$held") -> $(grep -c . <<< "$pout"))"
           return 0 ;;
        *) probe_fallback "$pr" "$sha" "$pout"; return 0 ;;
    esac
}
# settle_row <pr> <sha> <key> <status> <outcome> <reason> [<tip>]: the outcome table, one PR.
settle_row() {
    local pr="$1" sha="$2" key="$3" status="$4" outcome="$5" reason="$6" tip="${7:-}" t7 msg pout prc np
    # conflict-hold/<pr>: only a settled rebase conflict may later re-try on a new master tip.
    # A paused rescue never ran, so it keeps any hold. Every other fired or holdrepeat
    # outcome is a determinate result and drops the hold back to the plain retry cap.
    case "$status:$outcome" in
        fired:conflict)
            # Record the merge-tree path set at the launch tip, so a later tick can tell
            # whether master's move touched the conflict. No set recorded = today's rule.
            prc=2; pout="no master tip at launch"
            if [[ -n "$tip" ]]; then
                pout="$(pcw_conflict_probe "$ROOT" "$pr" "$tip" "$sha")" && prc=0 || prc=$?
            fi
            [[ "$prc" -eq 0 ]] && pout="merges clean at the launch tip"
            if [[ "$prc" -eq 1 ]]; then
                pcw_record_conflict_hold "$STATE" "$pr" "$tip" "$sha" "$pout"
                np="$(grep -c . <<< "$pout")"
                log "PR $pr: conflict hold recorded (master ${tip:0:7}; $np conflicted paths)"
            else
                pcw_record_conflict_hold "$STATE" "$pr" "$tip"
                t7="${tip:-unknown}"
                log "PR $pr: conflict hold recorded (master ${t7:0:7})"
                log "WARN PR $pr: conflict probe at hold time: $pout; a new master tip re-fires this PR as before"
            fi ;;
        fired:paused) ;;
        fired:*|holdrepeat:*) pcw_clear_conflict_hold "$STATE" "$pr" ;;
    esac
    case "$status:$outcome" in
        fired:shipped|fired:held|fired:conflict|fired:timed-out)
            pcw_record_attempt "$STATE" "$pr" "$key"
            log "PR $pr: rescue ran ($outcome); attempt recorded (head ${sha:0:7})" ;;
        fired:failed)
            case "$reason" in
                kind=*|terminal=*)
                    pcw_record_attempt "$STATE" "$pr" "$key"
                    log "PR $pr: rescue ran and failed ($reason); attempt recorded (head ${sha:0:7})" ;;
                *) strike "$pr" "$sha" "$key" "$status" "$outcome" "$reason" ;;
            esac ;;
        fired:declined|holdrepeat:*)
            pcw_record_declined "$STATE" "$pr" "$key"
            log "PR $pr: holdrepeat declined (head ${sha:0:7})"
            if pcw_kind_dm_due "$STATE" declined "$pr" "$key" "$sha"; then
                # shellcheck disable=SC2059  # the message is a fixed printf template
                msg="$(printf "$DECLINED_MSG" "$pr" "${sha:0:7}")"
                dm_ping "$msg" || true
                pcw_kind_mark_dm "$STATE" declined "$pr" "$key"
            fi ;;
        fired:rebased)
            log "PR $pr: rebase-only ran (merged master, still held for a human); no attempt recorded (head ${sha:0:7})" ;;
        fired:paused)
            log "PR $pr: paused by usage gate, retry later" ;;
        *) strike "$pr" "$sha" "$key" "$status" "$outcome" "$reason" ;;
    esac
}

reconcile_pending() {
    local pf id rf started now hdr pr sha key tip row status outcome reason all_reason=""
    [[ -d "$STATE/pending" ]] || return 0
    if [[ "$DRY_RUN" -eq 1 ]]; then
        local n=0
        for pf in "$STATE/pending"/*; do [[ -f "$pf" ]] && n=$((n + 1)); done
        [[ "$n" -eq 0 ]] || log "dry-run: $n pending launch(es) not reconciled"
        return 0
    fi
    now="$(date +%s)"
    for pf in "$STATE/pending"/*; do
        [[ -f "$pf" ]] || continue
        id="$(basename "$pf")"
        rf="$(sed -n '1s/^# result=\(.*\) started=[0-9]*$/\1/p' "$pf")"
        started="$(sed -n '1s/^.* started=\([0-9]*\)$/\1/p' "$pf")"
        [[ -n "$rf" ]] || rf="$STATE/results/$id.tsv"
        [[ "$started" =~ ^[0-9]+$ ]] || started=0
        all_reason=""
        if [[ -f "$rf" ]]; then
            hdr="$(sed -n 1p "$rf")"
            if [[ "$hdr" != "# pr-cycle-result v1" ]]; then
                log "pending $id: malformed result ($rf)"
                all_reason="malformed-result"
            fi
        elif [[ $((now - started)) -gt "$PCW_PENDING_MAX_AGE_S" ]]; then
            log "pending $id: no result file after ${PCW_PENDING_MAX_AGE_S}s"
            all_reason="no-result-file"
        else
            log "pending $id: no result yet"
            continue
        fi
        while IFS=$'\t' read -r pr sha key tip; do
            [[ -n "$pr" && -n "$sha" ]] || continue
            # The key was captured at launch; a pending file from the pre-key tick has none.
            [[ -n "$key" ]] || key="$sha"
            if [[ -n "$all_reason" ]]; then
                strike "$pr" "$sha" "$key" pending - "$all_reason"; continue
            fi
            row="$(awk -F'\t' -v p="$pr" '$1 == p && !f { print; f = 1 }' "$rf")"
            if [[ -z "$row" ]]; then
                strike "$pr" "$sha" "$key" no-row - -; continue
            fi
            IFS=$'\t' read -r _ status outcome reason <<< "$row"
            settle_row "$pr" "$sha" "$key" "$status" "$outcome" "${reason:--}" "$tip"
        done < <(tail -n +2 "$pf")
        rm -f "$pf" "$rf"
    done
}
reconcile_pending

TODAY="$(pcw_today)"   # local calendar day for the retries/ ledger, fixed for this tick
# ── (d) Qualifying set ───────────────────────────────────────────────────────
if ! PRS_JSON="$(gh pr list --state open --author @me --limit 200 \
        --json number,headRefName,headRefOid,mergeStateStatus,autoMergeRequest,isDraft,baseRefName,labels 2>/dev/null)"; then
    log "gh pr list failed"; exit 0
fi
if [[ "$DRY_RUN" -eq 0 ]]; then
    pcw_prune "$STATE" "$(jq -r '.[].number' <<< "$PRS_JSON")"
fi

# Every open PR's head branch -> number (drafts included: a PR stacked on a draft is
# still stacked). Feeds pcw_stacked_on.
OPEN_HEADS="$(jq -r '.[] | [.headRefName, .number] | @tsv' <<< "$PRS_JSON")"

# Skip notes: one "<pr>\t<reason>" line per open PR this tick did not launch. pr-cycle
# reads the file through PR_CYCLE_SKIP_NOTES and lists the reasons in its your-turn DM.
id="$(date +%s)-$$"
SKIP_NOTES="$STATE/results/$id.skip-notes"
note() { [[ "$DRY_RUN" -eq 1 ]] || printf '%s\t%s\n' "$1" "$2" >> "$SKIP_NOTES"; }
skip() { log "skip PR $1: $2"; note "$1" "$2"; }
if [[ "$DRY_RUN" -eq 0 ]]; then
    mkdir -p "$STATE/results"
    find "$STATE/results" -name '*.skip-notes' -mmin +$(( PCW_PENDING_MAX_AGE_S / 60 )) -delete 2>/dev/null || true
    while IFS= read -r d; do note "$d" "draft"; done \
        < <(jq -r '.[] | select(.isDraft) | .number' <<< "$PRS_JSON")
fi

# <wt>/tools/postplan-harness/out for the worktree holding $1, or nothing.
worktree_out_dir() {
    local wt
    wt="$(git -C "$ROOT" worktree list --porcelain 2>/dev/null | awk -v want="branch refs/heads/$1" '
        /^worktree / { path = substr($0, 10) }
        $0 == want && !f { print path; f=1 }')"
    [[ -n "$wt" ]] && printf '%s\n' "$wt/tools/postplan-harness/out"
    return 0
}

# Gate-timeout rescue. The "All checks green" gate fails closed when an anchor check has not
# reported by its deadline. When that is the PR's only failure and every anchor it named has
# since gone green on the same head, re-run the gate's failed job instead of launching a
# Claude rescue. The rerun goes back through the unchanged fail-closed gate.
# rc 0: handled (rerun issued or declared, or the PR skipped for this tick); the caller
#       continues to the next PR.
# rc 1: not a gate-timeout case; the caller falls through to the red rescue unchanged.
gate_timeout_rescue() {   # <pr> <sha> <check-runs-json>
    local pr="$1" sha="$2" cr="$3" others runs pick id st concl logtxt names n
    pcw_gate_failed <<< "$cr" || return 1
    # Any failure besides the gate (and human-signoff) needs the real rescue.
    if ! others="$(ccg_dedupe "$(jq -nc --arg g "$PCW_GATE_CHECK" '["human-signoff", $g]')" <<< "$cr" 2>/dev/null)"; then
        return 1
    fi
    [[ -z "$(ccg_failed <<< "$others")" ]] || return 1
    if ! runs="$(gh run list --workflow="$PCW_GATE_WORKFLOW" --commit "$sha" \
            --json databaseId,conclusion,status,headSha,createdAt --limit 20 2>/dev/null)"; then
        skip "$pr" "gate run lookup failed (gh run list); recheck next tick"; return 0
    fi
    if ! pick="$(pcw_gate_run_pick "$sha" <<< "$runs")"; then
        skip "$pr" "no gate run found for head ${sha:0:7}; recheck next tick"; return 0
    fi
    read -r id st concl <<< "$pick"
    if [[ "$st" != completed || "$concl" != failure ]]; then
        skip "$pr" "gate run $id is $st/$concl, not a settled failure; recheck next tick"; return 0
    fi
    if ! logtxt="$(gh run view "$id" --log-failed 2>/dev/null)"; then
        skip "$pr" "gate log read failed (gh run view $id); recheck next tick"; return 0
    fi
    names="$(pcw_gate_timeout_anchors <<< "$logtxt")" || return 1
    pcw_anchors_green "$names" <<< "$cr" || return 1
    n="$(pcw_gate_rerun_count "$STATE" "$pr" "$sha")"
    if [[ "$n" -ge "$PCW_GATE_RERUN_CAP" ]]; then
        skip "$pr" "gate-timeout rerun cap (head ${sha:0:7}; $n of $PCW_GATE_RERUN_CAP reruns used)"; return 0
    fi
    if [[ "$DRY_RUN" -eq 1 ]]; then
        log "dry-run: PR $pr would rerun gate run $id (timed out; anchors now green: ${names//$'\n'/, })"
        return 0
    fi
    if ! gh run rerun "$id" --failed >/dev/null 2>&1; then
        skip "$pr" "gate rerun failed (gh run rerun $id); recheck next tick"; return 0
    fi
    n="$(pcw_add_gate_rerun "$STATE" "$pr" "$sha")"
    skip "$pr" "gate timed out with anchors green; reran gate run $id ($n of $PCW_GATE_RERUN_CAP)"
    return 0
}

QUALIFY=()      # "<pr>|<sha>|<key>"
while IFS=$'\t' read -r pr branch sha mstate base human; do
    [[ -n "$pr" ]] || continue
    # human-signoff is red, so a human still has to review this PR by hand. A rescue
    # would push a conflict merge or fix commits under that review.
    if [[ "$human" == "1" ]]; then
        skip "$pr" "needs-a-human (waiting on your review)"; continue
    fi
    if pcw_inflight "$pr" "$branch" "$SNAP"; then
        skip "$pr" "post-plan in flight"; continue
    fi
    out_dirs=("$ROOT/tools/postplan-harness/out")
    wt_out="$(worktree_out_dir "$branch")"
    [[ -n "$wt_out" ]] && out_dirs+=("$wt_out")
    if pcw_recent_finish "$branch" "${out_dirs[@]}"; then
        skip "$pr" "post-plan finished <$PCW_GRACE_MIN min ago"; continue
    fi
    if [[ "$mstate" == "DIRTY" ]]; then
        kind=DIRTY
    else
        if cr="$(gh api "repos/{owner}/{repo}/commits/$sha/check-runs?per_page=100" 2>/dev/null)"; then
            verdict="$(pcw_check_verdict <<< "$cr")"
        else
            verdict=pending
        fi
        if [[ "$verdict" != "red" ]]; then
            skip "$pr" "checks $verdict"; continue
        fi
        if gate_timeout_rescue "$pr" "$sha" "$cr"; then continue; fi
        kind=red
    fi
    # Stacked (base is another open PR's head): its checks run against the parent
    # branch, so a rescue cannot fix them. Skipped before any attempt is recorded.
    if parent="$(pcw_stacked_on "$base" "$OPEN_HEADS")"; then
        skip "$pr" "stacked on #$parent"; continue
    fi
    # Retry key: the PR's patch-id, which a clean rebase keeps, so a rescue's own
    # rebase-and-push does not reset the cap. Captured here, before launch. Falls back to
    # the head SHA (today's keying, which never strands a PR) and says so once per head.
    key="$(pcw_patch_id "$ROOT" "$pr")"
    pcw_drop_pr_ref "$ROOT" "$pr"
    if [[ -z "$key" ]]; then
        key="$sha"
        log "PR $pr: patch-id unavailable; retry key falls back to head ${sha:0:7}"
        if pcw_kind_dm_due "$STATE" patchid "$pr" "$sha"; then
            # shellcheck disable=SC2059  # the message is a fixed printf template
            msg="$(printf "$PATCHID_MSG" "$pr" "${sha:0:7}")"
            if [[ "$DRY_RUN" -eq 1 ]]; then
                log "would DM: $DM_CMD --ping $msg"
            else
                dm_ping "$msg" || true
                pcw_kind_mark_dm "$STATE" patchid "$pr" "$sha"
            fi
        fi
    fi
    # origin/master tip now. pcw_patch_id above already fetched origin master. Empty means
    # unreadable, which never makes a conflict hold eligible.
    tip="$(pcw_master_tip "$ROOT")"
    # A settled rebase conflict may re-try on a new origin/master tip, within the daily cap.
    # Only a DIRTY PR qualifies. Every other capped PR keeps the until-the-diff-changes rule.
    crd=1
    if [[ "$kind" == DIRTY ]]; then
        pcw_conflict_retry_due "$STATE" "$pr" "$tip" "$TODAY" "$sha"; crd=$?
        # Due by tip or head: re-fire only when the conflict could have changed.
        if [[ "$crd" -eq 0 ]] && pcw_attempted_head "$STATE" "$pr" "$key" "$sha"; then
            conflict_refire "$pr" "$sha" "$tip"; crd=$?
        fi
    fi
    if [[ "$crd" -ne 0 ]] && pcw_attempted_head "$STATE" "$pr" "$key" "$sha"; then
        case "$crd" in
            2) skip "$pr" "retry cap (head ${sha:0:7}; rebase conflict, waiting for a new master tip)" ;;
            3) skip "$pr" "retry cap (head ${sha:0:7}; rebase conflict, daily cap of $PCW_CONFLICT_RETRY_DAILY_CAP launches reached)" ;;
            4) skip "$pr" "retry cap (head ${sha:0:7}; rebase conflict unchanged ($CONFLICT_NP paths))" ;;
            *) skip "$pr" "retry cap (head ${sha:0:7})" ;;
        esac
        if pcw_dm_due "$STATE" "$pr" "$key" "$sha"; then
            msg="pr-cycle-watch: PR #$pr is still $kind on head ${sha:0:7} after one rescue. Skipping it until its diff changes."
            # Name why the rescue stopped, so the DM is actionable without opening a log.
            IFS=$'\t' read -r run_dir why <<< "$(pcw_last_block "$branch" "${out_dirs[@]}")" || true
            if [[ -n "${why:-}" ]]; then
                msg+=" Why: $why Fix steps: $run_dir/blocked-ship.txt"
            elif [[ -n "${run_dir:-}" ]]; then
                msg+=" Last rescue run: $run_dir"
            fi
            # End with the one-command fix entry point, on its own line so it copies cleanly.
            msg+=$'\nOr paste this to have Claude fix it:\n'"$ROOT/bin/postplan-fix $pr"
            if [[ "$DRY_RUN" -eq 1 ]]; then
                log "would DM: $DM_CMD --ping $msg"
            else
                dm_ping "$msg" || true
                pcw_mark_dm "$STATE" "$pr" "$key"
            fi
        fi
        continue
    fi
    # These three skips send no DM: reconcile already sent the one that matters.
    if pcw_pending_has "$STATE" "$pr"; then
        skip "$pr" "rescue pending"; continue
    fi
    if pcw_declined_head "$STATE" "$pr" "$key" "$sha"; then
        skip "$pr" "holdrepeat declined (head ${sha:0:7})"; continue
    fi
    if [[ "$(pcw_strike_count "$STATE" "$pr" "$key" "$sha")" -ge "$PCW_STRIKE_CAP" ]]; then
        skip "$pr" "no-op rescue cap (head ${sha:0:7})"; continue
    fi
    QUALIFY+=("$pr|$sha|$key|$tip|$kind")
done < <(jq -r 'sort_by(.number) | .[] | select(.isDraft | not)
                | [.number, .headRefName, .headRefOid, .mergeStateStatus, .baseRefName,
                   (if any(.labels[]?; .name == "needs-a-human") then "1" else "0" end)] | @tsv' <<< "$PRS_JSON")

# ── (d2) Stuck set ───────────────────────────────────────────────────────────
# Open, non-draft, unarmed PRs whose newest post-plan run failed or that sit in conflict-hold.
# A green one is skipped as "checks green" every tick and nothing else names it.
# STUCK_ROWS: "<pr>\t<sha>\t<reason>" for each PR whose dm-stuck ledger is due.
STUCK_ROWS=()
while IFS=$'\t' read -r pr branch sha; do
    [[ -n "$pr" ]] || continue
    [[ " ${QUALIFY[*]-} " != *" $pr|"* ]] || continue   # a rescue launches this tick
    ! pcw_inflight "$pr" "$branch" "$SNAP" || continue
    out_dirs=("$ROOT/tools/postplan-harness/out")
    wt_out="$(worktree_out_dir "$branch")"
    [[ -n "$wt_out" ]] && out_dirs+=("$wt_out")
    reason="$(pcw_stuck_reason "$STATE" "$pr" "$branch" "${out_dirs[@]}")"
    [[ -n "$reason" ]] || continue
    pcw_kind_dm_due "$STATE" stuck "$pr" "$reason@$sha" || continue
    log "stuck PR $pr: $reason (head ${sha:0:7})"
    STUCK_ROWS+=("$pr"$'\t'"$sha"$'\t'"$reason")
done < <(jq -r 'sort_by(.number) | .[] | select(.isDraft | not) | select(.autoMergeRequest == null)
                | [.number, .headRefName, .headRefOid] | @tsv' <<< "$PRS_JSON")

# mark_stuck_rows: record the STUCK_ROWS entries the DM listed in dm-stuck/ as DM'd for their
# reason and head. Rows past the block's line cap stay unmarked and go out on a later tick.
mark_stuck_rows() {
    local row pr sha reason n=0
    for row in "${STUCK_ROWS[@]}"; do
        n=$((n + 1))
        [[ "$n" -le "$PCW_STUCK_MAX_LINES" ]] || break
        IFS=$'\t' read -r pr sha reason <<< "$row"
        pcw_kind_mark_dm "$STATE" stuck "$pr" "$reason@$sha"
    done
}

# send_stuck_dm: DM the stuck block on its own, then mark each row in dm-stuck/. Marks only
# after dm_ping succeeds, so a failed send re-tries next tick.
send_stuck_dm() {
    local block
    [[ ${#STUCK_ROWS[@]} -gt 0 ]] || return 0
    block="$(printf '%s\n' "${STUCK_ROWS[@]}" | pcw_stuck_block)"
    if [[ "$DRY_RUN" -eq 1 ]]; then
        log "would DM: $DM_CMD --ping $block"; return 0
    fi
    if ! dm_ping "pr-cycle-watch: these unarmed PRs are stuck and need you."$'\n'"$block"; then
        log "stuck DM failed; retrying next tick"; return 0
    fi
    mark_stuck_rows
}

if [[ ${#QUALIFY[@]} -eq 0 ]]; then
    rm -f "$SKIP_NOTES"
    send_stuck_dm
    log "idle: nothing qualifies"; exit 0
fi

# ── (e) Launch ───────────────────────────────────────────────────────────────
LAUNCH=("${QUALIFY[@]:0:$PCW_MAX_PER_TICK}")
for entry in "${QUALIFY[@]:$PCW_MAX_PER_TICK}"; do
    note "${entry%%|*}" "over the $PCW_MAX_PER_TICK-per-run cap; next tick"
done
csv=""
for entry in "${LAUNCH[@]}"; do csv="${csv:+$csv,}${entry%%|*}"; done
count=${#LAUNCH[@]}

if [[ "$DRY_RUN" -eq 1 ]]; then
    log "would run: $PR_CYCLE_CMD --go --only $csv --max-ready $count"; exit 0
fi

log "launching: $PR_CYCLE_CMD --go --only $csv --max-ready $count"
# The worker outlives this tick, so the launch records a pending entry, not an attempt. The
# entry is written first so a killed tick never loses the launch; a failed launch removes it.
pending_body="# result=$STATE/results/$id.tsv started=$(date +%s)"
for entry in "${LAUNCH[@]}"; do
    IFS='|' read -r l_pr l_sha l_key l_tip _ <<< "$entry"
    pending_body+=$'\n'"$l_pr"$'\t'"$l_sha"$'\t'"$l_key"$'\t'"$l_tip"
done
_pcw_write "$STATE/pending/$id" "$pending_body"
if PR_CYCLE_RESULT_FILE="$STATE/results/$id.tsv" PR_CYCLE_SKIP_NOTES="$SKIP_NOTES" "$PR_CYCLE_CMD" --go --only "$csv" --max-ready "$count"; then
    log "launched; pending $id"
    # Count every DIRTY launch, so the daily cap bounds the conflict re-tries.
    for entry in "${LAUNCH[@]}"; do
        IFS='|' read -r l_pr _ _ _ l_kind <<< "$entry"
        [[ "$l_kind" == DIRTY ]] && pcw_bump_retry "$STATE" "$l_pr" "$TODAY"
    done
else
    rm -f "$STATE/pending/$id"
    log "pr-cycle exited non-zero; no attempt recorded"
fi
# pr-cycle --go returns once launchd starts the worker, so the tick sends the stuck DM itself.
send_stuck_dm
exit 0
