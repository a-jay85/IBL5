    echo "ok: [V]-message-names-row"
else
    echo "FAIL: [V] message must contain '[V]' and the cell text 'Phase 1d probe P1'"
    FAILED=1
fi

# The pipe fixture (case 7) must fire the PIPE message, not a pattern message.
_f="$TMP/v-pipe.md"
printf '%s\n' "$FM"'
| # | What to verify | Test type | Timing | Test file / location |
|---|---------------|-----------|--------|---------------------|
