# Input path set for the tests.yml memo (bin/ci-memo, ADR-0131).
# One git pathspec per line. Superset of every dorny filter that gates a
# memoized job, widened to whole directories so a new file inside one is
# covered without a manifest edit. .github is in wholesale because the
# harness tests read workflow files and .github/scripts.
.github
bin
ibl5/bin
.claude
ibl5/tests
:(glob)**/*.php
:(glob)**/*.sql
:(glob)ibl5/**/*.ts
ibl5/composer.json
ibl5/composer.lock
ibl5/package.json
ibl5/bun.lock
ibl5/phpunit.xml
ibl5/phpstan.neon
ibl5/phpstan-tests.neon
ibl5/phpstan-baseline.neon
ibl5/phpstan-tests-baseline.neon
ibl5/phpstan-rules
ibl5/migrations
ibl5/IBLbot
ibl5/classes/SimRecap
