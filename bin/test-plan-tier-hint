expect_exit "J21 --brief with no value" 2 "$RC"
run_hint "$BASE_TMP/judge-rec" --desc 'Rename a key' --brief "$BASE_TMP/briefs/missing.md"
expect_exit "J21 unreadable brief file beside --desc" 2 "$RC"
expect_match "J21 stderr says cannot read brief file" 'cannot read brief file' "$ERR"
: > "$BASE_TMP/briefs/empty.md"
