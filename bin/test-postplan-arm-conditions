_s7_none="$("$PSC" "$_s7_plan" "$_s7_changed" "" "$_s_empty" 2>&1)"
_s7_ok="$("$PSC" "$_s7_plan" "$_s7_changed" "$_s7_gap_ok" "$_s_empty" 2>&1)"
_s7_notes="$("$PSC" "$_s7_plan" "$_s7_changed" "$_s7_gap_notes" "$_s_empty" 2>&1)"
_s7_decl="$("$PSC" "$_s7_plan" "$_s7_changed" "$_s7_gap_decl" "$_s_empty" 2>&1)"
_s7_count="$(grep -c '^SCOPE-NOTE: gap' <<< "$_s7_none" || true)"
if [ "$_s7_count" -eq 1 ] \
        && grep -qF 'SCOPE-NOTE: gap ibl5/a.php' <<< "$_s7_none" \
        && ! grep -q '^SCOPE-NOTE: gap' <<< "$_s7_ok" \
        && grep -qF 'SCOPE-NOTE: gap ibl5/a.php' <<< "$_s7_notes" \
        && grep -qF 'SCOPE-NOTE: gap ibl5/a.php' <<< "$_s7_decl"; then
    echo "ok: S7 only must-appear gaps are noted; only a Plan gaps bullet clears"
else
    echo "FAIL: S7 — none: '$_s7_none'; plan-gaps: '$_s7_ok'; notes: '$_s7_notes'; declared: '$_s7_decl'"
    FAILED=1
fi

# Case S8 — rejected forms exit 2 with Usage on stderr.
_s8_bad=0
_s8_body="$BASE_TMP/s8-unreadable-body"
printf 'x\n' > "$_s8_body"
chmod 000 "$_s8_body"
for _s8_case in noargs changed body; do
    case "$_s8_case" in
        noargs)  _s8_err="$("$PSC" 2>&1 >/dev/null)"; _s8_rc=$? ;;
        changed) _s8_err="$("$PSC" "$_s1_plan" "$BASE_TMP/s8-no-such-file" 2>&1 >/dev/null)"; _s8_rc=$? ;;
        body)    _s8_err="$("$PSC" "$_s1_plan" "$_s1_changed" "$_s8_body" 2>&1 >/dev/null)"; _s8_rc=$? ;;
    esac
    if [ "$_s8_rc" -ne 2 ] || ! grep -qF 'Usage:' <<< "$_s8_err"; then
        echo "FAIL: S8 — $_s8_case: rc=$_s8_rc stderr='$_s8_err'"
        _s8_bad=1
    fi
done
chmod 600 "$_s8_body"
if [ "$_s8_bad" -eq 0 ]; then
    echo "ok: S8 no args, unreadable changed file and unreadable body each exit 2 with Usage"
else
    FAILED=1
fi

# Case S9 — PR #1996 replay: ScheduleUpdater.php flagged, cleared by the declaring body.
_s9_bare="$("$PSC" "$PSC_FX/plan.md" "$PSC_FX/changed.txt" "" "$PSC_FX/added.txt" 2>&1)"
_s9_decl="$("$PSC" "$PSC_FX/plan.md" "$PSC_FX/changed.txt" "$PSC_FX/body-declared.md" "$PSC_FX/added.txt" 2>&1)"
if grep -qF 'SCOPE-NOTE: unplanned ibl5/classes/Updater/ScheduleUpdater.php' <<< "$_s9_bare" \
        && ! grep -q '^UNPLANNED-FILE:.*ScheduleUpdater.php' <<< "$_s9_bare" \
        && ! grep -q '^SCOPE-NOTE: unplanned' <<< "$_s9_decl" \
        && ! grep -q '^UNPLANNED-FILE:' <<< "$_s9_decl"; then
    echo "ok: S9 #1996 replay notes ScheduleUpdater.php; declaring body clears it"
else
    echo "FAIL: S9 — bare: '$(grep -c '^SCOPE-NOTE:' <<< "$_s9_bare" || true)' notes; declared out: '$_s9_decl'"
    FAILED=1
fi

# ── Matrix extraction must skip fenced rows (feeds conditions (1) and (3)) ────
# Same defect class as the decoy ## Critical Files heading above, on the other
# Phase 5.0 parser: a plan documenting the matrix format carries scaffold rows
# inside a fixture block. Read as declarations they become phantom MISSING: /
# truly-manual items that no diff can resolve, holding the PR forever. Live on
# plan `critical-files-parser-unification` (`tests/X.php`).
MX_FIX="$BASE_TMP/matrix-fence.md"
cat > "$MX_FIX" <<'MXEOF'
## Verification Matrix

````bash
# Outer 4-backtick fence wrapping an inner 3-backtick one: a width-blind parity
# toggle closes here and re-opens at the outer closer, leaking the decoy rows.
```text
inner block
```
| 1 | thing works | PHPUnit | post-impl | `tests/Decoy.php` |
| 2 | looks right | Truly-manual | post-impl | eyeball the decoy |
````

| # | Behavior | Test type | When | Test file |
|---|---|---|---|---|
| 1 | saves row | PHPUnit | post-impl | `ibl5/tests/Unit/RealTest.php` |
MXEOF

MX_PY=$( cd "$REPO_ROOT/tools/postplan-harness" && python3 -c '
import sys
from harness.planfile import parse_matrix
planned, manual, _ = parse_matrix(open(sys.argv[1]).read())
print(",".join(planned) + "|" + str(len(manual)))
' "$MX_FIX" )
if [ "$MX_PY" = "ibl5/tests/Unit/RealTest.php|0" ]; then
    echo "ok: matrix parser skips fenced scaffold rows (planned + truly-manual)"
else
    echo "FAIL: fenced matrix rows leaked into conditions (1)/(3) — got: $MX_PY"
    FAILED=1
fi

# --- pr_aggregator_required directly (shared predicate in bin/lib/pr-armable.sh) ---
# Fail-closed without a fixture, true when master's protection lists the aggregator context.
c15_prot_f="$BASE_TMP/prot-c15-direct.json"
printf '%s' '{"protection":{"required_status_checks":{"contexts":["Tests and Analysis","All checks settled"]}}}' > "$c15_prot_f"
# shellcheck disable=SC2016
if PATH="$SHIMD:$PATH" GH_PROTECTION_FIXTURE="" bash -c \
        'source "$1"; pr_aggregator_required' _ "$REPO_ROOT/bin/lib/pr-armable.sh"; then
    echo "FAIL: pr_aggregator_required returned 0 with unreadable protection (must fail closed)"
    FAILED=1
else
    echo "ok: pr_aggregator_required fails closed on unreadable protection"
fi
# shellcheck disable=SC2016
if PATH="$SHIMD:$PATH" GH_PROTECTION_FIXTURE="$c15_prot_f" bash -c \
        'source "$1"; pr_aggregator_required' _ "$REPO_ROOT/bin/lib/pr-armable.sh"; then
    echo "ok: pr_aggregator_required returns 0 when the context is listed"
else
    echo "FAIL: pr_aggregator_required returned 1 with 'All checks settled' listed"
    FAILED=1
fi

# --- predicate exit-status invariant (the truncation bug) -------------------
# The shim answers OPEN for #1100 and MERGED for every other number, so #1071 is
# the merged predecessor that made pr_dep_holds return 1. `gh api graphql` is not
# shimmed at all, so (11) takes its fail-closed api-error path — which must ALSO
# return 0.
expect_rc0 "rc0: pr_dep_holds, merged predecessor (the pr-triage truncation bug)" \
    "pr_dep_holds \"\$(printf 'x\\nDepends-on: #1071')\""
expect_rc0 "rc0: pr_dep_holds, unmerged predecessor" \
    "pr_dep_holds \"\$(printf 'x\\nDepends-on: #1100')\""
expect_rc0 "rc0: pr_dep_holds, no Depends-on marker" \
    "pr_dep_holds 'a body with no markers'"
expect_rc0 "rc0: pr_manual_testing_clearance, no section" \
    "pr_manual_testing_clearance 'a body with no sections'"

# --- (1) clearance precedence: unchecked box outranks the sentinel -----------
# The section window terminates at the next `## ` heading only when one exists.
# When `## Manual Testing` is the LAST `## ` heading — the shape /post-plan
# emits, since it appends the <!-- files-changed --> footer after it — the
# window runs to EOF, so a sentinel-looking line anywhere in that footer lands
# inside a section that also carries real unchecked manual rows. Sentinel-only
# matching then returns CLEARED and arms auto-merge on a PR with outstanding
# manual work. Hardening, not a live repair: 0 occurrences across the most
# recent 200 PR bodies (`gh pr list --state all --limit 200`, 2026-09-07).
#
# Canary: deleting the `- \[ \]` guard in bin/lib/pr-armable.sh flips the first
# case to CLEARED and it FAILS; restoring it PASSES. Not vacuous.
# expect_clearance <name> <CLEARED|HELD|UNKNOWN> <body> — assert the verdict.
# Sources the lib in a generated subscript for the same reason expect_rc0 does:
# pr-armable.sh is SOURCED, not executed, and is not in this harness's shell.
expect_clearance() { # name  expected  body
    local script="$BASE_TMP/clearance.sh" out
    {
        echo 'set -euo pipefail'
        echo "source '$REPO_ROOT/bin/lib/pr-armable.sh'"
        printf 'pr_manual_testing_clearance "$1"\n'
    } > "$script"
    out="$(PATH="$SHIMD:$PATH" bash "$script" "$3" 2>&1)"
    if [[ "$out" == "$2" ]]; then
        echo "ok: $1"
    else
        echo "FAIL: $1 — expected '$2', got '$out'"
        FAILED=1
    fi
}

expect_clearance "(1) unchecked box + sentinel in one window → HELD" "HELD" \
    "$(printf '## Manual Testing\n\n- [ ] **Verify by hand**\n\n<!-- files-changed:begin -->\nNo manual testing needed - all changes are covered by automated tests.\n')"

# The complement, which fixes the guard's blast radius: a CHECKED box is
# completed evidence, legitimately printed under the sentinel. It must NOT hold,
# or correct PRs stop auto-arming. This is why the guard matches `- [ ]` only
# and not bin/check-pr-manual-testing's shape regex `- \[[ x]\]`.
expect_clearance "(1) checked evidence box + sentinel → still CLEARED" "CLEARED" \
    "$(printf '## Manual Testing\n\nNo manual testing needed - all changes are covered by automated tests.\n\n- [x] bin/test-foo - all cases PASS\n')"
expect_clearance "shell twin stays sentinel-only: all-ticked body is HELD (harness-only widening)" "HELD" \
    "$(printf '## Manual Testing\n\n- [x] **Row 1** - executed\n')"

# --- (1) post-plan tick shape (backlog#691) ---------------------------------
# Phase 6 Step 3 item 4 now TICKS verified rows and keeps them under the
# sentinel as an audit trail. These cases pin the three verdict shapes that
# change relies on, using the exact row shape bin/normalize-manual-testing
# emits. They must pass BEFORE the skill edit (characterization) and after it.
expect_clearance "(1) tick shape: sentinel + all **Row N** ticked → CLEARED" "CLEARED" \
    "$(printf '## Manual Testing\n\nNo manual testing needed — remaining steps are covered by automated checks run in Phase 6; verification is automated: bin/test-foo\n\n- [x] **Row 1** — run bin/test-foo\n- [x] **Row 2** — check the log line\n\n<!-- files-changed:begin -->\n- a.sh\n<!-- files-changed:end -->\n')"
expect_clearance "(1) tick shape: sentinel + one Truly-manual row unticked → HELD" "HELD" \
    "$(printf '## Manual Testing\n\nNo manual testing needed — remaining steps are covered by automated checks run in Phase 6; verification is automated: bin/test-foo\n\n- [x] **Row 1** — run bin/test-foo\n- [ ] **Row 2** — does the new page look right?\n')"
expect_clearance "(1) tick shape: all ticked, no sentinel → HELD" "HELD" \
    "$(printf '## Manual Testing\n\n- [x] **Row 1** — run bin/test-foo\n- [x] **Row 2** — check the log line\n\n<!-- files-changed:begin -->\n- a.sh\n<!-- files-changed:end -->\n')"
# (1) harness Phase 6.7 writes MANUAL_TESTING_SENTINEL_TICKED (harness/classify.py) above
# the rows it ticked (backlog#1360). The wording here must match that constant byte for
# byte; tests/test_manual_testing.py::test_ticked_sentinel_pinned_in_shell_twin_test
# fails on drift. The all-ticked/no-sentinel HELD case above (pinned at :1863-1876 when
# this was written) stays HELD: the shell twin is sentinel-only and is not widened.
expect_clearance "(1) tick shape: Phase 6.7 ticked sentinel + all ticked → CLEARED" "CLEARED" \
    "$(printf '## Manual Testing\n\nNo manual testing needed — every row below was ticked by the harness in Phase 6.7; each is covered by an automated check that passed.\n\n- [x] **Row 1** — run bin/test-foo\n- [x] **Row 2** — check the log line\n\n<!-- files-changed:begin -->\n- a.sh\n<!-- files-changed:end -->\n')"
expect_clearance "(1) tick shape: Phase 6.7 ticked sentinel + one row unticked → HELD" "HELD" \
    "$(printf '## Manual Testing\n\nNo manual testing needed — every row below was ticked by the harness in Phase 6.7; each is covered by an automated check that passed.\n\n- [x] **Row 1** — run bin/test-foo\n- [ ] **Row 2** — does the new page look right?\n')"
expect_clearance "(1) counterfeit: quoted > sentinel and > - [x] before heading, real window unticked → HELD" "HELD" \
    "$(printf '<!-- manual-confirmation:begin -->\n## Manual confirmation needed\n\n> No manual testing needed — quoted from the plan\n> - [x] **Row 1** — quoted from the plan\n<!-- manual-confirmation:end -->\n\n## Manual Testing\n\n- [ ] **Row 1** — run bin/test-foo\n')"
expect_clearance "(1) counterfeit: quoted > sentinel before heading, real window all ticked → HELD" "HELD" \
    "$(printf '<!-- manual-confirmation:begin -->\n## Manual confirmation needed\n\n> No manual testing needed — quoted from the plan\n<!-- manual-confirmation:end -->\n\n## Manual Testing\n\n- [x] **Row 1** — run bin/test-foo\n')"

# backlog#691 relies on the predicate staying sentinel-driven. The tick path
# must never widen bash condition (1) the way armable.py's all_rows_ticked does.
if grep -q 'all_rows_ticked\|ticked_clear' "$REPO_ROOT/bin/lib/pr-armable.sh"; then
    echo "FAIL: bin/lib/pr-armable.sh grew a ticked-only clear (gate weakening)"; FAILED=1
else
    echo "ok: bin/lib/pr-armable.sh has no ticked-only clear"
fi

# --- (1) clearance tail clause: callers must pass the PR's changed files ------
# pr_manual_testing_clearance takes <body> [changed_files]. With changed_files
# empty it returns CLEARED on the bare sentinel and never checks the tail
# clause, so a body saying "No manual testing needed - e2e and unit tests"
# clears even when the PR ships no e2e spec and no unit test. Both callers
# passed only the body until this change. The predicate cases pin the two-arg
# AND semantics; the wiring cases pin that both callers now pass a second arg.
# expect_clearance_2arg <name> <CLEARED|HELD|UNKNOWN> <body> <changed_files>
expect_clearance_2arg() { # name  expected  body  changed_files
    local script="$BASE_TMP/clearance2.sh" out
    {
        echo 'set -euo pipefail'
        echo "source '$REPO_ROOT/bin/lib/pr-armable.sh'"
        printf 'pr_manual_testing_clearance "$1" "$2"\n'
    } > "$script"
    out="$(PATH="$SHIMD:$PATH" bash "$script" "$3" "$4" 2>&1)"
    if [[ "$out" == "$2" ]]; then
        echo "ok: $1"
    else
        echo "FAIL: $1 — expected '$2', got '$out'"
        FAILED=1
    fi
}

TAIL_BODY="$(printf '## Manual Testing\n\nNo manual testing needed — e2e and unit tests\n')"
expect_clearance_2arg "(1) tail names e2e+unit, only a non-test file changed → HELD" "HELD" \
    "$TAIL_BODY" "ibl5/classes/Foo.php"
expect_clearance_2arg "(1) tail names e2e+unit, only the e2e spec changed → HELD (AND, not OR)" "HELD" \
    "$TAIL_BODY" "ibl5/tests/e2e/foo.spec.ts"
expect_clearance_2arg "(1) tail names e2e+unit, both a spec and a *Test.php changed → CLEARED" "CLEARED" \
    "$TAIL_BODY" "$(printf 'ibl5/tests/e2e/foo.spec.ts\nibl5/tests/Unit/FooTest.php')"
expect_clearance_2arg "(1) type-agnostic sentinel + non-test file → CLEARED" "CLEARED" \
    "$(printf '## Manual Testing\n\nNo manual testing needed - all changes are covered by automated tests.\n')" \
    "ibl5/classes/Foo.php"
# Boundary: empty changed_files keeps the one-arg compatibility exit. This is
# the path that let the callers clear without a tail-clause check.
expect_clearance_2arg "(1) tail names e2e+unit, EMPTY changed_files → CLEARED (one-arg compat exit)" "CLEARED" \
    "$TAIL_BODY" ""

# --- (1) static wording (backlog#877) -------------------------------------------
# The runner writes MANUAL_TESTING_SENTINEL_STATIC when the plan's Verification
# Matrix has zero executable rows. Read it from the harness so this fixture tracks
# the real constant. It must stay CLEARED in both the one-arg and two-arg forms: a
# non-test changed file makes the two-arg form run the tail keyword scan, which the
# static tail must not trip.
STATIC_SENTINEL="$(PYTHONPATH="$REPO_ROOT/tools/postplan-harness" python3 -c \
    'from harness.classify import MANUAL_TESTING_SENTINEL_STATIC as s; print(s)' 2>&1)" || true
if [[ "$STATIC_SENTINEL" != "No manual testing needed"* ]]; then
    echo "FAIL: could not read MANUAL_TESTING_SENTINEL_STATIC from harness.classify: $STATIC_SENTINEL"
    FAILED=1
fi
STATIC_BODY="$(printf '## Manual Testing\n\n%s\n' "$STATIC_SENTINEL")"
expect_clearance "(1) static wording → CLEARED" "CLEARED" "$STATIC_BODY"
expect_clearance_2arg "(1) static wording + non-test file → CLEARED (tail has no test keyword)" "CLEARED" \
    "$STATIC_BODY" "ibl5/classes/Foo.php"
# Control: the same body with a test keyword appended to the tail HOLDS on the same
# non-test file, so the CLEARED case above is exercising the tail scan, not skipping it.
expect_clearance_2arg "(1) static wording + appended unit-test tail, non-test file → HELD (control)" "HELD" \
    "$(printf '## Manual Testing\n\n%s covered by unit tests\n' "$STATIC_SENTINEL")" "ibl5/classes/Foo.php"

# Wiring: both callers must pass a changed-file list as the second argument.
# Negative half: the exact one-arg call shipped on master must be gone.
# Positive half: the call must carry two double-quoted arguments. The regex
# is generic on purpose so Phase 2 may name its variable freely.
PT="$REPO_ROOT/bin/pr-triage"
TWO_ARG_RE='pr_manual_testing_clearance "[^"]+" "[^"]+"'
if grep -qF 'pr_manual_testing_clearance "$body")' "$PT"; then
    echo "FAIL: pr-triage still calls pr_manual_testing_clearance with the body only (tail clause never checked)"
    FAILED=1
else
    echo "ok: pr-triage no longer makes the one-arg clearance call"
fi
if grep -qE "$TWO_ARG_RE" "$PT"; then
    echo "ok: pr-triage passes changed files to pr_manual_testing_clearance"
else
    echo "FAIL: pr-triage has no two-arg pr_manual_testing_clearance call"
    FAILED=1
fi
expect_rc0 "rc0: pr_golden_hold, golden untouched" \
    "pr_golden_hold '[]'"
expect_rc0 "rc0: pr_feat_hold, non-feat title" \
    "pr_feat_hold 'fix: a bug' '[]'"
expect_rc0 "rc0: pr_pipeline_authored_hold, neither axis fires" \
    "pr_pipeline_authored_hold '[]' 'feature-x'"
expect_rc0 "rc0: pr_unresolved_findings_hold, gh api unavailable (fail-closed path)" \
    "pr_unresolved_findings_hold 1234"
expect_rc0 "rc0: pr_red_check_hold, gh checks unavailable (fail-open path)" \
    "pr_red_check_hold 1234"

# --- bin/pr-triage merge-state allowlist ------------------------------------
# BEHIND is the case that shipped wrong: master's protection is strict (branches
# must be up to date), so a BEHIND PR's green checks ran on a SHA GitHub will not
# merge. The old `mss != "DIRTY"` denylist armed it anyway. BLOCKED must stay
# armable — it is the normal "waiting on a required check" state and 28 of 30 open
# PRs sat in it on 2026-08-22, so blocking it would arm nothing, ever.
expect_mss "mss: BEHIND blocks (stale-green, the #1956 bug)" BEHIND block
expect_mss "mss: DRAFT blocks" DRAFT block
expect_mss "mss: UNKNOWN blocks" UNKNOWN block
expect_mss "mss: DIRTY blocks" DIRTY block
expect_mss "mss: unrecognised enum value blocks (fail-closed)" WIDGET block
expect_mss "mss: empty value blocks (fail-closed)" "" block
expect_mss "mss: BLOCKED still arms (28/30 PRs live here)" BLOCKED arm
expect_mss "mss: CLEAN still arms" CLEAN arm
expect_mss "mss: UNSTABLE still arms (non-required checks only)" UNSTABLE arm
expect_mss "mss: HAS_HOOKS still arms" HAS_HOOKS arm

# T0–T3: pr-triage clearance extraction.
# Extract the two lines Phase 2b added and run them in a generated subscript.
TRIAGE_LINES="$(sed -n \
    -e '/^    changed_paths="\$(printf/p' \
    -e '/^    clearance="\$(pr_manual_testing_clearance/p' \
    "$REPO_ROOT/bin/pr-triage")"
if grep -qF 'changed_paths=' <<< "$TRIAGE_LINES" && \
   grep -qF '"$changed_paths"' <<< "$TRIAGE_LINES"; then
    echo "ok: T0 — pr-triage clearance extraction finds changed_paths pass-through"
else
    echo "FAIL: T0 — pr-triage clearance call not found or missing changed_paths argument"
    FAILED=1
fi
run_triage_clearance() { # body  files-json -> clearance verdict on stdout
    local script="$BASE_TMP/triage_clearance.sh"
    {
        echo 'set -euo pipefail'
        echo "source '$REPO_ROOT/bin/lib/pr-armable.sh'"
        echo 'body="$1"; files="$2"'
        printf '%s\n' "$TRIAGE_LINES"
        echo 'printf "%s\n" "$clearance"'
    } > "$script"
    bash "$script" "$1" "$2" 2>&1
}
_unit_tail_body="$(printf '## Manual Testing\n\nNo manual testing needed — covered by unit tests\n')"
if [[ "$(run_triage_clearance "$_unit_tail_body" '[{"path":"bin/pr-triage"}]')" == "HELD" ]]; then
    echo "ok: T1 — non-test file path → HELD"
else
    echo "FAIL: T1 — expected HELD; dropping changed_paths clears the sentinel tail"
    FAILED=1
fi
if [[ "$(run_triage_clearance "$_unit_tail_body" '[{"path":"ibl5/tests/Foo/BarTest.php","additions":1}]')" == "CLEARED" ]]; then
    echo "ok: T2 — Test.php in diff → CLEARED"
else
    echo "FAIL: T2 — expected CLEARED; wrong jq field (e.g. .name) misses the test path"
    FAILED=1
fi
_plain_body="$(printf '## Manual Testing\n\nNo manual testing needed\n')"
_t3_out="$(run_triage_clearance "$_plain_body" '[]')"
_t3_rc=$?
if [[ "$_t3_out" == "CLEARED" ]] && [[ "$_t3_rc" -eq 0 ]]; then
    echo "ok: T3 — empty array → CLEARED, exit 0"
else
    echo "FAIL: T3 — expected CLEARED exit-0, got '$_t3_out' rc=$_t3_rc"
    FAILED=1
fi

# The truncation guard itself: a mid-loop `set -e` abort exits BEFORE any check
# placed after the loop, so only an EXIT trap can report it. Structural, because
# reproducing an abort would require breaking a predicate on purpose.
if grep -qF 'trap triage_exit_guard EXIT' "$REPO_ROOT/bin/pr-triage"; then
    echo "ok: pr-triage installs the EXIT trap that reports a truncated sweep"
else
    echo "FAIL: pr-triage has no EXIT trap — a mid-loop abort reverts to reporting"
    echo "      a partial table with an empty stderr (the 5-of-30 failure mode)"
    FAILED=1
fi

