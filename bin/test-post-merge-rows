#!/usr/bin/env bash
# test-post-merge-rows — contract harness for bin/lib/post-merge-rows.sh.
#
# Usage: bin/test-post-merge-rows
#
# Sources the lib and drives its five functions. PMR_LIB overrides the lib path so a
# mutated scratch copy can be checked; unset, the repo lib is used.

[ "${BASH_VERSINFO[0]:-0}" -ge 4 ] || { printf '%s: bash 4+ required (this is bash %s). Run: brew install bash\n' "${0##*/}" "${BASH_VERSION:-?}" >&2; exit 2; }
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/lib/harness.sh
. "$SCRIPT_DIR/lib/harness.sh"
H_FAIL_FD=2  # FAIL: lines stay on stderr, as in the sibling harnesses

LIB="${PMR_LIB:-$SCRIPT_DIR/lib/post-merge-rows.sh}"
[ -f "$LIB" ] || { echo "STOP: no lib at $LIB" >&2; exit 1; }
# shellcheck source=bin/lib/post-merge-rows.sh
. "$LIB"

h_tmp SCRATCH
trap 'h_cleanup' EXIT

# --- 1-4: row parsing ---------------------------------------------------------------
pmr_parse_row '- **Row 1** — run X'
h_eq "legacy-untagged kind" manual "$PMR_KIND"
h_eq "legacy-untagged valid" 1 "$PMR_VALID"
h_eq "legacy-untagged label" '**Row 1**' "$PMR_LABEL"
h_eq "legacy-untagged text" '— run X' "$PMR_TEXT"

pmr_parse_row '- **Row 2** [manual] — set secret'
h_eq "tag-manual kind" manual "$PMR_KIND"
h_eq "tag-manual valid" 1 "$PMR_VALID"
h_eq "tag-manual text" '— set secret' "$PMR_TEXT"

pmr_parse_row '- **Row 3** [auto:ci check-301] — curl prod'
h_eq "tag-auto-ci kind" auto:ci "$PMR_KIND"
h_eq "tag-auto-ci name" check-301 "$PMR_NAME"
h_eq "tag-auto-ci valid" 1 "$PMR_VALID"
h_eq "tag-auto-ci text" '— curl prod' "$PMR_TEXT"

pmr_parse_row '- [ ] **Row 4** [auto:mac sim-recap.install] — install'
h_eq "tag-auto-mac-checkbox kind" auto:mac "$PMR_KIND"
h_eq "tag-auto-mac-checkbox name" sim-recap.install "$PMR_NAME"

pmr_parse_row '- **Row 5** [the runbook](https://example.com/doc) — follow it'
h_eq "leading-link kind" manual "$PMR_KIND"
h_eq "leading-link valid" 1 "$PMR_VALID"
h_eq "leading-link text kept" '[the runbook](https://example.com/doc) — follow it' "$PMR_TEXT"

# --- 5: bad names stay manual, invalid, and are never evaluated ---------------------
rm -f /tmp/pmr-pwn
while IFS= read -r _row; do
    pmr_parse_row "$_row"
    h_eq "bad-names kind [$_row]" manual "$PMR_KIND"
    h_eq "bad-names valid [$_row]" 0 "$PMR_VALID"
    h_eq "bad-names name [$_row]" "" "$PMR_NAME"
done <<'ROWS'
- **Row 1** [auto:ci ../x] — t
- **Row 1** [auto:ci a/b] — t
- **Row 1** [auto:ci $(touch /tmp/pmr-pwn)] — t
- **Row 1** [auto:ci ] — t
- **Row 1** [auto:ci  x] — t
- **Row 1** [auto:foo x] — t
- **Row 1** [Manual] — t
ROWS
h_absent "bad-names never evaluated" /tmp/pmr-pwn

# --- 6: CRLF ------------------------------------------------------------------------
pmr_parse_row $'- **Row 3** [auto:ci check-301] — curl prod\r'
h_eq "crlf kind" auto:ci "$PMR_KIND"
h_eq "crlf name" check-301 "$PMR_NAME"
h_eq "crlf text" '— curl prod' "$PMR_TEXT"

# --- 7-8: section extraction --------------------------------------------------------
cat > "$SCRATCH/body.md" <<'BODY'
- **Row 9** above the section
## After merge
- **Row 1** inside one
- [ ] **Row 2** [manual] inside two
prose line
<!-- after-merge:end -->
- **Row 3** after the anchor
## Notes
- **Row 4** after the next heading
BODY
h_eq "rows-section-bounds" '- **Row 1** inside one
- [ ] **Row 2** [manual] inside two' "$(pmr_rows "$SCRATCH/body.md")"

cat > "$SCRATCH/fenced.md" <<'BODY'
## After merge
```markdown
- **Row 1** [manual] — fenced example
```
````
```
- **Row 2** still inside the 4-backtick fence
````
~~~
## After merge
- **Row 3** under a fenced heading
~~~
- **Row 4** real
BODY
h_eq "rows-skip-fenced" '- **Row 4** real' "$(pmr_rows "$SCRATCH/fenced.md")"

printf '# Summary\n- **Row 1** not in a section\n' > "$SCRATCH/absent.md"
_out="$(bash -c 'set -euo pipefail; . "$1"; pmr_rows "$2"' _ "$LIB" "$SCRATCH/absent.md")"
_rc=$?
h_eq "rows-absent exit" 0 "$_rc"
h_eq "rows-absent output" "" "$_out"

# --- 9: count validation ------------------------------------------------------------
for _v in 0 12 007; do
    if pmr_is_count "$_v"; then h_pass "is-count accepts [$_v]"; else h_fail "is-count accepts [$_v]" "rejected"; fi
done
for _v in "" 1a -1 " 1" "1 " 1.0 $'1\n2'; do
    if pmr_is_count "$_v"; then h_fail "is-count rejects [$_v]" "accepted"; else h_pass "is-count rejects [$_v]"; fi
done

# --- 10: needs-you reasons table ----------------------------------------------------
_pt() {  # label want-reasons args...
    local _lbl="$1" _wr="$2"
    shift 2
    unset PMR_PING PMR_PING_REASONS
    pmr_needs_you_reasons "$@"
    h_eq "reasons-table $_lbl reasons" "$_wr" "$PMR_NEEDS_YOU_REASONS"
    h_eq "reasons-table $_lbl sets no PMR_PING" "unset" "${PMR_PING+set}${PMR_PING-unset}"
}
_pt all-clear "" 0 0 checklist=success
_pt manual manual 1 0 checklist=success
_pt auto-failed auto-failed 0 1 checklist=success
_pt job-failure job:checklist=failure 0 0 checklist=failure
_pt job-cancelled job:checklist=cancelled 0 0 checklist=cancelled
_pt job-skipped job:checklist=skipped 0 0 checklist=skipped
_pt job-empty job:checklist= 0 0 checklist=
_pt bad-manual bad-count:manual abc 0
_pt empty-manual bad-count:manual "" 0
_pt bad-failed bad-count:auto_failed 0 x
_pt no-jobs "" 0 0

_err="$SCRATCH/huge.err"
pmr_needs_you_reasons 99999999999999999999999 0 2> "$_err"
h_eq "reasons-table huge reasons" manual "$PMR_NEEDS_YOU_REASONS"
h_not_contains "reasons-table huge no arithmetic error" "$(cat "$_err")" "integer expression"

# The old entry point is gone.
if declare -F pmr_ping_decision >/dev/null; then
    h_fail "pmr_ping_decision is removed" "still defined"
else
    h_pass "pmr_ping_decision is removed"
fi

# --- 11: no args under set -u -------------------------------------------------------
_out="$(bash -c 'set -euo pipefail; . "$1"; pmr_needs_you_reasons; printf "%s" "$PMR_NEEDS_YOU_REASONS"' _ "$LIB")"
_rc=$?
h_eq "reasons-no-args exit" 0 "$_rc"
h_eq "reasons-no-args result" "bad-count:manual bad-count:auto_failed" "$_out"

# --- 12: executor lookup ------------------------------------------------------------
# A scratch bin/ holding a copy of the lib: the lib finds executors next to itself.
mkdir -p "$SCRATCH/bin/lib"
cp "$LIB" "$SCRATCH/bin/lib/post-merge-rows.sh"
_ready() {
    bash -c '. "$1"; if pmr_executor_ready "$2"; then echo yes; else echo no; fi' _ "$SCRATCH/bin/lib/post-merge-rows.sh" "$1"
}
h_eq "executor-none ci" no "$(_ready auto:ci)"
h_eq "executor-none mac" no "$(_ready auto:mac)"
: > "$SCRATCH/bin/post-merge-ci-run"
h_eq "executor-ci ci" yes "$(_ready auto:ci)"
h_eq "executor-ci mac still absent" no "$(_ready auto:mac)"
: > "$SCRATCH/bin/post-merge-run"
h_eq "executor-mac mac" yes "$(_ready auto:mac)"
h_eq "executor-unknown kind" no "$(_ready manual)"
h_eq "executor-no-arg" no "$(_ready '')"
mkdir -p "$SCRATCH/bin2/lib" "$SCRATCH/bin2/post-merge-ci-run"
cp "$LIB" "$SCRATCH/bin2/lib/post-merge-rows.sh"
h_eq "executor-directory is not a file" no "$(bash -c '. "$1"; if pmr_executor_ready auto:ci; then echo yes; else echo no; fi' _ "$SCRATCH/bin2/lib/post-merge-rows.sh")"

# --- prose detector: fixture manifest (matrix row 5) ---------------------------------
FIXDIR="$SCRIPT_DIR/fixtures/after-merge-prose"
while IFS=$'\t' read -r _fx _want; do
    [ -n "$_fx" ] || continue
    if pmr_prose_hits "$FIXDIR/$_fx" > /dev/null; then _got=hit; else _got=clean; fi
    h_eq "prose-fixture $_fx" "$_want" "$_got"
done < "$FIXDIR/manifest.txt"

# --- prose text filter: fence, comment, blockquote, inline code (matrix row 6) -------
cat > "$SCRATCH/prose.md" <<'EOF'
plain prose line with `inline code` here
```
fenced line
```
> quoted line
<!-- comment line -->
after the comment
EOF
_pt="$(pmr_prose_text "$SCRATCH/prose.md")"
h_eq "prose-text keeps prose" 1 "$(grep -c 'plain prose line' <<< "$_pt")"
h_eq "prose-text maps inline code" 1 "$(grep -c 'with CODE here' <<< "$_pt")"
h_eq "prose-text drops fence" 0 "$(grep -c 'fenced line' <<< "$_pt")"
h_eq "prose-text drops blockquote" 0 "$(grep -c 'quoted line' <<< "$_pt")"
h_eq "prose-text drops comment" 0 "$(grep -c 'comment line' <<< "$_pt")"
h_eq "prose-text keeps line after comment" 1 "$(grep -c 'after the comment' <<< "$_pt")"

# A comment that closes on a `>` line must close; a `>` line outside a comment opens nothing.
cat > "$SCRATCH/quote-close.md" <<'EOF'
before the comment
<!-- a note that spans
> two lines and closes here -->
after: run this after merge
EOF
_pt="$(pmr_prose_text "$SCRATCH/quote-close.md")"
h_eq "prose-text comment closing on quote line keeps later prose" \
    $'1\tbefore the comment\n4\tafter: run this after merge' "$_pt"
_pt="$(pmr_prose_text "$SCRATCH/quote-close.md" 1)"
h_eq "prose-text keep=1 output for quote-line close" \
    $'1\tbefore the comment\n2\t<!-- a note that spans\n4\tafter: run this after merge' "$_pt"

cat > "$SCRATCH/quote-open.md" <<'EOF'
> quoted <!-- never closed
later prose
EOF
_pt="$(pmr_prose_text "$SCRATCH/quote-open.md")"
h_eq "prose-text unclosed comment in blockquote swallows nothing" $'2\tlater prose' "$_pt"

cat > "$SCRATCH/quote-inside.md" <<'EOF'
<!-- a note that spans
> still inside the comment
-->
after the real close
EOF
_pt="$(pmr_prose_text "$SCRATCH/quote-inside.md")"
h_eq "prose-text quote line inside comment prints nothing" $'4\tafter the real close' "$_pt"

cat > "$SCRATCH/quote-tail.md" <<'EOF'
<!-- note
> end --> quoted tail <!-- never closed
later prose
EOF
_pt="$(pmr_prose_text "$SCRATCH/quote-tail.md")"
h_eq "prose-text quote-line tail after close is dropped and opens nothing" $'3\tlater prose' "$_pt"

# --- waiver (matrix row 7) -----------------------------------------------------------
printf 'no waiver here\n' > "$SCRATCH/w-none.md"
printf '<!-- after-merge-prose-ok: 12345678901234 -->\n' > "$SCRATCH/w-14.md"
printf '<!-- after-merge-prose-ok: 123456789012345 -->\n' > "$SCRATCH/w-15.md"
pmr_waiver "$SCRATCH/w-none.md"; h_eq "waiver none" 1 "$?"
pmr_waiver "$SCRATCH/w-14.md"; h_eq "waiver 14 chars malformed" 2 "$?"
pmr_waiver "$SCRATCH/w-15.md"; h_eq "waiver 15 chars valid" 0 "$?"

# --- pmr_plan_check (matrix rows 7 and 8) --------------------------------------------
STEPS="$SCRATCH/steps"; mkdir -p "$STEPS"
PROSE='The owner runs the installer once on the Mac after merge.'
printf '# Plan\n\n%s\n' "$PROSE" > "$SCRATCH/p-prose.md"
_o="$(pmr_plan_check "$SCRATCH/p-prose.md" "$STEPS" "")"; _rc=$?
h_eq "plan-check prose no row fails" 1 "$_rc"
h_eq "plan-check prose names [AM]" 1 "$(grep -c '^\[AM\] owner-after-merge prose' <<< "$_o")"

printf '# Plan\n\n%s\n\n<!-- after-merge-prose-ok: owner step covered by the digest -->\n' "$PROSE" > "$SCRATCH/p-waived.md"
pmr_plan_check "$SCRATCH/p-waived.md" "$STEPS" "" > /dev/null; h_eq "plan-check valid waiver passes" 0 "$?"

printf '# Plan\n\n%s\n\n<!-- after-merge-prose-ok: short -->\n' "$PROSE" > "$SCRATCH/p-badwaiver.md"
_o="$(pmr_plan_check "$SCRATCH/p-badwaiver.md" "$STEPS" "")"; _rc=$?
h_eq "plan-check malformed waiver fails closed" 1 "$_rc"
h_eq "plan-check malformed waiver names reason length" 1 "$(grep -c 'at least 15 characters' <<< "$_o")"

printf '# Plan\n\n%s\n\n## After merge\n\n- **Row 1** [manual] — run the installer\n' "$PROSE" > "$SCRATCH/p-row.md"
pmr_plan_check "$SCRATCH/p-row.md" "$STEPS" "" > /dev/null; h_eq "plan-check row present passes" 0 "$?"

printf '# Plan\n\n%s\n\n```markdown\n## After merge\n\n- **Row 1** [manual] — example\n```\n' "$PROSE" > "$SCRATCH/p-fenced.md"
_o="$(pmr_plan_check "$SCRATCH/p-fenced.md" "$STEPS" "")"; _rc=$?
h_eq "plan-check fenced example row does not count" 1 "$_rc"
h_eq "plan-check fenced row names [AM] prose" 1 "$(grep -c '^\[AM\] owner-after-merge prose' <<< "$_o")"

printf '# Plan\n\n## After merge\n\n- **Row 1** [auto:mac ghost-step] — run it\n' > "$SCRATCH/p-nostep.md"
_o="$(pmr_plan_check "$SCRATCH/p-nostep.md" "$STEPS" "")"; _rc=$?
h_eq "plan-check missing step fails" 1 "$_rc"
h_eq "plan-check missing step names it" 1 "$(grep -c 'auto:mac ghost-step' <<< "$_o")"

printf '# Plan\n\n## After merge\n\n- **Row 1** [auto:mac ghost-step] — run it\n\nbin/post-merge-steps/ghost-step — NEW\n' > "$SCRATCH/p-cue.md"
pmr_plan_check "$SCRATCH/p-cue.md" "$STEPS" "" > /dev/null; h_eq "plan-check creation cue passes" 0 "$?"

: > "$STEPS/real-step"
printf '# Plan\n\n## After merge\n\n- **Row 1** [auto:mac real-step] — run it\n' > "$SCRATCH/p-disk.md"
pmr_plan_check "$SCRATCH/p-disk.md" "$STEPS" "" > /dev/null; h_eq "plan-check step on disk passes" 0 "$?"

_o="$(pmr_plan_check "$SCRATCH/p-disk.md" "$STEPS" "3 1 7")"; _rc=$?
h_eq "plan-check row number taken by matrix fails" 1 "$_rc"
h_eq "plan-check taken row names the repeat" 1 "$(grep -c 'repeats a Verification Matrix row number' <<< "$_o")"

printf '# Plan\n\n## After merge\n\n- **Row 1** [bogus tag] — run it\n' > "$SCRATCH/p-unparse.md"
_o="$(pmr_plan_check "$SCRATCH/p-unparse.md" "$STEPS" "")"; _rc=$?
h_eq "plan-check unparseable row fails" 1 "$_rc"
h_eq "plan-check unparseable row names it" 1 "$(grep -c 'unparseable After merge row' <<< "$_o")"

printf '# Plan\n\n## After merge\n\n- **Row 1** [auto:mac real-step] — a\n- **Row 1** [auto:mac real-step] — b\n' > "$SCRATCH/p-dup.md"
_o="$(pmr_plan_check "$SCRATCH/p-dup.md" "$STEPS" "")"; _rc=$?
h_eq "plan-check repeated After merge row number fails" 1 "$_rc"
h_eq "plan-check repeated row names the repeat" 1 "$(grep -c 'repeats an earlier After merge row number' <<< "$_o")"

# A post-merge: matrix row near the top, then about 1 MB of prose. Piping pmr_prose_text into
# grep -q under pipefail SIGPIPEs the producer after the first match and reads as "no
# post-merge: row", a false [AM] prose violation. awk, not `yes | head`: no pipe here either.
awk -v p="$PROSE" 'BEGIN {
    print "# Plan\n\n| 1 | x | Truly-manual | post-impl | post-merge: live host only |\n"; print p
    for (i = 0; i < 20000; i++) print "filler prose line " i " that keeps the producer writing"
}' > "$SCRATCH/p-big.md"
_o="$(set -o pipefail; pmr_plan_check "$SCRATCH/p-big.md" "$STEPS" "")"; _rc=$?
h_eq "plan-check large plan with post-merge: row passes under pipefail" 0 "$_rc"
h_eq "plan-check large plan prints no [AM]" "" "$_o"

h_done
