#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-architect-contract-split — proves the rules/detail split dropped no operative rule.
#
# Four token classes extracted from each pre-split baseline fixture:
#   bold lead-ins  : bullet-start **…** (every operative rule is named this way)
#   gate tokens    : [A-Z0-9]+ references to bin/check-plan gate letters
#   fenced blocks  : fenced code block bodies (sha256 hash + first non-blank line)
#   headings       : ## and ### section headings (sort -u)
#
# Four assertions per file pair:
#   1. No-loss    : every baseline token survives in rules ∪ detail
#   2. Residency  : every operative token (bold/gate/fenced) survives in rules file specifically
#   3. Orphans    : every Why: _…-detail.md § <heading> pointer in rules resolves
#   4. Size caps  : _architect-contract.md ≤ 29696 B, _plan-verification.md ≤ 21504 B
#   5. Read budget: every plan-architect def carries the no-re-read bounds (check_read_budget)
#   6. Added rules: every post-split bold lead-in in ADDED_RULES is resident in the contract (check_added_rules)
#                   (only enforced when the detail file exists — skipped on the un-split tree)
#   7. Mutation rule: the whole-matrix mutation bullet, its detail pointer, the detail heading and the SKILL.md gate-9 pointer all stay resident (check_mutation_rule)
#
# Run: bin/test-architect-contract-split              (exit 0 = pass, 1 = rule missing)
#      bin/test-architect-contract-split --self-test  (also proves checker catches a deletion)
#      bin/test-architect-contract-split --help       (usage)

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
FAILED=0

usage() {
  printf 'usage: %s [--self-test | --help]\n' "$(basename "$0")"
}

# ── Flag parsing ─────────────────────────────────────────────────────────────
MODE=check
case "${1-}" in
  "")           MODE=check ;;
  --self-test)  MODE=selftest ;;
  -h|--help)    usage; exit 0 ;;
  *)            printf 'unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
esac

# ── Allowlists ───────────────────────────────────────────────────────────────
# Format: "token<TAB>reason" — reason must be ≥15 chars or the entry is itself a failure.
# EXPECTED_ABSENT: baseline tokens deliberately deleted; exempt from no-loss assertion.
EXPECTED_ABSENT=(
  "Backlog / tracking-doc status update	replaced by the \"Backlog / GitHub Issue close\" bullet when ADR-0121 retired the in-repo markdown backlog corpus; there is no tracking doc row left to flip"
  "### Delegate — <phase name>	packet format updated: gate E (assertion binding) added Assertions field and expanded Self-verify field; old format intentionally superseded (PR #2346)"
)

# Format: "token<TAB>detail-file-path<TAB>reason"
# Waives residency for the token, but tightens no-loss: token must be in the named detail file.
# A named detail file that does not yet exist is a hard failure.
EXPECTED_MOVED=(
)

# Format: "token<TAB>reason" — bold lead-ins added to _architect-contract.md AFTER the split.
# The presplit fixture cannot see them, so assertions 1-2 do not protect them; check_added_rules does.
ADDED_RULES=(
  "**Existing tests the spec forces to edit.**	backlog#912: plans omitted existing test files their own spec changes forced to edit (PR #2336), and fidelity review flagged them as scope creep"
)

# ── Validate allowlists ───────────────────────────────────────────────────────
validate_allowlists() {
  local entry token reason rest
  for entry in "${EXPECTED_ABSENT[@]+"${EXPECTED_ABSENT[@]}"}"; do
    token="${entry%%	*}"
    reason="${entry#*	}"
    if [[ "${#reason}" -lt 15 ]]; then
      printf 'FAIL: EXPECTED_ABSENT entry has reason shorter than 15 chars: "%s"\n' "$token"
      FAILED=1
    fi
  done
  for entry in "${EXPECTED_MOVED[@]+"${EXPECTED_MOVED[@]}"}"; do
    token="${entry%%	*}"
    rest="${entry#*	}"
    local detail_file="${rest%%	*}"
    reason="${rest#*	}"
    if [[ "${#reason}" -lt 15 ]]; then
      printf 'FAIL: EXPECTED_MOVED entry has reason shorter than 15 chars: "%s"\n' "$token"
      FAILED=1
    fi
    if [[ ! -f "$detail_file" ]]; then
      printf 'FAIL: EXPECTED_MOVED references non-existent detail file: %s (token: "%s")\n' "$detail_file" "$token"
      FAILED=1
    fi
  done
}

# ── Token extractors ─────────────────────────────────────────────────────────
extract_bold() {
  sed -n 's/^[[:space:]]*[-*][[:space:]]*\*\*\([^*][^*]*\)\*\*.*/\1/p' "$1"
}

extract_gate() {
  grep -oE '\[[A-Z0-9]+\]' "$1" | sort -u
}

sha256_file() {
  shasum -a 256 "$1" 2>/dev/null | awk '{print $1}' \
    || sha256sum "$1" 2>/dev/null | awk '{print $1}'
}

extract_fenced() {
  local file="$1"
  local tmpdir in_block block_num block_file hash first_line
  tmpdir="$(mktemp -d)"
  in_block=0
  block_num=0

  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^[[:space:]]*\`\`\` ]]; then
      if [[ "$in_block" -eq 0 ]]; then
        in_block=1
        block_num=$((block_num + 1))
        block_file="$tmpdir/block_${block_num}"
      else
        if [[ -f "$block_file" ]]; then
          hash="$(sha256_file "$block_file")"
          first_line="$(grep -m1 '[^[:space:]]' "$block_file" 2>/dev/null || true)"
          if [[ -n "$hash" && -n "$first_line" ]]; then
            printf '%s\t%s\n' "$hash" "$first_line"
          fi
        fi
        in_block=0
      fi
    elif [[ "$in_block" -eq 1 ]]; then
      printf '%s\n' "$line" >> "$block_file"
    fi
  done < "$file"

  rm -rf "$tmpdir"
}

extract_headings() {
  grep -E '^#{2,3}[[:space:]]' "$1" | sort -u
}

# ── Allowlist lookup helpers ──────────────────────────────────────────────────
is_expected_absent() {
  local token="$1"
  local entry
  for entry in "${EXPECTED_ABSENT[@]+"${EXPECTED_ABSENT[@]}"}"; do
    if [[ "${entry%%	*}" == "$token" ]]; then
      return 0
    fi
  done
  return 1
}

# Prints the detail-file path for an EXPECTED_MOVED token, or exits 1 if not found.
expected_moved_detail() {
  local token="$1"
  local entry rest
  for entry in "${EXPECTED_MOVED[@]+"${EXPECTED_MOVED[@]}"}"; do
    if [[ "${entry%%	*}" == "$token" ]]; then
      rest="${entry#*	}"
      printf '%s' "${rest%%	*}"
      return 0
    fi
  done
  return 1
}

count_tokens() {
  local s="$1"
  if [[ -z "$s" ]]; then printf '0'; return; fi
  printf '%s\n' "$s" | grep -c . || printf '0'
}

# ── Vacuity spot-assertions ───────────────────────────────────────────────────
assert_canonical_gate_tokens() {
  local gate_tokens="$1"
  local tok
  # Canonical bin/check-plan gate tokens that must appear in the contract file.
  # [D] was removed prior to this PR; [M][V] live in _plan-verification.md, not here.
  for tok in '[C]' '[F]' '[H]' '[P]' '[S]' '[T]' '[8]' '[13]'; do
    if ! grep -qF -- "$tok" <<< "$gate_tokens"; then
      printf 'FAIL: gate class missing canonical token %s\n' "$tok"
      FAILED=1
    fi
  done
}

assert_phase_drift_present() {
  local baseline="$1"
  if ! grep -qF 'PHASE_DRIFT:' "$baseline"; then
    printf 'FAIL: PHASE_DRIFT: literal not found in %s — fenced extractor may be blind\n' \
      "$(basename "$baseline")"
    FAILED=1
  fi
}

# ── Per-class check helpers ───────────────────────────────────────────────────
check_token_noloss_residency() {
  local class="$1" token="$2" combined_content="$3" rules_content="$4"
  local moved_to=""
  moved_to="$(expected_moved_detail "$token" 2>/dev/null || true)"
  if [[ -n "$moved_to" ]]; then
    if ! grep -qF -- "$token" "$moved_to" 2>/dev/null; then
      printf 'FAIL [%s no-loss]: token absent from EXPECTED_MOVED detail file %s: "%s"\n' \
        "$class" "$moved_to" "$token"
      FAILED=1
    fi
  else
    if ! grep -qF -- "$token" <<< "$combined_content"; then
      printf 'FAIL [%s no-loss]: token missing from rules+detail: "%s"\n' "$class" "$token"
      FAILED=1
    fi
    if ! grep -qF -- "$token" <<< "$rules_content"; then
      printf 'FAIL [%s residency]: token not in rules file: "%s"\n' "$class" "$token"
      FAILED=1
    fi
  fi
}

check_fenced_noloss_residency() {
  local token="$1" combined_fenced="$2" rules_fenced="$3"
  local fhash="${token%%	*}"
  local fline="${token#*	}"
  local moved_to=""
  moved_to="$(expected_moved_detail "$fline" 2>/dev/null || true)"
  if [[ -n "$moved_to" ]]; then
    local moved_fenced
    moved_fenced="$(extract_fenced "$moved_to" 2>/dev/null || true)"
    if ! grep -qF -- "$fhash" <<< "$moved_fenced"; then
      printf 'FAIL [fenced no-loss]: block absent from EXPECTED_MOVED detail file %s: "%s"\n' \
        "$moved_to" "$fline"
      FAILED=1
    fi
  else
    if ! grep -qF -- "$fhash" <<< "$combined_fenced"; then
      printf 'FAIL [fenced no-loss]: fenced block missing from rules+detail: "%s"\n' "$fline"
      FAILED=1
    fi
    if ! grep -qF -- "$fhash" <<< "$rules_fenced"; then
      printf 'FAIL [fenced residency]: fenced block not in rules file: "%s"\n' "$fline"
      FAILED=1
    fi
  fi
}

# ── Main check function ───────────────────────────────────────────────────────
# Args: baseline rules detail label size_cap check_phase_drift
check_pair() {
  local baseline="$1" rules="$2" detail="$3" label="$4" size_cap="$5"
  local check_phase_drift="${6:-false}"

  printf '\n=== %s ===\n' "$label"

  # Extract baseline tokens
  local bold gate fenced headings
  bold="$(extract_bold "$baseline")"
  gate="$(extract_gate "$baseline")"
  fenced="$(extract_fenced "$baseline")"
  headings="$(extract_headings "$baseline")"

  # Count and print per-class summary (vacuity check)
  local cnt_bold cnt_gate cnt_fenced cnt_headings
  cnt_bold="$(count_tokens "$bold")"
  cnt_gate="$(count_tokens "$gate")"
  cnt_fenced="$(count_tokens "$fenced")"
  cnt_headings="$(count_tokens "$headings")"
  printf 'classes: bold=%d gate=%d fenced=%d heading=%d   (file: %s)\n' \
    "$cnt_bold" "$cnt_gate" "$cnt_fenced" "$cnt_headings" "$(basename "$baseline")"

  [[ "$cnt_bold" -gt 0 ]]     || { printf 'FAIL: bold lead-in extractor returned 0 tokens\n'; FAILED=1; }
  [[ "$cnt_gate" -gt 0 ]]     || { printf 'FAIL: gate token extractor returned 0 tokens\n'; FAILED=1; }
  [[ "$cnt_fenced" -gt 0 ]]   || { printf 'FAIL: fenced block extractor returned 0 tokens\n'; FAILED=1; }
  [[ "$cnt_headings" -gt 0 ]] || { printf 'FAIL: heading extractor returned 0 tokens\n'; FAILED=1; }

  # Canonical gate token and PHASE_DRIFT checks apply to contract pair only
  if [[ "$check_phase_drift" == "true" ]]; then
    assert_canonical_gate_tokens "$gate"
    assert_phase_drift_present "$baseline"
  fi

  # Build target content
  local rules_content detail_content combined_content
  rules_content="$(cat "$rules" 2>/dev/null || true)"
  if [[ -f "$detail" ]]; then
    detail_content="$(cat "$detail" 2>/dev/null || true)"
  else
    detail_content=""
  fi
  combined_content="${rules_content}"$'\n'"${detail_content}"

  local rules_fenced detail_fenced combined_fenced
  rules_fenced="$(extract_fenced "$rules" 2>/dev/null || true)"
  if [[ -f "$detail" ]]; then
    detail_fenced="$(extract_fenced "$detail" 2>/dev/null || true)"
  else
    detail_fenced=""
  fi
  combined_fenced="${rules_fenced}"$'\n'"${detail_fenced}"

  # ── Assertions 1+2: bold lead-ins ────────────────────────────────────────
  while IFS= read -r token; do
    [[ -n "$token" ]] || continue
    is_expected_absent "$token" && continue
    check_token_noloss_residency "bold" "$token" "$combined_content" "$rules_content"
  done <<< "$bold"

  # ── Assertions 1+2: gate tokens ──────────────────────────────────────────
  while IFS= read -r token; do
    [[ -n "$token" ]] || continue
    is_expected_absent "$token" && continue
    check_token_noloss_residency "gate" "$token" "$combined_content" "$rules_content"
  done <<< "$gate"

  # ── Assertions 1+2: fenced blocks ────────────────────────────────────────
  while IFS= read -r token; do
    [[ -n "$token" ]] || continue
    local fline="${token#*	}"
    is_expected_absent "$fline" && continue
    check_fenced_noloss_residency "$token" "$combined_fenced" "$rules_fenced"
  done <<< "$fenced"

  # ── Assertion 1: headings (no-loss only; residency not required) ──────────
  while IFS= read -r token; do
    [[ -n "$token" ]] || continue
    is_expected_absent "$token" && continue
    local moved_to=""
    moved_to="$(expected_moved_detail "$token" 2>/dev/null || true)"
    if [[ -n "$moved_to" ]]; then
      if ! grep -qF -- "$token" "$moved_to" 2>/dev/null; then
        printf 'FAIL [heading no-loss]: heading absent from EXPECTED_MOVED detail file %s: "%s"\n' \
          "$moved_to" "$token"
        FAILED=1
      fi
    else
      if ! grep -qF -- "$token" <<< "$combined_content"; then
        printf 'FAIL [heading no-loss]: heading missing from rules+detail: "%s"\n' "$token"
        FAILED=1
      fi
    fi
  done <<< "$headings"

  # ── Assertion 3: no orphan pointers ──────────────────────────────────────
  local pointer_line detail_ref heading detail_path
  while IFS= read -r pointer_line; do
    [[ -n "$pointer_line" ]] || continue
    detail_ref="$(printf '%s' "$pointer_line" | grep -oE '_[a-z-]+-detail\.md' | head -1 || true)"
    heading="$(printf '%s' "$pointer_line" | sed 's/.*§ //' | tr -d '.,;)')"
    [[ -n "$detail_ref" && -n "$heading" ]] || continue

    # Try both possible locations for the detail file
    detail_path="$REPO_ROOT/.claude/skills/plan/$detail_ref"
    [[ -f "$detail_path" ]] || detail_path="$REPO_ROOT/.claude/review-shared/$detail_ref"
    # If detail file doesn't exist yet (pre-split), skip the orphan check for it
    [[ -f "$detail_path" ]] || continue

    heading_esc=$(printf '%s' "$heading" | sed 's/[][\\^$.|?*+(){}]/\\&/g')
    if ! grep -qE "^#{2,3}[[:space:]]+${heading_esc}" "$detail_path" 2>/dev/null; then
      printf 'FAIL [orphan pointer]: rules file pointer to missing heading "%s" in %s\n' \
        "$heading" "$detail_ref"
      FAILED=1
    fi
  done < <(grep -oE '_(architect-contract|plan-verification)-detail\.md § [^.,;)]+' "$rules" 2>/dev/null || true)

  # ── Assertion 4: size cap (only when detail file exists) ─────────────────
  if [[ -f "$detail" ]]; then
    local actual_size
    actual_size="$(wc -c < "$rules" | tr -d '[:space:]')"
    if [[ "$actual_size" -gt "$size_cap" ]]; then
      printf 'FAIL [size cap]: %s is %d bytes (cap: %d)\n' "$(basename "$rules")" "$actual_size" "$size_cap"
      FAILED=1
    else
      printf 'size: %d bytes (cap %d) — OK\n' "$actual_size" "$size_cap"
    fi
  fi
}

# ── Self-test mode ────────────────────────────────────────────────────────────
run_selftest() {
  local tmpdir
  tmpdir="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$tmpdir'" EXIT

  local rules_src="$REPO_ROOT/.claude/skills/plan/_architect-contract.md"
  local mutated="$tmpdir/_architect-contract.md"
  cp "$rules_src" "$mutated"

  # Delete the **Size budget** bullet — a stable operative rule not touched by any sibling branch
  grep -vF '**Size budget**' "$mutated" > "$tmpdir/clean.md" && mv "$tmpdir/clean.md" "$mutated"

  if grep -qF '**Size budget**' "$mutated"; then
    printf 'FAIL: self-test mutation did not remove target bullet\n' >&2
    exit 1
  fi

  # Run check_pair against mutated file; expect FAILED > 0
  local old_failed=$FAILED
  FAILED=0
  check_pair \
    "$REPO_ROOT/bin/fixtures/architect-contract-presplit.md" \
    "$mutated" \
    "$REPO_ROOT/.claude/skills/plan/_architect-contract-detail.md" \
    "self-test-mutation" \
    28672 \
    true

  if [[ "$FAILED" -gt 0 ]]; then
    printf 'PASS: self-test correctly detected dropped rule (%d failure(s))\n' "$FAILED"
    FAILED=$old_failed
  else
    printf 'FAIL: self-test did not detect dropped rule — checker is vacuous\n'
    FAILED=$((old_failed + 1))
  fi

  # Mutation 2: drop the first ADDED_RULES bullet; check_added_rules must fail.
  local added_mut="$tmpdir/_architect-contract-added.md"
  local first_token="${ADDED_RULES[0]%%$'\t'*}"
  grep -vF -- "$first_token" "$rules_src" > "$added_mut"
  if grep -qF -- "$first_token" "$added_mut"; then
    printf 'FAIL: self-test mutation 2 did not remove the added-rule bullet\n' >&2
    exit 1
  fi
  old_failed=$FAILED
  FAILED=0
  check_added_rules "$added_mut"
  if [[ "$FAILED" -gt 0 ]]; then
    printf 'PASS: self-test detected dropped added rule (%d failure(s))\n' "$FAILED"
    FAILED=$old_failed
  else
    printf 'FAIL: check_added_rules did not detect dropped bullet — checker is vacuous\n'
    FAILED=$((old_failed + 1))
  fi

  # Mutations 3-6: check_mutation_rule must fail when any one of its four anchors is removed.
  local detail_src="$REPO_ROOT/.claude/skills/plan/_architect-contract-detail.md"
  local skill_src="$REPO_ROOT/.claude/skills/plan/SKILL.md"

  # Mutation 3 (A): delete the contract line carrying the bold lead-in.
  local mut_a="$tmpdir/contract-no-lead.md"
  grep -vF -- "$MUTATION_LEAD" "$rules_src" > "$mut_a"
  if grep -qF -- "$MUTATION_LEAD" "$mut_a"; then
    printf 'FAIL: self-test mutation 3 did not remove the mutation bullet\n' >&2
    exit 1
  fi
  expect_mutation_rule_fails "deleted mutation bullet" "$mut_a" "$detail_src" "$skill_src"

  # Mutation 4 (B): strip only the pointer text; the lead-in must survive so the pointer probe is what fails.
  local mut_b="$tmpdir/contract-no-pointer.md"
  sed 's/Mutation-statement counter-examples//' "$rules_src" > "$mut_b"
  if grep -qF -- "$MUTATION_POINTER" "$mut_b" || ! grep -qF -- "$MUTATION_LEAD" "$mut_b"; then
    printf 'FAIL: self-test mutation 4 did not isolate the pointer text\n' >&2
    exit 1
  fi
  expect_mutation_rule_fails "stripped contract pointer" "$mut_b" "$detail_src" "$skill_src"

  # Mutation 5 (C): delete the heading line from a detail copy.
  local mut_c="$tmpdir/detail-no-heading.md"
  grep -vF -- "$MUTATION_HEADING" "$detail_src" > "$mut_c"
  if grep -qF -- "$MUTATION_HEADING" "$mut_c"; then
    printf 'FAIL: self-test mutation 5 did not remove the detail heading\n' >&2
    exit 1
  fi
  expect_mutation_rule_fails "deleted detail heading" "$rules_src" "$mut_c" "$skill_src"

  # Mutation 6 (D): strip the gate-9 pointer sentence from a SKILL.md copy.
  local mut_d="$tmpdir/skill-no-pointer.md"
  sed 's/ Every behavioral row also names the production-code mutation.*$//' "$skill_src" > "$mut_d"
  if grep -qF 'Mutation-statement counter-examples' "$mut_d"; then
    printf 'FAIL: self-test mutation 6 did not remove the gate-9 sentence\n' >&2
    exit 1
  fi
  expect_mutation_rule_fails "stripped gate-9 pointer" "$rules_src" "$detail_src" "$mut_d"
}

# ── Entry point ───────────────────────────────────────────────────────────────
CONTRACT_BASELINE="$REPO_ROOT/bin/fixtures/architect-contract-presplit.md"
VERIFICATION_BASELINE="$REPO_ROOT/bin/fixtures/plan-verification-presplit.md"
CONTRACT_RULES="$REPO_ROOT/.claude/skills/plan/_architect-contract.md"
CONTRACT_DETAIL="$REPO_ROOT/.claude/skills/plan/_architect-contract-detail.md"
VERIFICATION_RULES="$REPO_ROOT/.claude/review-shared/_plan-verification.md"
VERIFICATION_DETAIL="$REPO_ROOT/.claude/review-shared/_plan-verification-detail.md"

[[ -f "$CONTRACT_BASELINE" ]]     || { printf 'FAIL: baseline missing: %s\n' "$CONTRACT_BASELINE"; exit 1; }
[[ -f "$VERIFICATION_BASELINE" ]] || { printf 'FAIL: baseline missing: %s\n' "$VERIFICATION_BASELINE"; exit 1; }

validate_allowlists

# -- Assertion 5: read-budget bounds are resident in every architect def -----
# The bounds must live in the AGENT DEFS, not only in _architect-contract.md: a def is
# always resident in the architect's system prompt, whereas the contract is a Read that a
# mid-plan compaction drops. Losing the bound is what causes the next compaction.
check_read_budget() {
  printf '\n=== read budget ===\n'
  local def defs=(plan-architect plan-architect-xhigh plan-architect-sonnet)
  local -a probes=(
    '## Your read budget'
    '_architect-contract.md` exactly once'
    'Never Read a `*-detail.md` companion'
    'Never Read `$DRAFT`'
    'Never Read the same file twice'
  )
  local probe path missing
  for def in "${defs[@]}"; do
    path="$REPO_ROOT/.claude/agents/$def.md"
    if [[ ! -f "$path" ]]; then
      printf 'FAIL [read budget]: missing agent def %s\n' "$path"
      FAILED=$((FAILED + 1)); continue
    fi
    missing=0
    for probe in "${probes[@]}"; do
      if ! grep -qF -- "$probe" "$path"; then
        printf 'FAIL [read budget]: %s.md is missing bound: %s\n' "$def" "$probe"
        FAILED=$((FAILED + 1)); missing=1
      fi
    done
    [[ "$missing" -eq 0 ]] && printf '%s.md: all %d bounds present\n' "$def" "${#probes[@]}"
  done

  # The detail files claim the architect never reads them. Keep that claim honest:
  # no architect def may instruct a Read of either companion.
  for def in "${defs[@]}"; do
    path="$REPO_ROOT/.claude/agents/$def.md"
    [[ -f "$path" ]] || continue
    if grep -qE 'Read [^.]*_(architect-contract|plan-verification)-detail\.md' "$path"; then
      printf 'FAIL [read budget]: %s.md instructs a Read of a *-detail.md companion\n' "$def"
      FAILED=$((FAILED + 1))
    fi
  done

  # SKILL.md Step 3 must hand the architect the once-only instruction.
  if ! grep -qF 'exactly once, as its first action' "$REPO_ROOT/.claude/skills/plan/SKILL.md"; then
    printf 'FAIL [read budget]: SKILL.md Step 3 no longer says the contract is Read exactly once\n'
    FAILED=$((FAILED + 1))
  fi
}

# -- Assertion 6: post-split rules stay resident -----------------------------
check_added_rules() {
  local rules_file="$1" entry token reason
  printf '\n=== added rules ===\n'
  for entry in "${ADDED_RULES[@]}"; do
    token="${entry%%$'\t'*}"
    reason="${entry#*$'\t'}"
    if [[ "${#reason}" -lt 15 || "$reason" == "$entry" ]]; then
      printf 'FAIL [added rules]: entry for %s lacks a reason of at least 15 chars\n' "$token"
      FAILED=$((FAILED + 1))
      continue
    fi
    if ! grep -qF -- "$token" "$rules_file"; then
      printf 'FAIL [added rules]: %s missing from %s\n' "$token" "$(basename "$rules_file")"
      FAILED=$((FAILED + 1))
    fi
  done
}

# -- Assertion 7: the whole-matrix mutation rule stays resident ---------------
# The bullet and its pointer live in _architect-contract.md (29645 of 29696 B), the counter-example
# section lives in _architect-contract-detail.md, and SKILL.md gate 9 points at both. Losing
# any one leaves the mutation rule unreachable from the place a plan author reads.
MUTATION_LEAD='**The mutation statement extends to the whole matrix, not just the negative-path rows above:**'
MUTATION_POINTER='`_architect-contract-detail.md` § Mutation-statement counter-examples'
MUTATION_HEADING='### Mutation-statement counter-examples'
MUTATION_SKILL_RE='^9\. \*\*Negative-path coverage\*\*.*Mutation-statement counter-examples'

check_mutation_rule() {
  local contract="$1" detail="$2" skill="$3" f before
  printf '\n=== mutation rule ===\n'
  for f in "$contract" "$detail" "$skill"; do
    if [[ ! -f "$f" ]]; then
      printf 'FAIL [mutation rule]: missing file %s\n' "$f"
      FAILED=$((FAILED + 1)); return 0
    fi
  done
  before=$FAILED
  if ! grep -qF -- "$MUTATION_LEAD" "$contract"; then
    printf 'FAIL [mutation rule]: %s lost the bullet lead-in: %s\n' "$(basename "$contract")" "$MUTATION_LEAD"
    FAILED=$((FAILED + 1))
  fi
  if ! grep -qF -- "$MUTATION_POINTER" "$contract"; then
    printf 'FAIL [mutation rule]: %s lost the pointer: %s\n' "$(basename "$contract")" "$MUTATION_POINTER"
    FAILED=$((FAILED + 1))
  fi
  if ! grep -qF -- "$MUTATION_HEADING" "$detail"; then
    printf 'FAIL [mutation rule]: %s lost the heading: %s\n' "$(basename "$detail")" "$MUTATION_HEADING"
    FAILED=$((FAILED + 1))
  fi
  if ! grep -qE -- "$MUTATION_SKILL_RE" "$skill"; then
    printf 'FAIL [mutation rule]: %s gate 9 lost the mutation-rule pointer\n' "$(basename "$skill")"
    FAILED=$((FAILED + 1))
  fi
  [[ "$FAILED" -eq "$before" ]] && printf 'mutation rule: all 4 probes present\n'
}

# Runs check_mutation_rule on (contract, detail, skill) and expects it to fail.
expect_mutation_rule_fails() {
  local label="$1" old_failed=$FAILED
  FAILED=0
  check_mutation_rule "$2" "$3" "$4"
  if [[ "$FAILED" -gt 0 ]]; then
    printf 'PASS: self-test detected %s (%d failure(s))\n' "$label" "$FAILED"
    FAILED=$old_failed
  else
    printf 'FAIL: check_mutation_rule did not detect %s — checker is vacuous\n' "$label"
    FAILED=$((old_failed + 1))
  fi
}

if [[ "$MODE" == selftest ]]; then
  run_selftest
else
  check_pair \
    "$CONTRACT_BASELINE" \
    "$CONTRACT_RULES" \
    "$CONTRACT_DETAIL" \
    "architect-contract" \
    29696 \
    true

  check_read_budget
  check_added_rules "$CONTRACT_RULES"
  check_mutation_rule "$CONTRACT_RULES" "$CONTRACT_DETAIL" "$REPO_ROOT/.claude/skills/plan/SKILL.md"

  # Cap is 21504 (21 KB), not the plan's 19456 (19 KB). The plan's movable-rationale
  # inventory was right: "## Required format" measures 11197 B in
  # bin/fixtures/plan-verification-presplit.md when its ### subsections are counted with it,
  # matching the plan's 11,172 B, and that rationale was in fact moved (the block is 4952 B
  # now). The gap is elsewhere -- the plan put "## Forced integration-verification trigger"
  # at 5,647 B when it measures 7237 B in the same fixture, and that section is content the
  # plan requires to stay verbatim. That 1590 B underestimate of protected content exceeds
  # the 1018 B by which the split file misses 19456. 29191 B baseline -> 21504 B cap is
  # still a ~26% ratchet, and assertions 1-3 (no-loss, residency, orphan pointers) are what
  # stop a cap met by deleting rules.
  check_pair \
    "$VERIFICATION_BASELINE" \
    "$VERIFICATION_RULES" \
    "$VERIFICATION_DETAIL" \
    "plan-verification" \
    21504 \
    false
fi

if [[ "$FAILED" -ne 0 ]]; then
  printf '\n%d assertion(s) failed\n' "$FAILED"
  exit 1
fi

printf '\nAll assertions passed\n'
exit 0
