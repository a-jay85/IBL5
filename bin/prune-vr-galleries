#!/usr/bin/env bash
# shellcheck shell=bash
if [[ "${1:-}" = "--help" || "${1:-}" = "-h" ]]; then
    cat <<'EOF'
Usage: prune-vr-galleries [--dry-run] [--cutoff-days N] [--max-dirs N] [--keep-file PATH]

Prune stale per-SHA VR gallery directories from the gh-pages checkout.
Operates on cwd (the gh-pages checkout) and never clones.

Options:
  --dry-run        Report only, never git rm.
  --cutoff-days N  Age threshold in whole days (default: 7). Must be a positive integer.
  --max-dirs N     After the age pass, keep only the N most recent survivors.
                   Must be a positive integer. Default: unset (no count cap).
  --keep-file PATH 40-hex dir names (one per line; blank and # lines ignored) exempt from both passes.
                   Missing/unreadable/malformed file aborts with exit 1.

Directories matching ./<40-hex-char SHA> whose most-recent commit date is
older than N days are pruned. Directories with no git history are skipped.
Dirs with no git history are never cap-pruned (intentional fail-closed behaviour).

After pruning, blobs in _vr-blobs/ that no surviving gallery index references
(dirs pruned in the same run do not count; keep-file dirs do) and whose newest
commit is older than --cutoff-days are removed. --dry-run prints WOULD GC lines.
EOF
    exit 0
fi
set -euo pipefail

# Prune stale per-SHA VR gallery directories from the gh-pages checkout.
# Operates on cwd (the gh-pages checkout) and never clones.
# A fresh checkout resets filesystem mtimes, so `find -mtime` is unreliable;
# derive each per-SHA dir's age from its newest commit date instead.
# The --keep-file list is produced by `bin/vr-refresh-targets --mode=keep` in the
# vr-pages-cleanup job.

usage() {
  cat >&2 <<'EOF'
Usage: prune-vr-galleries [--dry-run] [--cutoff-days N] [--max-dirs N] [--keep-file PATH]

Options:
  --dry-run        Report only, never git rm.
  --cutoff-days N  Age threshold in whole days (default: 7). Must be a positive integer.
  --max-dirs N     After the age pass, keep only the N most recent survivors.
                   Must be a positive integer. Default: unset (no count cap).
  --keep-file PATH 40-hex dir names (one per line; blank and # lines ignored) exempt from both passes.
                   Missing/unreadable/malformed file aborts with exit 1.

Directories matching ./<40-hex-char SHA> whose most-recent commit date is
older than N days are pruned. Directories with no git history are skipped.
Dirs with no git history are never cap-pruned (they are skipped before they
can enter the survivor list — intentional fail-closed behaviour).

After pruning, blobs in _vr-blobs/ that no surviving gallery index references
(dirs pruned in the same run do not count; keep-file dirs do) and whose newest
commit is older than --cutoff-days are removed. --dry-run prints WOULD GC lines.
EOF
}

dry_run=0
days=7
max_dirs=""
keep_file=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help)
      usage
      exit 0
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --cutoff-days)
      shift
      N="${1:-}"
      case "$N" in
        ''|*[!0-9]*)
          usage
          exit 1
          ;;
      esac
      if ! [ "$N" -gt 0 ]; then
        usage
        exit 1
      fi
      days="$N"
      shift
      ;;
    --max-dirs)
      shift
      N="${1:-}"
      case "$N" in
        ''|*[!0-9]*)
          usage
          exit 1
          ;;
      esac
      if ! [ "$N" -gt 0 ]; then
        usage
        exit 1
      fi
      max_dirs="$N"
      shift
      ;;
    --keep-file)
      shift
      if [[ $# -eq 0 || -z "${1:-}" ]]; then
        echo "prune-vr-galleries: --keep-file needs a path" >&2
        usage
        exit 1
      fi
      keep_file="$1"
      shift
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
  esac
done

# Load the keep file (fail closed): a missing, unreadable, or malformed file
# aborts before any git rm. keep_set is newline-delimited with a leading and
# trailing newline; no associative array, since macOS ships bash 3.2.
keep_set=$'\n'
if [[ -n "$keep_file" ]]; then
  if [[ ! -r "$keep_file" ]]; then
    echo "prune-vr-galleries: keep file not readable: $keep_file" >&2
    exit 1
  fi
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ -z "$line" ]] && continue
    [[ "$line" == \#* ]] && continue
    case "$line" in
      (*[!0-9a-f]*)
        echo "prune-vr-galleries: malformed keep-file line: $line" >&2
        exit 1
        ;;
    esac
    if [ "${#line}" -ne 40 ]; then
      echo "prune-vr-galleries: malformed keep-file line: $line" >&2
      exit 1
    fi
    keep_set+="$line"$'\n'
  done < "$keep_file"
fi

now=$(date +%s)
cutoff=$(( now - days * 86400 ))

removed=0
# Dirs pruned by this run (live or simulated), newline-delimited for bash 3.2.
# Pass 3 (blob GC) treats them as no longer referencing any blob.
pruned_set=$'\n'

# survivors collects "$ts<TAB>$dir" for every dir that survives the age filter.
# Dirs with no git history are skipped before they reach this list, so they are
# never eligible for the count cap either — intentional fail-closed behaviour.
survivors=()

while IFS= read -r dir; do
  b="${dir#./}"
  # \{40\} interval notation is unreliable across find implementations (BSD vs GNU emacs mode);
  # filter in bash instead — same semantics, portable everywhere.
  [ "${#b}" -eq 40 ] || continue
  case "$b" in (*[!0-9a-f]*) continue ;; esac
  case "$keep_set" in
    (*$'\n'"$b"$'\n'*)
      # Linked by an open PR: exempt from the age pass and, because it never
      # enters survivors, from the count cap too.
      if [[ "$dry_run" -eq 1 ]]; then
        echo "KEEP (linked by open PR) $dir"
      else
        echo "KEEP (linked by open PR) $dir" >&2
      fi
      continue
      ;;
  esac
  ts=$(git log -1 --format=%ct -- "$dir")
  if [[ -z "$ts" ]]; then
    echo "WARN: no git history for $dir, skipping" >&2
    continue
  fi
  age=$(( (now - ts) / 86400 ))
  if [ "$ts" -lt "$cutoff" ]; then
    removed=$(( removed + 1 ))
    pruned_set+="$b"$'\n'
    if [[ "$dry_run" -eq 1 ]]; then
      echo "WOULD PRUNE: $dir (age=${age}d)"
    else
      git rm -rq "$dir"
    fi
  else
    survivors+=("$ts"$'\t'"$dir")
    # With --max-dirs set the KEEP line is deferred to pass 2: a survivor the
    # count cap goes on to prune must never log KEEP first, or the run log
    # contradicts itself (and in live mode the dir is git rm'd silently after).
    if [[ -z "$max_dirs" ]]; then
      if [[ "$dry_run" -eq 1 ]]; then
        echo "KEEP: $dir (age=${age}d)"
      else
        echo "KEEP: $dir (age=${age}d)" >&2
      fi
    fi
  fi
done < <(find . -mindepth 1 -maxdepth 1 -type d)

# Pass 2: count cap — prune the oldest survivors beyond --max-dirs N, and emit
# the deferred KEEP lines for the ones that survive it.
# Only runs when --max-dirs was given and there are survivors to rank.
# Ranking: sort by timestamp descending (-k1,1nr), dir name as deterministic
# tiebreak (-k2,2). The first N rows are kept; tail -n +$((N+1)) emits the
# oldest survivors beyond the cap, and emits nothing when survivors <= N — a
# natural no-op at the exactly-at-N boundary.
# Process substitution (not a pipe) keeps removed increments in the current shell.
if [[ -n "$max_dirs" && ${#survivors[@]} -gt 0 ]]; then
  ranked=$(printf '%s\n' "${survivors[@]}" | sort -k1,1nr -k2,2)
  while IFS=$'\t' read -r keep_ts keep_dir; do
    [[ -n "$keep_dir" ]] || continue
    keep_age=$(( (now - keep_ts) / 86400 ))
    if [[ "$dry_run" -eq 1 ]]; then
      echo "KEEP: $keep_dir (age=${keep_age}d)"
    else
      echo "KEEP: $keep_dir (age=${keep_age}d)" >&2
    fi
  done < <(printf '%s\n' "$ranked" | head -n "$max_dirs")
  while IFS=$'\t' read -r cap_ts cap_dir; do
    [[ -n "$cap_dir" ]] || continue
    cap_age=$(( (now - cap_ts) / 86400 ))
    removed=$(( removed + 1 ))
    pruned_set+="${cap_dir#./}"$'\n'
    if [[ "$dry_run" -eq 1 ]]; then
      echo "WOULD PRUNE: $cap_dir (age=${cap_age}d)"
    else
      git rm -rq "$cap_dir"
    fi
  done < <(printf '%s\n' "$ranked" | tail -n +$(( max_dirs + 1 )))
fi

# Pass 3: blob GC. A blob in _vr-blobs/ is removed only when no surviving
# gallery index references it and its newest commit is older than the cutoff.
# Dirs this run pruned (pruned_set) no longer count as referrers; keep-file and
# no-history dirs never enter pruned_set, so their references always count.
# The per-blob lines go to stderr in live mode and stdout under --dry-run (WOULD GC
# lines). The "GC:" summary line always goes to stderr. Neither changes the stdout
# integer in live mode (it counts pruned dirs only).
if [[ -d _vr-blobs ]]; then
  gc_tmp=$(mktemp -d)
  trap 'rm -rf "$gc_tmp"' EXIT
  index_list="$gc_tmp/indexes"
  : > "$index_list"
  while IFS= read -r dir; do
    b="${dir#./}"
    [ "${#b}" -eq 40 ] || continue
    case "$b" in (*[!0-9a-f]*) continue ;; esac
    case "$pruned_set" in (*$'\n'"$b"$'\n'*) continue ;; esac
    if [[ -f "$dir/visual-review/index.html" ]]; then
      printf '%s\n' "$dir/visual-review/index.html" >> "$index_list"
    fi
  done < <(find . -mindepth 1 -maxdepth 1 -type d)
  if [[ -d pr ]]; then
    find pr -mindepth 3 -maxdepth 3 -path 'pr/*/visual-review/index.html' -type f >> "$index_list"
  fi

  # Fail closed: grep exit 1 means no matches (fine); exit >= 2 is a read error.
  refset="$gc_tmp/refset"
  : > "$refset.raw"
  while IFS= read -r idx; do
    rc=0
    grep -ohE '_vr-blobs/[0-9a-f]{64}\.png' "$idx" >> "$refset.raw" || rc=$?
    if [ "$rc" -ge 2 ]; then
      echo "prune-vr-galleries: blob reference scan failed" >&2
      exit 1
    fi
  done < "$index_list"
  sed -e 's|^_vr-blobs/||' -e 's|\.png$||' "$refset.raw" | sort -u > "$refset"

  cands="$gc_tmp/cands"
  : > "$cands"
  while IFS= read -r blob; do
    h="${blob##*/}"
    h="${h%.png}"
    [ "${#h}" -eq 64 ] || continue
    case "$h" in (*[!0-9a-f]*) continue ;; esac
    printf '%s\n' "$h" >> "$cands"
  done < <(find _vr-blobs -mindepth 1 -maxdepth 1 -type f -name '*.png')
  sort -o "$cands" "$cands"

  gc_total=$(wc -l < "$cands" | tr -d ' ')
  gc_unref=0
  gc_young=0
  gc_removed=0
  while IFS= read -r h; do
    [[ -n "$h" ]] || continue
    gc_unref=$(( gc_unref + 1 ))
    blob="_vr-blobs/$h.png"
    bts=$(git log -1 --format=%ct -- "$blob")
    if [[ -z "$bts" ]]; then
      echo "WARN: no git history for $blob, skipping" >&2
      continue
    fi
    if [ "$bts" -ge "$cutoff" ]; then
      gc_young=$(( gc_young + 1 ))
      continue
    fi
    gc_removed=$(( gc_removed + 1 ))
    if [[ "$dry_run" -eq 1 ]]; then
      echo "WOULD GC: $blob (age=$(( (now - bts) / 86400 ))d)"
    else
      git rm -q "$blob"
    fi
  done < <(comm -23 "$cands" "$refset")
  echo "GC: referenced=$(( gc_total - gc_unref )) unreferenced=$gc_unref young=$gc_young gc=$gc_removed" >&2
fi

echo "$removed"
