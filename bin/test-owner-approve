oa_mask() { sed -E -e "s#$TMP#<TMP>#g" -e 's#owner-approve\.[A-Za-z0-9]+#owner-approve.X#g' -e 's#[0-9a-f]{40}#<SHA>#g'; }
oa_corpus() { # <case>: its last exit code and RESULT line, plus the shim calls it made
    mkdir -p "$OA_CORPUS_DIR"
    {
        printf 'rc=%s\n' "$RC"
        grep '^RESULT: ' <<< "$OUT" | tail -n 1
        printf -- '--- gh.log\n'
        if [ -f "$FX/gh.log" ]; then oa_mask < "$FX/gh.log"; fi
        # Distinct calls only: poll counts vary with timing, the set of calls cannot.
        printf -- '--- launchctl.log\n'
        if [ -f "$FX/launchctl.log" ]; then sort -u "$FX/launchctl.log" | oa_mask; fi
    } > "$OA_CORPUS_DIR/$1"
}

if [ $# -gt 0 ]; then CASES="$*"; else CASES="$ALL_CASES"; fi

for name in ${OA_TEST_CASES:-$CASES}; do
    if ! declare -F "$name" >/dev/null; then
        echo "FAIL $name: no such case"
        H_FAIL=$((H_FAIL + 1))
        continue
    fi
    WHY=""
    "$name"
    if [ -n "${OA_CORPUS_DIR:-}" ]; then oa_corpus "$name"; fi
    if [ -z "$WHY" ]; then
        echo "PASS $name"
        H_PASS=$((H_PASS + 1))
    else
        echo "FAIL $name: $WHY"
        printf '%s\n' "$OUT" | sed -n '1,15p' | sed 's/^/    | /'
        H_FAIL=$((H_FAIL + 1))
    fi
done

h_done
