[[ "$(attempt 11)" == "$(key_of aaa1111)" ]] || fail "integration-real-worker-reconcile: attempts/11 is '$(attempt 11)' (file: $(cat "$rf" 2>/dev/null))"
[[ "$(cat "$STATE_DIR/declined/12" 2>/dev/null)" == "$(key_of bbb2222)" ]] \
    || fail "integration-real-worker-reconcile: declined/12 is '$(cat "$STATE_DIR/declined/12" 2>/dev/null)'"
