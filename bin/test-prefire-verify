#!/usr/bin/env bash
# Tests bin/lib/prefire-verify (the pre-fire verification gate) and its wiring
# into bin/post-plan-now, with stubbed PHPUnit / Infection / DB probe.
#
# Usage: bin/test-prefire-verify [case_name ...]
# With no arguments every case runs; with arguments only the named cases run.
# Prints `PASS <name>` / `FAIL <name>: <why>` per case. Exit 0 iff all pass.
# A case reported as `PENDING` (a dependency owned by another change has not
# landed) does not fail the run.
set -uo pipefail

# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GATE="$REPO/bin/lib/prefire-verify"
PPN="$REPO/bin/post-plan-now"

h_tmp TMP
mkdir -p "$TMP/shims" "$TMP/runlog" "$TMP/Library/LaunchAgents"
# Never touch real launchd, the keychain, or a shared /tmp log dir.
printf '#!/bin/sh\nexit 1\n' > "$TMP/shims/security"
printf '#!/bin/sh\nexit 0\n' > "$TMP/shims/launchctl"
chmod +x "$TMP/shims/security" "$TMP/shims/launchctl"
export PATH="$TMP/shims:$PATH"
export IBL5_USAGE_GATE_STATE_DIR="$TMP/gate"
mkdir -p "$IBL5_USAGE_GATE_STATE_DIR"
export POSTPLAN_LOG_DIR="$TMP/runlog" PLAN_NOW_LOG_DIR="$TMP/runlog"
unset CLAUDE_HEADLESS

WHY=""      # failure reasons for the current case
PENDING=""  # set by a case whose dependency has not landed
OUT=""      # combined stdout+stderr of the last run
RC=0        # exit code of the last run

note() { WHY="${WHY:+$WHY; }$*"; }
want_rc() { [ "$RC" -eq "$1" ] || note "expected exit $1, got $RC"; }
want_out() { grep -qF -- "$1" <<< "$OUT" || note "output lacks '$1'"; }
refute_out() { if grep -qF -- "$1" <<< "$OUT"; then note "output unexpectedly has '$1'"; fi; }
want_cnt() { # <counter> <n>
    local got; got=$(cnt "$1")
    [ "$got" -eq "$2" ] || note "counter $1 expected $2, got $got"
}
cnt() {
    if [ -f "$CNT/$1" ]; then wc -l < "$CNT/$1" | tr -d ' '; else echo 0; fi
}

# ---------------------------------------------------------------------------
# Fixture: a fresh temp git repo plus stubs. Sets D (case dir), R (repo),
# CNT (counter dir), PLAN (plan file path), and the PREFIRE_* seams.
# ---------------------------------------------------------------------------
new_case() {
    D=$(mktemp -d "$TMP/case.XXXXXX")
    R="$D/repo"
    CNT="$D/cnt"
    PLAN="$D/plan.md"
    mkdir -p "$R/ibl5/vendor/bin" "$CNT" "$D/stubs"
    export CNT
    unset STUB_PHPUNIT_RC STUB_MUT_MODE
    cat > "$R/ibl5/vendor/bin/phpunit" <<'EOF'
#!/usr/bin/env bash
echo run >> "$CNT/phpunit"
exit "${STUB_PHPUNIT_RC:-0}"
EOF
    cat > "$D/stubs/mutation" <<'EOF'
#!/usr/bin/env bash
echo run >> "$CNT/mutation"
case "${STUB_MUT_MODE:-ok}" in
    3672)
        echo "2295 mutations were generated"
        echo "491 mutants were escaped"
        echo "[ERROR] The minimum required MSI percentage should be 100%, but actual is 78.6%"
        exit 1 ;;
    prereq) echo "Error: pcov is not loaded"; exit 3 ;;
    *) echo "Mutation Score Indicator (MSI): 100%"; exit 0 ;;
esac
EOF
    printf '#!/usr/bin/env bash\necho run >> "$CNT/probe"\nexit "${STUB_PROBE_RC:-0}"\n' > "$D/stubs/probe"
    printf '#!/usr/bin/env bash\necho run >> "$CNT/excludes"\nexit 0\n' > "$D/stubs/excludes"
    chmod +x "$R/ibl5/vendor/bin/phpunit" "$D/stubs/mutation" "$D/stubs/probe" "$D/stubs/excludes"
    (
        cd "$R" || exit 1
        git init -q -b master
        git config user.email t@example.com
        git config user.name Test
        printf 'a\n' > ibl5/tracked.txt
        git add -A
        git commit -q -m init
    ) || { echo "HARNESS-SETUP: fixture repo failed" >&2; exit 2; }
    export PREFIRE_PHPUNIT_CMD="vendor/bin/phpunit"
    export PREFIRE_MUTATION_CMD="$D/stubs/mutation"
    export PREFIRE_DB_PROBE_CMD="$D/stubs/probe"
    export PREFIRE_EXCLUDES_CMD="$D/stubs/excludes"
}

# write_plan <row-line>...  — each argument is a full table row.
write_plan() {
    {
        printf '# Plan\n\n## Verification Matrix\n\n'
        printf '| # | What to verify | Test type | Timing | Test file / location |\n'
        printf '|---|----------------|-----------|--------|----------------------|\n'
        local r
        for r in "$@"; do printf '%s\n' "$r"; done
        printf '\nAll verification is automated.\n'
    } > "$PLAN"
}

row() { # <n> <cmd>
    printf '| %s | check %s | CLI-executable | post-impl | %s |' "$1" "$1" "$2"
}

# Three green rows that count their runs.
green_plan() {
    write_plan "$(row 1 "echo x >> $CNT/row1")" \
               "$(row 2 "echo x >> $CNT/row2")" \
               "$(row 3 "echo x >> $CNT/row3")"
}

run_gate() { # args passed to the gate; cwd = fixture repo
    OUT=$(cd "$R" && "$GATE" --base master "$@" 2>&1); RC=$?
}

# The gate's per-worktree pass-record dir (git-path may be relative to the repo).
state_dir() {
    local p; p=$(cd "$R" && git rev-parse --git-path prefire-verify)
    case "$p" in /*) printf '%s' "$p" ;; *) printf '%s/%s' "$R" "$p" ;; esac
}
pass_files() { # <glob>
    local d f; d=$(state_dir)
    [ -d "$d" ] || return 0
    for f in "$d"/*; do
        [ -e "$f" ] || continue
        f=${f##*/}
        if [[ "$f" =~ $1 ]]; then printf '%s\n' "$f"; fi
    done
}
tree_hash() {
    local idx rc
    idx=$(mktemp "$TMP/idx.XXXXXX")
    (cd "$R" && cp "$(git rev-parse --git-path index)" "$idx" \
        && GIT_INDEX_FILE="$idx" git add -A >/dev/null 2>&1 \
        && GIT_INDEX_FILE="$idx" git write-tree)
    rc=$?
    rm -f "$idx"
    return $rc
}

# ---------------------------------------------------------------------------
# Gate cases (matrix rows 7-21)
# ---------------------------------------------------------------------------
test_matrix_row_failure_refuses_and_names_row() {
    new_case
    write_plan "$(row 1 true)" "$(row 2 true)" "$(row 3 'exit 7')"
    run_gate --plan "$PLAN"
    want_rc 1
    want_out "FAIL matrix row 3 exited 7"
    [ -z "$(pass_files '\.matrix\..*\.pass$')" ] || note "a matrix pass record exists"
}

test_unrun_row_refuses_without_gate_record() {
    new_case
    write_plan "$(row 1 "echo x >> $CNT/row1; exit 7")"
    local d sha tree
    d=$(state_dir); mkdir -p "$d"
    sha=$(git hash-object "$PLAN")
    tree=$(tree_hash)
    printf 'All rows passed.\n' > "$D/ledger.md"
    printf 'stage=matrix tree=OTHERTREE key=%s at=x by=prefire-verify\n' "$sha" \
        > "$d/OTHERTREE.matrix.$sha.pass"
    # Correct filename, wrong tree= field inside.
    printf 'stage=matrix tree=WRONGTREE key=%s at=x by=prefire-verify\n' "$sha" \
        > "$d/$tree.matrix.$sha.pass"
    run_gate --plan "$PLAN"
    want_rc 1
    want_cnt row1 1
}

test_matrix_extract_skips_near_miss_rows() {
    new_case
    {
        printf '## Verification Matrix\n\n'
        printf '| # | What to verify | Test type | Timing | Test file / location |\n'
        printf '|---|---|---|---|---|\n'
        printf '| 1 | manual; run CLI-executable thing | Truly-manual | post-impl | echo manual |\n'
        printf '| 2 | pre | CLI-executable | pre-impl | echo pre |\n'
        printf '| 3 | plan-time (one-time-check: plan-time corpus diff) | CLI-executable | post-impl | echo onetime |\n'
        printf '| 4 | merge | CLI-executable | post-impl | post-merge: echo merged |\n'
        printf '| 5 | run-only | CLI-executable (run-only) | post-impl | echo runonly |\n'
        printf '| 6 | pipe | CLI-executable | post-impl | echo a \\| tr a b |\n'
        printf '\n## Next\n\n| 7 | after | CLI-executable | post-impl | echo outside |\n'
    } > "$PLAN"
    local got want
    got=$(bash -c ". '$REPO/bin/lib/plan-matrix-rows.sh'; plan_matrix_rows '$PLAN'" 2>&1)
    want=$'5\techo runonly\n6\techo a | tr a b'
    [ "$got" = "$want" ] || note "expected exactly rows 5 and 6, got: $(printf '%s' "$got" | tr '\t\n' ' >')"
}

test_plan_without_matrix_refuses() {
    new_case
    printf '# Plan\n\n## Phase 1\n\nNothing here.\n' > "$PLAN"
    run_gate --plan "$PLAN"
    want_rc 1
    want_out "no evidence to check"
}

test_phpunit_red_refuses() {
    new_case
    green_plan
    export STUB_PHPUNIT_RC=1
    run_gate --plan "$PLAN"
    want_rc 1
    want_out "FAIL phpunit: full default suite red"
}

test_db_down_fails_closed_naming_row() {
    new_case
    write_plan "$(row 1 true)" "$(row 2 "echo x >> $CNT/row2; bin/db-query 'SELECT 1'")"
    export STUB_PROBE_RC=3
    run_gate --plan "$PLAN"
    want_rc 3
    want_out "DB unreachable; matrix row 2 needs it"
    want_cnt row2 0
    unset STUB_PROBE_RC
}

test_all_green_passes_and_records() {
    new_case
    green_plan
    run_gate --plan "$PLAN"
    want_rc 0
    local n
    n=$(pass_files '\.pass$' | wc -l | tr -d ' ')
    [ "$n" -eq 3 ] || note "expected 3 .pass files, got $n"
}

test_cache_hit_skips_rerun() {
    new_case
    green_plan
    run_gate --plan "$PLAN"; want_rc 0
    run_gate --plan "$PLAN"; want_rc 0
    want_cnt phpunit 1
    want_cnt mutation 1
    want_cnt row1 1
    want_out "pass cached for tree"
}

test_tree_change_invalidates_cache() {
    new_case
    green_plan
    run_gate --plan "$PLAN"; want_rc 0
    printf 'b\n' >> "$R/ibl5/tracked.txt"
    run_gate --plan "$PLAN"; want_rc 0
    want_cnt phpunit 2
}

test_checks_mutating_tree_refuse() {
    new_case
    green_plan
    printf '#!/usr/bin/env bash\necho run >> "$CNT/phpunit"\necho gen > ../generated.txt\nexit 0\n' > "$D/stubs/phpunit-mut"
    chmod +x "$D/stubs/phpunit-mut"
    export PREFIRE_PHPUNIT_CMD="$D/stubs/phpunit-mut"
    run_gate --plan "$PLAN"
    want_rc 4
    want_out "changed the working tree"
    [ -z "$(pass_files '\.phpunit\.pass$')" ] || note "a phpunit pass record exists"
}

test_adhoc_no_plan_runs_phpunit_and_infection() {
    new_case
    run_gate
    want_rc 0
    want_out "SKIP matrix: no plan"
    want_cnt phpunit 1
    want_cnt mutation 1
}

test_infection_below_threshold_refuses_3672() {
    new_case
    green_plan
    export STUB_MUT_MODE=3672
    run_gate --plan "$PLAN"
    want_rc 1
    want_out "FAIL infection: below CI threshold"
    want_out "491 mutants were escaped"
    [ -z "$(pass_files '\.infection\..*\.pass$')" ] || note "an infection pass record exists"
}

test_infection_at_threshold_passes() {
    new_case
    green_plan
    run_gate --plan "$PLAN"
    want_rc 0
    [ -n "$(pass_files '\.infection\..*\.pass$')" ] || note "no infection pass record"
}

test_infection_prereq_missing_fails_closed() {
    new_case
    green_plan
    export STUB_MUT_MODE=prereq
    run_gate --plan "$PLAN"
    want_rc 3
    want_out "prerequisite missing"
    [ -z "$(pass_files '\.infection\..*\.pass$')" ] || note "an infection pass record exists"
}

test_mutation_diff_flags_match_ci() {
    new_case
    local wf="$REPO/.github/workflows/mutation-pr.yml" md="$REPO/bin/mutation-diff"
    local flags f n=0 re
    re='^--(min-msi|min-covered-msi|ignore-msi|git-diff-lines|only-covering|map-source|skip-initial|configuration=infection)'
    flags=$(awk '/vendor\/bin\/infection/ {on=1} on {print} on && !/\\[[:space:]]*$/ {exit}' "$wf" \
        | tr -s ' \\' '\n\n' | command grep -E -- "$re" || true)
    for f in $flags; do
        n=$((n + 1))
        grep -qF -- "$f" "$md" || note "CI flag $f missing from bin/mutation-diff"
    done
    [ "$n" -ge 5 ] || note "extracted only $n CI flags; parsing broke"
}

# ---------------------------------------------------------------------------
# post-plan-now cases (matrix rows 22-29)
# ---------------------------------------------------------------------------
# Builds MAIN (with origin) and a worktree WT on branch feat-x holding an
# untracked file, so post-plan-now passes its nothing-to-ship check.
new_ppn_case() {
    new_case
    local origin="$D/origin.git"
    MAIN="$D/IBL5"
    WT="$D/IBL5-worktrees/feat-x"
    mkdir -p "$D/home"
    git init -q --bare -b master "$origin"
    mkdir -p "$MAIN/bin/lib" "$MAIN/ibl5/vendor/bin"
    (
        cd "$MAIN" || exit 1
        git init -q -b master
        git config user.email t@example.com
        git config user.name Test
        git remote add origin "file://$origin"
        cp "$REPO/bin/lib/git-helpers.sh" bin/lib/git-helpers.sh
        cp "$R/ibl5/vendor/bin/phpunit" ibl5/vendor/bin/phpunit
        printf 'a\n' > ibl5/tracked.txt
        git add -A
        git commit -q -m init
        git push -q origin master
        git fetch -q origin
        git worktree add -q -b feat-x "$WT" master
    ) || { echo "HARNESS-SETUP: ppn fixture failed" >&2; exit 2; }
    git -C "$WT" config branch.feat-x.iblBase master
    printf 'new\n' > "$WT/NewTest.php"
    R="$WT"   # the gate state helpers now point at the worktree
    PLAN="$D/plan.md"
    rm -f "$D"/runlog.* 2>/dev/null || true
    rm -f "$POSTPLAN_LOG_DIR"/post-plan-now-feat-x-*.log 2>/dev/null || true
}

run_ppn() { # extra post-plan-now args; PPN_GATE overrides the gate path
    OUT=$(cd "$WT" && \
        BRANCH_BASE_OFFLINE=1 HOME="$D/home" \
        POST_PLAN_MAIN_ROOT="$MAIN" POST_PLAN_SELF_BIN="$MAIN/bin" \
        PREFIRE_VERIFY_SCRIPT="${PPN_GATE:-$GATE}" \
        "$PPN" "$@" 2>&1); RC=$?
}
fired() { ls "$POSTPLAN_LOG_DIR"/post-plan-now-feat-x-*.log >/dev/null 2>&1; }

test_post_plan_now_refuses_exit_9_on_gate_failure() {
    new_ppn_case
    write_plan "$(row 1 'exit 7')"
    run_ppn --plan "$PLAN"
    want_rc 9
    want_out "pre-fire verification refused"
    ! fired || note "post-plan-now launched despite a red gate"
}

test_post_plan_now_fires_when_gate_green() {
    new_ppn_case
    green_plan
    run_ppn --plan "$PLAN"
    refute_out "pre-fire verification refused"
    fired || note "no runner log; post-plan-now did not get past the gate"
}

test_post_plan_now_adhoc_no_plan_skips_matrix_only() {
    new_ppn_case
    run_ppn
    want_out "SKIP matrix: no plan"
    want_cnt phpunit 1
    refute_out "pre-fire verification refused"
}

test_bypass_logs_line_and_fires() {
    new_ppn_case
    write_plan "$(row 1 'exit 7')"
    local log="$MAIN/.git/prefire-verify-bypass.log" n
    run_ppn --plan "$PLAN" "--skip-verify=fixture bypass reason ok"
    [ "$RC" -ne 9 ] || note "exit 9; the bypass did not fire"
    if [ -f "$log" ]; then
        n=$(wc -l < "$log" | tr -d ' ')
        [ "$n" -eq 1 ] || note "bypass log has $n lines, expected 1"
        grep -qF -- "fixture bypass reason ok" "$log" || note "bypass log lacks the reason"
    else
        note "no bypass log at $log"
    fi
    want_cnt phpunit 0
}

test_bypass_refused_under_headless() {
    new_ppn_case
    write_plan "$(row 1 true)"
    local log="$MAIN/.git/prefire-verify-bypass.log"
    CLAUDE_HEADLESS=1 run_ppn --plan "$PLAN" "--skip-verify=fixture bypass reason ok"
    want_rc 9
    want_out "refused under CLAUDE_HEADLESS"
    [ ! -f "$log" ] || note "bypass log was written under headless"
}

test_bypass_short_reason_rejected() {
    new_ppn_case
    write_plan "$(row 1 true)"
    run_ppn --plan "$PLAN" "--skip-verify=short"
    want_rc 9
    want_out "at least 15 characters"
}

test_rebase_only_skips_gate() {
    new_ppn_case
    write_plan "$(row 1 'exit 7')"
    run_ppn --plan "$PLAN" --rebase-only
    refute_out "pre-fire verification refused"
    want_cnt phpunit 0
}

test_missing_gate_script_refuses() {
    new_ppn_case
    green_plan
    PPN_GATE="$D/no-such-gate" run_ppn --plan "$PLAN"
    want_rc 9
    want_out "pre-fire gate"
}

test_prompt_impl_step_6_9_precedes_step_7() {
    local f="$REPO/bin/automouse/prompt-impl" l69 l68 l7 body
    l69=$(grep -nF -- '## Step 6.9: Pre-Fire Verification Gate' "$f" | head -n 1 | cut -d: -f1)
    if [ -z "$l69" ]; then
        PENDING="Step 6.9 not yet in bin/automouse/prompt-impl"
        return 0
    fi
    l68=$(grep -nF -- '## Step 6.8:' "$f" | head -n 1 | cut -d: -f1)
    l7=$(grep -nF -- '## Step 7: Write Handoff File' "$f" | head -n 1 | cut -d: -f1)
    [ -n "$l68" ] || note "no Step 6.8 heading"
    [ -n "$l7" ] || note "no Step 7 heading"
    [ -n "$l68" ] && [ "$l69" -gt "$l68" ] || note "Step 6.9 is not after Step 6.8"
    [ -n "$l7" ] && [ "$l69" -lt "$l7" ] || note "Step 6.9 is not before Step 7"
    if [ -n "$l7" ] && [ "$l69" -lt "$l7" ]; then
        body=$(sed -n "${l69},$((l7 - 1))p" "$f")
        local s
        for s in "--stage matrix" "--stage phpunit" "--stage infection"; do
            grep -qF -- "$s" <<< "$body" || note "Step 6.9 does not name '$s'"
        done
    fi
}

# ---------------------------------------------------------------------------
# Runner
# ---------------------------------------------------------------------------
ALL_CASES="
test_matrix_row_failure_refuses_and_names_row
test_unrun_row_refuses_without_gate_record
test_matrix_extract_skips_near_miss_rows
test_plan_without_matrix_refuses
test_phpunit_red_refuses
test_db_down_fails_closed_naming_row
test_all_green_passes_and_records
test_cache_hit_skips_rerun
test_tree_change_invalidates_cache
test_checks_mutating_tree_refuse
test_adhoc_no_plan_runs_phpunit_and_infection
test_infection_below_threshold_refuses_3672
test_infection_at_threshold_passes
test_infection_prereq_missing_fails_closed
test_mutation_diff_flags_match_ci
test_post_plan_now_refuses_exit_9_on_gate_failure
test_post_plan_now_fires_when_gate_green
test_post_plan_now_adhoc_no_plan_skips_matrix_only
test_bypass_logs_line_and_fires
test_bypass_refused_under_headless
test_bypass_short_reason_rejected
test_rebase_only_skips_gate
test_missing_gate_script_refuses
test_prompt_impl_step_6_9_precedes_step_7
"

if [ $# -gt 0 ]; then CASES="$*"; else CASES="$ALL_CASES"; fi

FAILED=0
PENDED=0
for name in $CASES; do
    if ! declare -F "$name" >/dev/null; then
        echo "FAIL $name: no such case"
        FAILED=$((FAILED + 1))
        continue
    fi
    WHY=""; PENDING=""
    "$name"
    if [ -n "$PENDING" ]; then
        echo "PENDING $name: $PENDING"
        PENDED=$((PENDED + 1))
    elif [ -z "$WHY" ]; then
        echo "PASS $name"
    else
        echo "FAIL $name: $WHY"
        printf '%s\n' "$OUT" | sed -n '1,15p' | sed 's/^/    | /'
        FAILED=$((FAILED + 1))
    fi
done

[ "$PENDED" -eq 0 ] || echo "NOTE: $PENDED case(s) pending on another change"
[ "$FAILED" -eq 0 ]
