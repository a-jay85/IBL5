#!/bin/bash

# Cross-PR auto-merge triage. Classifies every OPEN PR into exactly one bucket
# (first-match-wins) and prints a report. With --arm it arms
# `gh pr merge --squash --auto` on ONLY the ARMABLE bucket.
#
# ARMABLE is FAIL-CLOSED: it requires a POSITIVE clearance signal (the
# `No manual testing needed` Manual-Testing sentinel that /post-plan writes after
# resolving every manual-testing item), never the mere absence of holds. A PR
# with no `## Manual Testing` section is UNCLEARED -> routed to a human, never
# auto-armed. This is why pr-triage never auto-arms a hand-made visual-change PR.
#
# The four live holds (Manual-Testing / golden / Depends-on / feat:) are shared
# verbatim with /post-plan Phase 6.5 via bin/lib/pr-armable.sh, so the arming
# judgment has one executable home and cannot drift. The live CI-check reading
# (DIRTY / BLOCKED-CHECK) is pr-triage's own — Phase 6.5 delegates it to `--auto`.
#
# Bucket precedence (first match wins):
#   1. DIRTY                  merge conflict (mergeStateStatus == DIRTY)
#   2. NOT-MERGEABLE          GitHub will not merge this head as-is —
#                             mergeStateStatus is BEHIND / DRAFT / UNKNOWN (or an
#                             unrecognised value). BEHIND is the load-bearing one:
#                             master's protection is strict, so a behind PR's green
#                             checks ran on a SHA GitHub will not merge — green but
#                             NOT current, which must never arm
#   3. BLOCKED-CHECK          a required Tests/E2E check is failing/pending/
#                             cancelled/absent, or body declares an expected-red
#   4. HELD                   Manual-Testing real rows, golden touched, or a
#                             belt-and-suspenders body hold marker
#   5. BLOCKED-DEP            an unmerged Depends-on: predecessor
#   6. PIPELINE-HELD          bug-pipeline PR (pipeline-authored label OR a
#                             `bug-<id>` branch name); UNCONDITIONAL — no label
#                             clears it, so it is never armed
#   7. FEAT-AWAITING-SIGNOFF  feat: title without the human-approved label
#   8. UNCLEARED              no Manual-Testing section (fail-closed; never armed)
#   9. ARMABLE                CLEARED + a mergeable merge-state + all required
#                             checks green-and-current
#
# Exit codes: 0 = report generated; 1 = an attempted --arm merge failed;
#             2 = usage error or gh not authenticated.

set -euo pipefail

GH_CMD="${GH_CMD:-gh}"
GH_API_CMD="${GH_API_CMD:-gh api}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/lib/pr-armable.sh
source "$SCRIPT_DIR/lib/pr-armable.sh"

usage() {
    cat <<'EOF'
Usage: bin/pr-triage [--arm] [--help|-h]

Classifies every OPEN PR into one bucket (first-match-wins) and prints a report.

Options:
  --arm        Arm `gh pr merge --squash --auto` on ONLY the ARMABLE bucket.
               Without it, the tool is read-only (report only).
  --help, -h   Show this message.

Environment (test seams):
  GH_CMD        Override the gh command (default: "gh").
  GH_API_CMD    Override the gh api command (default: "gh api").

ARMABLE is fail-closed: a PR is armed only with a positive Manual-Testing
clearance ("No manual testing needed"), all required checks green-and-current,
no merge-state hold (DIRTY/BEHIND/DRAFT/UNKNOWN — BEHIND is what enforces
"current", since master requires branches to be up to date), and no
HELD/dep/feat hold. A PR with no `## Manual Testing` section is
UNCLEARED and routed to a human. Reads one page (200 PRs / 100 check-runs).

Exit codes: 0 = report generated; 1 = an attempted --arm merge failed;
            2 = usage error / gh not authenticated.
EOF
}

ARM=0
for arg in "$@"; do
    case "$arg" in
        --arm)
            ARM=1
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --*)
            echo "unknown flag: $arg" >&2
            usage >&2
            exit 2
            ;;
        *)
            echo "unexpected argument: $arg" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if ! gh auth status >/dev/null 2>&1; then
    echo "ERROR: GitHub CLI is not authenticated." >&2
    echo "Run 'gh auth login' to authenticate, then retry." >&2
    exit 2
fi

REMOTE_URL="$(git remote get-url origin 2>/dev/null)" || {
    echo "ERROR: cannot read origin remote URL" >&2
    exit 2
}
SLUG="$(echo "$REMOTE_URL" | sed -E 's#^(https://github\.com/|ssh://git@github\.com/|git@github\.com:)##; s#\.git$##')"
if [ -z "$SLUG" ]; then
    echo "ERROR: cannot parse repo slug from origin URL: $REMOTE_URL" >&2
    exit 2
fi

# --- required contexts (decision 5): protection API, else hardcoded fallback ---
PROT="$($GH_API_CMD "repos/$SLUG/branches/master/protection" 2>/dev/null || echo '{}')"
REQUIRED=()
while IFS= read -r ctx; do
    [ -n "$ctx" ] && REQUIRED+=("$ctx")
done < <(echo "$PROT" | jq -r '.required_status_checks.contexts[]?' 2>/dev/null)
if [ "${#REQUIRED[@]}" -eq 0 ]; then
    # Fallback: token lacks admin/repo scope for the protection API.
    REQUIRED=("Tests and Analysis" "E2E Tests" "human-signoff")
fi

# BLOCKED-CHECK evaluates only the non-signoff contexts (decision 1):
# human-signoff is the feat: floor's lever, handled by bucket FEAT, not here.
is_blocked_check_ctx() {
    case "$1" in
        "human-signoff") return 1 ;;
        *) return 0 ;;
    esac
}

# state_of <latest_json> <ctx> -> green|failing|pending|cancelled|absent
state_of() {
    echo "$1" | jq -r --arg n "$2" '
        map(select(.name == $n)) as $m
        | if ($m | length) == 0 then "absent"
          elif ($m[0].status != "completed") then "pending"
          elif ($m[0].conclusion == "cancelled") then "cancelled"
          elif ($m[0].conclusion | IN("success","skipped","neutral")) then "green"
          else "failing" end'
}

# rerun_id <latest_json> <ctx> -> the workflow-run id from .details_url, or empty
# `|| true`: grep exits 1 when details_url lacks a runs/<id> segment; without it
# the captured substitution would abort under `set -o pipefail`.
rerun_id() {
    echo "$1" | jq -r --arg n "$2" 'map(select(.name == $n)) | .[0].details_url // ""' \
        | grep -oE 'runs/[0-9]+' | grep -oE '[0-9]+' | head -1 || true
}

EXPECTED_RED_RE='expected[ -]?red|will be RED|Expected CI check.*RED'
HELD_BODY_RE='auto_merge:[[:space:]]*false|auto_postplan:[[:space:]]*false|human reviewer|human authz|requires human review|do NOT auto-merge|DNM'

PRS_JSON="$("$GH_CMD" pr list --state open --limit 200 \
    --json number,title,body,labels,mergeStateStatus,headRefOid,headRefName,files 2>/dev/null || echo '[]')"

PR_COUNT="$(echo "$PRS_JSON" | jq 'length')"

printf '%-7s  %-22s  %-26s  %s\n' "PR#" "BUCKET" "NEXT-ACTION" "SIGNALS"
printf '%-7s  %-22s  %-26s  %s\n' "-------" "----------------------" "--------------------------" "-------"

# mss_blocks_merge <mergeStateStatus>  -> 0 (true) when GitHub will NOT merge this
# head as-is, whatever the check-runs say.
#
# Written as an ALLOWLIST by inversion. GitHub's MergeStateStatus enum is closed
# (BEHIND BLOCKED CLEAN DIRTY DRAFT HAS_HOOKS UNKNOWN UNSTABLE), so naming the four
# that CAN legitimately arm and blocking everything else means an unrecognised or
# empty value fails CLOSED instead of falling through to ARMABLE. The previous
# `mss != "DIRTY"` denylist did the opposite: BEHIND, DRAFT and UNKNOWN all armed.
#
#   BLOCKED   — the normal "waiting on a required check/review" state; arming
#               auto-merge on it is the entire point of this script, so it must
#               stay armable (measured 2026-08-22: 28 of 30 open PRs were BLOCKED,
#               so an allowlist of CLEAN alone would arm nothing, ever).
#   UNSTABLE  — only NON-required checks are red; the required set is asserted
#               separately by $armable_checks_green.
#   HAS_HOOKS — clean, with repo pre-receive hooks.
mss_blocks_merge() {
    case "$1" in
        CLEAN|BLOCKED|HAS_HOOKS|UNSTABLE) return 1 ;;
        *) return 0 ;;
    esac
}

# mss_action <mergeStateStatus> -> the NEXT-ACTION text for a NOT-MERGEABLE row.
mss_action() {
    case "$1" in
        BEHIND)  echo "update branch onto master" ;;
        DRAFT)   echo "mark ready for review" ;;
        UNKNOWN) echo "re-check (state unknown)" ;;
        *)       echo "re-check merge state" ;;
    esac
}

EXIT=0
RERUN_HINTS=""
ROWS=0
SWEEPING=0

# The truncation guard. A predicate or gh call that returns nonzero inside the
# sweep aborts the whole script under `set -euo pipefail` — mid-loop, so a check
# placed AFTER the loop would never run. Only an EXIT trap sees that abort. Without
# it the failure is invisible: exit 1, empty stderr, and a partial table that reads
# as a complete report (that is exactly how a merged Depends-on: predecessor hid 25
# of 30 open PRs until 2026-08-22). Fails LOUD rather than silently under-reporting.
triage_exit_guard() {
    local rc=$?
    if [ "$SWEEPING" = "1" ]; then
        echo "ERROR: pr-triage ABORTED after $ROWS of $PR_COUNT open PRs (exit $rc)." >&2
        echo "       Last PR attempted: #${num:-?}. A predicate or gh call returned" >&2
        echo "       nonzero under set -euo pipefail. The table above is INCOMPLETE." >&2
        [ "$rc" -eq 0 ] && rc=2
    fi
    exit "$rc"
}
trap triage_exit_guard EXIT
SWEEPING=1

i=0
while [ "$i" -lt "$PR_COUNT" ]; do
    PR="$(echo "$PRS_JSON" | jq ".[$i]")"
    i=$((i + 1))

    num="$(echo "$PR" | jq -r '.number')"
    title="$(echo "$PR" | jq -r '.title')"
    body="$(echo "$PR" | jq -r '.body // ""')"
    mss="$(echo "$PR" | jq -r '.mergeStateStatus // ""')"
    sha="$(echo "$PR" | jq -r '.headRefOid')"
    labels="$(echo "$PR" | jq -c '.labels // []')"
    files="$(echo "$PR" | jq -c '.files // []')"
    head_ref="$(echo "$PR" | jq -r '.headRefName // ""')"

    # --- live check-runs for this PR's head SHA (dedupe: latest run per name) ---
    CR_JSON="$($GH_API_CMD "repos/$SLUG/commits/$sha/check-runs?per_page=100" 2>/dev/null \
        || echo '{"check_runs":[]}')"
    LATEST="$(echo "$CR_JSON" | jq '[.check_runs | group_by(.name) | .[]
        | sort_by(.completed_at // .started_at) | last]')"

    # --- compute signals ---
    clearance="$(pr_manual_testing_clearance "$body")"
    golden="$(pr_golden_hold "$files")"
    feat="$(pr_feat_hold "$title" "$labels")"
    # `| tr` like deps/unresolved below: both axes can fire, and the predicate
    # emits one reason per LINE — an untranslated newline splits the report row.
    pipeline="$(pr_pipeline_authored_hold "$labels" "$head_ref" | tr '\n' ' ')"
    deps="$(pr_dep_holds "$body" | tr '\n' ' ')"
    unresolved="$(pr_unresolved_findings_hold "$num" | tr '\n' ' ')"

    check_signals=""
    blocked_check=0
    cancelled_ctx=""
    armable_checks_green=1
    for ctx in "${REQUIRED[@]}"; do
        st="$(state_of "$LATEST" "$ctx")"
        check_signals="${check_signals}${ctx}=${st}; "
        [ "$st" != "green" ] && armable_checks_green=0
        if is_blocked_check_ctx "$ctx" && [ "$st" != "green" ]; then
            blocked_check=1
            [ "$st" = "cancelled" ] && cancelled_ctx="$ctx"
        fi
    done
    expected_red=0
    if echo "$body" | grep -qiE "$EXPECTED_RED_RE"; then
        expected_red=1
        blocked_check=1
    fi

    held_body=0
    if echo "$body" | grep -qiE "$HELD_BODY_RE"; then
        held_body=1
    fi

    # --- bucket (first match wins) ---
    bucket=""
    action=""
    if [ "$mss" = "DIRTY" ]; then
        bucket="DIRTY"; action="rebase onto master"
    elif mss_blocks_merge "$mss"; then
        # Ranked here, beside DIRTY, because it is the same fact: GitHub will not
        # merge this head. The SIGNALS column still prints every required check's
        # state, so nothing a lower bucket would have said is lost.
        bucket="NOT-MERGEABLE"; action="$(mss_action "$mss")"
    elif [ "$blocked_check" = "1" ]; then
        bucket="BLOCKED-CHECK"; action="fix / re-run CI"
        if [ -n "$cancelled_ctx" ]; then
            rid="$(rerun_id "$LATEST" "$cancelled_ctx")"
            [ -n "$rid" ] && RERUN_HINTS="${RERUN_HINTS}hint: gh run rerun ${rid}  # ${cancelled_ctx} was CANCELLED on PR #${num}"$'\n'
        fi
    elif [ "$clearance" = "HELD" ] || [ -n "$golden" ] || [ "$held_body" = "1" ] || [ -n "$unresolved" ]; then
        bucket="HELD"; action="human review"
    elif [ -n "$deps" ]; then
        bucket="BLOCKED-DEP"; action="wait for predecessor"
    elif [ -n "$pipeline" ]; then
        # Distinct from the feat: bucket on purpose. The pipeline floor is
        # UNCONDITIONAL — no `human-approved` label clears it — so reusing
        # FEAT-AWAITING-SIGNOFF's "human sign-off + label" action would send an
        # operator down a dead end (label the PR, nothing arms).
        bucket="PIPELINE-HELD"; action="human merge (never arms)"
    elif [ -n "$feat" ]; then
        bucket="FEAT-AWAITING-SIGNOFF"; action="human sign-off + label"
    elif [ "$clearance" = "UNKNOWN" ]; then
        bucket="UNCLEARED"; action="human review (no clearance)"
    elif [ "$clearance" = "CLEARED" ] && ! mss_blocks_merge "$mss" && [ "$armable_checks_green" = "1" ]; then
        bucket="ARMABLE"; action="arm auto-merge"
    else
        # Defensive: cleared but a check is not green yet (race) -> not armable.
        bucket="UNCLEARED"; action="human review (checks not green)"
    fi

    signals="clearance=${clearance}; ${check_signals}held_body=$([ "$held_body" = 1 ] && echo yes || echo no); golden=$([ -n "$golden" ] && echo yes || echo no); deps=$([ -n "$deps" ] && echo "${deps% }" || echo none); feat=$([ -n "$feat" ] && echo yes || echo no); pipeline=$([ -n "$pipeline" ] && echo "${pipeline% }" || echo none); expected_red=$([ "$expected_red" = 1 ] && echo yes || echo no); unresolved=$([ -n "$unresolved" ] && echo "${unresolved% }" || echo none)"

    printf '%-7s  %-22s  %-26s  %s\n' "#$num" "$bucket" "$action" "mss=${mss:-?}; $signals"
    ROWS=$((ROWS + 1))

    # --- --arm side-effect: ONLY the ARMABLE bucket ---
    # No --delete-branch, deliberately: the repo already sets deleteBranchOnMerge,
    # so GitHub deletes the head branch itself. Carrying the flag only added harm —
    # the local delete fails in a multi-worktree clone (gh can exit non-zero and
    # this loop would report a false ARM FAILED on a PR that armed fine), and a parent
    # merge carrying it permanently closes stacked child PRs. Same rationale as
    # tools/postplan-harness/harness/adapters/ghad.py LiveGh.
    if [ "$ARM" = "1" ] && [ "$bucket" = "ARMABLE" ]; then
        if "$GH_CMD" pr merge "$num" --squash --auto >/dev/null 2>&1; then
            echo "  armed auto-merge on #$num"
        else
            echo "  ARM FAILED on #$num (gh pr merge exited non-zero)" >&2
            EXIT=1
        fi
    fi
done
SWEEPING=0

if [ "$ROWS" -ne "$PR_COUNT" ]; then
    echo "ERROR: reported $ROWS of $PR_COUNT open PRs without aborting." >&2
    EXIT=2
fi

if [ -n "$RERUN_HINTS" ]; then
    echo
    printf '%s' "$RERUN_HINTS"
fi

exit "$EXIT"
