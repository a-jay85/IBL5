#!/bin/bash
# Print the next available migration number.
# Thin wrapper over bin/next-number migration (grammar in bin/lib/numbering.sh).

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
Usage: bin/next-migration

Print the next available migration number (zero-padded 3-digit integer).
Scans the main checkout, canonical root, all origin refs, and sibling
worktrees to avoid collisions.

Must be run from a worktree, not the main checkout.

Arguments: none
Exit codes: 0 = number printed, 1 = no migrations found or run from main checkout
EOF
    exit 0
fi

exec "$(dirname "$0")/next-number" migration
