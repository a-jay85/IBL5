: > "$RW/repo/seed"; git -C "$RW/repo" add -A >/dev/null 2>&1; git -C "$RW/repo" commit -qm seed >/dev/null 2>&1
RW_TOP="$(cd "$RW/repo" && git rev-parse --show-toplevel)"
