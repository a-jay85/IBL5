#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/install-git-hooks — install the pre-commit gate, the pre-push ADR
# decision-trigger gate, and the CSS auto-heal trigger into the COMMON git hooks dir.
#
# Copies thin shims into the COMMON git hooks dir (git rev-parse
# --git-common-dir), so a single install covers every worktree (worktrees share
# the common .git). The pre-commit shim exec's bin/pre-commit-hook (the gate
# body, version-controlled) and fails closed if that file is absent. The pre-push
# shim chains git-lfs (preserving LFS pushes) then exec's bin/pre-push-adr-hook,
# where the gate logic lives version-controlled. The post-merge shim likewise
# chains git-lfs then exec's bin/post-merge-hook (migrate, warm-cache, cleanup).
#
# It also injects a version-controlled CSS auto-heal call into post-checkout,
# post-merge, and post-rewrite. These git ops bulk-rewrite the working tree in a
# way the @tailwindcss/cli --watch container does not reliably observe, leaving
# the compiled stylesheet stale (see bin/rebuild-css-if-source-changed).
#
# We deliberately do NOT use core.hooksPath: it is all-or-nothing across the
# shared common git dir and would orphan the existing untracked hooks (the git-lfs
# pre-push, post-merge wt-cleanup, post-checkout). Copying/injecting shims is
# surgical.
#
# Idempotent: re-running detects our sentinel markers and rewrites/skips in
# place; a pre-existing NON-shim pre-push (the default git-lfs one) is backed up
# once to pre-push.pre-adr.bak before we overwrite it; a pre-existing non-shim
# pre-commit is backed up once to pre-commit.pre-shim.bak. The CSS injection is a
# no-op when its sentinel is already present, and preserves any existing hook
# body (it inserts our call right after the shebang so it runs before a hook's
# branch-gated early-exit).

set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
Usage: bin/install-git-hooks

Install the pre-commit gate, pre-push ADR decision-trigger gate, and CSS
auto-heal trigger into the COMMON git hooks directory. Copies thin shims
into $(git rev-parse --git-common-dir)/hooks so a single install covers
every worktree.

No arguments accepted. Idempotent: safe to re-run; existing shims are
rewritten in place and a pre-existing non-shim hook is backed up once.

Installed hooks:
  pre-commit    Shim that exec's bin/pre-commit-hook (version-controlled).
  pre-push      Chains git-lfs then exec's bin/pre-push-adr-hook.
  post-merge    Chains git-lfs then exec's bin/post-merge-hook.
  post-checkout, post-merge, post-rewrite  CSS auto-heal trigger.
EOF
    exit 0
fi

PRECOMMIT_SENTINEL='# IBL5-PRECOMMIT-HOOK'

HOOKS_DIR="$(git rev-parse --git-common-dir)/hooks"
mkdir -p "$HOOKS_DIR"
PRECOMMIT_SHIM="$HOOKS_DIR/pre-commit"

# Back up a pre-existing non-shim pre-commit exactly once (preserves whatever a
# developer already had). Re-running over our own shim makes no backup.
if [ -e "$PRECOMMIT_SHIM" ] && ! grep -qF "$PRECOMMIT_SENTINEL" "$PRECOMMIT_SHIM"; then
    BACKUP="$HOOKS_DIR/pre-commit.pre-shim.bak"
    if [ ! -e "$BACKUP" ]; then
        cp "$PRECOMMIT_SHIM" "$BACKUP"
        echo "Backed up existing pre-commit hook to $BACKUP"
    fi
fi

cat > "$PRECOMMIT_SHIM" <<'EOF'
#!/bin/sh
# IBL5-PRECOMMIT-HOOK (installed by bin/install-git-hooks)
# The gate body lives version-controlled at bin/pre-commit-hook.
REPO_ROOT="$(git rev-parse --show-toplevel)"
if [ ! -x "$REPO_ROOT/bin/pre-commit-hook" ]; then
    echo "pre-commit: $REPO_ROOT/bin/pre-commit-hook is missing or not executable." >&2
    echo "This shim fails closed rather than silently skipping the doc/gofmt/byte-budget gates." >&2
    echo "Run bin/install-git-hooks from a checkout that has it, or use --no-verify deliberately." >&2
    exit 1
fi
exec "$REPO_ROOT/bin/pre-commit-hook" "$@"
EOF
chmod 0755 "$PRECOMMIT_SHIM"

echo "Installed pre-commit hook shim: $PRECOMMIT_SHIM"

SENTINEL='# IBL5-ADR-HOOK'

SHIM="$HOOKS_DIR/pre-push"

# Back up a pre-existing non-shim pre-push exactly once (preserves the default
# git-lfs hook). Re-running over our own shim makes no backup.
if [ -e "$SHIM" ] && ! grep -qF "$SENTINEL" "$SHIM"; then
    BACKUP="$HOOKS_DIR/pre-push.pre-adr.bak"
    if [ ! -e "$BACKUP" ]; then
        cp "$SHIM" "$BACKUP"
        echo "Backed up existing pre-push hook to $BACKUP"
    fi
fi

cat > "$SHIM" <<'EOF'
#!/bin/sh
# IBL5-ADR-HOOK (installed by bin/install-git-hooks)
# Chain git-lfs (preserves LFS pushes), then the ADR decision-trigger gate.
if command -v git-lfs >/dev/null 2>&1; then git lfs pre-push "$@" || exit $?; fi
REPO_ROOT="$(git rev-parse --show-toplevel)"
exec "$REPO_ROOT/bin/pre-push-adr-hook" "$@"
EOF
chmod 0755 "$SHIM"

echo "Installed pre-push ADR hook: $SHIM"

# --- post-merge: shim that exec's bin/post-merge-hook ------------------------
# The body (cleanup, prod-seed refresh, migrate, warm-cache, IBL6 rebuild)
# lives version-controlled at bin/post-merge-hook. The shim also carries the
# git-lfs smudge and the CSS auto-heal sentinel, so inject_css_heal below
# leaves it alone. A pre-existing non-shim post-merge is backed up once.
POSTMERGE_SENTINEL='# IBL5-POSTMERGE-HOOK'
POSTMERGE_SHIM="$HOOKS_DIR/post-merge"

if [ -e "$POSTMERGE_SHIM" ] && ! grep -qF "$POSTMERGE_SENTINEL" "$POSTMERGE_SHIM"; then
    BACKUP="$HOOKS_DIR/post-merge.pre-shim.bak"
    if [ ! -e "$BACKUP" ]; then
        cp "$POSTMERGE_SHIM" "$BACKUP"
        echo "Backed up existing post-merge hook to $BACKUP"
    fi
fi

cat > "$POSTMERGE_SHIM" <<'EOF'
#!/bin/sh
# IBL5-POSTMERGE-HOOK (installed by bin/install-git-hooks)
# IBL5-CSS-REBUILD (installed by bin/install-git-hooks)
"$(git rev-parse --show-toplevel 2>/dev/null)/bin/rebuild-css-if-source-changed" >/dev/null 2>&1 || true
# Git LFS smudge runs on every merge, all branches, before the body's
# master-only early exit.
if command -v git-lfs >/dev/null 2>&1; then git lfs post-merge "$@"; fi
REPO_ROOT="$(git rev-parse --show-toplevel)"
[ -x "$REPO_ROOT/bin/post-merge-hook" ] || exit 0
exec "$REPO_ROOT/bin/post-merge-hook" "$@"
EOF
chmod 0755 "$POSTMERGE_SHIM"

echo "Installed post-merge hook shim: $POSTMERGE_SHIM"

# --- CSS auto-heal: inject into post-checkout / post-merge / post-rewrite ------
# These git ops bulk-rewrite the working tree; the --watch container misses that,
# so the compiled stylesheet goes stale. Our call is placed right after the
# shebang so it runs BEFORE any branch-gated early-exit already in the hook
# (post-merge exits early on non-master, but worktrees live on feature branches).
CSS_SENTINEL='# IBL5-CSS-REBUILD'
CSS_BLOCK="$CSS_SENTINEL (installed by bin/install-git-hooks)
\"\$(git rev-parse --show-toplevel 2>/dev/null)/bin/rebuild-css-if-source-changed\" >/dev/null 2>&1 || true"

inject_css_heal() {
    local hook="$HOOKS_DIR/$1"
    if [ ! -e "$hook" ]; then
        printf '#!/bin/sh\n%s\n' "$CSS_BLOCK" > "$hook"
        chmod 0755 "$hook"
        echo "Created $1 with CSS auto-heal: $hook"
        return
    fi
    if grep -qF "$CSS_SENTINEL" "$hook"; then
        return  # already injected
    fi
    # Insert our block after the first line (the shebang), preserving the rest.
    local tmp="$hook.tmp.$$"
    { head -n 1 "$hook"; printf '%s\n' "$CSS_BLOCK"; tail -n +2 "$hook"; } > "$tmp"
    chmod 0755 "$tmp"
    mv "$tmp" "$hook"
    echo "Injected CSS auto-heal into $1: $hook"
}

inject_css_heal post-checkout
inject_css_heal post-merge
inject_css_heal post-rewrite
