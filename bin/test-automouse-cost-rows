#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-automouse-cost-rows — regression test for automouse-run's cost roll-up.
#
# The bug this pins (shipped 2026-07-09 in b42dfb6b2 / #1381, live 6 days):
# append_cost_row appended the row at EOF — BELOW the "## Weekly aggregate"
# section — and then called regenerate_weekly_section, whose strip deletes from
# that header to EOF. Every row but the day's first was written and immediately
# deleted, leaving one blank line each. Nine phases ran 2026-07-15; the report
# kept ONE row and nine blank lines, and the weekly total read $9.75 for a ~$120
# week.
#
# The load-bearing assertion is CONTIGUITY, not presence: a blank line between
# two rows splits the markdown table in half, so "all 3 rows are in the file" can
# pass while the rendered table is still broken.
#
# Run: bin/test-automouse-cost-rows  (exit 0 = all pass, 1 = a case failed)

set -u

REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
FAILED=0

# assert_eq <actual> <expected> <label>
assert_eq() {
    if [ "$1" = "$2" ]; then
        printf '  ok   %s (%s)\n' "$3" "$1"
    else
        printf '  FAIL %s: got %s, expected %s\n' "$3" "$1" "$2"
        FAILED=1
    fi
}

# assert_near <actual> <expected> <tol> <label>
assert_near() {
    if awk -v a="$1" -v e="$2" -v t="$3" 'BEGIN{d=a-e; if(d<0)d=-d; exit !(d<=t)}'; then
        printf '  ok   %s (%s)\n' "$4" "$1"
    else
        printf '  FAIL %s: got %s, expected %s +/- %s\n' "$4" "$1" "$2" "$3"
        FAILED=1
    fi
}

# assert_gt <actual> <threshold> <label> [why]
assert_gt() {
    if awk -v a="$1" -v t="$2" 'BEGIN{exit !(a>t)}'; then
        printf '  ok   %s (%s > %s)\n' "$3" "$1" "$2"
    else
        printf '  FAIL %s: got %s, expected > %s%s\n' "$3" "$1" "$2" "${4:+ -- $4}"
        FAILED=1
    fi
}

# assert_ne <actual> <forbidden> <label>
assert_ne() {
    if [ "$1" != "$2" ]; then
        printf '  ok   %s (%s != %s)\n' "$3" "$1" "$2"
    else
        printf '  FAIL %s: got %s, which must NOT equal %s\n' "$3" "$1" "$2"
        FAILED=1
    fi
}

# pj <json-file-or-"-"> <key> — pull one scalar out of a pricer JSON object.
pj() {
    python3 -c 'import json,sys; print(json.load(open(sys.argv[1]) if sys.argv[1]!="-" else sys.stdin)[sys.argv[2]])' "$1" "$2"
}

# Sandbox NIGHTLY_DIR so the real roll-up is never touched.
TMPROOT=$(mktemp -d)
trap 'rm -rf "$TMPROOT"' EXIT
mkdir -p "$TMPROOT/reports" "$TMPROOT/logs"

# shellcheck disable=SC2034  # read by the append_cost_row/regenerate_* funcs sourced below
NIGHTLY_DIR="$TMPROOT"
LOG="$TMPROOT/logs/$(date +%F).log"
: > "$LOG"

# Source only the functions under test — automouse-run is a long-running
# driver, so extract rather than execute it.
eval "$(awk '/^model_tier\(\)/,/^}/'             "$REPO_ROOT/bin/automouse/run")"
eval "$(awk '/^_date_ago\(\)/,/^}/'              "$REPO_ROOT/bin/automouse/run")"
eval "$(awk '/^append_cost_row\(\)/,/^}/'        "$REPO_ROOT/bin/automouse/run")"
eval "$(awk '/^strip_weekly_section\(\)/,/^}/'   "$REPO_ROOT/bin/automouse/run")"
eval "$(awk '/^regenerate_weekly_section\(\)/,/^}/' "$REPO_ROOT/bin/automouse/run")"

REPORT="$TMPROOT/reports/$(date +%F)-costs.md"

# Three phases, each with its own exit: line — mirrors a real multi-plan night.
for n in 1 2 3; do
    before=$(wc -l < "$LOG")
    printf '[00:0%d:00] plan-%d/impl exit: cost=$%d.5000 peak_ctx=%d000\n' "$n" "$n" "$n" "$((100 + n))" >> "$LOG"
    append_cost_row "plan-$n.md" "impl" "$before" "claude-sonnet-4-6"
done

# 1. Every row survives.
rows=$(grep -c '^| plan-' "$REPORT")
assert_eq "$rows" 3 "all 3 rows survive"

# 2. THE regression: rows are contiguous — no blank line splits the table.
gap=$(awk '/^\| plan-/ {if (last && NR-last > 1) bad=1; last=NR} END {print bad+0}' "$REPORT")
assert_eq "$gap" 0 "rows are contiguous (no table-splitting blanks)"

# 3. The weekly section stays single and last.
weeklies=$(grep -c '^## Weekly aggregate' "$REPORT")
assert_eq "$weeklies" 1 "exactly 1 weekly section (idempotent regen)"

# 4. The aggregate totals every row, not just the first ($1.50+$2.50+$3.50).
total=$(awk -F'|' '/\*\*Total\*\*/ {gsub(/[ \t]/,"",$3); print $3; exit}' "$REPORT")
assert_eq "$total" "7.5000" "weekly total sums all rows"

# 5. Peak-ctx column is populated (guards the 5-col header regression).
peaks=$(grep -c '| 10[123]K |' "$REPORT")
assert_eq "$peaks" 3 "peak-ctx column carries all 3 peaks"

# ---------------------------------------------------------------------------
# Fixture suite — bin/lib/automouse-pricer and bin/automouse/backfill-costs.
#
# The harness `result` event undercounts: it sums only the top-level `usage` of
# the MAIN transcript, missing every `usage.iterations[]` entry and every
# subagent transcript. For the 2026-08-18 db-query-worktree-routing run it
# reported $1.82 (impl) / $2.82 (postplan); recomputation gives $12.8633 /
# $4.0134. The `cost > 5.0` / `cost > 3.0` assertions below exist so a
# regression back to the harness figures fails LOUDLY rather than looking
# plausible.
# ---------------------------------------------------------------------------

PRICER="$REPO_ROOT/bin/lib/automouse-pricer"
BACKFILL="$REPO_ROOT/bin/automouse/backfill-costs"
FIXROOT="$REPO_ROOT/bin/fixtures/automouse-cost"
FIXPROJ="$FIXROOT/proj"
IMPL_SID="bea65310-ff05-4604-aa22-d124759ac2e9"
POST_SID="c0bf7a82-5244-4f64-bfe3-543e25dc8b3d"
NCOL_EXPECTED=13

printf '\n-- pricer: golden fixture --\n'

"$PRICER" --session-id "$IMPL_SID" --proj-dir "$FIXPROJ" > "$TMPROOT/impl.json"
"$PRICER" --session-id "$POST_SID" --proj-dir "$FIXPROJ" > "$TMPROOT/post.json"

impl_cost=$(pj "$TMPROOT/impl.json" cost)
post_cost=$(pj "$TMPROOT/post.json" cost)

# 6/7. The golden figures, to the cent.
assert_near "$impl_cost" 12.8633 0.01 "impl prices to \$12.8633"
assert_near "$post_cost" 4.0134  0.01 "postplan prices to \$4.0134"

# 8/9. Floor guards — these fail if the pricer regresses to the harness figures
#      \$1.82392625 / \$2.81965335 (top-level main-transcript usage only).
assert_gt "$impl_cost" 5.0 "impl is not the harness under-count" \
    "harness reports \$1.82392625 — iterations and/or subagents were dropped"
assert_gt "$post_cost" 3.0 "postplan is not the harness under-count" \
    "harness reports \$2.81965335 — iterations and/or subagents were dropped"

# 10. peak_ctx is carried through.
assert_eq "$(pj "$TMPROOT/impl.json" peak_ctx)" 208262 "impl peak_ctx"

printf '\n-- pricer: iterations REPLACE, not ADD (Error-A guard) --\n'

# Two records. Record B's real spend lives entirely in usage.iterations[], on a
# DIFFERENT model than the top-level, so the three candidate answers are far
# apart and cannot be confused for rounding:
#   A            = opus  1000 in / 1000 out   -> $0.0300
#   B top-level  = opus  100000 in            -> $0.5000
#   B iteration  = haiku 2000 in / 500 out    -> $0.0045
# replace (correct) = 0.0345   top-level-only = 0.5300   sum = 0.5345
ITDIR="$TMPROOT/itproj/proj"
mkdir -p "$ITDIR"
cat > "$ITDIR/iter-session.jsonl" <<'JSONL'
{"type":"assistant","timestamp":"2026-08-18T00:00:01.000Z","message":{"id":"msg_a","model":"claude-opus-5","usage":{"input_tokens":1000,"output_tokens":1000,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}
{"type":"assistant","timestamp":"2026-08-18T00:00:02.000Z","message":{"id":"msg_b","model":"claude-opus-5","usage":{"input_tokens":100000,"output_tokens":0,"cache_read_input_tokens":0,"cache_creation_input_tokens":0,"iterations":[{"model":"claude-haiku-4-5-20251001","input_tokens":2000,"output_tokens":500,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}]}}}
JSONL

"$PRICER" --session-id iter-session --proj-dir "$ITDIR" > "$TMPROOT/iter.json"
iter_cost=$(pj "$TMPROOT/iter.json" cost)

# 11. Iterations are priced at all (not silently dropped).
assert_near "$iter_cost" 0.0345 0.0001 "iterations are priced (replace semantics)"
# 12. Not the top-level-only reading — that IS the Error-A regression.
assert_ne "$iter_cost" 0.53 "iterations are not ignored in favour of top-level usage"
# 13. And NOT the sum. If a future edit makes iteration handling additive, every
#     multi-iteration record silently double-counts; this catches it.
assert_ne "$iter_cost" 0.5345 "iterations REPLACE the top-level usage (not added to it)"

# 14/15. peak_ctx is a MAX over {top-level} U {each iteration}, never a sum:
#        max(1000, 100000, 2000) = 100000; the sum would be 103000.
iter_peak=$(pj "$TMPROOT/iter.json" peak_ctx)
assert_eq "$iter_peak" 100000 "peak_ctx is the max over usage parts"
assert_ne "$iter_peak" 103000 "peak_ctx is not the sum of usage parts"

printf '\n-- pricer: subagent transcripts are included (Error-B guard) --\n'

# 16. Dropping subagents/ must cost the impl session exactly its subagent spend.
mkdir -p "$TMPROOT/nosub"
NOSUB="$TMPROOT/nosub/proj"
cp -R "$FIXPROJ" "$NOSUB"
rm -rf "${NOSUB:?}/$IMPL_SID/subagents"
nosub_cost=$("$PRICER" --session-id "$IMPL_SID" --proj-dir "$NOSUB" | pj - cost)
delta=$(awk -v a="$impl_cost" -v b="$nosub_cost" 'BEGIN{printf "%.4f", a-b}')
assert_near "$delta" 2.1594 0.01 "subagent transcripts contribute \$2.1594"

printf '\n-- pricer: dedup is by message.id --\n'

# 17. A verbatim duplicate record must not be counted twice.
DUPDIR="$TMPROOT/dupproj/proj"
mkdir -p "$DUPDIR"
cp "$ITDIR/iter-session.jsonl" "$DUPDIR/dup-session.jsonl"
head -1 "$ITDIR/iter-session.jsonl" >> "$DUPDIR/dup-session.jsonl"
dup_cost=$("$PRICER" --session-id dup-session --proj-dir "$DUPDIR" | pj - cost)
assert_eq "$dup_cost" "$iter_cost" "duplicate message.id is not double-counted"

printf '\n-- pricer: missing session degrades, it does not abort --\n'

# 18/19. An unknown session id is a clean exit 3 plus a machine-readable error,
#        so append_cost_row can fall back to the logged figure with Prov=unknown.
miss_out=$("$PRICER" --session-id deadbeef --proj-dir "$FIXPROJ" 2>/dev/null) && miss_rc=0 || miss_rc=$?
assert_eq "$miss_rc" 3 "missing session exits 3"
assert_eq "$(printf '%s' "$miss_out" | grep -c 'session-not-found')" 1 \
    "missing session reports session-not-found"

printf '\n-- pricer: price staleness is loud --\n'

# 20/21. Past price_expiry the pricer must WARN on stderr and flag price_stale,
#        so a silently-wrong price table cannot survive a release cycle.
stale_err=$(AUTOMOUSE_PRICER_TODAY=2026-09-01 "$PRICER" --session-id "$POST_SID" \
    --proj-dir "$FIXPROJ" 2>&1 >"$TMPROOT/stale.json")
assert_eq "$(printf '%s' "$stale_err" | grep -c '^WARN:')" 1 "stale price table warns on stderr"
assert_eq "$(pj "$TMPROOT/stale.json" price_stale)" "True" "stale price table sets price_stale"

printf '\n-- backfill: dry-run writes nothing; .bak is written once --\n'

BF="$TMPROOT/bf"
cp -R "$FIXROOT/nightly" "$BF"
BF_REPORT="$BF/reports/2026-08-18-costs.md"
BF_BAK="$BF_REPORT.bak"
BF_SIDECAR="$BF/logs/2026-08-18.costs.jsonl"

NIGHTLY_DIR="$BF" "$BACKFILL" --dry-run --proj-dir "$FIXROOT" > "$TMPROOT/bf-dry.out"

# 22. The join must be unambiguous, or the rewritten costs are guesses.
assert_eq "$(grep -c '^join: 2 matched, 0 ambiguous, 0 missed$' "$TMPROOT/bf-dry.out")" 1 \
    "backfill joins both fixture phases unambiguously"
# 23. --dry-run means NO writes at all, including no .bak.
assert_eq "$([ -e "$BF_BAK" ] && echo yes || echo no)" "no" "--dry-run creates no .bak"

NIGHTLY_DIR="$BF" "$BACKFILL" --proj-dir "$FIXROOT" > "$TMPROOT/bf-run1.out"

# 24-27. The real run backs up, rewrites to the 13-column schema, drops a sidecar.
assert_eq "$([ -e "$BF_BAK" ] && echo yes || echo no)" "yes" "real run writes a .bak"
assert_eq "$([ -e "$BF_SIDECAR" ] && echo yes || echo no)" "yes" "real run writes the sidecar ledger"
assert_eq "$(awk -F'|' '/^\| db-query-worktree-routing\.md \| impl /{print NF-2; exit}' "$BF_REPORT")" \
    "$NCOL_EXPECTED" "rewritten row has $NCOL_EXPECTED columns"
assert_eq "$(grep -c '| 12.8633 |' "$BF_REPORT")" 1 "rewritten impl row carries the recomputed cost"

cp "$BF_REPORT" "$TMPROOT/bf-report.snap"
cp "$BF_BAK" "$TMPROOT/bf-bak.snap"
NIGHTLY_DIR="$BF" "$BACKFILL" --proj-dir "$FIXROOT" > "$TMPROOT/bf-run2.out"

# 28-30. Idempotent: a second real run changes nothing and must NOT clobber the
#        .bak, which is the only surviving copy of the pre-backfill state.
assert_eq "$(grep -c '^no changes$' "$TMPROOT/bf-run2.out")" 1 "second backfill run reports no changes"
assert_eq "$(cmp -s "$BF_REPORT" "$TMPROOT/bf-report.snap" && echo same || echo differs)" "same" \
    "second backfill run leaves the report byte-identical"
assert_eq "$(cmp -s "$BF_BAK" "$TMPROOT/bf-bak.snap" && echo same || echo differs)" "same" \
    "second backfill run does not overwrite the .bak"

printf '\n-- backfill: legacy 3- and 6-column reports migrate without corruption --\n'

# Three header shapes shipped over the archive's life: 3 columns (Plan, Phase,
# Cost), 5 (+ Model, Tier) and 6 (+ Peak Ctx). Neither of these rows can join a
# transcript, so both take the pad path -- which is exactly where a width guard
# or a naive right-pad does its damage: the 3-column rule was left stranded under
# a 13-column header, and the 6-column form's Peak Ctx landed in Surcharge est ($).
BF2="$TMPROOT/bf2"
mkdir -p "$BF2/reports" "$BF2/logs"
cat > "$BF2/reports/2026-05-28-costs.md" <<'L3EOF'
# Nightly cost roll-up — 2026-05-28

| Plan | Phase | Cost ($) |
|---|---|---|
| legacy-three.md | impl | 10.3703 |
L3EOF
cat > "$BF2/reports/2026-07-04-costs.md" <<'L6EOF'
# Nightly cost roll-up — 2026-07-04

| Plan | Phase | Model | Tier | Cost ($) | Peak Ctx (K) |
|---|---|---|---|---|---|
| legacy-six.md | impl | claude-opus-5 | Opus | 5.9871 | 115K |
L6EOF

NIGHTLY_DIR="$BF2" "$BACKFILL" --proj-dir "$FIXROOT" > "$TMPROOT/bf-legacy.out"

r3="$BF2/reports/2026-05-28-costs.md"
r6="$BF2/reports/2026-07-04-costs.md"

# 31-33. The 3-column form: header, rule and row all reach 13 columns, and the
#        cost stays in the cost column rather than under Model.
assert_eq "$(awk -F'|' '/^\|---/{print NF-2; exit}' "$r3")" "$NCOL_EXPECTED" \
    "3-column report's separator rule widens to $NCOL_EXPECTED columns"
assert_eq "$(awk -F'|' '/^\| legacy-three\.md \|/{print NF-2; exit}' "$r3")" "$NCOL_EXPECTED" \
    "3-column report's data row widens to $NCOL_EXPECTED columns"
assert_eq "$(awk -F'|' '/^\| legacy-three\.md \|/{gsub(/[ \t]/,"",$6); print $6; exit}' "$r3")" \
    "10.3703" "3-column row keeps its cost in the cost column"

# 34-35. The 6-column form: Peak Ctx shifts right past the inserted Surcharge
#        cell instead of being rendered as a dollar figure.
assert_eq "$(awk -F'|' '/^\| legacy-six\.md \|/{gsub(/[ \t]/,"",$7); print $7; exit}' "$r6")" "" \
    "6-column row leaves the inserted Surcharge cell empty"
assert_eq "$(awk -F'|' '/^\| legacy-six\.md \|/{gsub(/[ \t]/,"",$8); print $8; exit}' "$r6")" "115K" \
    "6-column row's peak slides into Peak Ctx, not Surcharge"

# 36. Unjoined rows are still marked unknown, not silently left blank.
assert_eq "$(awk -F'|' '/^\| legacy-six\.md \|/{gsub(/[ \t]/,"",$14); print $14; exit}' "$r6")" \
    "unknown" "unjoined legacy row is marked Prov=unknown"

# 37. The legacy shapes are exactly where a re-widen would double-shift, so the
#     second run has to be a no-op the same way the 13-column path is.
NIGHTLY_DIR="$BF2" "$BACKFILL" --proj-dir "$FIXROOT" > "$TMPROOT/bf-legacy2.out"
assert_eq "$(grep -c '^no changes$' "$TMPROOT/bf-legacy2.out")" "1" \
    "re-running backfill over migrated legacy reports is a no-op"


# ---------------------------------------------------------------------------
# Stub-pricer sandbox — append_cost_row's plumbing (matrix rows 7-11).
#
# append_cost_row invokes "$SELF_DIR/../lib/automouse-pricer" with no --proj-dir,
# so letting the REAL pricer run here would glob ~/.claude/projects and make the
# test depend on the runner's home dir and on session ids that age out after
# ~30 days. A stub on that same self-relative path exercises every consumer of
# the pricer's JSON — parse, 13 columns, 20-key sidecar line, surcharge cell,
# weekly aggregate — with zero ~/.claude dependency. The pricer's own numeric
# correctness is pinned by the golden-constant assertions above.
# ---------------------------------------------------------------------------

echo
echo "-- append_cost_row: recomputed path via a stub pricer --"

S2=$(mktemp -d)
mkdir -p "$S2/reports" "$S2/logs" "$S2/bin/automouse" "$S2/bin/lib"
cat > "$S2/bin/lib/automouse-pricer" <<'STUBEOF'
#!/usr/bin/env bash
# Test stub: fixed JSON for session id "stub-good", exit 3 for anything else.
case " $* " in
  *" stub-good "*) ;;
  *) echo '{"error":"session-not-found"}'; exit 3 ;;
esac
cat <<'JSONEOF'
{"session_id":"stub-good","cost":9.1234,"surcharge_low":0.19,"surcharge_high":1.95,
 "inp":111,"out":222,"cr":333,"w5":444,"w1":555,"peak_ctx":208262,
 "compactions_main":2,"compactions_sub":1,"price_asof":"2026-08-18"}
JSONEOF
STUBEOF
chmod +x "$S2/bin/lib/automouse-pricer"

NIGHTLY_DIR="$S2"
SELF_DIR="$S2/bin/automouse"
LOG="$S2/logs/$(date +%F).log"
: > "$LOG"
S2_REPORT="$S2/reports/$(date +%F)-costs.md"
S2_SIDECAR="$S2/logs/$(date +%F).costs.jsonl"

for n in 1 2; do
    before=$(wc -l < "$LOG")
    printf '[00:0%d:00] good-%d.md/impl exit: cost=$1.8200 peak_ctx=99000 session_id=stub-good\n' \
        "$n" "$n" >> "$LOG"
    append_cost_row "good-$n.md" "impl" "$before" "claude-opus-4-1"
done

# Row 7 — the pricer's JSON reaches every column, and the recomputed figure
# replaces the harness figure rather than sitting beside it.
good_row=$(grep -m1 '^| good-1.md |' "$S2_REPORT")
assert_eq "$(printf '%s' "$good_row" | awk -F'|' '{print NF-2}')" "$NCOL_EXPECTED" \
    "recomputed row has 13 columns"
assert_eq "$(printf '%s' "$good_row" | awk -F'|' '{gsub(/[ \t]/,"",$6); print $6}')" "9.1234" \
    "cost column carries the recomputed figure, not the harness one"
assert_eq "$(printf '%s' "$good_row" | awk -F'|' '{gsub(/[ \t]/,"",$8); print $8}')" "208K" \
    "peak-ctx column carries the pricer peak, not the truncated stream peak"
assert_eq "$(printf '%s' "$good_row" | awk -F'|' '{gsub(/[ \t]/,"",$14); print $14}')" "recomputed" \
    "Prov column reads recomputed"
assert_eq "$(printf '%s' "$good_row" | awk -F'|' '{gsub(/[ 	]/,"",$7); print $7}')" "0.19–1.95" \
    "surcharge cell renders the en-dash bounded interval"

# Row 8 — one well-formed sidecar line per phase, carrying the full 20-key schema.
assert_eq "$(jq -s 'length' "$S2_SIDECAR")" "2" "sidecar gains exactly one line per phase"
assert_eq "$(jq -s '.[0] | keys | length' "$S2_SIDECAR")" "20" "sidecar line carries all 20 keys"
assert_eq "$(jq -r -s '.[0].provenance' "$S2_SIDECAR")" "recomputed" "sidecar records provenance"
assert_eq "$(jq -r -s '.[0].cost' "$S2_SIDECAR")" "9.1234" "sidecar records the recomputed cost"

# Row 11a — no unpriced rows means no exclusion note at all.
assert_eq "$(grep -c 'unpriced rows' "$S2_REPORT")" "0" \
    "all-priced week emits no exclusion note"

echo
echo "-- append_cost_row: a failing pricer degrades to unknown, it does not abort --"

# Row 9 — the pricer exits 3 for an unrecognised session. Under `set -euo
# pipefail` in the real driver that must not kill the run; the row still lands,
# falling back to the harness figure and flagged as unpriced.
before=$(wc -l < "$LOG")
printf '[00:03:00] bad.md/impl exit: cost=$2.5000 peak_ctx=101000 session_id=stub-missing\n' >> "$LOG"
append_cost_row "bad.md" "impl" "$before" "claude-opus-4-1"
assert_eq "$?" "0" "append_cost_row returns 0 when the pricer fails"

bad_row=$(grep -m1 '^| bad.md |' "$S2_REPORT")
assert_eq "$(printf '%s' "$bad_row" | awk -F'|' '{gsub(/[ \t]/,"",$14); print $14}')" "unknown" \
    "failed pricer yields Prov=unknown"
assert_eq "$(printf '%s' "$bad_row" | awk -F'|' '{gsub(/[ \t]/,"",$6); print $6}')" "2.5000" \
    "failed pricer falls back to the logged harness cost"
assert_eq "$(printf '%s' "$bad_row" | awk -F'|' '{print NF-2}')" "$NCOL_EXPECTED" \
    "unknown row still has 13 columns"

echo
echo "-- weekly aggregate: three totals, and unpriced rows are counted --"

# Row 10 — floor / floor+low / floor+high are all emitted, and the floor is the
# plain sum of the sidecar costs (9.1234 + 9.1234 + 2.5000).
assert_eq "$(grep -c '^| \*\*Total\*\* (floor)' "$S2_REPORT")" "1" "floor total emitted"
assert_eq "$(grep -c '^| \*\*Total\*\* (floor + est low)' "$S2_REPORT")" "1" "floor+low total emitted"
assert_eq "$(grep -c '^| \*\*Total\*\* (floor + est high)' "$S2_REPORT")" "1" "floor+high total emitted"

floor=$(awk -F'|' '/\*\*Total\*\* \(floor\)/ {gsub(/[ \t]/,"",$3); print $3; exit}' "$S2_REPORT")
sidecar_sum=$(jq -s '[.[].cost] | add' "$S2_SIDECAR")
assert_near "$floor" "$sidecar_sum" 0.0001 "floor total equals the sidecar cost sum"

low=$(awk -F'|' '/\*\*Total\*\* \(floor \+ est low\)/ {gsub(/[ \t]/,"",$3); print $3; exit}' "$S2_REPORT")
high=$(awk -F'|' '/\*\*Total\*\* \(floor \+ est high\)/ {gsub(/[ \t]/,"",$3); print $3; exit}' "$S2_REPORT")
assert_gt "$low" "$floor" "floor+low exceeds floor" "the surcharge interval must widen the total"
assert_gt "$high" "$low" "floor+high exceeds floor+low"

# Row 11b — the one unknown row is counted and named.
assert_eq "$(grep -c '> \*\*excludes 1 unpriced rows\*\*' "$S2_REPORT")" "1" \
    "week with one unknown row reports excludes 1"

# Split-miss flagging is retained (plan: dropping the column was the REJECTED
# alternative) and is now fed by the pricer's 208262 peak. The truncated stream
# value (99000) would have suppressed it — which is the bug this pins.
assert_eq "$(grep -c 'Split-miss candidates (peak ctx >150K)' "$S2_REPORT")" "1" \
    "split-miss block is retained and fires on the recomputed peak"
assert_eq "$(grep -c 'impl(208K)' "$S2_REPORT")" "1" "split-miss names the phase and its true peak"

echo
echo "-- schema migration: the old 6-column report widens without shifting cells --"

# The new schema INSERTS "Surcharge est ($)" at column 6, so an old row's peak
# must slide from cell 6 to cell 7. Padding seven cells onto the END gets the
# count right (13) and the semantics wrong: the peak lands under Surcharge.
S3=$(mktemp -d)
mkdir -p "$S3/reports" "$S3/logs"
NIGHTLY_DIR="$S3"
SELF_DIR="$S3/nonexistent"
LOG="$S3/logs/$(date +%F).log"
: > "$LOG"
S3_REPORT="$S3/reports/$(date +%F)-costs.md"
cat > "$S3_REPORT" <<OLDEOF
# Automouse cost roll-up — $(date +%F)

| Plan | Phase | Model | Tier | Cost (\$) | Peak Ctx (K) |
|---|---|---|---|---|---|
| old.md | impl | claude-opus-4-1 | opus | 1.2300 | 101K |
OLDEOF

before=$(wc -l < "$LOG")
printf '[00:01:00] new.md/impl exit: cost=$4.0000 peak_ctx=120000\n' >> "$LOG"
append_cost_row "new.md" "impl" "$before" "claude-opus-4-1"

old_row=$(grep -m1 '^| old.md |' "$S3_REPORT")
assert_eq "$(printf '%s' "$old_row" | awk -F'|' '{print NF-2}')" "$NCOL_EXPECTED" \
    "migrated old row has 13 columns"
assert_eq "$(printf '%s' "$old_row" | awk -F'|' '{gsub(/[ \t]/,"",$6); print $6}')" "1.2300" \
    "migrated old row keeps its cost in the cost column"
assert_eq "$(printf '%s' "$old_row" | awk -F'|' '{gsub(/[ \t]/,"",$7); print $7}')" "" \
    "migrated old row leaves the inserted Surcharge cell empty"
assert_eq "$(printf '%s' "$old_row" | awk -F'|' '{gsub(/[ \t]/,"",$8); print $8}')" "101K" \
    "migrated old row's peak slides into Peak Ctx, not Surcharge"
assert_eq "$(grep -c '^| Plan | Phase | Model | Tier | Cost (\$) | Surcharge est (\$) |' "$S3_REPORT")" "1" \
    "header is rewritten to the 13-column schema exactly once"

rm -rf "$S2" "$S3"

exit "$FAILED"
