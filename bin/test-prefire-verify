for name in $CASES; do
    if ! declare -F "$name" >/dev/null; then
        echo "FAIL $name: no such case"
        H_FAIL=$((H_FAIL + 1))
        continue
    fi
    WHY=""
    "$name"
    if [ -z "$WHY" ]; then
        echo "PASS $name"
        H_PASS=$((H_PASS + 1))
    else
        echo "FAIL $name: $WHY"
        printf '%s\n' "$OUT" | sed -n '1,15p' | sed 's/^/    | /'
        H_FAIL=$((H_FAIL + 1))
    fi
done

h_done
