#!/bin/bash
#
# bin/check-engine-freeze: keep new decompile tokens inside the JSB port paths.
#
# The name is historical. ADR-0194 froze engine/ with a second gate. ADR-0236
# lifted the freeze and kept this file name because both ADRs cite it.
#
#   Decompile-token gate: no added line or added file name may carry a decompile
#     artifact (function, data, and label symbols, the dumped source file names,
#     and struct offsets) unless its path starts with an allowlisted prefix:
#       engine/      the faithful Go port of JSB
#       jsb-native/  RE research material for the port (untracked today)
#     Website code under ibl5/ and every other path stay banned. Deleted and
#     context lines are never read, so existing citations stay and removing one
#     passes. --no-renames makes a move out of an allowlisted path count as
#     added lines under the new path, so it fails.
#
# The base is always passed in with --since=<ref> (CI passes the PR base sha), never
# derived from repo state. Diffs compare the working tree against the merge-base, so
# staged and unstaged tracked changes count. Untracked files do not.
#
# The allowlist below is fixed. There is no exemption directory and no inline
# marker. Fixtures in the harness are built by concatenation.
# Keep this file free of the literal tokens, or the gate fails its own PR.
#
# Bash 3.2 safe (macOS /bin/bash): no mapfile, no associative arrays, no ${x,,}.
#
# Exit codes: 0 = pass, 1 = violation found, 2 = usage or git error.

set -euo pipefail

usage() {
    echo "usage: bin/check-engine-freeze --since=<ref>"
    echo "fails when an added line or file name outside engine/ or jsb-native/ carries a decompile token"
}

die() {
    echo "check-engine-freeze: $1" >&2
    exit 2
}

since=""
if [ "$#" -eq 0 ]; then
    usage >&2
    die "use --since=<ref>"
fi
for arg in "$@"; do
    case "$arg" in
        -h|--help) usage; exit 0 ;;
        --since=?*) since="${arg#--since=}" ;;
        --since=|--since) die "use --since=<ref>" ;;
        -*) die "unknown option: $arg" ;;
        *) die "use --since=<ref> (unexpected argument: $arg)" ;;
    esac
done
[ -n "$since" ] || die "use --since=<ref>"

root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repository"
cd "$root"

git rev-parse --verify --quiet "${since}^{commit}" >/dev/null || die "cannot resolve ref: $since"
mb=$(git merge-base "$since" HEAD 2>/dev/null) || die "no merge-base (shallow clone?)"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

gitdiff() {
    git -c core.quotePath=false diff --no-color --no-ext-diff --no-textconv \
        --src-prefix=a/ --dst-prefix=b/ "$@"
}

# Run a diff into a file. A non-zero git exit is a usage or git error, never a pass.
diff_to() {
    local out="$1"
    shift
    gitdiff "$@" >"$out" || die "git diff failed: $*"
}

viol=0

# ── Gate B: decompile tokens ─────────────────────────────────────────────────

TOKEN_RE='FUN_[0-9A-Fa-f]{6,}|DAT_[0-9A-Fa-f]{6,}|LAB_[0-9A-Fa-f]{6,}|decompiled\.c|jsb560_decompile[d]|00_MASTER_REFERENCE\.md|\+0x[0-9A-Fa-f]{2,}'
HUNK_RE='^@@ -[0-9,]+ \+([0-9]+)'

# Paths where an added line or file name may carry a decompile token (ADR-0236).
# Match is by prefix on the post-image path. The list is fixed.
allowed_path() {
    case "$1" in
        engine/*|jsb-native/*) return 0 ;;
    esac
    return 1
}

# --no-renames: a file moved out of an allowlisted path shows every line as added under its new path.
diff_to "$tmp/full.diff" --no-renames -U0 "$mb"
rc=0
grep -E '^(\+|@@ )' "$tmp/full.diff" >"$tmp/added.diff" || rc=$?
[ "$rc" -le 1 ] || die "grep failed on the diff"

path=""
line=0
ok=0
while IFS= read -r l; do
    case "$l" in
        '+++ /dev/null')
            path=""
            ok=0
            ;;
        '+++ b/'*)
            path="${l#+++ b/}"
            if allowed_path "$path"; then ok=1; else ok=0; fi
            if [ "$ok" -eq 0 ] && [[ $path =~ $TOKEN_RE ]]; then
                echo "DECOMPILE-TOKEN $path: file name: ${BASH_REMATCH[0]}"
                viol=1
            fi
            ;;
        '@@ '*)
            if [[ $l =~ $HUNK_RE ]]; then
                line=${BASH_REMATCH[1]}
            fi
            ;;
        '+'*)
            # Strip the leading plus so content that starts with 0x is not a hit.
            c="${l#+}"
            if [ "$ok" -eq 0 ] && [[ $c =~ $TOKEN_RE ]]; then
                echo "DECOMPILE-TOKEN $path:$line: ${BASH_REMATCH[0]}"
                viol=1
            fi
            line=$((line + 1))
            ;;
    esac
done <"$tmp/added.diff"

if [ "$viol" -ne 0 ]; then
    echo "decompile tokens may be added only under engine/ or jsb-native/; see .claude/rules/engine-go.md"
    echo "move the citation under an allowlisted path or reword the added line"
    exit 1
fi

echo "check-engine-freeze: OK"
