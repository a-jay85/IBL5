test_testmode_refuses_unset_dir() {
    new_env
    seed_home ""
    unset IBL5_USAGE_GATE_STATE_DIR
    local real; real=$(real_default_dir)
    mkdir -p "$real"
    printf '%s' "$(usage_json 95 0)" | jq --argjson t "$(date +%s)" '. + {fetched_at:$t}' > "$real/cache.json"
    make_stub_bin "$STUB" tok "$BODY_B"; stub_security_recorder "$STUB"
    local err rc
    err=$(IBL5_USAGE_GATE_TEST_MODE=1 PATH="$STUB:$ORIG_PATH" bash -c ". '$REPO_ROOT/bin/lib/usage-gate.sh'; usage_prestart_gate automouse $SID_A /x/run" 2>&1 >/dev/null); rc=$?
    assert_eq testmode_refuse_unset:rc 0 "$rc"
    assert_contains testmode_refuse_unset:stderr "$err" "USAGE-GATE-TEST: refusing the real state dir"
    assert_eq testmode_refuse_unset:files "$real/cache.json" "$(find "$real" -type f)"
    assert_eq testmode_refuse_unset:markers "" "$(ls -A "$real/markers" 2>/dev/null)"
}

test_testmode_refuses_explicit_real_dir() {
    new_env
    seed_home ""
    local real; real=$(real_default_dir)
    local out rc
    out=$(IBL5_USAGE_GATE_STATE_DIR="$real/" IBL5_USAGE_GATE_TEST_MODE=1 bash -c ". '$REPO_ROOT/bin/lib/usage-fetch.sh'; usage_state_dir" 2>/dev/null); rc=$?
    assert_eq testmode_refuse_explicit:rc 1 "$rc"
    assert_eq testmode_refuse_explicit:out /dev/null/usage-gate-refused "$out"
    assert_no_file testmode_refuse_explicit:no-dir "$real"
}

test_prod_unset_dir_uses_default() {
    new_env
    seed_home ""
    unset IBL5_USAGE_GATE_STATE_DIR IBL5_USAGE_GATE_TEST_MODE
    local out rc
    out=$(bash -c ". '$REPO_ROOT/bin/lib/usage-fetch.sh'; usage_state_dir"); rc=$?
    assert_eq prod_default:rc 0 "$rc"
    assert_eq prod_default:out "$(real_default_dir)" "$out"
    assert_file prod_default:markers "$(real_default_dir)/markers"
}

# ---------------------------------------------------------------- runner

TESTS=$(grep -E '^test_[a-z0-9_]+\(\)' "$0" | sed 's/().*//')
if [ "$#" -gt 0 ]; then TESTS="$*"; fi
for t in $TESTS; do
    echo "$t"
    "$t"
done

echo
echo "passed=$PASS failed=$FAIL"
if [ "$FAIL" -ne 0 ]; then
    echo "failed:$FAILED_NAMES"
    exit 1
fi
exit 0
