    && grep -qF -- "  V Ann Alpha 34m 28p 5r 7a 2s 0b 10-19 3-7" "$STUB/prompt.out"; then
    srt_ok "prompt_fact_sheet_renders_game_and_player_lines — g1 header and V player line"
