#!/usr/bin/env bash
# Tests bin/lib/prefire-verify (the pre-fire verification gate) and its wiring
# into bin/post-plan-now, with stubbed PHPUnit / DB probe.
#
# Usage: bin/test-prefire-verify [case_name ...]
# With no arguments every case runs; with arguments only the named cases run.
# Prints `PASS <name>` / `FAIL <name>: <why>` per case. Exit 0 iff all pass.
set -uo pipefail

# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GATE="$REPO/bin/lib/prefire-verify"
PPN="$REPO/bin/post-plan-now"

h_tmp TMP
mkdir -p "$TMP/shims" "$TMP/runlog" "$TMP/Library/LaunchAgents"
# Never touch real launchd, the keychain, or a shared /tmp log dir.
printf '#!/bin/sh\nexit 1\n' > "$TMP/shims/security"
printf '#!/bin/sh\nexit 0\n' > "$TMP/shims/launchctl"
chmod +x "$TMP/shims/security" "$TMP/shims/launchctl"
export PATH="$TMP/shims:$PATH"
export IBL5_USAGE_GATE_STATE_DIR="$TMP/gate"
mkdir -p "$IBL5_USAGE_GATE_STATE_DIR"
export POSTPLAN_LOG_DIR="$TMP/runlog" PLAN_NOW_LOG_DIR="$TMP/runlog"
unset CLAUDE_HEADLESS

WHY=""      # failure reasons for the current case
OUT=""      # combined stdout+stderr of the last run
RC=0        # exit code of the last run

note() { WHY="${WHY:+$WHY; }$*"; }
want_rc() { [ "$RC" -eq "$1" ] || note "expected exit $1, got $RC"; }
want_out() { grep -qF -- "$1" <<< "$OUT" || note "output lacks '$1'"; }
refute_out() { if grep -qF -- "$1" <<< "$OUT"; then note "output unexpectedly has '$1'"; fi; }
want_cnt() { # <counter> <n>
    local got; got=$(cnt "$1")
    [ "$got" -eq "$2" ] || note "counter $1 expected $2, got $got"
}
cnt() {
    if [ -f "$CNT/$1" ]; then wc -l < "$CNT/$1" | tr -d ' '; else echo 0; fi
}
want_args() { # <exact last argv line the phpunit stub recorded>
    local got; got=$(tail -n 1 "$CNT/phpunit_args" 2>/dev/null)
    [ "$got" = "$1" ] || note "phpunit args expected '$1', got '$got'"
}
run_gate_nobase() { OUT=$(cd "$R" && "$GATE" "$@" 2>&1); RC=$?; }

# ---------------------------------------------------------------------------
# Fixture: a fresh temp git repo plus stubs. Sets D (case dir), R (repo),
# CNT (counter dir), PLAN (plan file path), and the PREFIRE_* seams.
# ---------------------------------------------------------------------------
new_case() {
    D=$(mktemp -d "$TMP/case.XXXXXX")
    R="$D/repo"
    CNT="$D/cnt"
    PLAN="$D/plan.md"
    mkdir -p "$R/ibl5/vendor/bin" "$CNT" "$D/stubs"
    export CNT
    unset STUB_PHPUNIT_RC STUB_MUT_MODE
    cat > "$R/ibl5/vendor/bin/phpunit" <<'EOF'
#!/usr/bin/env bash
echo run >> "$CNT/phpunit"
printf '%s:%s\n' "$#" "$*" >> "$CNT/phpunit_args"
exit "${STUB_PHPUNIT_RC:-0}"
EOF
    printf '#!/usr/bin/env bash\necho run >> "$CNT/mutation"\nexit 0\n' > "$D/stubs/mutation"
    printf '#!/usr/bin/env bash\necho run >> "$CNT/probe"\nexit "${STUB_PROBE_RC:-0}"\n' > "$D/stubs/probe"
    printf '#!/usr/bin/env bash\necho run >> "$CNT/excludes"\nexit 0\n' > "$D/stubs/excludes"
    chmod +x "$R/ibl5/vendor/bin/phpunit" "$D/stubs/mutation" "$D/stubs/probe" "$D/stubs/excludes"
    (
        cd "$R" || exit 1
        git init -q -b master
        git config user.email t@example.com
        git config user.name Test
        printf 'a\n' > ibl5/tracked.txt
        git add -A
        git commit -q -m init
    ) || { echo "HARNESS-SETUP: fixture repo failed" >&2; exit 2; }
    export PREFIRE_PHPUNIT_CMD="vendor/bin/phpunit"
    export PREFIRE_PHPUNIT_FULL=1   # existing cases pin full-suite behavior; subset_case unsets it
    export PREFIRE_DB_PROBE_CMD="$D/stubs/probe"
    # Removed seams. Kept exported so a stray read shows up in $CNT.
    export PREFIRE_MUTATION_CMD="$D/stubs/mutation"
    export PREFIRE_EXCLUDES_CMD="$D/stubs/excludes"
}

# subset_case: new_case plus a committed class/test tree on master, then branch feat.
# Auto mode: PREFIRE_PHPUNIT_FULL unset.
subset_case() {
    new_case
    unset PREFIRE_PHPUNIT_FULL
    (
        cd "$R" || exit 1
        mkdir -p ibl5/classes/Foo ibl5/tests/Foo ibl5/tests/Other ibl5/tests/WideUnit
        printf '<?php\nclass Bar {}\n' > ibl5/classes/Foo/Bar.php
        printf '<?php\nclass Lonely {}\n' > ibl5/classes/Foo/Lonely.php
        printf '<?php\nclass Team {}\n' > ibl5/classes/Team.php
        printf '<?php\nclass BarTest { function t() { new Bar(); } }\n' > ibl5/tests/Foo/BarTest.php
        printf '<?php\nclass OldTest {}\n' > ibl5/tests/Foo/OldTest.php
        printf '<?php\nclass UsesBarTest { function t() { Bar::x(); } }\n' > ibl5/tests/Other/UsesBarTest.php
        printf '<?php\nclass UnrelatedTest {}\n' > ibl5/tests/Other/UnrelatedTest.php
        printf '<?php\n// root-class test\n' > ibl5/tests/TeamTest.php
        printf '<?php\nabstract class WideUnitTestCase {}\n' > ibl5/tests/WideUnit/WideUnitTestCase.php
        printf '<?php\n' > ibl5/tests/bootstrap.php
        printf '<phpunit/>\n' > ibl5/phpunit.xml
        printf '{}\n' > ibl5/composer.lock
        git add -A && git commit -q -m tree && git checkout -q -b feat
    ) || { echo "HARNESS-SETUP: subset fixture failed" >&2; exit 2; }
}

# write_plan <row-line>...  — each argument is a full table row.
write_plan() {
    {
        printf '# Plan\n\n## Verification Matrix\n\n'
        printf '| # | What to verify | Test type | Timing | Test file / location |\n'
        printf '|---|----------------|-----------|--------|----------------------|\n'
        local r
        for r in "$@"; do printf '%s\n' "$r"; done
        printf '\nAll verification is automated.\n'
    } > "$PLAN"
}

row() { # <n> <cmd>
    printf '| %s | check %s | CLI-executable | post-impl | %s |' "$1" "$1" "$2"
}

# Three green rows that count their runs.
green_plan() {
    write_plan "$(row 1 "echo x >> $CNT/row1")" \
               "$(row 2 "echo x >> $CNT/row2")" \
               "$(row 3 "echo x >> $CNT/row3")"
}

run_gate() { # args passed to the gate; cwd = fixture repo
    OUT=$(cd "$R" && "$GATE" --base master "$@" 2>&1); RC=$?
}

# The gate's per-worktree pass-record dir (git-path may be relative to the repo).
state_dir() {
    local p; p=$(cd "$R" && git rev-parse --git-path prefire-verify)
    case "$p" in /*) printf '%s' "$p" ;; *) printf '%s/%s' "$R" "$p" ;; esac
}
pass_files() { # <glob>
    local d f; d=$(state_dir)
    [ -d "$d" ] || return 0
    for f in "$d"/*; do
        [ -e "$f" ] || continue
        f=${f##*/}
        if [[ "$f" =~ $1 ]]; then printf '%s\n' "$f"; fi
    done
}
tree_hash() {
    local idx rc
    idx=$(mktemp "$TMP/idx.XXXXXX")
    (cd "$R" && cp "$(git rev-parse --git-path index)" "$idx" \
        && GIT_INDEX_FILE="$idx" git add -A >/dev/null 2>&1 \
        && GIT_INDEX_FILE="$idx" git write-tree)
    rc=$?
    rm -f "$idx"
    return $rc
}

# ---------------------------------------------------------------------------
# Gate cases (matrix rows 7-21)
# ---------------------------------------------------------------------------
test_matrix_row_failure_refuses_and_names_row() {
    new_case
    write_plan "$(row 1 true)" "$(row 2 true)" "$(row 3 'exit 7')"
    run_gate --plan "$PLAN"
    want_rc 1
    want_out "FAIL matrix row 3 exited 7"
    [ -z "$(pass_files '\.matrix\..*\.pass$')" ] || note "a matrix pass record exists"
}

test_unrun_row_refuses_without_gate_record() {
    new_case
    write_plan "$(row 1 "echo x >> $CNT/row1; exit 7")"
    local d sha tree
    d=$(state_dir); mkdir -p "$d"
    sha=$(git hash-object "$PLAN")
    tree=$(tree_hash)
    printf 'All rows passed.\n' > "$D/ledger.md"
    printf 'stage=matrix tree=OTHERTREE key=%s at=x by=prefire-verify\n' "$sha" \
        > "$d/OTHERTREE.matrix.$sha.pass"
    # Correct filename, wrong tree= field inside.
    printf 'stage=matrix tree=WRONGTREE key=%s at=x by=prefire-verify\n' "$sha" \
        > "$d/$tree.matrix.$sha.pass"
    run_gate --plan "$PLAN"
    want_rc 1
    want_cnt row1 1
}

test_matrix_extract_skips_near_miss_rows() {
    new_case
    {
        printf '## Verification Matrix\n\n'
        printf '| # | What to verify | Test type | Timing | Test file / location |\n'
        printf '|---|---|---|---|---|\n'
        printf '| 1 | manual; run CLI-executable thing | Truly-manual | post-impl | echo manual |\n'
        printf '| 2 | pre | CLI-executable | pre-impl | echo pre |\n'
        printf '| 3 | plan-time (one-time-check: plan-time corpus diff) | CLI-executable | post-impl | echo onetime |\n'
        printf '| 4 | merge | CLI-executable | post-impl | post-merge: echo merged |\n'
        printf '| 5 | run-only | CLI-executable (run-only) | post-impl | echo runonly |\n'
        printf '| 6 | pipe | CLI-executable | post-impl | echo a \\| tr a b |\n'
        printf '\n## Next\n\n| 7 | after | CLI-executable | post-impl | echo outside |\n'
    } > "$PLAN"
    local got want
    got=$(bash -c ". '$REPO/bin/lib/plan-matrix-rows.sh'; plan_matrix_rows '$PLAN'" 2>&1)
    want=$'5\techo runonly\n6\techo a | tr a b'
    [ "$got" = "$want" ] || note "expected exactly rows 5 and 6, got: $(printf '%s' "$got" | tr '\t\n' ' >')"
}

test_relative_plan_from_subdir_runs_rows() {
    new_case
    green_plan
    # cwd = ibl5/, so ../../plan.md is the plan here and nothing at the repo root.
    OUT=$(cd "$R/ibl5" && "$GATE" --base master --stage matrix --plan ../../plan.md 2>&1); RC=$?
    want_rc 0
    refute_out "no evidence to check"
    want_out "matrix passed"
    want_cnt row1 1
    want_cnt row3 1
}

test_plan_without_matrix_refuses() {
    new_case
    printf '# Plan\n\n## Phase 1\n\nNothing here.\n' > "$PLAN"
    run_gate --plan "$PLAN"
    want_rc 1
    want_out "no evidence to check"
}

