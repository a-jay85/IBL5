run_approval synchronize "" not-ui "" "" /nonexistent; rc=$?
expect "approval: not-ui skips fingerprint -> rc 0" 0 "$rc"
want "approval: not-ui skips fingerprint -> pass" "$LAST_OUT" "VERDICT=pass"

# hs_not_ui_passes: a backend-only PR titled "feat: add stat endpoint" now gets
