extract_step67_block() {
    # Prints the first bash fence found between ## Step 6.7: and ## Step 7: headings
    local prompt_file
    prompt_file="$(dirname "$0")/automouse/prompt-impl"
    awk '/^## Step 6\.7:/{found=1} found && /^```bash$/{in_block=1; next} in_block && /^```$/{exit} in_block{print} /^## Step 7:/ && found{exit}' "$prompt_file"
}

step67-skipped-no-plan() {
    local repo plan="" stub_checker=""
    trap '_rm_tmp "$repo" "${plan:+$(dirname "$plan")}" "$stub_checker"; trap - RETURN' RETURN
    repo=$(mktemp -d)
    git -C "$repo" init -q
    git -C "$repo" commit --allow-empty -m "base" -q
    BASE=$(git -C "$repo" rev-parse HEAD)
    git -C "$repo" update-ref refs/remotes/origin/master "$BASE"

    local plan
    plan="$repo/missing-plan.md"
    # plan file does not exist

    local block
    block=$(extract_step67_block)
    [ -n "$block" ] || { echo "FAIL extract_step67_block returned empty"; return 1; }

    local out
    out=$(cd "$repo" && PLAN_PATH="$plan" MATRIX_SCRIPT="$MATRIX_ASSERTIONS_SCRIPT" bash -c "$block" 2>&1)
    if echo "$out" | grep -q 'MATRIX_VERDICT=skipped'; then
        echo "PASS step67-skipped-no-plan"
    else
        echo "FAIL step67-skipped-no-plan — expected MATRIX_VERDICT=skipped, got: $out"
        return 1
    fi
}

step67-unrealised() {
    local repo plan="" stub_checker=""
    trap '_rm_tmp "$repo" "${plan:+$(dirname "$plan")}" "$stub_checker"; trap - RETURN' RETURN
    repo=$(mktemp -d)
    git -C "$repo" init -q
    git -C "$repo" commit --allow-empty -m "base" -q
    BASE=$(git -C "$repo" rev-parse HEAD)
    git -C "$repo" update-ref refs/remotes/origin/master "$BASE"

    local plan
    plan="$(mktemp -d)/plan.md"
    plan_fixture '| 1 | `frobnicate_widget_case` verifies the gate | CLI-executable | post-impl | `bin/test-it` |' > "$plan"

    # Branch commit adds a file WITHOUT the token
    echo "nothing here" > "$repo/some_file.txt"
    git -C "$repo" add some_file.txt
    git -C "$repo" commit -m "branch" -q

    local block
    block=$(extract_step67_block)
    [ -n "$block" ] || { echo "FAIL extract_step67_block returned empty"; return 1; }

    local out
    out=$(cd "$repo" && PLAN_PATH="$plan" MATRIX_SCRIPT="$MATRIX_ASSERTIONS_SCRIPT" bash -c "$block" 2>&1)
    if echo "$out" | grep -q 'MATRIX_VERDICT=unrealised' && echo "$out" | grep -q 'UNREALISED-ASSERTION: row'; then
        echo "PASS step67-unrealised"
    else
        echo "FAIL step67-unrealised — expected unrealised verdict, got: $out"
        return 1
    fi
}

step67-clean() {
    local repo plan="" stub_checker=""
    trap '_rm_tmp "$repo" "${plan:+$(dirname "$plan")}" "$stub_checker"; trap - RETURN' RETURN
    repo=$(mktemp -d)
    git -C "$repo" init -q
    git -C "$repo" commit --allow-empty -m "base" -q
    BASE=$(git -C "$repo" rev-parse HEAD)
    git -C "$repo" update-ref refs/remotes/origin/master "$BASE"

    local plan
    plan="$(mktemp -d)/plan.md"
    plan_fixture '| 1 | `frobnicate_widget_case` verifies the gate | CLI-executable | post-impl | `bin/test-it` |' > "$plan"

    # Branch commit adds a file WITH the token
    echo "frobnicate_widget_case" > "$repo/test_widget.py"
    git -C "$repo" add test_widget.py
    git -C "$repo" commit -m "branch" -q

    local block
    block=$(extract_step67_block)
    [ -n "$block" ] || { echo "FAIL extract_step67_block returned empty"; return 1; }

    local out
    out=$(cd "$repo" && PLAN_PATH="$plan" MATRIX_SCRIPT="$MATRIX_ASSERTIONS_SCRIPT" bash -c "$block" 2>&1)
    if echo "$out" | grep -q 'MATRIX_VERDICT=clean'; then
        echo "PASS step67-clean"
    else
        echo "FAIL step67-clean — expected MATRIX_VERDICT=clean, got: $out"
        return 1
    fi
}

step67-uncommitted() {
    local repo plan="" stub_checker=""
    trap '_rm_tmp "$repo" "${plan:+$(dirname "$plan")}" "$stub_checker"; trap - RETURN' RETURN
    repo=$(mktemp -d)
    git -C "$repo" init -q
    git -C "$repo" commit --allow-empty -m "base" -q
    BASE=$(git -C "$repo" rev-parse HEAD)
    git -C "$repo" update-ref refs/remotes/origin/master "$BASE"

    local plan
    plan="$(mktemp -d)/plan.md"
    plan_fixture '| 1 | `frobnicate_widget_case` verifies the gate | CLI-executable | post-impl | `bin/test-it` |' > "$plan"

    # Token file exists but is NOT committed (untracked)
    echo "frobnicate_widget_case" > "$repo/test_widget.py"

    local block
    block=$(extract_step67_block)
    [ -n "$block" ] || { echo "FAIL extract_step67_block returned empty"; return 1; }

    local out
    out=$(cd "$repo" && PLAN_PATH="$plan" MATRIX_SCRIPT="$MATRIX_ASSERTIONS_SCRIPT" bash -c "$block" 2>&1)
    if echo "$out" | grep -q 'MATRIX_VERDICT=uncommitted'; then
        echo "PASS step67-uncommitted"
    else
        echo "FAIL step67-uncommitted — expected MATRIX_VERDICT=uncommitted, got: $out"
        return 1
    fi
}

step67-unavailable() {
    local repo plan="" stub_checker=""
    trap '_rm_tmp "$repo" "${plan:+$(dirname "$plan")}" "$stub_checker"; trap - RETURN' RETURN
    repo=$(mktemp -d)
    git -C "$repo" init -q
    git -C "$repo" commit --allow-empty -m "base" -q
    BASE=$(git -C "$repo" rev-parse HEAD)
    git -C "$repo" update-ref refs/remotes/origin/master "$BASE"

    local plan
    plan="$(mktemp -d)/plan.md"
    plan_fixture '| 1 | `frobnicate_widget_case` verifies the gate | CLI-executable | post-impl | `bin/test-it` |' > "$plan"

    echo "frobnicate_widget_case" > "$repo/test_widget.py"
    git -C "$repo" add test_widget.py
    git -C "$repo" commit -m "branch" -q

    # Stub checker that exits 2
    local stub_checker
    stub_checker=$(mktemp)
    printf '#!/bin/sh\necho "checker broken" >&2\nexit 2\n' > "$stub_checker"
    chmod +x "$stub_checker"

    local block
    block=$(extract_step67_block)
    [ -n "$block" ] || { echo "FAIL extract_step67_block returned empty"; return 1; }

    local out
    out=$(cd "$repo" && PLAN_PATH="$plan" MATRIX_SCRIPT="$stub_checker" bash -c "$block" 2>&1)
    if echo "$out" | grep -q 'MATRIX_VERDICT=unavailable'; then
        echo "PASS step67-unavailable"
    else
        echo "FAIL step67-unavailable — expected MATRIX_VERDICT=unavailable, got: $out"
        return 1
    fi
}

extract_prefire_command() {
    # Extract the backtick-quoted command from the **Matrix check first.** line in workflow-continuity.md
    local rule_file
    rule_file="$(dirname "$0")/../.claude/rules/workflow-continuity.md"
    grep '\*\*Matrix check first\.\*\*' "$rule_file" | grep -o '`bin/lib/plan-matrix-assertions[^`]*`' | tr -d '`'
}

prefire-rule-staged-new-file-realised() {
    local span
    span=$(extract_prefire_command)
    [ -n "$span" ] || { echo "FAIL prefire-rule-staged-new-file-realised — extracted span is empty"; return 1; }

    local repo plan="" stub_checker=""
    trap '_rm_tmp "$repo" "${plan:+$(dirname "$plan")}" "$stub_checker"; trap - RETURN' RETURN
    repo=$(mktemp -d)
    git -C "$repo" init -q
    git -C "$repo" commit --allow-empty -m "base" -q
    BASE=$(git -C "$repo" rev-parse HEAD)
    git -C "$repo" update-ref refs/remotes/origin/master "$BASE"

    local plan
    plan="$(mktemp -d)/plan.md"
    plan_fixture '| 1 | `frobnicate_prefire_case` verifies the gate | CLI-executable | post-impl | `bin/test-it` |' > "$plan"

    # New uncommitted file staged with the token
    echo "frobnicate_prefire_case" > "$repo/test_prefire.py"
    git -C "$repo" add test_prefire.py

    # Build the command: substitute <plan> with the real plan path, and prefix bin/lib/plan-matrix-assertions with the real script path
    local cmd
    cmd=$(echo "$span" | sed "s|<plan>|$plan|g" | sed "s|bin/lib/plan-matrix-assertions|$MATRIX_ASSERTIONS_SCRIPT|g")

    local out
    out=$(cd "$repo" && eval "$cmd" 2>&1)
    local rc=$?

    if [ $rc -eq 0 ] && ! echo "$out" | grep -q 'UNREALISED-ASSERTION'; then
        echo "PASS prefire-rule-staged-new-file-realised"
    else
        echo "FAIL prefire-rule-staged-new-file-realised — expected no UNREALISED-ASSERTION and exit 0, got rc=$rc out=$out"
        return 1
    fi
}

prefire-rule-missing-token-unrealised() {
    local span
    span=$(extract_prefire_command)
    [ -n "$span" ] || { echo "FAIL prefire-rule-missing-token-unrealised — extracted span is empty"; return 1; }

    local repo plan="" stub_checker=""
    trap '_rm_tmp "$repo" "${plan:+$(dirname "$plan")}" "$stub_checker"; trap - RETURN' RETURN
    repo=$(mktemp -d)
    git -C "$repo" init -q
    git -C "$repo" commit --allow-empty -m "base" -q
    BASE=$(git -C "$repo" rev-parse HEAD)
    git -C "$repo" update-ref refs/remotes/origin/master "$BASE"

    local plan
    plan="$(mktemp -d)/plan.md"
    plan_fixture '| 1 | `frobnicate_prefire_case` verifies the gate | CLI-executable | post-impl | `bin/test-it` |' > "$plan"

    # Staged file does NOT contain the token
    echo "nothing relevant" > "$repo/test_prefire.py"
    git -C "$repo" add test_prefire.py

    local cmd
    cmd=$(echo "$span" | sed "s|<plan>|$plan|g" | sed "s|bin/lib/plan-matrix-assertions|$MATRIX_ASSERTIONS_SCRIPT|g")

    local out
    out=$(cd "$repo" && eval "$cmd" 2>&1)

    local unrealised_count
    unrealised_count=$(echo "$out" | grep -c 'UNREALISED-ASSERTION: row' || true)

    if [ "$unrealised_count" -eq 1 ]; then
        echo "PASS prefire-rule-missing-token-unrealised"
    else
        echo "FAIL prefire-rule-missing-token-unrealised — expected exactly 1 UNREALISED-ASSERTION line, got $unrealised_count in: $out"
        return 1
    fi
}

step67-routing() {
    local prompt_file
    prompt_file="$(dirname "$0")/automouse/prompt-impl"

    # Step 6.7 heading line number must be between Step 6.6 and Step 7 line numbers
    local line66 line67 line7
    line66=$(grep -n '^## Step 6\.6:' "$prompt_file" | head -1 | cut -d: -f1)
    line67=$(grep -n '^## Step 6\.7:' "$prompt_file" | head -1 | cut -d: -f1)
    line7=$(grep -n '^## Step 7:' "$prompt_file" | head -1 | cut -d: -f1)

    if [ -z "$line67" ] || [ "$line67" -le "$line66" ] || [ "$line67" -ge "$line7" ]; then
        echo "FAIL step67-routing — Step 6.7 heading not between Step 6.6 ($line66) and Step 7 ($line7), got: $line67"
        return 1
    fi

    # Step 6.6 section must have zero occurrences of "proceed to Step 7" or "proceeding to Step 7"
    local section66
    section66=$(awk "NR==$line66{found=1} found && NR>$line66 && /^## /{exit} found{print}" "$prompt_file")
    if echo "$section66" | grep -q 'proceed to Step 7\|proceeding to Step 7'; then
        echo "FAIL step67-routing — Step 6.6 still routes to Step 7"
        return 1
    fi

    # Step 6.7 section must contain the no-handoff and never-proceeds sentences
    local section67
    section67=$(awk "NR==$line67{found=1} found && NR>$line67 && /^## /{exit} found{print}" "$prompt_file")
    if ! echo "$section67" | grep -q 'Do NOT write the handoff file'; then
        echo "FAIL step67-routing — Step 6.7 missing 'Do NOT write the handoff file'"
        return 1
    fi
    if ! echo "$section67" | grep -q 'never proceeds to Step 7'; then
        echo "FAIL step67-routing — Step 6.7 missing 'never proceeds to Step 7'"
        return 1
    fi

    echo "PASS step67-routing"
}

step67() {
    local ok=0
    step67-skipped-no-plan || ok=1
    step67-unrealised || ok=1
    step67-clean || ok=1
    step67-uncommitted || ok=1
    step67-unavailable || ok=1
    step67-routing || ok=1
    return $ok
}

prefire() {
    local ok=0
    prefire-rule-staged-new-file-realised || ok=1
    prefire-rule-missing-token-unrealised || ok=1
    return $ok
}

# --- run a single case ---

run_case() {
local case="$1"
# Function-based cases (step67-*, prefire-*): call directly
if declare -f "$case" > /dev/null 2>&1; then
    if ! "$case"; then
        FAILED=1
    fi
    return
fi
local root
root=$(mktemp -d)
git -C "$root" init -q

case "$case" in

absent-new-token)
    plan_fixture '| 7 | `FIXTURE_NEW_SYMBOL` verifies the gate | CLI-executable | post-impl | `bin/test-it` |' \
        > "$root/plan.md"
    printf '+some unrelated added line\n' > "$root/diff.txt"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    lines=$(printf '%s\n' "$out" | grep -c 'UNREALISED-ASSERTION' || true)
    if [ "$rc" -eq 0 ] && [ "$lines" -eq 1 ] && printf '%s\n' "$out" | grep -qF 'UNREALISED-ASSERTION: row 7'; then
        ok "absent-new-token"
    else
        fail "absent-new-token (rc=$rc, lines=$lines, out=$out)"
    fi
    ;;

present-in-plus)
    plan_fixture '| 7 | `FIXTURE_NEW_SYMBOL` verifies the gate | CLI-executable | post-impl | `bin/test-it` |' \
        > "$root/plan.md"
    # feed diff on stdin via "-"
    out=$(printf '+FIXTURE_NEW_SYMBOL=1\n' | MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" - 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && [ -z "$out" ]; then
        ok "present-in-plus"
    else
        fail "present-in-plus (rc=$rc, out=$out)"
    fi
    ;;

no-single-word-tokens)
    plan_fixture '| 5 | `two words here` and plain prose only | CLI-executable | post-impl | `bin/test-it` |' \
        > "$root/plan.md"
    printf '+nothing relevant\n' > "$root/diff.txt"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && [ -z "$out" ]; then
        ok "no-single-word-tokens"
    else
        fail "no-single-word-tokens (rc=$rc, out=$out)"
    fi
    ;;

waived)
    plan_fixture \
        '| 3 | `FIXTURE_WAIVE_ME` should appear | CLI-executable | post-impl | `bin/test-it` |' \
        '| 4 | `FIXTURE_WAIVE_ME` should also appear | CLI-executable | post-impl | `bin/test-it` |' \
        > "$root/plan.md"
    printf '+unrelated line\n' > "$root/diff.txt"
    printf 'WAIVE-MATRIX-ROW: 3\n' > "$root/body.txt"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" "$root/body.txt" 2>/dev/null)
    rc=$?
    row3=$(printf '%s' "$out" | grep -c 'row 3' || true)
    row4=$(printf '%s' "$out" | grep -c 'row 4' || true)
    if [ "$rc" -eq 0 ] && [ "$row3" -eq 0 ] && [ "$row4" -eq 1 ]; then
        ok "waived"
    else
        fail "waived (rc=$rc, row3=$row3, row4=$row4, out=$out)"
    fi
    ;;

waived-exact)
    # Waiving 2.10 must NOT silence row 2.1 (exact match, not substring)
    plan_fixture \
        '| 2.1  | `FIXTURE_EXACT_A` fires | CLI-executable | post-impl | `bin/test-it` |' \
        '| 2.10 | `FIXTURE_EXACT_B` fires | CLI-executable | post-impl | `bin/test-it` |' \
        > "$root/plan.md"
    printf '+unrelated line\n' > "$root/diff.txt"
    printf 'WAIVE-MATRIX-ROW: 2.10\n' > "$root/body.txt"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" "$root/body.txt" 2>/dev/null)
    rc=$?
    row21=$(printf '%s' "$out" | grep -c 'row 2\.1 ' || true)
    row210=$(printf '%s' "$out" | grep -c 'row 2\.10' || true)
    if [ "$rc" -eq 0 ] && [ "$row21" -eq 1 ] && [ "$row210" -eq 0 ]; then
        ok "waived-exact"
    else
        fail "waived-exact (rc=$rc, row21=$row21, row210=$row210, out=$out)"
    fi
    ;;

fenced)
    # Row 8 inside a fence, row 9 outside — only 9 should fire
    {
        printf '| # | What to verify | Test type | Timing | Test file / location |\n'
        printf '|---|---|---|---|---|\n'
        printf '| 9 | `FIXTURE_FENCE_SYMBOL` outside fence | CLI-executable | post-impl | `bin/t` |\n'
        printf '\n'
        printf '```\n'
        printf '| # | What to verify | Test type | Timing | Test file / location |\n'
        printf '|---|---|---|---|---|\n'
        printf '| 8 | `FIXTURE_FENCE_SYMBOL` inside fence | CLI-executable | post-impl | `bin/t` |\n'
        printf '```\n'
    } > "$root/plan.md"
    printf '+unrelated\n' > "$root/diff.txt"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    row8=$(printf '%s' "$out" | grep -c 'row 8' || true)
    row9=$(printf '%s' "$out" | grep -c 'row 9' || true)
    if [ "$rc" -eq 0 ] && [ "$row8" -eq 0 ] && [ "$row9" -eq 1 ]; then
        ok "fenced"
    else
        fail "fenced (rc=$rc, row8=$row8, row9=$row9, out=$out)"
    fi
    ;;

preexisting-tree-token)
    plan_fixture '| 6 | `FIXTURE_OLD_SYMBOL` should still be here | CLI-executable | post-impl | `bin/test-it` |' \
        > "$root/plan.md"
    # Put the token in a tracked file in the root
    printf 'FIXTURE_OLD_SYMBOL=legacy\n' > "$root/existing.sh"
    git -C "$root" add existing.sh
    git -C "$root" -c user.email=t@t.com -c user.name=T commit -qm "add"
    # Diff that doesn't mention the token at all
    printf '+something_else\n' > "$root/diff.txt"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && [ -z "$out" ]; then
        ok "preexisting-tree-token"
    else
        fail "preexisting-tree-token (rc=$rc, out=$out)"
    fi
    ;;

context-line-token)
    plan_fixture '| 11 | `FIXTURE_CTX_SYMBOL` is checked | CLI-executable | post-impl | `bin/test-it` |' \
        > "$root/plan.md"
    # Token appears only on a context line (leading space), root lacks it
    printf ' FIXTURE_CTX_SYMBOL=old\n' > "$root/diff.txt"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && [ -z "$out" ]; then
        ok "context-line-token"
    else
        fail "context-line-token (rc=$rc, out=$out)"
    fi
    ;;

dup-guard-regression)
    plan_fixture '| 8 | `bin/plan-now` and `PLAN_NOW_DUP_CHECK` added | CLI-executable | post-impl | `bin/test-it` |' \
        > "$root/plan.md"
    # Diff modifies bin/plan-now (path appears in + lines) but NEVER adds PLAN_NOW_DUP_CHECK
    printf '+#!/bin/bash\n+# bin/plan-now: main script\n+echo running bin/plan-now\n' > "$root/diff.txt"
    err=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>&1 1>/dev/null)
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && printf '%s' "$out" | grep -qF 'UNREALISED-ASSERTION: row 8' \
        && printf '%s' "$err" | grep -qF 'PLAN_NOW_DUP_CHECK'; then
        ok "dup-guard-regression"
    else
        fail "dup-guard-regression (rc=$rc, out=$out, err=$err)"
    fi
    ;;

empty-env)
    # Build the absent-new-token fixture
    plan_fixture '| 7 | `FIXTURE_NEW_SYMBOL` verifies the gate | CLI-executable | post-impl | `bin/test-it` |' \
        > "$root/plan.md"
    printf '+some unrelated added line\n' > "$root/diff.txt"
    # Reference output from normal run
    ref=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    # Empty-env run (rely on cwd for tree root)
    got=$( (cd "$root" && env -i PATH=/usr/bin:/bin "$HELPER" plan.md diff.txt) 2>/dev/null)
    got_rc=$?
    if [ "$ref" = "$got" ] && [ "$got_rc" -eq 0 ]; then
        ok "empty-env"
    else
        fail "empty-env (rc=$got_rc, ref=$ref, got=$got)"
    fi
    ;;

usage)
    # Sub-test 1: missing plan path -> exit 2
    "$HELPER" /nonexistent/plan.md 2>/dev/null && rc1=0 || rc1=$?
    # Sub-test 2: valid plan but non-existent body file -> exit 2
    plan_fixture '| 1 | `FIXTURE_X` | CLI | post | `f` |' > "$root/plan.md"
    printf '+FIXTURE_X\n' > "$root/diff.txt"
    "$HELPER" "$root/plan.md" "$root/diff.txt" /nonexistent/body.md 2>/dev/null && rc2=0 || rc2=$?
    if [ "$rc1" -eq 2 ] && [ "$rc2" -eq 2 ]; then
        ok "usage"
    else
        fail "usage (rc1=$rc1, rc2=$rc2)"
    fi
    ;;

bad-flags)
    # Sub-test 1: unknown flag as $1 (not a readable file) -> exit 2
    "$HELPER" --bad-flag 2>/dev/null && rc1=0 || rc1=$?
    # Sub-test 2: valid plan, diff, but non-existent body file -> exit 2
    plan_fixture '| 1 | `FIXTURE_Y` | CLI | post | `f` |' > "$root/plan.md"
    printf '+FIXTURE_Y\n' > "$root/diff.txt"
    "$HELPER" "$root/plan.md" "$root/diff.txt" /nonexistent/body.txt 2>/dev/null && rc2=0 || rc2=$?
    if [ "$rc1" -eq 2 ] && [ "$rc2" -eq 2 ]; then
        ok "bad-flags"
    else
        fail "bad-flags (rc1=$rc1, rc2=$rc2)"
    fi
    ;;

empty-range)
    # An empty diff still reports an absent token as unrealised
    plan_fixture '| 12 | `FIXTURE_EMPTY_RANGE_SYM` is expected | CLI-executable | post-impl | `bin/t` |' \
        > "$root/plan.md"
    printf '' > "$root/diff.txt"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && printf '%s' "$out" | grep -qF 'UNREALISED-ASSERTION: row 12'; then
        ok "empty-range"
    else
        fail "empty-range (rc=$rc, out=$out)"
    fi
    ;;

multi-arg-call)
    plan_fixture '| 1 | method call: `assertCount(3)` present | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        > "$root/plan.md"
    out=$(printf '+        self::assertCount(3, $this->locate($source)[%s]);\n' "'tokens'" \
        | MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" - 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && [ -z "$out" ]; then
        ok "multi-arg-call"
    else
        fail "multi-arg-call (rc=$rc, out=$out)"
    fi
    ;;

multi-arg-call-mutation)
    plan_fixture '| 1 | method call: `assertCount(3)` present | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        > "$root/plan.md"
    out=$(printf '+        self::assertCount(99, $something);\n' \
        | MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" - 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && printf '%s\n' "$out" | grep -qF 'UNREALISED-ASSERTION: row 1'; then
        ok "multi-arg-call-mutation"
    else
        fail "multi-arg-call-mutation (rc=$rc, out=$out)"
    fi
    ;;

shell-var-default)
    plan_fixture '| 1 | shell var: `${MY_TEST_VAR}` set | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        > "$root/plan.md"
    out=$(printf '+  local x="${MY_TEST_VAR:-}" root\n' \
        | MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" - 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && [ -z "$out" ]; then
        ok "shell-var-default"
    else
        fail "shell-var-default (rc=$rc, out=$out)"
    fi
    ;;

shell-var-default-mutation)
    plan_fixture '| 1 | shell var: `${COMPLETELY_ABSENT_XYZ_VAR}` set | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        > "$root/plan.md"
    out=$(printf '+some unrelated added line\n' \
        | MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" - 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && printf '%s\n' "$out" | grep -qF 'UNREALISED-ASSERTION: row 1'; then
        ok "shell-var-default-mutation"
    else
        fail "shell-var-default-mutation (rc=$rc, out=$out)"
    fi
    ;;

# Mutation: restoring the prefix-glob arm flags this row.
glob-token-skipped)
    plan_fixture '| 1 | glob match: `test_digest_xyzzy_*` present | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        > "$root/plan.md"
    out=$(printf '+some unrelated added line\n' \
        | MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" - 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && [ -z "$out" ]; then
        ok "glob-token-skipped"
    else
        fail "glob-token-skipped (rc=$rc, out=$out)"
    fi
    ;;

glob-token-skipped-shapes)
    plan_fixture '| 1 | css glob: `tables/*.css` | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        '| 2 | home-dir glob: `~/claude-plans/**/*.md` | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        '| 3 | catch-all arm: `*)` | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        > "$root/plan.md"
    out=$(printf '+some unrelated added line\n' \
        | MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" - 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && [ -z "$out" ]; then
        ok "glob-token-skipped-shapes"
    else
        fail "glob-token-skipped-shapes (rc=$rc, out=$out)"
    fi
    ;;

glob-row-plain-token-still-flags)
    plan_fixture '| 1 | glob `tables/*.css` with `fixture_absent_xyzzy_tok` | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        > "$root/plan.md"
    out=$(printf '+some unrelated added line\n' \
        | MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" - 2>"$root/err.txt")
    rc=$?
    if [ "$rc" -eq 0 ] && grep -qF 'UNREALISED-ASSERTION: row 1' <<< "$out" \
        && grep -qF 'fixture_absent_xyzzy_tok' "$root/err.txt" \
        && ! grep -qF 'tables/' "$root/err.txt"; then
        ok "glob-row-plain-token-still-flags"
    else
        fail "glob-row-plain-token-still-flags (rc=$rc, out=$out)"
    fi
    ;;

deleted-file-exact-path)
    plan_fixture '| 1 | offloaded `ibl5/images/hof/jordan.jpg` file | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        > "$root/plan.md"
    deleted_diff_fixture ibl5/images/hof/jordan.jpg > "$root/diff.txt"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && [ -z "$out" ]; then
        ok "deleted-file-exact-path"
    else
        fail "deleted-file-exact-path (rc=$rc, out=$out)"
    fi
    ;;

deleted-file-basename)
    plan_fixture '| 1 | offloaded `jordan.jpg` file | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        > "$root/plan.md"
    deleted_diff_fixture ibl5/images/hof/jordan.jpg > "$root/diff.txt"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && [ -z "$out" ]; then
        ok "deleted-file-basename"
    else
        fail "deleted-file-basename (rc=$rc, out=$out)"
    fi
    ;;

# Mutation: a leading-prefix-only match (token must start the path) flags this row.
deleted-file-dir-component)
    plan_fixture '| 1 | offloaded `images/hof` photos | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        > "$root/plan.md"
    deleted_diff_fixture ibl5/images/hof/jordan.jpg > "$root/diff.txt"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && [ -z "$out" ]; then
        ok "deleted-file-dir-component"
    else
        fail "deleted-file-dir-component (rc=$rc, out=$out)"
    fi
    ;;

deleted-file-leading-dir)
    plan_fixture '| 1 | offloaded `ibl5/images` tree | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        > "$root/plan.md"
    deleted_diff_fixture ibl5/images/hof/jordan.jpg > "$root/diff.txt"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && [ -z "$out" ]; then
        ok "deleted-file-leading-dir"
    else
        fail "deleted-file-leading-dir (rc=$rc, out=$out)"
    fi
    ;;

# Mutation: a plain substring match clears these rows.
deleted-file-substring-not-aligned)
    plan_fixture '| 1 | partial `ages/hof` name | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        '| 2 | partial `jordan` name | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        '| 3 | partial `hof/jordan.jp` name | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        > "$root/plan.md"
    deleted_diff_fixture ibl5/images/hof/jordan.jpg > "$root/diff.txt"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && grep -qF 'UNREALISED-ASSERTION: row 1' <<< "$out" && grep -qF 'UNREALISED-ASSERTION: row 2' <<< "$out" && grep -qF 'UNREALISED-ASSERTION: row 3' <<< "$out"; then
        ok "deleted-file-substring-not-aligned"
    else
        fail "deleted-file-substring-not-aligned (rc=$rc, out=$out)"
    fi
    ;;

deleted-file-not-deleted)
    plan_fixture '| 1 | offloaded `ibl5/images/hof/jordan.jpg` file | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        > "$root/plan.md"
    p=ibl5/images/hof/jordan.jpg
    {
        printf 'diff --git a/%s b/%s\n' "$p" "$p"
        printf 'index 3b18e51..9a1f2c3 100644\n'
        printf -- '--- a/%s\n' "$p"
        printf '+++ b/%s\n' "$p"
        printf '@@ -1 +1 @@\n-old\n+new\n'
    } > "$root/diff.txt"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && grep -qF 'UNREALISED-ASSERTION: row 1' <<< "$out"; then
        ok "deleted-file-not-deleted"
    else
        fail "deleted-file-not-deleted (rc=$rc, out=$out)"
    fi
    ;;

deleted-file-space-path)
    plan_fixture '| 1 | offloaded `images/hof` photos | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        > "$root/plan.md"
    deleted_diff_fixture "ibl5/images/hof/michael jordan.jpg" > "$root/diff.txt"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && [ -z "$out" ]; then
        ok "deleted-file-space-path"
    else
        fail "deleted-file-space-path (rc=$rc, out=$out)"
    fi
    ;;

deleted-file-quoted-path-skipped)
    plan_fixture '| 1 | offloaded `images/hof` photos | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        > "$root/plan.md"
    {
        printf 'diff --git "a/ibl5/images/hof/j\\303\\266rdan.jpg" "b/ibl5/images/hof/j\\303\\266rdan.jpg"\n'
        printf 'deleted file mode 100644\n'
    } > "$root/diff.txt"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && grep -qF 'UNREALISED-ASSERTION: row 1' <<< "$out"; then
        ok "deleted-file-quoted-path-skipped"
    else
        fail "deleted-file-quoted-path-skipped (rc=$rc, out=$out)"
    fi
    ;;

# Canary: a deletion set that swallows unrelated tokens clears this row.
plain-missing-canary)
    plan_fixture '| 1 | offloaded `fixture_absent_xyzzy_tok` file | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        > "$root/plan.md"
    deleted_diff_fixture ibl5/images/hof/jordan.jpg > "$root/diff.txt"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && grep -qF 'UNREALISED-ASSERTION: row 1' <<< "$out"; then
        ok "plain-missing-canary"
    else
        fail "plain-missing-canary (rc=$rc, out=$out)"
    fi
    ;;

glob-only-row-silent)
    plan_fixture '| 1 | only `tables/*.css` and `*.md` here | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        > "$root/plan.md"
    out=$(printf '+some unrelated added line\n' \
        | MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" - 2>"$root/err.txt")
    rc=$?
    if [ "$rc" -eq 0 ] && [ -z "$out" ] && [ "$(wc -l < "$root/err.txt")" -eq 0 ]; then
        ok "glob-only-row-silent"
    else
        fail "glob-only-row-silent (rc=$rc, out=$out)"
    fi
    ;;

skip-equals-class4)
    # `name=value` is cut to `name`; the name realised in the diff clears the row.
    plan_fixture '| 1 | scenario: `current_tree=T2` | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        > "$root/plan.md"
    out=$(printf '+    run(current_tree="$T2")\n' \
        | MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" - 2>/dev/null)
    rc=$?
    # Mutation: a name found nowhere still flags.
    plan_fixture '| 2 | scenario: `fixture_absent_name=T2` | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        > "$root/plan2.md"
    out2=$(printf '+    run(current_tree="$T2")\n' \
        | MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan2.md" - 2>/dev/null)
    if [ "$rc" -eq 0 ] && [ -z "$out" ] && printf '%s\n' "$out2" | grep -qF 'UNREALISED-ASSERTION: row 2'; then
        ok "skip-equals-class4"
    else
        fail "skip-equals-class4 (rc=$rc, out=$out, out2=$out2)"
    fi
    ;;

skip-equals-class5)
    # `VAR=1` is cut to `VAR`; a monkeypatch of the same name realises it.
    plan_fixture '| 1 | env var: `REVIEW_OWED_TIMEOUT=1` | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        > "$root/plan.md"
    out=$(printf '+    monkeypatch.setattr(fidelity, "REVIEW_OWED_TIMEOUT", 1)\n' \
        | MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" - 2>/dev/null)
    rc=$?
    # Mutation: an env name found nowhere still flags.
    plan_fixture '| 2 | env var: `FIXTURE_ABSENT_TIMEOUT=1` | CLI-executable | post-impl | `bin/lib/plan-matrix-assertions` |' \
        > "$root/plan2.md"
    out2=$(printf '+    monkeypatch.setattr(fidelity, "REVIEW_OWED_TIMEOUT", 1)\n' \
        | MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan2.md" - 2>/dev/null)
    if [ "$rc" -eq 0 ] && [ -z "$out" ] && printf '%s\n' "$out2" | grep -qF 'UNREALISED-ASSERTION: row 2'; then
        ok "skip-equals-class5"
    else
        fail "skip-equals-class5 (rc=$rc, out=$out, out2=$out2)"
    fi
    ;;

tag-skips-row)
    # A well-formed tag on a CLI-executable row: no UNREALISED line, one ONE-TIME-CHECK line on stdout.
    plan_fixture '| 7 | `FIXTURE_ONE_SHOT_TOKEN` printed by the run (one-time-check: evidence is printed output at plan time) | CLI-executable | post-impl | `bin/run-it` |' \
        > "$root/plan.md"
    printf '+unrelated line\n' > "$root/diff.txt"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    unreal=$(printf '%s\n' "$out" | grep -c '^UNREALISED-ASSERTION:' || true)
    skipped=$(printf '%s\n' "$out" | grep -c '^ONE-TIME-CHECK: row 7 ' || true)
    if [ "$rc" -eq 0 ] && [ "$unreal" -eq 0 ] && [ "$skipped" -eq 1 ]; then
        ok "tag-skips-row"
    else
        fail "tag-skips-row (rc=$rc, unreal=$unreal, skipped=$skipped, out=$out)"
    fi
    ;;

tag-untagged-same-row-flags)
    # The identical row without the tag still flags: the skip is the tag's doing, nothing else.
    plan_fixture '| 7 | `FIXTURE_ONE_SHOT_TOKEN` printed by the run | CLI-executable | post-impl | `bin/run-it` |' \
        > "$root/plan.md"
    printf '+unrelated line\n' > "$root/diff.txt"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && printf '%s\n' "$out" | grep -qF 'UNREALISED-ASSERTION: row 7'; then
        ok "tag-untagged-same-row-flags"
    else
        fail "tag-untagged-same-row-flags (rc=$rc, out=$out)"
    fi
    ;;

tag-malformed-checked)
    # Fail-closed: a tag that is not the trailing text of the cell is ignored; row still flags;
    # the ignore notice goes to stderr with its own prefix.
    plan_fixture '| 7 | (one-time-check: evidence is printed output at plan time) `FIXTURE_ONE_SHOT_TOKEN` printed | CLI-executable | post-impl | `bin/run-it` |' \
        > "$root/plan.md"
    printf '+unrelated line\n' > "$root/diff.txt"
    err=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>&1 >/dev/null)
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    ignored=$(printf '%s\n' "$err" | grep -c '^ONE-TIME-CHECK-IGNORED: row 7 ' || true)
    if [ "$rc" -eq 0 ] && printf '%s\n' "$out" | grep -qF 'UNREALISED-ASSERTION: row 7' && [ "$ignored" -eq 1 ]; then
        ok "tag-malformed-checked"
    else
        fail "tag-malformed-checked (rc=$rc, ignored=$ignored, out=$out, err=$err)"
    fi
    ;;

tag-short-reason-checked)
    # Fail-closed: a reason under 15 chars is ignored; row still flags.
    plan_fixture '| 7 | `FIXTURE_ONE_SHOT_TOKEN` printed (one-time-check: too short) | CLI-executable | post-impl | `bin/run-it` |' \
        > "$root/plan.md"
    printf '+unrelated line\n' > "$root/diff.txt"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && printf '%s\n' "$out" | grep -qF 'UNREALISED-ASSERTION: row 7'; then
        ok "tag-short-reason-checked"
    else
        fail "tag-short-reason-checked (rc=$rc, out=$out)"
    fi
    ;;

tag-wrong-type-checked)
    # Fail-closed: a well-formed tag on a non-CLI-executable row is ignored; row still flags.
    plan_fixture '| 7 | `FIXTURE_ONE_SHOT_TOKEN` shown in the browser (one-time-check: evidence is printed output at plan time) | E2E | post-impl | `e2e/x.spec.ts` |' \
        > "$root/plan.md"
    printf '+unrelated line\n' > "$root/diff.txt"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    if [ "$rc" -eq 0 ] && printf '%s\n' "$out" | grep -qF 'UNREALISED-ASSERTION: row 7'; then
        ok "tag-wrong-type-checked"
    else
        fail "tag-wrong-type-checked (rc=$rc, out=$out)"
    fi
    ;;

tag-line-prefix)
    # The informational lines must never start with the prefix every caller greps for.
    plan_fixture \
        '| 7 | `FIXTURE_ONE_SHOT_TOKEN` printed (one-time-check: evidence is printed output at plan time) | CLI-executable | post-impl | `bin/run-it` |' \
        '| 8 | `FIXTURE_OTHER_TOKEN` printed (one-time-check: short) | CLI-executable | post-impl | `bin/run-it` |' \
        > "$root/plan.md"
    printf '+unrelated line\n' > "$root/diff.txt"
    all=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>&1)
    rc=$?
    unreal=$(printf '%s\n' "$all" | grep -c '^UNREALISED-ASSERTION:' || true)
    info=$(printf '%s\n' "$all" | grep -c '^ONE-TIME-CHECK' || true)
    if [ "$rc" -eq 0 ] && [ "$unreal" -eq 1 ] && [ "$info" -eq 2 ]; then
        ok "tag-line-prefix"
    else
        fail "tag-line-prefix (rc=$rc, unreal=$unreal, info=$info, all=$all)"
    fi
    ;;

replay-2578-tagged)
    # The motivating case: rows 12 and 14 tagged, same diff as the untagged replay, zero UNREALISED lines.
    replay_2578_fixture "$root" tagged
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    unreal=$(printf '%s\n' "$out" | grep -c '^UNREALISED-ASSERTION:' || true)
    skipped=$(printf '%s\n' "$out" | grep -c '^ONE-TIME-CHECK: row 1[24] ' || true)
    if [ "$rc" -eq 0 ] && [ "$unreal" -eq 0 ] && [ "$skipped" -eq 2 ]; then
        ok "replay-2578-tagged"
    else
        fail "replay-2578-tagged (rc=$rc, unreal=$unreal, skipped=$skipped, out=$out)"
    fi
    ;;

replay-2578-untagged)
    # Characterization: the #2578 matrix, untagged, flags rows 12 and 14 and nothing else.
    replay_2578_fixture "$root"
    out=$(MATRIX_ASSERT_ROOT="$root" "$HELPER" "$root/plan.md" "$root/diff.txt" 2>/dev/null)
    rc=$?
    total=$(printf '%s\n' "$out" | grep -c '^UNREALISED-ASSERTION:' || true)
    r12=$(printf '%s\n' "$out" | grep -c '^UNREALISED-ASSERTION: row 12 ' || true)
    r14=$(printf '%s\n' "$out" | grep -c '^UNREALISED-ASSERTION: row 14 ' || true)
    if [ "$rc" -eq 0 ] && [ "$total" -eq 2 ] && [ "$r12" -eq 1 ] && [ "$r14" -eq 1 ]; then
        ok "replay-2578-untagged"
    else
        fail "replay-2578-untagged (rc=$rc, total=$total, r12=$r12, r14=$r14, out=$out)"
    fi
    ;;

*)
    printf 'Unknown case: %s\n' "$case" >&2
    printf 'Valid cases: absent-new-token present-in-plus no-single-word-tokens waived waived-exact fenced preexisting-tree-token context-line-token dup-guard-regression empty-env usage bad-flags empty-range multi-arg-call multi-arg-call-mutation shell-var-default shell-var-default-mutation glob-token-skipped glob-token-skipped-shapes glob-row-plain-token-still-flags deleted-file-exact-path deleted-file-basename deleted-file-dir-component deleted-file-leading-dir deleted-file-substring-not-aligned deleted-file-not-deleted deleted-file-space-path deleted-file-quoted-path-skipped plain-missing-canary glob-only-row-silent skip-equals-class4 skip-equals-class5 replay-2578-untagged tag-skips-row tag-untagged-same-row-flags tag-malformed-checked tag-short-reason-checked tag-wrong-type-checked tag-line-prefix replay-2578-tagged step67-skipped-no-plan step67-unrealised step67-clean step67-uncommitted step67-unavailable step67-routing prefire-rule-staged-new-file-realised prefire-rule-missing-token-unrealised step67 prefire all\n' >&2
    exit 2
    ;;
esac

rm -rf "$root"
}

# --- dispatch ---

ARG="${1:-all}"

CASES="absent-new-token present-in-plus no-single-word-tokens waived waived-exact fenced preexisting-tree-token context-line-token dup-guard-regression empty-env usage bad-flags empty-range multi-arg-call multi-arg-call-mutation shell-var-default shell-var-default-mutation glob-token-skipped glob-token-skipped-shapes glob-row-plain-token-still-flags deleted-file-exact-path deleted-file-basename deleted-file-dir-component deleted-file-leading-dir deleted-file-substring-not-aligned deleted-file-not-deleted deleted-file-space-path deleted-file-quoted-path-skipped plain-missing-canary glob-only-row-silent skip-equals-class4 skip-equals-class5 replay-2578-untagged tag-skips-row tag-untagged-same-row-flags tag-malformed-checked tag-short-reason-checked tag-wrong-type-checked tag-line-prefix replay-2578-tagged step67-skipped-no-plan step67-unrealised step67-clean step67-uncommitted step67-unavailable step67-routing prefire-rule-staged-new-file-realised prefire-rule-missing-token-unrealised"

if [ "$ARG" = "all" ]; then
    for c in $CASES; do
        run_case "$c"
    done
else
    run_case "$ARG"
fi

if [ "$FAILED" -ne 0 ]; then
    exit 1
fi
