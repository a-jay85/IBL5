# ── agent_allowlist_is_wrapper_only ───────────────────────────────────────────
# The raw mysql client runs shell commands (system, \!), so the agent may run only
# bin/sim-recap-mysql. A bare "Write" rule matches any path, so it is gone too;
# acceptEdits keeps writes inside the temp workdir. --allowedTools is the last
# flag, so every argv line after it is an allow-list entry.
SRT_WRAPPER="$SCRIPT_DIR/sim-recap-mysql"
srt_reset; srt_claim42
srt_run
srt_allow="$(sed -n '/^--allowedTools$/,$p' "$STUB/claude.argv" | sed 1d)"
srt_expect_eq "agent_allowlist_is_wrapper_only" "Bash($SRT_WRAPPER:*)" "$srt_allow"
srt_log_lacks "$STUB" claude.argv "Bash(mysql:*)" "agent_allowlist_is_wrapper_only — no bare mysql rule"
srt_log_lacks "$STUB" claude.argv "Bash($STUB/mysql:*)" "agent_allowlist_is_wrapper_only — no absolute mysql rule"
srt_log_has "$STUB" claude.argv "acceptEdits" "agent_allowlist_is_wrapper_only — scratch-file redirects allowed"

# ── wrapper_refuses_client_commands ───────────────────────────────────────────
# bin/sim-recap-mysql against a stub client that records its argv. Refused input
# must exit 2 before the client starts. The real client's own block
# (--skip-system-command --binary-mode) was proved against a server in PR #3379.
cat > "$STUB/wrapclient" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$@" > "$STUB/wrap.argv"
SH
chmod +x "$STUB/wrapclient"
srt_wrap() { # <stdin-text> <args...>
    local in="$1"; shift
    rm -f "$STUB/wrap.argv"
    printf '%s' "$in" | SIM_RECAP_MYSQL_BIN="$STUB/wrapclient" SIM_RECAP_DB_HOST=h \
        SIM_RECAP_DB_PORT=1 SIM_RECAP_DB_USER=u SIM_RECAP_DB_NAME=ibldb \
        "$SRT_WRAPPER" "$@" > "$STUB/wrap.out" 2>&1
    SRT_RC=$?
}
srt_wrap_refused() { # <name> <stdin-text> <args...>
    local name="$1"; shift
    srt_wrap "$@"
    srt_expect_eq "$name — exit 2" 2 "$SRT_RC"
    srt_file_absent "$STUB/wrap.argv" "$name — client never started"
    srt_log_has "$STUB" wrap.out "refusing" "$name — says why"
}
rm -f "$STUB/pwned"
srt_wrap_refused "wrapper_refuses_bang"          "" -e '\! touch '"$STUB"'/pwned'
srt_wrap_refused "wrapper_refuses_system_e"      "" -e 'SELECT 1; system touch '"$STUB"'/pwned'
srt_wrap_refused "wrapper_refuses_system_stdin"  $'SELECT 1;\nSYSTEM touch '"$STUB"$'/pwned\n'
srt_wrap_refused "wrapper_refuses_tee"           "" -e 'tee /tmp/x; SELECT 1'
srt_wrap_refused "wrapper_refuses_tee_short"     "" -e $'SELECT 1;\n\\T /tmp/x'
srt_wrap_refused "wrapper_refuses_source_stdin"  $'source /etc/passwd\n'
srt_wrap_refused "wrapper_refuses_system_flag"   "" --system-command -e 'SELECT 1'
srt_wrap_refused "wrapper_refuses_defaults_file" "" --defaults-file=/tmp/x -e 'SELECT 1'
srt_wrap_refused "wrapper_refuses_positional"    "" -e 'SELECT 1' otherdb
srt_file_absent "$STUB/pwned" "wrapper_refuses_client_commands — no command ran"

# ── wrapper_runs_sql_with_fixed_flags ─────────────────────────────────────────
srt_wrap "" -N -e "SELECT name FROM ibl_plr WHERE name = 'D''Angelo'"
srt_expect_eq "wrapper_runs_sql_with_fixed_flags — exit 0" 0 "$SRT_RC"
srt_expect_eq "wrapper_runs_sql_with_fixed_flags — --no-defaults first" \
    "--no-defaults" "$(sed -n 1p "$STUB/wrap.argv")"
srt_log_has "$STUB" wrap.argv "--skip-system-command" "wrapper_runs_sql_with_fixed_flags — system off"
srt_log_has "$STUB" wrap.argv "--binary-mode" "wrapper_runs_sql_with_fixed_flags — client commands off"
srt_log_has "$STUB" wrap.argv "SELECT name FROM ibl_plr WHERE name = 'D''Angelo'" \
    "wrapper_runs_sql_with_fixed_flags — SQL passed through"
srt_expect_eq "wrapper_runs_sql_with_fixed_flags — database last" \
    "ibldb" "$(tail -n 1 "$STUB/wrap.argv")"
srt_wrap $'SELECT 1;\nSELECT 2;\n' -t
srt_expect_eq "wrapper_runs_stdin_sql — exit 0" 0 "$SRT_RC"
srt_log_has "$STUB" wrap.argv "SELECT 2;" "wrapper_runs_stdin_sql — stdin SQL passed with -e"

# A backslash command mid-line is not refused by the pre-check (it refuses only
# line/statement-start forms and a trailing \G). The client's --binary-mode is
# what blocks it, so the flag must be in argv. A backslash inside a string
# literal must also pass.
srt_wrap "" -e 'SELECT 1 \T /tmp/x'
srt_expect_eq "wrapper_passes_midline_backslash — exit 0" 0 "$SRT_RC"
srt_log_has "$STUB" wrap.argv 'SELECT 1 \T /tmp/x' "wrapper_passes_midline_backslash — SQL reaches the client"
srt_log_has "$STUB" wrap.argv "--binary-mode" "wrapper_passes_midline_backslash — client is what blocks it"
srt_wrap "" -e "SELECT 1 FROM t WHERE c LIKE 'x\\.%'"
srt_expect_eq "wrapper_passes_like_backslash_dot — exit 0" 0 "$SRT_RC"
srt_log_has "$STUB" wrap.argv 'LIKE '\''x\.%'\' "wrapper_passes_like_backslash_dot — SQL reaches argv with one backslash"
srt_log_lacks "$STUB" wrap.argv 'x\\.%' "wrapper_passes_like_backslash_dot — backslash not doubled"

