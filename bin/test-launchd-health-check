# ---------------------------------------------------------------------------
# B-series: bin/bug-pipeline-check verdicts routed through check_bug_pipeline
# ---------------------------------------------------------------------------

# bpc_set <rc> <line>... — script the stub checker's stdout and exit code
bpc_set() {
    local rc="$1"; shift
    printf '%s\n' "$@" > "$CASE/bpc.out"
    printf '%s\n' "$rc" > "$CASE/bpc-rc"
}
# count_fail <key> — FAIL lines for exactly <key> in $OUT
count_fail() { grep -cF -- "FAIL: $1: " <<< "$OUT"; }
# dm_blocks — DMs the fake-dm stub received
dm_blocks() { if [ -f "$CASE/dm.log" ]; then grep -c '^---$' "$CASE/dm.log"; else echo 0; fi; }
# eq <label> <want> <got> / has <label> <haystack> <needle> / lacks (same shape)
eq() { if [ "$2" = "$3" ]; then ok "$1"; else fail "$1" "want [$2] got [$3]"; fi; }
has() { if grep -qF -- "$3" <<< "$2"; then ok "$1"; else fail "$1" "missing [$3] in [$(head -c 300 <<< "$2")]"; fi; }
lacks() { if grep -qF -- "$3" <<< "$2"; then fail "$1" "unexpected [$3] in [$(head -c 300 <<< "$2")]"; else ok "$1"; fi; }

# B0: healthy stub is invoked and adds nothing
healthy_fixture B0
run_checker
eq "B0 stub invoked" yes "$([ -f "$CASE/bpc-ran" ] && echo yes || echo no)"
eq "B0 rc 0" 0 "$RC"
eq "B0 no bug-pipeline lines" 0 "$(grep -c 'bug-pipeline:' <<< "$OUT")"

