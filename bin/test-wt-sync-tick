#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-wt-sync-tick — regression harness for bin/wt-sync-tick and
# the --print-schedule path of bin/wt-sync-cron-setup.
#
# Fully self-contained: every git fixture is built under mktemp; stub
# binaries on PATH replace ioreg (idle reader) and lsof (in-use check).
# Never touches real worktrees.
#
# Run: bin/test-wt-sync-tick  (exit 0 = all pass, 1 = a case failed)

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TICK="$SCRIPT_DIR/wt-sync-tick"
CRON_SETUP="$SCRIPT_DIR/wt-sync-cron-setup"
TMP="$(mktemp -d)"
trap 'chmod -R u+w "$TMP" 2>/dev/null; rm -rf "$TMP" 2>/dev/null' EXIT

FAILED=0

pass()     { echo "ok: $1"; }
failcase() { echo "FAIL: $1"; FAILED=1; }

# assert_match <name> <ERE> <haystack>
assert_match() {
    if printf '%s\n' "$3" | grep -qE "$2"; then
        pass "$1"
    else
        failcase "$1 — expected to match: $2"
        printf '%s\n' "$3" | sed 's/^/    /'
    fi
}

# assert_absent <name> <ERE> <haystack>
assert_absent() {
    if printf '%s\n' "$3" | grep -qE "$2"; then
        failcase "$1 — expected NOT to match: $2"
        printf '%s\n' "$3" | sed 's/^/    /'
    else
        pass "$1"
    fi
}

# assert_eq <name> <expected> <actual>
assert_eq() {
    if [ "$2" = "$3" ]; then
        pass "$1"
    else
        failcase "$1 — expected '$2', got '$3'"
    fi
}

# ── Stub binaries ─────────────────────────────────────────────────────────────
# Place fake ioreg and lsof on PATH; each reads an env var for its output.
# ioreg additionally reaches the tick via the WT_SYNC_IOREG seam (the tick calls
# it by absolute path so a launchd PATH gap can never silently disable the gate).
# STUB_IOREG_LINE: what ioreg emits (default: idle 700s — above the 600s threshold).
# STUB_LSOF_LINE: what lsof -d cwd emits (default: empty — no process in any wt).
STUBBIN="$TMP/stubbin"
mkdir -p "$STUBBIN"

cat > "$STUBBIN/ioreg" <<'SH'
#!/bin/sh
echo "${STUB_IOREG_LINE:-HIDIdleTime = 700000000000}"
SH
chmod +x "$STUBBIN/ioreg"

cat > "$STUBBIN/lsof" <<'SH'
#!/bin/sh
echo "${STUB_LSOF_LINE:-}"
SH
chmod +x "$STUBBIN/lsof"

# ── run_tick <extra-env-assignments...> -- <args...> ─────────────────────────
# Sets OUT (stdout+stderr combined) and ST (exit status).
# Hardwires STUBBIN onto PATH, log+lock dirs under TMP, and clears the kill switch.
_TICK_LOG="$TMP/default-run/wt-sync.log"
_TICK_LOCKD="$TMP/default-run/lock"
mkdir -p "$_TICK_LOCKD" "$(dirname "$_TICK_LOG")"

# shellcheck disable=SC2329,SC2034
run_tick() {
    ST=0
    OUT="$(PATH="$STUBBIN:$PATH" \
           WT_SYNC_IOREG="$STUBBIN/ioreg" \
           WT_SYNC_LOG="$_TICK_LOG" \
           WT_SYNC_LOCK_DIR="$_TICK_LOCKD" \
           WT_SYNC_ENABLED=1 \
           "$TICK" "$@" 2>&1)" || ST=$?
}

run_only() {   # <wt-path> [extra args...] — sets ONLY_OUT, ONLY_ERR, ONLY_ST
    local wt="$1"; shift
    ONLY_ST=0
    ONLY_ERR="$TMP/only.err.$$"
    ONLY_OUT="$(PATH="$STUBBIN:$PATH" WT_SYNC_IOREG="$STUBBIN/ioreg" \
                WT_SYNC_LOG="$_TICK_LOG" WT_SYNC_LOCK_DIR="$_TICK_LOCKD" \
                WT_SYNC_ENABLED=1 \
                "$TICK" --only "$wt" "$@" 2>"$ONLY_ERR")" || ONLY_ST=$?
}

# ── Synthetic git environment factory ────────────────────────────────────────
# new_env — creates <TMP>/env.XXXX/{origin.git, main}; returns main path.
new_env() {
    local base
    base="$(mktemp -d "$TMP/env.XXXXXX")"
    git init -q --bare "$base/origin.git"
    git clone -q "$base/origin.git" "$base/main" 2>/dev/null
    git -C "$base/main" config user.email t@example.com
    git -C "$base/main" config user.name tester
    git -C "$base/main" config commit.gpgsign false
    printf 'init\n' > "$base/main/README.md"
    git -C "$base/main" add README.md
    git -C "$base/main" commit -qm init
    git -C "$base/main" branch -M master
    git -C "$base/main" push -q -u origin master
    # Resolve symlinks so the returned path matches what git worktree list
    # --porcelain returns (on macOS /var/folders is a symlink under /private).
    # Every path downstream (WT_SYNC_REPO_ROOT, stub lsof lines, worktree
    # subdirs) must be canonical for the in-use grep to find a match.
    (cd "$base/main" && pwd -P)
}

# _make_stale_copy <main> <name> <wt>
# Reproduces the post-pipeline stale copy. The worktree commits A,B and pushes
# them. Then origin/<name> is force-pushed to A',B': the same patches with new
# SHAs, as the squash/rebase pipeline leaves it. Local ends ahead=2 behind=2,
# and `git cherry origin/<name> HEAD` prints only '-' lines.
# Writes nothing to stdout (add_worktree's stdout is the returned path).
_make_stale_copy() {
    local main="$1" name="$2" wt="$3" i url clone a b
    printf '%s\n' "$name" > "$main/$name.txt"
    git -C "$main" add "$name.txt"
    git -C "$main" commit -qm "$name initial"
    git -C "$main" push -q origin "$name"
    git -C "$main" checkout -q master
    git -C "$main" worktree add -q "$wt" "$name"
    for i in 1 2; do
        printf 'work %s\n' "$i" > "$wt/work$i.txt"
        git -C "$wt" add "work$i.txt"
        git -C "$wt" -c user.email=t@example.com -c user.name=tester \
            -c commit.gpgsign=false commit -qm "work $i"
    done
    git -C "$wt" push -q origin "$name"
    url="$(git -C "$main" remote get-url origin)"
    clone="$(mktemp -d "$TMP/clone_stale.XXXXXX")"
    git clone -q "$url" "$clone" 2>/dev/null
    git -C "$clone" config user.email t@example.com
    git -C "$clone" config user.name tester
    git -C "$clone" config commit.gpgsign false
    git -C "$clone" checkout -q "$name"
    a="$(git -C "$clone" rev-parse HEAD~1)"; b="$(git -C "$clone" rev-parse HEAD)"
    git -C "$clone" reset -q --hard HEAD~2
    # A distinct committer forces new SHAs even within the same second.
    GIT_COMMITTER_NAME=pipeline-bot GIT_COMMITTER_EMAIL=bot@example.com \
        git -C "$clone" cherry-pick "$a" "$b" >/dev/null 2>&1
    git -C "$clone" push -q -f origin "$name" 2>/dev/null
    # refs/remotes are shared across worktrees, so this updates main's origin/<name>.
    git -C "$wt" fetch -q origin "$name" 2>/dev/null
}

# add_worktree <main> <name> [ahead|behind|current|diverged|stale-copy|stale-copy-plus-unique]
# Sets up a worktree branch in various states relative to origin.
add_worktree() {
    local main="$1" name="$2" state="${3:-current}"
    local wt="$main/worktrees/$name"

    git -C "$main" checkout -q -b "$name" master
    case "$state" in
        current)
            # Commit, push, create worktree — local == origin.
            printf '%s\n' "$name" > "$main/$name.txt"
            git -C "$main" add "$name.txt"
            git -C "$main" commit -qm "$name initial"
            git -C "$main" push -q origin "$name"
            git -C "$main" checkout -q master
            git -C "$main" worktree add -q "$wt" "$name"
            ;;
        ahead)
            # Commit to origin, create worktree, then add LOCAL commit not pushed.
            printf '%s\n' "$name" > "$main/$name.txt"
            git -C "$main" add "$name.txt"
            git -C "$main" commit -qm "$name initial"
            git -C "$main" push -q origin "$name"
            git -C "$main" checkout -q master
            git -C "$main" worktree add -q "$wt" "$name"
            # Add an unpushed commit to the worktree
            printf 'unpushed\n' > "$wt/unpushed.txt"
            git -C "$wt" add unpushed.txt
            git -C "$wt" -c user.email=t@example.com -c user.name=tester \
                -c commit.gpgsign=false commit -qm "unpushed local commit"
            ;;
        behind)
            # Commit, push, create worktree, then advance origin via a second clone.
            printf '%s\n' "$name" > "$main/$name.txt"
            git -C "$main" add "$name.txt"
            git -C "$main" commit -qm "$name initial"
            git -C "$main" push -q origin "$name"
            git -C "$main" checkout -q master
            git -C "$main" worktree add -q "$wt" "$name"
            # Second clone advances origin
            local orig_url; orig_url="$(git -C "$main" remote get-url origin)"
            local clone2; clone2="$(mktemp -d "$TMP/clone2.XXXXXX")"
            git clone -q "$orig_url" "$clone2" 2>/dev/null
            git -C "$clone2" config user.email t@example.com
            git -C "$clone2" config user.name tester
            git -C "$clone2" config commit.gpgsign false
            git -C "$clone2" checkout -q "$name"
            printf 'origin-advance\n' > "$clone2/origin-advance.txt"
            git -C "$clone2" add origin-advance.txt
            git -C "$clone2" commit -qm "origin advance"
            git -C "$clone2" push -q origin "$name"
            # Fetch so REPO_ROOT knows about the new origin commit
            git -C "$main" fetch -q origin
            ;;
        cannot-ff)
            # Create branch, push, add worktree, then advance origin AND add an
            # untracked file in the worktree that the origin commit would also add.
            # has_uncommitted_changes misses untracked files, so the dirty gate
            # passes — then merge --ff-only fails (working tree conflict).
            printf '%s\n' "$name" > "$main/$name.txt"
            git -C "$main" add "$name.txt"
            git -C "$main" commit -qm "$name initial"
            git -C "$main" push -q origin "$name"
            git -C "$main" checkout -q master
            git -C "$main" worktree add -q "$wt" "$name"
            # Advance origin with a commit that adds 'would-conflict.txt'
            local orig_url2; orig_url2="$(git -C "$main" remote get-url origin)"
            local clone3; clone3="$(mktemp -d "$TMP/clone3.XXXXXX")"
            git clone -q "$orig_url2" "$clone3" 2>/dev/null
            git -C "$clone3" config user.email t@example.com
            git -C "$clone3" config user.name tester
            git -C "$clone3" config commit.gpgsign false
            git -C "$clone3" checkout -q "$name"
            printf 'from-origin\n' > "$clone3/would-conflict.txt"
            git -C "$clone3" add would-conflict.txt
            git -C "$clone3" commit -qm "origin adds would-conflict.txt"
            git -C "$clone3" push -q origin "$name"
            git -C "$main" fetch -q origin
            # Place the conflicting file as UNTRACKED in the worktree
            printf 'from-local\n' > "$wt/would-conflict.txt"
            ;;
        behind-dirty-clean)
            # Behind by a commit to a.txt; local uncommitted edit to b.txt (non-overlapping).
            # git --ff-only succeeds; expected verdict SYNCED 1, b.txt edit preserved.
            printf '%s\n' "$name" > "$main/$name.txt"
            git -C "$main" add "$name.txt"
            git -C "$main" commit -qm "$name initial"
            git -C "$main" push -q origin "$name"
            git -C "$main" checkout -q master
            git -C "$main" worktree add -q "$wt" "$name"
            local orig_bdc; orig_bdc="$(git -C "$main" remote get-url origin)"
            local clone_bdc; clone_bdc="$(mktemp -d "$TMP/clone_bdc.XXXXXX")"
            git clone -q "$orig_bdc" "$clone_bdc" 2>/dev/null
            git -C "$clone_bdc" config user.email t@example.com
            git -C "$clone_bdc" config user.name tester
            git -C "$clone_bdc" config commit.gpgsign false
            git -C "$clone_bdc" checkout -q "$name"
            printf 'from-origin\n' > "$clone_bdc/a.txt"
            git -C "$clone_bdc" add a.txt
            git -C "$clone_bdc" commit -qm "origin adds a.txt"
            git -C "$clone_bdc" push -q origin "$name"
            git -C "$main" fetch -q origin
            # Local edit to b.txt (different file — non-overlapping)
            printf 'local-dirty\n' > "$wt/b.txt"
            ;;
        behind-dirty-overlap)
            # Behind by a commit to a.txt; local uncommitted edit to a.txt (overlapping).
            # git --ff-only refuses; expected verdict BEHIND-DIRTY.
            printf '%s\n' "$name" > "$main/$name.txt"
            git -C "$main" add "$name.txt"
            git -C "$main" commit -qm "$name initial"
            # Seed a.txt on origin
            printf 'base\n' > "$main/a.txt"
            git -C "$main" add a.txt
            git -C "$main" commit -qm "add a.txt"
            git -C "$main" push -q origin "$name"
            git -C "$main" checkout -q master
            git -C "$main" worktree add -q "$wt" "$name"
            local orig_bdo; orig_bdo="$(git -C "$main" remote get-url origin)"
            local clone_bdo; clone_bdo="$(mktemp -d "$TMP/clone_bdo.XXXXXX")"
            git clone -q "$orig_bdo" "$clone_bdo" 2>/dev/null
            git -C "$clone_bdo" config user.email t@example.com
            git -C "$clone_bdo" config user.name tester
            git -C "$clone_bdo" config commit.gpgsign false
            git -C "$clone_bdo" checkout -q "$name"
            printf 'from-origin\n' > "$clone_bdo/a.txt"
            git -C "$clone_bdo" add a.txt
            git -C "$clone_bdo" commit -qm "origin changes a.txt"
            git -C "$clone_bdo" push -q origin "$name"
            git -C "$main" fetch -q origin
            # Local edit to a.txt (same file — overlapping)
            printf 'local-dirty\n' > "$wt/a.txt"
            ;;
        behind-untracked-collide)
            # Behind by a commit that adds new.txt; untracked new.txt already present.
            # git --ff-only refuses; expected verdict BEHIND-DIRTY.
            printf '%s\n' "$name" > "$main/$name.txt"
            git -C "$main" add "$name.txt"
            git -C "$main" commit -qm "$name initial"
            git -C "$main" push -q origin "$name"
            git -C "$main" checkout -q master
            git -C "$main" worktree add -q "$wt" "$name"
            local orig_buc; orig_buc="$(git -C "$main" remote get-url origin)"
            local clone_buc; clone_buc="$(mktemp -d "$TMP/clone_buc.XXXXXX")"
            git clone -q "$orig_buc" "$clone_buc" 2>/dev/null
            git -C "$clone_buc" config user.email t@example.com
            git -C "$clone_buc" config user.name tester
            git -C "$clone_buc" config commit.gpgsign false
            git -C "$clone_buc" checkout -q "$name"
            printf 'from-origin\n' > "$clone_buc/new.txt"
            git -C "$clone_buc" add new.txt
            git -C "$clone_buc" commit -qm "origin adds new.txt"
            git -C "$clone_buc" push -q origin "$name"
            git -C "$main" fetch -q origin
            # Untracked new.txt already in the worktree
            printf 'local-untracked\n' > "$wt/new.txt"
            ;;
        stale)
            # Minimal stale copy: one commit on local and one patch-identical commit
            # pushed via a second clone, leaving ahead=1 behind=1 with no unique work.
            printf '%s\n' "$name" > "$main/$name.txt"
            git -C "$main" add "$name.txt"
            git -C "$main" commit -qm "$name initial"
            git -C "$main" push -q origin "$name"
            git -C "$main" checkout -q master
            git -C "$main" worktree add -q "$wt" "$name"
            printf 'stale\n' > "$wt/stale.txt"
            git -C "$wt" add stale.txt
            git -C "$wt" -c user.email=t@example.com -c user.name=tester \
                -c commit.gpgsign=false commit -qm "stale local"
            local orig_st; orig_st="$(git -C "$main" remote get-url origin)"
            local clone_st; clone_st="$(mktemp -d "$TMP/clone_st.XXXXXX")"
            git clone -q "$orig_st" "$clone_st" 2>/dev/null
            git -C "$clone_st" config user.email t@example.com
            git -C "$clone_st" config user.name tester
            git -C "$clone_st" config commit.gpgsign false
            git -C "$clone_st" checkout -q "$name"
            printf 'stale\n' > "$clone_st/stale.txt"
            git -C "$clone_st" add stale.txt
            # Different committer identity ensures distinct SHA from local commit
            # while keeping the patch-id (diff content) identical.
            GIT_COMMITTER_NAME=pipeline-bot GIT_COMMITTER_EMAIL=bot@example.com \
                git -C "$clone_st" commit -qm "stale local"
            git -C "$clone_st" push -q origin "$name"
            git -C "$main" fetch -q origin
            ;;
        stale-copy)
            _make_stale_copy "$main" "$name" "$wt"
            ;;
        stale-copy-plus-unique)
            # Stale copy plus one real commit C that origin lacks, so `git cherry` shows '+ C'.
            _make_stale_copy "$main" "$name" "$wt"
            printf 'unique\n' > "$wt/unique.txt"
            git -C "$wt" add unique.txt
            git -C "$wt" -c user.email=t@example.com -c user.name=tester \
                -c commit.gpgsign=false commit -qm "real unique commit"
            ;;
        diverged)
            # Both local and origin have new commits (non-conflicting files).
            # Clean tree; expected verdict MERGED.
            printf '%s\n' "$name" > "$main/$name.txt"
            git -C "$main" add "$name.txt"
            git -C "$main" commit -qm "$name initial"
            git -C "$main" push -q origin "$name"
            git -C "$main" checkout -q master
            git -C "$main" worktree add -q "$wt" "$name"
            # Local commit in the worktree (non-conflicting file)
            printf 'local-commit\n' > "$wt/local.txt"
            git -C "$wt" add local.txt
            git -C "$wt" -c user.email=t@example.com -c user.name=tester \
                -c commit.gpgsign=false commit -qm "local commit"
            # Advance origin with a non-conflicting commit
            local orig_div; orig_div="$(git -C "$main" remote get-url origin)"
            local clone_div; clone_div="$(mktemp -d "$TMP/clone_div.XXXXXX")"
            git clone -q "$orig_div" "$clone_div" 2>/dev/null
            git -C "$clone_div" config user.email t@example.com
            git -C "$clone_div" config user.name tester
            git -C "$clone_div" config commit.gpgsign false
            git -C "$clone_div" checkout -q "$name"
            printf 'origin-commit\n' > "$clone_div/origin.txt"
            git -C "$clone_div" add origin.txt
            git -C "$clone_div" commit -qm "origin commit"
            git -C "$clone_div" push -q origin "$name"
            git -C "$wt" fetch origin "$name" -q
            ;;
        diverged-conflict)
            # Both local and origin have new commits that touch the same file.
            # Clean tree; expected verdict DIVERGED-CONFLICT.
            printf '%s\n' "$name" > "$main/$name.txt"
            git -C "$main" add "$name.txt"
            git -C "$main" commit -qm "$name initial"
            git -C "$main" push -q origin "$name"
            git -C "$main" checkout -q master
            git -C "$main" worktree add -q "$wt" "$name"
            # Local commit touching conflict.txt
            printf 'local-version\n' > "$wt/conflict.txt"
            git -C "$wt" add conflict.txt
            git -C "$wt" -c user.email=t@example.com -c user.name=tester \
                -c commit.gpgsign=false commit -qm "local conflict.txt"
            # Advance origin with a conflicting commit on the same file
            local orig_dc; orig_dc="$(git -C "$main" remote get-url origin)"
            local clone_dc; clone_dc="$(mktemp -d "$TMP/clone_dc.XXXXXX")"
            git clone -q "$orig_dc" "$clone_dc" 2>/dev/null
            git -C "$clone_dc" config user.email t@example.com
            git -C "$clone_dc" config user.name tester
            git -C "$clone_dc" config commit.gpgsign false
            git -C "$clone_dc" checkout -q "$name"
            printf 'origin-version\n' > "$clone_dc/conflict.txt"
            git -C "$clone_dc" add conflict.txt
            git -C "$clone_dc" commit -qm "origin conflict.txt"
            git -C "$clone_dc" push -q origin "$name"
            git -C "$wt" fetch origin "$name" -q
            ;;
    esac
    echo "$wt"
}

# ── Helpers ───────────────────────────────────────────────────────────────────
fresh_log() { local f="$TMP/$1/wt-sync.log"; mkdir -p "$TMP/$1/lock"; echo "$f"; }
fresh_lockd() { echo "$TMP/$1/lock"; }

run_with_repo() {
    # run_with_repo <main> <log> <lockd> [extra-env=val ...] -- [args...]
    local main="$1" log="$2" lockd="$3"; shift 3
    local extra_env=()
    while [ $# -gt 0 ] && [ "$1" != "--" ]; do
        extra_env+=("$1"); shift
    done
    [ "${1:-}" = "--" ] && shift
    ST=0
    OUT="$(env PATH="$STUBBIN:$PATH" WT_SYNC_IOREG="$STUBBIN/ioreg" \
               WT_SYNC_REPO_ROOT="$main" \
               WT_SYNC_LOG="$log" \
               WT_SYNC_LOCK_DIR="$lockd" \
               WT_SYNC_ENABLED=1 \
               "${extra_env[@]+"${extra_env[@]}"}" \
               "$TICK" "$@" 2>&1)" || ST=$?
}

# ── Check 0: source-level safety grep ────────────────────────────────────────
# A future edit breaking the non-destructive contract should fail here first.
if grep -E '\bgit\b.*(push|rebase|reset\s+--hard)' "$TICK" | grep -v '# stale-copy-reset$' | grep -q .; then
    failcase "source-level: wt-sync-tick contains git push / rebase / reset --hard"
else
    pass "source-level: no git push/rebase/reset --hard in wt-sync-tick"
fi

# ── Check 0b: the stale-copy exemption covers exactly one, exact line ────────
# The marker lets the source greps skip the intentional reset. Pin it to one
# line whose target is origin's copy of the branch, so the marker can't be
# reused to smuggle in another destructive git call.
STALE_MARKED="$(grep -c '# stale-copy-reset$' "$TICK")"
assert_eq "source-level: exactly one stale-copy exempt line" "1" "$STALE_MARKED"
if grep '# stale-copy-reset$' "$TICK" | grep -qE '^[[:space:]]*git -C "\$wt" reset --hard --quiet "refs/remotes/origin/\$branch" '; then
    pass "source-level: stale-copy exempt line resets only to refs/remotes/origin/\$branch"
else
    failcase "source-level: stale-copy exempt line is not the expected reset-to-origin call"
fi

# ── Test 1: operator present → exit 0, nothing synced ────────────────────────
MAIN1="$(new_env)"
add_worktree "$MAIN1" "wt-present" behind >/dev/null
LOG1="$(fresh_log t1)"; LOCKD1="$(fresh_lockd t1)"
STUB_IOREG_LINE="HIDIdleTime = 50000000000"   # 50s — below 600s threshold
OUT1="$(env PATH="$STUBBIN:$PATH" WT_SYNC_IOREG="$STUBBIN/ioreg" WT_SYNC_REPO_ROOT="$MAIN1" WT_SYNC_LOG="$LOG1" \
           WT_SYNC_LOCK_DIR="$LOCKD1" WT_SYNC_ENABLED=1 STUB_IOREG_LINE="$STUB_IOREG_LINE" \
           "$TICK" 2>&1)" || true
unset STUB_IOREG_LINE
assert_match "operator-present: exit message" "operator present" "$OUT1"
# No log entry should have been written (tick exited before doing any work)
assert_absent "operator-present: log has no synced= entry" "synced=" "$(cat "$LOG1" 2>/dev/null)"
# Verify the worktree was NOT touched (HEAD still equals original, NOT origin)
HEAD_AFTER="$(git -C "$MAIN1/worktrees/wt-present" rev-parse HEAD 2>/dev/null || echo '')"
HEAD_ORIGIN="$(git -C "$MAIN1" rev-parse origin/wt-present 2>/dev/null || echo '')"
if [ "$HEAD_AFTER" != "$HEAD_ORIGIN" ]; then
    pass "operator-present: worktree not synced"
else
    failcase "operator-present: worktree was synced (should not have been)"
fi

# ── Test 2: non-numeric idle → treated as present, fail-closed ───────────────
MAIN2="$(new_env)"
add_worktree "$MAIN2" "wt-baddle" behind >/dev/null
LOG2="$(fresh_log t2)"; LOCKD2="$(fresh_lockd t2)"
OUT2="$(env PATH="$STUBBIN:$PATH" WT_SYNC_IOREG="$STUBBIN/ioreg" WT_SYNC_REPO_ROOT="$MAIN2" WT_SYNC_LOG="$LOG2" \
           WT_SYNC_LOCK_DIR="$LOCKD2" WT_SYNC_ENABLED=1 \
           STUB_IOREG_LINE="completely-unrelated-output" \
           "$TICK" 2>&1)" || true
assert_match "fail-closed: unreadable idle message" "unreadable|operator present|fail.closed" "$OUT2"
assert_absent "fail-closed: log has no synced= entry" "synced=" "$(cat "$LOG2" 2>/dev/null)"

# ── Test 3: --force bypasses the idle gate ────────────────────────────────────
# Stub ioreg would return "operator present" (below threshold), but --force skips it.
MAIN3="$(new_env)"
add_worktree "$MAIN3" "wt-force" current >/dev/null
LOG3="$(fresh_log t3)"; LOCKD3="$(fresh_lockd t3)"
OUT3="$(env PATH="$STUBBIN:$PATH" WT_SYNC_IOREG="$STUBBIN/ioreg" WT_SYNC_REPO_ROOT="$MAIN3" WT_SYNC_LOG="$LOG3" \
           WT_SYNC_LOCK_DIR="$LOCKD3" WT_SYNC_ENABLED=1 \
           STUB_IOREG_LINE="HIDIdleTime = 10000000000" \
           "$TICK" --force 2>&1)" || true
# Should reach the scanning step (not exit at idle gate)
assert_absent "force: does not emit 'operator present'" "operator present" "$OUT3"
assert_match  "force: reaches scanning" "Scanning worktrees|CURRENT|SYNCED|Done:" "$OUT3"
assert_match  "force: log written" "synced=" "$(cat "$LOG3" 2>/dev/null)"

# ── Test 4: worktree AHEAD → skipped, STRAGGLER line written ─────────────────
MAIN4="$(new_env)"
add_worktree "$MAIN4" "wt-fwd" ahead >/dev/null
LOG4="$(fresh_log t4)"; LOCKD4="$(fresh_lockd t4)"
HEAD_BEFORE="$(git -C "$MAIN4/worktrees/wt-fwd" rev-parse HEAD)"
run_with_repo "$MAIN4" "$LOG4" "$LOCKD4" -- --force
assert_eq "ahead: exit 0" "0" "$ST"
HEAD_AFTER="$(git -C "$MAIN4/worktrees/wt-fwd" rev-parse HEAD)"
assert_eq "ahead: HEAD not changed" "$HEAD_BEFORE" "$HEAD_AFTER"
assert_match "ahead: STRAGGLER in log" "STRAGGLER.*wt-fwd|STRAGGLER.*reason=ahead" \
    "$(cat "$LOG4" 2>/dev/null)"
assert_match "ahead: counted in summary" "ahead=" "$(cat "$LOG4" 2>/dev/null)"
assert_match "ahead: reset-stale=0" "reset-stale=0" "$(cat "$LOG4" 2>/dev/null)"

# ── Test 5: dirty worktree → skipped, working tree byte-identical after ───────
MAIN5="$(new_env)"
add_worktree "$MAIN5" "wt-dirty" current >/dev/null
# Dirty: stage a change
printf 'dirty\n' >> "$MAIN5/worktrees/wt-dirty/README.md"
git -C "$MAIN5/worktrees/wt-dirty" add README.md
LOG5="$(fresh_log t5)"; LOCKD5="$(fresh_lockd t5)"
CONTENT_BEFORE="$(cat "$MAIN5/worktrees/wt-dirty/README.md")"
