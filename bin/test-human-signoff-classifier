LAST_OUT=$(bash -c 'set -euo pipefail; source "$0"; fix="$1"; calls=0
    stub_refetch() { calls=$((calls + 1)); if [ -e "$fix/attempt-$calls.json" ]; then cp "$fix/attempt-$calls.json" "$1"; fi; }
    rc=0
    hs_eval_approval synchronize "" not-ui human-approved "$2" "$3" || true
    hs_await_record 3 0 stub_refetch synchronize "" not-ui human-approved "$2" "$3" "$4" || rc=$?
    echo "VERDICT=$HS_VERDICT REASON=$HS_DROP_REASON GATE_RED=$HS_GATE_RED CALLS=$calls"; exit "$rc"' \
    "$LIB" "$T/aw-w1b" "$A" "$T/aw-w1b/c.json" "$T/aw-w1b/e.json" 2>&1)
