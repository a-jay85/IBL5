# ── roster_fetched_into_workdir ───────────────────────────────────────────────
# simRecapContext.php is called over ssh; the result lands in roster-context.json.
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":42}\n' > "$STUB/resp.claim-next"
export SIM_RECAP_KEEP_WORKDIR=1
srt_run
WORKDIR_PATH=$(sed -n 's/.*\] workdir \(\/[^ ]*\) .*/\1/p' "$STUB/tick.out" | head -1)
if [ -z "$WORKDIR_PATH" ] || [ ! -f "$WORKDIR_PATH/roster-context.json" ]; then
    srt_fail "roster_fetched_into_workdir — roster-context.json not found in workdir"
else
    _rc_content=$(cat "$WORKDIR_PATH/roster-context.json")
    if printf '%s' "$_rc_content" | grep -q '"sim"'; then
        srt_ok "roster_fetched_into_workdir — roster-context.json contains sim key"
    else
        srt_fail "roster_fetched_into_workdir — roster-context.json malformed: $_rc_content"
    fi
    if grep -qF -- "--roster=$WORKDIR_PATH/roster-context.json" "$STUB/prompt.argv" 2>/dev/null; then
        srt_ok "roster_fetched_into_workdir — --roster=<workdir> passed to prompt"
    else
        srt_fail "roster_fetched_into_workdir — --roster not in prompt.argv: $(cat "$STUB/prompt.argv" 2>/dev/null)"
    fi
    rm -rf "$WORKDIR_PATH"
fi
unset SIM_RECAP_KEEP_WORKDIR

# ── context_fetch_failure_parks_transport ────────────────────────────────────
# The fact-sheet context is mandatory: if simRecapContext.php fails (exit 255),
# the sim parks transport before the prompt is built and before any agent spend.
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":42}\n' > "$STUB/resp.claim-next"
touch "$STUB/fail.simRecapContext"
srt_run
srt_expect_eq "context fetch failure — exit 0" 0 "$SRT_RC"
srt_log_has "$STUB" curl.log "/post-to-thread" \
    "degraded_path_discord_alert — alert fires on qctx failure"
srt_log_has "$STUB" ssh.log "park --sim=42 --host=mac --cause=transport" \
    "context_fetch_failure_parks_transport — parks transport"
srt_file_absent "$STUB/claude.sentinel" \
    "context fetch failure — claude never spawned"
srt_log_lacks "$STUB" ssh.log "storeSimRecap.php" \
    "context fetch failure — no storeSimRecap.php call"

# ── context_empty_games_parks_transport ──────────────────────────────────────
# Schedule scores not posted yet: a context with no games cannot carry a recap.
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":42}\n' > "$STUB/resp.claim-next"
printf '{"sim":42,"roster":{},"active_injuries":[],"sim_trades":[],"games":[],"standings":[]}\n' \
    > "$STUB/resp.simRecapContext"
srt_run
srt_expect_eq "context empty games — exit 0" 0 "$SRT_RC"
srt_log_has "$STUB" ssh.log "park --sim=42 --host=mac --cause=transport" \
    "context_empty_games_parks_transport — parks transport"
srt_file_absent "$STUB/claude.sentinel" \
    "context empty games — claude never spawned"
srt_log_lacks "$STUB" curl.log "/post-to-thread" \
    "context_empty_games_parks_transport — no ops alert for a timing state"

# ── context_null_ordinal_parks_transport ─────────────────────────────────────
# A game whose team box row is not imported yet has a null game_of_that_day;
# the tick never infers it, so it parks until the ordinal exists.
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":42}\n' > "$STUB/resp.claim-next"
printf '{"sim":42,"roster":{},"active_injuries":[],"sim_trades":[],"games":[{"key":"g1","season_year":2008,"game_date":"2026-07-23","box_id":null,"game_of_that_day":null,"visitor_teamid":1,"visitor_name":"Team A","visitor_score":101,"home_teamid":2,"home_name":"Team B","home_score":99,"visitor_top":[],"home_top":[],"injuries":[]}],"standings":[]}\n' \
    > "$STUB/resp.simRecapContext"
srt_run
srt_expect_eq "context null ordinal — exit 0" 0 "$SRT_RC"
srt_log_has "$STUB" ssh.log "park --sim=42 --host=mac --cause=transport" \
    "context_null_ordinal_parks_transport — parks transport"
srt_file_absent "$STUB/claude.sentinel" \
    "context null ordinal — claude never spawned"
srt_log_lacks "$STUB" curl.log "/post-to-thread" \
    "context_null_ordinal_parks_transport — no ops alert for a timing state"

# ── onset_alert_full_wording ─────────────────────────────────────────────────
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":42}\n' > "$STUB/resp.claim-next"
touch "$STUB/fail.simRecapContext"
srt_run
srt_log_has "$STUB" curl.log \
    "WARNING: sim 42 recap parked: simRecapContext.php fact-sheet fetch failed or returned no usable games. Further parked sims will NOT re-alert; expect a single RECOVERED message when it comes back." \
    "onset_alert_full_wording — exact onset string"

# ── recovery_alert_full_wording ──────────────────────────────────────────────
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":42}\n' > "$STUB/resp.claim-next"
printf '{"degraded_since":"2026-08-14T00:00:00","degraded_count":2}\n' > "$STUB/ops-alert.json"
srt_run
srt_log_has "$STUB" curl.log \
    "RECOVERED: simRecapContext.php fact sheet is answering again (sim 42). 2 sim recap(s) parked waiting for it since 2026-08-14T00:00:00" \
    "recovery_alert_full_wording — exact recovery string with seeded count and timestamp"

# ── dry_run_without_context_exits_1_without_agent ────────────────────────────
srt_reset
touch "$STUB/fail.simRecapContext"
srt_run --dry-run --sim=42
srt_expect_eq "dry_run_without_context_exits_1_without_agent — exit 1" 1 "$SRT_RC"
srt_log_has "$STUB" tick.out "fact-sheet context unavailable" \
    "dry run without context — logs the refusal"
srt_file_absent "$STUB/claude.sentinel" \
    "dry run without context — claude never spawned"

# ── phase_gate_stays_armed_when_recaps_disabled ───────────────────────────────
# When claim-next reports recaps_enabled:false and sim is null (nothing left to
# drain), the tick logs the reason and exits 0. It never unloads itself, so the
# first tick after the phase flips can resume work.
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":null,"phase":"Playoffs","recaps_enabled":false}\n' \
    > "$STUB/resp.claim-next"
srt_run
srt_expect_eq "phase_gate_stays_armed_when_recaps_disabled — exit 0" 0 "$SRT_RC"
srt_log_has "$STUB" tick.out "poller stays armed" \
    "phase_gate_stays_armed_when_recaps_disabled — logged reason"
srt_log_has "$STUB" tick.out "phase: Playoffs" \
    "phase_gate_stays_armed_when_recaps_disabled — logged phase"
srt_count "phase_gate_stays_armed_when_recaps_disabled — zero claude" 0 "$STUB/claude.log"
srt_file_absent "$STUB/launchctl.log" \
    "phase_gate_stays_armed_when_recaps_disabled — launchctl never called"

# ── phase_gate_resumes_when_recaps_enabled ────────────────────────────────────
# A disabled tick followed by an enabled tick with a pending sim: the second
# tick claims and generates normally, with no re-arm step in between.
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":null,"phase":"Preseason","recaps_enabled":false}\n' \
    > "$STUB/resp.claim-next"
srt_run
srt_log_has "$STUB" tick.out "poller stays armed" \
    "phase_gate_resumes_when_recaps_enabled — disabled tick stays armed"
printf '{"ok":true,"cmd":"claim-next","sim":"42","phase":"HEAT","recaps_enabled":true}\n' \
    > "$STUB/resp.claim-next"
srt_run
srt_expect_eq "phase_gate_resumes_when_recaps_enabled — enabled tick exit 0" 0 "$SRT_RC"
srt_log_has "$STUB" tick.out "claimed sim 42" \
    "phase_gate_resumes_when_recaps_enabled — enabled tick claims"
srt_count "phase_gate_resumes_when_recaps_enabled — one claude" 1 "$STUB/claude.log"
srt_file_absent "$STUB/launchctl.log" \
    "phase_gate_resumes_when_recaps_enabled — launchctl never called"

# ── phase_gate_never_unloads_when_recaps_enabled ─────────────────────────────────
# Regular Season (recaps_enabled:true) with no pending sim → cheap exit, no
# unload. The poller should stay running and wait for the next sim.
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":null,"phase":"Regular Season","recaps_enabled":true}\n' \
    > "$STUB/resp.claim-next"
srt_run
srt_expect_eq "phase_gate_never_unloads_when_recaps_enabled — exit 0" 0 "$SRT_RC"
srt_log_has "$STUB" tick.out "no pending sim — exiting cheap" \
    "phase_gate_never_unloads_when_recaps_enabled — cheap exit"
srt_file_absent "$STUB/launchctl.log" \
    "phase_gate_never_unloads_when_recaps_enabled — launchctl never called"

# ── phase_gate_never_unloads_in_dry_run ─────────────────────────────────────────
# --dry-run goes to dry_run(), which never calls claim-next or touches the phase
# gate. Even if we put a hostile resp.claim-next, launchctl must never be called.
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":null,"phase":"Playoffs","recaps_enabled":false}\n' \
    > "$STUB/resp.claim-next"
srt_run --dry-run --sim=42
srt_expect_eq "phase_gate_never_unloads_in_dry_run — exit 0" 0 "$SRT_RC"
srt_file_absent "$STUB/launchctl.log" \
    "phase_gate_never_unloads_in_dry_run — launchctl never called in dry-run mode"

# ── unclaimed_sim_aborts_before_phase_gate ──────────────────────────────────
# When --sim=N is supplied and the queue returns claimed:false, the
# unclaimable-sim guard exits 1 before the phase gate runs. The launchctl
# assertion confirms nothing unloads even though recaps_enabled:false.
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":null,"phase":"Playoffs","recaps_enabled":false}\n' \
    > "$STUB/resp.claim"
srt_run --sim=42
srt_expect_eq "unclaimed_sim_aborts_before_phase_gate — exit 1" 1 "$SRT_RC"
srt_file_absent "$STUB/launchctl.log" \
    "unclaimed_sim_aborts_before_phase_gate — launchctl not called"

# ── phase_gate_fail_safe_missing_field ────────────────────────────────────────
# If claim-next returns a response without the recaps_enabled field (e.g. the
# remote script was not yet deployed), jq evaluates `.recaps_enabled == false`
# as `null == false` → false, so jq_ok returns non-zero → plain idle exit.
# Fail-safe: absence of the field must be treated as "recaps enabled."
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":null}\n' > "$STUB/resp.claim-next"
srt_run
srt_expect_eq "phase_gate_fail_safe_missing_field — exit 0" 0 "$SRT_RC"
srt_log_has "$STUB" tick.out "no pending sim — exiting cheap" \
    "phase_gate_fail_safe_missing_field — cheap exit (not the disabled branch)"
srt_file_absent "$STUB/launchctl.log" \
    "phase_gate_fail_safe_missing_field — launchctl never called on missing field"

# ── degraded_path_alert_noop_when_no_thread_id ────────────────────────────────
# Alert must be a no-op (no curl call) when OPS_ALERT_THREAD_ID is unset.
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":42}\n' > "$STUB/resp.claim-next"
touch "$STUB/fail.simRecapContext"
export SIM_RECAP_OPS_ALERT_THREAD_ID=""
srt_run
srt_expect_eq "degraded_path_alert_noop_when_no_thread_id — exit 0" 0 "$SRT_RC"
srt_log_lacks "$STUB" curl.log "/post-to-thread" \
    "degraded_path_alert_noop_when_no_thread_id — no curl call when thread ID empty"

# ── degraded_path_alert_fault_tolerant ────────────────────────────────────────
# Tick must succeed (exit 0) even when curl fails.
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":42}\n' > "$STUB/resp.claim-next"
touch "$STUB/fail.simRecapContext"
export SIM_RECAP_OPS_ALERT_THREAD_ID="123"
cat > "$STUB/curl" <<'SH'
#!/usr/bin/env bash
echo "$*" >> "$STUB/curl.log"
exit 1
SH
chmod +x "$STUB/curl"
srt_run
srt_expect_eq "degraded_path_alert_fault_tolerant — exit 0" 0 "$SRT_RC"
# A missing fact sheet parks transport; the point of this case (a failing curl
# never fails the tick) is the exit 0 above.
srt_log_has "$STUB" ssh.log "park --sim=42 --host=mac --cause=transport" \
    "degraded_path_alert_fault_tolerant — tick completes and parks when curl fails"
# Restore working curl stub for any tests that follow.
cat > "$STUB/curl" <<'SH'
#!/usr/bin/env bash
echo "$*" >> "$STUB/curl.log"
case " $* " in *" -K - "*) cat >> "$STUB/curl.stdin" ;; esac
[ "${STUB_CURL_FAIL:-0}" = 1 ] && exit 7
exit 0
SH
chmod +x "$STUB/curl"

# ══ OPS-ALERT EDGE TRIGGERING ═════════════════════════════════════════════════
# The four (observation × state) cases, plus the two ways state can be wrong.
# None of these need a clock: the mechanism has no cooldown by design.

# ── ops_alert_second_degraded_sim_is_silent ───────────────────────────────────
# The defect this closes: a sustained outage alerted once per CLAIMED SIM for as
# long as it lasted. Two consecutive degraded ticks must yield exactly ONE post.
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":42}\n' > "$STUB/resp.claim-next"
touch "$STUB/fail.simRecapContext"
srt_run
srt_run
srt_expect_eq "ops_alert_second_degraded_sim_is_silent — one post across two degraded ticks" \
    1 "$(srt_matches curl.log '/post-to-thread')"
srt_log_has "$STUB" curl.log "fact-sheet fetch failed" \
    "ops_alert_second_degraded_sim_is_silent — the single post is the onset warning"

# ── ops_alert_recovery_ping_on_healthy_after_degraded ─────────────────────────
# The recovery ping is what makes the silence readable — without it "no ping"
# would be ambiguous between "still down" and "fixed", and a periodic reminder
# would be the only way to tell. Exactly two posts per outage, then state gone.
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":42}\n' > "$STUB/resp.claim-next"
touch "$STUB/fail.simRecapContext"
srt_run
rm -f "$STUB/fail.simRecapContext"
srt_run
srt_expect_eq "ops_alert_recovery_ping_on_healthy_after_degraded — exactly two posts" \
    2 "$(srt_matches curl.log '/post-to-thread')"
srt_log_has "$STUB" curl.log "RECOVERED" \
    "ops_alert_recovery_ping_on_healthy_after_degraded — recovery ping fired"
srt_file_absent "$STUB/ops-alert.json" \
    "ops_alert_recovery_ping_on_healthy_after_degraded — state cleared on recovery"

# ── ops_alert_silent_when_never_degraded ──────────────────────────────────────
# Healthy observation with no state: the fourth case, and the common one. A
# healthy tick must never post — otherwise every successful sim pings the thread.
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":42}\n' > "$STUB/resp.claim-next"
srt_run
srt_expect_eq "ops_alert_silent_when_never_degraded — zero posts" \
    0 "$(srt_matches curl.log '/post-to-thread')"

# ── ops_alert_dry_run_does_not_consume_edge ───────────────────────────────────
# A human's --dry-run against a degraded endpoint must not write state: doing so
# would consume the onset edge and silence the alert the next live tick owes us.
srt_reset
touch "$STUB/fail.simRecapContext"
srt_run --dry-run --sim=42
srt_expect_eq "ops_alert_dry_run_does_not_consume_edge — dry-run posts nothing" \
    0 "$(srt_matches curl.log '/post-to-thread')"
srt_file_absent "$STUB/ops-alert.json" \
    "ops_alert_dry_run_does_not_consume_edge — dry-run wrote no state"
# Clear the log so the next assertion measures the LIVE tick alone — otherwise a
# dry-run post would satisfy the count and the assertion would pass vacuously.
rm -f "$STUB/curl.log"
printf '{"ok":true,"cmd":"claim-next","sim":42}\n' > "$STUB/resp.claim-next"
srt_run
srt_expect_eq "ops_alert_dry_run_does_not_consume_edge — live onset still fires afterwards" \
    1 "$(srt_matches curl.log '/post-to-thread')"

# ── ops_alert_state_write_failure_is_loud ─────────────────────────────────────
# An unwritable state path silently restores the flood, so it must leave a
# breadcrumb. $STUB/mysql is a FILE, so mkdir -p of it as a directory fails.
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":42}\n' > "$STUB/resp.claim-next"
touch "$STUB/fail.simRecapContext"
export SIM_RECAP_OPS_ALERT_STATE="$STUB/mysql/ops-alert.json"
srt_run
srt_expect_eq "ops_alert_state_write_failure_is_loud — exit 0" 0 "$SRT_RC"
srt_log_has "$STUB" tick.out "repeat-alert suppression is OFF" \
    "ops_alert_state_write_failure_is_loud — warning logged"
srt_log_has "$STUB" curl.log "/post-to-thread" \
    "ops_alert_state_write_failure_is_loud — alert still fires despite the write failure"
export SIM_RECAP_OPS_ALERT_STATE="$STUB/ops-alert.json"

# ── ops_alert_corrupt_count_does_not_kill_the_tick ────────────────────────────
# A state file that is valid JSON but carries a STRING degraded_count used to
# reach $((count + 1)), which is an unbound variable under `set -u` — fatal to
# the whole tick, not just the alert. A corrupt state file may cost a
# suppression; it must never cost the recap.
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":42}\n' > "$STUB/resp.claim-next"
touch "$STUB/fail.simRecapContext"
printf '{"degraded_since":"2026-08-14T00:00:00","degraded_count":"lots"}\n' > "$STUB/ops-alert.json"
srt_run
srt_expect_eq "ops_alert_corrupt_count_does_not_kill_the_tick — exit 0" 0 "$SRT_RC"
srt_log_has "$STUB" ssh.log "park --sim=42 --host=mac --cause=transport" \
    "ops_alert_corrupt_count_does_not_kill_the_tick — the tick still reached its park"

# ══ DB-SYNC HOOK CASES ═══════════════════════════════════════════════════════

# ── DB-SYNC-1: fires once per stored sim ─────────────────────────────────────
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":"42"}' > "$STUB/resp.claim-next"
SIM_RECAP_DB_SYNC_BIN="$STUB/db-sync-now" SIM_RECAP_DB_SYNC_LOG="$STUB/db-sync.log" srt_run
srt_settle "$STUB_CALLS"
srt_count "DB-SYNC-1: fires once per stored sim" 1 "$STUB_CALLS"
srt_log_has "$STUB" tick.out "triggering local DB sync" "DB-SYNC-1: trigger logged"

# ── DB-SYNC-2: does NOT fire per poll when no sim queued ─────────────────────
srt_reset
SIM_RECAP_DB_SYNC_BIN="$STUB/db-sync-now" SIM_RECAP_DB_SYNC_LOG="$STUB/db-sync.log" srt_run
srt_count "DB-SYNC-2: no fire on no-sim" 0 "$STUB_CALLS"

# ── DB-SYNC-3: store failure fires nothing ────────────────────────────────────
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":"42"}' > "$STUB/resp.claim-next"
touch "$STUB/store-fails"
SIM_RECAP_DB_SYNC_BIN="$STUB/db-sync-now" SIM_RECAP_DB_SYNC_LOG="$STUB/db-sync.log" srt_run
srt_count "DB-SYNC-3: no fire on store-fail" 0 "$STUB_CALLS"
srt_log_lacks "$STUB" tick.out "triggering local DB sync" "DB-SYNC-3: no trigger logged"

# ── DB-SYNC-4: agent failure fires nothing ────────────────────────────────────
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":"42"}' > "$STUB/resp.claim-next"
touch "$STUB/agent-fails"
SIM_RECAP_DB_SYNC_BIN="$STUB/db-sync-now" SIM_RECAP_DB_SYNC_LOG="$STUB/db-sync.log" srt_run
srt_count "DB-SYNC-4: no fire on agent-fail" 0 "$STUB_CALLS"

# ── DB-SYNC-5: --dry-run fires nothing ────────────────────────────────────────
srt_reset
SIM_RECAP_DB_SYNC_BIN="$STUB/db-sync-now" SIM_RECAP_DB_SYNC_LOG="$STUB/db-sync.log" srt_run --dry-run --sim=42
srt_count "DB-SYNC-5: no fire on --dry-run" 0 "$STUB_CALLS"

# ── DB-SYNC-6: missing binary degrades quietly ────────────────────────────────
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":"42"}' > "$STUB/resp.claim-next"
SIM_RECAP_DB_SYNC_BIN="$STUB/does-not-exist" SIM_RECAP_DB_SYNC_LOG="$STUB/db-sync.log" srt_run
srt_expect_eq "DB-SYNC-6: tick exits 0 with missing binary" "0" "$SRT_RC"
srt_log_has "$STUB" tick.out "stored" "DB-SYNC-6: stored logged"
srt_log_lacks "$STUB" tick.out "triggering" "DB-SYNC-6: no sync line"

# ── DB-SYNC-7: non-blocking (stub sleeps 30s, tick must finish in <10s) ───────
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":"42"}' > "$STUB/resp.claim-next"
cat > "$STUB/db-sync-slow" <<'EOS'
#!/bin/bash
sleep 30
EOS
chmod +x "$STUB/db-sync-slow"
start_s=$SECONDS
SIM_RECAP_DB_SYNC_BIN="$STUB/db-sync-slow" SIM_RECAP_DB_SYNC_LOG="$STUB/db-sync.log" srt_run
elapsed=$(( SECONDS - start_s ))
if [ "$elapsed" -lt 10 ]; then srt_ok "DB-SYNC-7: non-blocking (${elapsed}s)"
else srt_fail "DB-SYNC-7: tick blocked (${elapsed}s >= 10s)"; fi
# Kill any lingering sleeper so the suite does not hand a 30s child to the caller.
pkill -f "$STUB/db-sync-slow" 2>/dev/null || true

# ── Host mode (Phase 1, sim-recap-github-actions) ──
HM_DISABLED='{"ok":true,"sim":null,"recaps_enabled":false,"phase":"Playoffs"}'

# 1. actions: stays armed
srt_reset
printf '%s\n' "$HM_DISABLED" > "$STUB/resp.claim-next"
SIM_RECAP_HOST_MODE=actions srt_run
srt_expect_eq "HM-1 exit 0" 0 "$SRT_RC"
srt_log_has "$STUB" tick.out "poller stays armed" "actions stays armed"
srt_file_absent "$STUB/launchctl.log" "HM-1 launchctl never called"

# 2. launchd: same line, no bootout (seam unset)
srt_reset
printf '%s\n' "$HM_DISABLED" > "$STUB/resp.claim-next"
( unset SIM_RECAP_HOST_MODE; srt_run; echo "$SRT_RC" > "$STUB/hm.rc" )
srt_expect_eq "HM-2 exit 0" 0 "$(cat "$STUB/hm.rc")"
srt_log_has "$STUB" tick.out "poller stays armed" "launchd stays armed (unset)"
srt_file_absent "$STUB/launchctl.log" "HM-2 launchctl never called"

# 3. empty seam = launchd
srt_reset
printf '%s\n' "$HM_DISABLED" > "$STUB/resp.claim-next"
SIM_RECAP_HOST_MODE="" srt_run
srt_log_has "$STUB" tick.out "poller stays armed" "empty seam stays armed"
srt_file_absent "$STUB/launchctl.log" "HM-3 launchctl never called"

# 4. bogus seam aborts before any ssh call (exit 1 since HOST_ID derivation)
srt_reset
SIM_RECAP_HOST_MODE=cron srt_run
srt_expect_eq "HM-4 exit 1" 1 "$SRT_RC"
srt_log_has "$STUB" tick.out "SIM_RECAP_HOST_MODE must be launchd or actions" "bogus seam aborts"
srt_file_absent "$STUB/ssh.log" "HM-4 no ssh call made"

# 5. actions db-sync skipped
srt_reset
printf '{"ok":true,"cmd":"claim-next","sim":"42"}' > "$STUB/resp.claim-next"
SIM_RECAP_HOST_MODE=actions SIM_RECAP_DB_SYNC_BIN="$STUB/db-sync-now" \
    SIM_RECAP_DB_SYNC_LOG="$STUB/db-sync.log" srt_run
srt_file_absent "$STUB_CALLS" "HM-5 db-sync-now never fired"
srt_log_has "$STUB" tick.out "db-sync skipped (host mode: actions)" "actions db-sync skipped"

# 6. actions empty tick spawns zero claude
srt_reset
SIM_RECAP_HOST_MODE=actions srt_run
srt_expect_eq "HM-6 exit 0" 0 "$SRT_RC"
srt_count "actions empty tick spawns zero claude" 0 "$STUB/claude.log"
srt_log_has "$STUB" tick.out "no pending sim — exiting cheap" "HM-6 exits cheap"

# 7. actions queue failure still errors
srt_reset
touch "$STUB/fail.claim-next"
SIM_RECAP_HOST_MODE=actions srt_run
srt_expect_eq "HM-7 exit 1" 1 "$SRT_RC"
srt_log_has "$STUB" tick.out "claim-next --host=actions did not complete" "actions queue failure still errors"
srt_count "HM-7 zero claude" 0 "$STUB/claude.log"

# 8. live --sim=N uses the claim verb
srt_reset
printf '{"ok":true,"cmd":"claim","sim":null}\n' > "$STUB/resp.claim"
srt_run --sim=7
srt_log_has "$STUB" ssh.log "claim --sim=7" "live --sim=N uses claim verb"
srt_log_lacks "$STUB" ssh.log "claim-next" "HM-8 no claim-next call"

# 9. live --sim=N on a sim that is not pending: claim echoes the sim with
# claimed:false; the tick must not generate (would overwrite + re-post)
srt_reset
printf '{"ok":true,"cmd":"claim","sim":7,"claimed":false}\n' > "$STUB/resp.claim"
srt_run --sim=7
srt_expect_eq "HM-9 unclaimed sim exits non-zero" 1 "$SRT_RC"
srt_log_has "$STUB" tick.out "sim 7 was not claimable" "HM-9 logs unclaimable sim"
srt_count "HM-9 zero claude" 0 "$STUB/claude.log"
srt_log_lacks "$STUB" ssh.log "storeSimRecap" "HM-9 no store call"

# 10. live --sim=N with claimed:true generates
srt_reset
printf '{"ok":true,"cmd":"claim","sim":7,"claimed":true}\n' > "$STUB/resp.claim"
srt_run --sim=7
srt_log_has "$STUB" tick.out "claimed sim 7" "HM-10 claimed sim proceeds"
srt_count "HM-10 one claude" 1 "$STUB/claude.log"

# ── Webhook ops transport (Phase 2) ──
WH_URL="https://discord.test/api/webhooks/1/SECRET-WEBHOOK-TOKEN"
WH_CLAIM='{"ok":true,"cmd":"claim-next","sim":42}'

# 1. exactly two pings across onset and recovery; 2-4 reuse this run's artifacts
srt_reset
export SIM_RECAP_OPS_WEBHOOK_URL="$WH_URL"
printf '%s\n' "$WH_CLAIM" > "$STUB/resp.claim-next"
touch "$STUB/fail.simRecapContext"
srt_run
cp "$STUB/tick.out" "$STUB/wh.out1"
srt_run
cat "$STUB/tick.out" >> "$STUB/wh.out1"
rm -f "$STUB/fail.simRecapContext"
srt_run
cat "$STUB/tick.out" >> "$STUB/wh.out1"
srt_count "webhook: exactly two pings across onset and recovery" 2 "$STUB/curl.log"
srt_expect_eq "webhook: exactly two pings — two url lines on stdin" \
    2 "$(srt_matches curl.stdin '^url = ')"
srt_log_has "$STUB" curl.log "fact-sheet fetch failed" "webhook: onset body is the fact-sheet warning"
srt_log_has "$STUB" curl.log "RECOVERED" "webhook: recovery body is RECOVERED"
srt_expect_eq "webhook: first ping is the onset" 1 \
    "$(sed -n 1p "$STUB/curl.log" | grep -c 'fact-sheet fetch failed')"
srt_expect_eq "webhook: second ping is the recovery" 1 \
    "$(sed -n 2p "$STUB/curl.log" | grep -c 'RECOVERED')"

# 2. URL never in argv
srt_log_lacks "$STUB" curl.log "discord.test" "webhook URL never in argv"
srt_expect_eq "webhook argv carries -K - on every call" \
    2 "$(srt_matches curl.log ' -K - ')"

# 3. URL never in tick output (all three ticks, stdout+stderr)
srt_log_lacks "$STUB" wh.out1 "SECRET-WEBHOOK-TOKEN" "webhook URL never in tick output"

# 4. thread id appended
srt_log_has "$STUB" curl.stdin \
    'url = "https://discord.test/api/webhooks/1/SECRET-WEBHOOK-TOKEN?thread_id=test-ops-thread"' \
    "webhook thread id appended"

# 5. existing query string uses &
srt_reset
export SIM_RECAP_OPS_WEBHOOK_URL="${WH_URL}?wait=true"
printf '%s\n' "$WH_CLAIM" > "$STUB/resp.claim-next"
touch "$STUB/fail.simRecapContext"
srt_run
srt_log_has "$STUB" curl.stdin "?wait=true&thread_id=test-ops-thread" \
    "webhook with existing query uses &"

# 6. curl failure never fails the tick
srt_reset
export SIM_RECAP_OPS_WEBHOOK_URL="$WH_URL"
printf '%s\n' "$WH_CLAIM" > "$STUB/resp.claim-next"
touch "$STUB/fail.simRecapContext"
STUB_CURL_FAIL=1 srt_run
srt_expect_eq "webhook curl failure never fails the tick — exit 0" 0 "$SRT_RC"
# A missing fact sheet parks transport instead of storing; exit 0 above is the
# property under test.
srt_log_has "$STUB" ssh.log "park --sim=42 --host=mac --cause=transport" "webhook curl failure never fails the tick — tick completes and parks"

# 7. unset and empty both use the bot path
srt_reset
unset SIM_RECAP_OPS_WEBHOOK_URL
printf '%s\n' "$WH_CLAIM" > "$STUB/resp.claim-next"
touch "$STUB/fail.simRecapContext"
srt_run
srt_log_has "$STUB" curl.log "post-to-thread" "webhook unset uses bot path"
srt_file_absent "$STUB/curl.stdin" "webhook unset leaves no curl stdin"
srt_reset
export SIM_RECAP_OPS_WEBHOOK_URL=""
printf '%s\n' "$WH_CLAIM" > "$STUB/resp.claim-next"
touch "$STUB/fail.simRecapContext"
srt_run
srt_log_has "$STUB" curl.log "post-to-thread" "webhook unset and empty both use bot path"
srt_file_absent "$STUB/curl.stdin" "webhook empty leaves no curl stdin"

# 8. webhook alone arms the alert; no thread id = webhook's own channel
srt_reset
export SIM_RECAP_OPS_WEBHOOK_URL="$WH_URL"
export SIM_RECAP_OPS_ALERT_THREAD_ID=""
printf '%s\n' "$WH_CLAIM" > "$STUB/resp.claim-next"
touch "$STUB/fail.simRecapContext"
srt_run
srt_expect_eq "webhook without thread id — exit 0" 0 "$SRT_RC"
srt_count "webhook without thread id still pings once" 1 "$STUB/curl.log"
srt_log_has "$STUB" curl.log "fact-sheet fetch failed" "webhook without thread id sends the onset body"
srt_log_has "$STUB" curl.stdin "url = \"$WH_URL\"" \
    "webhook without thread id posts to the bare webhook URL"
srt_log_lacks "$STUB" curl.stdin "thread_id" "webhook without thread id adds no thread_id"

# 9. existing query string, no thread id: URL left untouched
srt_reset
export SIM_RECAP_OPS_WEBHOOK_URL="${WH_URL}?wait=true"
export SIM_RECAP_OPS_ALERT_THREAD_ID=""
printf '%s\n' "$WH_CLAIM" > "$STUB/resp.claim-next"
touch "$STUB/fail.simRecapContext"
srt_run
srt_log_has "$STUB" curl.stdin "url = \"${WH_URL}?wait=true\"" \
    "webhook with query and no thread id keeps the URL as-is"
unset SIM_RECAP_OPS_WEBHOOK_URL

# ── Public-log hygiene (Phase 7) ──
# The workflow runs in a PUBLIC repo, so job logs are world-readable. These cases
# pin what the tick lets onto its own stdout/stderr (the only streams the runner
# captures); everything the agent, ssh and mysql emit must stay off them.

# srt_run_split [args…] — like srt_run but stdout and stderr stay separate.
# shellcheck disable=SC2120  # optional args, forwarded to the driver
srt_run_split() {
    "$SRT_DRIVER" "$@" > "$STUB/tick.stdout" 2> "$STUB/tick.stderr"
    SRT_RC=$?
}

# srt_lacks_both <token> <name> — token absent from stdout AND stderr.
srt_lacks_both() {
    srt_log_lacks "$STUB" tick.stdout "$1" "hygiene sub-check: $2 (stdout)"
    srt_log_lacks "$STUB" tick.stderr "$1" "hygiene sub-check: $2 (stderr)"
}

# srt_group_ok <name> <nfail-before> — summary line that stays honest: ok only
# when no sub-check since <nfail-before> failed.
srt_group_ok() {
    if [ "$H_FAIL" -eq "$2" ]; then srt_ok "$1"; else srt_fail "$1"; fi
}

srt_reset
SIM_RECAP_HOST_MODE=actions STUB_SENTINEL=1 SIM_RECAP_DB_PASSWORD=PW-SENTINEL-9f3 srt_run_split
srt_log_has "$STUB" tick.stderr "stored" "hygiene sub-check: fixture reaches the store path"

n0=$H_FAIL
# 1.
srt_lacks_both "AGENT-STDOUT-SENTINEL" "agent stdout"
srt_group_ok "actions: agent stdout never reaches job streams" "$n0"
# 2.
n0=$H_FAIL
srt_lacks_both "AGENT-STDERR-SENTINEL" "agent stderr"
srt_group_ok "actions: agent stderr never reaches job streams" "$n0"
# 3.
n0=$H_FAIL
srt_lacks_both "PAYLOAD-SENTINEL" "payload"
srt_lacks_both "ROSTER-SENTINEL" "roster"
srt_lacks_both "DB-OUTPUT-SENTINEL" "db output"
srt_group_ok "actions: payload, roster, db output never reach job streams" "$n0"
# 4.
n0=$H_FAIL
srt_lacks_both "PW-SENTINEL-9f3" "db password"
srt_log_lacks "$STUB" ssh.log "PW-SENTINEL-9f3" "hygiene sub-check: db password never in ssh argv"
srt_log_has "$STUB" claude.argv "--model" "hygiene sub-check: claude argv was recorded"
srt_log_lacks "$STUB" claude.argv "PW-SENTINEL-9f3" "hygiene sub-check: db password never in claude argv"
srt_group_ok "actions: db password never reaches job streams or ssh argv" "$n0"
# 5.
srt_expect_eq "actions: tick stdout is empty on the live path" 0 \
    "$(wc -c < "$STUB/tick.stdout" | tr -d '[:space:]')"
# 6.
n0=$H_FAIL
srt_log_lacks "$STUB" tick.stderr "PHASE-SENTINEL" "hygiene sub-check: phase absent when recaps are enabled"
srt_reset
printf '%s\n' '{"ok":true,"cmd":"claim-next","sim":null,"recaps_enabled":false,"phase":"PHASE-SENTINEL"}' \
    > "$STUB/resp.claim-next"
SIM_RECAP_HOST_MODE=actions STUB_SENTINEL=1 SIM_RECAP_DB_PASSWORD=PW-SENTINEL-9f3 srt_run_split
srt_log_has "$STUB" tick.stderr "PHASE-SENTINEL" "hygiene sub-check: phase echoed on the recaps-disabled fixture"
srt_log_lacks "$STUB" tick.stderr '"ok":true' "hygiene sub-check: raw claim JSON not echoed (stderr)"
srt_log_lacks "$STUB" tick.stdout '"ok":true' "hygiene sub-check: raw claim JSON not echoed (stdout)"
srt_group_ok "actions: phase value is the only claim field echoed" "$n0"

# ── Static hygiene over the workflow file ──
SRT_WORKFLOW="$SCRIPT_DIR/../.github/workflows/sim-recap.yml"

# srt_workflow_hygiene <file> — return 0 when the workflow cannot leak to a public log.
srt_workflow_hygiene() {
    local f="$1" rc=0 tok
    [ -f "$f" ] || return 1
    for tok in 'bin/sim-recap-tick $sim_arg >/dev/null' \
               'secrets not configured, skipping' \
               'cancel-in-progress: false' \
               'timeout-minutes: 40' \
               'SIM_RECAP_HOST_MODE: actions' \
               'id: secrets' \
               "if: github.event_name != 'pull_request'"; do
        grep -qF -- "$tok" "$f" || { echo "missing: $tok" >&2; rc=1; }
    done
    for tok in 'upload-artifact' 'agent.json' '--dry-run' 'set -x' \
               'ACTIONS_STEP_DEBUG' '*/5 * * * *' \
               'EVENT: ${{ github.event_name }}'; do
        grep -qF -- "$tok" "$f" && { echo "forbidden: $tok" >&2; rc=1; }
    done
    # permissions: must be immediately followed by contents: read
    awk '/^permissions:/ { getline nxt; if (nxt ~ /^[[:space:]]+contents: read[[:space:]]*$/) ok=1 }
         END { exit ok ? 0 : 1 }' "$f" || { echo "permissions: not followed by contents: read" >&2; rc=1; }
    # `secrets.` appears only on env:/with: mapping lines, never inside a run block
    # (a block is `run: |` up to the next line at an indent <= the run key's); and
    # no run block holds `cat `.
    awk '
        function indent(l) { match(l, /^[[:space:]]*/); return RLENGTH }
        {
            ind = indent($0)
            if (inrun && $0 !~ /^[[:space:]]*$/ && ind <= runind) inrun = 0
            if (inrun) {
                if ($0 ~ /secrets\./) { print "secrets. inside run block: " $0 > "/dev/stderr"; bad = 1 }
                if ($0 ~ /cat /)      { print "cat inside run block: " $0 > "/dev/stderr"; bad = 1 }
                next
            }
            if ($0 ~ /^[[:space:]]*(- )?run:/) {
                if ($0 ~ /secrets\./ || $0 ~ /run:.*cat /) { print "leak on run line: " $0 > "/dev/stderr"; bad = 1 }
                if ($0 ~ /run:[[:space:]]*[|>]/) { inrun = 1; runind = ind }
                next
            }
            if ($0 ~ /secrets\./ && $0 !~ /^[[:space:]]+[A-Za-z0-9_-]+: .*secrets\./) {
                print "secrets. outside a mapping line: " $0 > "/dev/stderr"; bad = 1
            }
        }
        END { exit bad ? 1 : 0 }
    ' "$f" || rc=1
    # Every step that maps `${{ secrets.X }}` is gated: the `id: secrets` step by
    # `if: github.event_name != 'pull_request'`, every other step by
    # `steps.secrets.outputs.configured == 'true'` (false whenever the first is
    # skipped). A step is a `- ` item at the indent of the first item under `steps:`.
    # Bracket expressions keep the regexes portable across BSD awk and mawk.
    awk '
        function indent(l) { match(l, /^[[:space:]]*/); return RLENGTH }
        function flush() {
            if (!started || !hassec) return
            if (!hasif) {
                print "secret-gating: step maps a secret with no if: guard: " name > "/dev/stderr"; bad = 1
            } else if (idsec && ifline !~ /github[.]event_name != .pull_request./) {
                print "secret-gating: Check secrets step is not gated off pull_request: " ifline > "/dev/stderr"; bad = 1
            } else if (!idsec && ifline !~ /steps[.]secrets[.]outputs[.]configured == .true./ \
                              && ifline !~ /github[.]event_name != .pull_request./) {
                print "secret-gating: step maps a secret behind an if: that is not the secrets gate: " name > "/dev/stderr"; bad = 1
            }
        }
        /^[[:space:]]*steps:[[:space:]]*$/ { insteps = 1; stepind = -1; next }
        insteps && /^[[:space:]]*- / {
            if (stepind < 0) stepind = indent($0)
            if (indent($0) == stepind) {
                flush(); started = 1; hassec = 0; hasif = 0; idsec = 0; ifline = ""; name = $0
            }
        }
        insteps && started {
            if ($0 ~ /[$][{][{][[:space:]]*secrets[.]/) hassec = 1
            if ($0 ~ /^[[:space:]]*if:/) { hasif = 1; ifline = $0 }
            if ($0 ~ /^[[:space:]]*id: secrets[[:space:]]*$/) idsec = 1
        }
        END { flush(); exit bad ? 1 : 0 }
    ' "$f" || rc=1
    [ "$(grep -c '^concurrency:' "$f")" = 1 ] || { echo "concurrency: block count != 1" >&2; rc=1; }
    grep -qE '^[[:space:]]+group: sim-recap[[:space:]]*$' "$f" \
        || { echo "concurrency group is not sim-recap" >&2; rc=1; }
    return "$rc"
}

if srt_workflow_hygiene "$SRT_WORKFLOW" 2>"$STUB/wf.err"; then
    srt_ok "workflow hygiene passes on the committed file"
else
    srt_fail "workflow hygiene passes on the committed file — $(tr '\n' ';' < "$STUB/wf.err")"
fi

# Leaking copies. (a) agent.json cat spliced INTO the Run tick step's run block;
# (b) a bare `cat` with no forbidden filename, to pin the run-block `cat ` rule
# on its own; (c) a secret on a run: line.
wf_leak='          cat "$RUNNER_TEMP"/sim-recap-*/agent.json'
awk -v leak="$wf_leak" '{ print } /bin\/sim-recap-tick \$sim_arg/ { print leak }' \
    "$SRT_WORKFLOW" > "$STUB/wf-agent.yml"
wf_leak='          cat /etc/hostname'
awk -v leak="$wf_leak" '{ print } /bin\/sim-recap-tick \$sim_arg/ { print leak }' \
    "$SRT_WORKFLOW" > "$STUB/wf-cat.yml"
cp "$SRT_WORKFLOW" "$STUB/wf-secret.yml"
printf '      - name: Leak\n        run: echo ${{ secrets.SIM_RECAP_DB_PASSWORD }}\n' >> "$STUB/wf-secret.yml"
# (d) the event guard deleted from the Check secrets step; (e) the guard pointed
# at the wrong event; (f) a trailing step that maps a secret with no if: at all.
grep -vF "if: github.event_name != 'pull_request'" "$SRT_WORKFLOW" > "$STUB/wf-ungated.yml"
sed "s/!= 'pull_request'/!= 'schedule'/" "$SRT_WORKFLOW" > "$STUB/wf-badgate.yml"
cp "$SRT_WORKFLOW" "$STUB/wf-stray.yml"
printf '      - name: Stray\n        env:\n          X: %s\n        run: echo ok\n' \
    '${{ secrets.HOST }}' >> "$STUB/wf-stray.yml"
wf_bad=0
for wf_copy in wf-agent wf-cat wf-secret wf-ungated wf-badgate wf-stray; do
    if srt_workflow_hygiene "$STUB/$wf_copy.yml" 2>/dev/null; then
        echo "  hygiene wrongly passed on $wf_copy.yml"
        wf_bad=$((wf_bad + 1))
    fi
done
srt_expect_eq "workflow hygiene fails on a leaking copy" 0 "$wf_bad"
# The three gating copies must fail on the gating check itself, not on a side effect.
wf_reason_bad=0
for wf_copy in wf-ungated wf-badgate wf-stray; do
    srt_workflow_hygiene "$STUB/$wf_copy.yml" 2>"$STUB/$wf_copy.err" || true
    grep -q '^secret-gating:' "$STUB/$wf_copy.err" || {
        echo "  $wf_copy.yml failed without a secret-gating: reason"
        wf_reason_bad=$((wf_reason_bad + 1))
    }
done
srt_expect_eq "gating copies fail with a secret-gating: reason" 0 "$wf_reason_bad"

# GUARD-OK: the event guard sits directly under `id: secrets` and no EVENT token
# remains anywhere in the file.
wf_guard_ok=0
wf_after_id=$(grep -A1 'id: secrets' "$SRT_WORKFLOW" || true)
grep -qF "if: github.event_name != 'pull_request'" <<< "$wf_after_id" || wf_guard_ok=1
grep -q 'EVENT' "$SRT_WORKFLOW" && wf_guard_ok=1
srt_expect_eq "GUARD-OK: if: sits under id: secrets and no EVENT token remains" 0 "$wf_guard_ok"

# SMOKE-DONE: the awk fires on a stray ungated step and stays quiet on the committed file.
wf_stray_hits=$(srt_workflow_hygiene "$STUB/wf-stray.yml" 2>&1 \
    | grep -c 'secret-gating: step maps a secret with no if' || true)
wf_committed_hits=$(srt_workflow_hygiene "$SRT_WORKFLOW" 2>&1 | grep -c 'secret-gating:' || true)
srt_expect_eq "SMOKE-DONE: stray ungated step yields one secret-gating: line" 1 "$wf_stray_hits"
srt_expect_eq "SMOKE-DONE: committed file yields zero secret-gating: lines" 0 "$wf_committed_hits"

# INSTALL-STEP: run the "Install mysql client, jq, claude CLI" run: block under
# bash -e (GitHub's default step shell) with stub sudo/curl in a hermetic env.
# Cases: curl fails (429), installer leaves no claude, installer works, curl argv.
srt_install_step_script() {  # <workflow> <out-script>; fails if fewer than 3 lines
    awk '
        function ind(s) { match(s, /^ */); return RLENGTH }
        /- name: Install mysql client, jq, claude CLI[[:space:]]*$/ { instep = 1; next }
        instep && !inrun && /^[[:space:]]*- name:/ { exit }
        instep && !inrun && /^[[:space:]]*run: \|[[:space:]]*$/ { inrun = 1; runind = ind($0); next }
        inrun {
            if ($0 ~ /^[[:space:]]*$/) { print ""; next }
            if (ind($0) <= runind) exit
            if (!bodyind) bodyind = ind($0)
            print substr($0, bodyind + 1)
        }
    ' "$1" > "$2"
    [ "$(grep -c . "$2" || true)" -ge 3 ]
}

SRT_INST_BIN="$STUB/inst-bin"
mkdir -p "$SRT_INST_BIN"
printf '#!/bin/sh\nexit 0\n' > "$SRT_INST_BIN/sudo"
cat > "$SRT_INST_BIN/curl" <<'SRT_CURL'
#!/bin/bash
printf '%s\n' "$@" > "$SRT_CURL_ARGV"
out=""
while [ $# -gt 0 ]; do
    if [ "$1" = "-o" ]; then out="$2"; shift; fi
    shift
done
case "$SRT_CURL_MODE" in
    fail) echo "curl: (22) The requested URL returned error: 429" >&2; exit 22 ;;
    noclaude) body='exit 0' ;;
    claude) body='mkdir -p "$HOME/.local/bin" && printf "#!/bin/sh\nexit 0\n" > "$HOME/.local/bin/claude" && chmod +x "$HOME/.local/bin/claude"' ;;
esac
if [ -n "$out" ]; then printf '%s\n' "$body" > "$out"; else printf '%s\n' "$body"; fi
SRT_CURL
chmod +x "$SRT_INST_BIN/sudo" "$SRT_INST_BIN/curl"

srt_install_run() {  # <script> <curl-mode> <case-dir>; returns the step's exit code
    local d="$3"
    rm -rf "$d"; mkdir -p "$d/home" "$d/tmp"; : > "$d/github_path"
    env -i PATH="$SRT_INST_BIN:/usr/bin:/bin" HOME="$d/home" RUNNER_TEMP="$d/tmp" \
        GITHUB_PATH="$d/github_path" SRT_CURL_MODE="$2" SRT_CURL_ARGV="$d/curl.argv" \
        bash -e "$1" > "$d/out" 2>&1
}

srt_install_argv_ok() {  # <case-dir>; checks the recorded curl argv
    local a
    a=" $(tr '\n' ' ' < "$1/curl.argv")"
    grep -qF -- ' --retry 4 ' <<< "$a" || { echo "argv lacks --retry 4" >&2; return 1; }
    grep -qF -- ' --retry-all-errors ' <<< "$a" || { echo "argv lacks --retry-all-errors" >&2; return 1; }
    grep -qF -- ' --retry-delay 10 ' <<< "$a" || { echo "argv lacks --retry-delay 10" >&2; return 1; }
    grep -qF -- " -o $1/tmp/claude-install.sh " <<< "$a" || { echo "argv lacks -o under RUNNER_TEMP" >&2; return 1; }
    [ "$(tail -n 1 "$1/curl.argv")" = "https://claude.ai/install.sh" ] \
        || { echo "last argv is not https://claude.ai/install.sh" >&2; return 1; }
}

if env -i PATH=/usr/bin:/bin bash -c 'command -v claude' >/dev/null 2>&1; then
    srt_fail "INSTALL-STEP precondition: claude already on /usr/bin:/bin, harness cannot see a missing install"
fi
if srt_install_step_script "$SRT_WORKFLOW" "$STUB/inst-step.sh"; then
    srt_ok "INSTALL-STEP: run block extracted from the committed workflow"
else
    srt_fail "INSTALL-STEP: run block not found in $SRT_WORKFLOW"
fi

srt_install_run "$STUB/inst-step.sh" fail "$STUB/inst-c1" && rc=0 || rc=$?
srt_expect_eq "INSTALL-CURL-FAIL: step exits 22 when curl fails" 22 "$rc"
srt_expect_eq "INSTALL-CURL-FAIL: GITHUB_PATH left empty" 0 "$(grep -c . "$STUB/inst-c1/github_path" || true)"

srt_install_run "$STUB/inst-step.sh" noclaude "$STUB/inst-c2" && rc=0 || rc=$?
srt_expect_eq "INSTALL-NO-CLAUDE: step exits 1 when installer leaves no claude" 1 "$rc"
if grep -qF '::error title=sim-recap::claude CLI not found on PATH after install' "$STUB/inst-c2/out"; then
    srt_ok "INSTALL-NO-CLAUDE: ::error line names the missing CLI"
else
    srt_fail "INSTALL-NO-CLAUDE: ::error line names the missing CLI"
fi
srt_expect_eq "INSTALL-NO-CLAUDE: GITHUB_PATH left empty" 0 "$(grep -c . "$STUB/inst-c2/github_path" || true)"

srt_install_run "$STUB/inst-step.sh" claude "$STUB/inst-c3" && rc=0 || rc=$?
srt_expect_eq "INSTALL-OK: step exits 0 when installer drops claude" 0 "$rc"
srt_expect_eq "INSTALL-OK: GITHUB_PATH holds HOME/.local/bin" \
    "$STUB/inst-c3/home/.local/bin" "$(< "$STUB/inst-c3/github_path")"
if srt_install_argv_ok "$STUB/inst-c3" 2>"$STUB/inst-argv.err"; then
    srt_ok "INSTALL-ARGV: curl gets --retry 4, --retry-all-errors, --retry-delay 10, -o RUNNER_TEMP, exact URL"
else
    srt_fail "INSTALL-ARGV: $(tr '\n' ';' < "$STUB/inst-argv.err")"
fi

# LEGACY-SEES-BUG: the pre-fix step shape must exit 0 on a failed curl, which
# proves this harness can see the original bug (run 39736079105).
printf '%s\n' '      - name: Install mysql client, jq, claude CLI' \
    "        if: steps.secrets.outputs.configured == 'true'" \
    '        run: |' \
    '          sudo apt-get update -qq && sudo apt-get install -y -qq mysql-client jq >/dev/null' \
    '          curl -fsSL https://claude.ai/install.sh | bash >/dev/null' \
    '          echo "$HOME/.local/bin" >> "$GITHUB_PATH"' > "$STUB/wf-inst-legacy.yml"
srt_install_step_script "$STUB/wf-inst-legacy.yml" "$STUB/inst-legacy.sh" || true
srt_install_run "$STUB/inst-legacy.sh" fail "$STUB/inst-legacy" && rc=0 || rc=$?
srt_expect_eq "LEGACY-SEES-BUG: pipe form exits 0 when curl fails" 0 "$rc"

# MUT-*: mutated copies of the committed workflow. Each must flip its case.
grep -vF 'command -v claude' "$SRT_WORKFLOW" > "$STUB/wf-inst-noguard.yml"
grep -vF 'export PATH="$HOME/.local/bin:$PATH"' "$SRT_WORKFLOW" > "$STUB/wf-inst-noexport.yml"
sed 's/ --retry-all-errors//' "$SRT_WORKFLOW" > "$STUB/wf-inst-noretryall.yml"
srt_install_step_script "$STUB/wf-inst-noguard.yml" "$STUB/inst-noguard.sh" || true
srt_install_run "$STUB/inst-noguard.sh" noclaude "$STUB/inst-mg" && rc=0 || rc=$?
srt_expect_eq "MUT-NOGUARD: dropping the command -v guard lets a missing claude exit 0" 0 "$rc"
srt_install_step_script "$STUB/wf-inst-noexport.yml" "$STUB/inst-noexport.sh" || true
srt_install_run "$STUB/inst-noexport.sh" claude "$STUB/inst-me" && rc=0 || rc=$?
srt_expect_eq "MUT-NOEXPORT: dropping the step PATH export fails the guard" 1 "$rc"
srt_install_step_script "$STUB/wf-inst-noretryall.yml" "$STUB/inst-noretryall.sh" || true
srt_install_run "$STUB/inst-noretryall.sh" claude "$STUB/inst-mr" || true
srt_install_argv_ok "$STUB/inst-mr" 2>/dev/null && rc=0 || rc=$?
srt_expect_eq "MUT-NORETRYALL: dropping --retry-all-errors fails the argv pin" 1 "$rc"

# PR-RUN-DONE: opt-in live check, run after the PR is open and its run has finished.
# Set SRT_CHECK_PR_RUN=<branch> to read that branch's latest pull_request run.
if [ -n "${SRT_CHECK_PR_RUN:-}" ]; then
    pr_run_id=$(gh run list --workflow sim-recap.yml --branch "$SRT_CHECK_PR_RUN" \
        --event pull_request --limit 1 --json databaseId --jq '.[0].databaseId')
    pr_run_conclusion=$(gh run view "$pr_run_id" --json conclusion --jq .conclusion)
    pr_run_step=$(gh run view "$pr_run_id" --json jobs \
        --jq '.jobs[0].steps[] | select(.name=="Check secrets") | .conclusion')
    pr_run_masked=$(gh run view "$pr_run_id" --log 2>/dev/null | grep -c 'T7: \*\*\*' || true)
    srt_expect_eq "PR-RUN-DONE: run concludes success" success "$pr_run_conclusion"
    srt_expect_eq "PR-RUN-DONE: Check secrets step is skipped" skipped "$pr_run_step"
    srt_expect_eq "PR-RUN-DONE: log holds no masked T7 line" 0 "$pr_run_masked"
fi

h_done
