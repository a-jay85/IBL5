    && grep -qF 'Poll logs:' "$CALLS_H" \
    && grep -qF 'launchd-stderr.log' "$CALLS_H" \
    && grep -qF 'Run log:' "$CALLS_H"; } \
  && ok "(IF-h) poll tail: failed launch does not suppress never-ran (alert=true, log paths in detail)" \
  || bad "(IF-h) poll tail: expected alert=true never-ran dispatch, got: $(cat "$CALLS_H" 2>/dev/null)"

