cf_check cf-digest-four-lines "$(cf_decide "$BCFD")" "FIDELITY_GATE=spawn" "FIDELITY_GATE_REASON=carry-forward-files-missing"
mk_cf_digest 5

# cf_materialise <word> <carry-tree> <head-tree> <verdict-file> — run the materialise block.
cf_materialise() {
    printf '{"number":%s}' "$CF_PR" > "$BASE_TMP/fixture.json"
    PATH="$SHIMD:$PATH" GH_PR_FIXTURE="$BASE_TMP/fixture.json" PRIOR_DIGEST="$CF_DIGEST" \
        CARRY_WORD="$1" CARRY_TREE="$2" HEAD_TREE="$3" FIDELITY_VERDICT_FILE="$4" bash -c "$BCFM" 2>&1
}

# --- materialise: happy path feeds the real parse block and condition (12)
CF_VF="$BASE_TMP/cf-vf.md"
rm -f "$CF_VF"
CF_FAILED_BEFORE=$FAILED
CF_MOUT="$(cf_materialise READY "$CF_T" "$CF_T" "$CF_VF")"
grep -qxF "CARRIED=$CF_VF" <<< "$CF_MOUT" || { echo "FAIL: cf-materialise-happy — no CARRIED= line: '$CF_MOUT'"; FAILED=1; }
[ "$(head -1 "$CF_VF" 2>/dev/null)" = "READY" ] || { echo "FAIL: cf-materialise-happy — line 1 is not READY"; FAILED=1; }
grep -qxF '## DIGEST' "$CF_VF" 2>/dev/null || { echo "FAIL: cf-materialise-happy — no ## DIGEST section"; FAILED=1; }
[ "$(tail -1 "$CF_VF" 2>/dev/null)" = "REVIEWED_TREE=$CF_T" ] || { echo "FAIL: cf-materialise-happy — last line is not REVIEWED_TREE=$CF_T"; FAILED=1; }
[ "$(sed -n '/^## DIGEST/,$p' "$CF_VF" 2>/dev/null | grep -c '^\*\*')" = 5 ] || { echo "FAIL: cf-materialise-happy — DIGEST section does not carry 5 label lines"; FAILED=1; }
printf '{"number":%s}' "$CF_PR" > "$BASE_TMP/fixture.json"
expect_fidelity "cf-materialise-happy: verdict parse reads READY" "READY" \
    "$(PATH="$SHIMD:$PATH" GH_PR_FIXTURE="$BASE_TMP/fixture.json" FIDELITY_VERDICT_FILE="$CF_VF" bash -c "$B55" 2>&1)"
[ "$FAILED" = "$CF_FAILED_BEFORE" ] && echo "ok: cf-materialise-happy"
rm -f "/tmp/post-plan-digest-lines-$CF_PR.txt"

# --- materialise refusals: STOP: on stdout, no verdict file written
CF_VF2="$BASE_TMP/cf-vf2.md"
rm -f "$CF_VF2"
CF_ROUT="$(cf_materialise "NOT READY" "$CF_T" "$CF_T" "$CF_VF2")"
if [ "${CF_ROUT:0:5}" = "STOP:" ] && [ ! -e "$CF_VF2" ]; then echo "ok: cf-materialise-refuses-not-ready"
else echo "FAIL: cf-materialise-refuses-not-ready — out='$CF_ROUT' file-exists=$([ -e "$CF_VF2" ] && echo yes || echo no)"; FAILED=1; fi

rm -f "$CF_VF2"
CF_ROUT="$(cf_materialise READY "$CF_T" "$(printf 'c%.0s' $(seq 40))" "$CF_VF2")"
if [ "${CF_ROUT:0:5}" = "STOP:" ] && [ ! -e "$CF_VF2" ]; then echo "ok: cf-materialise-refuses-tree"
else echo "FAIL: cf-materialise-refuses-tree — out='$CF_ROUT' file-exists=$([ -e "$CF_VF2" ] && echo yes || echo no)"; FAILED=1; fi

rm -f "$CF_VF2"
mk_cf_digest 4
CF_ROUT="$(cf_materialise READY "$CF_T" "$CF_T" "$CF_VF2")"
if [ "${CF_ROUT:0:5}" = "STOP:" ] && [ ! -e "$CF_VF2" ]; then echo "ok: cf-materialise-refuses-short-digest"
else echo "FAIL: cf-materialise-refuses-short-digest — out='$CF_ROUT' file-exists=$([ -e "$CF_VF2" ] && echo yes || echo no)"; FAILED=1; fi
mk_cf_digest 5
rm -f "/tmp/post-plan-digest-lines-$CF_PR.txt"

# --- mutation: widen the terminal-word case to admit the NOT READY line. cf-not-ready's own
# inputs must then print FIDELITY_GATE=skip, proving that case's assertion is live.
CF_MUT="$(printf '%s\n' "$BCFD" | sed 's/"READY"|"READY WITH NOTES") ;;/"READY"|"READY WITH NOTES"|"NOT READY — held for your final review") ;;/')"
mk_prior_body "NOT READY — held for your final review" "$CF_BANNER_DEFAULT" "$CF_PLANLINE" "$CF_T"
if [ "$CF_MUT" = "$(printf '%s\n' "$BCFD")" ]; then
    echo "FAIL: cf-mutation-case-widened — mutation inert: sed pattern did not apply to the decision block"; FAILED=1
elif grep -qxF "FIDELITY_GATE=skip" <<< "$(cf_decide "$CF_MUT")"; then
    echo "ok: cf-mutation-case-widened"
else
    echo "FAIL: cf-mutation-case-widened — mutation inert: widened block still printed spawn"; FAILED=1
fi
fi

# --- Phase 5.5 stale-verdict clear (verdict 1 and -2): structural + behavioural cases
# PR 999999 keeps the default /tmp path clear of any live PR's verdict file.
SV_PR=999999
SV_FIX="$BASE_TMP/sv-fixture.json"
printf '{"number":%s}' "$SV_PR" > "$SV_FIX"
SV_STALE="$(printf 'READY WITH NOTES\n\n## DIGEST\n**Why:** stale prior run\n')"
SV_VF1="$BASE_TMP/sv-vf1.md"
SV_VF2="$BASE_TMP/sv-vf2.md"
SV_DEF1="/tmp/post-plan-fidelity-verdict-$SV_PR.md"
SV_DEF2="/tmp/post-plan-fidelity-verdict-$SV_PR-2.md"

# sv_run <block> [vf1] [vf2] — run a clear block under the gh shim. An empty vf
# argument leaves that override unset so the block's PR-keyed default applies.
sv_run() {
    local blk="$1" vf1="${2:-}" vf2="${3:-}"
    (
        unset FIDELITY_VERDICT_FILE FIDELITY_VERDICT_FILE_2
        [ -n "$vf1" ] && export FIDELITY_VERDICT_FILE="$vf1"
        [ -n "$vf2" ] && export FIDELITY_VERDICT_FILE_2="$vf2"
        PATH="$SHIMD:$PATH" GH_PR_FIXTURE="$SV_FIX" bash -c "$blk" 2>&1
    )
}

# sv1-stale-parses-without-clear (characterization): the stale fixture is a
# verdict the real Step 3 parse block accepts. This is the bug: without a clear,
# a prior run's file passes as this run's word. It also proves the later
# "missing" assertion is earned by the clear block and not by a broken fixture.
printf '%s\n' "$SV_STALE" > "$SV_VF1"
expect_fidelity "sv1-stale-parses-without-clear: stale file parses as READY WITH NOTES" "READY WITH NOTES" \
    "$(PATH="$SHIMD:$PATH" GH_PR_FIXTURE="$SV_FIX" FIDELITY_VERDICT_FILE="$SV_VF1" bash -c "$B55" 2>&1)"
rm -f "$SV_VF1"

# sv1_struct <skill-file> — prints "ok" when the verdict-1 clear marker is a unique
# whole line, sits below the "## Step 2 " heading and above the first reviewer
# spawn after that heading, and no rm -f command line naming a verdict path sits
# above Step 2 (Steps 1, 1b, 1c must keep the carried verdict). Else prints why.
sv1_struct() {
    local f="$1" n s2 fence spawn early
    n="$(grep -cxF '# phase 5.5 clear stale verdict 1' "$f")"
    [ "$n" = 1 ] || { echo "verdict-1 marker count is $n, want 1"; return; }
    s2="$(grep -n '^## Step 2 ' "$f" | head -1 | cut -d: -f1)"
    fence="$(grep -nxF '# phase 5.5 clear stale verdict 1' "$f" | cut -d: -f1)"
    spawn="$(awk -v s="${s2:-0}" 'NR>s && /subagent_type: "pr-ready-phase6"/ && !p {print NR; p=1}' "$f")"
    early="$(awk -v s="${s2:-0}" 'NR<s && /^[[:space:]]*rm -f/ && /(FIDELITY_VERDICT_FILE|fidelity-verdict)/ {c++} END {print c+0}' "$f")"
    if [ -z "$s2" ] || [ -z "$spawn" ]; then echo "anchor missing (step2=$s2 spawn=$spawn)"
    elif [ "$fence" -le "$s2" ] || [ "$fence" -ge "$spawn" ]; then echo "fence $fence not between step2 $s2 and spawn $spawn"
    elif [ "$early" != 0 ]; then echo "$early verdict rm -f line(s) above ## Step 2"
    else echo ok; fi
}

SV1S="$(sv1_struct "$P55_SKILL")"
if [ "$SV1S" = ok ]; then echo "ok: sv1-struct"; else echo "FAIL: sv1-struct — $SV1S"; FAILED=1; fi

BSV1="$(extract_block '# phase 5.5 clear stale verdict 1' "$P55_SKILL")"
if [ -n "$BSV1" ] && [ "$(grep -c '^rm -f' <<< "$BSV1")" = 1 ]; then echo "ok: sv1-extract"
else echo "FAIL: sv1-extract — clear block missing or not exactly one rm -f line"; FAILED=1; fi

# sv1-clears-stale: stale non-empty verdict 1 is gone after the block, and the
# real Step 3 parse block then reports missing.
printf '%s\n' "$SV_STALE" > "$SV_VF1"
sv_run "$BSV1" "$SV_VF1" "$SV_VF2" >/dev/null
if [ ! -e "$SV_VF1" ]; then echo "ok: sv1-clears-stale"
else echo "FAIL: sv1-clears-stale — stale verdict 1 survived the clear block"; FAILED=1; fi
expect_fidelity "sv1-clears-stale: parse after clear reads missing" "missing" \
    "$(PATH="$SHIMD:$PATH" GH_PR_FIXTURE="$SV_FIX" FIDELITY_VERDICT_FILE="$SV_VF1" bash -c "$B55" 2>&1)"

# sv1-absent-ok: the block exits 0 when there is nothing to clear.
rm -f "$SV_VF1"
sv_run "$BSV1" "$SV_VF1" "$SV_VF2" >/dev/null; SV_RC=$?
if [ "$SV_RC" = 0 ]; then echo "ok: sv1-absent-ok"
else echo "FAIL: sv1-absent-ok — exit $SV_RC on an absent verdict file"; FAILED=1; fi

# sv1-default-path-pr-keyed: with no override the block removes the PR-keyed
# /tmp path, which is the path Step 2's reviewer writes and Step 3 reads.
printf '%s\n' "$SV_STALE" > "$SV_DEF1"
sv_run "$BSV1" "" "" >/dev/null
if [ ! -e "$SV_DEF1" ]; then echo "ok: sv1-default-path-pr-keyed"
else echo "FAIL: sv1-default-path-pr-keyed — $SV_DEF1 survived"; FAILED=1; fi
rm -f "$SV_DEF1"

# --- sv1 mutations: each must turn its target case red. An unchanged copy is inert.
SV_M="$BASE_TMP/sv-mut.md"

# rm line deleted from the include copy: the stale file must survive.
sed '/^rm -f "\$FIDELITY_VERDICT_FILE"$/d' "$P55_SKILL" > "$SV_M"
if cmp -s "$SV_M" "$P55_SKILL"; then echo "FAIL: sv1-mutation-rm-deleted — mutation inert: sed did not apply"; FAILED=1
else
    printf '%s\n' "$SV_STALE" > "$SV_VF1"
    sv_run "$(extract_block '# phase 5.5 clear stale verdict 1' "$SV_M")" "$SV_VF1" "$SV_VF2" >/dev/null
    if [ -e "$SV_VF1" ]; then echo "ok: sv1-mutation-rm-deleted"
    else echo "FAIL: sv1-mutation-rm-deleted — verdict 1 vanished with the rm line gone"; FAILED=1; fi
    rm -f "$SV_VF1"
fi

# PID-keyed path: the PR-keyed default file must survive.
SV_MB="$(sed 's/post-plan-fidelity-verdict-\$PR_NUM\.md/post-plan-fidelity-verdict-$$.md/' <<< "$BSV1")"
if [ "$SV_MB" = "$BSV1" ]; then echo "FAIL: sv1-mutation-pid-keyed — mutation inert: sed did not apply"; FAILED=1
else
    printf '%s\n' "$SV_STALE" > "$SV_DEF1"
    sv_run "$SV_MB" "" "" >/dev/null
    if [ -e "$SV_DEF1" ]; then echo "ok: sv1-mutation-pid-keyed"
    else echo "FAIL: sv1-mutation-pid-keyed — PR-keyed file removed by a PID-keyed block"; FAILED=1; fi
    rm -f "$SV_DEF1"
fi

# rm injected into Step 1c's carry-forward block: sv1_struct must reject it.
awk '{print} /^# phase 5\.5 carry-forward materialise$/ {print "rm -f \"$FIDELITY_VERDICT_FILE\""}' "$P55_SKILL" > "$SV_M"
if cmp -s "$SV_M" "$P55_SKILL"; then echo "FAIL: sv1-mutation-rm-in-step1c — mutation inert: awk did not apply"; FAILED=1
elif [ "$(sv1_struct "$SV_M")" != ok ]; then echo "ok: sv1-mutation-rm-in-step1c"
else echo "FAIL: sv1-mutation-rm-in-step1c — sv1_struct accepted an rm above Step 2"; FAILED=1; fi

# spawn sentence moved above the fence: sv1_struct must reject it.
awk '{print} /^## Step 2 / {print "Spawn with `subagent_type: \"pr-ready-phase6\"` now."}' "$P55_SKILL" > "$SV_M"
if cmp -s "$SV_M" "$P55_SKILL"; then echo "FAIL: sv1-mutation-spawn-above-fence — mutation inert: awk did not apply"; FAILED=1
elif [ "$(sv1_struct "$SV_M")" != ok ]; then echo "ok: sv1-mutation-spawn-above-fence"
else echo "FAIL: sv1-mutation-spawn-above-fence — sv1_struct accepted a spawn above the fence"; FAILED=1; fi

# sv2_struct <skill-file> — prints "ok" when the verdict-2 clear marker is a unique
# whole line inside Step 4b, below the skip-gate echo, below the RE_REVIEW=skip
# paragraph, below the first RE_REVIEW=spawn line after the Step 4b heading, and
# above the re-review spawn sentence, which itself sits above ## Step 5. Else why.
sv2_struct() {
    local f="$1" n s4b s5 fence echo_l skip_l rr spawn2
    n="$(grep -cxF '# phase 5.5 clear stale verdict 2' "$f")"
    [ "$n" = 1 ] || { echo "verdict-2 marker count is $n, want 1"; return; }
    s4b="$(grep -n '^## Step 4b ' "$f" | head -1 | cut -d: -f1)"
    s5="$(grep -n '^## Step 5 ' "$f" | head -1 | cut -d: -f1)"
    fence="$(grep -nxF '# phase 5.5 clear stale verdict 2' "$f" | cut -d: -f1)"
    echo_l="$(awk -v s="${s4b:-0}" 'NR>s && index($0, "echo \"RE_REVIEW=") && !p {print NR; p=1}' "$f")"
    skip_l="$(awk -v s="${s4b:-0}" 'NR>s && index($0, "On `RE_REVIEW=skip`") && !p {print NR; p=1}' "$f")"
    rr="$(awk -v s="${s4b:-0}" 'NR>s && index($0, "RE_REVIEW=spawn") && !index($0, "echo ") && !p {print NR; p=1}' "$f")"
    spawn2="$(awk -v s="${s4b:-0}" 'NR>s && /subagent_type: "pr-ready-phase6"/ && !p {print NR; p=1}' "$f")"
    if [ -z "$s4b" ] || [ -z "$s5" ] || [ -z "$echo_l" ] || [ -z "$skip_l" ] || [ -z "$rr" ] || [ -z "$spawn2" ]; then
        echo "anchor missing (4b=$s4b s5=$s5 echo=$echo_l skip=$skip_l rr=$rr spawn2=$spawn2)"
    elif [ "$fence" -le "$echo_l" ] || [ "$fence" -le "$skip_l" ] || [ "$fence" -le "$rr" ]; then
        echo "fence $fence not below echo $echo_l, skip $skip_l and spawn-branch line $rr"
    elif [ "$fence" -ge "$spawn2" ] || [ "$spawn2" -ge "$s5" ]; then
        echo "fence $fence not above re-review spawn $spawn2 inside Step 4b (step5=$s5)"
    else echo ok; fi
}

SV2S="$(sv2_struct "$P55_SKILL")"
if [ "$SV2S" = ok ]; then echo "ok: sv2-struct"; else echo "FAIL: sv2-struct — $SV2S"; FAILED=1; fi

BSV2="$(extract_block '# phase 5.5 clear stale verdict 2' "$P55_SKILL")"
if [ -n "$BSV2" ] && [ "$(grep -c '^rm -f' <<< "$BSV2")" = 1 ] \
        && ! grep -qF 'clear stale verdict 1' <<< "$BSV2"; then echo "ok: sv2-extract"
else echo "FAIL: sv2-extract — clear block missing, not one rm -f line, or merged with the verdict-1 fence"; FAILED=1; fi

# sv2-clears-stale-keeps-verdict-1: the -2 block removes a stale -2 file and
# leaves a present verdict-1 file in place.
printf '%s\n' "$SV_STALE" > "$SV_VF1"
printf '%s\n' "$SV_STALE" > "$SV_VF2"
sv_run "$BSV2" "$SV_VF1" "$SV_VF2" >/dev/null
if [ ! -e "$SV_VF2" ]; then echo "ok: sv2-clears-stale"
else echo "FAIL: sv2-clears-stale — stale verdict 2 survived the clear block"; FAILED=1; fi
if [ -s "$SV_VF1" ]; then echo "ok: sv2-keeps-verdict-1"
else echo "FAIL: sv2-keeps-verdict-1 — the -2 clear block removed verdict 1"; FAILED=1; fi
rm -f "$SV_VF1" "$SV_VF2"

# sv2-absent-ok: the block exits 0 when there is nothing to clear.
sv_run "$BSV2" "$SV_VF1" "$SV_VF2" >/dev/null; SV_RC=$?
if [ "$SV_RC" = 0 ]; then echo "ok: sv2-absent-ok"
else echo "FAIL: sv2-absent-ok — exit $SV_RC on an absent verdict file"; FAILED=1; fi

# sv2-default-path-pr-keyed: with no overrides the block removes the PR-keyed -2
# path and leaves the PR-keyed verdict-1 path alone.
printf '%s\n' "$SV_STALE" > "$SV_DEF1"
printf '%s\n' "$SV_STALE" > "$SV_DEF2"
sv_run "$BSV2" "" "" >/dev/null
if [ ! -e "$SV_DEF2" ] && [ -s "$SV_DEF1" ]; then echo "ok: sv2-default-path-pr-keyed"
else echo "FAIL: sv2-default-path-pr-keyed — def2-exists=$([ -e "$SV_DEF2" ] && echo yes || echo no) def1-exists=$([ -e "$SV_DEF1" ] && echo yes || echo no)"; FAILED=1; fi
rm -f "$SV_DEF1" "$SV_DEF2"

# --- sv2 mutations: each must turn its target case red. An unchanged copy is inert.

# rm line deleted from the include copy: the stale -2 file must survive.
sed '/^rm -f "\$FIDELITY_VERDICT_FILE_2"$/d' "$P55_SKILL" > "$SV_M"
if cmp -s "$SV_M" "$P55_SKILL"; then echo "FAIL: sv2-mutation-rm-deleted — mutation inert: sed did not apply"; FAILED=1
else
    printf '%s\n' "$SV_STALE" > "$SV_VF2"
    sv_run "$(extract_block '# phase 5.5 clear stale verdict 2' "$SV_M")" "$SV_VF1" "$SV_VF2" >/dev/null
    if [ -e "$SV_VF2" ]; then echo "ok: sv2-mutation-rm-deleted"
    else echo "FAIL: sv2-mutation-rm-deleted — verdict 2 vanished with the rm line gone"; FAILED=1; fi
    rm -f "$SV_VF2"
fi

# default path collapsed onto verdict 1: the PR-keyed verdict-1 file must be removed,
# which sv2-default-path-pr-keyed would report as a failure.
SV_MB="$(sed 's/-\$PR_NUM-2\.md/-$PR_NUM.md/' <<< "$BSV2")"
if [ "$SV_MB" = "$BSV2" ]; then echo "FAIL: sv2-mutation-path-collapsed — mutation inert: sed did not apply"; FAILED=1
else
    printf '%s\n' "$SV_STALE" > "$SV_DEF1"
    sv_run "$SV_MB" "" "" >/dev/null
    if [ ! -e "$SV_DEF1" ]; then echo "ok: sv2-mutation-path-collapsed"
    else echo "FAIL: sv2-mutation-path-collapsed — collapsed block left verdict 1, so the keep-verdict-1 check is not live"; FAILED=1; fi
    rm -f "$SV_DEF1"
fi

# fence hoisted to the top of Step 4b, above the skip gate: sv2_struct must reject it.
awk '/^# phase 5\.5 clear stale verdict 2$/ {next} {print} /^## Step 4b / {print "# phase 5.5 clear stale verdict 2"}' "$P55_SKILL" > "$SV_M"
if cmp -s "$SV_M" "$P55_SKILL"; then echo "FAIL: sv2-mutation-fence-above-skip-gate — mutation inert: awk did not apply"; FAILED=1
elif [ "$(sv2_struct "$SV_M")" != ok ]; then echo "ok: sv2-mutation-fence-above-skip-gate"
else echo "FAIL: sv2-mutation-fence-above-skip-gate — sv2_struct accepted a fence above the skip gate"; FAILED=1; fi

# re-review spawn sentence moved above the fence: sv2_struct must reject it.
awk '{print} /^## Step 4b / {print "Spawn `subagent_type: \"pr-ready-phase6\"` now."}' "$P55_SKILL" > "$SV_M"
if cmp -s "$SV_M" "$P55_SKILL"; then echo "FAIL: sv2-mutation-spawn-above-fence — mutation inert: awk did not apply"; FAILED=1
elif [ "$(sv2_struct "$SV_M")" != ok ]; then echo "ok: sv2-mutation-spawn-above-fence"
else echo "FAIL: sv2-mutation-spawn-above-fence — sv2_struct accepted a spawn above the fence"; FAILED=1; fi
rm -f "$SV_M"

# --- end stale-verdict clear cases

# --- §5.8c findings render: extraction + composition cases ----------------

# Extract _digest_labels from bin/digest-dm-build (the expect_mss idiom: anchor on
# the function's own 'name() {' .. '}' lines and eval it, so case 5 can assert on
# the parser's records directly without the DM budget truncating them).
# Trade-off: extracting the function rather than parsing the DM text catches a sixth
# label displacing **Touches:** — parsing the DM cannot detect that defect.
_DL_FN="$(sed -n '/^_digest_labels() {/,/^}/p' "$REPO_ROOT/bin/digest-dm-build")"
if [ -z "$_DL_FN" ]; then
    echo "FAIL: 5.8c setup — _digest_labels() not found in bin/digest-dm-build"
    FAILED=1
fi
# shellcheck disable=SC2091
eval "$_DL_FN"

RR_LINE="**Re-reviewed tree:** cafebabe0001 (READY)"

# Case 1 — findings render: XYZZY-FINDING-SENTINEL present and before ### Merge digest
out1="$(run_findings "$B58F" findings spawn)"
body1="$(compose_fixture_body "$RR_LINE" "$out1")"
sentinel_lineno="$(grep -n 'XYZZY-FINDING-SENTINEL' <<< "$body1" | head -1 | cut -d: -f1)"
digest_lineno="$(grep -n '^### Merge digest$' <<< "$body1" | head -1 | cut -d: -f1)"
if grep -qF 'XYZZY-FINDING-SENTINEL' <<< "$body1" \
        && [ -n "$sentinel_lineno" ] && [ -n "$digest_lineno" ] \
        && [ "$sentinel_lineno" -lt "$digest_lineno" ]; then
    echo "ok: 5.8c findings render: sentinel present and before ### Merge digest"
else
    echo "FAIL: 5.8c findings render: sentinel missing or not before ### Merge digest (sentinel=$sentinel_lineno digest=$digest_lineno)"
    FAILED=1
fi

# Case 2 — quiet: findingsempty produces an empty slot and only blank lines between
# `Findings: none.` and ### Merge digest
out2="$(run_findings "$B58F" findingsempty spawn)"
body2="$(compose_fixture_body "$RR_LINE" "$out2")"
if grep -q '^--- V2_FINDINGS ---$' <<< "$out2"; then
    echo "FAIL: 5.8c quiet: block emitted findings for a whitespace-only body"
    FAILED=1
else
    echo "ok: 5.8c quiet: rendered slot is empty (V2_FINDINGS_PRESENT=no)"
fi
between2="$(awk '/^Findings: none\.$/{found=1;next} found && /^### Merge digest/{exit} found{print}' <<< "$body2")"
if grep -q '[^[:space:]]' <<< "$between2"; then
    echo "FAIL: 5.8c quiet: non-blank content between Findings: none. and ### Merge digest: '$between2'"
    FAILED=1
else
    echo "ok: 5.8c quiet: only blank lines between Findings: none. and ### Merge digest"
fi

# Case 3 — degrade: absent -2 file; composed body is byte-identical to the
# pre-change template composed with an empty slot (the block's exit status is
# not asserted: it ends non-zero by design and run_findings swallows it)
out3="$(run_findings "$B58F" absent spawn)"
body3="$(compose_fixture_body "$RR_LINE" "$out3")"
body3_ref="$(compose_fixture_body "$RR_LINE" "")"
if [ "$body3" = "$body3_ref" ]; then
    echo "ok: 5.8c degrade: absent file produces body byte-identical to empty-slot template"
else
    echo "FAIL: 5.8c degrade: body differs from empty-slot template"
    FAILED=1
fi

# Case 4 — skip: structural guard that the findings-render fence sits AFTER the
# RE_REVIEW=spawn line and BEFORE the Step 5 heading in _phase-5.5-fidelity.md.
# That placement is what confines the render block to the spawn path; if it
# drifted above RE_REVIEW=spawn or out of Step 4b, skip-mode runs would also render.  Behavioral testing is not needed: on skip, no second
# reviewer runs, so FIDELITY_VERDICT_FILE_2 is never written and the block is never
# reached.
_spawn_lineno="$(grep -n 'RE_REVIEW=spawn' "$P55_SKILL" | head -1 | cut -d: -f1)"
_fence_lineno="$(grep -n '# phase 5.8 findings render' "$P55_SKILL" | head -1 | cut -d: -f1)"
_step5_lineno="$(grep -n '^## Step 5' "$P55_SKILL" | head -1 | cut -d: -f1)"
if [ -n "$_spawn_lineno" ] && [ -n "$_fence_lineno" ] && [ -n "$_step5_lineno" ] \
        && [ "$_fence_lineno" -gt "$_spawn_lineno" ] \
        && [ "$_fence_lineno" -lt "$_step5_lineno" ]; then
    echo "ok: 5.8c skip: findings-render fence is inside the RE_REVIEW=spawn branch of Step 4b (structural guard)"
else
    echo "FAIL: 5.8c skip: findings-render fence is NOT between RE_REVIEW=spawn and ## Step 5 (fence=$_fence_lineno spawn=$_spawn_lineno step5=$_step5_lineno)"
    FAILED=1
fi

# Case 5 — digest-parse regression: feed case 1's body to extracted _digest_labels;
# assert exactly five records and each label's value equals its sentinel; then run
# bin/digest-dm-build end-to-end on the same body and assert exit 0.
if [ -n "$_DL_FN" ]; then
    dl_out="$(_digest_labels <<< "$body1")"
    dl_count="$(awk -F'\t' 'NF>=2{c++} END{print c+0}' <<< "$dl_out")"
    if [ "$dl_count" -eq 5 ]; then
        echo "ok: 5.8c digest-parse: _digest_labels yields exactly 5 records"
    else
        echo "FAIL: 5.8c digest-parse: _digest_labels yielded $dl_count records (expected 5)"
        FAILED=1
    fi
    for _lv_pair in \
        'What changed:WC-VAL' \
        'Why:WHY-VAL' \
        'Watch:WATCH-VAL' \
        'Touches:TOUCH-VAL' \
        'Machine-authored fixes:MAF-VAL'; do
        _lbl="${_lv_pair%%:*}"; _want="${_lv_pair#*:}"
        _got="$(awk -F'\t' -v l="$_lbl" '$1 == l { print $2; exit }' <<< "$dl_out")"
        if [ "$_got" = "$_want" ]; then
            echo "ok: 5.8c digest-parse: label '$_lbl' = '$_want'"
        else
            echo "FAIL: 5.8c digest-parse: label '$_lbl' expected '$_want', got '$_got'"
            FAILED=1
        fi
    done
    if printf '%s\n' "$body1" | "$REPO_ROOT/bin/digest-dm-build" \
            --pr-number 9999 --title t --url u > /dev/null 2>&1; then
        echo "ok: 5.8c digest-parse: bin/digest-dm-build exits 0 on composed body"
    else
        echo "FAIL: 5.8c digest-parse: bin/digest-dm-build non-zero on composed body"
        FAILED=1
    fi
fi

# 4f: no fixture writes /tmp/post-plan-fidelity-verdict-<digit> paths.  Pattern uses a bracketed char-class so the source line for the
# _VPATH_PAT assignment does not contain '/tmp/...' + digit and cannot self-match.
_VPATH_PAT='post-plan-fidelity-verdict-[0-9]'
_vpath_hits="$(grep -c "/tmp/${_VPATH_PAT}" "$SCRIPT_DIR/test-postplan-arm-conditions" || true)"
if [ "$_vpath_hits" -eq 0 ]; then
    echo "ok: 5.8c fixture hygiene: no fixture writes a /tmp verdict path keyed by a digit"
else
    echo "FAIL: 5.8c fixture hygiene: $_vpath_hits lines contain /tmp/post-plan-fidelity-verdict-<digit> (expected none)"
    FAILED=1
fi

# --- §5.7 drift guards: path stem + parse tokens in the fidelity phase -----------
grep -qF 'post-plan-fidelity-verdict-' "$P55_SKILL" \
    || { echo "FAIL: drift — $(basename "$P55_SKILL") lost the verdict-path stem"; FAILED=1; }
if grep -qE 'post-plan-fidelity-verdict-(\$\$|\$PPID)' "$P55_SKILL"; then
    echo "FAIL: drift — $(basename "$P55_SKILL") keys the verdict path to a PID; the writer and the reader are different shells"
    FAILED=1
fi
# shellcheck disable=SC2016  # literal shell text, not expansions
PARSE_TOKENS=(
    "sed '/^## DIGEST/,\$d'"
    '^(READY WITH NOTES|NOT READY|READY)'
    'tail -1'
)
for tok in "${PARSE_TOKENS[@]}"; do
    if printf '%s' "$B55" | grep -qF -- "$tok"; then
        echo "ok: 5.5 verdict parse carries [$tok]"
    else
        echo "FAIL: verdict-parse drift — 5.5 is missing [$tok]"
        FAILED=1
    fi
done

# have <name> <haystack> <needle> — literal substring assertion. Herestring, never a
# pipe into grep -q: .claude/rules/shell-pipefail-grep.md.
have() {
    if grep -qF -- "$3" <<< "$2"; then echo "ok: $1"
    else echo "FAIL: $1 — missing literal '$3'"; FAILED=1; fi
}
# lacks <name> <haystack> <needle>
lacks() {
    if grep -qF -- "$3" <<< "$2"; then
        echo "FAIL: $1 — must NOT contain '$3'"; FAILED=1
    else echo "ok: $1"; fi
}

# §5.9j the shared surfaces condition (14) must never reach. Its evidence is a /tmp flag
# local to one run — not live-derivable, so a predicate reading it would emit
# machine-dependent columns in bin/pr-triage. Checked by content, not by history: the CI
# checkout is shallow with no origin/master ref (tests.yml harness-tests), and the property
# is "the shared predicate never reads the flag", not "the file is untouched".
for F in bin/lib/pr-armable.sh bin/pr-triage; do
    F_TXT="$(cat "$REPO_ROOT/$F")"
    lacks "§5.9j: $F never reads the conflict flag" "$F_TXT" '/tmp/postplan-conflict-resolved-'
    lacks "§5.9j: $F never names condition (14)"    "$F_TXT" 'condition (14)'
done
# --- skill carries no arming logic (postplan-skill-shrink) ---
# tools/postplan-harness/harness/armable.py is the only arming authority. POSTPLAN_SKILL_DIR is a
# test seam so the mutation proof can point at a copy with one arming string injected.
_SKILL_DIR="${POSTPLAN_SKILL_DIR:-$REPO_ROOT/.claude/skills/post-plan}"
_ARM_RE='gh pr merge [^`]*(--|[[:space:]]-[[:alpha:]])|enablePullRequestAutoMerge|enable-auto-merge|^# condition \([0-9]+\)|^[[:space:]]*(\.|source)[[:space:]]+[^ ]*pr-armable\.sh|^## Phase 6\.5'
_hits=$(grep -nE "$_ARM_RE" "$_SKILL_DIR"/*.md 2>/dev/null || true)
if [ -z "$_hits" ]; then echo "ok: no_arming_logic_in_skill"
else echo "FAIL: no_arming_logic_in_skill — arming-shaped text in the fallback skill:"; printf '%s\n' "$_hits"; FAILED=1; fi
_retired_present=0
for _f in _phase-2-conflict-resolution.md _phase-3-classify-diff.md _phase-4-review-audit.md \
          _phase-5-final-verification.md _phase-6-manual-testing.md _phase-6.5-arm-auto-merge.md \
          _phase-7-ci-monitoring.md; do
    [ -e "$_SKILL_DIR/$_f" ] && { echo "FAIL: retired_phase_file_present — $_f"; FAILED=1; _retired_present=1; }
done
[ "$_retired_present" -eq 0 ] && echo "ok: retired_phase_file_present (none)"
if grep -qE 'never runs .gh pr merge.' "$_SKILL_DIR/SKILL.md"; then echo "ok: skill_states_no_arm"
else echo "FAIL: skill_states_no_arm — SKILL.md intro lost the no-arming sentence"; FAILED=1; fi
# Repo-wide sweep: no live reference to a retired _phase-{2,3,4,5-final,6,6.5,7} file.
# Excluded: harness path lists and fixtures, the two sibling-owned skill files, this guard,
# and the registry rows that carry (example) / retired markers.
_dangling=$(git -C "$REPO_ROOT" grep -n -e '_phase-2-conflict' -e '_phase-3-classify' \
    -e '_phase-4-review' -e '_phase-5-final' -e '_phase-6-manual' -e '_phase-6\.5-arm' -e '_phase-7-ci' -- . \
    ':!tools/postplan-harness/harness/gate_backtest.py' ':!tools/postplan-harness/harness/fidelity.py' \
    ':!tools/postplan-harness/tests/fixtures' ':!tools/postplan-harness/tests/test_gatefix.py' \
    ':!tools/postplan-harness/tests/test_resolver_self_heal.py' \
    ':!tools/postplan-harness/harness/llm_calls.py' ':!.claude/skills/post-plan/_phase-5.5-fidelity.md' \
    ':!.claude/skills/post-plan/_pr-body-claims.md' ':!bin/test-postplan-arm-conditions' \
    ':!ibl5/docs/retrospective-class-registry.md' 2>/dev/null || true)
if [ -z "$_dangling" ]; then echo "ok: no_dangling_retired_phase_refs"
else echo "FAIL: no_dangling_retired_phase_refs:"; printf '%s\n' "$_dangling"; FAILED=1; fi
# --- end skill carries no arming logic ---

if [ "$FAILED" -eq 0 ]; then
    echo "All post-plan block checks passed."
else
    echo "Some post-plan block checks FAILED."
fi
exit "$FAILED"
