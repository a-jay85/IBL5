#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-check-phpunit-hygiene — regression test for bin/check-phpunit-hygiene.
#
# Pins THREE checks the gate enforces:
#   mark-test-skipped  markTestSkipped() is a blocking hit; an inline
#                      `// phpunit-hygiene-allow:` marker suppresses it.
#   no-db-group        a CONCRETE class extending DatabaseTestCase that lacks
#                      `#[Group('database')]` is a blocking hit (the attribute
#                      is not inherited; without it the test runs in the no-DB
#                      job and fails). An `abstract` base class is exempt, as is
#                      a class carrying `// phpunit-hygiene-allow-no-db-group:`.
#   set-accessible     a Reflection `->setAccessible(` call is a blocking hit —
#                      a no-op since PHP 8.1, deprecated since 8.5 (fatal in
#                      PHP 9), so it emits a deprecation on every suite run. An
#                      inline `// phpunit-hygiene-allow:` marker suppresses it.
#
# Each case builds a throwaway git repo under mktemp (check-phpunit-hygiene
# resolves its scan root from `git rev-parse --show-toplevel`) with a single
# fixture under ibl5/tests/, runs the gate in MODE=all from inside, and asserts
# the exit code + output. MODE=all exercises the same pattern-matching logic as
# --pr; only the file-set builder differs, and that is unchanged pre-existing
# code.
#
# BLIND SPOT: every fixture repo holds ONE file, so this test cannot exercise the
# gate at scale — the bash 3.2 heap crash that a per-file grep loop in
# run_pattern triggers over ~1k files is invisible here. After touching
# run_pattern, also run `bin/check-phpunit-hygiene` on the real tree.
#
# It also covers the --pr base-ref seam of bin/check-e2e-hygiene (identical
# E2E_HYGIENE_BASE_REF / PHPUNIT_HYGIENE_BASE_REF contract) via run_seam_case.
# It also pins bin/check-hot-files' scope and arg parsing (section "hot-files").
#
# Run: bin/test-check-phpunit-hygiene  (exit 0 = all pass, 1 = a case failed)

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
HYGIENE="$SCRIPT_DIR/check-phpunit-hygiene"
E2E_HYGIENE="$SCRIPT_DIR/check-e2e-hygiene"
HOT="$SCRIPT_DIR/check-hot-files"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP" 2>/dev/null' EXIT

FAILED=0
pass()     { echo "ok: $1"; }
failcase() { echo "FAIL: $1"; FAILED=1; }

# mk_repo — build a fresh git repo with an ibl5/tests dir; echo its path.
mk_repo() {
    local d
    d="$(mktemp -d "$TMP/repo.XXXXXX")"
    git init -q "$d" >/dev/null 2>&1
    git -C "$d" config user.email t@example.com >/dev/null 2>&1
    git -C "$d" config user.name tester >/dev/null 2>&1
    git -C "$d" config commit.gpgsign false >/dev/null 2>&1
    mkdir -p "$d/ibl5/tests"
    echo "$d"
}

# run_case <name> <expected-exit> <expected-output-regex|-> <fixture-relpath> <fixture-body>
# Builds a repo with one fixture file and runs check-phpunit-hygiene (MODE=all).
run_case() {
    local name="$1" want="$2" want_re="$3" relpath="$4" body="$5"
    local d out rc
    d="$(mk_repo)"
    mkdir -p "$d/$(dirname "$relpath")"
    printf '%s\n' "$body" > "$d/$relpath"
    out="$( ( cd "$d" && "$HYGIENE" ) 2>&1 )"
    rc=$?
    if [ "$rc" -ne "$want" ]; then
        failcase "$name — expected exit $want, got $rc"
        printf '%s\n' "$out" | sed 's/^/    /'
        return
    fi
    if [ "$want_re" != "-" ] && ! printf '%s' "$out" | grep -qE "$want_re"; then
        failcase "$name — output did not match: $want_re"
        printf '%s\n' "$out" | sed 's/^/    /'
        return
    fi
    pass "$name (exit $rc)"
}

# --- Characterization: existing mark-test-skipped behavior is preserved -------

run_case "skip-flagged" 1 'mark-test-skipped' "ibl5/tests/SkipTest.php" \
'<?php
namespace Tests\X;
use PHPUnit\Framework\TestCase;
class SkipTest extends TestCase
{
    public function testThing(): void
    {
        $this->markTestSkipped("nope");
    }
}'

run_case "skip-marker-suppresses" 0 '-' "ibl5/tests/SkipMarkedTest.php" \
'<?php
namespace Tests\X;
use PHPUnit\Framework\TestCase;
class SkipMarkedTest extends TestCase
{
    public function testThing(): void
    {
        // phpunit-hygiene-allow: external service is unreachable in unit tier
        $this->markTestSkipped("nope");
    }
}'

# --- New: no-db-group check ---------------------------------------------------

run_case "db-group-missing-flagged" 1 'no-db-group' "ibl5/tests/NoGroupTest.php" \
'<?php
namespace Tests\X;
use Tests\DatabaseIntegration\DatabaseTestCase;
class NoGroupTest extends DatabaseTestCase
{
    public function testThing(): void {}
}'

run_case "db-group-present-ok" 0 '-' "ibl5/tests/WithGroupTest.php" \
'<?php
namespace Tests\X;
use PHPUnit\Framework\Attributes\Group;
use Tests\DatabaseIntegration\DatabaseTestCase;
#[Group("database")]
class WithGroupTest extends DatabaseTestCase
{
    public function testThing(): void {}
}'

run_case "db-group-abstract-exempt" 0 '-' "ibl5/tests/BaseTestCase.php" \
'<?php
namespace Tests\X;
use Tests\DatabaseIntegration\DatabaseTestCase;
abstract class BaseTestCase extends DatabaseTestCase
{
    protected function helper(): void {}
}'

run_case "db-group-marker-suppresses" 0 '-' "ibl5/tests/MarkedNoGroupTest.php" \
'<?php
namespace Tests\X;
use Tests\DatabaseIntegration\DatabaseTestCase;
// phpunit-hygiene-allow-no-db-group: runs only under a bespoke harness, not the db group
class MarkedNoGroupTest extends DatabaseTestCase
{
    public function testThing(): void {}
}'

run_case "non-db-testcase-ok" 0 '-' "ibl5/tests/PlainTest.php" \
'<?php
namespace Tests\X;
use PHPUnit\Framework\TestCase;
class PlainTest extends TestCase
{
    public function testThing(): void {}
}'

# --- New: set-accessible check ------------------------------------------------

run_case "set-accessible-flagged" 1 'set-accessible' "ibl5/tests/ReflectTest.php" \
'<?php
namespace Tests\X;
use PHPUnit\Framework\TestCase;
class ReflectTest extends TestCase
{
    public function testThing(): void
    {
        $prop = (new \ReflectionClass($this))->getProperty("x");
        $prop->setAccessible(true);
    }
}'

run_case "set-accessible-marker-suppresses" 0 '-' "ibl5/tests/ReflectMarkedTest.php" \
'<?php
namespace Tests\X;
use PHPUnit\Framework\TestCase;
class ReflectMarkedTest extends TestCase
{
    public function testThing(): void
    {
        // phpunit-hygiene-allow: pinned here to characterize the 8.5 deprecation itself
        $prop->setAccessible(true);
    }
}'

# A `setAccessible` that is not a method call on a Reflection object must not hit —
# the pattern anchors on `->` so a same-named local/string is left alone.
run_case "set-accessible-word-only-ok" 0 '-' "ibl5/tests/NoReflectTest.php" \
'<?php
namespace Tests\X;
use PHPUnit\Framework\TestCase;
class NoReflectTest extends TestCase
{
    public function testThing(): void
    {
        $this->assertSame("setAccessible(true)", $doc);
    }
}'

# --- base-ref seam (--pr): PHPUNIT_HYGIENE_BASE_REF / E2E_HYGIENE_BASE_REF ---
# Both gates share one contract: unset or empty means origin/master, a non-empty
# value is the --pr diff base, and a non-empty value that is not a commit exits 2.

# run_seam_case <name> <gate-path> <var-name> <var-mode> <expected-exit> <expected-regex|-> <fixture-relpath> <fixture-body>
# var-mode: unset | empty | base (commit A) | head (commit B) | bogus
# Commit A is an empty README that origin/master points at; commit B adds the fixture.
run_seam_case() {
    local name="$1" gate="$2" var="$3" mode="$4" want="$5" want_re="$6" relpath="$7" body="$8"
    local d out rc sha_a sha_b
    d="$(mk_repo)"
    : > "$d/README"
    git -C "$d" add README >/dev/null 2>&1
    git -C "$d" commit -q -m A >/dev/null 2>&1
    sha_a="$(git -C "$d" rev-parse HEAD)"
    git -C "$d" update-ref refs/remotes/origin/master "$sha_a"
    mkdir -p "$d/$(dirname "$relpath")"
    printf '%s\n' "$body" > "$d/$relpath"
    git -C "$d" add -A >/dev/null 2>&1
    git -C "$d" commit -q -m B >/dev/null 2>&1
    sha_b="$(git -C "$d" rev-parse HEAD)"
    case "$mode" in
        unset) out="$( ( cd "$d" && env -u "$var" "$gate" --pr ) 2>&1 )" ;;
        empty) out="$( ( cd "$d" && env "$var=" "$gate" --pr ) 2>&1 )" ;;
        base)  out="$( ( cd "$d" && env "$var=$sha_a" "$gate" --pr ) 2>&1 )" ;;
        head)  out="$( ( cd "$d" && env "$var=$sha_b" "$gate" --pr ) 2>&1 )" ;;
        bogus) out="$( ( cd "$d" && env "$var=no-such-ref-1291" "$gate" --pr ) 2>&1 )" ;;
    esac
    rc=$?
    if [ "$rc" -ne "$want" ]; then
        failcase "$name — expected exit $want, got $rc"
        printf '%s\n' "$out" | sed 's/^/    /'
        return
    fi
    if [ "$want_re" != "-" ] && ! printf '%s' "$out" | grep -qE "$want_re"; then
        failcase "$name — output did not match: $want_re"
        printf '%s\n' "$out" | sed 's/^/    /'
        return
    fi
    pass "$name (exit $rc)"
}

SEAM_PHP='<?php
namespace Tests\X;
use PHPUnit\Framework\TestCase;
class SeamSkipTest extends TestCase
{
    public function testThing(): void
    {
        $this->markTestSkipped("nope");
    }
}'
SEAM_TS="import { test } from '@playwright/test';
test.skip('seam', async () => {});"

# The `empty` cases catch the colon-less default `${VAR-origin/master}`, which treats an
# empty var as a set one and diffs against "".
PV=PHPUNIT_HYGIENE_BASE_REF
# Fixtures sit one directory deep: the gates' --pr pathspecs (`ibl5/tests/**/*.php`,
# `ibl5/tests/e2e/**/*.ts`) need a subdirectory to match.
PF="ibl5/tests/Seam/SeamSkipTest.php"
run_seam_case "phpunit-seam-unset-defaults-origin-master" "$HYGIENE" "$PV" unset 1 'mark-test-skipped' "$PF" "$SEAM_PHP"
run_seam_case "phpunit-seam-empty-defaults-origin-master" "$HYGIENE" "$PV" empty 1 'mark-test-skipped' "$PF" "$SEAM_PHP"
run_seam_case "phpunit-seam-base-flags"                   "$HYGIENE" "$PV" base  1 'mark-test-skipped' "$PF" "$SEAM_PHP"
run_seam_case "phpunit-seam-head-excludes-file"           "$HYGIENE" "$PV" head  0 '-' "$PF" "$SEAM_PHP"
run_seam_case "phpunit-seam-bogus-ref-exit2"              "$HYGIENE" "$PV" bogus 2 'does not resolve to a commit' "$PF" "$SEAM_PHP"

EV=E2E_HYGIENE_BASE_REF
EF="ibl5/tests/e2e/seam/seam.spec.ts"
run_seam_case "e2e-seam-unset-defaults-origin-master" "$E2E_HYGIENE" "$EV" unset 1 'skip' "$EF" "$SEAM_TS"
run_seam_case "e2e-seam-empty-defaults-origin-master" "$E2E_HYGIENE" "$EV" empty 1 'skip' "$EF" "$SEAM_TS"
run_seam_case "e2e-seam-base-flags"                   "$E2E_HYGIENE" "$EV" base  1 'skip' "$EF" "$SEAM_TS"
run_seam_case "e2e-seam-head-excludes-file"           "$E2E_HYGIENE" "$EV" head  0 '-' "$EF" "$SEAM_TS"
run_seam_case "e2e-seam-bogus-ref-exit2"              "$E2E_HYGIENE" "$EV" bogus 2 'does not resolve to a commit' "$EF" "$SEAM_TS"

# === hot-files: scope + arg parsing (bin/check-hot-files) ===
# Pins the --pr crossing logic, HOT_FILE_BASE_REF validation (a non-empty value
# must resolve in --pr mode), lenient arg parsing and --help. Every case runs
# with HOT_FILE_THRESHOLD=5; "N lines" is `seq N`.

# mk_hot_repo <base-lines (0 = absent at base)> <head-lines> <relpath>
# Commits the base state, then leaves the head state uncommitted. A file absent
# at base is added with `git add -N` so the diff lists it.
mk_hot_repo() {
    local base="$1" head="$2" rel="$3" d
    d="$(mk_repo)"
    mkdir -p "$d/ibl5/classes/Sub"
    : > "$d/ibl5/classes/.keep"
    if [ "$base" -gt 0 ]; then
        seq "$base" > "$d/$rel"
    fi
    git -C "$d" add -A >/dev/null 2>&1
    git -C "$d" commit -q -m base >/dev/null 2>&1
    seq "$head" > "$d/$rel"
    if [ "$base" -eq 0 ]; then
        git -C "$d" add -N "$rel" >/dev/null 2>&1
    fi
    echo "$d"
}

# hot_case <name> <want-exit> <want-regex|-> <absent-regex|-> <dir> <env-assigns/cmd...>
# Runs from <dir> with HOT_FILE_BASE_REF unset and the threshold at 5, stdout and
# stderr combined. The trailing words are `env` arguments: assignments, then the gate.
hot_case() {
    local name="$1" want="$2" want_re="$3" absent_re="$4" d="$5" out rc
    shift 5
    out="$( ( cd "$d" && env -u HOT_FILE_BASE_REF HOT_FILE_THRESHOLD=5 "$@" ) 2>&1 )"
    rc=$?
    if [ "$rc" -ne "$want" ]; then
        failcase "$name — expected exit $want, got $rc"
        printf '%s\n' "$out" | sed 's/^/    /'
        return
    fi
    if [ "$want_re" != "-" ] && ! grep -qE -- "$want_re" <<< "$out"; then
        failcase "$name — output did not match: $want_re"
        printf '%s\n' "$out" | sed 's/^/    /'
        return
    fi
    if [ "$absent_re" != "-" ] && grep -qE -- "$absent_re" <<< "$out"; then
        failcase "$name — output unexpectedly matched: $absent_re"
        printf '%s\n' "$out" | sed 's/^/    /'
        return
    fi
    pass "$name (exit $rc)"
}

HOT_HEADER='^=== Hot files \(> 5 LOC\) ===$'
HOT_FOO="ibl5/classes/Foo.php"

d="$(mk_hot_repo 3 10 "$HOT_FOO")"
hot_case hot-pr-crossing-exit0 0 \
    '^CROSSED: ibl5/classes/Foo\.php \(now 10 LOC, was 3 at base\)$' - \
    "$d" HOT_FILE_BASE_REF=HEAD "$HOT" --pr

d="$(mk_hot_repo 0 10 ibl5/classes/Sub/Bar.php)"
hot_case hot-pr-nested-new-file-crossing 0 \
    '^CROSSED: ibl5/classes/Sub/Bar\.php \(now 10 LOC, was 0 at base\)$' - \
    "$d" HOT_FILE_BASE_REF=HEAD "$HOT" --pr

d="$(mk_hot_repo 10 12 "$HOT_FOO")"
hot_case hot-pr-chronic-no-crossing-exit1 1 "$HOT_HEADER" 'CROSSED' \
    "$d" HOT_FILE_BASE_REF=HEAD "$HOT" --pr

d="$(mk_hot_repo 3 10 "$HOT_FOO")"
hot_case hot-full-mode-lists-exit0 0 "$HOT_HEADER" 'CROSSED' "$d" "$HOT"
hot_case hot-full-mode-lists-foo 0 'Foo\.php' 'CROSSED' "$d" "$HOT"

# The fixture has no origin/master, so the unvalidated default yields an empty
# crossing list (exit 1) with git's own noise and never the exit-2 guard.
hot_case hot-env-unset-default-not-validated 1 - 'does not resolve' "$d" "$HOT" --pr
hot_case hot-env-empty-defaults 1 - 'does not resolve' "$d" HOT_FILE_BASE_REF= "$HOT" --pr
# A non-empty HOT_FILE_BASE_REF is validated in --pr mode: a bogus ref exits 2
# with the shared lib's message, so CI never reads it as "no crossing".
hot_case hot-env-bogus-exit2 2 '^HOT_FILE_BASE_REF=nosuchref does not resolve to a commit$' 'CROSSED' \
    "$d" HOT_FILE_BASE_REF=nosuchref "$HOT" --pr
# Full (listing) mode never resolves a base, so the same bogus value still lists.
hot_case hot-env-bogus-full-mode-lists 0 "$HOT_HEADER" 'does not resolve' \
    "$d" HOT_FILE_BASE_REF=nosuchref "$HOT"
# A bare $HOT_FILE_BASE_REF read (no :- default) dies under set -u in an empty
# launchd-like environment. `env -i` also drops HOME and every other variable.
hot_case hot-empty-env-no-unbound-variable 1 - 'unbound variable' "$d" env -i PATH="$PATH" "$HOT" --pr

hot_case hot-unknown-arg-ignored 0 "$HOT_HEADER" - "$d" "$HOT" --bogus
hot_case hot-help-exit0 0 '^Usage: bin/check-hot-files \[--pr\]' - "$d" "$HOT" --help
mkdir -p "$TMP/nogit"
hot_case hot-help-outside-git-exit0 0 '^Usage: bin/check-hot-files \[--pr\]' - "$TMP/nogit" "$HOT" --help

# Post-migration: the shared arg loop recognises --pr and --help in any position
# (a deliberate widening: they used to count only as $1), and --base is additive.
hot_case hot-pr-after-unknown-arg 0 '^CROSSED: ' - \
    "$(mk_hot_repo 3 10 "$HOT_FOO")" HOT_FILE_BASE_REF=HEAD "$HOT" --bogus --pr
hot_case hot-help-any-position 0 '^Usage:' - "$d" "$HOT" --pr --help
hot_case hot-base-flag-missing-exit2 2 '^--base requires a ref value$' - "$d" "$HOT" --pr --base
hot_case hot-base-flag-bogus-exit2 2 '^--base nosuchref does not resolve to a commit$' - \
    "$d" "$HOT" --pr --base nosuchref
hot_case hot-base-flag-scans 0 '^CROSSED: ' - \
    "$(mk_hot_repo 3 10 "$HOT_FOO")" "$HOT" --pr --base HEAD

if [ "$FAILED" -ne 0 ]; then
    echo "RESULT: FAILED"
    exit 1
fi
echo "RESULT: all passed"
exit 0
