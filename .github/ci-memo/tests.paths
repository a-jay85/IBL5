# Input path set for the tests.yml memo (bin/ci-memo, ADR-0131).
# One git pathspec per line. Superset of every dorny filter that gates a
# memoized job, plus the workflow, its composite action, and this file.
.github/workflows/tests.yml
.github/actions/setup-php-env
.github/ci-memo/tests.paths
bin
ibl5/bin
.claude
:(glob)**/*.php
:(glob)**/*.sql
:(glob)ibl5/**/*.ts
:(glob)ibl5/**/*.tsx
ibl5/composer.json
ibl5/composer.lock
ibl5/package.json
ibl5/bun.lock
ibl5/phpunit.xml
ibl5/phpstan.neon
ibl5/phpstan-tests.neon
ibl5/phpstan-baseline.neon
ibl5/phpstan-tests-baseline.neon
ibl5/phpstan-rules
ibl5/migrations
ibl5/IBLbot
