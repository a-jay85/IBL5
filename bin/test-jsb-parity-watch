#!/usr/bin/env bash
# bin/test-jsb-parity-watch — fixture harness for bin/jsb-parity-watch and
# bin/jsb-parity-watch-setup. Drives only the CLIs. gh, curl, pgrep, launchctl,
# discord-dm and automouse/run are stubs, so no case reaches GitHub, Discord,
# launchd or a real model.
#
# Usage: bin/test-jsb-parity-watch [case_name ...]   (no arguments runs every case)
# shellcheck disable=SC2329  # case_* and helpers are dispatched by name
set -uo pipefail
# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
h_tmp T

BASE=1795430000
SECRET="https://hooks.example.invalid/T3-SECRET-7f3a9c"
AMDIR=".claude/projects/-Users-ajaynicolas-GitHub-IBL5/automouse"

GREEN='[{"__typename":"CheckRun","status":"COMPLETED","conclusion":"SUCCESS","name":"a"}]'
ROLL_FAILED='[{"__typename":"CheckRun","status":"COMPLETED","conclusion":"FAILURE","name":"a"}]'
PENDING='[{"__typename":"CheckRun","status":"IN_PROGRESS","conclusion":"","name":"a"},{"__typename":"StatusContext","context":"x","state":"EXPECTED"}]'
NEAR_MISS='[{"__typename":"CheckRun","status":"COMPLETED","conclusion":"SKIPPED","name":"a"},{"__typename":"CheckRun","status":"COMPLETED","conclusion":"NEUTRAL","name":"b"},{"__typename":"CheckRun","status":"COMPLETED","conclusion":"SUCCESS","name":"c"}]'
ERROR_CTX='[{"__typename":"StatusContext","context":"ci","state":"ERROR"}]'
SUPERSEDED_OK='[{"__typename":"CheckRun","status":"COMPLETED","conclusion":"CANCELLED","name":"m","workflowName":"w","startedAt":"2026-01-01T00:00:01Z"},{"__typename":"CheckRun","status":"COMPLETED","conclusion":"SUCCESS","name":"m","workflowName":"w","startedAt":"2026-01-01T00:00:09Z"}]'
SUPERSEDED_BAD='[{"__typename":"CheckRun","status":"COMPLETED","conclusion":"SUCCESS","name":"m","workflowName":"w","startedAt":"2026-01-01T00:00:01Z"},{"__typename":"CheckRun","status":"COMPLETED","conclusion":"FAILURE","name":"m","workflowName":"w","startedAt":"2026-01-01T00:00:09Z"}]'

S=""

# --- Sandbox ---------------------------------------------------------------------

# ledger <id:status:slug>...: write the sandbox ledger.
ledger() {
    local out='[]' t id st sl
    for t in "$@"; do
        id="${t%%:*}"; t="${t#*:}"; st="${t%%:*}"; sl="${t#*:}"
        out=$(jq -c --arg id "$id" --arg st "$st" --arg sl "$sl" \
            '. + [{id: $id, status: $st, plan_slug: (if $sl == "" then null else $sl end)}]' <<< "$out")
    done
    jq -n --argjson r "$out" '{rows: $r}' > "$S/parity/ledger.json"
}

write_stub() {
    local name="$1"
    cat > "$S/stub/$name"
    chmod 755 "$S/stub/$name"
}

# sandbox <name>: build $S for one case, with one row (pl-0001) in flight.
sandbox() {
    S="$T/$1"
    mkdir -p "$S/home/.config/jsb-parity" "$S/home/$AMDIR/queue" "$S/home/$AMDIR/done" \
        "$S/home/$AMDIR/skipped" "$S/home/$AMDIR/reports" "$S/parity/recordings" \
        "$S/parity/state" "$S/plannow" "$S/stub" "$S/bin/automouse" "$S/log" "$S/fix" "$S/main"
    printf '%s\n' "$SECRET" > "$S/home/.config/jsb-parity/webhook-url"
    chmod 600 "$S/home/.config/jsb-parity/webhook-url"
    printf '{"current":"rec-1"}\n' > "$S/parity/recordings/index.json"
    ledger "pl-0001:captured:jsb-port-pl-0001"

    write_stub gh <<'STUB'
#!/bin/sh
echo "$*" >> "$JSB_STUB_DIR/log/gh.argv"
[ -e "$JSB_STUB_DIR/fix/gh-fail" ] && exit 1
slug=""
while [ $# -gt 0 ]; do
    [ "$1" = "--head" ] && slug="$2"
    shift
done
f="$JSB_STUB_DIR/fix/gh-$slug.json"
if [ -f "$f" ]; then cat "$f"; else echo '[]'; fi
STUB
    write_stub curl <<'STUB'
#!/bin/sh
echo "$*" >> "$JSB_STUB_DIR/log/curl.argv"
cat >> "$JSB_STUB_DIR/log/curl.stdin"
code=204
[ -f "$JSB_STUB_DIR/fix/curl-code" ] && code=$(cat "$JSB_STUB_DIR/fix/curl-code")
printf '%s' "$code"
STUB
    write_stub pgrep <<'STUB'
#!/bin/sh
echo "$*" >> "$JSB_STUB_DIR/log/pgrep.argv"
[ -e "$JSB_STUB_DIR/fix/automouse-running" ]
STUB
    write_stub launchctl <<'STUB'
#!/bin/sh
echo "$*" >> "$JSB_STUB_DIR/log/launchctl.argv"
if [ "$1" = "list" ]; then
    printf 'PID\tStatus\tLabel\n'
    [ -f "$JSB_STUB_DIR/fix/launchctl-list" ] && cat "$JSB_STUB_DIR/fix/launchctl-list"
fi
exit 0
STUB
    cat > "$S/bin/discord-dm" <<'STUB'
#!/bin/sh
echo "$*" >> "$JSB_STUB_DIR/log/discord-dm.argv"
cat >> "$JSB_STUB_DIR/log/discord-dm.stdin"
code=0
[ -f "$JSB_STUB_DIR/fix/dm-exit" ] && code=$(cat "$JSB_STUB_DIR/fix/dm-exit")
exit "$code"
STUB
    cat > "$S/bin/automouse/run" <<'STUB'
#!/bin/sh
echo "$*" >> "$JSB_STUB_DIR/log/automouse-run.argv"
STUB
    chmod 755 "$S/bin/discord-dm" "$S/bin/automouse/run"
}

# run_watch [args...]: run the watcher in the sandbox. Env seams default to the
# sandbox when unset and pass through unchanged when empty ("VAR= run_watch").
run_watch() {
    local rc
    env HOME="$S/home" PATH="$S/stub:$PATH" TZ=UTC JSB_STUB_DIR="$S" \
        JSB_WATCH_PARITY_DIR="${JSB_WATCH_PARITY_DIR-$S/parity}" \
        JSB_WATCH_BIN="${JSB_WATCH_BIN-$S/bin}" \
        JSB_WATCH_PLANNOW_DIR="${JSB_WATCH_PLANNOW_DIR-$S/plannow}" \
        JSB_WATCH_NOW="${JSB_WATCH_NOW-${NOW:-$BASE}}" \
        "$REPO/bin/jsb-parity-watch" "$@" > "$S/out" 2> "$S/err"
    rc=$?
    printf '%s\n' "$rc" > "$S/rc"
    return 0
}

# run_setup [args...]: run the installer in the sandbox.
run_setup() {
    local rc
    env HOME="$S/home" PATH="$S/stub:$PATH" JSB_STUB_DIR="$S" \
        MAIN_WT="${SETUP_MAIN_WT-$S/main}" REPO_ROOT="${SETUP_REPO_ROOT:-$REPO}" \
        "$REPO/bin/jsb-parity-watch-setup" "$@" > "$S/out" 2> "$S/err"
    rc=$?
    printf '%s\n' "$rc" > "$S/rc"
    return 0
}

reset_logs() { rm -f "$S"/log/*; }
cnt() {
    local f="$S/log/$1.argv"
    if [ -f "$f" ]; then echo $(($(wc -l < "$f"))); else echo 0; fi
}
slurp() { if [ -f "$1" ]; then cat "$1"; fi; }
out() { slurp "$S/out"; }
rc_is() { h_eq "$1" "$2" "$(tr -d '[:space:]' < "$S/rc")"; }

# gh_pr <slug> <number> <state> <armed yes|no> <sha> <rollup-json>
gh_pr() {
    jq -n --argjson n "$2" --arg st "$3" --arg armed "$4" --arg sha "$5" --argjson roll "$6" \
        '[{number: $n, state: $st,
           mergedAt: (if $st == "MERGED" then "2026-11-22T00:00:00Z" else null end),
           url: ("https://github.com/a-jay85/IBL5/pull/" + ($n | tostring)),
           autoMergeRequest: (if $armed == "yes" then {enabledAt: "2026-11-22T00:00:00Z", mergeMethod: "SQUASH"} else null end),
           statusCheckRollup: $roll, headRefOid: $sha}]' > "$S/fix/gh-$1.json"
}

no_actions() {
    h_eq "$1: no webhook call" 0 "$(cnt curl)"
    h_eq "$1: no DM" 0 "$(cnt discord-dm)"
    h_eq "$1: no schedule call" 0 "$(cnt automouse-run)"
}

AM() { printf '%s' "$S/home/$AMDIR"; }

# --- Lock cases (rows 3-6) -------------------------------------------------------

case_lock_held_exits_quiet() {
    sandbox lock_held
    mkdir -p "$S/parity/state/loop.lock"
    printf '%s %s host\n' "$$" "$BASE" > "$S/parity/state/loop.lock/pid"
    run_watch
    rc_is "lock held: exit 0" 0
    h_absent "lock held: gh never called" "$S/log/gh.argv"
    h_contains "lock held: says so" "$(out)" "run lock held"
}

case_lock_stale_dead_pid_proceeds() {
    local dead
    sandbox lock_dead
    dead=$(sh -c 'echo $$')
    mkdir -p "$S/parity/state/loop.lock"
    printf '%s %s host\n' "$dead" "$BASE" > "$S/parity/state/loop.lock/pid"
    run_watch
    rc_is "dead pid: exit 0" 0
    h_exists "dead pid with a fresh epoch is stale: gh called" "$S/log/gh.argv"
}

case_lock_pid0_age_boundary() {
    sandbox lock_pid0
    mkdir -p "$S/parity/state/loop.lock"
    printf '0 %s host\n' $((BASE - 14400)) > "$S/parity/state/loop.lock/pid"
    run_watch
    h_absent "pid 0 at age 14400 is held" "$S/log/gh.argv"
    reset_logs
    printf '0 %s host\n' $((BASE - 14401)) > "$S/parity/state/loop.lock/pid"
    run_watch
    h_exists "pid 0 at age 14401 is stale" "$S/log/gh.argv"
}

case_lock_no_pidfile_mtime() {
    local real
    sandbox lock_nopid
    mkdir -p "$S/parity/state/loop.lock"
    real=$(date +%s)
    NOW=$real run_watch
    h_absent "fresh lock dir with no pid file is held" "$S/log/gh.argv"
    reset_logs
    NOW=$((real + 120)) run_watch
    h_exists "lock dir with no pid file is stale past 60 s" "$S/log/gh.argv"
}

# --- Verdict cases (rows 7-13) ---------------------------------------------------

case_merged_fires() {
    local last
    sandbox merged
    gh_pr jsb-port-pl-0001 7 MERGED no sha1 "$GREEN"
    run_watch
    rc_is "merged: exit 0" 0
    h_eq "merged: one webhook call" 1 "$(cnt curl)"
    last=$(slurp "$S/home/.cache/jsb-parity-watch.last")
    h_contains "merged: fingerprint names the PR" "$last" "pl-0001=7:MERGED:sha1"
    h_contains "merged: fingerprint ends with the run time" "$last" " $BASE"
    h_not_contains "merged: verdict is a fire, not WAIT:merged" "$(out)" "WAIT:merged"
}

case_open_failed_fires_once_per_sha() {
    sandbox failed_sha
    gh_pr jsb-port-pl-0001 42 OPEN no aaa "$ROLL_FAILED"
    run_watch
    h_eq "failed check: fires" 1 "$(cnt curl)"
    reset_logs
    NOW=$((BASE + 25200)) run_watch
    h_eq "same sha past 6 h: stays quiet" 0 "$(cnt curl)"
    gh_pr jsb-port-pl-0001 42 OPEN no bbb "$ROLL_FAILED"
    NOW=$((BASE + 25200)) run_watch
    h_eq "new sha: fires again" 1 "$(cnt curl)"
}

case_open_pending_waits() {
    sandbox pending
    gh_pr jsb-port-pl-0001 42 OPEN no aaa "$PENDING"
    run_watch
    no_actions "pending checks"
    h_contains "pending: verdict is a wait" "$(out)" "WAIT:checks-pending"
}

case_check_verdict_near_miss() {
    sandbox near_green
    gh_pr jsb-port-pl-0001 42 OPEN no aaa "$NEAR_MISS"
    run_watch
    h_eq "SKIPPED and NEUTRAL count as green: held-for-owner DM" 1 "$(cnt discord-dm)"
    h_eq "SKIPPED and NEUTRAL count as green: no webhook" 0 "$(cnt curl)"
    sandbox near_error
    gh_pr jsb-port-pl-0001 42 OPEN no aaa "$ERROR_CTX"
    run_watch
    h_eq "ERROR context counts as failed: webhook" 1 "$(cnt curl)"
    sandbox superseded_ok
    gh_pr jsb-port-pl-0001 42 OPEN no aaa "$SUPERSEDED_OK"
    run_watch
    h_eq "superseded CANCELLED run, later SUCCESS: held-for-owner DM" 1 "$(cnt discord-dm)"
    h_eq "superseded CANCELLED run, later SUCCESS: no webhook" 0 "$(cnt curl)"
    sandbox superseded_bad
    gh_pr jsb-port-pl-0001 42 OPEN no aaa "$SUPERSEDED_BAD"
    run_watch
    h_eq "earlier SUCCESS, later FAILURE of one check: webhook" 1 "$(cnt curl)"
}

case_open_green_armed_waits() {
    sandbox armed
    gh_pr jsb-port-pl-0001 42 OPEN yes aaa "$GREEN"
    run_watch
    no_actions "green and armed"
    h_contains "armed: verdict is a wait" "$(out)" "WAIT:auto-merge-armed"
}

case_open_green_unarmed_stall_dm() {
    sandbox unarmed
    gh_pr jsb-port-pl-0001 42 OPEN no aaa "$GREEN"
    run_watch
    h_eq "green unarmed: one DM" 1 "$(cnt discord-dm)"
    h_contains "DM names the PR" "$(slurp "$S/log/discord-dm.stdin")" "pull/42"
    h_eq "stall key recorded" "pl-0001:held-for-owner:42" "$(slurp "$S/home/.cache/jsb-parity-stalls.txt")"
    reset_logs
    run_watch
    h_eq "rerun sends no second DM" 0 "$(cnt discord-dm)"
}

case_closed_fires() {
    sandbox closed
    gh_pr jsb-port-pl-0001 9 CLOSED no aaa "$GREEN"
    run_watch
    h_eq "closed unmerged: webhook" 1 "$(cnt curl)"
    h_contains "closed: reason names it" "$(slurp "$S/log/curl.argv")" "pl-0001:closed"
    h_not_contains "closed: verdict is a fire, not WAIT:closed" "$(out)" "WAIT:closed"
}

