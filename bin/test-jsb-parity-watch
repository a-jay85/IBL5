}

case_gh_error_no_action() {
    sandbox gh_error
    ledger "pl-0011:captured:jsb-port-pl-0011" "pl-0025:captured:jsb-port-pl-0025"
    gh_pr jsb-port-pl-0011 11 MERGED no s11 "$GREEN"
    : > "$S/fix/gh-fail"
    run_watch
    rc_is "gh failure: exit 0" 0
    no_actions "gh failure"
    h_eq "gh failure: exactly one log line" 1 "$(($(wc -l < "$S/out")))"
    h_contains "gh failure: line says so" "$(out)" "gh pr list failed"
}

case_bad_input_quiet() {
    sandbox bad_input
    rm -f "$S/parity/ledger.json"
    run_watch
    rc_is "missing ledger: exit 0" 0
    h_contains "missing ledger: says so" "$(out)" "ledger missing"
    h_absent "missing ledger: gh never called" "$S/log/gh.argv"
    printf '{not json\n' > "$S/parity/ledger.json"
    run_watch
    rc_is "invalid ledger: exit 0" 0
    h_contains "invalid ledger: no action taken" "$(out)" "no action taken"
    h_absent "invalid ledger: gh never called" "$S/log/gh.argv"
    no_actions "invalid ledger"
    # A rows array of numbers passes the shape check, then breaks the row filter.
    # That failure reaches the ERR trap, which must exit 0 with a log line.
    printf '{"rows":[1]}\n' > "$S/parity/ledger.json"
    run_watch
    rc_is "broken row filter: exit 0" 0
    h_contains "broken row filter: ERR trap logs it" "$(out)" "error at line"
    h_contains "broken row filter: no action taken" "$(out)" "no action taken"
    h_absent "broken row filter: gh never called" "$S/log/gh.argv"
    no_actions "broken row filter"
}

case_curl_failure_no_fingerprint() {
    sandbox curl_fail
    gh_pr jsb-port-pl-0001 7 MERGED no sha1 "$GREEN"
    printf '500' > "$S/fix/curl-code"
    run_watch
    h_absent "HTTP 500: no fingerprint written" "$S/home/.cache/jsb-parity-watch.last"
    h_contains "HTTP 500: logged" "$(out)" "HTTP 500"
    rm -f "$S/fix/curl-code"
    reset_logs
    run_watch
    h_eq "next run with HTTP 204 fires again" 1 "$(cnt curl)"
    h_exists "HTTP 204: fingerprint written" "$S/home/.cache/jsb-parity-watch.last"
}

# --- Safety cases (rows 30-32) -----------------------------------------------------

sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum < "$1"
    else
        shasum -a 256 < "$1"
    fi
}

# no_secret_in <label>: the webhook URL appears in no output, argv, DM or cache file.
no_secret_in() {
    local f leak=0
    for f in "$S/out" "$S/err" "$S"/log/*.argv "$S/log/discord-dm.stdin"; do
        if [ -f "$f" ] && grep -qE -- "T3-SECRET|FIXER-SECRET" "$f"; then leak=1; h_fail "$1: secret leaked into $f"; fi
    done
    if [ -d "$S/home/.cache" ] && grep -rqE -- "T3-SECRET|FIXER-SECRET" "$S/home/.cache"; then leak=1; h_fail "$1: secret leaked into the cache"; fi
    if [ "$leak" = 0 ]; then h_pass "$1: secret stays out of every output"; fi
}

