#!/usr/bin/env bash
# shellcheck shell=bash
#
# test-plan-tier-hint — behavioural harness for the advisory architect-tier
# pre-check, plus the static drift assertions that keep the five copies of the
# /plan Step 3 check-1 trigger in agreement.
#
# The fixture table pins the decision procedure: a gate path alone never
# escalates, a gate path plus a weakening verb does, and directory membership is
# never the trigger. The negative/boundary rows are the ones that go red if the
# implementation regresses to directory-led matching — do not drop them.
#
# Run: bin/test-plan-tier-hint  (exit 0 = all pass, 1 = a case failed)

set -u

# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
# PLAN_TIER_HINT overrides the script under test (mutation check runs master's copy).
HINT="${PLAN_TIER_HINT:-$SCRIPT_DIR/plan-tier-hint}"
h_tmp BASE_TMP

OUT="$BASE_TMP/out"
ERR="$BASE_TMP/err"

expect_eq() { h_eq "$1" "$2" "$3"; } # name want got

expect_exit() { # name want-code got-code
    if [ "$3" -eq "$2" ]; then
        h_pass "$1 (exit $3)"
    else
        h_fail "$1" "expected exit $2, got $3"
        sed 's/^/      | /' "$ERR" 2>/dev/null | head -10
    fi
}

expect_match() { # name pattern file
    if grep -qE "$2" "$3"; then
        h_pass "$1"
    else
        h_fail "$1" "output did not match /$2/"
        sed 's/^/      | /' "$3" 2>/dev/null | head -10
    fi
}

assert_contains() { # name file literal
    if grep -qF "$3" "$ROOT/$2"; then
        h_pass "$1"
    else
        h_fail "$1" "$2 no longer contains the expected text"
    fi
}

assert_absent() { # name file literal
    if grep -qF "$3" "$ROOT/$2"; then
        h_fail "$1" "$2 still contains the retired text"
    else
        h_pass "$1"
    fi
}

echo "== fixture table =="

# 1 — prose-only skill edit does not escalate
expect_eq "1 prose-only skill edit" "default" \
    "$("$HINT" --desc 'prose-only edit to .claude/skills/plan/SKILL.md — rewording the authoring guidance, decision procedure preserved')"

# 2 — gate-condition removal, described in prose only
expect_eq "2 gate-condition removal in prose" "xhigh" \
    "$("$HINT" --desc 'remove the bin/check-plan gate condition that rejects plans over 500 lines')"

# 3 — security surface unchanged
expect_eq "3 security surface" "xhigh" \
    "$("$HINT" --desc 'add authorization checks to the admin trade-approval endpoint')"

# 4 — destructive migration unchanged
expect_eq "4 destructive migration" "xhigh" \
    "$("$HINT" --desc 'migration that will drop column retired and backfill it')"

# 5 — bootstrap hazard
expect_eq "5 bootstrap hazard" "xhigh" \
    "$("$HINT" --desc 'change the Phase 6.5 arming condition so digest-bearing PRs auto-merge')"

# 6 — recipe-backed downgrade
expect_eq "6 recipe-backed downgrade" "sonnet" \
    "$("$HINT" --desc 'recipe-backed marker swap: apply the explicit recipe, copying the existing pattern in the same file')"

# 7 — precedence: check 1 outranks check 2
expect_eq "7 check 1 outranks check 2" "xhigh" \
    "$("$HINT" --desc 'recipe-backed: remove the bin/check-plan gate condition, copying the existing pattern')"

# 8 — additive gate: a gate path with no weakening verb is NOT a trigger
expect_eq "8 additive gate" "default" \
    "$("$HINT" --desc 'add a new bin/check-actions-pinned gate that rejects unpinned actions')"

# 9 — directory alone is never the trigger
expect_eq "9 rules path, no weakening" "default" \
    "$("$HINT" --files .claude/rules/core-coding.md --desc 'reword a rule for clarity')"

# 10 — --files and --desc share one haystack
expect_eq "10 files and desc share one haystack" "xhigh" \
    "$("$HINT" --files bin/check-plan --desc 'relax the phase-count limit')"

# 11 — a non-gate bin/ path does not escalate
expect_eq "11 non-gate bin path" "default" \
    "$("$HINT" --files bin/wt-new --desc 'add a --base flag')"

# 12 — bare-auth regression guard
expect_eq "12 authoring is not an auth keyword" "default" \
    "$("$HINT" --desc 'authoring a new ADR about plan authorship')"

# 13 — stdin is equivalent to --desc
expect_eq "13 description on stdin" "xhigh" \
    "$(printf 'remove the bin/check-plan gate condition' | "$HINT")"

# 14 — --explain names a non-empty reason after a TAB
TAB="$(printf '\t')"
"$HINT" --desc 'remove the bin/check-plan gate condition' --explain > "$OUT" 2>"$ERR"
expect_match "14 explain emits tier TAB reason" "^xhigh${TAB}.+" "$OUT"

# 15 — empty input fails loudly, never silently defaults
"$HINT" > "$OUT" 2>"$ERR" </dev/null
expect_exit "15 empty input exits 2" 2 "$?"
expect_eq "15 empty input prints nothing on stdout" "" "$(cat "$OUT")"
expect_match "15 empty input prints usage on stderr" '^Usage:' "$ERR"

echo
echo "== audited task lines, 2026-10-18..24 xhigh routing audit =="

# 16 — class H1 (audit row 13): additive gate, 'deleted' is an adjective
expect_eq "16 audit row 13 additive gate with deleted symbol" "default" \
    "$("$HINT" --desc 'Add a /plan rule and an additive bin/check-plan gate requiring Verification Matrix rows that assert a deleted symbol stays absent to point at an in-repo test or CI-wired bin/check-* script instead of a plan-only CLI command')"

# 17 — class H2 (audit row 02): escape names an existing defense on a pinned split
expect_eq "17 audit row 02 pinned split with escaped output" "default" \
    "$("$HINT" --desc 'Split TradeRosterPreviewCashRowBuilder::buildCashRows into a cash-collection helper and one table-driven row builder, after pinning its HTML-escaped label output.')"

# 18 — class D1 (audit row 01): already default; pins that it stays there
expect_eq "18 audit row 01 byte-pinned rendering split" "default" \
    "$("$HINT" --desc 'Split TeamTableService::getTableOutput into roster, starters and view-wrapper helpers after pinning its tab and dropdown wrapper output byte-for-byte.')"

# 19 — class D1 (audit row 29): already default; pins that it stays there
expect_eq "19 audit row 29 characterization-pinned table-drive" "default" \
    "$("$HINT" --desc 'Pin FreeAgencyProcessor::parseOfferData for every offer type with characterization tests, then table-drive its offer1-6 ladder.')"

# 20-24 — boundary: the H1/H2 carve-outs must not swallow a real trigger
expect_eq "20 additive gate plus a real removal stays xhigh" "xhigh" \
    "$("$HINT" --desc 'Add an additive bin/check-plan gate and remove the 500-line condition')"
expect_eq "21 additive gate plus relax on a deleted row stays xhigh" "xhigh" \
    "$("$HINT" --desc 'Add an additive bin/check-plan gate and relax the deleted-row check')"
expect_eq "22 row 02 line plus authorization stays xhigh" "xhigh" \
    "$("$HINT" --desc 'Split TradeRosterPreviewCashRowBuilder::buildCashRows into helpers after pinning its HTML-escaped label output, and add an authorization check')"
expect_eq "23 escape fix with no pin stays xhigh" "xhigh" \
    "$("$HINT" --desc 'fix the missing HTML escape on the player bio output')"
expect_eq "24 pinned split that fixes unescaped output stays xhigh" "xhigh" \
    "$("$HINT" --desc 'Split PlayerBioRenderer::render after pinning its output byte-for-byte, and fix the unescaped player names')"

# 25-26 — audited true triggers keep firing
expect_eq "25 audit row 15 auth-gated POST stays xhigh" "xhigh" \
    "$("$HINT" --desc 'Tighten authorization on the auth-gated draft selection POST endpoint so only the team owning the on-the-clock pick can submit, and rename the misnamed `wildCards` in ProjectedDraftOrder.')"
expect_eq "26 audit row 22 gate weakening stays xhigh" "xhigh" \
    "$("$HINT" --desc 'Weaken the required All checks settled merge gate (bin/check-pr-checks-green V4 condition) so a ghost workflow run whose jobs all completed no longer holds it')"

expect_eq "26b pinned split that drops the escaping stays xhigh" "xhigh" \
    "$("$HINT" --desc 'Split TradeRosterPreviewCashRowBuilder::buildCashRows into helpers after pinning its output, and drop the HTML escape on labels')"
expect_eq "26c pinned split rendering without escaping stays xhigh" "xhigh" \
    "$("$HINT" --desc 'Split PlayerBioRenderer::render after pinning its output, and render names without escaping')"
expect_eq "26d pinned split that adds escaping stays xhigh" "xhigh" \
    "$("$HINT" --desc 'Split PlayerBioRenderer::render into helpers after pinning its output byte-for-byte, and escape the raw team names')"
expect_eq "26e pinned split that HTML-escapes new output stays xhigh" "xhigh" \
    "$("$HINT" --desc 'Split PlayerBioRenderer::render into helpers after pinning its output byte-for-byte, and HTML-escape the raw team names')"
# 27 — PIN_RE conjunct: escape on a split with no pin stays xhigh
expect_eq "27 escape on an unpinned split stays xhigh" "xhigh" \
    "$("$HINT" --desc 'Split the player bio renderer into helpers and escape the team name')"
# 27b — NEGATED_PIN_RE: "unpinned" and "without characterization" are no pin
expect_eq "27b unpinned split with escaped output stays xhigh" "xhigh" \
    "$("$HINT" --desc 'Split the unpinned PlayerBioRenderer::render, whose output is HTML-escaped, into helpers')"
expect_eq "27c split without characterization tests stays xhigh" "xhigh" \
    "$("$HINT" --desc 'Split X into helpers without characterization tests; its labels are escaped')"
# 28 — RESTRUCTURE_RE conjunct: pinned escape change with no restructure stays xhigh
expect_eq "28 pinned escape change with no restructure stays xhigh" "xhigh" \
    "$("$HINT" --desc 'Escape the team name in the player bio output after pinning its current output')"
# 29b — passive-voice removal is a real weakening, not an adjective
expect_eq "29b additive gate plus passive removal stays xhigh" "xhigh" \
    "$("$HINT" --desc 'Add an additive bin/check-plan gate; the 500-line condition gets removed')"
# 29 — ADDITIVE_RE conjunct: a participle weakening without the additive marker stays xhigh
expect_eq "29 participle weakening without additive stays xhigh" "xhigh" \
    "$("$HINT" --desc 'make bin/check-plan stop failing plans whose rows cite removed files')"

echo
echo "== 2026-10-27 corpus: real arming-condition weakenings stay xhigh =="

# Verbatim first lines from the plan-now corpus. Each lets an input a Phase 6.5
# arming condition held before now pass, so each must keep reaching Fable.
expect_eq "30a corpus 134111 narrow arming condition (3) stays xhigh" "xhigh" \
    "$("$HINT" --desc '/plan Narrow Phase 6.5 arming condition (3) so post-plan stops holding on a MISSING item when a plan matrix row names a file only as a reference or environment location that the plan says gets no edit.')"
expect_eq "30b corpus 144516 narrow arming condition (14) stays xhigh" "xhigh" \
    "$("$HINT" --desc '/plan Narrow Phase 6.5 arming condition (14) so a leftover /tmp/postplan-conflict-resolved-<slug> marker from an earlier post-plan run stops holding a PR whose current rebase was clean.')"
expect_eq "30c corpus 191125 relaxing arming condition (17) stays xhigh" "xhigh" \
    "$("$HINT" --desc '/plan Make gate-backtest count a false flag only when the head gate flags and the base-ref gate does not, relaxing arming condition (17) (backlog#1672)')"
expect_eq "30d corpus 115439 weaken arming condition (9) stays xhigh" "xhigh" \
    "$("$HINT" --desc '/plan Weaken arming condition (9) and the destructive-migration gate so SQL comments no longer trip them, and tighten the LLM one-way door bar in armable.py and pr-armable.sh')"

echo
echo "== 2026-10-27 corpus: keyword-only and additive tasks hint default =="

expect_eq "31a corpus 113618 review threads before auto-merge is default" "default" \
    "$("$HINT" --desc '/plan Make /post-plan reply to and resolve every PR review thread before arming auto-merge, and flag "armed + unresolved thread" PRs in bin/pr-triage and the merge digest, so GitHub'"'"'s "Require conversation resolution before merging" can be enabled on master safely.')"
expect_eq "31b corpus 114441 state-changed plumbing is default" "default" \
    "$("$HINT" --desc '/plan Make post-plan'"'"'s `--state-changed` flag reach the compiled harness so its early hold-repeat check stops declining PRs that pr-cycle sent because they have new conflicts or red CI')"
expect_eq "31c corpus 153924 branch-name-agnostic is default" "default" \
    "$("$HINT" --desc '/plan Make every script, workflow, hook, gate and Phase 6.5 arming condition branch-name-agnostic so the default branch can be renamed from master to main without breaking anything')"
expect_eq "31d explain names check 1c for a pipeline weakening" "check 1c" \
    "$("$HINT" --explain --desc 'Narrow Phase 6.5 arming condition (3) so post-plan stops holding on a MISSING item' | cut -f2 | cut -c1-8)"

echo
echo "== each dropped keyword: additive default, weakening xhigh =="

expect_eq "32a auto-merge additive hold is default" "default" \
    "$("$HINT" --desc 'Add a hold that blocks auto-merge on PRs whose diff has deleted test files')"
expect_eq "32b auto-merge relaxed is xhigh" "xhigh" \
    "$("$HINT" --desc 'Relax the auto-merge hold for docs-only PRs')"
expect_eq "32c so-PRs-auto-merge is xhigh" "xhigh" \
    "$("$HINT" --desc 'change the merge policy so digest-bearing PRs auto-merge')"
expect_eq "33a human signoff added is default" "default" \
    "$("$HINT" --desc 'Add a human signoff hold for PRs that touch the migrations directory')"
expect_eq "33b human signoff exempted is xhigh" "xhigh" \
    "$("$HINT" --desc 'Exempt chore PRs from the human signoff floor')"
expect_eq "34a phase 6.5 tightened is default" "default" \
    "$("$HINT" --desc 'Tighten Phase 6.5 so a PR with a stale plan file is held')"
expect_eq "34b phase 6.5 stops holding is xhigh" "xhigh" \
    "$("$HINT" --desc 'Make Phase 6.5 stop holding PRs whose only failure is a flaky e2e shard')"
expect_eq "35a new arming condition is default" "default" \
    "$("$HINT" --desc 'Add a new arming condition that holds PRs touching workflow files')"
expect_eq "35b arming condition no longer holds is xhigh" "xhigh" \
    "$("$HINT" --desc 'Narrow arming condition (12) so it no longer holds docs-only PRs')"
expect_eq "35c arming condition lets X pass is xhigh" "xhigh" \
    "$("$HINT" --desc 'Change arming condition (5) so it lets digest-only PRs pass')"

echo
echo "== terminology near-misses =="

expect_eq "36a narrows what passes is default" "default" \
    "$("$HINT" --desc 'Tighten arming condition (4) so it narrows what passes to green-CI PRs only')"
expect_eq "36b tighten one condition and relax another is xhigh" "xhigh" \
    "$("$HINT" --desc 'Tighten arming condition (4) and relax arming condition (6)')"
expect_eq "36c adds a hold and stops holding is xhigh" "xhigh" \
    "$("$HINT" --desc 'Add a hold for unsigned commits and make Phase 6.5 stop holding PRs with a stale digest')"

echo
echo "== security and destructive token qualifiers =="

expect_eq "37a slop-ok escape hatch doc is default" "default" \
    "$("$HINT" --desc 'Document the slop-ok escape hatch in the prose-style rule')"
expect_eq "37b gate escape hatch reaches check 1c" "check 1c" \
    "$("$HINT" --explain --desc 'Add an escape hatch to bin/check-prose for quoted transcripts' | cut -f2 | cut -c1-8)"
expect_eq "37c escape hatch around csrf stays check 1a" "check 1a" \
    "$("$HINT" --explain --desc 'Add an escape hatch that skips the CSRF check on the trade form' | cut -f2 | cut -c1-8)"
expect_eq "37d pre-authorized shipping is default" "default" \
    "$("$HINT" --desc 'Make post-plan shipping pre-authorized for branches this session created')"
expect_eq "38a truncate prose is default" "default" \
    "$("$HINT" --desc 'Truncate long Discord DM bodies to 2000 characters')"
expect_eq "38b truncate a table is xhigh" "xhigh" \
    "$("$HINT" --desc 'TRUNCATE ibl_box_scores before the reimport')"
expect_eq "38c delete from prose is default" "default" \
    "$("$HINT" --desc 'Delete from the backlog any issue already merged')"
expect_eq "38d delete from a table is xhigh" "xhigh" \
    "$("$HINT" --desc 'DELETE FROM ibl_plr_snapshots WHERE season < 2000')"

echo
echo "== static drift assertions (five copies of the trigger) =="

assert_contains "canonical states the behavioural test" \
    '.claude/skills/plan/SKILL.md' 'previously rejected now passes'
assert_absent "canonical has no dangling clause reference" \
    '.claude/skills/plan/SKILL.md' 'clause 4'
assert_absent "safety mirror is no longer directory-led" \
    '.claude/rules/work-triage.md' 'ship-pipeline surface'
assert_contains "tiers table points at the canonical check" \
    '.claude/rules/agent-tiering.md' '/plan` Step 3 check 1'
assert_contains "plan-prompt points at the canonical check" \
    '.claude/skills/plan-prompt/SKILL.md' '/plan` Step 3 check 1'
assert_contains "agent def carries the directory clause" \
    '.claude/agents/plan-architect-xhigh.md' 'Directory alone is never the trigger'
# Bash 3.2 guard (macOS /bin/bash): the hint lowercases with tr, never with ${HAY,,}.
assert_absent "hint avoids the Bash-4 lowercase expansion" \
    'bin/plan-tier-hint' '${HAY,,}'
assert_contains "canonical carries the pinned-restructure carve-out" \
    '.claude/skills/plan/SKILL.md' 'Pinned restructure of a security surface'
assert_contains "plan-prompt points at the pinned-restructure carve-out" \
    '.claude/skills/plan-prompt/SKILL.md' 'characterization-pinned split'

h_done
