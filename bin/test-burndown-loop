        "backlog empty (sentinel confirmed first round LEDGER: none); --once ends the run"
    assert_not_contains test_empty_once_exits_zero:no-sleep "$OUT" "reason=backlog-empty"
    assert_no_file test_empty_once_exits_zero:no-dm "$T/dm.calls"
}

test_empty_sentinel_with_ledger_ran() {
