    printf '%s' '"home_teamid":2,"game_of_that_day":1,"box_id":null,"sort_order":1,"recap_text":"'
    # shellcheck disable=SC2183  # intentional: printf '%280s' pads with spaces (no args = empty string pads to width)
    printf '%280s' | tr ' ' 'x'
    printf '%s' '"}]}'
} > "$STUB/resp.payload"
srt_run
