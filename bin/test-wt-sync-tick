# ── Test 27: only: FETCH-FAILED under fetch timeout ───────────────────────────
MAIN27="$(new_env)"
WT27="$(add_worktree "$MAIN27" "wt-ff27" current)"
STUBBIN27="$TMP/stubbin27"
mkdir -p "$STUBBIN27"
cp "$STUBBIN/ioreg" "$STUBBIN27/ioreg"
cp "$STUBBIN/lsof" "$STUBBIN27/lsof"
# Capture real git path before STUBBIN swap — STUBBIN only has ioreg/lsof, not git.
REAL_GIT27="$(command -v git)"
cat > "$STUBBIN27/git" <<SH
#!/bin/sh
for _a; do
    case "\$_a" in fetch) sleep 30; exit 0;; esac
done
exec "$REAL_GIT27" "\$@"
SH
chmod +x "$STUBBIN27/git"
STUBBIN_SAVE27="$STUBBIN"
STUBBIN="$STUBBIN27"
ONLY_ST=0; ONLY_ERR="$TMP/only27.err"
ONLY_OUT="$(WT_SYNC_FETCH_TIMEOUT=1 PATH="$STUBBIN:$PATH" \
            WT_SYNC_IOREG="$STUBBIN/ioreg" \
            WT_SYNC_LOG="$_TICK_LOG" WT_SYNC_LOCK_DIR="$_TICK_LOCKD" \
            WT_SYNC_ENABLED=1 \
            "$TICK" --only "$WT27" 2>"$ONLY_ERR")" || ONLY_ST=$?
STUBBIN="$STUBBIN_SAVE27"
assert_eq "only: FETCH-FAILED stdout"  "FETCH-FAILED" "$ONLY_OUT"
assert_eq "only: FETCH-FAILED exit 0"  "0"            "$ONLY_ST"

