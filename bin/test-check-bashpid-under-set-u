#!/usr/bin/env bash
[ "${BASH_VERSINFO[0]:-0}" -ge 4 ] || { printf '%s: bash 4+ required (this is bash %s). Run: brew install bash\n' "${0##*/}" "${BASH_VERSION:-?}" >&2; exit 2; }
set -euo pipefail

# Test harness for bin/check-bashpid-under-set-u (the bash-4-only BASHPID gate).
# Follows bin/test-check-shell-portability style.
#
# Every fixture lives in a mktemp dir; nothing is written inside the IBL5 tree.
# Fixture lines are built by concatenation (BP='BASH''PID'), so this file holds no
# literal bare read and the gate passes on its own file.

PASS=0
FAIL=0

pass() { echo "PASS: $1"; PASS=$((PASS + 1)); }
fail() { echo "FAIL: $1"; FAIL=$((FAIL + 1)); }

DIR=$(mktemp -d)
trap 'rm -rf "$DIR"' EXIT

BIN="$(cd "$(dirname "$0")" && pwd)"
SCRIPT="$BIN/check-bashpid-under-set-u"
BP='BASH''PID'
D='$'
SB='#!/bin/bash'
FX="$DIR/fixture.sh"

mk() { local out="$1"; shift; printf '%s\n' "$@" > "$out"; }
run_gate() { set +e; OUT=$("$SCRIPT" "$@" 2>&1); RC=$?; set -e; }
expect() { # name want_rc want_substring
    if [ "$RC" -eq "$2" ]; then
        case "$OUT" in *"$3"*) pass "$1"; return 0 ;; esac
    fi
    fail "$1 (rc=$RC, want rc=$2 and '$3'; output: $OUT)"
}
# case_fx name want_rc substring line...   (writes $FX as shebang + lines, scans it)
case_fx() {
    local name="$1" rc="$2" sub="$3"
    shift 3
    mk "$FX" "$SB" "$@"
    run_gate --files "$FX"
    expect "$name" "$rc" "$sub"
}

# Failing shapes (the PR 3937 occurrences: a bare read under set -u).
case_fx bare-dollar 1 'fixture.sh:2:' "tmp=/tmp/x.${D}${BP}"
case_fx bare-braced 1 'fixture.sh:2:' "tmp=/tmp/x.${D}{${BP}}"
case_fx bare-end-of-line 1 'fixture.sh:2:' "echo ${D}${BP}"
case_fx bare-before-punct 1 'fixture.sh:2:' "echo \"pid-${D}${BP}.log\""
case_fx bare-colon-error-op 1 'fixture.sh:2:' "echo ${D}{${BP}:?}"
case_fx bare-substring-op 1 'fixture.sh:2:' "echo ${D}{${BP}/1/2}"
case_fx bare-error-op 1 'fixture.sh:2:' "echo ${D}{${BP}?}"
case_fx bare-length 1 'fixture.sh:2:' "echo ${D}{#${BP}}"
case_fx bare-index 1 'fixture.sh:2:' "echo ${D}{${BP}[0]}"
case_fx bare-after-trailing-comment 1 'fixture.sh:3:' 'x=1  # fine' "echo ${D}${BP}"
case_fx fix-hint-printed 1 'fix: write' "echo ${D}${BP}"

# Passing shapes.
case_fx colon-default 0 'OK' "tmp=/tmp/x.${D}{${BP}:-${D}${D}}"
case_fx colon-default-empty 0 'OK' "tmp=${D}{${BP}:-}"
case_fx dash-default 0 'OK' "tmp=${D}{${BP}-}"
case_fx plus-alternate 0 'OK' "tmp=${D}{${BP}:+yes}"
case_fx comment-line 0 'OK' "# uses ${D}${BP} and ${D}{${BP}} here"
case_fx indented-comment 0 'OK' "    # ${D}${BP}"
case_fx trailing-comment 0 'OK' "x=1  # ${D}${BP}"
case_fx longer-name 0 'OK' "echo ${D}${BP}_X ${D}{${BP}X}"

# Scope: non-shell files are skipped, a shebang-only shell file is scanned.
mk "$DIR/tool.py" '#!/usr/bin/env python3' "x = '${D}${BP}'"
run_gate --files "$DIR/tool.py"
expect non-shell-skipped 0 'OK'
mk "$DIR/noext" '#!/usr/bin/env bash' "echo ${D}${BP}"
run_gate --files "$DIR/noext"
expect shebang-only-scanned 1 'noext:2:'

# Usage errors.
run_gate --bogus
expect usage-unknown-flag 2 'unknown option'
run_gate --files
expect usage-files-empty 2 '--files needs'
run_gate --files "$DIR/missing"
expect usage-missing-file 2 'no such file'
run_gate --help
expect help-exits-0 0 'usage:'

# The real tree passes (every current use is a comment).
run_gate
expect real-tree-passes 0 'OK'

echo ""
echo "Results: $PASS passed, $FAIL failed"
[ "$FAIL" -eq 0 ] || exit 1
