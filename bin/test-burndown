# ── C48: bare repo paths join the overlap key set ─────────────────────────────
# Unit seam: run bd_load_repo_files + bd_paths_for in a subshell, print _bd_paths.
bd_paths_probe() (
    eval "$(grep -E '^FILE_LINE_RE=' "$SCRIPT")"
    # shellcheck source=/dev/null
    . "$(dirname "$SCRIPT")/lib/burndown.sh"
    BD_TMP="$(mktemp -d)"
    trap 'rm -rf "$BD_TMP"' EXIT
    # shellcheck disable=SC2034  # read by bd_load_repo_files
    BD_GIT=git
    # shellcheck disable=SC2034
    BD_REPO_ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
    bd_load_repo_files
    bd_paths_for "$1"
    # shellcheck disable=SC2154  # _bd_paths is set by bd_paths_for
    printf '%s' "$_bd_paths"
)
[ "$(bd_paths_probe "see bin/lib/burndown.sh.")" = "bin/lib/burndown.sh" ] \
    && ok "C48a: bare tracked path counted, period stripped" \
    || fail "C48a: bare tracked path counted, period stripped"
[ -z "$(bd_paths_probe "and/or https://github.com/a-jay85/IBL5/pull/12 bin/no-such-dir/x.sh")" ] \
    && ok "C48b: nonexistent slash tokens ignored" \
    || fail "C48b: nonexistent slash tokens ignored"
[ "$(bd_paths_probe "bin/a:1 only")" = "bin/a" ] \
    && ok "C48c: path:line of a nonexistent file still counts" \
    || fail "C48c: path:line of a nonexistent file still counts"
[ "$(bd_paths_probe "bin/backlog:12 and ./bin/backlog")" = "bin/backlog" ] \
    && ok "C48d: bare plus path:line dedupe, ./ stripped" \
    || fail "C48d: bare plus path:line dedupe, ./ stripped"

# C48e: bare path creates overlap between two issues
cat > "$T/fx/issues.json" <<'JSON'
[
  {"number":100,"title":"Hundred","body":"touches bin/lib/burndown.sh","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":101,"title":"Hundred-one","body":"bin/lib/burndown.sh:5 fix","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]}
]
JSON
OUT="$(bd_b 2>&1)"; RC=$?
grep -qE 'SKIP +#101 .*overlap with #100 on bin/lib/burndown.sh' <<< "$OUT" \
    && grep -qE 'PICK +#100' <<< "$OUT" \
    && ok "C48e: bare path creates overlap" || fail "C48e: bare path creates overlap (got: $OUT)"

