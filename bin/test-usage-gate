#!/usr/bin/env bash
# Unit and CLI tests for the usage-limit drain/pause/resume gate.
# Phases 1-8 of usage-limit-drain-resume extend this file.
#
# Every test points IBL5_USAGE_GATE_STATE_DIR at a fresh mktemp dir so the real
# state dir is never written, and shadows `security` / `curl` on PATH so the real
# keychain and network are never touched.

set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PASS=0
FAIL=0
FAILED_NAMES=""

pass() { PASS=$((PASS + 1)); echo "  ok   $1"; }
fail() { FAIL=$((FAIL + 1)); FAILED_NAMES="$FAILED_NAMES $1"; echo "  FAIL $1${2:+ — $2}"; }

assert_eq() {  # name expected actual
    if [ "$2" = "$3" ]; then pass "$1"; else fail "$1" "expected [$2] got [$3]"; fi
}
assert_contains() {  # name haystack needle
    case "$2" in *"$3"*) pass "$1" ;; *) fail "$1" "missing [$3] in [$2]" ;; esac
}
assert_file() {  # name path
    if [ -e "$2" ]; then pass "$1"; else fail "$1" "missing file $2"; fi
}
assert_no_file() {  # name path
    if [ ! -e "$2" ]; then pass "$1"; else fail "$1" "unexpected file $2"; fi
}

TMPROOT=$(mktemp -d)
trap 'rm -rf "$TMPROOT"' EXIT

# make_stub_bin <dir> <token|""> <curl-body> [curl-exit]
# PATH-shadowed `security` and `curl`. curl appends a line to <dir>/curl.calls.
make_stub_bin() {
    local dir="$1" tok="$2" body="$3" rc="${4:-0}"
    mkdir -p "$dir"
    if [ -n "$tok" ]; then
        printf '#!/bin/sh\necho '"'"'{"claudeAiOauth":{"accessToken":"%s"}}'"'"'\n' "$tok" > "$dir/security"
    else
        printf '#!/bin/sh\nexit 1\n' > "$dir/security"
    fi
    printf '%s' "$body" > "$dir/curl.body"
    printf '#!/bin/sh\necho call >> "%s/curl.calls"\ncat "%s/curl.body"\nexit %s\n' "$dir" "$dir" "$rc" > "$dir/curl"
    chmod +x "$dir/security" "$dir/curl"
}

curl_calls() {  # <stubdir>
    if [ -f "$1/curl.calls" ]; then wc -l < "$1/curl.calls" | tr -d ' '; else echo 0; fi
}

BODY_A='{"five_hour":{"utilization":41.0,"resets_at":"2026-09-28T20:00:00.123+00:00"},"seven_day":{"utilization":12.0,"resets_at":"2026-10-02T00:00:00+00:00"}}'
BODY_B='{"five_hour":{"utilization":77.0,"resets_at":"2026-09-28T21:00:00+00:00"},"seven_day":{"utilization":30.0,"resets_at":"2026-10-02T00:00:00+00:00"}}'

# new_env: fresh state dir + stub dir, exported for the current test.
new_env() {
    T=$(mktemp -d "$TMPROOT/t.XXXXXX")
    export IBL5_USAGE_GATE_STATE_DIR="$T/state"
    STUB="$T/stub"
    mkdir -p "$IBL5_USAGE_GATE_STATE_DIR/markers"
    ORIG_PATH="${ORIG_PATH:-$PATH}"
}

seed_cache() {  # <fetched_at> <body>
    printf '%s' "$2" | jq --argjson t "$1" '. + {fetched_at:$t}' > "$IBL5_USAGE_GATE_STATE_DIR/cache.json"
}

# ---------------------------------------------------------------- Phase 1

test_fetch_fresh_cache_hit() {
    new_env
    make_stub_bin "$STUB" tok "$BODY_B" 1
    seed_cache "$(date +%s)" "$BODY_A"
    local out rc
    out=$(PATH="$STUB:$ORIG_PATH" bash -c ". '$REPO_ROOT/bin/lib/usage-fetch.sh'; usage_fetch 45"); rc=$?
    assert_eq fetch_fresh_cache_hit:rc 0 "$rc"
    assert_eq fetch_fresh_cache_hit:body "$(printf '%s' "$BODY_A" | jq -S -c .)" "$(printf '%s' "$out" | jq -S -c .)"
    assert_eq fetch_fresh_cache_hit:no-curl 0 "$(curl_calls "$STUB")"
}

test_fetch_stale_triggers_live() {
    new_env
    make_stub_bin "$STUB" tok "$BODY_B"
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    local out rc
    out=$(PATH="$STUB:$ORIG_PATH" bash -c ". '$REPO_ROOT/bin/lib/usage-fetch.sh'; usage_fetch 45"); rc=$?
    assert_eq fetch_stale_triggers_live:rc 0 "$rc"
    assert_eq fetch_stale_triggers_live:body 77.0 "$(printf '%s' "$out" | jq -r '.five_hour.utilization')"
    assert_eq fetch_stale_triggers_live:cache 77.0 "$(jq -r '.five_hour.utilization' "$IBL5_USAGE_GATE_STATE_DIR/cache.json")"
    assert_eq fetch_stale_triggers_live:one-call 1 "$(curl_calls "$STUB")"
}

test_fetch_no_token_fail_open() {
    new_env
    make_stub_bin "$STUB" "" "$BODY_B"
    local out rc
    out=$(PATH="$STUB:$ORIG_PATH" bash -c ". '$REPO_ROOT/bin/lib/usage-fetch.sh'; usage_fetch 45"); rc=$?
    assert_eq fetch_no_token:rc 1 "$rc"
    assert_eq fetch_no_token:empty "" "$out"
    assert_contains fetch_no_token:log "$(cat "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log")" "fetch-failed reason=no-token"
    assert_eq fetch_no_token:no-curl 0 "$(curl_calls "$STUB")"
}

test_fetch_bad_body_serves_stale() {
    new_env
    make_stub_bin "$STUB" tok '{"error":"x"}'
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    local before out rc
    before=$(cat "$IBL5_USAGE_GATE_STATE_DIR/cache.json")
    out=$(PATH="$STUB:$ORIG_PATH" bash -c ". '$REPO_ROOT/bin/lib/usage-fetch.sh'; usage_fetch 45"); rc=$?
    assert_eq fetch_bad_body:rc 2 "$rc"
    assert_eq fetch_bad_body:stale 41.0 "$(printf '%s' "$out" | jq -r '.five_hour.utilization')"
    assert_contains fetch_bad_body:log "$(cat "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log")" "reason=bad-body"
    assert_eq fetch_bad_body:cache-unchanged "$before" "$(cat "$IBL5_USAGE_GATE_STATE_DIR/cache.json")"
}

test_fetch_rejects_bad_max_age() {
    new_env
    local err rc
    err=$(bash -c ". '$REPO_ROOT/bin/lib/usage-fetch.sh'; usage_fetch abc" 2>&1 >/dev/null); rc=$?
    assert_eq fetch_bad_max_age:abc-rc 1 "$rc"
    assert_contains fetch_bad_max_age:abc-msg "$err" "usage_fetch: max_age must be an integer"
    err=$(bash -c ". '$REPO_ROOT/bin/lib/usage-fetch.sh'; usage_fetch" 2>&1 >/dev/null); rc=$?
    assert_eq fetch_bad_max_age:none-rc 1 "$rc"
    assert_contains fetch_bad_max_age:none-msg "$err" "usage_fetch: max_age must be an integer"
}

test_state_dir_env_unset() {
    new_env
    local h out
    h=$(mktemp -d "$TMPROOT/home.XXXXXX")
    out=$(env -u IBL5_USAGE_GATE_STATE_DIR HOME="$h" bash -c ". '$REPO_ROOT/bin/lib/usage-fetch.sh'; usage_state_dir")
    assert_eq state_dir_env_unset "$h/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/usage-gate" "$out"
}

test_state_dir_env_empty() {
    new_env
    local h out
    h=$(mktemp -d "$TMPROOT/home.XXXXXX")
    out=$(IBL5_USAGE_GATE_STATE_DIR="" HOME="$h" bash -c ". '$REPO_ROOT/bin/lib/usage-fetch.sh'; usage_state_dir")
    assert_eq state_dir_env_empty "$h/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/usage-gate" "$out"
}

# ---------------------------------------------------------------- Phase 2

# gate_run <bash-snippet>: run a snippet with usage-gate.sh sourced.
gate_run() {
    bash -c ". '$REPO_ROOT/bin/lib/usage-gate.sh'; $1"
}

usage_json() {  # <five> <week>
    printf '{"five_hour":{"utilization":%s,"resets_at":"2026-09-28T20:00:00.123+00:00"},"seven_day":{"utilization":%s,"resets_at":"2026-10-02T00:00:00+00:00"}}' "$1" "$2"
}

SID_A=11111111-1111-4111-8111-111111111111
SID_B=22222222-2222-4222-8222-222222222222
SID_C=33333333-3333-4333-8333-333333333333
SID_D=44444444-4444-4444-8444-444444444444

test_zone_boundaries() {
    new_env
    assert_eq zone:92.99 normal "$(gate_run "usage_zone '$(usage_json 92.99 0)'")"
    assert_eq zone:93.0 drain "$(gate_run "usage_zone '$(usage_json 93.0 0)'")"
    assert_eq zone:97.99 drain "$(gate_run "usage_zone '$(usage_json 97.99 0)'")"
    assert_eq zone:98.0 stop "$(gate_run "usage_zone '$(usage_json 98.0 0)'")"
    assert_eq zone:100 stop "$(gate_run "usage_zone '$(usage_json 100 0)'")"
    assert_eq zone:weekly-max drain "$(gate_run "usage_zone '$(usage_json 10 95)'")"
}

test_thresholds_env_unset() {
    new_env
    assert_eq thresholds_unset "93 98" "$(env -u IBL5_USAGE_DRAIN_PCT -u IBL5_USAGE_STOP_PCT bash -c ". '$REPO_ROOT/bin/lib/usage-gate.sh'; usage_thresholds")"
}

test_thresholds_env_empty() {
    new_env
    assert_eq thresholds_empty "93 98" "$(IBL5_USAGE_DRAIN_PCT="" IBL5_USAGE_STOP_PCT="" bash -c ". '$REPO_ROOT/bin/lib/usage-gate.sh'; usage_thresholds")"
}

test_thresholds_env_invalid() {
    new_env
    assert_eq thresholds_inverted "93 98" "$(IBL5_USAGE_DRAIN_PCT=99 IBL5_USAGE_STOP_PCT=98 gate_run usage_thresholds)"
    assert_contains thresholds_inverted:log "$(cat "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log")" "bad-thresholds drain=99 stop=98"
    assert_eq thresholds_alpha "93 98" "$(IBL5_USAGE_DRAIN_PCT=abc gate_run usage_thresholds)"
    assert_eq thresholds_custom "80 90" "$(IBL5_USAGE_DRAIN_PCT=80 IBL5_USAGE_STOP_PCT=90 gate_run usage_thresholds)"
    assert_eq thresholds_custom:zone drain "$(IBL5_USAGE_DRAIN_PCT=80 IBL5_USAGE_STOP_PCT=90 gate_run "usage_zone '$(usage_json 85 0)'")"
}

test_resets_epoch_formats() {
    new_env
    local a b n
    a=$(gate_run "usage_resets_epoch '{\"five_hour\":{\"resets_at\":\"2026-09-28T20:00:00.123+00:00\"}}' five_hour")
    b=$(gate_run "usage_resets_epoch '{\"five_hour\":{\"resets_at\":\"2026-09-28T20:00:00Z\"}}' five_hour")
    n=$(gate_run "usage_resets_epoch '{\"five_hour\":{\"resets_at\":null}}' five_hour")
    assert_eq resets_epoch:fraction-eq-z "$a" "$b"
    assert_eq resets_epoch:value 1790625600 "$a"
    assert_eq resets_epoch:null "" "$n"
}

test_limiting_window_tie() {
    new_env
    assert_eq limiting_window:tie seven_day "$(gate_run "usage_limiting_window '$(usage_json 50 50)'")"
    assert_eq limiting_window:five five_hour "$(gate_run "usage_limiting_window '$(usage_json 60 50)'")"
}

test_marker_write_read_clear() {
    new_env
    local rbin="$T/resume.sh"
    printf '#!/bin/sh\n' > "$rbin"; chmod +x "$rbin"
    gate_run "usage_marker_write $SID_A post-plan-now '$rbin' usage-pause drain 95 five_hour 1790625600"
    assert_eq marker:rc 0 "$?"
    local m
    m=$(gate_run "usage_marker_read $SID_A")
    assert_eq marker:argv1 --resume-paused "$(printf '%s' "$m" | jq -r '.resume_argv[1]')"
    assert_eq marker:argv2 "$SID_A" "$(printf '%s' "$m" | jq -r '.resume_argv[2]')"
    assert_eq marker:priority 1 "$(printf '%s' "$m" | jq -r '.priority')"
    assert_eq marker:resume_count 0 "$(printf '%s' "$m" | jq -r '.resume_count')"
    gate_run "usage_marker_bump_resume $SID_A"
    gate_run "usage_marker_write $SID_A post-plan-now '$rbin' usage-pause drain 96 five_hour 1790625600"
    assert_eq marker:count-carried 1 "$(gate_run "usage_marker_read $SID_A" | jq -r '.resume_count')"
    gate_run "usage_marker_clear $SID_A"
    gate_run "usage_marker_clear $SID_A"
    assert_no_file marker:cleared "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
}

test_marker_rejects_bad_input() {
    new_env
    local rbin="$T/resume.sh" rc
    printf '#!/bin/sh\n' > "$rbin"; chmod +x "$rbin"
    gate_run "usage_marker_write ../evil post-plan-now '$rbin' usage-pause drain 95 five_hour 1"; rc=$?
    assert_eq marker_bad:sid 1 "$rc"
    gate_run "usage_marker_write $SID_A bogus '$rbin' usage-pause drain 95 five_hour 1"; rc=$?
    assert_eq marker_bad:runner 1 "$rc"
    gate_run "usage_marker_write $SID_A plan-now relative/bin usage-pause drain 95 five_hour 1"; rc=$?
    assert_eq marker_bad:relative 1 "$rc"
    gate_run "usage_marker_write $SID_A plan-now '$T/not-exec' usage-pause drain 95 five_hour 1"; rc=$?
    assert_eq marker_bad:missing-bin 1 "$rc"
    assert_eq marker_bad:dir-empty 0 "$(find "$IBL5_USAGE_GATE_STATE_DIR/markers" -type f | wc -l | tr -d ' ')"
    assert_no_file marker_bad:no-escape "$IBL5_USAGE_GATE_STATE_DIR/evil.json"
}

test_markers_sorted_order() {
    new_env
    local rbin="$T/resume.sh" f
    printf '#!/bin/sh\n' > "$rbin"; chmod +x "$rbin"
    assert_eq sorted:empty "" "$(gate_run usage_markers_sorted)"
    gate_run "usage_marker_write $SID_A plan-now '$rbin' usage-pause drain 95 five_hour 1"
    gate_run "usage_marker_write $SID_B automouse '$rbin' usage-pause drain 95 five_hour 1"
    gate_run "usage_marker_write $SID_C post-plan-now '$rbin' usage-pause drain 95 five_hour 1"
    gate_run "usage_marker_write $SID_D post-plan-now '$rbin' usage-pause drain 95 five_hour 1"
    # pin paused_at: A=1 B=3 C=5 D=2
    set_paused() {  # sid t
        f="$IBL5_USAGE_GATE_STATE_DIR/markers/$1.json"
        jq --argjson t "$2" '.paused_at = $t' "$f" > "$f.x" && mv "$f.x" "$f"
    }
    set_paused $SID_A 1; set_paused $SID_B 3; set_paused $SID_C 5; set_paused $SID_D 2
    assert_eq sorted:order "$SID_D $SID_C $SID_B $SID_A" "$(gate_run usage_markers_sorted | tr '\n' ' ' | sed 's/ $//')"
}

test_token_exclusive() {
    new_env
    local rc
    gate_run "usage_token_acquire $SID_A 99999"; rc=$?
    assert_eq token:A-acquires 0 "$rc"
    gate_run "usage_token_acquire $SID_B 99998"; rc=$?
    assert_eq token:B-blocked 1 "$rc"
    gate_run "usage_token_acquire $SID_A"; rc=$?
    assert_eq token:A-idempotent 0 "$rc"
    gate_run "usage_token_release $SID_B"; rc=$?
    assert_eq token:foreign-release-rc 0 "$rc"
    assert_eq token:still-A "$SID_A" "$(gate_run usage_token_holder)"
    gate_run "usage_token_release $SID_A"
    assert_no_file token:freed "$IBL5_USAGE_GATE_STATE_DIR/drain-token.d"
    gate_run "usage_token_acquire $SID_B 99998"; rc=$?
    assert_eq token:B-acquires 0 "$rc"
}

test_token_reclaim_dead_pid() {
    new_env
    local dead
    sh -c 'exit 0' & dead=$!
    wait "$dead"
    gate_run "usage_token_acquire $SID_A $dead"
    gate_run usage_token_reclaim_dead
    assert_no_file token_reclaim:dead "$IBL5_USAGE_GATE_STATE_DIR/drain-token.d"
    assert_contains token_reclaim:log "$(cat "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log")" "token-reclaimed sid=$SID_A"
    sleep 30 & local live=$!
    gate_run "usage_token_acquire $SID_B $live"
    gate_run usage_token_reclaim_dead
    assert_file token_reclaim:live-kept "$IBL5_USAGE_GATE_STATE_DIR/drain-token.d"
    kill "$live" 2>/dev/null
    wait "$live" 2>/dev/null
}

test_delta_log_throttle() {
    new_env
    local log="$IBL5_USAGE_GATE_STATE_DIR/deltas.jsonl"
    gate_run "usage_delta_log $SID_A plan-now haiku '$(usage_json 40 10)'"
    gate_run "usage_delta_log $SID_A plan-now haiku '$(usage_json 40 10)'"
    assert_eq delta:one-line 1 "$(wc -l < "$log" | tr -d ' ')"
    assert_eq delta:first-zero 0 "$(head -1 "$log" | jq -r '.d_five')"
    gate_run "usage_delta_log $SID_A plan-now haiku '$(usage_json 43 10)'"
    assert_eq delta:two-lines 2 "$(wc -l < "$log" | tr -d ' ')"
    assert_eq delta:d_five 3 "$(tail -1 "$log" | jq -r '.d_five')"
}

test_limit_hit_vs_env_error() {
    new_env
    local f="$T/log.txt" n
    for line in "You've hit your weekly limit" "API Error: 429" "rate_limit_error"; do
        printf '%s\n' "$line" > "$f"
        gate_run "usage_is_limit_hit '$f'"; n=$?
        assert_eq "limit_hit:$line" 0 "$n"
        gate_run "usage_is_env_error '$f'"; n=$?
        assert_eq "env_error:$line" 0 "$n"
    done
    for line in "API Error: 401" "API Error: 529" "overloaded_error"; do
        printf '%s\n' "$line" > "$f"
        gate_run "usage_is_limit_hit '$f'"; n=$?
        assert_eq "not_limit_hit:$line" 1 "$n"
        gate_run "usage_is_env_error '$f'"; n=$?
        assert_eq "env_only:$line" 0 "$n"
    done
    printf 'discussing 401 handling in AuthService\n' > "$f"
    gate_run "usage_is_limit_hit '$f'"; n=$?
    assert_eq prose:limit 1 "$n"
    gate_run "usage_is_env_error '$f'"; n=$?
    assert_eq prose:env 1 "$n"
    printf 'API Error: 429\nfine\n' > "$f"
    gate_run "usage_is_limit_hit '$f' 1"; n=$?
    assert_eq after_line:skips 1 "$n"
}

# ---------------------------------------------------------------- Phase 3

PAUSE_JSON='{"continue":false,"stopReason":"usage-pause"}'

# decide_setup <five> [week]: fresh env, fresh cache at that utilization, stub PATH
# that fails curl (so a cache miss is visible), and an executable RESUME_BIN.
decide_setup() {
    new_env
    make_stub_bin "$STUB" "" '{}' 1
    seed_cache "$(date +%s)" "$(usage_json "$1" "${2:-0}")"
    RBIN="$T/resume.sh"
    printf '#!/bin/sh\n' > "$RBIN"; chmod +x "$RBIN"
}

# decide <sid> [extra env assignments via the environment]: prints hook output.
decide() {
    printf '{"session_id":"%s","cwd":"%s"}' "$1" "$PWD" \
        | PATH="$STUB:$ORIG_PATH" bash -c ". '$REPO_ROOT/bin/lib/usage-gate.sh'; usage_gate_decide"
}

test_decide_normal_allows() {
    decide_setup 50
    local out
    out=$(IBL5_USAGE_GATE_RUNNER=plan-now IBL5_USAGE_GATE_RESUME_BIN="$RBIN" decide $SID_A)
    assert_eq decide_normal:out "" "$out"
    assert_no_file decide_normal:no-marker "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
}

test_decide_drain_pauses_non_holder() {
    decide_setup 95
    local out
    out=$(IBL5_USAGE_GATE_RUNNER=plan-now IBL5_USAGE_GATE_RESUME_BIN="$RBIN" decide $SID_A)
    assert_eq decide_drain:out "$PAUSE_JSON" "$out"
    assert_file decide_drain:marker "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
    local m
    m=$(cat "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json")
    assert_eq decide_drain:zone drain "$(printf '%s' "$m" | jq -r .zone)"
    assert_eq decide_drain:reason usage-pause "$(printf '%s' "$m" | jq -r .reason)"
}

test_decide_drain_allows_holder() {
    decide_setup 95
    gate_run "usage_token_acquire $SID_A $$"
    local out
    out=$(IBL5_USAGE_GATE_RUNNER=plan-now IBL5_USAGE_GATE_RESUME_BIN="$RBIN" decide $SID_A)
    assert_eq decide_holder:out "" "$out"
    assert_no_file decide_holder:no-marker "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
}

test_decide_stop_pauses_holder_and_releases() {
    decide_setup 99
    gate_run "usage_token_acquire $SID_A $$"
    local out
    out=$(IBL5_USAGE_GATE_RUNNER=plan-now IBL5_USAGE_GATE_RESUME_BIN="$RBIN" decide $SID_A)
    assert_eq decide_stop:out "$PAUSE_JSON" "$out"
    assert_no_file decide_stop:token-gone "$IBL5_USAGE_GATE_STATE_DIR/drain-token.d"
    assert_file decide_stop:marker "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
}

test_decide_fail_open_no_usage() {
    new_env
    make_stub_bin "$STUB" "" '{}' 1
    RBIN="$T/resume.sh"; printf '#!/bin/sh\n' > "$RBIN"; chmod +x "$RBIN"
    local out
    out=$(IBL5_USAGE_GATE_RUNNER=plan-now IBL5_USAGE_GATE_RESUME_BIN="$RBIN" decide $SID_A)
    assert_eq decide_no_usage:out "" "$out"
    assert_contains decide_no_usage:log "$(cat "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log")" "reason=no-usage"
}

test_decide_fail_open_stale() {
    decide_setup 99
    seed_cache "$(( $(date +%s) - 600 ))" "$(usage_json 99 0)"
    local out
    out=$(IBL5_USAGE_GATE_RUNNER=plan-now IBL5_USAGE_GATE_RESUME_BIN="$RBIN" decide $SID_A)
    assert_eq decide_stale:out "" "$out"
    assert_contains decide_stale:log "$(cat "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log")" "reason=stale-usage"
    assert_no_file decide_stale:no-marker "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
}

test_decide_runner_env_unset() {
    decide_setup 99
    local out
    out=$(env -u IBL5_USAGE_GATE_RUNNER IBL5_USAGE_GATE_RESUME_BIN="$RBIN" bash -c "$(declare -f decide); SID_A=$SID_A; STUB='$STUB'; ORIG_PATH='$ORIG_PATH'; REPO_ROOT='$REPO_ROOT'; decide $SID_A")
    assert_eq decide_runner_unset:out "" "$out"
    assert_no_file decide_runner_unset:no-marker "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
}

test_decide_runner_env_empty() {
    decide_setup 99
    local out
    out=$(IBL5_USAGE_GATE_RUNNER="" IBL5_USAGE_GATE_RESUME_BIN="$RBIN" decide $SID_A)
    assert_eq decide_runner_empty:out "" "$out"
    assert_no_file decide_runner_empty:no-marker "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
}

test_decide_resume_bin_unset() {
    decide_setup 99
    local out
    out=$(env -u IBL5_USAGE_GATE_RESUME_BIN IBL5_USAGE_GATE_RUNNER=plan-now bash -c "$(declare -f decide); STUB='$STUB'; ORIG_PATH='$ORIG_PATH'; REPO_ROOT='$REPO_ROOT'; decide $SID_A")
    assert_eq decide_bin_unset:out "" "$out"
    assert_no_file decide_bin_unset:no-marker "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
}

test_decide_resume_bin_empty() {
    decide_setup 99
    local out
    out=$(IBL5_USAGE_GATE_RUNNER=plan-now IBL5_USAGE_GATE_RESUME_BIN="" decide $SID_A)
    assert_eq decide_bin_empty:out "" "$out"
    assert_no_file decide_bin_empty:no-marker "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
}

test_decide_model_env_unset_and_empty() {
    decide_setup 50
    IBL5_USAGE_GATE_RUNNER=plan-now IBL5_USAGE_GATE_RESUME_BIN="$RBIN" decide $SID_A >/dev/null
    seed_cache "$(date +%s)" "$(usage_json 55 0)"
    IBL5_USAGE_GATE_MODEL="" IBL5_USAGE_GATE_RUNNER=plan-now IBL5_USAGE_GATE_RESUME_BIN="$RBIN" decide $SID_A >/dev/null
    local log="$IBL5_USAGE_GATE_STATE_DIR/deltas.jsonl"
    assert_eq decide_model:lines 2 "$(wc -l < "$log" | tr -d ' ')"
    assert_eq decide_model:unset unknown "$(head -1 "$log" | jq -r .model)"
    assert_eq decide_model:empty unknown "$(tail -1 "$log" | jq -r .model)"
}

test_decide_marker_write_fails_allows() {
