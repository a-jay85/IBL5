#!/usr/bin/env python3
# bin/lib/deleted-guards: report safety guards a unified diff removes.
#
# Usage:
#   bin/lib/deleted-guards --diff <path|-> [--plan <plan.md>]
#   bin/lib/deleted-guards --lint-plan <plan.md> [--require]
#
# --diff mode
#   stdout  REMOVED-GUARD<TAB><key><TAB><path><TAB><kind><TAB><snippet>
#           INTENDED<TAB><key><TAB><path><TAB><kind><TAB><snippet>
#   exit 0  no unintended guard removals
#   exit 1  one or more REMOVED-GUARD lines printed
#   exit 2  usage error, unreadable --diff/--plan, or a diff it cannot parse
#
# --lint-plan mode (the single owner of the `## Must preserve` grammar;
# bin/check-plan gate [MP] relays its lines)
#   stdout  MP-VIOLATION: <message>   (one per problem)
#   exit 0  section valid, or absent without --require
#   exit 1  one or more MP-VIOLATION lines
#   exit 2  usage error or unreadable plan
#
# A guard key is <kind>@<path>#<first 8 hex of sha1(normalized line)>, so it
# survives rebases. A removed guard cancels against an identical (normalized)
# added line in the SAME file only: a re-indent is not flagged, a cross-file
# move is. Test, fixture and doc paths are skipped. A plan's
# `### Intended removals` bullets suppress matching removals (printed as
# INTENDED). Stdlib only, so it runs under a launchd-like empty environment.

import hashlib
import re
import sys

USAGE = (
    "Usage: bin/lib/deleted-guards --diff <path|-> [--plan <plan.md>]\n"
    "       bin/lib/deleted-guards --lint-plan <plan.md> [--require]"
)

# (lang, kind, pattern, paired). Order matters: the first matching kind wins.
GUARD_KINDS = [
    ("php", "try", r"^try ?\{", False),
    ("php", "catch", r"^(\} ?)?catch ?\(", False),
    ("php", "finally", r"^(\} ?)?finally ?\{", False),
    ("php", "exists-check",
     r"\b(class_exists|function_exists|method_exists|interface_exists"
     r"|property_exists|extension_loaded)\s*\(", False),
    ("php", "lock",
     r"\b(acquireLock|releaseLock|GET_LOCK|RELEASE_LOCK|flock|sem_acquire"
     r"|sem_release)\b", False),
    ("php", "null-return",
     r"^if ?\(.*(=== ?null|null ?===|!== ?null|null ?!==|is_null\(|isset\("
     r"|empty\()", True),
    ("shell", "command-guard", r"\bcommand -v\b|\btype -P\b|\bhash [A-Za-z_]",
     False),
    ("shell", "lock", r"\bflock\b|\bshlock\b|\blockf\b|\bmkdir\b[^;&|]*lock",
     False),
    ("shell", "or-true", r"\|\| ?(true|:)( |;|$|#)", False),
    ("shell", "trap", r"^trap ", False),
    ("shell", "strict-mode", r"^set -[a-z]*[eu]", False),
    ("shell", "early-exit-test",
     r"\[\[? ?-[zndefxsr] .*\]\]? ?(&&|\|\|)|^if \[\[? ?-[zndefxsr] ", True),
    ("python", "try", r"^try ?:", False),
    ("python", "except", r"^except\b", False),
    ("python", "finally", r"^finally ?:", False),
    ("python", "type-guard", r"^if (not )?(hasattr|isinstance|callable)\(",
     True),
    ("python", "lock",
     r"\.acquire\(|\.release\(|\bwith [^:]*lock\b|fcntl\.(flock|lockf)",
     False),
    ("python", "none-return", r"^if .* is (not )?None\b", True),
]
COMPILED = [(lang, kind, re.compile(pat), paired)
            for lang, kind, pat, paired in GUARD_KINDS]
KNOWN_KINDS = sorted({kind for _, kind, _, _ in GUARD_KINDS})
EXIT_STMT = re.compile(r"\b(return|throw|exit|raise|continue)\b")

SKIP_PATHS = [re.compile(p) for p in (
    r"(^|/)tests?/", r"(^|/)test_[^/]*\.py$", r"_test\.py$", r"Test\.php$",
    r"^bin/test-", r"^bin/fixtures/", r"\.md$",
)]

INTENDED_RE = re.compile(
    r"^[-*] `([^`]+)` ([A-Za-z-]+): `([^`]+)` (?:—|--) (.*)$")
NONE_TOP_RE = re.compile(r"^[-*] none (?:—|--) (.*)$")
BULLET_RE = re.compile(r"^[-*] ")
FENCE_RE = re.compile(r"^\s*(```|~~~)")
MP_HEADING_RE = re.compile(r"^## Must preserve\s*$")
INTENDED_HEADING_RE = re.compile(r"^### Intended removals\s*$")


class UsageError(Exception):
    pass


def normalize(line):
    return re.sub(r"\s+", " ", line).strip()


def language(path, first_line=None):
    if path.endswith(".php"):
        return "php"
    if path.endswith(".py"):
        return "python"
    if path.endswith(".sh") or path.endswith(".bash"):
        return "shell"
    base = path.rsplit("/", 1)[-1]
    if path.startswith("bin/") and "." not in base:
        first = first_line
        if first is None:
            try:
                with open(path, encoding="utf-8", errors="replace") as fh:
                    first = fh.readline()
            except OSError:
                # Type unknown (deleted file, different cwd): match every
                # language so a Python guard deletion cannot slip through.
                return "unknown"
        return "python" if "python" in first else "shell"
    return None


def skipped(path):
    return any(p.search(path) for p in SKIP_PATHS)


_ESCAPES = {"a": 7, "b": 8, "t": 9, "n": 10, "v": 11, "f": 12, "r": 13,
            '"': 34, "\\": 92}


def unquote(token):
    """Undo git's C-style quoting ("x y.php", \\303\\251 octal bytes)."""
    if len(token) < 2 or not (token.startswith('"') and token.endswith('"')):
        return token
    body = token[1:-1]
    out = bytearray()
    i = 0
    while i < len(body):
        ch = body[i]
        if ch != "\\" or i + 1 >= len(body):
            out += ch.encode("utf-8")
            i += 1
            continue
        nxt = body[i + 1]
        if nxt in "01234567":
            j = i + 1
            while j < len(body) and j < i + 4 and body[j] in "01234567":
                j += 1
            out.append(int(body[i + 1:j], 8) & 0xFF)
            i = j
        else:
            out.append(_ESCAPES.get(nxt, ord(nxt) & 0xFF))
            i += 2
    return out.decode("utf-8", errors="replace")


def strip_prefix(token, prefix):
    """Unquote a ---/+++ path and drop its a/ or b/ prefix, else None."""
    token = unquote(token)
    return token[2:] if token.startswith(prefix) else None


def parse_diff(text):
    """Return ordered file records: {path, hunks: [[(sign, normalized)]]}.

    sign is "-", "+", or " " (context). A record whose path could not be
    determined keeps path None so the caller can fail closed.
    """
    files = []
    cur = None
    in_hunk = False
    old_path = new_path = None
    for raw in text.splitlines():
        if raw.startswith("diff --git "):
            m = re.match(r"^diff --git a/(.*) b/(.*)$", raw)
            if not m:
                m = re.match(r'^diff --git (".*") (".*")$', raw)
                path = strip_prefix(m.group(2), "b/") if m else None
            else:
                path = m.group(2)
            cur = {"path": path, "hunks": []}
            files.append(cur)
            in_hunk = False
            old_path = new_path = None
            continue
        if cur is None:
            continue
        if not in_hunk:
            if raw.startswith("--- "):
                old_path = raw[4:]
                continue
            if raw.startswith("+++ "):
                new_path = raw[4:]
                new_stripped = strip_prefix(new_path, "b/")
                old_stripped = (strip_prefix(old_path, "a/")
                                if old_path else None)
                if new_stripped is not None:
                    cur["path"] = new_stripped
                elif new_path == "/dev/null" and old_stripped is not None:
                    cur["path"] = old_stripped
                continue
            if raw.startswith("rename to "):
                cur["path"] = unquote(raw[len("rename to "):])
                continue
        if raw.startswith("@@"):
            if not cur["hunks"]:
                cur["starts_at_1"] = bool(
                    re.match(r"^@@ -1[ ,]", raw)
                    or re.match(r"^@@ -0,0 \+1[ ,]", raw))
            in_hunk = True
            cur["hunks"].append([])
            continue
        if not in_hunk:
            continue
        if raw.startswith("-"):
            cur["hunks"][-1].append(("-", normalize(raw[1:])))
        elif raw.startswith("+"):
            cur["hunks"][-1].append(("+", normalize(raw[1:])))
        elif raw.startswith(" ") or raw == "":
            cur["hunks"][-1].append((" ", normalize(raw[1:])))
    return files


def classify(lang, line):
    for klang, kind, rx, paired in COMPILED:
        if (klang == lang or lang == "unknown") and rx.search(line):
            return kind, paired
    return None, False


def guard_key(kind, path, norm):
    return "%s@%s#%s" % (kind, path,
                         hashlib.sha1(norm.encode("utf-8")).hexdigest()[:8])


def find_removed_guards(files):
    """Ordered list of (key, path, kind, snippet, full) surviving cancellation."""
    out = []
    seen = set()
    for rec in files:
        path = rec["path"]
        if not path or skipped(path):
            continue
        first = None
        if rec.get("starts_at_1") and rec["hunks"] and rec["hunks"][0]:
            cand = rec["hunks"][0][0][1]
            if cand.startswith("#!"):
                first = cand
        lang = language(path, first)
        if lang is None:
            continue
        added = {}
        for hunk in rec["hunks"]:
            for sign, norm in hunk:
                if sign == "+":
                    added[norm] = added.get(norm, 0) + 1
        for hunk in rec["hunks"]:
            # Old-file view: removed and context lines in order, so an exit
            # statement left behind as context still pairs with the guard.
            old = [(s, n) for s, n in hunk if s != "+"]
            for i, (sign, norm) in enumerate(old):
                if sign != "-":
                    continue
                kind, paired = classify(lang, norm)
                if kind is None:
                    continue
                if paired and not any(EXIT_STMT.search(r)
                                      for _, r in old[i:i + 3]):
                    continue
                if added.get(norm, 0) > 0:
                    added[norm] -= 1
                    continue
                key = guard_key(kind, path, norm)
                if key in seen:
                    continue
                seen.add(key)
                out.append((key, path, kind, norm[:120], norm))
    return out


def strip_fences(lines):
    kept = []
    fenced = False
    for line in lines:
        if FENCE_RE.match(line):
            fenced = not fenced
            continue
        if not fenced:
            kept.append(line)
    return kept


def parse_must_preserve(text):
    """Parse a plan's `## Must preserve` section.

    Returns (present, preserve_bullets, intended_bullets, violations).
    intended_bullets holds only well-formed entries as dicts with path, kind,
    needle, reason. violations is a list of (part, bullet_text, message);
    part is "section", "preserve" or "intended".
    """
    lines = strip_fences(text.splitlines())
    start = None
    for i, line in enumerate(lines):
        if MP_HEADING_RE.match(line):
            start = i
            break
    if start is None:
        return False, [], [], []
    section = []
    for line in lines[start + 1:]:
        if line.startswith("## "):
            break
        section.append(line)
    preserve_part, intended_part = section, None
    for i, line in enumerate(section):
        if INTENDED_HEADING_RE.match(line):
            preserve_part = section[:i]
            intended_part = []
            for sub in section[i + 1:]:
                if sub.startswith("### "):
                    break
                intended_part.append(sub)
            break

    violations = []
    preserve = [ln.rstrip() for ln in preserve_part if BULLET_RE.match(ln)]
    if not preserve:
        violations.append(("preserve", "",
                           "## Must preserve has no bullets (list guards to "
                           "keep, or '- none — <reason>')"))
    none_bullets = [b for b in preserve
                    if b[2:] == "none"
                    or b[2:].startswith(("none —", "none --"))]
    for b in preserve:
        if b in none_bullets:
            m = NONE_TOP_RE.match(b)
            if not m or len(m.group(1).strip()) < 15:
                violations.append(("preserve", b,
                                   "none bullet needs a reason of 15+ chars: "
                                   + b))
            continue
        body = b[2:]
        spans = re.findall(r"`[^`]+`", body)
        outside = re.sub(r"`[^`]+`", "", body).strip()
        if not spans or len(outside) < 10:
            violations.append(("preserve", b,
                               "guard bullet needs a backticked path and 10+ "
                               "chars of description: " + b))
    if none_bullets and len(preserve) > 1:
        violations.append(("preserve", none_bullets[0],
                           "a '- none' bullet must be the only bullet in "
                           "## Must preserve"))

    intended = []
    if intended_part is not None:
        bullets = [ln.rstrip() for ln in intended_part if BULLET_RE.match(ln)]
        if not bullets:
            violations.append(("intended", "",
                               "### Intended removals has no bullets (write "
                               "'- none' when nothing is removed on purpose)"))
        bare_none = [b for b in bullets
                     if b in ("- none", "* none")
                     or NONE_TOP_RE.match(b)]
        if bare_none and len(bullets) > 1:
            violations.append(("intended", bare_none[0],
                               "'- none' must be the only bullet under "
                               "### Intended removals"))
        for b in bullets:
            if b in bare_none:
                continue
            m = INTENDED_RE.match(b)
            if not m:
                violations.append(("intended", b,
                                   "malformed intended-removal bullet "
                                   "(want - `<path>` <kind>: `<needle>` "
                                   "— <reason>): " + b))
                continue
            path, kind, needle, reason = m.groups()
            if kind not in KNOWN_KINDS:
                violations.append(("intended", b,
                                   "unknown guard kind '%s' (known: %s)"
                                   % (kind, ", ".join(KNOWN_KINDS))))
                continue
            if len(reason.strip()) < 10:
                violations.append(("intended", b,
                                   "intended-removal reason needs 10+ chars: "
                                   + b))
                continue
            intended.append({"path": path, "kind": kind, "needle": normalize(needle),
                             "reason": reason.strip()})
    return True, preserve, intended, violations


def read_text(path):
    if path == "-":
        return sys.stdin.read()
    with open(path, encoding="utf-8", errors="replace") as fh:
        return fh.read()


def run_lint(plan, require):
    try:
        text = read_text(plan)
    except OSError as exc:
        sys.stderr.write("deleted-guards: cannot read plan %s: %s\n%s\n"
                         % (plan, exc, USAGE))
        return 2
    present, _, _, violations = parse_must_preserve(text)
    if not present:
        if require:
            print("MP-VIOLATION: missing ## Must preserve section (list "
                  "guards to keep, or '- none — <reason>')")
            return 1
        return 0
    for _, _, msg in violations:
        print("MP-VIOLATION: " + msg)
    return 1 if violations else 0


def run_diff(diff, plan):
    try:
        text = read_text(diff)
    except OSError as exc:
        sys.stderr.write("deleted-guards: cannot read diff %s: %s\n%s\n"
                         % (diff, exc, USAGE))
        return 2
    intended = []
    if plan is not None:
        try:
            plan_text = read_text(plan)
        except OSError as exc:
            sys.stderr.write("deleted-guards: cannot read plan %s: %s\n%s\n"
                             % (plan, exc, USAGE))
            return 2
        _, _, intended, violations = parse_must_preserve(plan_text)
        for part, bullet, _ in violations:
            if part == "intended" and bullet:
                sys.stderr.write("deleted-guards: ignoring malformed "
                                 "intended-removal bullet: %s\n" % bullet)
    files = parse_diff(text)
    if text.strip() and not files:
        sys.stderr.write("deleted-guards: no 'diff --git' sections found\n")
        return 2
    for rec in files:
        if rec["path"] is None:
            sys.stderr.write("deleted-guards: cannot determine the path of a "
                             "'diff --git' section; failing closed\n")
            return 2
    rc = 0
    for key, path, kind, snippet, full in find_removed_guards(files):
        hit = any(i["path"] == path and i["kind"] == kind
                  and i["needle"] in full for i in intended)
        tag = "INTENDED" if hit else "REMOVED-GUARD"
        if not hit:
            rc = 1
        print("\t".join((tag, key, path, kind, snippet)))
    return rc


def parse_args(argv):
    opts = {}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("--diff", "--plan", "--lint-plan"):
            if i + 1 >= len(argv) or arg in opts:
                raise UsageError()
            opts[arg] = argv[i + 1]
            i += 2
        elif arg == "--require" and arg not in opts:
            opts[arg] = True
            i += 1
        else:
            raise UsageError()
    if "--lint-plan" in opts:
        if "--diff" in opts or "--plan" in opts:
            raise UsageError()
    elif "--diff" not in opts or "--require" in opts:
        raise UsageError()
    return opts


def main(argv):
    try:
        opts = parse_args(argv)
    except UsageError:
        sys.stderr.write(USAGE + "\n")
        return 2
    if "--lint-plan" in opts:
        return run_lint(opts["--lint-plan"], "--require" in opts)
    return run_diff(opts["--diff"], opts.get("--plan"))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
