@@ -523,6 +527,22 @@ db_cmd "$DB_CONTAINER" mariadb "$DB_DEFAULT_NAME" -e "
         SELECT migration FROM migrations WHERE migration LIKE '%.sql';
 " 2> >(db_strip_warnings >&2) || true
 
+# The backfill marks every prod-applied migration done, so a migration that changes a
+# preserved table (whose local copy the prod dump did not touch) would never reach it.
+# Re-apply exactly those, through bin/db-migrate. Local-only: db_cmd on $DB_CONTAINER.
+MIG_DIR="$REPO_ROOT/ibl5/migrations"
+if [ -n "$WORKTREE_PATH" ] && [ -d "$WORKTREE_PATH/ibl5/migrations" ]; then
+    MIG_DIR="$WORKTREE_PATH/ibl5/migrations"
+fi
+echo ""
+echo "Replaying migrations that touch preserved tables..."
+# shellcheck disable=SC2086  # PRESERVE_TABLES is a validated space-separated list
+if ! replay_preserved_migrations "$DB_CONTAINER" "$DB_DEFAULT_NAME" "$MIG_DIR" \
+        "$PRE_SYNC_VERSIONS" $PRESERVE_TABLES; then
+    echo "ERROR: preserved-table migration replay failed; the local bug tables may be behind prod's schema." >&2
+    exit 1
+fi
+
