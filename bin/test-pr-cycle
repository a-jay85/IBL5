grep -qF '#777' <<< "$_sk" || fail "skip-notes-drop-armed-and-fired: 777 missing: $_sk"
grep -qF '#101' <<< "$_sk" && fail "skip-notes-drop-armed-and-fired: armed 101 listed: $_sk"
