#!/usr/bin/env bash
# bin/jsb-parity-watch — hourly zero-token watcher for the JSB parity loop.
#
# Run by the com.ibl5.jsb-parity-watch LaunchAgent (bin/jsb-parity-watch-setup).
# It reads the parity ledger and GitHub PR state, picks one verdict per in-flight
# ledger row, computes every verdict first, then acts once per run:
#
#   row state                                         verdict
#   ------------------------------------------------  ------------------------------
#   PR merged                                         FIRE webhook
#   PR closed without merge                           FIRE webhook
#   PR open, a check failed (new head SHA)            FIRE webhook (once per SHA)
#   PR open, checks pending                           wait
#   PR open, green, auto-merge armed                  wait
#   PR open, green, auto-merge not armed              STALL (DM: held for owner)
#   no PR, plan queued, automouse idle                KICK (schedule a run)
#   no PR, plan queued, automouse running             wait
#   no PR, a loaded plan-now job may own the slug     wait
#   no PR, plan in done/ or skipped/                  STALL (DM)
#   no PR, failure report names the slug              STALL (DM)
#   no PR, nothing found                              STALL (DM: no trace)
#   no row in flight                                  FIRE webhook
#
# One webhook POST, one automouse kick and one DM per new stall key per run.
# A gh failure on any row aborts the run before any action. Any unexpected error
# logs one line and exits 0, so launchd never throttles the job.
#
# Blocker fixer. Armed means the fixer webhook URL file is non-empty. State comes
# from state/blockers.json under the parity dir.
#
#   fixer state                                       action
#   ------------------------------------------------  ------------------------------
#   armed, unfixed fixer-class blocker or stall       WAKE fixer webhook
#   armed, stall the fixer cannot take                DM, as in the table above
#   armed, stall with an open fix                     no stall DM
#   armed, no ack 3h after the first wake             DM once
#   fix PR merged                                     FIRE webhook (fix-merged:<slug>)
#   fix PR closed or red                              DM once
#   fix PR never opened in 48h                        DM once
#
# Usage:
#   bin/jsb-parity-watch             # act
#   bin/jsb-parity-watch --dry-run   # print config, row and decision lines; act on nothing
#
# Env seams (all optional; empty means the default): JSB_WATCH_PARITY_DIR,
# JSB_WATCH_BIN, JSB_WATCH_PLANNOW_DIR, JSB_WATCH_NOW (epoch seconds).
#
# The watcher writes only under $HOME/.cache. It never writes under the parity
# dir, never runs parity_loop.py, and calls gh only as `pr list`.
[ "${BASH_VERSINFO[0]:-0}" -ge 4 ] || { printf '%s: bash 4+ required (this is bash %s). Run: brew install bash\n' "${0##*/}" "${BASH_VERSION:-?}" >&2; exit 2; }
set -Eeuo pipefail
export PATH="$PATH:/usr/local/bin:/opt/homebrew/bin:/opt/homebrew/opt/mariadb/bin:$HOME/.bun/bin:$HOME/.local/bin:/usr/bin:/bin"

log() { printf '%s jsb-parity-watch: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }
trap 'log "error at line $LINENO; no action taken"; exit 0' ERR

# Parse arguments before any side effect, so --help touches nothing (bin/test-bin-help).
DRY_RUN=0

usage() {
    cat <<'USAGE'
Usage: bin/jsb-parity-watch [--dry-run]
  --dry-run   print config, row and decision lines; take no action
  -h, --help  show this help
USAGE
}

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DRY_RUN=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "jsb-parity-watch: unknown argument: $1" >&2; usage >&2; exit 2 ;;
    esac
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$SCRIPT_DIR/.."
# shellcheck source=bin/lib/launchd-sched.sh
. "$SCRIPT_DIR/lib/launchd-sched.sh"
MAIN_WT="$(lsched_main_wt "$REPO_ROOT")"

STALE_AGE_S=14400
MUTEX_STALE_S=60
REFIRE_S=21600
FIXER_URL_FILE="$HOME/.config/jsb-parity/fixer-webhook-url"
FIXER_QUEUE="$HOME/.cache/jsb-parity-fixer-queue.txt"   # key<TAB>context, read by the fixer task
FIXER_WAKES="$HOME/.cache/jsb-parity-fixer-wakes.txt"   # key<TAB>first_epoch<TAB>last_epoch
FIXER_ACK_S=10800
FIXER_PR_STALE_S=172800
# Copy of FIXER_STAGES in jsb-native/tools/parity_loop/fixer.py. Change both together.
FIXER_STAGES=" plan-skipped plan-failed no-trace no-plan plan-now-failed "
SCHEDULE_DELAY_S=120
FAILED_CONCLUSIONS='["FAILURE","CANCELLED","TIMED_OUT","ACTION_REQUIRED","STARTUP_FAILURE","ERROR"]'
INFLIGHT_FILTER='.rows[] | select(.status == "captured" and (.plan_slug // "") != "") | "\(.id) \(.plan_slug)"'
PR_PICK='(map(select(.state == "OPEN")) + map(select(.state == "MERGED")) + map(select(.state == "CLOSED")))[0] // empty'
# GitHub keeps superseded runs of a check on one head SHA (a re-run leaves the old
# CANCELLED entry). Keep only the latest run per (workflow, check) before classifying.
CHECK_FILTER='[.statusCheckRollup[]?] | group_by([(.workflowName // ""), (.name // .context // "")]) | map(max_by(.startedAt // .completedAt // "")) | [.[] | ((.conclusion // .state // "") | ascii_upcase) as $c | (.status // "COMPLETED") as $s | if any($failed[]; . == $c) then "failed" elif ($s != "COMPLETED" or $c == "" or $c == "PENDING" or $c == "EXPECTED") then "pending" else "green" end] | if any(.[]; . == "failed") then "failed" elif (length == 0 or any(.[]; . == "pending")) then "pending" else "green" end'
PARITY_DIR="${JSB_WATCH_PARITY_DIR:-$MAIN_WT/jsb-native/parity}"
JSB_BIN="${JSB_WATCH_BIN:-$SCRIPT_DIR}"
PLANNOW_DIR="${JSB_WATCH_PLANNOW_DIR:-/tmp}"
NOW="${JSB_WATCH_NOW:-$(date +%s)}"
case "$NOW" in ''|*[!0-9]*) echo "jsb-parity-watch: JSB_WATCH_NOW must be epoch seconds" >&2; exit 2 ;; esac
CACHE_DIR="$HOME/.cache"
FIRED_SHAS="$CACHE_DIR/jsb-parity-watch.fired-shas"
STALLS="$CACHE_DIR/jsb-parity-stalls.txt"
LAST="$CACHE_DIR/jsb-parity-watch.last"
WEBHOOK_FILE="$HOME/.config/jsb-parity/webhook-url"
AUTOMOUSE_DIR="$HOME/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/automouse"

FIRE_REASONS=""
STALL_KEYS=""
HIDDEN_ROWS=" "     # space-delimited row ids whose stall state is unknown this run
KICK=0
GH_ERROR=""
FACTS=""
ROW_LINES=""
FIXER_STATE=""
FIXER_DUE_KEYS=""   # newline-separated keys the next fixer POST wakes for
FIX_VERDICTS=""
fp=""

quiet_exit() { log "$1"; exit 0; }

# dry_guard <action>: returns 0 when the action may run, 1 (after saying so) in dry-run.
dry_guard() {
    [ "$DRY_RUN" = 0 ] || { echo "dry-run: would $1"; return 1; }
}

fmt_epoch() {
    if date -d @0 +%s >/dev/null 2>&1; then
        date -d "@$1" '+%Y-%m-%d %H:%M'
    else
        date -r "$1" '+%Y-%m-%d %H:%M'
    fi
}

sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    else
        shasum -a 256 "$1" | cut -d' ' -f1
    fi
}

# match_plan <dir> <slug>: print the basename of the first plan file for the slug.
# A dangling queue symlink counts.
match_plan() {
    local dir="$1" slug="$2" f
    for f in "$dir/$slug.md" "$dir"/*-"$slug".md; do
        if [ -e "$f" ] || [ -L "$f" ]; then
            basename "$f"
            return 0
        fi
    done
    return 0
}

# lock_is_stale <lockdir>: returns 0 when stale. Mirrors
# jsb-native/tools/parity_loop/lock.py in the main checkout.
lock_is_stale() {
    local lockdir="$1" pid="" epoch="" host="" mtime
    if [ -r "$lockdir/pid" ]; then
        read -r pid epoch host < "$lockdir/pid" || true
        case "$pid" in ''|*[!0-9]*) pid="" ;; esac
        case "$epoch" in ''|*[!0-9]*) pid="" ;; esac
    fi
    if [ -n "$pid" ]; then
        if [ "$pid" -gt 0 ] && ! kill -0 "$pid" 2>/dev/null; then return 0; fi
        if [ $((NOW - epoch)) -gt "$STALE_AGE_S" ]; then return 0; fi
        return 1
    fi
    mtime=$(stat -c %Y "$lockdir" 2>/dev/null || stat -f %m "$lockdir" 2>/dev/null || echo 0)
    if [ $((NOW - mtime)) -gt "$MUTEX_STALE_S" ]; then return 0; fi
    return 1
}

# log_names_slug <log> <slug>: 0 when the plan-now log belongs to <slug>. A log whose
# identity line (bin/plan-now writes it first) carries a slug matches on that field
# exactly. Older logs and slug=- logs fall back to the content match.
log_names_slug() {
    local log="$1" slug="$2" id_slug
    id_slug=$(awk '!f && match($0, /^plan-now: identity slug=[^ ]* /) { print substr($0, 25, RLENGTH - 25); f = 1 }' "$log" 2>/dev/null) || id_slug=''
    if [ -n "$id_slug" ] && [ "$id_slug" != "-" ]; then
        [ "$id_slug" = "$slug" ]; return
    fi
    grep -qE "${slug}([^A-Za-z0-9]|\$)" "$log" 2>/dev/null
}

# row_verdict <id> <slug>: line 1 is the verdict; line 2 is the fingerprint fact
# (absent when the row has no PR).
row_verdict() {
    local id="$1" slug="$2" prs pr state number sha check armed f b log label newest r slug_re
    # Runs in a command-substitution subshell. The inherited ERR trap would print its
    # log line into the captured output and exit 0. Cleared here, nothing leaks into
    # the output. Bash drops -e inside $(...), so a failed command just keeps going;
    # main instead checks that line 1 starts with a known verdict prefix.
    trap - ERR
    slug_re="${slug}([^A-Za-z0-9]|\$)"
    if ! prs=$(gh pr list --repo a-jay85/IBL5 --head "$slug" --state all --json number,state,mergedAt,url,autoMergeRequest,statusCheckRollup,headRefOid 2>/dev/null) \
        || ! pr=$(printf '%s' "$prs" | jq -c "$PR_PICK" 2>/dev/null); then
        echo "ERROR:gh"; return 0
    fi

    if [ -n "$pr" ]; then
        state=$(printf '%s' "$pr" | jq -r '.state')
        number=$(printf '%s' "$pr" | jq -r '.number')
        sha=$(printf '%s' "$pr" | jq -r '.headRefOid // ""')
        check="-"
        case "$state" in
            MERGED) echo "FIRE:merged" ;;
            CLOSED) echo "FIRE:closed" ;;
            OPEN)
                check=$(printf '%s' "$pr" | jq -r --argjson failed "$FAILED_CONCLUSIONS" "$CHECK_FILTER")
                armed=$(printf '%s' "$pr" | jq -r 'if .autoMergeRequest == null then "no" else "yes" end')
                case "$check" in
                    failed) if grep -qxF -- "$id:$sha" "$FIRED_SHAS" 2>/dev/null; then echo "WAIT:check-failed-seen"; else echo "FIRE:check-failed:$sha"; fi ;;
                    pending) echo "WAIT:checks-pending" ;;
                    green) if [ "$armed" = "yes" ]; then echo "WAIT:auto-merge-armed"; else echo "STALL:held-for-owner:$number"; fi ;;
                    *) echo "WAIT:check-unknown" ;;
                esac ;;
            *) echo "WAIT:pr-state-unknown" ;;
        esac
        printf '%s=%s:%s:%s:%s\n' "$id" "$number" "$state" "$sha" "$check"
        return 0
    fi

    f=$(match_plan "$AUTOMOUSE_DIR/queue" "$slug")
    if [ -n "$f" ]; then
        if pgrep -f 'bin/automouse/run' >/dev/null 2>&1; then echo "WAIT:automouse-running"; else echo "KICK:schedule"; fi
        return 0
    fi

    for label in $(launchctl list 2>/dev/null | grep -oE 'com\.ibl5\.plan-now-[0-9-]+' || true); do
        log="$PLANNOW_DIR/plan-now-${label#com.ibl5.plan-now-}.log"
        if log_names_slug "$log" "$slug"; then
            echo "WAIT:plan-now-running"; return 0
        fi
        # The identity line names another run's slug, so this live run is attributed.
        if grep -qE '^plan-now: identity slug=[^- ]' "$log" 2>/dev/null; then continue; fi
        if [ ! -f "$log" ] || ! grep -qE 'jsb-port-' "$log"; then echo "WAIT:plan-now-unattributed"; return 0; fi
    done

    f=$(match_plan "$AUTOMOUSE_DIR/done" "$slug")
    if [ -n "$f" ]; then echo "STALL:plan-done:$f"; return 0; fi
    f=$(match_plan "$AUTOMOUSE_DIR/skipped" "$slug")
    if [ -n "$f" ]; then echo "STALL:plan-skipped:$f"; return 0; fi

    for r in "$AUTOMOUSE_DIR"/reports/*"$slug"*; do
        [ -e "$r" ] || continue
        b=$(basename "$r")
        case "$b" in *-done-*) continue ;; esac
        grep -qE "$slug_re" <<< "$b" || continue
        echo "STALL:plan-failed:$b"; return 0
    done

    newest=""
    for f in "$PLANNOW_DIR"/plan-now-*.log; do
        [ -e "$f" ] || continue
        if log_names_slug "$f" "$slug"; then newest="$f"; fi
    done
    if [ -n "$newest" ]; then
        # No-plan / failed stage: the newest linked log's last RESULT line decides.
        case "$(grep '^plan-now: RESULT ' "$newest" 2>/dev/null | tail -n 1)" in
            "plan-now: RESULT no-plan"|"plan-now: RESULT no-plan "*) echo "STALL:no-plan:$(basename "$newest")" ;;
            "plan-now: RESULT failed"|"plan-now: RESULT failed "*) echo "STALL:plan-now-failed:$(basename "$newest")" ;;
            *) echo "STALL:no-trace:$(basename "$newest")" ;;
        esac
    else
        echo "STALL:no-trace:none"
    fi
    return 0
}

# stall_message <key>: the DM text for one stall key (<id>:<stage>:<ref>).
stall_message() {
    local key="$1" id rest stage ref slug q
    id="${key%%:*}"; rest="${key#*:}"; stage="${rest%%:*}"; ref="${rest#*:}"
    slug=$(jq -r --arg id "$id" '[.rows[] | select(.id == $id) | .plan_slug][0] // ""' "$PARITY_DIR/ledger.json" || echo "")
    case "$stage" in
        held-for-owner)
            printf 'JSB parity watch: %s (%s) has PR https://github.com/a-jay85/IBL5/pull/%s. It is green and auto-merge is not armed.\n' "$id" "$slug" "$ref" ;;
        plan-done)
            printf 'JSB parity watch: %s (%s) has no PR, but its plan is in done/: %s.\n' "$id" "$slug" "$ref" ;;
        plan-skipped)
            printf 'JSB parity watch: %s (%s) has no PR, but its plan is in skipped/: %s.\n' "$id" "$slug" "$ref" ;;
        plan-failed)
            printf 'JSB parity watch: %s (%s) has no PR and a failure report names it: %s.\n' "$id" "$slug" "$ref" ;;
        no-plan)
            q=$(grep -E '^[[:space:]]*NO_PLAN: ' "$PLANNOW_DIR/$ref" 2>/dev/null | tail -n 1 || true)
            [ -n "$q" ] || q=$(grep '^plan-now: RESULT ' "$PLANNOW_DIR/$ref" 2>/dev/null | tail -n 1 || true)
            printf 'JSB parity watch: %s (%s) has no PR. Its plan-now run halted with no plan. Log: %s\n%s\nCheck whether the work is already done (an earlier PR may have landed it), then re-fire the port or flip the ledger row. Until someone acts, row %s stays stranded at status captured.\n' \
                "$id" "$slug" "$PLANNOW_DIR/$ref" "$q" "$id" ;;
        plan-now-failed)
            q=$(grep '^plan-now: RESULT ' "$PLANNOW_DIR/$ref" 2>/dev/null | tail -n 1 || true)
            printf 'JSB parity watch: %s (%s) has no PR. Its plan-now run failed. Log: %s\n%s\nRead the log and fix the cause, then re-fire the port or flip the ledger row. Until someone acts, row %s stays stranded at status captured.\n' \
                "$id" "$slug" "$PLANNOW_DIR/$ref" "$q" "$id" ;;
        no-trace)
            if [ "$ref" = "none" ]; then
                printf 'JSB parity watch: %s (%s) has no PR, no queued plan and no plan-now log naming it.\n' "$id" "$slug"
            else
                printf 'JSB parity watch: %s (%s) has no PR and no queued plan. Newest plan-now log naming it is %s:\n%s\n' \
                    "$id" "$slug" "$ref" "$(tail -n 5 "$PLANNOW_DIR/$ref" 2>/dev/null || true)"
            fi ;;
        *)
            printf 'JSB parity watch: %s (%s) is stalled (%s).\n' "$id" "$slug" "$key" ;;
    esac
}

fixer_armed() {
    [ -s "$FIXER_URL_FILE" ]
}

# fixer_json: the active blockers and the fixer record, empty when unreadable.
fixer_json() {
    local f="$PARITY_DIR/state/blockers.json" out=""
    trap - ERR
    if [ -f "$f" ]; then
        out=$(jq -c '{active: (.active // {}), fixer: (.fixer // {})}' "$f" 2>/dev/null) || out=""
    fi
    [ -n "$out" ] || out='{"active":{},"fixer":{}}'
    printf '%s\n' "$out"
}

# fixer_known <key>: the fixer holds this key, as an open fix or as the owner's.
fixer_known() {
    jq -e --arg k "$1" '[.fixer.open?, .fixer.owner?] | any(.[]; type == "object" and has($k))' \
        <<< "$FIXER_STATE" >/dev/null 2>&1
}

# fixer_open <key>: a fix is open for this key.
fixer_open() {
    jq -e --arg k "$1" '.fixer.open? | type == "object" and has($k)' \
        <<< "$FIXER_STATE" >/dev/null 2>&1
}

# put_line <file> <key> [value]: replace the key's tab-separated line, or drop it.
put_line() {
    local file="$1" key="$2" value="${3-}"
    mkdir -p "$CACHE_DIR"
    : >> "$file"
    awk -F'\t' -v k="$key" '$1 != k' "$file" > "$file.tmp"
    if [ -n "$value" ]; then printf '%s\t%s\n' "$key" "$value" >> "$file.tmp"; fi
    mv "$file.tmp" "$file"
}

# wake_field <key> <column>: one number from the key's wakes line, or nothing.
wake_field() {
    local value=""
    [ -f "$FIXER_WAKES" ] || return 0
    value=$(awk -F'\t' -v k="$1" -v c="$2" '$1 == k && !f {print $c; f=1}' "$FIXER_WAKES")
    case "$value" in ''|*[!0-9]*) return 0 ;; esac
    echo "$value"
}

# fixer_wake_age <key>: seconds since the key's first wake, or nothing.
fixer_wake_age() {
    local first
    first=$(wake_field "$1" 2)
    [ -n "$first" ] || return 0
    echo $((NOW - first))
}

# fixer_enqueue <key> <context> <dm_key>: queue the key, and ask for a wake when it
# is due. A key with no wake line starts afresh, so its old DM line is dropped.
fixer_enqueue() {
    local key="$1" context="$2" dm_key="$3" first last fresh=0
    context="${context//[$'\t\r\n']/ }"
    first=$(wake_field "$key" 2)
    last=$(wake_field "$key" 3)
    [ -n "$first" ] || { first="$NOW"; last=""; fresh=1; }
    if [ -z "$last" ] || [ $((NOW - last)) -gt "$REFIRE_S" ]; then
        echo "fixer: wake $key"
        # fixer_mark_woken stamps the last wake once the POST succeeds.
        FIXER_DUE_KEYS="$FIXER_DUE_KEYS$key"$'\n'
    fi
    dry_guard "queue fixer key $key" || return 0
    if [ "$fresh" = 1 ] && [ -s "$STALLS" ]; then put_line "$STALLS" "$dm_key"; fi
    put_line "$FIXER_QUEUE" "$key" "$context"
    put_line "$FIXER_WAKES" "$key" "$first"$'\t'"$last"
}

# fixer_mark_woken: stamp the last wake on each due key after a successful POST.
fixer_mark_woken() {
    local key first
    while read -r key; do
        [ -n "$key" ] || continue
        first=$(wake_field "$key" 2)
        put_line "$FIXER_WAKES" "$key" "${first:-$NOW}"$'\t'"$NOW"
    done <<< "$FIXER_DUE_KEYS"
}

# A claim acks the wake. Dropping the wake line lets a later recurrence wake afresh.
fixer_forget_claimed() {
    local key keys
    if [ "$DRY_RUN" != 0 ] || [ ! -s "$FIXER_WAKES" ]; then return 0; fi
    keys=$(jq -r '[.fixer.open?, .fixer.owner?] | map(objects | keys[]) | .[]' <<< "$FIXER_STATE") # pipefail-ok: jq filter pipe, not a shell pipe; a jq failure trips the ERR trap and the run takes no action
    while read -r key; do
        [ -n "$key" ] || continue
        put_line "$FIXER_WAKES" "$key"
    done <<< "$keys"
}

# fixer_prune: drop the queue and wake lines of blockers that are gone, so the
# fixer never claims a resolved key and a recurrence starts a fresh wake. The
# merged:<slug> line stays while that fix is open, so its 6h refire limit holds.
# An unattributed plan-now job hides a row's stall, so that row's stall lines stay.
fixer_prune() {
    local file="$PARITY_DIR/state/blockers.json" live key keys path s_row s_stage slug verdict
    if [ "$DRY_RUN" != 0 ]; then return 0; fi
    # An unreadable state file does not prove that a blocker is gone.
    if [ -f "$file" ] && ! jq -e . "$file" >/dev/null 2>&1; then return 0; fi
    live=$(jq -r '.active | objects | keys[]' <<< "$FIXER_STATE") # pipefail-ok: jq filter pipe, not a shell pipe; a jq failure trips the ERR trap and the run takes no action
    for key in $STALL_KEYS; do
        IFS=: read -r s_row s_stage _ <<< "$key"
        live="$live"$'\n'"stall:$s_stage:$s_row"
    done
    while read -r _ slug verdict; do
        if [ "$verdict" = "merged" ]; then live="$live"$'\n'"merged:$slug"; fi
    done <<< "$FIX_VERDICTS"
    for path in "$FIXER_QUEUE" "$FIXER_WAKES"; do
        [ -s "$path" ] || continue
        keys=$(awk -F'\t' '{print $1}' "$path")
        while read -r key; do
            if [[ "$key" == stall:* && "$HIDDEN_ROWS" == *" ${key##*:} "* ]]; then continue; fi
            if [ -n "$key" ] && ! grep -qxF -- "$key" <<< "$live"; then
                put_line "$path" "$key"
            fi
        done <<< "$keys"
    done
}

# fixer_dm <key> <text>: one error DM per key, deduped through the stalls file.
# fixer_enqueue drops a no-ack line when its blocker starts a fresh wake.
fixer_dm() {
    local key="$1" text="$2"
    if grep -qxF -- "$key" "$STALLS" 2>/dev/null; then return 0; fi
    echo "fixer: dm $key"
    dry_guard "send fixer DM $key" || return 0
    if printf '%s' "$text" | "$JSB_BIN/discord-dm" --quiet --error - >/dev/null 2>&1; then
        mkdir -p "$CACHE_DIR"
        printf '%s\n' "$key" >> "$STALLS"
    else
        log "discord-dm failed for $key; will retry next run"
    fi
}

# fix_pr_dm <dm-kind> <stage text> <key> <slug>: the DM for a fix PR that cannot land.
fix_pr_dm() {
    local kind="$1" stage="$2" key="$3" slug="$4" base jsbn="$PARITY_DIR/.."
    base=$(jq -r --arg k "$key" '.fixer.open[$k].jsbn_base // "<jsbn_base>"' <<< "$FIXER_STATE")
    fixer_dm "$kind:$key:$slug" "JSB parity fixer: $stage for $key ($slug). The loop stays blocked. Check git -C $jsbn log --oneline $base..origin/main and revert bad commits, then run: python3 $jsbn/tools/parity_loop/parity_loop.py fix release --key $key --ibl5 $MAIN_WT"
}

# fix_pr_verdict <slug>: merged, closed, red, open or none. "error" on a gh failure.
fix_pr_verdict() {
    local slug="$1" prs pr state check
    # Same subshell reason as row_verdict.
    trap - ERR
    if ! prs=$(gh pr list --repo a-jay85/IBL5 --head "$slug" --state all --json number,state,mergedAt,url,autoMergeRequest,statusCheckRollup,headRefOid 2>/dev/null) \
        || ! pr=$(printf '%s' "$prs" | jq -c "$PR_PICK" 2>/dev/null); then
        echo "error"; return 0
    fi
    if [ -z "$pr" ]; then echo "none"; return 0; fi
    state=$(printf '%s' "$pr" | jq -r '.state')
    case "$state" in
        MERGED) echo "merged" ;;
        CLOSED) echo "closed" ;;
        OPEN)
            check=$(printf '%s' "$pr" | jq -r --argjson failed "$FAILED_CONCLUSIONS" "$CHECK_FILTER")
            if [ "$check" = "failed" ]; then echo "red"; else echo "open"; fi ;;
        *) echo "open" ;;
    esac
}

# fixer_actions: wake the fixer for open blockers and act on each fix PR verdict.
fixer_actions() {
    local key dm_sent fix age slug verdict at rows last
    if fixer_armed; then
        rows=$(jq -r '.active | objects | to_entries[] | select((.value | type) == "object" and .value.bucket == "fixer") | [.key, (if .value.dm_sent == false then "false" else "true" end), (.value.fix // "" | tostring | gsub("[\\t\\r\\n]+"; " "))] | @tsv' <<< "$FIXER_STATE") # pipefail-ok: jq filter pipe, not a shell pipe; a jq failure trips the ERR trap and the run takes no action
        while IFS=$'\t' read -r key dm_sent fix; do
            [ -n "$key" ] || continue
            if fixer_known "$key"; then continue; fi
            age=$(fixer_wake_age "$key")
            fixer_enqueue "$key" "$fix" "fixer-no-ack:$key"
            if [ "$dm_sent" = "false" ] && [ -n "$age" ] && [ "$age" -gt "$FIXER_ACK_S" ]; then
                fixer_dm "fixer-no-ack:$key" "JSB parity fixer: no ack for $key after $((age / 3600))h. The loop stays blocked. Check that the T3 fixer task is on. Blocker: $fix"
            fi
        done <<< "$rows"
    fi
    while read -r key slug verdict; do
        [ -n "$key" ] || continue
        case "$verdict" in
            merged)
                # In the fingerprint on every run, so the first merge fires and a repeat does not.
                FACTS="${FACTS:+$FACTS,}fix:$slug=merged"
                last=$(wake_field "merged:$slug" 3)
                if [ -z "$last" ] || [ $((NOW - last)) -ge "$REFIRE_S" ]; then
                    echo "fixer: fix-merged $slug"
                    FIRE_REASONS="$FIRE_REASONS fix-merged:$slug"
                    FIRE_REASONS="${FIRE_REASONS# }"
                fi ;;
            closed) fix_pr_dm fixer-pr-closed "fix PR closed without merge" "$key" "$slug" ;;
            red) fix_pr_dm fixer-pr-red "fix PR has a failed check" "$key" "$slug" ;;
            none)
                at=$(jq -r --arg k "$key" '.fixer.open[$k].at // 0 | floor' <<< "$FIXER_STATE") # pipefail-ok: jq filter pipe, not a shell pipe; a jq failure trips the ERR trap and the run takes no action
                if [ $((NOW - at)) -gt "$FIXER_PR_STALE_S" ]; then
                    fix_pr_dm fixer-no-pr "no fix PR after 48h" "$key" "$slug"
                fi ;;
        esac
    done <<< "$FIX_VERDICTS"
    if [ -n "$FIXER_DUE_KEYS" ]; then
        fire_webhook "fixer-queue" "$FIXER_URL_FILE"
    fi
}

# fire_webhook <reasons> [url_file]: POST once. The URL goes to curl only through its
# stdin config. url_file defaults to the parity webhook, the only one that records state.
fire_webhook() {
    local reasons="$1" url_file="${2:-$WEBHOOK_FILE}" url body code r
    dry_guard "fire webhook ($reasons)" || return 0
    url=$(head -n 1 "$url_file" 2>/dev/null || true)
    case "$url" in
        https://*) ;;
        *) log "webhook file unusable; no action taken"; return 0 ;;
    esac
    case "$url" in
        *'"'*) log "webhook file unusable; no action taken"; return 0 ;;
    esac
    body='{"source":"jsb-parity-watch","reasons":"'"$reasons"'"}'
    code=$(printf 'url = "%s"\n' "$url" | curl -sS -o /dev/null -w '%{http_code}' --max-time 20 -X POST -H 'Content-Type: application/json' --data "$body" -K - 2>/dev/null) || code=000
    case "$code" in [0-9][0-9][0-9]) ;; *) code=000 ;; esac
    case "$code" in 2??) ;; *) log "webhook POST failed (HTTP $code)"; return 0 ;; esac
    if [ "$url_file" != "$WEBHOOK_FILE" ]; then
        fixer_mark_woken
        log "fixer webhook POST ok (HTTP $code)"
        return 0
    fi
    mkdir -p "$CACHE_DIR"
    printf '%s %s\n' "$fp" "$NOW" > "$LAST.tmp"
    mv "$LAST.tmp" "$LAST"
    for r in $reasons; do
        case "$r" in
            *:check-failed:*) printf '%s:%s\n' "${r%%:*}" "${r##*:}" >> "$FIRED_SHAS" ;;
            fix-merged:*) put_line "$FIXER_WAKES" "merged:${r#fix-merged:}" "$NOW"$'\t'"$NOW" ;;
        esac
    done
    log "webhook POST ok (HTTP $code) reasons=$reasons"
}

main() {
    local lockdir ledger inflight recording id slug out verdict fact key msg when last_fp="" last_at=0
    local open_fixes s_row s_stage age

    if [ "$DRY_RUN" = 1 ]; then
        echo "config: parity_dir=$PARITY_DIR bin=$JSB_BIN plannow_dir=$PLANNOW_DIR now=$NOW"
    fi

    lockdir="$PARITY_DIR/state/loop.lock"
    if [ -d "$lockdir" ]; then
        if ! lock_is_stale "$lockdir"; then
            quiet_exit "run lock held; no action taken"
        fi
    fi

    ledger="$PARITY_DIR/ledger.json"
    if [ ! -f "$ledger" ]; then
        quiet_exit "ledger missing at $ledger; no action taken"
    fi
    if ! jq -e '.rows | type == "array"' "$ledger" >/dev/null 2>&1; then
        quiet_exit "ledger unreadable at $ledger; no action taken"
    fi
    # set -E hands the ERR trap to this subshell. There it would print its log line
    # into $inflight and exit 0, so the log line would parse as a row. Clear it, so a
    # jq failure fails the assignment and the main shell's trap ends the run.
    inflight=$(trap - ERR; jq -r "$INFLIGHT_FILTER" "$ledger")
    recording="none"
    if [ -f "$PARITY_DIR/recordings/index.json" ]; then
        recording=$(jq -r '.current // "none"' "$PARITY_DIR/recordings/index.json" 2>/dev/null || echo "none")
    fi

    while read -r id slug; do
        [ -n "$id" ] || continue
        out=$(row_verdict "$id" "$slug")
        verdict="${out%%$'\n'*}"
        case "$verdict" in
            ERROR:*|FIRE:*|KICK:*|STALL:*|WAIT:*) ;;
            *) quiet_exit "no verdict for $id; no action taken" ;;
        esac
        case "$out" in
            *$'\n'*) fact="${out#*$'\n'}"; fact="${fact%%$'\n'*}" ;;
            *) fact="" ;;
        esac
        [ -n "$fact" ] || fact="$id=none"
        ROW_LINES="${ROW_LINES}row $id $slug $verdict"$'\n'
        FACTS="${FACTS:+$FACTS,}$fact"
        case "$verdict" in
            ERROR:*) GH_ERROR="$slug" ;;
            FIRE:*) FIRE_REASONS="${FIRE_REASONS:+$FIRE_REASONS }$id:${verdict#FIRE:}" ;;
            KICK:*) KICK=1 ;;
            STALL:*) STALL_KEYS="${STALL_KEYS:+$STALL_KEYS }$id:${verdict#STALL:}" ;;
            WAIT:plan-now-unattributed) HIDDEN_ROWS="$HIDDEN_ROWS$id " ;;
            WAIT:*) ;;
        esac
    done <<< "$inflight"

    FIXER_STATE=$(fixer_json)
    open_fixes=$(jq -r '.fixer.open? | objects | to_entries[] | select((.value | type) == "object" and (.value.slug // "") != "") | "\(.key) \(.value.slug)"' <<< "$FIXER_STATE") # pipefail-ok: jq filter pipe, not a shell pipe; a jq failure trips the ERR trap and the run takes no action
    while read -r key slug; do
        [ -n "$slug" ] || continue
        verdict=$(fix_pr_verdict "$slug" </dev/null)
        case "$verdict" in
            merged|closed|red|open|none) FIX_VERDICTS="${FIX_VERDICTS}$key $slug $verdict"$'\n' ;;
            *) GH_ERROR="$slug" ;;
        esac
    done <<< "$open_fixes"

    if [ -n "$GH_ERROR" ]; then
        quiet_exit "gh pr list failed for $GH_ERROR; no action taken"
    fi
    if [ -z "$inflight" ]; then FIRE_REASONS="no-row-in-flight"; fi

    printf '%s' "$ROW_LINES"

    if [ "$KICK" = 1 ]; then
        if dry_guard "schedule an automouse run"; then
            when=$(fmt_epoch $((NOW + SCHEDULE_DELAY_S)))
            log "scheduling automouse run at $when"
            "$JSB_BIN/automouse/run" schedule "$when" >/dev/null 2>&1 || log "automouse schedule failed"
        fi
    fi

    fixer_forget_claimed
    fixer_prune

    for key in $STALL_KEYS; do
        IFS=: read -r s_row s_stage _ <<< "$key"
        # An open fix owns its stall. fixer_actions DMs when that fix cannot land.
        if fixer_armed && fixer_open "stall:$s_stage:$s_row"; then
            continue
        fi
        if fixer_armed && [[ "$FIXER_STAGES" == *" $s_stage "* ]] && ! fixer_known "stall:$s_stage:$s_row"; then
            age=$(fixer_wake_age "stall:$s_stage:$s_row")
            # Enqueue at any age, so an unclaimed stall wakes again after REFIRE_S.
            fixer_enqueue "stall:$s_stage:$s_row" "$key" "$key"
            if [ -z "$age" ] || [ "$age" -lt "$FIXER_ACK_S" ]; then
                continue
            fi
        fi
        if grep -qxF -- "$key" "$STALLS" 2>/dev/null; then
            continue
        fi
        if dry_guard "send stall DM $key"; then
            msg=$(stall_message "$key")
            if printf '%s' "$msg" | "$JSB_BIN/discord-dm" --quiet --error - >/dev/null 2>&1; then
                mkdir -p "$CACHE_DIR"
                printf '%s\n' "$key" >> "$STALLS"
            else
                log "discord-dm failed for $key; will retry next run"
            fi
        fi
    done

    fixer_actions

    if [ -z "$FIRE_REASONS" ]; then
        echo "decision: no fire"
        return 0
    fi
    fp="$(sha256_of "$ledger")|${recording// /_}|$FACTS"
    if [ -f "$LAST" ]; then
        read -r last_fp last_at < "$LAST" || true
    fi
    case "$last_at" in ''|*[!0-9]*) last_at=0 ;; esac
    if [ "$fp" = "$last_fp" ] && [ $((NOW - last_at)) -lt "$REFIRE_S" ]; then
        echo "decision: fire suppressed (unchanged state, last fire $((NOW - last_at))s ago)"
        return 0
    fi
    echo "decision: fire ($FIRE_REASONS)"
    fire_webhook "$FIRE_REASONS"
}

main
