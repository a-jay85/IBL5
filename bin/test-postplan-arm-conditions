    "$CF_BANNER_DEFAULT" "$CF_PLANLINE" "$CF_T"
cf_check cf-suffixed-notes "$(cf_decide "$BCFD")" "FIDELITY_GATE=spawn" "FIDELITY_GATE_REASON=prior-verdict-not-terminal"

mk_prior_body "READY (re-review) — findings remediated in abc1234 and re-reviewed clean on tree $CF_T; condition (12) arms on the next /post-plan Phase 6.5 run" \
    "$CF_BANNER_DEFAULT" "$CF_PLANLINE" "$CF_T"
