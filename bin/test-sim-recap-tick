"$SRT_DRIVER" --dry-run --sim=42 > "$STUB/tick.stdout" 2> "$STUB/tick.stderr"
SRT_RC=$?
srt_ck "exit" 0 "$SRT_RC"
srt_ck "stdout games[0].sort_order" "1" "$(jq -r '.games[0].sort_order' "$STUB/tick.stdout" 2>/dev/null)"
srt_ck_lacks ssh.log "storeSimRecap" "no store call"
srt_ck_lacks ssh.log "claim-next" "no queue claim"
srt_ck_lacks ssh.log "simRecapQueue.php park" "no park call"
srt_case_done "dry_run_prints_assembled_payload"

