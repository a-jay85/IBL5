# --- Phase 6 body-marker preservation (L20) --------------------------------
# Fixtures: #1100 is OPEN (shim), everything else MERGED, so a preserved
# Depends-on: #1100 still BLOCKs condition (6).

# 1. Capture pulls a Depends-on: line
BODY_DEP_BOTH='{"body":"intro\nDepends-on: #1100\n\n## Manual Testing\n- [ ] x"}'
out_capture_depends_on="$(run_markers "$BODY_DEP_BOTH" "$BODY_DEP_BOTH")"
expect_out 'markers_capture_depends_on' 'BODY_MARKERS_CAPTURED=1' "$out_capture_depends_on"
expect_out 'markers_capture_depends_on (line present)' 'Depends-on: #1100' "$out_capture_depends_on"

# 2. Capture is case-insensitive (matches pr_dep_holds's grep -iE)
out_capture_ci="$(run_markers \
    "$(printf '{"body":"%s"}' 'intro\ndepends-on: #1100\n\n## Manual Testing\n- [ ] x')" \
    "$(printf '{"body":"%s"}' 'intro\ndepends-on: #1100\n\n## Manual Testing\n- [ ] x')")"
expect_out 'markers_capture_case_insensitive' 'BODY_MARKERS_CAPTURED=1' "$out_capture_ci"

# 3. Capture carries a multi-line <!-- no-adr: --> through its closing delimiter
BEFORE_BODY_NOADR="$(cat <<'BEOF'
{"body":"intro\n<!-- no-adr:\n  schema-only change, no decision recorded\n-->\n\n## Manual Testing\n- [ ] x"}
BEOF
)"
out_capture_noadr="$(run_markers "$BEFORE_BODY_NOADR" "$BEFORE_BODY_NOADR")"
expect_out 'markers_capture_multiline_no_adr (count=3)' 'BODY_MARKERS_CAPTURED=3' "$out_capture_noadr"
expect_out 'markers_capture_multiline_no_adr (closing delimiter)' '-->' "$out_capture_noadr"

# 4. Preserved marker => verdict=preserved, zero repair writes
BODY_WITH_DEP='{"body":"Depends-on: #1100\n\n## Manual Testing\n..."}'
out_preserved="$(run_markers "$BODY_WITH_DEP" "$BODY_WITH_DEP")"
expect_out 'markers_verify_preserved_no_write' 'BODY_MARKERS=preserved' "$out_preserved"
rec_preserved="$BASE_TMP/edit-record"
if [ ! -s "$rec_preserved" ]; then
    echo "ok: markers_verify_preserved_no_write (zero writes)"
else
    echo "FAIL: markers_verify_preserved_no_write — repair write fired on a preserved body"
    FAILED=1
fi

# 5. Dropped marker => verdict=dropped, repair write fires with marker as first line
BEFORE_BODY_DROP='{"body":"Depends-on: #1100\n\n## Manual Testing\n..."}'
AFTER_BODY_DROP='{"body":"## Manual Testing\n...\n\n<!-- files-changed:begin -->\n- foo.php\n<!-- files-changed:end -->"}'
out_dropped="$(run_markers "$BEFORE_BODY_DROP" "$AFTER_BODY_DROP")"
expect_out 'markers_verify_dropped_repairs (verdict)' 'BODY_MARKERS=dropped:' "$out_dropped"
rec_dropped="$BASE_TMP/edit-record"
first_line_dropped="$(head -1 "$rec_dropped" 2>/dev/null)"
if [ "$first_line_dropped" = "Depends-on: #1100" ]; then
    echo "ok: markers_verify_dropped_repairs (first line of repair = Depends-on: #1100)"
else
    echo "FAIL: markers_verify_dropped_repairs — first line of repair body is '$first_line_dropped', expected 'Depends-on: #1100'"
    FAILED=1
fi

# 6. End-to-end: repaired body makes condition (6) BLOCK again
repaired_body_json="$(jq -Rs '{body:.}' < "$rec_dropped" 2>/dev/null)"
if [ -n "$repaired_body_json" ]; then
    expect_block 'markers_repaired_body_rearms_cond6' BLOCK \
        "$(run_isolated "$B6" "$repaired_body_json" '' '')"
else
    echo "FAIL: markers_repaired_body_rearms_cond6 — rec_dropped was empty, case 5 must have failed"
    FAILED=1
fi

# 7. Inline prose mention counts as dropped (grep -qxF = whole-line match)
AFTER_BODY_INLINE='{"body":"See Depends-on: #1100 above for context.\n\n## Manual Testing\n..."}'
out_inline="$(run_markers "$BEFORE_BODY_DROP" "$AFTER_BODY_INLINE")"
expect_out 'markers_inline_mention_is_dropped' 'BODY_MARKERS=dropped:' "$out_inline"

# 8. No markers => BODY_MARKERS_CAPTURED=0, verdict=none, zero writes
BODY_NO_MARKERS='{"body":"## Manual Testing\nNo manual testing needed — automated."}'
out_none="$(run_markers "$BODY_NO_MARKERS" "$BODY_NO_MARKERS")"
expect_out 'markers_none_no_capture_no_write (captured=0)' 'BODY_MARKERS_CAPTURED=0' "$out_none"
expect_out 'markers_none_no_capture_no_write (verdict=none)' 'BODY_MARKERS=none' "$out_none"
rec_none="$BASE_TMP/edit-record"
if [ ! -s "$rec_none" ]; then
    echo "ok: markers_none_no_capture_no_write (zero writes)"
else
    echo "FAIL: markers_none_no_capture_no_write — spurious repair write on a marker-free body"
    FAILED=1
fi

