#!/bin/bash
# Run pending SQL migrations against a running Docker MariaDB container.
# Usage: bin/db-migrate <db-container> <migrations-dir> [db-name]
#
# Migrations are tracked in schema_migrations(version VARCHAR(255) PRIMARY KEY).
# Already-applied migrations are skipped (idempotent).

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
Usage: bin/db-migrate <db-container> <migrations-dir> [db-name]

Run pending SQL migrations against a running Docker MariaDB container.
Migrations are tracked in schema_migrations and already-applied ones are skipped
(idempotent).

  db-container    Docker container name running MariaDB
  migrations-dir  Directory containing .sql migration files
  db-name         Database name (default: iblhoops_ibl5)

Exit codes:
  0  All pending migrations applied successfully
  1  One or more migrations failed
EOF
    exit 0
fi

set -euo pipefail

source "$(dirname "$0")/lib/db-helpers.sh"

DB_CONTAINER="${1:-}"
MIGRATIONS_DIR="${2:-}"

DB_NAME="${3:-$DB_DEFAULT_NAME}"

if [ -z "$DB_CONTAINER" ] || [ -z "$MIGRATIONS_DIR" ]; then
    echo "Usage: bin/db-migrate <db-container> <migrations-dir> [db-name]" >&2
    exit 1
fi

if [ ! -d "$MIGRATIONS_DIR" ]; then
    echo "Migrations directory not found: $MIGRATIONS_DIR" >&2
    exit 1
fi

# Check there are actually .sql files
if ! ls "$MIGRATIONS_DIR"/*.sql &>/dev/null; then
    echo "No .sql files found in $MIGRATIONS_DIR"
    exit 0
fi

DB_CMD="mariadb -u $DB_ROOT_USER -p$DB_ROOT_PASS $DB_NAME"

echo "Running migrations..."
db_exec "$DB_CONTAINER" $DB_CMD \
    -e "CREATE TABLE IF NOT EXISTS schema_migrations (version VARCHAR(255) PRIMARY KEY, applied_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP);"

FAILED=0
for migration in "$MIGRATIONS_DIR"/*.sql; do
    [ -f "$migration" ] || continue
    BASENAME=$(basename "$migration")
    ALREADY=$(db_exec "$DB_CONTAINER" $DB_CMD -N \
        -e "SELECT COUNT(*) FROM schema_migrations WHERE version='$BASENAME';")
    if [ "$ALREADY" = "0" ]; then
        echo "  Applying $BASENAME..."
        if db_exec_stdin "$DB_CONTAINER" $DB_CMD < "$migration"; then
            db_exec "$DB_CONTAINER" $DB_CMD \
                -e "INSERT INTO schema_migrations (version) VALUES ('$BASENAME');"
        else
            echo "  FAILED: $BASENAME" >&2
            FAILED=$((FAILED + 1))
        fi
    fi
done

if [ "$FAILED" -gt 0 ]; then
    echo "ERROR: $FAILED migration(s) failed." >&2
    exit 1
fi
