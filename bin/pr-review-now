#!/usr/bin/env bash
# pr-review-now — fire one detached headless Claude session for a PR, running /pr-review <N>.
#
# Usage:
#   bin/pr-review-now <PR> [--dry-run]
#   bin/pr-review-now --stop <PR>
#   bin/pr-review-now --stop-all
#
#   <PR>          PR number to review (required). Fires /pr-review <PR> as a detached launchd job.
#   --dry-run     Emit the runner + plist but skip launchctl bootstrap.
#                 Also honoured via env: PR_REVIEW_NOW_DRY_RUN=1.
#   --stop <PR>   Abort the fired session for this PR: bootout the launchd label,
#                 TERM then KILL anything carrying --name <label>, release the slot
#                 (remove the plist) and clear the PR's /tmp scratch. Exits nonzero and
#                 LEAVES the slot held if a process survives KILL.
#   --stop-all    Apply --stop to every PR currently holding a pr-review-now slot.
#   --help, -h    Print this usage and exit 0.
#
# WARNING: Run from the main checkout, not a worktree. The launched session must start
# from the main checkout so /pr-review Phase 0 resolves the target PR's own worktree.
# This script pins the main checkout itself (see ROOT below).
#
# Env seams:
#   PR_REVIEW_NOW_CLAUDE     Override the claude binary (stub for tests). Unset = auto-detect.
#   PR_REVIEW_NOW_DRY_RUN=1  Emit runner + plist per PR but skip launchctl bootstrap.
#   PR_REVIEW_NOW_MODEL      Model for the fired session (default: sonnet — lets the
#                            /pr-review skill's own frontmatter pin win).
#   PR_REVIEW_NOW_DISCORD_DM Override the discord-dm binary path for the finish DM.

set -euo pipefail

# --- PATH prelude -----------------------------------------------------------------------
# A safety net for invocation from a restricted context (cron, a hook) that lacks the
# usual tool dirs. Appended, not prepended: an interactive caller's own PATH — and the
# test harness's shim dir — must still win. The runner emitted below prepends instead,
# because launchd hands it a minimal PATH with no caller preference to respect.
export PATH="$PATH:/usr/local/bin:/opt/homebrew/bin:$HOME/.bun/bin:$HOME/.local/bin:/Applications/cmux.app/Contents/Resources/bin"

CLAUDE_BIN="${PR_REVIEW_NOW_CLAUDE:-$(command -v claude || true)}"

# --- ROOT pin ---------------------------------------------------------------------------
# Resolve the MAIN checkout, never the worktree we happen to be standing in.
# --git-common-dir points at the main .git even from a linked worktree, where
# --show-toplevel would return the worktree instead.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
GIT_COMMON="$(git -C "$SCRIPT_DIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
if [[ -z "$GIT_COMMON" ]]; then
    # git < 2.31 has no --path-format; fall back to resolving the relative answer by hand.
    GIT_COMMON="$(cd "$SCRIPT_DIR" && cd "$(git rev-parse --git-common-dir)" && pwd -P)"
fi
ROOT="$(dirname "$GIT_COMMON")"

# .git is a DIRECTORY in the main checkout and a FILE in a linked worktree, so -d
# structurally rejects a worktree even if the pin above somehow returned one.
[[ -d "$ROOT/.git" ]] || {
    echo "ERROR: cannot locate main checkout (ROOT=$ROOT)" >&2
    exit 1
}
[[ -f "$ROOT/.claude/skills/pr-review/SKILL.md" ]] || {
    echo "ERROR: $ROOT does not look like the IBL5 checkout (no .claude/skills/pr-review/SKILL.md)" >&2
    exit 1
}

# --- defaults ---------------------------------------------------------------------------
MODEL="${PR_REVIEW_NOW_MODEL:-sonnet}"
EFFORT=high
JOBS=5
# Single ceiling for the bounded poll loop (wait_for_slot).
# One constant cannot drift.
CEILING_SECS=7200
MODE=fire          # fire | stop | stop-all
STOP_PRS=()
TARGET_PR=""

# --- flag parsing -----------------------------------------------------------------------
usage() { sed -n '2,28p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) PR_REVIEW_NOW_DRY_RUN=1; shift ;;
        --stop)
            [[ "$MODE" != "stop-all" ]] || { echo "ERROR: --stop and --stop-all are mutually exclusive" >&2; exit 2; }
            [[ $# -ge 2 ]] || { echo "ERROR: --stop requires a value" >&2; exit 2; }
            IFS=',' read -r -a _sprs <<< "$2"
            for _s in ${_sprs[@]+"${_sprs[@]}"}; do
                [[ "$_s" =~ ^[1-9][0-9]*$ ]] || { echo "ERROR: --stop expects positive integers, got: $_s" >&2; exit 2; }
                STOP_PRS+=("$_s")
            done
            MODE=stop; shift 2 ;;
        --stop-all)
            [[ "$MODE" == "fire" ]] || { echo "ERROR: --stop and --stop-all are mutually exclusive" >&2; exit 2; }
            MODE=stop-all; shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) echo "ERROR: unknown flag: $1" >&2; usage >&2; exit 2 ;;
        *)
            if [[ -z "$TARGET_PR" ]]; then
                [[ "$1" =~ ^[1-9][0-9]*$ ]] || { echo "ERROR: PR number must be a positive integer, got: $1" >&2; exit 1; }
                TARGET_PR="$1"; shift
            else
                echo "ERROR: unexpected positional argument: $1" >&2; exit 2
            fi ;;
    esac
done

if [[ "$MODE" == "fire" && -z "$TARGET_PR" ]]; then
    echo "ERROR: PR number is required" >&2; usage >&2; exit 1
fi

if [[ "$MODE" != "fire" ]]; then
    [[ "$MODE" != "stop" || ${#STOP_PRS[@]} -gt 0 ]] \
        || { echo "ERROR: --stop expects positive integers, got an empty list" >&2; exit 2; }
fi

# Liveness probe for a launchd label. Returns 0 = alive OR undecidable, 1 = provably dead.
# Fail closed by construction: only pgrep's "no match" (exit 1) proves death. A missing pgrep,
# or an error exit (procps rejects BSD-only flags with exit 2), reads as ALIVE — so a slot is
# never freed, and a live session is never killed, on the strength of a broken probe.
# The pattern is END-ANCHORED: `name com.ibl5.pr-review-now-1901` unanchored also matches PR
# 19011. `--name <label>` is the final argv element of caffeinate, timeout and claude alike.
_label_alive() {
    local label="$1" rc=0
    command -v pgrep >/dev/null 2>&1 || return 0
    if pgrep -f "name ${label}$" >/dev/null 2>&1; then
        return 0
    else
        rc=$?      # must be read here: in a condition context set -e is suppressed
    fi
    [[ $rc -eq 1 ]] && return 1
    return 0
}

# --- stop path --------------------------------------------------------------------------
# `launchctl bootout` unloads the label but does NOT kill the reparented caffeinate → timeout
# → claude chain, so bootout alone leaves the run burning tokens while the plist (the slot
# token) disappears. Kill by label, verify death, THEN release the slot — in that order.
stop_one_pr() {
    local PR="$1"
    local LABEL="com.ibl5.pr-review-now-${PR}"
    local PLIST="$HOME/Library/LaunchAgents/${LABEL}.plist"
    local LOG="/tmp/pr-review-now-${PR}.log"
    # End-anchored: `name ...-1901` (unanchored) also matches a LIVE session for PR 19011,
    # and on the kill path that means SIGKILLing the wrong run mid-publish.
    local PAT="name ${LABEL}$"
    local waited=0 keep=""

    launchctl bootout "gui/$(id -u)/${LABEL}" 2>/dev/null || true
    pkill -TERM -f "$PAT" 2>/dev/null || true
    sleep 2                                    # grace: let claude flush its log and exit
    pkill -KILL -f "$PAT" 2>/dev/null || true

    # Fail closed: the slot is released ONLY once nothing carries the label. If something
    # survives KILL we would rather over-count slots than hand a slot to a second session.
    while _label_alive "$LABEL"; do
        if [[ $waited -ge 5 ]]; then
            echo "ERROR: PR #${PR}: a process still carries ${LABEL} after SIGKILL;" >&2
            echo "       slot left occupied (${PLIST}); investigate before re-firing." >&2
            return 1
        fi
        sleep 1; waited=$((waited + 1))
    done

    # Preserve the log for forensics under a name the NEXT fire's pre-clear will collect.
    # It must be moved out of the glob's reach first: /tmp/pr-review-now-<N>.log.aborted also
    # matches /tmp/pr-review-*-<N>.*, so a mv-then-rm would delete what it just preserved.
    if [[ -f "$LOG" ]]; then
        keep="$(mktemp /tmp/prn-keep.XXXXXX)"
        mv -f "$LOG" "$keep"
    fi
    rm -f "$PLIST"                             # release the slot — exactly once
    rm -f /tmp/pr-review-*-"${PR}".*          # clear this PR's /pr-review scratch
    if [[ -n "$keep" ]]; then
        mv -f "$keep" "${LOG}.aborted"
    fi
    echo "stopped PR #${PR}: process killed, slot released, scratch cleared"
    return 0
}

stop_all() {
    local f label pr rc=0 found=0
    for f in "$HOME/Library/LaunchAgents"/com.ibl5.pr-review-now-*.plist; do
        [[ -e "$f" ]] || continue              # unmatched globs stay literal
        found=1
        label="$(basename "$f" .plist)"
        pr="${label##*-}"
        stop_one_pr "$pr" || rc=1             # aggregate: one stuck PR must not mask the rest
    done
    [[ "$found" -eq 1 ]] || echo "no pr-review-now slots held; nothing to stop"
    return "$rc"
}

if [[ "$MODE" != "fire" ]]; then
    _stop_rc=0
    if [[ "$MODE" == "stop-all" ]]; then
        stop_all || _stop_rc=$?
    else
        for _p in "${STOP_PRS[@]}"; do stop_one_pr "$_p" || _stop_rc=1; done
    fi
    exit "$_stop_rc"
fi

# Checked HERE, not at assignment time: the stop verbs are an emergency abort and must keep
# working on a machine where the claude binary has moved. Only the firing path needs it.
[[ -n "$CLAUDE_BIN" && -x "$CLAUDE_BIN" ]] || {
    echo "ERROR: claude binary not found on PATH (set PR_REVIEW_NOW_CLAUDE to override)" >&2
    exit 1
}

# --- fire -------------------------------------------------------------------------------
# Every temp path is keyed to the PR number, never to $$ or a timestamp: those are
# process-local and do not survive the launchd boundary (defect class B1, 33280f865).
fire_pr() {
    local PR="$1"
    local LABEL="com.ibl5.pr-review-now-${PR}"
    local PLIST="$HOME/Library/LaunchAgents/${LABEL}.plist"
    local RUNNER="/tmp/pr-review-now-runner-${PR}.sh"
    local LOG="/tmp/pr-review-now-${PR}.log"
    local PROMPT="/tmp/pr-review-now-prompt-${PR}.md"
    mkdir -p "$(dirname "$PLIST")"

    # A --stop that was itself interrupted can leave this PR's /pr-review scratch behind.
    # Clear it — but only when the label is provably dead, so we can never delete a live
    # run's working state.
    # The glob is deliberately broad (a new /pr-review scratch name is covered automatically);
    # the driver's OWN three paths are excluded by name, because $PROMPT and $RUNNER are written
    # just below and $LOG is read by the runner — test scripts may pre-plant
    # /tmp/pr-review-now-<PR>.log for a PR they then fire.
    # $LOG.aborted is deliberately NOT excluded: the previous abort's forensics are superseded
    # the moment this PR is re-fired, and that is what bounds /tmp growth.
    local _stale
    if ! _label_alive "$LABEL"; then
        for _stale in /tmp/pr-review-*-"${PR}".*; do
            [[ -e "$_stale" ]] || continue
            case "$_stale" in
                "$LOG"|"$PROMPT"|"$RUNNER") continue ;;
            esac
            rm -f "$_stale"
        done
    fi

    # BQ1 probed YES on 2026-08-21: disable-model-invocation gates the in-session Skill
    # tool, not the user position, so `claude -p "/pr-review N"` resolves the slash command.
    printf '/pr-review %s\n' "$PR" > "$PROMPT"

    # Header is shell-quoted once via %q; the body is a quoted heredoc emitted verbatim,
    # so nothing in it expands twice.
    {   printf '#!/usr/bin/env bash\n'
        printf 'ROOT=%q\n'       "$ROOT"
        printf 'LABEL=%q\n'      "$LABEL"
        printf 'PLIST=%q\n'      "$PLIST"
        printf 'LOG=%q\n'        "$LOG"
        printf 'PROMPT=%q\n'     "$PROMPT"
        printf 'PR=%q\n'         "$PR"
        printf 'MODEL=%q\n'      "$MODEL"
        printf 'EFFORT=%q\n'     "$EFFORT"
        printf 'CLAUDE_BIN=%q\n' "$CLAUDE_BIN"
        printf 'DISCORD_DM=%q\n' "${PR_REVIEW_NOW_DISCORD_DM:-$ROOT/bin/discord-dm}"
        cat <<'RUNNER_EOF'
export PATH="/usr/local/bin:/opt/homebrew/bin:$HOME/.bun/bin:$HOME/.local/bin:/Applications/cmux.app/Contents/Resources/bin:$PATH"
cd "$ROOT" || exit 1
started=$(date +%s)

# The finish DM's fields. Every terminal branch sets them; notify() at the tail sends once.
DM_ICON=""      # ✅ completed · ❌ failed
DM_VERDICT=""   # the RESULT line
DM_NEXT=""      # what happens next

CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 CLAUDE_HEADLESS=1 \
    caffeinate -s timeout 3600 "$CLAUDE_BIN" -p "$(cat "$PROMPT")" \
    --dangerously-skip-permissions \
    --model "$MODEL" --effort "$EFFORT" \
    --name "$LABEL" > "$LOG" 2>&1
rc=$?
elapsed=$(( $(date +%s) - started ))

if [ "$rc" -eq 0 ]; then
    DM_ICON="✅"; DM_VERDICT="completed — exit 0"; DM_NEXT="read the log"
elif [ "$rc" -eq 124 ]; then
    DM_ICON="❌"; DM_VERDICT="failed — killed by the 3600s timeout"; DM_NEXT="read the log"
else
    DM_ICON="❌"; DM_VERDICT="failed — claude exited $rc"; DM_NEXT="read the log"
fi

# The whole reason this job exists in the background: tell the human it finished.
# `claude -p` does not stream, so $LOG is empty until this point and there is no
# earlier moment worth watching.
#
# BEFORE the teardown below, and that ordering is load-bearing: `launchctl bootout`
# terminates this job, and discord-dm retries across a window longer than a pm2
# restart (~5min15s). Sending after the bootout would race the send against its
# own termination and lose exactly the messages that matter — the ones sent while
# prod is bouncing.
notify() {
    if [ ! -x "$DISCORD_DM" ]; then
        echo "pr-review-now: no executable discord-dm at $DISCORD_DM — not notifying."
        return 0
    fi

    # A verdict this runner never set means someone added a branch and missed it.
    # Say so in the DM rather than sending a blank line.
    local msg
    msg="${DM_ICON:-❓} pr-review-now: PR #${PR}
RESULT ${DM_VERDICT:-unknown — the runner set no verdict}
${elapsed}s · ${DM_NEXT:-read the log}
log: $LOG"

    if ! printf '%s' "$msg" | "$DISCORD_DM" -; then
        # discord-dm already spooled it and raised a macOS notification. The
        # verdict is in $LOG regardless, so an undeliverable DM is never fatal.
        echo "pr-review-now: DM UNDELIVERED (spooled by discord-dm) — the verdict above stands."
    fi
}
notify
# Releasing the slot is the FIRST post-claude action: "plist present" == "job live"
# is what the concurrency cap counts.
rm -f "$PLIST"
launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
RUNNER_EOF
    } > "$RUNNER"
    chmod +x "$RUNNER"

    # Unquoted heredoc: ${LABEL}/${RUNNER}/${ROOT}/${LOG}/${HOME} expand at write time.
    cat > "$PLIST" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>${LABEL}</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>-lc</string><string>exec ${RUNNER}</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>WorkingDirectory</key><string>${ROOT}</string>
  <key>StandardOutPath</key><string>${LOG}</string>
  <key>StandardErrorPath</key><string>${LOG}</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:${HOME}/.bun/bin:${HOME}/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict></plist>
PLIST_EOF

    if [[ -n "${PR_REVIEW_NOW_DRY_RUN:-}" ]]; then
        echo "DRY(plist) PR #${PR}: runner=${RUNNER} plist=${PLIST}"
        return 0
    fi
    launchctl bootout "gui/$(id -u)/${LABEL}" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
    echo "Fired PR #${PR}: label=${LABEL}, log=${LOG}"
}

# --- concurrency cap --------------------------------------------------------------------
# The plist IS the slot token: the runner deletes it the moment claude returns.

# _label_alive() (the liveness probe reap_stale and stop_one_pr share) is defined ABOVE the
# stop dispatch: bash defines functions as it executes, so a definition down here would not
# exist yet when the --stop path runs.
live_slots() {
    local f n=0
    for f in "$HOME/Library/LaunchAgents"/com.ibl5.pr-review-now-*.plist; do
        # A non-matching glob stays literal, so -e is what distinguishes zero from one.
        if [[ -e "$f" ]]; then n=$((n + 1)); fi
    done
    printf '%s\n' "$n"
}

reap_stale() {   # plist on disk, no live label AND no live process = the job really died
    # Under the test seam nothing is ever bootstrapped, so every plist would look stale
    # and the reaper would eat the very output the cap is counting.
    [[ -n "${PR_REVIEW_NOW_DRY_RUN:-}" ]] && return 0
    local f label
    for f in "$HOME/Library/LaunchAgents"/com.ibl5.pr-review-now-*.plist; do
        [[ -e "$f" ]] || continue
        label="$(basename "$f" .plist)"
        launchctl list "$label" >/dev/null 2>&1 && continue   # label still live → keep the slot
        _label_alive "$label" && continue                     # L34: claude still running → keep it
        rm -f "$f"; echo "reaped stale slot $label"
    done
    return 0                                                  # a trailing failed test must not
}                                                             # propagate out under set -e

wait_for_slot() {
    local waited=0
    while [[ "$(live_slots)" -ge "$JOBS" ]]; do
        echo "waiting for slot ($(live_slots)/$JOBS in flight)…"
        reap_stale
        [[ "$(live_slots)" -lt "$JOBS" ]] && break
        if [[ -n "${PR_REVIEW_NOW_DRY_RUN:-}" ]]; then
            echo "cap reached under PR_REVIEW_NOW_DRY_RUN — not sleeping; stopping here." >&2
            exit 0
        fi
        sleep 5; waited=$((waited + 5))
        if [[ $waited -ge $CEILING_SECS ]]; then echo "ERROR: waited 2h for a slot; aborting" >&2; exit 1; fi
    done
}

# Snapshot the live job table ONCE, into a variable. Never `launchctl list | grep -q`:
# under `set -o pipefail`, grep -q exits on the first match, launchctl takes SIGPIPE, and
# the pipeline reports failure even though the label WAS found — silently disabling the
# already-running skip. `|| true` also covers Linux CI, which has no launchctl at all.
LAUNCHCTL_LIST="$(launchctl list 2>/dev/null || true)"

# Anchored at end-of-line: the label carries no suffix, so an unanchored match
# would let a live PR 1892 job suppress a fire for PR 189.
if grep -qE "com\.ibl5\.pr-review-now-${TARGET_PR}$" <<< "$LAUNCHCTL_LIST"; then
    echo "PR #${TARGET_PR} is already running — skipping. Use --stop ${TARGET_PR} to abort it." >&2
    exit 0
fi

wait_for_slot
fire_pr "$TARGET_PR"
