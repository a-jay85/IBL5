case_end holdrepeat-plan-comment-fails-no-refire

# 52 (a plan-only fix on a branch ahead of master commits nothing, pushes nothing, comments and re-fires)
hr_reset
{ printf 'NOTE=$(sed -nE %s "%s")\n' "'$HR_NOTE_SED'" "$TMP/claude.prompt"
  printf 'printf -- "- bin/test-widget, bin/widget-tool and The widget renders widgetmark: the work never needed them\\n" > "$NOTE"\n'
  printf 'printf "# Widget plan\\n" > "%s"\n' "$HR_PLAN_FILE"
} > "$TMP/effects/hr-planonly.sh"
export CLAUDE_STUB_REPLY="$TMP/reply-hr-fixed" CLAUDE_STUB_EFFECT="$TMP/effects/hr-planonly.sh"
hr_run
need "rc 0 (stderr: $ERR)" test "$RC" = 0
need "final line" final_is "$STDOUT" fixed
need "plan comment posted" gh_has "pr comment"
need "post-plan re-fired" test "$(ppn_count)" = 1
need "HEAD unchanged" head_is_tip
need "origin unchanged" origin_is_tip
need "plan edit kept" test ! "$(cmp -s "$TMP/plan.orig" "$HR_PLAN_FILE" && echo same)" = same
case_end holdrepeat-plan-only-fix-ships

# 53 (the default STATE_DIR sits under the gitignored out/ dir: the launcher's own "started"
# ledger write and a concurrent harness run writing to out/ are not tamper)
hr_reset
HR_EXCL="$MAIN/.git/info/exclude"
cp "$HR_EXCL" "$TMP/exclude.orig"
printf 'tools/postplan-harness/out/\n' >> "$HR_EXCL"
HR_DEF_STATE="$MAIN/tools/postplan-harness/out/state"
mkdir -p "$HR_DEF_STATE"
hr_seed "$HR_DEF_STATE" "$HR_REASON"
export POSTPLAN_FIX_STATE_DIR=""
# The stub session ends within a second, and bash 3.2's -nt compares whole seconds, so the
# effects date their writes 5 s ahead, as a real session minutes long would.
HR_LATER='python3 -c "import os,sys,time; t=time.time()+5; [os.utime(p,(t,t)) for p in sys.argv[1:]]"'
{ cat "$TMP/effects/hr-fix.sh"
  printf 'printf "{}\\n" > "%s/concurrent-run.json"\n' "$MAIN/tools/postplan-harness/out"
  printf '%s "%s/concurrent-run.json" "%s"/*.json\n' "$HR_LATER" "$MAIN/tools/postplan-harness/out" "$HR_DEF_STATE"
} > "$TMP/effects/hr-outdir.sh"
export CLAUDE_STUB_REPLY="$TMP/reply-hr-fixed" CLAUDE_STUB_EFFECT="$TMP/effects/hr-outdir.sh"
hr_run
cp "$TMP/exclude.orig" "$HR_EXCL"
need "rc 0 (stderr: $ERR)" test "$RC" = 0
need "final line" final_is "$STDOUT" fixed
need "no gate-path DM" test "$(dm_has 'gate-path' && echo yes || echo no)" = no
need "ledger in the default state dir" grep -qF "fixed-refire-rc=0" "$HR_DEF_STATE/$B_HR.holdrepeat-fix.json"
rm -rf "$HR_DEF_STATE" "$MAIN/tools/postplan-harness/out/concurrent-run.json"
case_end holdrepeat-state-dir-not-tamper

# 54 (a session that runs pytest leaves gitignored harness .pyc files in the worktree: not
# tamper, and the session env sets PYTHONDONTWRITEBYTECODE so it should write none)
hr_reset
cp "$HR_EXCL" "$TMP/exclude.orig"
printf '__pycache__/\n*.pyc\n' >> "$HR_EXCL"
{ cat "$TMP/effects/hr-fix.sh"
  printf 'printf "%%s" "${PYTHONDONTWRITEBYTECODE-unset}" > "%s"\n' "$TMP/pydwb"
  printf 'mkdir -p tools/postplan-harness/harness/__pycache__\n'
  printf 'printf "x" > tools/postplan-harness/harness/__pycache__/holdrepeat.cpython-312.pyc\n'
  printf '%s tools/postplan-harness/harness/__pycache__/holdrepeat.cpython-312.pyc\n' "$HR_LATER"
} > "$TMP/effects/hr-pyc.sh"
export CLAUDE_STUB_REPLY="$TMP/reply-hr-fixed" CLAUDE_STUB_EFFECT="$TMP/effects/hr-pyc.sh"
rm -f "$TMP/pydwb"
( unset PYTHONDONTWRITEBYTECODE; hr_run; printf '%s\n%s\n' "$RC" "$STDOUT" > "$TMP/pyc.out" )
cp "$TMP/exclude.orig" "$HR_EXCL"
HR_PYC_RC=$(sed -n 1p "$TMP/pyc.out"); HR_PYC_OUT=$(sed -n '2,$p' "$TMP/pyc.out")
need "rc 0" test "$HR_PYC_RC" = 0
need "final line" final_is "$HR_PYC_OUT" fixed
need "session env sets PYTHONDONTWRITEBYTECODE=1" test "$(cat "$TMP/pydwb" 2>/dev/null)" = 1
need "worktree pyc purged" test ! -e "$WTH/tools/postplan-harness/harness/__pycache__/holdrepeat.cpython-312.pyc"
case_end holdrepeat-pycache-not-tamper

# 54a (a harness/ package at the worktree root never shadows the real one: the launcher's cwd
# is $WT, and a planted holdrepeat whose fix-recheck exits 0 must not be what runs. Ignored and
# older than t0, so no guard removes it and every _hr_py call runs with it in place.)
hr_plant() {  # <dir>: a harness package that records its import and exits 0 on any subcommand
    mkdir -p "$1/harness"
    printf 'open("%s", "a").write("init\\n")\n' "$TMP/planted.hit" > "$1/harness/__init__.py"
    printf 'import sys\nopen("%s", "a").write("holdrepeat\\n")\nprint("ok")\nsys.exit(0)\n' "$TMP/planted.hit" > "$1/harness/holdrepeat.py"
}
hr_reset
cp "$HR_EXCL" "$TMP/exclude.orig"
printf '/harness/\n' >> "$HR_EXCL"
hr_plant "$WTH"
rm -f "$TMP/planted.hit"
export CLAUDE_STUB_REPLY="$TMP/reply-hr-fixed" CLAUDE_STUB_EFFECT="$TMP/effects/hr-fix.sh"
hr_run
cp "$TMP/exclude.orig" "$HR_EXCL"
rm -rf "$WTH/harness"
need "rc 0 (stderr: $ERR)" test "$RC" = 0
need "final line" final_is "$STDOUT" fixed
need "planted module never imported" test ! -e "$TMP/planted.hit"
need "ledger written by the real module" ledger_has "fixed-refire-rc=0"
case_end holdrepeat-planted-module-not-imported

# 54b (a session that plants an untracked harness/ package at the worktree root is rejected:
# the files never ride the push and are gone afterwards)
hr_reset
{ cat "$TMP/effects/hr-fix.sh"; declare -f hr_plant; printf 'TMP=%q\nhr_plant .\n' "$TMP"; } > "$TMP/effects/hr-plant.sh"
rm -f "$TMP/planted.hit"
export CLAUDE_STUB_REPLY="$TMP/reply-hr-fixed" CLAUDE_STUB_EFFECT="$TMP/effects/hr-plant.sh"
hr_run
need "rc 21" test "$RC" = 21
need "final line" final_is "$STDOUT" gave-up-planted-python
need "DM names the planted path" dm_has "planted-python: harness/"
need "origin unchanged" origin_is_tip
need "no post-plan call" no_ppn
need "planted files removed" test ! -e "$WTH/harness"
need "worktree clean" wt_clean
need "HEAD restored" head_is_tip
need "planted module never imported" test ! -e "$TMP/planted.hit"
case_end holdrepeat-planted-module-blocks-push

# 55 (the plan comment is verified by the URL gh pr comment printed, so a first page of
# comments that misses the new one does not count as "did not land")
hr_reset
: > "$TMP/gh.paged"
export CLAUDE_STUB_REPLY="$TMP/reply-hr-fixed" CLAUDE_STUB_EFFECT="$TMP/effects/hr-planedit.sh"
hr_run
need "rc 0 (stderr: $ERR)" test "$RC" = 0
need "final line" final_is "$STDOUT" fixed
need "comment read back by its id" gh_has "api repos/a-jay85/IBL5/issues/comments/555"
need "one post-plan call" test "$(ppn_count)" = 1
case_end holdrepeat-comment-verified-by-url

# 56 (someone else pushes the PR branch during the session: the revert leaves that push alone
# and the DM says so)
hr_reset
cat > "$TMP/effects/hr-ownerpush.sh" <<EFFEOF
sha=\$(git commit-tree "HEAD^{tree}" -p HEAD -m owner-push)
git push -q origin "\$sha:refs/heads/$B_HR"
printf '%s\n' "\$sha" > "$TMP/owner.sha"
EFFEOF
export CLAUDE_STUB_REPLY="$TMP/reply-hr-blocked" CLAUDE_STUB_EFFECT="$TMP/effects/hr-ownerpush.sh"
hr_run
need "rc 21" test "$RC" = 21
need "final line" final_is "$STDOUT" gave-up-refs
need "owner's push kept on origin" test "$(origin_hr)" = "$(cat "$TMP/owner.sha" 2>/dev/null)"
need "DM says the remote was left as is" dm_has "left as is"
need "worktree back at HEAD0" head_is_tip
need "no post-plan call" no_ppn
case_end holdrepeat-owner-push-kept

# 57 (the session's own commit pushed to origin is still rewritten back to HEAD0)
hr_reset
{ cat "$TMP/effects/hr-commit.sh"; printf 'git push -q origin "HEAD:refs/heads/%s"\n' "$B_HR"; } > "$TMP/effects/hr-sessionpush.sh"
export CLAUDE_STUB_REPLY="$TMP/reply-hr-blocked" CLAUDE_STUB_EFFECT="$TMP/effects/hr-sessionpush.sh"
hr_run
need "rc 21" test "$RC" = 21
need "final line" final_is "$STDOUT" gave-up-refs
need "origin rewritten to HEAD0" origin_is_tip
need "HEAD restored" head_is_tip
case_end holdrepeat-session-push-reverted

# 58 (--holdrepeat --dry-run is inert: no fetch, so an unreachable origin and a dirty tree
# do not change the result, and no temp dir is made)
hr_reset
printf 'x\n' > "$WTH/untracked.txt"
HR_URL=$(git -C "$MAIN" remote get-url origin)
git -C "$MAIN" remote set-url origin "$TMP/no-such-origin.git"
mkdir -p "$TMP/dryrun-tmp"
( export TMPDIR="$TMP/dryrun-tmp"; run_fix "$SUT" --holdrepeat --dry-run 77; printf '%s\n%s\n' "$RC" "$STDOUT" > "$TMP/dry.out" )
git -C "$MAIN" remote set-url origin "$HR_URL"
rm -f "$WTH/untracked.txt"
HR_DRY_RC=$(sed -n 1p "$TMP/dry.out"); HR_DRY_OUT=$(sed -n '2,$p' "$TMP/dry.out")
need "rc 0" test "$HR_DRY_RC" = 0
need "final line" final_is "$HR_DRY_OUT" dry-run
need "prompt printed" has_s "$HR_DRY_OUT" "HOLDREPEAT_FIX: fixed"
need "no temp dir made" test -z "$(ls -A "$TMP/dryrun-tmp")"
need "no claude call" no_args
case_end holdrepeat-dry-run-inert
hr_reset

h_done
