chk_rc "E6 missing registry" 0
log_has 'empty keep e-old: probe error' || note_err "missing registry not a probe error"
printf 'not json' > "$CD/registry.json"
rt "${E_ON[@]}" -- --force
log_has 'session registry unparseable' || note_err "bad registry not a probe error"
rt "${E_ON[@]}" WT_GC_LAUNCHCTL=/nonexistent/launchctl -- --force
log_has 'launchctl list failed' || note_err "launchctl failure not a probe error"
[ -d "$(wt_dir e-old)" ] || note_err "removed"
finish_case
fi

if should_run E7-empty-reaped; then
fx E7-empty-reaped
mk_wt e-old e-old age_days=10; row EMPTY e-old
SHA="$(git -C "$ENV_MAIN" rev-parse refs/heads/e-old)"
rt "${E_ON[@]}" -- --force
chk_rc E7 0
log_has 'empty reaped e-old branch=e-old age=10d' || note_err "no reaped line"
[ -d "$(wt_dir e-old)" ] && note_err "worktree still present"
[ "$(cat "$CD/wt-remove-argv" 2>/dev/null)" = "$(printf 'e-old\n--volumes')" ] || note_err "wt-remove argv not exactly e-old --volumes"
has_branch e-old && note_err "branch still present"
tips_has "$SHA refs/heads/e-old" || note_err "tips lacks sha"
finish_case
fi

if should_run E8-young-kept; then
fx E8-young-kept
mk_wt e-young e-young age_days=3; row EMPTY e-young
