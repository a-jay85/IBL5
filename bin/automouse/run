#!/bin/bash
# Wrapper script for the IBL5 automouse autonomous workflow.
# Called by launchd on the recurring com.ibl5.automouse schedule. Loops through
# queued plans, firing two claude -p invocations per plan (implementation +
# post-plan) until the queue is empty or the time guard is exceeded.
#
# To test manually: bin/automouse/run
# To force-trigger via launchd: launchctl start com.ibl5.automouse
# To schedule a one-shot run: bin/automouse/run schedule "2026-05-28 20:00 PDT"
# To pause tonight's run:      bin/automouse/run disarm-tonight
# To pause until a given time: bin/automouse/run disarm-until "2026-08-20 09:00 PDT"

set -euo pipefail

# launchd runs with minimal env — ensure our tools are findable
export PATH="/usr/local/bin:/opt/homebrew/bin:$HOME/.bun/bin:$HOME/.local/bin:/Applications/cmux.app/Contents/Resources/bin:$PATH"

# --- One-shot scheduler subcommand ----------------------------------------
# Usage: bin/automouse/run schedule "YYYY-MM-DD HH:MM [TZ]"
# Creates a self-cleaning launchd agent that fires bin/automouse/run once at the
# given time, then removes its own plist and boots itself out. The timezone
# abbreviation is optional and defaults to the system's local zone.
# Example: bin/automouse/run schedule "2026-05-28 20:00 PDT"
if [ "${1:-}" = "schedule" ]; then
    WHEN="${2:-}"
    if [ -z "$WHEN" ]; then
        echo "usage: bin/automouse/run schedule \"YYYY-MM-DD HH:MM [TZ]\"" >&2
        echo "example: bin/automouse/run schedule \"2026-05-28 20:00 PDT\"" >&2
        exit 1
    fi

    # Resolve to an epoch — try with a timezone abbreviation first, then local.
    EPOCH=$(date -j -f '%Y-%m-%d %H:%M %Z' "$WHEN" +%s 2>/dev/null || true)
    if [ -z "$EPOCH" ]; then
        EPOCH=$(date -j -f '%Y-%m-%d %H:%M' "$WHEN" +%s 2>/dev/null || true)
    fi
    if [ -z "$EPOCH" ]; then
        echo "error: could not parse time '$WHEN'" >&2
        echo "expected: YYYY-MM-DD HH:MM [TZ]  (e.g. 2026-05-28 20:00 PDT)" >&2
        exit 1
    fi

    if [ "$EPOCH" -le "$(date +%s)" ]; then
        echo "error: '$WHEN' resolves to the past ($(date -r "$EPOCH" '+%Y-%m-%d %H:%M %Z'))" >&2
        exit 1
    fi

    # launchd StartCalendarInterval is interpreted in system-local time — derive
    # local calendar components from the resolved epoch. 10# forces base-10 so
    # values like 08/09 don't trip bash's octal parser.
    CAL_MONTH=$((10#$(date -r "$EPOCH" +%m)))
    CAL_DAY=$((10#$(date -r "$EPOCH" +%d)))
    CAL_HOUR=$((10#$(date -r "$EPOCH" +%H)))
    CAL_MIN=$((10#$(date -r "$EPOCH" +%M)))
    LOCAL_STR=$(date -r "$EPOCH" '+%Y-%m-%d %H:%M %Z')

    LABEL="com.ibl5.automouse-oneshot-$EPOCH"
    PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
    SELF="/Users/ajaynicolas/GitHub/IBL5/bin/automouse/run"
    OUT_LOG="$HOME/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/automouse/logs/launchd-oneshot-stdout.log"
    ERR_LOG="$HOME/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/automouse/logs/launchd-oneshot-stderr.log"
    mkdir -p "$(dirname "$OUT_LOG")"

    cat > "$PLIST" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$LABEL</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-lc</string>
		<string>$SELF; rm -f "$PLIST"; launchctl bootout gui/\$(id -u)/$LABEL</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Month</key>
		<integer>$CAL_MONTH</integer>
		<key>Day</key>
		<integer>$CAL_DAY</integer>
		<key>Hour</key>
		<integer>$CAL_HOUR</integer>
		<key>Minute</key>
		<integer>$CAL_MIN</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>/Users/ajaynicolas/GitHub/IBL5</string>
	<key>StandardOutPath</key>
	<string>$OUT_LOG</string>
	<key>StandardErrorPath</key>
	<string>$ERR_LOG</string>
</dict>
</plist>
PLIST_EOF

    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST"

    echo "Scheduled one-shot automouse-run:"
    echo "  fires:  $LOCAL_STR  (local time)"
    echo "  label:  $LABEL"
    echo "  plist:  $PLIST"
    echo "  note:   runs only if the Mac is awake then; self-removes after firing."
    exit 0
fi

# --- Disarm subcommands ----------------------------------------------------
# Usage: bin/automouse/run disarm-tonight
#        bin/automouse/run disarm-until "YYYY-MM-DD HH:MM [TZ]"
#
# Takes the recurring com.ibl5.automouse job out of launchd and arms a one-shot
# agent that bootstraps the SAME plist back at the given time.
#
# The ordering is deliberate and fail-safe: the re-arm agent is bootstrapped and
# VERIFIED first, and only then is the recurring job booted out — so a failure to
# arm leaves the pipeline running instead of silently off. That is the exact
# failure mode of the 2026-08-11 outage, where the re-enable was queued with
# `at` and never fired because macOS ships com.apple.atrun disabled; four
# scheduled runs were lost before anyone noticed.
#
# Every launchctl call goes through $LAUNCHCTL so bin/test-automouse-disarm can
# stub it with a recording shim and assert the arm-before-disarm ordering.

# Resolve "YYYY-MM-DD HH:MM [TZ]" to an epoch. BSD (macOS) forms first, GNU
# fallback last so these helpers stay exercisable on the Linux CI runner.
parse_when_epoch() {
    local when="$1" epoch=""
    epoch=$(date -j -f '%Y-%m-%d %H:%M %Z' "$when" +%s 2>/dev/null || true)
    [ -n "$epoch" ] || epoch=$(date -j -f '%Y-%m-%d %H:%M' "$when" +%s 2>/dev/null || true)
    [ -n "$epoch" ] || epoch=$(date -d "$when" +%s 2>/dev/null || true)
    [ -n "$epoch" ] || return 1
    printf '%s\n' "$epoch"
}

# Format an epoch with a strftime spec: BSD `date -r`, GNU `date -d @`.
epoch_fmt() {
    date -r "$1" "+$2" 2>/dev/null || date -d "@$1" "+$2"
}

# Hour and Minute of the recurring job's StartCalendarInterval, space-separated.
# Returns 1 when the key is absent or holds an ARRAY of intervals (which has no
# single Hour) — callers must error out rather than fall through to a guessed
# fire time.
daily_fire_hhmm() {
    local plist="$1" h m
    h=$(plutil -extract StartCalendarInterval.Hour raw -o - -- "$plist" 2>/dev/null || true)
    m=$(plutil -extract StartCalendarInterval.Minute raw -o - -- "$plist" 2>/dev/null || true)
    case "$h" in ''|*[!0-9]*) return 1 ;; esac
    case "$m" in ''|*[!0-9]*) m=0 ;; esac
    printf '%s %s\n' "$((10#$h))" "$((10#$m))"
}

# Next local-wall-clock occurrence of hour:minute strictly after now_epoch.
# Re-parses tomorrow's calendar date instead of adding 86400 so a DST transition
# doesn't slide the fire time by an hour.
next_daily_epoch() {
    local hour="$1" min="$2" now="$3" day cand
    day=$(epoch_fmt "$now" '%Y-%m-%d')
    cand=$(parse_when_epoch "$(printf '%s %02d:%02d' "$day" "$hour" "$min")") || return 1
    if [ "$cand" -le "$now" ]; then
        day=$(epoch_fmt "$((now + 86400))" '%Y-%m-%d')
        cand=$(parse_when_epoch "$(printf '%s %02d:%02d' "$day" "$hour" "$min")") || return 1
    fi
    printf '%s\n' "$cand"
}

# PID of an in-flight automouse run; returns 1 when idle or not loaded.
automouse_running_pid() {
    local out pid
    out=$("${LAUNCHCTL:-launchctl}" list com.ibl5.automouse 2>/dev/null) || return 1
    pid=$(printf '%s\n' "$out" | sed -n 's/.*"PID"[[:space:]]*=[[:space:]]*\([0-9][0-9]*\);.*/\1/p' | head -1)
    [ -n "$pid" ] || return 1
    printf '%s\n' "$pid"
}

disarm_until_epoch() {
    local rearm_epoch="$1"
    local lc="${LAUNCHCTL:-launchctl}"
    local agents="${LAUNCH_AGENTS_DIR:-$HOME/Library/LaunchAgents}"
    local state="${AUTOMOUSE_STATE_DIR:-$HOME/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/automouse}"
    local daily="$agents/com.ibl5.automouse.plist"
    local label="com.ibl5.automouse-rearm-$rearm_epoch"
    local plist="$agents/$label.plist"
    local breadcrumb="$state/.disarmed-until"
    local log="$state/logs/launchd-rearm.log"
    local uid pid stale cal_month cal_day cal_hour cal_min hhmm next_fire

    if [ ! -f "$daily" ]; then
        echo "error: recurring plist not found: $daily" >&2
        return 1
    fi
    uid=$(id -u)

    # launchctl bootout SIGTERMs a running instance — never take down a run in
    # flight just to pause the schedule.
    if pid=$(automouse_running_pid); then
        echo "error: an automouse run is in flight (PID $pid)." >&2
        echo "       Disarming now would SIGTERM it. Retry once it finishes." >&2
        return 1
    fi

    mkdir -p "$agents" "$state/logs"

    # Clear only OUR re-arm agents so repeated disarms don't stack. Deliberately
    # NOT the broader com.ibl5.automouse-* glob — that would also boot out and
    # delete a one-shot run the user scheduled with `run schedule`.
    for stale in "$agents"/com.ibl5.automouse-rearm-*.plist; do
        [ -e "$stale" ] || continue
        "$lc" bootout "gui/$uid/$(basename "$stale" .plist)" 2>/dev/null || true
        rm -f "$stale"
    done

    # 10# forces base-10 so values like 08/09 don't trip bash's octal parser.
    cal_month=$((10#$(epoch_fmt "$rearm_epoch" '%m')))
    cal_day=$((10#$(epoch_fmt "$rearm_epoch" '%d')))
    cal_hour=$((10#$(epoch_fmt "$rearm_epoch" '%H')))
    cal_min=$((10#$(epoch_fmt "$rearm_epoch" '%M')))

    # The re-arm command chains on success only: if the bootstrap fails, the
    # plist and the breadcrumb are KEPT and the failure is logged, so the
    # evidence and the retry both survive. A `;`-chained self-delete would erase
    # both and leave a zero-byte log indistinguishable from success.
    cat > "$plist" <<PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$label</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-lc</string>
		<string>if launchctl list com.ibl5.automouse >/dev/null 2>/dev/null; then echo "[\$(date '+%Y-%m-%d %H:%M:%S')] $label: com.ibl5.automouse already loaded, nothing to re-arm"; rm -f "$breadcrumb" "$plist"; launchctl bootout gui/$uid/$label; elif launchctl bootstrap gui/$uid "$daily"; then echo "[\$(date '+%Y-%m-%d %H:%M:%S')] $label: re-armed com.ibl5.automouse"; rm -f "$breadcrumb" "$plist"; launchctl bootout gui/$uid/$label; else echo "[\$(date '+%Y-%m-%d %H:%M:%S')] $label: FAILED to re-arm com.ibl5.automouse - keeping $plist for retry"; fi</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Month</key>
		<integer>$cal_month</integer>
		<key>Day</key>
		<integer>$cal_day</integer>
		<key>Hour</key>
		<integer>$cal_hour</integer>
		<key>Minute</key>
		<integer>$cal_min</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>$log</string>
	<key>StandardErrorPath</key>
	<string>$log</string>
</dict>
</plist>
PLIST_EOF

    # ARM FIRST. Both failure paths below return with the recurring job still
    # loaded — pausing is never allowed to become an unnoticed permanent stop.
    if ! "$lc" bootstrap "gui/$uid" "$plist"; then
        rm -f "$plist"
        echo "error: could not bootstrap the re-arm agent." >&2
        echo "       Recurring job left ENABLED — nothing was disarmed." >&2
        return 1
    fi
    if ! "$lc" list "$label" >/dev/null 2>/dev/null; then
        "$lc" bootout "gui/$uid/$label" 2>/dev/null || true
        rm -f "$plist"
        echo "error: the re-arm agent did not register with launchd." >&2
        echo "       Recurring job left ENABLED — nothing was disarmed." >&2
        return 1
    fi

    # Only now is it safe to take the recurring job down. Tolerate rc != 0: the
    # job may already be unloaded, which is the desired end state anyway.
    "$lc" bootout "gui/$uid/com.ibl5.automouse" 2>/dev/null || true

    {
        echo "disarmed_at=$(epoch_fmt "$(date +%s)" '%Y-%m-%d %H:%M %Z')"
        echo "rearm_epoch=$rearm_epoch"
        echo "rearm_at=$(epoch_fmt "$rearm_epoch" '%Y-%m-%d %H:%M %Z')"
        echo "rearm_label=$label"
        echo "rearm_plist=$plist"
        echo "requested_by=${USER:-unknown}"
    } > "$breadcrumb"

    # Report the first run that actually happens after the re-arm — a re-arm
    # time earlier in the day than the recurring fire time disarms nothing, and
    # this line makes that visible instead of surprising.
    next_fire=""
    if hhmm=$(daily_fire_hhmm "$daily"); then
        # $hhmm is "<hour> <minute>" — unquoted on purpose so it splits in two.
        next_fire=$(next_daily_epoch $hhmm "$rearm_epoch" 2>/dev/null || true)
    fi

    echo "Disarmed com.ibl5.automouse."
    echo "  re-arms:   $(epoch_fmt "$rearm_epoch" '%Y-%m-%d %H:%M %Z')  (local time)"
    if [ -n "$next_fire" ]; then
        echo "  next run:  $(epoch_fmt "$next_fire" '%Y-%m-%d %H:%M %Z')  (first scheduled run after re-arm)"
    fi
    echo "  label:     $label"
    echo "  plist:     $plist"
    echo "  state:     $breadcrumb"
    echo "  log:       $log"
    echo "  note:      the re-arm needs the Mac awake then. If it is missed, re-enable by hand:"
    echo "             launchctl bootstrap gui/$uid $daily"
}

if [ "${1:-}" = "disarm-tonight" ] || [ "${1:-}" = "disarm-until" ]; then
    DISARM_AGENTS="${LAUNCH_AGENTS_DIR:-$HOME/Library/LaunchAgents}"
    DISARM_DAILY="$DISARM_AGENTS/com.ibl5.automouse.plist"
    NOW=$(date +%s)

    if [ "$1" = "disarm-tonight" ]; then
        if ! DAILY_HHMM=$(daily_fire_hhmm "$DISARM_DAILY"); then
            echo "error: could not read StartCalendarInterval.Hour from $DISARM_DAILY" >&2
            echo "       (an array of intervals has no single Hour — use disarm-until instead)" >&2
            exit 1
        fi
        # $DAILY_HHMM is "<hour> <minute>" — unquoted on purpose so it splits.
        DISARM_FIRE=$(next_daily_epoch $DAILY_HHMM "$NOW")
        # Re-arm an hour after the run we're skipping would have started, so the
        # bootstrap can't land inside that interval. launchd does not fire a
        # catch-up run for an interval missed while the job was unloaded
        # (verified by hand 2026-08-14), so the margin is about ordering, not
        # about suppressing a replay.
        REARM_EPOCH=$((DISARM_FIRE + 3600))
    else
        WHEN="${2:-}"
        if [ -z "$WHEN" ]; then
            echo "usage: bin/automouse/run disarm-until \"YYYY-MM-DD HH:MM [TZ]\"" >&2
            echo "example: bin/automouse/run disarm-until \"2026-08-20 09:00 PDT\"" >&2
            exit 1
        fi
        if ! REARM_EPOCH=$(parse_when_epoch "$WHEN"); then
            echo "error: could not parse time '$WHEN'" >&2
            echo "expected: YYYY-MM-DD HH:MM [TZ]  (e.g. 2026-08-20 09:00 PDT)" >&2
            exit 1
        fi
    fi

    if [ "$REARM_EPOCH" -le "$NOW" ]; then
        echo "error: re-arm time resolves to the past ($(epoch_fmt "$REARM_EPOCH" '%Y-%m-%d %H:%M %Z'))" >&2
        exit 1
    fi

    disarm_until_epoch "$REARM_EPOCH"
    exit 0
fi

# Burst mode: if NIGHTLY_BURST is set, check cutoff and self-revert when expired.
if [ "${NIGHTLY_BURST:-}" = "1" ] && [ -n "${NIGHTLY_BURST_CUTOFF:-}" ]; then
    BURST_PLIST="$HOME/Library/LaunchAgents/com.ibl5.automouse.plist"
    BURST_BACKUP="$HOME/Library/LaunchAgents/com.ibl5.automouse.plist.backup-pre-burst"
    # Compare current time against cutoff (both in local time)
    if [ "$(date +%s)" -ge "$(date -j -f '%Y-%m-%dT%H:%M:%S' "$NIGHTLY_BURST_CUTOFF" +%s 2>/dev/null || echo 0)" ]; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') Burst cutoff reached ($NIGHTLY_BURST_CUTOFF). Restoring production plist."
        if [ -f "$BURST_BACKUP" ]; then
            launchctl remove com.ibl5.automouse 2>/dev/null || true
            sleep 1
            cp "$BURST_BACKUP" "$BURST_PLIST"
            rm -f "$BURST_BACKUP"
            launchctl load "$BURST_PLIST"
            echo "$(date '+%Y-%m-%d %H:%M:%S') Production plist restored. Burst schedule removed."
        else
            echo "$(date '+%Y-%m-%d %H:%M:%S') WARNING: No backup plist found at $BURST_BACKUP"
        fi
        exit 0
    fi
fi

# macOS doesn't ship GNU timeout — prefer coreutils gtimeout, else use a shim.
# The shim must close inherited pipeline fds inside the timer subshell (bash 3.2
# doesn't reliably apply external redirects on backgrounded subshells in pipes).
if command -v gtimeout &>/dev/null; then
    timeout() {
        local secs=$1; shift
        "$@" &
        local cmd_pid=$!
        if [ -n "${NIGHTLY_CMDPID_FILE:-}" ]; then
            echo "$cmd_pid" > "$NIGHTLY_CMDPID_FILE"
        fi
        ( exec 0</dev/null 1>/dev/null 2>&1
          sleep "$secs" && kill -TERM "$cmd_pid" 2>/dev/null \
            && sleep "${KILL_GRACE_SECS:-15}" && kill -KILL "$cmd_pid" 2>/dev/null
        ) &
        local timer_pid=$!
        local status=0
        wait "$cmd_pid" || status=$?
        pkill -P "$timer_pid" 2>/dev/null || true
        kill "$timer_pid" 2>/dev/null || true
        wait "$timer_pid" 2>/dev/null || true
        return "$status"
    }
elif ! command -v timeout &>/dev/null; then
    # NIGHTLY_CMDPID_FILE: if set, the timeout shim writes the backgrounded
    # command's PID there so the heartbeat watcher can stall-kill it.
    timeout() {
        local secs=$1; shift
        "$@" &
        local cmd_pid=$!
        if [ -n "${NIGHTLY_CMDPID_FILE:-}" ]; then
            echo "$cmd_pid" > "$NIGHTLY_CMDPID_FILE"
        fi
        # exec inside subshell guarantees fd closure (bash 3.2 pipeline compat)
        ( exec 0</dev/null 1>/dev/null 2>&1
          sleep "$secs" && kill -TERM "$cmd_pid" 2>/dev/null \
            && sleep "${KILL_GRACE_SECS:-15}" && kill -KILL "$cmd_pid" 2>/dev/null
        ) &
        local timer_pid=$!
        local status=0
        wait "$cmd_pid" || status=$?
        pkill -P "$timer_pid" 2>/dev/null || true
        kill "$timer_pid" 2>/dev/null || true
        wait "$timer_pid" 2>/dev/null || true
        return "$status"
    }
fi

# Signal to /post-plan that we're running headless (skips Phase 11:
# Worktree Preview Environment — no human present to verify)
export CLAUDE_HEADLESS=1

# DELIBERATELY NO CLAUDE_CODE_AUTO_COMPACT_WINDOW export here (nor in
# bin/post-plan-now / bin/plan-now). `claude -p` reads the same user-level
# settings an interactive session does, so with no override the headless window
# IS the interactive window — currently the `autoCompactWindow` pin in
# ~/.claude/settings.json — and tracks it by construction. An explicit export
# was two numbers to keep in sync and drifted: it sat at 200000 with a comment
# claiming the pin was 120K, when the pin had already moved on.
#
# Tripwire before you re-add one. Inheriting is the smaller window: headless
# sessions carry ~44K of fixed context (system prompt + rules + memory +
# compaction summary) and compaction fires at ~73% of the window, so working
# room is (0.73 * pin) - 44K. Read the live pin — never hardcode it here, that
# is exactly what drifted last time:
#     jq .autoCompactWindow ~/.claude/settings.json
# At the 200000 an explicit export would set, working room is ~102K. The
# 2026-08-10 run that was aborted by hand had already reached peak_ctx=72063
# during reconnaissance — 21 tools in, before a single edit — i.e. most of the
# way to that ~102K trigger point with the whole implementation still ahead of
# it. (That 72063 predates the peak_ctx fix, so it is a summed figure and reads
# high against post-fix rows.) If impl runs
# start showing repeated compactions (2026-07-07, at a window around 120K: 5
# compactions in 19 min, 21% of the 5h budget, zero edits made), the fix is to
# export a larger window again — 200000 keeps peak context at/below the ~200K
# degradation and 2x-cost edge — and to accept that it no longer tracks the
# interactive setting.

REPO="/Users/ajaynicolas/GitHub/IBL5"
# This script's OWN tree, used to resolve the two prompt files it feeds to
# `claude -p`. Without it the prompts resolve against the `cd "$REPO"` below, so a
# worktree copy of this script would run MAIN's prompts — meaning a prompt change
# cannot be exercised until after it merges. $REPO stays main-pinned deliberately:
# it is the bin/wt-new base and the target of the git ops.
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NIGHTLY_DIR="$HOME/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/automouse"
LOG_DIR="$NIGHTLY_DIR/logs"
QUEUE_DIR="$NIGHTLY_DIR/queue"
PLANS_DIR="${PLANS_DIR:-$HOME/claude-plans}"
MAX_ELAPSED=17100  # ~4h45m — stops around 4:45am, leaves headroom in the 5h usage window
MAX_ATTEMPTS=3     # per-plan retry cap within one night (covers impl + postplan phases)
# Failure-report caps (ADR-0085): the `.failure` sidecar fed to an escalated
# retry is at most this many lines AND this many bytes (whichever is smaller),
# so a multi-hour transcript can never blow the retry's context window.
FAILURE_TAIL_LINES=200
FAILURE_TAIL_BYTES=20000
MAX_IMPL_SECS=3600   # per-phase cap: impl gets at most 1h
MAX_PP_SECS=3600     # per-phase cap: post-plan gets at most 1h
# Wall-clock cap-timeout classifier (see impl_cap_timeout below). The tolerance
# absorbs process startup/teardown skew around `timeout`; it must stay SMALL —
# a large value would forgive ordinary failures, which is exactly the
# blanket-forgive this breaker must not become.
CAP_TIMEOUT_TOLERANCE_SECS=30
CAP_REFUND_LIMIT=2   # max wall-clock refunds per plan; the 3rd cap-timeout burns
                     # a real attempt so MAX_ATTEMPTS still retires a hopeless plan
LOCK_TTL_SECS=9000   # max a single plan legitimately holds its claim lock
                     # (impl 1h + postplan 1h + overhead); a lock older than this
                     # whose owner PID is gone is presumed crashed and stolen.
STALL_KILL_SECS=1800 # kill phase if no stream events for 30 minutes.
                     # Was 600. The Agent/Task tool is now ASYNCHRONOUS: it returns
                     # "Async agent launched successfully" immediately and the parent
                     # is re-invoked by a task notification when the delegate finishes.
                     # A live sub-agent emits NOTHING on the parent's stream, so a
                     # correctly-working impl looks identical to a wedged one for the
                     # whole delegate runtime (the 2026-08-13 docfix run sat event-free
                     # for 440s with three delegates in flight, then lost a 4th at the
                     # 600s harness ceiling). The watcher never actually fired in that
                     # run — the harness ceiling got there first — but lifting that
                     # ceiling to 0 hands the kill straight to this watcher, and the
                     # dead window was exactly 600s, so 600 would now be lethal at the
                     # same instant. A stall-kill classifies as environmental, so an
                     # over-tight threshold costs a refund, not a burned attempt. This
                     # is a fast-fail on top of the real cap, not the only backstop:
                     # `timeout "$REMAINING_SECS"` (<= MAX_IMPL_SECS/MAX_PP_SECS = 1h)
                     # is the hard ceiling, so raising this trades detection latency
                     # for correctness and can never extend a phase past 1h.
KILL_GRACE_SECS=15   # after SIGTERM, wait this long then SIGKILL — a phase wedged
                     # on a dead inference stream traps SIGTERM and ignores it
                     # (the 2026-06-11 run hung 7h on a SIGTERM that never landed)
ARCHIVE_AGE_DAYS="${NIGHTLY_ARCHIVE_AGE_DAYS:-7}"  # startup-archive entries idle this many days
MIN_VIABLE_SECS=60   # a real impl/postplan never finishes (pass OR fail) under a
                     # minute — historical runs are 15-50 min; environmental
                     # fast-fails (usage/rate limit, auth error, transient) exit in
                     # 2-5s. A sub-minute exit is therefore environmental, not a
                     # plan failure: stop the night, don't burn the queue to skipped/.

HANDOFF_DIR="$NIGHTLY_DIR/handoff"
mkdir -p "$LOG_DIR" "$QUEUE_DIR" "$HANDOFF_DIR"

# One-off single-plan mode: bin/automouse/run plan <slug>
# Runs impl + post-plan for exactly ONE named plan, then stops. Reuses all
# guard machinery (heartbeat/stall-kill, env-breaker, handoff resume, cost
# roll-up, reports, lock). Foreground, streams to the dated log like a manual run.
SINGLE_PLAN=""
if [ "${1:-}" = "plan" ]; then
    slug="${2:-}"
    if [ -z "$slug" ]; then
        echo "usage: bin/automouse/run plan <slug>" >&2
        exit 1
    fi
    FILENAME="${slug%.md}.md"
    if [ ! -e "$QUEUE_DIR/$FILENAME" ]; then
        # Not already queued — queue it now, reusing automouse-queue's
        # resolution (INPUT / $PLANS_DIR/$INPUT / $PLANS_DIR/$INPUT.md) and its
        # evict_dispositions() cleanup of stale skipped/ + done/ sidecars.
        if ! NIGHTLY_DIR="$NIGHTLY_DIR" PLANS_DIR="$PLANS_DIR" \
                "$REPO/bin/automouse/queue" "$slug"; then
            echo "automouse-run plan: cannot resolve or queue '$slug' — " \
                 "no such plan under $PLANS_DIR" >&2
            exit 1
        fi
    fi
    if [ ! -e "$QUEUE_DIR/$FILENAME" ]; then
        echo "automouse-run plan: '$slug' did not land in the queue after " \
             "queuing — aborting" >&2
        exit 1
    fi
    SINGLE_PLAN="$FILENAME"
fi

WATCHER_PID=""
CURRENT_LOCK=""   # claim-lock dir held for the plan this runner is processing
CAP_DEFERRED=" "  # space-wrapped basenames cap-refunded this run; claim_next_plan skips them
cleanup_watcher() {
    if [ -n "$WATCHER_PID" ]; then
        kill "$WATCHER_PID" 2>/dev/null || true
        wait "$WATCHER_PID" 2>/dev/null || true
    fi
    rm -f "$NIGHTLY_DIR/.heartbeat-$$-impl" "$NIGHTLY_DIR/.heartbeat-$$-postplan" \
         "$NIGHTLY_DIR/.cmdpid-$$-impl" "$NIGHTLY_DIR/.cmdpid-$$-postplan" 2>/dev/null || true
    # Release any plan claim still held (e.g. we broke out of the loop mid-plan on
    # a time guard or env-failure) so a sibling/next run can resume it.
    if [ -n "$CURRENT_LOCK" ]; then
        rm -rf "$CURRENT_LOCK" 2>/dev/null || true
    fi
}
trap cleanup_watcher EXIT

run_heartbeat_watcher() {
    local hb_file=$1 log_file=$2 label=$3 pid_file=$4 slug=$5
    while sleep 60; do
        if [ ! -f "$hb_file" ]; then
            continue
        fi
        local last_epoch now age
        last_epoch=$(cat "$hb_file" 2>/dev/null) || continue
        [ -n "$last_epoch" ] || continue
        now=$(date +%s)
        age=$(( now - last_epoch ))
        local ts
        ts=$(date +%H:%M:%S)
        if [ "$age" -gt "$STALL_KILL_SECS" ]; then
            local target_pid
            target_pid=$(cat "$pid_file" 2>/dev/null) || true
            if [ -n "$target_pid" ] && kill -0 "$target_pid" 2>/dev/null; then
                printf '[%s] %s STALL-KILL: %s — no events for %ds, killing pid %s and children\n' \
                    "$ts" "$slug" "$label" "$age" "$target_pid" >> "$log_file"
                pkill -TERM -P "$target_pid" 2>/dev/null || true
                kill -TERM "$target_pid" 2>/dev/null || true
                # SIGTERM can be trapped/ignored by a phase wedged on a dead
                # inference stream (this hung the 2026-06-11 run for 7h);
                # escalate to SIGKILL after a grace period.
                sleep "$KILL_GRACE_SECS"
                if kill -0 "$target_pid" 2>/dev/null; then
                    printf '[%s] %s STALL-KILL: %s — pid %s survived SIGTERM, sending SIGKILL\n' \
                        "$(date +%H:%M:%S)" "$slug" "$label" "$target_pid" >> "$log_file"
                    pkill -KILL -P "$target_pid" 2>/dev/null || true
                    kill -KILL "$target_pid" 2>/dev/null || true
                fi
                return
            else
                printf '[%s] %s WARNING: %s — no events for %ds (stalled, pid gone)\n' \
                    "$ts" "$slug" "$label" "$age" >> "$log_file"
            fi
        elif [ "$age" -gt 300 ]; then
            printf '[%s] %s WARNING: %s — no events for %ds (possibly stalled)\n' "$ts" "$slug" "$label" "$age" >> "$log_file"
        else
            printf '[%s] %s heartbeat: %s alive (%ds since last event)\n' "$ts" "$slug" "$label" "$age" >> "$log_file"
        fi
    done
}

# Map a Claude model id to its tier label for the cost roll-up. Prefix match so
# a version bump (claude-opus-5 → claude-opus-5) keeps resolving; an unknown or
# empty id yields "?" rather than a blank cell.
model_tier() {
    case "${1:-}" in
        *opus*)   echo "Opus"   ;;
        *sonnet*) echo "Sonnet" ;;
        *haiku*)  echo "Haiku"  ;;
        *)        echo "?"      ;;
    esac
}

# Append a per-phase cost row to the night's cost roll-up. Cost is parsed from
# the phase's `exit:` line (emitted by automouse-stream-filter.sh into the log). One
# row per phase keeps this robust across split impl/postplan invocations — no
# cross-phase variable dependency. See .claude/rules/automouse-workflow.md.
append_cost_row() {
    local plan=$1 phase=$2 log_before=$3 model=${4:-?}
    local logged_cost sid pricer_json provenance cost tier peak_raw peak_k
    local inp out cr w5 w1 peak_ctx_raw compactions_main compactions_sub
    local surcharge_low surcharge_high price_asof surcharge_cell report sidecar
    # Sibling-relative, never $REPO: a worktree copy of `run` must price with its
    # own checkout's pricer, not the main checkout's.
    local root="${SELF_DIR:-}/.."
    tier=$(model_tier "$model")
    # `|| true` is load-bearing: under `set -euo pipefail` a killed phase emits no
    # `cost=` line, so grep exits non-zero and would abort the whole automouse loop.
    # Store the harness figure as logged_cost; cost is overwritten by the pricer below.
    logged_cost=$(tail -n +"$((log_before + 1))" "$LOG" | grep -oE 'cost=\$[0-9.]+' | tail -1 | sed 's/cost=\$//') || true
    [ -n "$logged_cost" ] || logged_cost="?"
    sid=$(tail -n +"$((log_before + 1))" "$LOG" | grep -oE 'session_id=[^ ]+' | tail -1 | sed 's/session_id=//') || true
    peak_raw=$(tail -n +"$((log_before + 1))" "$LOG" | grep -oE 'peak_ctx=[0-9]+' | tail -1 | sed 's/peak_ctx=//') || true
    peak_k=$(( ${peak_raw:-0} / 1000 ))
    # Call pricer; || pricer_json="" prevents a non-zero pricer exit from aborting
    # the automouse loop under set -euo pipefail — degrade to logged_cost, never abort.
    pricer_json=""
    if [ -n "${sid:-}" ]; then
        pricer_json=$("$root/lib/automouse-pricer" --session-id "$sid" 2>/dev/null) || pricer_json=""
    fi
    # Parse pricer JSON; empty or unparseable → provenance=unknown, fall back to logged_cost.
    if [ -n "$pricer_json" ] && printf '%s' "$pricer_json" | jq -e . >/dev/null 2>&1; then
        IFS=$'\t' read -r cost surcharge_low surcharge_high inp out cr w5 w1 peak_ctx_raw \
            compactions_main compactions_sub price_asof \
            <<< "$(printf '%s' "$pricer_json" | jq -r '[.cost,.surcharge_low,.surcharge_high,.inp,.out,.cr,.w5,.w1,.peak_ctx,.compactions_main,.compactions_sub,(.price_asof // "")] | @tsv')" || true
        provenance="recomputed"
        peak_k=$(( ${peak_ctx_raw:-0} / 1000 ))
    else
        cost="$logged_cost"
        surcharge_low="" surcharge_high="" inp="" out="" cr="" w5="" w1=""
        peak_ctx_raw="${peak_raw:-0}" compactions_main="" compactions_sub="" price_asof=""
        provenance="unknown"
    fi
    # Surcharge cell: en-dash-bounded interval when compactions > 0, else em-dash.
    surcharge_cell="—"
    if [ "$provenance" = "recomputed" ] && \
            [ "$(( ${compactions_main:-0} + ${compactions_sub:-0} ))" -gt 0 ]; then
        surcharge_cell=$(printf '%.2f\xe2\x80\x93%.2f' "$surcharge_low" "$surcharge_high") \
            || surcharge_cell="—"
    fi
    report="$NIGHTLY_DIR/reports/$(date +%Y-%m-%d)-costs.md"
    mkdir -p "$(dirname "$report")"
    # Write sidecar: one JSON line per phase, all 20 keys unconditionally (null for missing).
    sidecar="$NIGHTLY_DIR/logs/$(date +%Y-%m-%d).costs.jsonl"
    mkdir -p "$(dirname "$sidecar")"
    jq -n -c \
        --arg  date             "$(date +%Y-%m-%d)" \
        --arg  plan             "$plan" \
        --arg  phase            "$phase" \
        --arg  model            "$model" \
        --arg  tier             "$tier" \
        --arg  session_id       "${sid:-}" \
        --arg  cost             "$cost" \
        --arg  surcharge_low    "${surcharge_low:-}" \
        --arg  surcharge_high   "${surcharge_high:-}" \
        --arg  inp              "${inp:-}" \
        --arg  out              "${out:-}" \
        --arg  cr               "${cr:-}" \
        --arg  w5               "${w5:-}" \
        --arg  w1               "${w1:-}" \
        --arg  peak_ctx         "${peak_ctx_raw:-0}" \
        --arg  compactions_main "${compactions_main:-}" \
        --arg  compactions_sub  "${compactions_sub:-}" \
        --arg  provenance       "$provenance" \
        --arg  price_asof       "${price_asof:-}" \
        --arg  logged_cost      "$logged_cost" \
        'def n: tonumber? // null; {date:$date,plan:$plan,phase:$phase,model:$model,tier:$tier,session_id:$session_id,cost:($cost|n),surcharge_low:($surcharge_low|n),surcharge_high:($surcharge_high|n),inp:($inp|n),out:($out|n),cr:($cr|n),w5:($w5|n),w1:($w1|n),peak_ctx:($peak_ctx|n),compactions_main:($compactions_main|n),compactions_sub:($compactions_sub|n),provenance:$provenance,price_asof:$price_asof,logged_cost:($logged_cost|n)}' \
        >> "$sidecar"
    # Create report with new 13-column header; or strip-then-migrate the old 6-column form.
    if [ ! -f "$report" ]; then
        printf '# Automouse cost roll-up — %s\n\n| Plan | Phase | Model | Tier | Cost ($) | Surcharge est ($) | Peak Ctx (K) | In | Out | Cache-read | CW-5m | CW-1h | Prov |\n|---|---|---|---|---|---|---|---|---|---|---|---|---|\n' \
            "$(date +%Y-%m-%d)" > "$report"
    fi
    # Strip the weekly section BEFORE migrating (weekly-section pipe rows must not be
    # padded) and BEFORE appending — the bug that ate every row but the day's first.
    strip_weekly_section "$report"
    if grep -qF '| Plan | Phase | Model | Tier | Cost ($) | Peak Ctx (K) |' "$report" 2>/dev/null; then
        local tmp_mig
        tmp_mig=$(mktemp)
        awk '
            /^\| Plan \| Phase \| Model \| Tier \| Cost \(\$\) \| Peak Ctx \(K\) \|/ { print "| Plan | Phase | Model | Tier | Cost ($) | Surcharge est ($) | Peak Ctx (K) | In | Out | Cache-read | CW-5m | CW-1h | Prov |"; next }
            /^\|[-]+\|/ { print "|---|---|---|---|---|---|---|---|---|---|---|---|---|"; next }
            /^\|/ {
                nf = split($0, c, "|")
                m = 0
                for (i = 2; i <= nf - 1; i++) { m++; cell[m] = c[i] }
                if (m >= 6) { for (j = m; j >= 6; j--) cell[j+1] = cell[j]; cell[6] = " "; m++ }
                for (j = m + 1; j <= 13; j++) cell[j] = " "
                line = ""
                for (j = 1; j <= 13; j++) line = line "|" cell[j]
                print line "|"
                next
            }
            { print }
        ' "$report" > "$tmp_mig" && mv "$tmp_mig" "$report"
    fi
    printf '| %s | %s | %s | %s | %s | %s | %dK | %s | %s | %s | %s | %s | %s |\n' \
        "$plan" "$phase" "$model" "$tier" "$cost" "$surcharge_cell" "$peak_k" \
        "${inp:-—}" "${out:-—}" "${cr:-—}" "${w5:-—}" "${w1:-—}" "$provenance" >> "$report"
    regenerate_weekly_section "$report"
}

# Truncate a costs report back to its per-phase table: drop the weekly-aggregate
# section and the blank lines that separate it from the table, leaving the file
# ending on the last row. Trailing blanks must go too — a blank line between two
# rows splits the markdown table in half.
strip_weekly_section() {
    local report=$1 tmp
    tmp=$(mktemp)
    awk '
        /^## Weekly aggregate/ { exit }
        /^[[:space:]]*$/       { blanks++; next }
        { for (i = 0; i < blanks; i++) print ""; blanks = 0; print }
    ' "$report" > "$tmp" && mv "$tmp" "$report"
}

# Return the date N days ago in YYYY-MM-DD format. Works on both BSD (macOS,
# date -v) and GNU (Linux/CI, date -d) date implementations.
_date_ago() {
    date -v-"$1"d +%F 2>/dev/null || date -d "$1 days ago" +%F
}

# Rebuild the trailing-7-days weekly aggregate at the bottom of today's costs
# report. Idempotent: strips any prior "## Weekly aggregate" section (always the
# last section) and rewrites it. Cost-by-tier comes from the sidecar ledger
# (logs/YYYY-MM-DD.costs.jsonl); token totals come from the sidecar with fallback
# to exit-line tags from the day's .log for days without a sidecar.
# Three total cost lines are emitted: floor, floor+surcharge-est-low, floor+surcharge-est-high.
regenerate_weekly_section() {
    local report=$1 reports_dir logs_dir d f i lf
    local all_sidecar cost_rows tok_rows tok_stream split_miss unpriced
    local floor_raw low_raw high_raw floor_total low_total high_total
    reports_dir=$(dirname "$report")
    logs_dir="$NIGHTLY_DIR/logs"
    strip_weekly_section "$report"
    all_sidecar=$(mktemp)
    for i in 0 1 2 3 4 5 6; do
        d=$(_date_ago "$i"); f="$logs_dir/$d.costs.jsonl"
        if [ -f "$f" ]; then cat "$f" >> "$all_sidecar"; fi
    done
    floor_raw="0" low_raw="0" high_raw="0" unpriced=0
    if [ -s "$all_sidecar" ]; then
        unpriced=$(jq -s '[.[] | select(.provenance=="unknown")] | length' "$all_sidecar") || unpriced=0
        IFS=$'\t' read -r floor_raw low_raw high_raw <<< "$(jq -r -s '
            def n: (. // 0) | if type=="number" then . else 0 end;
            {
                f:  ([.[].cost          | n] | add // 0),
                sl: ([.[].surcharge_low  | n] | add // 0),
                sh: ([.[].surcharge_high | n] | add // 0)
            } | [.f, (.f + .sl), (.f + .sh)] | @tsv
        ' "$all_sidecar")" || true
    fi
    for i in 0 1 2 3 4 5 6; do
        d=$(_date_ago "$i"); f="$logs_dir/$d.costs.jsonl"; lf="$logs_dir/$d.log"
        if [ ! -f "$f" ] && [ -f "$lf" ]; then
            fb=$(grep -hc 'exit:' "$lf" 2>/dev/null) || fb=0
            unpriced=$(( unpriced + ${fb:-0} ))
        fi
    done
    floor_total=$(printf '%.4f' "${floor_raw:-0}")
    low_total=$(printf  '%.4f' "${low_raw:-0}")
    high_total=$(printf '%.4f' "${high_raw:-0}")
    cost_rows=$(
        if [ -s "$all_sidecar" ]; then
            jq -r -s '
                def n: (. // 0) | if type=="number" then . else 0 end;
                group_by(.tier) | .[] |
                { t: .[0].tier, c: ([.[].cost | n] | add // 0) } |
                [.t, .c] | @tsv
            ' "$all_sidecar" | awk -F'\t' '{printf "| %s | %.4f |\n",$1,$2}'
        fi
    ) || cost_rows=""
    tok_stream=$(mktemp)
    {
            if [ -s "$all_sidecar" ]; then
                jq -r -s '
                    def n: (. // 0) | if type=="number" then . else 0 end;
                    .[] | [.phase, (.inp|n), (.out|n), (.cr|n), (.w5|n), (.w1|n), (.peak_ctx|n)] | @tsv
                ' "$all_sidecar"
            fi
            # Days predating the sidecar schema have only a raw log, so fall back to
            # parsing its `exit:` lines. Peak-ctx (field 7) is deliberately hardcoded 0:
            # those logs carry only the truncated stream peak that the split-miss comment
            # below calls out as unreliable, so a legacy day never trips the flag.
            for i in 0 1 2 3 4 5 6; do
                d=$(_date_ago "$i"); f="$logs_dir/$d.costs.jsonl"
                if [ ! -f "$f" ]; then
                    lf="$logs_dir/$d.log"
                    if [ -f "$lf" ]; then
                        grep -h 'exit:' "$lf" 2>/dev/null | awk '
                            { ph="?"; n=split($2,a,"/"); if(n>=2) ph=a[n]
                              in_v=0;ou_v=0;cr_v=0;cw_v=0
                              for(j=1;j<=NF;j++){if(split($j,kv,"=")==2){k=kv[1];v=kv[2]
                                if(v~/^[0-9]+$/){
                                  if(k=="in")in_v=v+0;else if(k=="out")ou_v=v+0;
                                  else if(k=="cache")cr_v=v+0;else if(k=="cache_write")cw_v=v+0}}}
                              print ph"\t"in_v"\t"ou_v"\t"cr_v"\t"cw_v"\t0\t0" }
                        ' || true
                    fi
                fi
            done
    } > "$tok_stream"
    tok_rows=$(awk -F'\t' '
        { p=$1;inp[p]+=$2;out[p]+=$3;cr[p]+=$4;w5[p]+=$5;w1[p]+=$6;seen[p]=1
          inpT+=$2;oT+=$3;crT+=$4;w5T+=$5;w1T+=$6 }
        END {
            for(p in seen) printf "| %s | %d | %d | %d | %d | %d |\n",p,inp[p],out[p],cr[p],w5[p],w1[p]
            printf "| **Total** | %d | %d | %d | %d | %d |\n",inpT,oT,crT,w5T,w1T
        }
    ' "$tok_stream") || tok_rows=""
    # Peak-ctx split-miss flagging (>150K) is retained from the pre-sidecar schema,
    # now fed by the pricer's true peak ($7) rather than the truncated stream value
    # that suppressed the flag on the run that most needed it.
    split_miss=$(awk -F'\t' '
        { p=$1; v=$7+0; if (v>pk[p]) pk[p]=v }
        END { f=""; for (p in pk) if (pk[p]>150000) f=f " " p "(" int(pk[p]/1000) "K)"; print f }
    ' "$tok_stream") || split_miss=""
    rm -f "$tok_stream" "$all_sidecar"
    {
        printf '\n## Weekly aggregate (last 7 days)\n\n'
        printf '### Cost by tier ($)\n\n| Tier | Cost ($) |\n|---|---|\n'
        if [ -n "$cost_rows" ]; then printf '%s\n' "$cost_rows"; fi
        printf '| **Total** (floor) | %s |\n' "$floor_total"
        printf '| **Total** (floor + est low) | %s |\n' "$low_total"
        printf '| **Total** (floor + est high) | %s |\n' "$high_total"
        if [ "${unpriced:-0}" -gt 0 ]; then
            printf '\n> **excludes %d unpriced rows**\n' "$unpriced"
        fi
        printf '\n### Tokens by phase\n\n| Phase | Input | Output | Cache-read | CW-5m | CW-1h |\n|---|---|---|---|---|---|\n'
        if [ -n "$tok_rows" ]; then printf '%s\n' "$tok_rows"; fi
        if [ -n "${split_miss// /}" ]; then
            printf '\n> **Split-miss candidates (peak ctx >150K):**%s\n' "$split_miss"
        fi
    } >> "$report"
}

# Decrement the current plan's attempt counter by one ("refund"). Used when a
# phase is cut short by an environmental failure (usage/rate limit, auth error,
# transient) rather than a genuine plan failure — the plan should retry cleanly
# next run, not march toward the poison-pill skip threshold.
# Give back the attempt consumed by an environmental failure.
#
# Deliberately does NOT remove "$CAP_REFUND_FILE". This function is called FROM
# the cap-timeout refund path, so clearing the counter here would reset the
# bound on every refund and make cap-timeout refunds UNLIMITED — the exact
# inverse of CAP_REFUND_LIMIT. The counter is evicted only where a plan's whole
# retry state resets: poison-pill eviction, impl success/disposition, the
# end-of-session orphan sweep, and bin/automouse/queue.
refund_attempt() {
    local current
    current=$(cat "$ATTEMPT_FILE" 2>/dev/null || echo 0)
    if [ "$current" -le 1 ]; then
        rm -f "$ATTEMPT_FILE" "$FAILURE_FILE"
    else
        echo $(( current - 1 )) > "$ATTEMPT_FILE"
    fi
}

# Scan this phase's slice of the log for a known environmental-failure signature:
# a Claude usage/rate limit or an Anthropic API auth error, in any phrasing these
# surface in (the legacy single-string checks missed "weekly limit" and the plain
# "API Error: 401", causing whole queues to grind into skipped/). Patterns are
# kept specific to Claude-runtime errors so a postplan security audit discussing
# auth code does not false-trigger. Returns 0 on match. Safe under `set -e`: only
# ever called inside an `if` condition.
phase_env_error() {
    local log_before=$1
    tail -n +"$(( log_before + 1 ))" "$LOG" 2>/dev/null | grep -qiE \
        "hit your [a-z0-9 -]*limit|usage limit reached|api error:[[:space:]]*(401|403|429|529)|overloaded_error|rate_limit_error"
}

# A phase that emitted no stream events for STALL_KILL_SECS is force-killed by the
# heartbeat watcher (see run_heartbeat_watcher), which writes a distinctive
# "STALL-KILL" marker into this phase's log slice. A stall is a transient hang
# (typically a dead/wedged inference stream), NOT a plan defect — classify it
# environmental so the breaker refunds + stops rather than burning the attempt
# toward the poison-pill skip. Safe under `set -e`: only called inside `if`.
phase_stalled() {
    local log_before=$1
    tail -n +"$(( log_before + 1 ))" "$LOG" 2>/dev/null | grep -q "STALL-KILL"
}

# Decide whether an impl phase should trip the environmental breaker (refund +
# stop the loop). Pure predicate over five 0/1 booleans so it is unit-testable
# (see bin/test-automouse-env-breaker) — the call site computes the inputs.
#
# Env-stop ONLY when the agent produced NO outcome — neither a handoff (success)
# nor a queue-exit (a deliberate skip/disposition) — AND a transient signature is
# present (known limit/auth error, watchdog stall-kill, or a sub-minute exit).
#
# The in_queue guard is the fix for the false positive that stopped the loop on a
# legitimate disposition: every deliberate impl disposition (already-merged,
# stale-plan, ambiguity, wt-new failure, missing-info — see bin/automouse/prompt-impl)
# runs `mv queue/$PLAN → done/` (already-merged) or `→ skipped/` (the rest), so the
# plan leaves queue/ (in_queue=0) and exits
# fast with no handoff. Without this guard the sub-minute check misreads that
# clean skip as a transient kill. A real transient never gets that far: it dies
# mid-stream, leaving the plan in queue/ (in_queue=1). This mirrors the postplan
# breaker, which gates its sub-minute check on the handoff still being present.
#
# Safe under `set -e`: only ever called inside an `if` condition.
should_impl_env_stop() {
    local handoff=$1 in_queue=$2 env_err=$3 stalled=$4 fast=$5
    [ "$handoff" -eq 1 ] && return 1     # handoff written → impl succeeded
    [ "$in_queue" -eq 0 ] && return 1    # plan left queue/ → deliberate disposition, not environmental
    [ "$env_err" -eq 1 ] || [ "$stalled" -eq 1 ] || [ "$fast" -eq 1 ]
}

# Was this phase killed by the per-phase wall clock (the `timeout` cap)?
#
# Narrow by construction. The exit status alone proves nothing: 143 is ALSO the
# ordinary SUCCESS exit here, because bin/lib/automouse-stream-filter.sh
# kill -TERMs claude on the final `result` event — a clean 6-minute impl exits
# 143 too. The DURATION test is what discriminates. Both statuses are accepted:
# 124 is GNU timeout's own exit code, and 143 is what this pipeline actually
# observes (the harness traps SIGTERM, emits a graceful `result`, and the stream
# filter then TERMs the recorded pid, masking timeout's 124).
impl_cap_timeout() {
    local status=$1 dur=$2 budget=$3
    [ "$status" -eq 143 ] || [ "$status" -eq 124 ] || return 1
    [ "$dur" -ge $(( budget - CAP_TIMEOUT_TOLERANCE_SECS )) ]
}

# Does this cap-timeout earn an attempt refund?
#
# Same boolean shape as should_impl_env_stop(): handoff=1 means the impl
# actually SUCCEEDED at the wall (post-plan must run — nothing to refund), and
# in_queue=0 means the agent deliberately disposed of the plan at the wall.
# Refunds are bounded by CAP_REFUND_LIMIT so a plan that times out forever still
# reaches the MAX_ATTEMPTS poison pill.
should_refund_cap_timeout() {
    local handoff=$1 in_queue=$2 cap_timeout=$3 granted=$4 limit=$5
    [ "$cap_timeout" -eq 1 ] || return 1
    [ "$handoff" -eq 1 ] && return 1
    [ "$in_queue" -eq 0 ] && return 1
    [ "$granted" -lt "$limit" ]
}

# Read the cap-refund counter, sanitizing anything that is not a non-negative
# integer to 0. Fails CLOSED is wrong here and fails OPEN is worse, so it fails
# to 0 = "no refunds granted yet", the value a fresh plan has; a truncated or
# hand-edited sidecar therefore costs at most the normal 2-refund budget.
cap_refunds_granted() {
    local file=$1 raw
    raw=$(cat "$file" 2>/dev/null || echo 0)
    case "$raw" in
        ''|*[!0-9]*) echo 0 ;;
        *)           echo "$raw" ;;
    esac
}

# Persist the incremented cap-refund count (single-line overwrite, never append).
record_cap_refund() {
    local file=$1 granted=$2
    echo $(( granted + 1 )) > "$file"
}

# Write a one-line report when the run STOPS on an environmental failure. The
# queue is left intact (nothing skipped), so without this a no-progress night —
# e.g. a single head-of-queue plan that keeps fast-failing — would be silent.
# Distinct filename prefix (env-stop) from the skip/error/done reports.
write_env_stop_report() {
    local plan=$1 phase=$2 reason=$3 log_before=$4
    local reports_dir="$NIGHTLY_DIR/reports" slug
    slug=$(basename "$plan" .md)
    mkdir -p "$reports_dir"
    {
        printf 'Automouse run STOPPED during %s of "%s" — %s.\n\n' "$phase" "$slug" "$reason"
        printf 'The queue was left intact — no plans were skipped. It resumes next run.\n'
        printf 'If this recurs for the same plan, that plan may be malformed — review it.\n\n'
        printf '## Phase log tail\n\n```\n'
        tail -n +"$(( log_before + 1 ))" "$LOG" 2>/dev/null | tail -20 || true
        printf '\n```\n'
    } > "$reports_dir/$(date +%Y-%m-%d)-env-stop-$slug.md"
}

# Persist a per-attempt failure report for the escalated final retry (ADR-0085).
# Writes a CAPPED tail of THIS attempt's log slice to a `.failure` sidecar in
# QUEUE_DIR, a sibling of the `.attempts` counter, so it shares that counter's
# lifecycle and is fed to the next attempt by bin/automouse/prompt-impl. Capped
# because the slice can be a multi-hour transcript; a crashed/stall-killed agent
# may have written nothing structured, so a raw log tail is the reliable,
# agent-cooperation-free baseline.
# Args: <plan_name> <log_before> <impl_model> <attempt_num>
write_failure_report() {
    _wfr_plan="$1"; _wfr_before="$2"; _wfr_model="$3"; _wfr_attempt="$4"
    _wfr_file="$QUEUE_DIR/${_wfr_plan}.failure"
    {
        printf '# Prior attempt %d/%d failed (model: %s) at %s\n\n' \
            "$_wfr_attempt" "$MAX_ATTEMPTS" "$_wfr_model" "$(date)"
        printf 'This is the tail of the previous impl attempt that did NOT complete.\n'
        printf 'Read it to avoid repeating the same failure; it is capped and may be truncated mid-line.\n\n'
        printf '## Last %d lines of the failed attempt log (hard-capped to %d bytes)\n\n```\n' \
            "$FAILURE_TAIL_LINES" "$FAILURE_TAIL_BYTES"
        sed -n "$(( _wfr_before + 1 )),\$p" "$LOG" \
            | tail -n "$FAILURE_TAIL_LINES" \
            | tail -c "$FAILURE_TAIL_BYTES"
        printf '\n```\n'
    } > "$_wfr_file"
}

# Decide whether to feed the prior-failure report to this attempt's impl prompt.
# YES iff escalation fired (impl model != base model) AND the sidecar is present.
# DECOUPLED from the escalation trigger (ADR-0085): the report is fed only when
# both hold, so (a) a leaked/stale sidecar on a NON-escalated attempt is never
# fed, and (b) an escalation with no sidecar degrades gracefully to an
# un-augmented Opus retry.
# Args: <base_model> <impl_model> <failure_file>   → exit 0 = feed, 1 = do not
should_feed_failure_report() {
    [ "$1" != "$2" ] && [ -f "$3" ]
}

# Move entries in a automouse subdir untouched for $ARCHIVE_AGE_DAYS into a sibling
# `<subdir>.archive/`, keeping the working dirs small without deleting history.
# Matches regular files AND symlinks; `find` does not follow symlinks, so a
# disposition symlink (done/, skipped/) is judged on its OWN mtime — the date it
# was moved there — not the plan file it points at. `+N` = strictly older than
# N*24h. Lazily creates the archive dir only when something actually moves.
# Caller scopes this under `|| true` so a failure here can never abort the night.
archive_stale() {
    local subdir=$1
    local src="$NIGHTLY_DIR/$subdir"
    local dest="$NIGHTLY_DIR/${subdir}.archive"
    [ -d "$src" ] || return 0
    local moved=0 entry
    while IFS= read -r entry; do
        [ -n "$entry" ] || continue
        mkdir -p "$dest"
        mv "$entry" "$dest/" 2>/dev/null && moved=$(( moved + 1 ))
    done < <(find "$src" -mindepth 1 -maxdepth 1 \( -type f -o -type l \) \
                  -mtime +"$ARCHIVE_AGE_DAYS" 2>/dev/null)
    [ "$moved" -eq 0 ] || echo "Archived $moved stale entr$([ "$moved" -eq 1 ] && echo y || echo ies) from $subdir/ → ${subdir}.archive/" >> "$LOG"
}

# Atomically claim the oldest queued plan not already locked by a live sibling
# runner, enabling several automouse-run processes to drain the queue in parallel
# without ever working the same plan twice. `mkdir` is atomic on the local FS, so
# two racing runners can never both create the same lock dir — exactly one wins.
# On success: echoes the claimed plan path to stdout and leaves
# "$QUEUE_DIR/<plan>.lock/" held (owner PID recorded in its `pid` file). On
# failure (every queued plan is locked by a live sibling): echoes nothing, returns 1.
# A lock whose owner PID is dead, or older than LOCK_TTL_SECS, is treated as stale
# and stolen — covering a runner that crashed mid-plan. Only ever called as
# `NEXT_PLAN=$(claim_next_plan) || NEXT_PLAN=""`, so the return-1 is set -e safe.
claim_next_plan() {
    local plan plan_name lock owner now lock_epoch
    while IFS= read -r plan; do
        [ -n "$plan" ] || continue
        plan_name=$(basename "$plan")
        [ -n "${SINGLE_PLAN:-}" ] && [ "$plan_name" != "$SINGLE_PLAN" ] && continue
        # Cap-refunded earlier in THIS run → deliberately deferred to a future
        # run. Skip before locking, so a sibling runner stays free to take it and
        # this runner falls through to the next-oldest plan.
        case "$CAP_DEFERRED" in *" $plan_name "*) continue ;; esac
        lock="$QUEUE_DIR/${plan_name}.lock"
        # Fast path: unlocked plan — claim atomically.
        if mkdir "$lock" 2>/dev/null; then
            echo "$$" > "$lock/pid"
            printf '%s\n' "$plan"
            return 0
        fi
        # Locked — is the holder dead or the lock expired? If so, steal it.
        owner=$(cat "$lock/pid" 2>/dev/null) || owner=""
        now=$(date +%s)
        lock_epoch=$(stat -f %m "$lock" 2>/dev/null || echo "$now")
        if { [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; } \
           || [ "$(( now - lock_epoch ))" -gt "$LOCK_TTL_SECS" ]; then
            rm -rf "$lock" 2>/dev/null || true
            # Re-create atomically; the loser of a two-stealer race fails mkdir
            # here and simply falls through to the next plan.
            if mkdir "$lock" 2>/dev/null; then
                echo "$$" > "$lock/pid"
                printf '[%s] stole stale lock for %s (dead/expired owner=%s)\n' \
                    "$(date +%H:%M:%S)" "$plan_name" "${owner:-?}" >> "$LOG"
                printf '%s\n' "$plan"
                return 0
            fi
        fi
        # Live lock held by a sibling — skip to the next-oldest plan.
    done < <(ls -1tr "$QUEUE_DIR"/*.md 2>/dev/null)
    return 1
}

LOG="$LOG_DIR/$(date +%Y-%m-%d).log"

cd "$REPO"

# Prevent macOS from sleeping while we run (released automatically on exit)
caffeinate -s -w $$ &
CAFFEINATE_PID=$!

START=$(date +%s)
PLANS_RUN=0

echo "=== Automouse session starting at $(date) ===" >> "$LOG"

# Freshen the reference checkout's master so the self-heal staleness guard below
# sees origin's latest — a re-created file or a widened guard only exists locally
# once pulled. automouse-run has no other top-of-run pull (the per-plan pull in
# automouse-prompt-impl runs AFTER this and never when the queue holds only
# skipped plans), so without this the empty-queue recovery case never advances
# master and the FP is never seen. ff-only never diverges the read-only main
# checkout (ADR-0062); both lines are non-fatal so a fetch hiccup can't abort the
# night.
git -C "$REPO" fetch origin master >> "$LOG" 2>&1 || true
git -C "$REPO" merge --ff-only origin/master >> "$LOG" 2>&1 || true

# Self-heal: requeue staleness-skipped plans whose guard now passes. Runs BEFORE
# archival so a marked plan isn't swept into skipped.archive/ first. Non-fatal
# (|| true): a self-heal hiccup must never abort the night (mirrors the || true
# on the archive_stale block).
# Skipped in single-plan mode: requeuing other staleness-skipped plans would
# violate "leaves the rest of the queue untouched".
if [ -z "${SINGLE_PLAN:-}" ]; then
    "$REPO/bin/automouse/self-heal" >> "$LOG" 2>&1 || true
fi

# Startup archival: shrink the accumulating output dirs by moving entries idle
# for $ARCHIVE_AGE_DAYS into sibling `.archive/` folders. queue/ (pending work,
# iterated below) and handoff/ (transient, cleaned at loop end) are excluded by
# design. Whole block guarded so an archival hiccup never stops the night.
if [ -z "${SINGLE_PLAN:-}" ]; then
    {
        archive_stale logs
        archive_stale reports
        archive_stale "done"
        archive_stale skipped
    } || true
fi

while true; do
    # Check if queue has plans
    if ! ls "$QUEUE_DIR"/*.md &>/dev/null; then
        if [ "$PLANS_RUN" -eq 0 ]; then
            echo "Queue empty — nothing to run." >> "$LOG"
            mkdir -p "$NIGHTLY_DIR/reports"
            echo "No plan queued for tonight." \
                > "$NIGHTLY_DIR/reports/$(date +%Y-%m-%d)-no-queue.md"
        else
            echo "Queue drained after $PLANS_RUN plan(s)." >> "$LOG"
        fi
        break
    fi

    # Time guard: don't start a new plan if >4h elapsed
    ELAPSED=$(( $(date +%s) - START ))
    if [ "$ELAPSED" -gt "$MAX_ELAPSED" ]; then
        echo "Time guard: ${ELAPSED}s elapsed (max ${MAX_ELAPSED}s), stopping." >> "$LOG"
        break
    fi

    # Atomically claim the oldest queued plan not held by a live sibling runner.
    # If every queued plan is already claimed, there's nothing for us to do.
    NEXT_PLAN=$(claim_next_plan) || NEXT_PLAN=""
    if [ -z "$NEXT_PLAN" ]; then
        if [ -n "${SINGLE_PLAN:-}" ]; then
            echo "Plan ${SINGLE_PLAN%.md} is being processed by another runner — nothing to do." >> "$LOG"
        elif [ "$CAP_DEFERRED" != " " ]; then
            echo "No claimable plan left. Cap-refunded and deferred to the next run:${CAP_DEFERRED% } — stopping." >> "$LOG"
        else
            echo "All queued plans are claimed by a concurrent runner — nothing to do." >> "$LOG"
        fi
        break
    fi
    PLAN_NAME=$(basename "$NEXT_PLAN")
    PLAN_SLUG="${PLAN_NAME%.md}"   # tags each interleaved log line with its plan
    CURRENT_LOCK="$QUEUE_DIR/${PLAN_NAME}.lock"

    # Per-plan retry counter — skip poison pills
    ATTEMPT_FILE="$QUEUE_DIR/${PLAN_NAME}.attempts"
    FAILURE_FILE="$QUEUE_DIR/${PLAN_NAME}.failure"   # capped tail of the last genuine impl failure (ADR-0085); lifecycle-tied to ATTEMPT_FILE
    CAP_REFUND_FILE="$QUEUE_DIR/${PLAN_NAME}.cap-refunds"   # wall-clock refunds granted to this plan; lifecycle-tied to ATTEMPT_FILE, NOT reset by refund_attempt
    ATTEMPTS=0
    if [ -f "$ATTEMPT_FILE" ]; then
        ATTEMPTS=$(cat "$ATTEMPT_FILE")
    fi
    if [ "$ATTEMPTS" -ge "$MAX_ATTEMPTS" ]; then
        echo "Plan $PLAN_NAME failed $ATTEMPTS times — moving to skipped/." >> "$LOG"
        mkdir -p "$NIGHTLY_DIR/skipped"
        mv "$NEXT_PLAN" "$NIGHTLY_DIR/skipped/"
        rm -f "$ATTEMPT_FILE" "$FAILURE_FILE" "$CAP_REFUND_FILE"
        REPORTS_DIR="$NIGHTLY_DIR/reports"
        mkdir -p "$REPORTS_DIR"
        SLUG=$(basename "$PLAN_NAME" .md)
        {
            printf 'Plan "%s" skipped after %d failed attempts in one night. Needs human review.\n\n' \
                "$SLUG" "$ATTEMPTS"
            printf '## Last attempt log tail\n\n```\n'
            tail -30 "$LOG"
            printf '\n```\n'
        } > "$REPORTS_DIR/$(date +%Y-%m-%d)-skipped-$SLUG.md"
        rm -rf "$CURRENT_LOCK" 2>/dev/null || true
        CURRENT_LOCK=""
        continue
    fi

    # Increment attempt counter
    echo $(( ATTEMPTS + 1 )) > "$ATTEMPT_FILE"

    PLANS_RUN=$(( PLANS_RUN + 1 ))
    echo "--- Plan #$PLANS_RUN: $PLAN_NAME (attempt $(( ATTEMPTS + 1 ))) at $(date) ---" >> "$LOG"

    # --- Phase 1: Implementation ---
    # Skip if handoff file exists (resume: impl done, postplan pending)
    HANDOFF_FILE="$HANDOFF_DIR/${PLAN_NAME}.json"

    if [ -f "$HANDOFF_FILE" ]; then
        echo "Handoff exists — skipping impl, proceeding to post-plan." >> "$LOG"
    else
        REMAINING_SECS=$(( MAX_ELAPSED - $(( $(date +%s) - START )) ))
        if [ "$REMAINING_SECS" -lt 300 ]; then
            REMAINING_SECS=300
        fi
        # Per-phase cap: don't let one impl consume the whole night
        if [ "$REMAINING_SECS" -gt "$MAX_IMPL_SECS" ]; then
            REMAINING_SECS="$MAX_IMPL_SECS"
        fi
        IMPL_LOG_BEFORE=$(wc -l < "$LOG" 2>/dev/null || echo 0)
        HEARTBEAT_FILE="$NIGHTLY_DIR/.heartbeat-$$-impl"
        CMDPID_FILE="$NIGHTLY_DIR/.cmdpid-$$-impl"
        rm -f "$HEARTBEAT_FILE" "$CMDPID_FILE"

        run_heartbeat_watcher "$HEARTBEAT_FILE" "$LOG" "impl" "$CMDPID_FILE" "$PLAN_SLUG" &
        WATCHER_PID=$!

        IMPL_STATUS=0
        IMPL_START=$(date +%s)
        # Per-plan model selection: a plan may declare `impl_model:` in its
        # first frontmatter block; absent/unknown → Opus default.
        # Both invocations pass `--effort high` explicitly to pin reasoning
        # depth regardless of the user's interactive `/effort` setting (which
        # writes ~/.claude/settings.json effortLevel). Do not remove as
        # "redundant with the default" — the pin is the point.
        BASE_MODEL=$(bin/lib/plan-impl-model "$NEXT_PLAN")
        # Escalate a non-Opus plan to Opus on its FINAL attempt only (ADR-0085).
        # $ATTEMPTS is the PRE-increment read (:621-624); the attempt now running
        # is $(( ATTEMPTS + 1 )), which the helper compares against MAX_ATTEMPTS.
        IMPL_MODEL=$(bin/lib/automouse-escalate-model "$BASE_MODEL" "$(( ATTEMPTS + 1 ))" "$MAX_ATTEMPTS")
        if [ "$IMPL_MODEL" != "$BASE_MODEL" ]; then
            echo "[$(date +%H:%M:%S)] ESCALATING impl model $BASE_MODEL -> $IMPL_MODEL (final attempt $(( ATTEMPTS + 1 ))/$MAX_ATTEMPTS) for $PLAN_NAME" >> "$LOG"
        fi
        echo "[$(date +%H:%M:%S)] impl model: $IMPL_MODEL for $PLAN_NAME" >> "$LOG"
        # Assemble the impl prompt. On the escalated final retry ONLY, append a
        # second trailing context line (PRIOR_FAILURE_REPORT=<path>) in the same
        # style as PLAN_FILE — report-if-present, decoupled from the escalation
        # trigger (ADR-0085).
        IMPL_PROMPT="$(cat "$SELF_DIR/prompt-impl")

PLAN_FILE=$PLAN_NAME"
        # `cat` does not expand shell syntax, so the template's budget slot is a
        # literal {{IMPL_BUDGET_MINUTES}} token substituted here. Keep the token
        # spelled identically on both sides — bin/test-automouse-impl-cap-timeout
        # pins that pairing, because a one-sided rename would silently ship the
        # raw placeholder to the agent.
        IMPL_BUDGET_MIN=$(( REMAINING_SECS / 60 ))
        IMPL_PROMPT="${IMPL_PROMPT//\{\{IMPL_BUDGET_MINUTES\}\}/$IMPL_BUDGET_MIN}"
        if should_feed_failure_report "$BASE_MODEL" "$IMPL_MODEL" "$FAILURE_FILE"; then
            IMPL_PROMPT="$IMPL_PROMPT
PRIOR_FAILURE_REPORT=$FAILURE_FILE"
            echo "[$(date +%H:%M:%S)] feeding prior failure report to escalated retry: $FAILURE_FILE for $PLAN_NAME" >> "$LOG"
        fi
        # CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 disables the harness's background-task
        # sweep (same reason bin/plan-now sets it). At the default (~600s) the harness
        # TERMINATES a still-running background task after the final turn and prints
        # "Background tasks still running after 600s; terminating." — which is exactly
        # how the 2026-08-13 docfix-veronly-self-ship impl lost its Phase 7 delegate
        # after phases 1-6 had already landed green. Since Agent/Task is asynchronous,
        # EVERY delegate is a background task, so any packet slower than the ceiling
        # was unwinnable. 0 = wait indefinitely; `timeout "$REMAINING_SECS"` and the
        # heartbeat watcher (STALL_KILL_SECS) remain the real bounds.
        #
        # WHAT THIS DOES NOT COVER. The harness sweep has TWO independent triggers, and
        # the ceiling is only one of them. Decompiled from 2.1.241, the sweep fires when
        # the main thread is idle and EITHER the ceiling is exceeded OR nothing awaitable
        # remains — and "awaitable" is `local_agent`/`local_workflow` only:
        #   I2e(e){ if(e.type==="local_agent") return !cR(e); return e.type==="local_workflow" }
        # A shell started with `run_in_background: true` is `local_bash`, so it is NEVER
        # awaited no matter what this variable is set to; after a 5000ms grace the harness
        # logs `print wind-down: killing background shell <id>` and exits. Setting the
        # ceiling to 0 makes background AGENTS safe and does nothing at all for background
        # BASH. The 2026-08-24 team-page-expiring-players-faded impl lost three verification
        # gates and its handoff to exactly this path. The guard is upstream, not here:
        # bin/automouse/prompt-impl forbids backgrounded Bash, and ~/.claude/hooks/bash-guard.sh
        # check 17 denies `run_in_background: true` whenever CLAUDE_HEADLESS is set.
        CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 \
        NIGHTLY_CMDPID_FILE="$CMDPID_FILE" \
        timeout "$REMAINING_SECS" \
            claude -p "$IMPL_PROMPT" \
                --dangerously-skip-permissions \
                --model "$IMPL_MODEL" \
                --effort high \
                --output-format stream-json \
                --verbose \
                --name "automouse-impl-$(date +%Y-%m-%d-%H%M)" \
            2> >(grep -v 'thinking.type=enabled' >> "$LOG") \
            | bin/lib/automouse-stream-filter.sh "$HEARTBEAT_FILE" "$CMDPID_FILE" "$PLAN_SLUG" impl \
            >> "$LOG" || IMPL_STATUS=$?

        kill "$WATCHER_PID" 2>/dev/null || true
        wait "$WATCHER_PID" 2>/dev/null || true
        WATCHER_PID=""
        rm -f "$HEARTBEAT_FILE" "$CMDPID_FILE"

        if [ "$IMPL_STATUS" -ne 0 ]; then
            printf '[%s] %s claude exited code=%d (impl phase)\n' "$(date +%H:%M:%S)" "$PLAN_SLUG" "$IMPL_STATUS" >> "$LOG"
        fi

        echo "--- Plan #$PLANS_RUN impl finished at $(date) ---" >> "$LOG"
        append_cost_row "$PLAN_NAME" impl "$IMPL_LOG_BEFORE" "$IMPL_MODEL"

        IMPL_DUR=$(( $(date +%s) - IMPL_START ))

        # Environmental-failure breaker. A usage/rate limit, auth error, or any
        # transient that kills the agent is NOT a plan failure — refund the attempt
        # and STOP so the queue survives intact (it resumes next run). The decision
        # lives in should_impl_env_stop() (above): env-stop only when the agent
        # produced no outcome (no handoff AND the plan is still in queue/) and a
        # transient signature is present —
        #   1. a known limit/auth signature in this phase's log slice, or
        #   2. a sub-minute exit — real impls run 15-50 min, so a fast no-outcome
        #      exit is environmental whatever the phrasing, and (unlike string
        #      matching) is immune to the async-stderr log-flush race.
        #   3. a watchdog stall-kill — no stream events for STALL_KILL_SECS, a
        #      transient hang (e.g. a dead inference stream), not a plan defect.
        # A deliberate skip (plan moved out of queue/) is NOT environmental and
        # falls through to continue the loop. A slow no-signature failure that left
        # the plan in queue/ falls through as a genuine plan failure, keeping its
        # incremented attempt → eventual poison-pill skip (unchanged).
        # EXCEPTION, handled just below: a slow failure that was the wall-clock
        # cap itself is refunded by the bounded cap-timeout breaker, up to
        # CAP_REFUND_LIMIT times per plan.
        IMPL_HANDOFF=0;  [ -f "$HANDOFF_FILE" ] && IMPL_HANDOFF=1
        IMPL_IN_QUEUE=0; [ -e "$NEXT_PLAN" ]   && IMPL_IN_QUEUE=1
        IMPL_ENV_ERR=0;  phase_env_error "$IMPL_LOG_BEFORE" && IMPL_ENV_ERR=1
        IMPL_STALLED=0;  phase_stalled "$IMPL_LOG_BEFORE"   && IMPL_STALLED=1
        IMPL_FAST=0;     [ "$IMPL_DUR" -lt "$MIN_VIABLE_SECS" ] && IMPL_FAST=1
        if should_impl_env_stop "$IMPL_HANDOFF" "$IMPL_IN_QUEUE" "$IMPL_ENV_ERR" "$IMPL_STALLED" "$IMPL_FAST"; then
            REASON="usage/rate limit, auth error, or transient"
            if [ "$IMPL_STALLED" -eq 1 ]; then
                REASON="phase stalled — no stream events for >$((STALL_KILL_SECS/60))min, force-killed"
            elif [ "$IMPL_FAST" -eq 1 ]; then
                REASON="$REASON (impl exited in ${IMPL_DUR}s)"
            fi
            echo "Environmental failure during impl — $REASON. Refunding attempt, stopping loop." >> "$LOG"
            refund_attempt
            write_env_stop_report "$PLAN_NAME" impl "$REASON" "$IMPL_LOG_BEFORE"
            break
        fi

        # Wall-clock cap breaker (BOUNDED). timeout(1) hard-kills the impl at
        # REMAINING_SECS; that is environmental in exactly the way a STALL-KILL
        # is — the agent was cut off mid-work, not defeated by the plan — so the
        # attempt is refunded. Two deliberate differences from the breaker above:
        # it does NOT break the loop (a cap-timeout means THIS PLAN was big, not
        # that the environment is degraded, so the next plan is still worth
        # running), and it is CAPPED, because a plan that always exhausts the
        # wall must still retire.
        IMPL_CAP_TIMEOUT=0
        IMPL_CAP_REFUNDED=0
        impl_cap_timeout "$IMPL_STATUS" "$IMPL_DUR" "$REMAINING_SECS" && IMPL_CAP_TIMEOUT=1
        CAP_REFUNDS=$(cap_refunds_granted "$CAP_REFUND_FILE")
        if should_refund_cap_timeout "$IMPL_HANDOFF" "$IMPL_IN_QUEUE" "$IMPL_CAP_TIMEOUT" "$CAP_REFUNDS" "$CAP_REFUND_LIMIT"; then
            CAP_REASON="impl hard-killed at the ${REMAINING_SECS}s wall-clock cap (exit $IMPL_STATUS after ${IMPL_DUR}s)"
            echo "CAP-TIMEOUT REFUNDED ($(( CAP_REFUNDS + 1 ))/$CAP_REFUND_LIMIT) — $CAP_REASON. Attempt refunded; continuing to the next plan." >> "$LOG"
            record_cap_refund "$CAP_REFUND_FILE" "$CAP_REFUNDS"
            refund_attempt
            IMPL_CAP_REFUNDED=1
            # Defer for the REST OF THIS RUN (see claim_next_plan): the plan is
            # still the oldest entry in queue/, so without this the next iteration
            # would immediately re-claim it and grind the whole night on one plan.
            CAP_DEFERRED="$CAP_DEFERRED$PLAN_NAME "
        elif [ "$IMPL_CAP_TIMEOUT" -eq 1 ] && [ "$IMPL_HANDOFF" -eq 0 ] && [ "$IMPL_IN_QUEUE" -eq 1 ]; then
            echo "CAP-TIMEOUT BURNED — impl hard-killed at the ${REMAINING_SECS}s wall-clock cap (exit $IMPL_STATUS after ${IMPL_DUR}s); refund budget ${CAP_REFUNDS}/${CAP_REFUND_LIMIT} exhausted, this counts as a genuine attempt." >> "$LOG"
        fi

        # Handoff created → impl succeeded, reset attempt counter
        if [ -f "$HANDOFF_FILE" ]; then
            echo "Handoff file created — impl succeeded." >> "$LOG"
            rm -f "$ATTEMPT_FILE" "$FAILURE_FILE" "$CAP_REFUND_FILE"
        elif [ ! -e "$NEXT_PLAN" ]; then
            echo "Impl made a deliberate disposition (plan left queue/, e.g. already-merged → done/ or a stale-plan skip) — not an environmental failure, continuing." >> "$LOG"
        elif [ "$IMPL_CAP_REFUNDED" -eq 0 ]; then
            # Genuine (non-environmental) failure: handoff absent, plan STILL in
            # queue/, the env-stop guard did NOT fire (it breaks above), and the
            # cap-timeout breaker did NOT refund (it sets IMPL_CAP_REFUNDED=1). The
            # incremented attempt stays in place (→ eventual poison-pill, unchanged).
            # Persist the capped failure report so the NEXT attempt — escalated to
            # Opus on the final retry (ADR-0085) — has this attempt's context.
            write_failure_report "$PLAN_NAME" "$IMPL_LOG_BEFORE" "$IMPL_MODEL" "$(( ATTEMPTS + 1 ))"
            echo "Genuine impl failure — wrote $FAILURE_FILE (attempt $(( ATTEMPTS + 1 ))/$MAX_ATTEMPTS)." >> "$LOG"
        fi
    fi

    # --- Phase 2: Post-Plan (only if handoff file exists) ---
    if [ -f "$HANDOFF_FILE" ]; then
        # Re-check time guard before starting post-plan
        ELAPSED=$(( $(date +%s) - START ))
        if [ "$ELAPSED" -gt "$MAX_ELAPSED" ]; then
            echo "Time guard between phases — will resume postplan next run." >> "$LOG"
            break
        fi

        REMAINING_SECS=$(( MAX_ELAPSED - $(( $(date +%s) - START )) ))
        if [ "$REMAINING_SECS" -lt 300 ]; then
            REMAINING_SECS=300
        fi
        if [ "$REMAINING_SECS" -gt "$MAX_PP_SECS" ]; then
            REMAINING_SECS="$MAX_PP_SECS"
        fi
        PP_LOG_BEFORE=$(wc -l < "$LOG" 2>/dev/null || echo 0)
        HEARTBEAT_FILE="$NIGHTLY_DIR/.heartbeat-$$-postplan"
        CMDPID_FILE="$NIGHTLY_DIR/.cmdpid-$$-postplan"
        rm -f "$HEARTBEAT_FILE" "$CMDPID_FILE"

        run_heartbeat_watcher "$HEARTBEAT_FILE" "$LOG" "postplan" "$CMDPID_FILE" "$PLAN_SLUG" &
        WATCHER_PID=$!

        PP_STATUS=0
        PP_START=$(date +%s)
        # Same background-task ceiling as the impl phase above — /post-plan spawns
        # review/E2E sub-agents, which are asynchronous too. The skill's own "drain
        # every background shell before ending your turn" rule is unchanged and still
        # the primary contract; this only stops the harness from severing an agent
        # that is legitimately still working. It does NOT protect a backgrounded Bash
        # shell — see the impl-phase comment above for why the ceiling cannot; that is
        # what the skill's drain barrier and bash-guard.sh check 17 are for.
        CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 \
        NIGHTLY_CMDPID_FILE="$CMDPID_FILE" \
        timeout "$REMAINING_SECS" \
            claude -p "$(cat "$SELF_DIR/prompt-postplan")

PLAN_FILE=$PLAN_NAME" \
                --dangerously-skip-permissions \
                --model claude-sonnet-4-6 \
                --effort high \
                --output-format stream-json \
                --verbose \
                --name "automouse-postplan-$(date +%Y-%m-%d-%H%M)" \
            2> >(grep -v 'thinking.type=enabled' >> "$LOG") \
            | bin/lib/automouse-stream-filter.sh "$HEARTBEAT_FILE" "$CMDPID_FILE" "$PLAN_SLUG" postplan \
            >> "$LOG" || PP_STATUS=$?

        kill "$WATCHER_PID" 2>/dev/null || true
        wait "$WATCHER_PID" 2>/dev/null || true
        WATCHER_PID=""
        rm -f "$HEARTBEAT_FILE" "$CMDPID_FILE"

        if [ "$PP_STATUS" -ne 0 ]; then
            printf '[%s] %s claude exited code=%d (postplan phase)\n' "$(date +%H:%M:%S)" "$PLAN_SLUG" "$PP_STATUS" >> "$LOG"
        fi

        echo "--- Plan #$PLANS_RUN postplan finished at $(date) ---" >> "$LOG"
        append_cost_row "$PLAN_NAME" postplan "$PP_LOG_BEFORE" claude-sonnet-4-6

        PP_DUR=$(( $(date +%s) - PP_START ))

        # Environmental-failure breaker (mirrors impl). A successful post-plan
        # removes the handoff (the agent moves the plan to done/ and deletes it),
        # so a handoff still present after a sub-minute exit means the agent never
        # ran — environmental. A known limit/auth signature stops regardless, so a
        # dead budget doesn't burn a postplan retry. Refund + stop; queue intact.
        if phase_env_error "$PP_LOG_BEFORE" \
           || phase_stalled "$PP_LOG_BEFORE" \
           || { [ -f "$HANDOFF_FILE" ] && [ "$PP_DUR" -lt "$MIN_VIABLE_SECS" ]; }; then
            REASON="usage/rate limit, auth error, or transient"
            if phase_stalled "$PP_LOG_BEFORE"; then
                REASON="phase stalled — no stream events for >$((STALL_KILL_SECS/60))min, force-killed"
            elif [ "$PP_DUR" -lt "$MIN_VIABLE_SECS" ]; then
                REASON="$REASON (postplan exited in ${PP_DUR}s)"
            fi
            echo "Environmental failure during postplan — $REASON. Refunding attempt, stopping loop." >> "$LOG"
            refund_attempt
            write_env_stop_report "$PLAN_NAME" postplan "$REASON" "$PP_LOG_BEFORE"
            break
        fi
    fi

    # If the plan moved out of queue/ (to done/ or skipped/), clean up its attempt file and failure report
    if [ ! -e "$NEXT_PLAN" ]; then
        rm -f "$ATTEMPT_FILE" "$FAILURE_FILE" "$CAP_REFUND_FILE"
    fi

    # Release this plan's claim — done with it for this iteration. A genuine
    # failure leaves it in queue/ (attempt incremented) for any runner to retry;
    # a completed plan has moved to done/. Either way, drop the lock and move on.
    if [ -n "$CURRENT_LOCK" ]; then
        rm -rf "$CURRENT_LOCK" 2>/dev/null || true
        CURRENT_LOCK=""
    fi

    # Single-plan mode: exactly one attempt, then stop — predictable for a
    # watched one-off. A genuine failure does NOT retry to MAX_ATTEMPTS.
    [ -n "${SINGLE_PLAN:-}" ] && break
done

# Clean up any leftover attempt files for plans that completed
for af in "$QUEUE_DIR"/*.attempts; do
    [ -e "$af" ] || continue
    PLAN_FOR_ATTEMPT="${af%.attempts}"
    if [ ! -e "$PLAN_FOR_ATTEMPT" ]; then
        rm -f "$af"
    fi
done

# Clean up any leftover failure reports for plans that completed (mirrors the
# .attempts sweep above — .failure shares the .attempts lifecycle, ADR-0085)
for ff in "$QUEUE_DIR"/*.failure; do
    [ -e "$ff" ] || continue
    PLAN_FOR_FAILURE="${ff%.failure}"
    if [ ! -e "$PLAN_FOR_FAILURE" ]; then
        rm -f "$ff"
    fi
done

# Clean up any leftover cap-refund counters for plans that completed (mirrors
# the .attempts sweep above — .cap-refunds shares the .attempts lifecycle)
for cf in "$QUEUE_DIR"/*.cap-refunds; do
    [ -e "$cf" ] || continue
    PLAN_FOR_CAP="${cf%.cap-refunds}"
    if [ ! -e "$PLAN_FOR_CAP" ]; then
        rm -f "$cf"
    fi
done

# Clean up orphaned handoff files (plan no longer in queue)
for hf in "$HANDOFF_DIR"/*.json; do
    [ -e "$hf" ] || continue
    PLAN_FOR_HANDOFF="$QUEUE_DIR/$(basename "${hf%.json}")"
    if [ ! -e "$PLAN_FOR_HANDOFF" ]; then
        rm -f "$hf"
    fi
done

# Clean up orphaned claim locks (plan no longer in queue — completed or skipped).
# Locks on plans still in queue/ are left alone: a sibling runner may hold one
# legitimately, and a genuinely abandoned one is reaped via the staleness check
# in claim_next_plan on the next run.
for lock in "$QUEUE_DIR"/*.md.lock; do
    [ -e "$lock" ] || continue
    if [ ! -e "${lock%.lock}" ]; then
        rm -rf "$lock" 2>/dev/null || true
    fi
done

echo "=== Automouse session complete at $(date) — $PLANS_RUN plan(s) run ===" >> "$LOG"
