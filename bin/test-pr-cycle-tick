set_result "101\tfired\tfailed\tkind=test"
run_tick
run_tick
[[ "$(launch_count)" == "1" ]] || fail "rebase-keeps-cap: want 1 launch before the rebase, got $(launch_count)"
[[ "$(attempt 101)" == "$K1" ]] || fail "rebase-keeps-cap: attempts/101 is '$(attempt 101)', want the patch-id key"
[[ "$(dm_count)" == "1" ]] || fail "rebase-keeps-cap: want 1 retry-cap DM before the rebase, got $(dm_count)"
set_prs '101|branch-one|fff6666|BLOCKED|false'; set_checks fff6666 red
run_tick
[[ "$(launch_count)" == "1" ]] || fail "rebase-keeps-cap: relaunched after a rebase that kept the patch-id"
out_has 'retry cap' || fail "rebase-keeps-cap: no retry-cap skip line: $OUT"
[[ "$(dm_count)" == "1" ]] || fail "rebase-keeps-cap: retry-cap DM resent for the rebased head ($(dm_count))"
grep -qF "PR #101 is still red on head aaa1111 after one rescue. Skipping it until its diff changes." "$SCRATCH/dm.log" \
    || fail "rebase-keeps-cap: retry-cap DM wording: $(cat "$SCRATCH/dm.log")"
end_case rebase-keeps-cap

reset; begin_case
E_PATCHID="$SCRATCH/patchid-file"; K1="$(key_of 1111111)"; K2="$(key_of 2222222)"
set_prs "$RED101"; set_checks aaa1111 red; set_key 101 "$K1"
set_result "101\tfired\tfailed\tkind=test"
run_tick
run_tick
set_prs '101|branch-one|fff6666|BLOCKED|false'; set_checks fff6666 red; set_key 101 "$K2"
run_tick
[[ "$(launch_count)" == "2" ]] || fail "content-change-requalifies: want a second launch for a new patch-id, got $(launch_count)"
end_case content-change-requalifies

reset; begin_case
E_PATCHID="$SCRATCH/patchid-file"; K1="$(key_of 1111111)"; K2="$(key_of 2222222)"
set_prs "$RED101"; set_checks aaa1111 red; set_key 101 "$K1"
set_result "101\tfired\tfailed\tkind=test"
run_tick
grep -qxF "$(printf '101\taaa1111\t%s' "$K1")" "$STATE_DIR"/pending/* \
    || fail "settle-uses-launch-key: pending line is not <pr>TAB<sha>TAB<key>: $(cat "$STATE_DIR"/pending/* 2>/dev/null)"
set_prs '101|branch-one|fff6666|BLOCKED|false'; set_checks fff6666 red; set_key 101 "$K2"
run_tick
[[ "$(attempt 101)" == "$K1" ]] || fail "settle-uses-launch-key: attempts/101 is '$(attempt 101)', want the launch-time key $K1"
end_case settle-uses-launch-key

reset; begin_case
E_PATCHID="$SCRATCH/patchid-file"; K1="$(key_of 1111111)"
