# ── Orphan stash drop ─────────────────────────────────────────────────────────
ST_ON=(WT_GC_DROP_STASHES=1 WT_GC_ARCHIVE_STAMP=1700000000)
stash_has() { git -C "$ENV_MAIN" stash list --format=%H | grep -qxF -- "$1"; }
# mk_stash <subject-branch> <age_days> [untracked] — stash a tracked edit
# (plus an untracked file when asked), dated N days ago, with the subject
# "On <branch>: fixture". Prints the stash sha.
mk_stash() {
    local ep sha
    ep="$(epoch_ago "$2")"
    printf 'stashed-%s-%s\n' "$1" "$RANDOM" > "$ENV_MAIN/README.md"
    if [ "${3:-}" = untracked ]; then
        printf 'u\n' > "$ENV_MAIN/stash-untracked-$1.txt"
        GIT_AUTHOR_DATE="@$ep" GIT_COMMITTER_DATE="@$ep" git -C "$ENV_MAIN" stash push -q -u -m fixture >/dev/null 2>&1
    else
        GIT_AUTHOR_DATE="@$ep" GIT_COMMITTER_DATE="@$ep" git -C "$ENV_MAIN" stash push -q -m fixture >/dev/null 2>&1
    fi
    sha="$(git -C "$ENV_MAIN" rev-parse 'stash@{0}')"
    git -C "$ENV_MAIN" stash drop -q >/dev/null 2>&1
    git -C "$ENV_MAIN" stash store -m "On $1: fixture" "$sha" >/dev/null 2>&1
    printf '%s\n' "$sha"
}

if should_run ST1-branch-gone-dropped; then
fx ST1-branch-gone-dropped
SHA="$(mk_stash gone-a 10)"
rt "${ST_ON[@]}" -- --force
chk_rc ST1 0
stash_has "$SHA" && note_err "stash still listed"
arch_has "1700000000/stash/$SHA" || note_err "no stash archive ref"
log_has "stash dropped ${SHA:0:10} \(branch gone\)" || note_err "no dropped log"
finish_case
fi

