# ---------------------------------------------------------------- empty backlog
# An empty batch needs the script-written sentinel; the marker alone is a failure.
# The stub's default action is `drain`: sentinel, marker, then the stop flag.

# stop_on_sleep: the next stubbed sleep creates the stop flag.
stop_on_sleep() { printf 'touch "%s/stop"\n' "$STATE" > "$T/sleep.hook"; }

# empty_dms: how many "backlog empty" DMs the run sent.
empty_dms() {
    if [ -f "$T/dm.calls" ]; then
        grep -c 'backlog empty; re-checking every 240m' "$T/dm.calls" || true
    else
        echo 0
    fi
}

test_empty_marker_without_sentinel_fails() {
    new_env
    seed_usage 5 0 1
    queue none-unconfirmed
    IBL5_BURNDOWN_MAX_FAILS=1 run_loop run
    # Mutation: classifying on the marker alone makes this batch empty, not failed.
    assert_eq test_empty_marker_without_sentinel_fails:rc 1 "$RC"
    assert_contains test_empty_marker_without_sentinel_fails:line "$OUT" \
        "batch failed reason=none-selected-unconfirmed rc=0 fails=1/1"
    assert_not_contains test_empty_marker_without_sentinel_fails:no-empty-line "$OUT" "backlog empty"
}

test_empty_sentinel_sleeps_until_stop() {
    new_env
    seed_usage 5 0 1
    queue none
    stop_on_sleep
    run_loop run
    assert_eq test_empty_sentinel_sleeps_until_stop:rc 0 "$RC"
    assert_contains test_empty_sentinel_sleeps_until_stop:line "$OUT" \
        "backlog empty (sentinel confirmed first round LEDGER: none); re-check in 240m streak=1"
    assert_contains test_empty_sentinel_sleeps_until_stop:sleep "$OUT" "sleep 14400s reason=backlog-empty"
    assert_contains test_empty_sentinel_sleeps_until_stop:finish "$OUT" "finish reason=stopped"
    assert_not_contains test_empty_sentinel_sleeps_until_stop:not-exhausted "$OUT" "finish reason=exhausted"
}

test_empty_dm_once_per_streak() {
    new_env
    seed_usage 5 0 1
    queue none none
    run_loop run
    assert_eq test_empty_dm_once_per_streak:rc 0 "$RC"
    # Three empty rounds (none, none, drain) send one DM, not three.
    assert_eq test_empty_dm_once_per_streak:one-dm 1 "$(empty_dms)"
}

test_empty_streak_resets_after_ran() {
    new_env
    seed_usage 5 0 1
    queue none ledger
    run_loop run
    assert_eq test_empty_streak_resets_after_ran:rc 0 "$RC"
    # empty, ran, empty (drain): the ran batch ends the first streak.
    assert_eq test_empty_streak_resets_after_ran:two-dms 2 "$(empty_dms)"
}

test_empty_once_exits_zero() {
