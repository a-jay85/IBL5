#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-pr-triage — regression harness for bin/pr-triage.
# Fully offline: stub gh, no network.
# Wired into the "Shell harness regression tests" job in .github/workflows/tests.yml.
# Run: bin/test-pr-triage (exit 0 = all pass, 1 = a case failed)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TRIAGE="$SCRIPT_DIR/pr-triage"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
export HOME="$TMP/home"

FAILED=0

pass()     { echo "ok: $1"; }
failcase() { echo "FAIL: $1"; FAILED=1; }

# assert_match <name> <ERE> <output>
assert_match() {
    if printf '%s\n' "$3" | grep -qE "$2"; then
        pass "$1"
    else
        failcase "$1 - expected to match: $2"
        printf '%s\n' "$3" | sed 's/^/    /'
    fi
}

# assert_absent <name> <ERE> <output>
assert_absent() {
    if printf '%s\n' "$3" | grep -qE "$2"; then
        failcase "$1 - expected NOT to match: $2"
        printf '%s\n' "$3" | sed 's/^/    /'
    else
        pass "$1"
    fi
}

# assert_status <name> <expected> <actual>
assert_status() {
    if [ "$3" = "$2" ]; then pass "$1"; else failcase "$1 - expected exit $2, got $3"; fi
}

if [ ! -x "$TRIAGE" ]; then
    echo "FAIL: $TRIAGE is missing or not executable" >&2
    exit 1
fi

# Scratch repo so `git remote get-url origin` resolves inside triage.
git init -q "$TMP/repo"
git -C "$TMP/repo" remote add origin https://github.com/a-jay85/IBL5-test.git

# Stub gh / gh api — appends each call to $FIX/calls.log (FIX resolved at run time from env)
mkdir -p "$TMP/stubs"
cat > "$TMP/stubs/gh" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$FIX/calls.log"
case "$1 $2" in
  "auth status") exit 0 ;;
  "pr list")     cat "$FIX/prs.json" ;;
  "pr merge")    rc=0; [ -f "$FIX/merge-rc" ] && rc="$(cat "$FIX/merge-rc")"; exit "$rc" ;;
  "pr view")     echo '{"state":"MERGED"}' ;;
  "api graphql") echo '{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":[]}}}}}' ;;
  api*)
    case "$*" in
      *update-branch*) rc=0; [ -f "$FIX/update-branch-rc" ] && rc="$(cat "$FIX/update-branch-rc")"
                       [ "$rc" = 0 ] && echo '{"message":"Updating pull request branch."}'; exit "$rc" ;;
      *protection*)    echo '{"required_status_checks":{"contexts":["Tests and Analysis","E2E Tests","human-signoff"]}}' ;;
      *check-runs*)    sha="$(printf '%s' "$*" | sed -E 's#.*/commits/([0-9a-f]+)/check-runs.*#\1#')"
                       if [ -f "$FIX/checks-$sha.json" ]; then cat "$FIX/checks-$sha.json"; else echo '{"check_runs":[]}'; fi ;;
      "api user")      if [ -f "$FIX/viewer.json" ]; then cat "$FIX/viewer.json"; else echo '{"login":"fixture-me"}'; fi ;;
      *issues/*/comments*) n="$(printf '%s' "$*" | sed -E 's#.*/issues/([0-9]+)/comments.*#\1#')"
                       if [ -f "$FIX/comments-$n.json" ]; then cat "$FIX/comments-$n.json"; else echo '[]'; fi ;;
      *) echo '{}' ;;
    esac ;;
  *) echo '{}' ;;
esac
STUB
chmod +x "$TMP/stubs/gh"

# Stub merge-line pass: logs "merge-line <args>"; exit code from $FIX/merge-line-rc.
cat > "$TMP/stubs/merge-line" <<'STUB'
#!/usr/bin/env bash
printf 'merge-line %s\n' "$*" >> "$FIX/calls.log"
echo "[00:00:00] updated PR #1 onto master"
rc=0; [ -f "$FIX/merge-line-rc" ] && rc="$(cat "$FIX/merge-line-rc")"
exit "$rc"
STUB
chmod +x "$TMP/stubs/merge-line"

# checks_json <conclusion-Tests> <conclusion-E2E> <conclusion-signoff>
checks_json() {
    printf '{"check_runs":['
    printf '{"name":"Tests and Analysis","status":"completed","conclusion":"%s","completed_at":"2026-09-25T00:00:00Z","details_url":"https://github.com/a-jay85/IBL5-test/actions/runs/1"},' "$1"
    printf '{"name":"E2E Tests","status":"completed","conclusion":"%s","completed_at":"2026-09-25T00:00:00Z","details_url":"https://github.com/a-jay85/IBL5-test/actions/runs/1"},' "$2"
    printf '{"name":"human-signoff","status":"completed","conclusion":"%s","completed_at":"2026-09-25T00:00:00Z","details_url":"https://github.com/a-jay85/IBL5-test/actions/runs/1"}' "$3"
    printf ']}'
}

# pr_json <number> <mss> <body> — emits one PR JSON object; wrap in array via: pr_json ... | jq -s .
pr_json() {
    local num="$1" mss="$2" body="$3"
    local sha
    sha="$(printf '%040d' "$num")"
    jq -n \
        --argjson num "$num" \
        --arg mss "$mss" \
        --arg body "$body" \
        --arg sha "$sha" \
        '{number: $num, title: ("chore: fixture #" + ($num|tostring)), body: $body, labels: [], files: [],
          mergeStateStatus: ($mss | if . == "" then null else . end),
          headRefOid: $sha, headRefName: ("fixture-" + ($num|tostring))}'
}

BODY_CLEAR="$(printf '## Summary\nx\n\n## Manual Testing\nNo manual testing needed (covered by automated tests).')"
BODY_HELD="$(printf '## Summary\nx\n\n## Manual Testing\n- [ ] click the button')"
BODY_UNCLEARED="$(printf '## Summary\nx')"

# run_triage <fixdir> [--arm]  — sets OUT (merged stdout+stderr) and ST (exit status)
run_triage() {
    local fix="$1"; shift
    ST=0
    OUT="$(cd "$TMP/repo" && FIX="$fix" GH_CMD="$TMP/stubs/gh" GH_API_CMD="$TMP/stubs/gh api" \
        PR_TRIAGE_MERGE_LINE_CMD="$TMP/stubs/merge-line" PATH="$TMP/stubs:$PATH" "$TRIAGE" "$@" 2>&1)" || ST=$?
}

# row_bucket <output> <pr-number>  — BUCKET column
row_bucket() { printf '%s\n' "$1" | awk -F'  +' -v pr="#$2" '$1 == pr { print $2 }'; }
# row_action <output> <pr-number>  — NEXT-ACTION column
row_action()  { printf '%s\n' "$1" | awk -F'  +' -v pr="#$2" '$1 == pr { print $3 }'; }
# row_mss <output> <pr-number>  — MSS column
row_mss()     { printf '%s\n' "$1" | awk -F'  +' -v pr="#$2" '$1 == pr { print $4 }'; }

# --- C1: DRAFT + cleared + green under --arm is NOT-MERGEABLE ---
FIX="$(mktemp -d -p "$TMP")"
checks_json success success success > "$FIX/checks-$(printf '%040d' 1).json"
pr_json 1 DRAFT "$BODY_CLEAR" | jq -s . > "$FIX/prs.json"
run_triage "$FIX" --arm
assert_match  "C1 bucket=NOT-MERGEABLE"   "NOT-MERGEABLE"          "$(row_bucket "$OUT" 1)"
assert_match  "C1 action=mark ready"      "mark ready for review"  "$(row_action "$OUT" 1)"
assert_absent "C1 never arms"             "pr merge"               "$(cat "$FIX/calls.log" 2>/dev/null)"
assert_absent "C15 DRAFT no update-branch" "update-branch"         "$(cat "$FIX/calls.log" 2>/dev/null)"
assert_status "C1 exit 0"                 0                        "$ST"

# --- C2: UNKNOWN is NOT-MERGEABLE ---
FIX="$(mktemp -d -p "$TMP")"
checks_json success success success > "$FIX/checks-$(printf '%040d' 2).json"
pr_json 2 UNKNOWN "$BODY_CLEAR" | jq -s . > "$FIX/prs.json"
run_triage "$FIX" --arm
assert_match  "C2 bucket=NOT-MERGEABLE"   "NOT-MERGEABLE"               "$(row_bucket "$OUT" 2)"
assert_match  "C2 action=re-check"        "re-check \\(state unknown\\)" "$(row_action "$OUT" 2)"
assert_absent "C2 no pr merge"            "pr merge"                    "$(cat "$FIX/calls.log" 2>/dev/null)"
assert_absent "C15 UNKNOWN no update-branch" "update-branch"            "$(cat "$FIX/calls.log" 2>/dev/null)"
assert_status "C2 exit 0"                 0                             "$ST"

# --- C3: empty mergeStateStatus is NOT-MERGEABLE, MSS column prints ? ---
FIX="$(mktemp -d -p "$TMP")"
checks_json success success success > "$FIX/checks-$(printf '%040d' 3).json"
pr_json 3 "" "$BODY_CLEAR" | jq -s . > "$FIX/prs.json"
run_triage "$FIX" --arm
assert_match  "C3 bucket=NOT-MERGEABLE"   "NOT-MERGEABLE"   "$(row_bucket "$OUT" 3)"
assert_match  "C3 MSS column prints ?"    "^[?]$"           "$(row_mss "$OUT" 3)"
assert_absent "C3 no pr merge"            "pr merge"        "$(cat "$FIX/calls.log" 2>/dev/null)"
assert_status "C3 exit 0"                 0                 "$ST"

# --- C4: non-BEHIND ARMABLE arms with --arm ---
FIX="$(mktemp -d -p "$TMP")"
checks_json success success success > "$FIX/checks-$(printf '%040d' 4).json"
pr_json 4 BLOCKED "$BODY_CLEAR" | jq -s . > "$FIX/prs.json"
run_triage "$FIX" --arm
assert_match  "C4 bucket=ARMABLE"         "^ARMABLE$"                        "$(row_bucket "$OUT" 4)"
assert_match  "C4 action=arm auto-merge"  "^arm auto-merge$"                 "$(row_action "$OUT" 4)"
assert_match  "C4 merge call logged"      "^pr merge 4 --squash --auto$"     "$(cat "$FIX/calls.log")"
assert_match  "C4 armed stdout"           "armed auto-merge on #4"           "$OUT"
assert_absent "C4 no update-branch"       "update-branch"                    "$(cat "$FIX/calls.log")"
assert_absent "C4 no merge-line pass"     "^merge-line"                      "$(cat "$FIX/calls.log")"
assert_status "C4 exit 0"                 0                                  "$ST"

# --- C5: non-BEHIND report-only (no --arm) ---
FIX="$(mktemp -d -p "$TMP")"
checks_json success success success > "$FIX/checks-$(printf '%040d' 4).json"
pr_json 4 BLOCKED "$BODY_CLEAR" | jq -s . > "$FIX/prs.json"
run_triage "$FIX"
assert_match  "C5 bucket=ARMABLE"         "^ARMABLE$"   "$(row_bucket "$OUT" 4)"
assert_absent "C5 no pr merge"            "pr merge"    "$(cat "$FIX/calls.log" 2>/dev/null)"
assert_status "C5 exit 0"                 0             "$ST"

# --- C6: two BEHIND+clean PRs arm, then ONE merge-line pass, no per-PR update ---
FIX="$(mktemp -d -p "$TMP")"
checks_json success success success > "$FIX/checks-$(printf '%040d' 6).json"
checks_json success success success > "$FIX/checks-$(printf '%040d' 7).json"
{ pr_json 6 BEHIND "$BODY_CLEAR"; pr_json 7 BEHIND "$BODY_CLEAR"; } | jq -s . > "$FIX/prs.json"
run_triage "$FIX" --arm
assert_match  "C6 bucket=ARMABLE"                 "^ARMABLE$"                                         "$(row_bucket "$OUT" 6)"
assert_match  "C6 action=arm auto-merge update"   "^arm auto-merge \\(update branch first\\)$"        "$(row_action "$OUT" 6)"
assert_match  "C6 merge call logged #6"           "^pr merge 6 --squash --auto$"                      "$(cat "$FIX/calls.log")"
assert_match  "C6 merge call logged #7"           "^pr merge 7 --squash --auto$"                      "$(cat "$FIX/calls.log")"
assert_absent "C6 no per-PR update-branch"        "update-branch"                                     "$(cat "$FIX/calls.log")"
assert_match  "C6 merge-line pass logged"         "^merge-line --once --repo a-jay85/IBL5-test$"      "$(cat "$FIX/calls.log")"
assert_status "C6 exactly one merge-line pass"    1                                                   "$(grep -c '^merge-line' "$FIX/calls.log")"
merge_line="$(grep -n "^pr merge 7 " "$FIX/calls.log" | cut -d: -f1)"
pass_line="$(grep -n "^merge-line" "$FIX/calls.log" | cut -d: -f1)"
[ "${merge_line:-0}" -lt "${pass_line:-0}" ] && pass "C6 arms before pass" || failcase "C6 arms before pass (merge=$merge_line pass=$pass_line)"
assert_match  "C6 armed stdout"                   "armed auto-merge on #6"                            "$OUT"
assert_match  "C6 pass output prefixed"           "merge-line: \[00:00:00\] updated PR #1 onto master" "$OUT"
assert_status "C6 exit 0"                         0                                                   "$ST"

# --- C8: BEHIND + failing Tests-and-Analysis is BLOCKED-CHECK ---
FIX="$(mktemp -d -p "$TMP")"
checks_json failure success success > "$FIX/checks-$(printf '%040d' 8).json"
pr_json 8 BEHIND "$BODY_CLEAR" | jq -s . > "$FIX/prs.json"
run_triage "$FIX" --arm
assert_match  "C8 bucket=BLOCKED-CHECK"   "^BLOCKED-CHECK$"   "$(row_bucket "$OUT" 8)"
assert_absent "C8 no pr merge"            "pr merge"          "$(cat "$FIX/calls.log" 2>/dev/null)"
assert_absent "C8 no update-branch"       "update-branch"     "$(cat "$FIX/calls.log" 2>/dev/null)"
assert_status "C8 exit 0"                 0                   "$ST"

# --- C9: BEHIND + unchecked Manual-Testing box is HELD ---
FIX="$(mktemp -d -p "$TMP")"
checks_json success success success > "$FIX/checks-$(printf '%040d' 9).json"
pr_json 9 BEHIND "$BODY_HELD" | jq -s . > "$FIX/prs.json"
run_triage "$FIX" --arm
assert_match  "C9 bucket=HELD"            "^HELD$"            "$(row_bucket "$OUT" 9)"
assert_match  "C9 action=human review"    "human review"      "$(row_action "$OUT" 9)"
assert_absent "C9 no pr merge"            "pr merge"          "$(cat "$FIX/calls.log" 2>/dev/null)"
assert_absent "C9 no update-branch"       "update-branch"     "$(cat "$FIX/calls.log" 2>/dev/null)"
assert_status "C9 exit 0"                 0                   "$ST"

# --- C10: BEHIND + no Manual Testing section is UNCLEARED ---
FIX="$(mktemp -d -p "$TMP")"
checks_json success success success > "$FIX/checks-$(printf '%040d' 10).json"
pr_json 10 BEHIND "$BODY_UNCLEARED" | jq -s . > "$FIX/prs.json"
run_triage "$FIX" --arm
assert_match  "C10 bucket=UNCLEARED"      "^UNCLEARED$"       "$(row_bucket "$OUT" 10)"
assert_absent "C10 no pr merge"           "pr merge"          "$(cat "$FIX/calls.log" 2>/dev/null)"
assert_status "C10 exit 0"                0                   "$ST"

# --- C11: BEHIND, merge-line pass fails: merge logged, pass logged, exit 1 ---
FIX="$(mktemp -d -p "$TMP")"
echo 1 > "$FIX/merge-line-rc"
checks_json success success success > "$FIX/checks-$(printf '%040d' 11).json"
pr_json 11 BEHIND "$BODY_CLEAR" | jq -s . > "$FIX/prs.json"
run_triage "$FIX" --arm
assert_match  "C11 merge call logged"      "^pr merge 11 --squash --auto$"   "$(cat "$FIX/calls.log")"
assert_match  "C11 merge-line pass logged" "^merge-line --once"              "$(cat "$FIX/calls.log")"
assert_match  "C11 MERGE-LINE PASS FAILED" "MERGE-LINE PASS FAILED"          "$OUT"
assert_status "C11 exit 1"                 1                                 "$ST"

# --- C12: BEHIND, merge fails — ARM FAILED, no update-branch, exit 1 ---
FIX="$(mktemp -d -p "$TMP")"
echo 1 > "$FIX/merge-rc"
checks_json success success success > "$FIX/checks-$(printf '%040d' 12).json"
pr_json 12 BEHIND "$BODY_CLEAR" | jq -s . > "$FIX/prs.json"
run_triage "$FIX" --arm
assert_match  "C12 ARM FAILED"            "ARM FAILED on #12"   "$OUT"
assert_absent "C12 no update-branch"      "update-branch"       "$(cat "$FIX/calls.log")"
assert_absent "C12 no merge-line pass"    "^merge-line"         "$(cat "$FIX/calls.log")"
assert_status "C12 exit 1"                1                     "$ST"

# --- C13: BEHIND report-only — ARMABLE action, no write calls ---
FIX="$(mktemp -d -p "$TMP")"
checks_json success success success > "$FIX/checks-$(printf '%040d' 13).json"
pr_json 13 BEHIND "$BODY_CLEAR" | jq -s . > "$FIX/prs.json"
run_triage "$FIX"
assert_match  "C13 bucket=ARMABLE"        "^ARMABLE$"                              "$(row_bucket "$OUT" 13)"
assert_match  "C13 action=update first"   "^arm auto-merge \\(update branch first\\)$" "$(row_action "$OUT" 13)"
assert_absent "C13 no pr merge"           "pr merge"                               "$(cat "$FIX/calls.log" 2>/dev/null)"
assert_absent "C13 no update-branch"      "update-branch"                          "$(cat "$FIX/calls.log" 2>/dev/null)"
assert_absent "C13 no merge-line pass"    "^merge-line"                            "$(cat "$FIX/calls.log" 2>/dev/null)"
assert_status "C13 exit 0"                0                                        "$ST"

# --- C14: pr-cycle parse compatibility on C13 output ---
c14_armable="$(printf '%s\n' "$OUT" | awk -F'  +' '$1 ~ /^#[0-9]+$/ && $2 == "ARMABLE"')"
assert_match  "C14 awk finds ARMABLE row" "^#13"          "$c14_armable"
c14_lines="$(printf '%s\n' "$c14_armable" | grep -c '.' 2>/dev/null || echo 0)"
assert_status "C14 exactly one ARMABLE"   1               "$c14_lines"
assert_absent "C14 no double space in action" "  "        "$(row_action "$OUT" 13)"

# --- C7: --help offline exits 0 and prints "ARMABLE is fail-closed" and "update-branch" ---
ST=0; OUT="$("$TRIAGE" --help 2>&1)" || ST=$?
assert_status "C7 --help exit 0"              0                        "$ST"
assert_match  "C7 ARMABLE is fail-closed"     "ARMABLE is fail-closed" "$OUT"
assert_match  "C7 usage mentions update-branch" "update-branch"        "$OUT"

# --- C16/C17: PAUSED bucket (ADR-0143 usage gate) ---
# A post-plan-now marker whose resume_cwd is this PR's worktree wins over ARMABLE.
export IBL5_USAGE_GATE_STATE_DIR="$TMP/gate-state"
mkdir -p "$IBL5_USAGE_GATE_STATE_DIR"
GATE_LIB="$SCRIPT_DIR/lib/usage-gate.sh"
for wt in wt-a wt-b; do
    mkdir -p "$TMP/$wt/bin"
    git init -q "$TMP/$wt"
    : > "$TMP/$wt/bin/post-plan-now"
    chmod +x "$TMP/$wt/bin/post-plan-now"
done
# Marker for wt-a (the runner name is post-plan-now, the resume script lives in wt-a).
# shellcheck source=bin/lib/usage-gate.sh
( . "$GATE_LIB"; usage_marker_write "cccccccc-3333-4333-8333-cccccccccccc" post-plan-now \
    "$TMP/wt-a/bin/post-plan-now" usage-pause drain 94 five_hour "" ) > /dev/null 2>&1 \
    || { failcase "C16 setup: marker write failed"; }
export PR_TRIAGE_WTL="$TMP/wtl.porcelain"
printf 'worktree %s\nHEAD 0000\nbranch refs/heads/fixture-16\n\nworktree %s\nHEAD 0000\nbranch refs/heads/fixture-17\n' \
    "$TMP/wt-a" "$TMP/wt-b" > "$PR_TRIAGE_WTL"

FIX="$(mktemp -d -p "$TMP")"
checks_json success success success > "$FIX/checks-$(printf '%040d' 16).json"
checks_json success success success > "$FIX/checks-$(printf '%040d' 17).json"
{ pr_json 16 CLEAN "$BODY_CLEAR"; pr_json 17 CLEAN "$BODY_CLEAR"; } | jq -s . > "$FIX/prs.json"
run_triage "$FIX" --arm
assert_match  "C16 paused worktree -> PAUSED"       "^PAUSED$"                                  "$(row_bucket "$OUT" 16)"
assert_match  "C16 action names the usage gate"     "none . post-plan paused by usage gate"     "$(row_action "$OUT" 16)"
assert_absent "C16 --arm never merges the paused PR" "^pr merge 16 "                            "$(cat "$FIX/calls.log")"
assert_match  "C17 other worktree stays ARMABLE"    "^ARMABLE$"                                 "$(row_bucket "$OUT" 17)"
assert_match  "C17 the unpaused PR is armed"        "^pr merge 17 --squash --auto$"             "$(cat "$FIX/calls.log")"
assert_status "C16 exit 0"                          0                                           "$ST"

# No marker at all: the PR is ARMABLE again.
rm -rf "$IBL5_USAGE_GATE_STATE_DIR/markers"
run_triage "$FIX"
assert_match  "C18 no marker -> ARMABLE"            "^ARMABLE$"                                 "$(row_bucket "$OUT" 16)"

# --help documents the bucket.
ST=0; OUT="$("$TRIAGE" --help 2>&1)" || ST=$?
assert_match  "C19 --help mentions PAUSED"          "PAUSED"                                    "$OUT"

# --- H1-H13: bin/lib/held-prs.sh pure functions (the `--held` view) ---
# shellcheck source=bin/lib/held-prs.sh
source "$SCRIPT_DIR/lib/held-prs.sh"

H_PR='{"author":{"login":"me"},"isDraft":false,"autoMergeRequest":null}'
ST=0; hp_is_held "$H_PR" me || ST=$?
assert_status "H1 held: mine, non-draft, un-armed"   0 "$ST"
ST=0; hp_is_held '{"author":{"login":"me"},"isDraft":false,"autoMergeRequest":{"mergeMethod":"SQUASH"}}' me || ST=$?
assert_status "H2 armed PR left out"                 1 "$ST"
ST=0; hp_is_held '{"author":{"login":"me"},"isDraft":true,"autoMergeRequest":null}' me || ST=$?
assert_status "H3 draft left out"                    1 "$ST"
ST=0; hp_is_held '{"author":{"login":"someone-else"},"isDraft":false,"autoMergeRequest":null}' me || ST=$?
assert_status "H4 other author left out"             1 "$ST"
ST=0; hp_is_held '{"author":{"login":""},"isDraft":false,"autoMergeRequest":null}' "" || ST=$?
assert_status "H5 empty login left out"              1 "$ST"

H_STICKY="$(printf '%s\n' '<!-- pr-ready-verdict -->' 'Fidelity: PASS · auto-merge held' '' \
    'Auto-merge held:' '- (7) auto_merge — plan sets auto_merge: false' \
    '- (8) feat — awaiting human-approved' '' '- (99) trailing — after the block')"
OUT="$(hp_sticky_reasons "$H_STICKY")"
assert_match  "H6 recorded (7)"                      '^\(7\) auto_merge — plan sets auto_merge: false$' "$OUT"
assert_match  "H6 recorded (8)"                      '^\(8\) feat — awaiting human-approved$'           "$OUT"
assert_absent "H6 stops at block end (trailing)"     'trailing'                                         "$OUT"
OUT="$(hp_sticky_reasons "${H_STICKY/Auto-merge held:/**Auto-merge held:**}")"
assert_match  "H6 bold header accepted"              '^\(7\) '                                          "$OUT"

OUT="$(hp_sticky_reasons "$(printf '%s\n' '<!-- pr-ready-verdict -->' 'Auto-merge held:' '- no arming decision recorded')")"
assert_status "H7 no-decision bullet -> no reason"   0 "${#OUT}"
OUT="$(hp_sticky_reasons "$(printf '%s\n' '<!-- pr-ready-verdict -->' 'Fidelity: PASS · auto-merge armed')")"
assert_status "H7 armed banner -> no reason"         0 "${#OUT}"

OUT="$(printf '%s\n%s\n' \
    '[{"body":"plain"},{"body":"<!-- pr-ready-verdict -->\nold"}]' \
    '[{"body":"<!-- pr-ready-verdict -->\nnew"}]' | hp_pick_sticky)"
assert_match  "H8 last marker comment wins"          '^new$' "$OUT"
assert_absent "H8 older marker comment dropped"      'old'   "$OUT"
ST=0; OUT="$(printf '[]' | hp_pick_sticky)" || ST=$?
assert_status "H8 empty page exits 0"                0 "$ST"
assert_status "H8 empty page prints nothing"         0 "${#OUT}"

H_CHECKS="$(checks_json failure success failure | jq -c '(.check_runs[] | select(.name == "E2E Tests")) |= (.status = "in_progress")')"
OUT="$(hp_check_reasons <<< "$H_CHECKS")"
assert_match  "H9 red check named"                   '^red checks: Tests and Analysis \(failure\)$' "$OUT"
assert_match  "H9 pending check named"               '^pending checks: E2E Tests$'                  "$OUT"
assert_absent "H9 human-signoff never listed"        'human-signoff'                                "$OUT"
OUT="$(hp_check_reasons <<< "$(checks_json success success failure)")"
assert_status "H10 sign-off-only failure -> nothing" 0 "${#OUT}"

H_GREEN="$(checks_json success success success)"
OUT="$(hp_live_reasons DIRTY HELD "golden-changed feat-awaiting-signoff" "$H_GREEN")"
assert_match  "H11 DIRTY reason"                     '^merge conflict \(DIRTY\)$'          "$OUT"
assert_match  "H11 manual-testing reason"            '^manual-testing rows unresolved$'    "$OUT"
assert_match  "H11 HOLDS token golden-changed"       '^golden-changed$'                    "$OUT"
assert_match  "H11 HOLDS token feat-awaiting-signoff" '^feat-awaiting-signoff$'            "$OUT"
OUT="$(hp_live_reasons CLEAN CLEARED - "$H_GREEN")"
assert_status "H11 clean PR -> nothing"              0 "${#OUT}"

OUT="$(printf 'a\n\nb\na\n' | hp_dedupe | tr '\n' ',')"
assert_status "H12 dedupe keeps order, drops repeats" 0 "$([ "$OUT" = "a,b," ] && echo 0 || echo 1)"

OUT="$(hp_format_line 5 https://x/5 "fix:  two  spaces" "$(printf 'r1\nr2\nr1')")"
assert_match  "H13 joined line"                      '^#5  https://x/5  fix: two spaces  r1; r2$' "$OUT"
OUT="$(hp_format_line 5 https://x/5 "t" "")"
assert_match  "H13 no reasons -> unknown"            '  unknown$' "$OUT"

# --- H-E1..H-E9: bin/pr-triage --held end to end through the stub gh ---
# held_pr <num> <mss> <author> <isDraft:true|false> <armed:true|false> [title]
held_pr() {
    pr_json "$1" "$2" "$BODY_CLEAR" | jq --arg a "$3" --argjson d "$4" \
        --argjson am "$5" --arg t "${6:-}" '. + {author: {login: $a}, isDraft: $d,
          autoMergeRequest: (if $am then {mergeMethod: "SQUASH"} else null end),
          url: ("https://github.com/a-jay85/IBL5-test/pull/" + (.number|tostring))}
        | if $t != "" then .title = $t else . end'
}

FIX_A="$(mktemp -d -p "$TMP")"
for n in 40 41 42 43 44 45 46 47; do
    checks_json success success success > "$FIX_A/checks-$(printf '%040d' "$n").json"
done
checks_json failure success success > "$FIX_A/checks-$(printf '%040d' 46).json"
checks_json success success success \
    | jq -c '(.check_runs[] | select(.name == "E2E Tests")) |= (.status = "in_progress" | .conclusion = null)' \
    > "$FIX_A/checks-$(printf '%040d' 47).json"
jq -n --arg b "$(printf '%s\n' '<!-- pr-ready-verdict -->' 'Fidelity: PASS · auto-merge held' '' \
    'Auto-merge held:' '- (7) auto_merge — plan sets auto_merge: false' \
    '- (7) auto_merge — plan sets auto_merge: false')" '[{body: $b}]' > "$FIX_A/comments-44.json"
{
    held_pr 40 CLEAN fixture-me false false
    held_pr 41 CLEAN fixture-me false true
    held_pr 42 DRAFT fixture-me true false
    held_pr 43 CLEAN someone-else false false
    held_pr 44 DIRTY fixture-me false false
    held_pr 45 CLEAN fixture-me false false "feat: fixture forty-five"
    held_pr 46 CLEAN fixture-me false false
    held_pr 47 CLEAN fixture-me false false
} | jq -s . > "$FIX_A/prs.json"

run_triage "$FIX_A" --held
assert_match  "H-E1 header"                        '^PR#  URL  TITLE  REASONS$' "$OUT"
assert_absent "H-E1 armed PR left out"             '^#41  '                      "$OUT"
assert_absent "H-E1 draft left out"                '^#42  '                      "$OUT"
assert_absent "H-E1 other author left out"         '^#43  '                      "$OUT"
assert_status "H-E1 exit 0"                        0                             "$ST"
assert_absent "H-E1 ROWS guard satisfied"          'ERROR: reported'             "$OUT"
assert_absent "H-E1 read-only"  'pr merge|update-branch|-X POST|-X PATCH'        "$(cat "$FIX_A/calls.log")"
assert_match  "H-E2 two reasons, recorded first, dup dropped" \
    '^#44  [^ ]+  chore: fixture #44  \(7\) auto_merge — plan sets auto_merge: false; merge conflict \(DIRTY\)$' "$OUT"
# Mutation check: swapping ${out:-unknown} for ${out:--} in hp_format_line makes this line end "  -".
assert_match  "H-E3 unknown"                      '^#40  https://github.com/a-jay85/IBL5-test/pull/40  chore: fixture #40  unknown$' "$OUT"
assert_match  "H-E4 feat awaiting sign-off"        '^#45  .*  feat-awaiting-signoff$'                      "$OUT"
assert_match  "H-E4 red check"                     '^#46  .*  red checks: Tests and Analysis \(failure\)$' "$OUT"
assert_match  "H-E4 pending check"                 '^#47  .*  pending checks: E2E Tests$'                  "$OUT"

# H-E9: default mode still lists the armed PR and prints the old header.
run_triage "$FIX_A"
assert_match  "H-E9 default mode lists #41"        '^#41 '                           "$OUT"
assert_absent "H-E9 default mode has no held header" '^PR#  URL  TITLE  REASONS$'     "$OUT"

# H-E5: --held and --arm are exclusive, rejected before any gh call.
FIX="$(mktemp -d -p "$TMP")"
run_triage "$FIX" --held --arm
assert_status "H-E5 --held --arm exit 2"           2                    "$ST"
assert_match  "H-E5 --held --arm says why"         'mutually exclusive' "$OUT"
assert_absent "H-E5 --held --arm no gh pr list"    'pr list'            "$(cat "$FIX/calls.log" 2>/dev/null)"
run_triage "$FIX" --arm --held
assert_status "H-E5 --arm --held exit 2"           2                    "$ST"
assert_match  "H-E5 --arm --held says why"         'mutually exclusive' "$OUT"
assert_absent "H-E5 --arm --held no gh pr list"    'pr list'            "$(cat "$FIX/calls.log" 2>/dev/null)"

# H-E6: --held=yes is an unknown flag.
FIX="$(mktemp -d -p "$TMP")"
run_triage "$FIX" --held=yes
assert_status "H-E6 --held=yes exit 2"             2                              "$ST"
assert_match  "H-E6 --held=yes unknown flag"       'unknown flag: --held=yes'     "$OUT"

# H-E7: an unresolved viewer login fails closed instead of listing nothing.
FIX="$(mktemp -d -p "$TMP")"
cp "$FIX_A/prs.json" "$FIX/prs.json"
echo '{}' > "$FIX/viewer.json"
run_triage "$FIX" --held
assert_status "H-E7 no login exit 2"               2                                  "$ST"
assert_match  "H-E7 no login says why"             'cannot resolve your GitHub login' "$OUT"
assert_absent "H-E7 no login lists nothing"        '^#40  '                           "$OUT"

# H-E8: --help documents the flag.
ST=0; OUT="$("$TRIAGE" --help 2>&1)" || ST=$?
assert_match  "H-E8 --help mentions --held"        '[-][-]held'                                      "$OUT"
assert_match  "H-E8 --help mentions the exclusion" 'Read-only; cannot be combined' "$OUT"

[ "$FAILED" = 0 ] && exit 0 || exit 1
