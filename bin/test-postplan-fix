for tok in "HOLDREPEAT_FIX: fixed" "HOLDREPEAT_FIX: needs-gate-edit" "HOLDREPEAT_FIX: blocked" \
    "HOLDREPEAT_FIX: nothing-to-fix" "LAST line of the final message"; do
    need "prompt has '$tok'" has_s "$STDOUT" "$tok"
done
case_end holdrepeat-dry-run-prompt
fi

