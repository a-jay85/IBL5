#!/bin/bash
# IBLbot pm2 watchdog. Redirects all output to the IBLbot healthcheck log so
# cron never sends email. Connection-refused errors are transient (pm2 restarted);
# pm2 start/save output is informational. Neither warrants a notification.
set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
Usage: bin/iblbot-healthcheck

IBLbot pm2 watchdog. If IBLbot is not responding on port 50000, restarts it
via pm2. All output is redirected to the healthcheck log.
Intended for cron use — not for interactive invocation.

Arguments: none
EOF
    exit 0
fi

LOG=/home/iblhoops/.pm2/iblbot-healthcheck.log
IBLBOT=/home/iblhoops/public_html/ibl5/IBLbot
export NVM_DIR=/home/iblhoops/.nvm

exec >> "$LOG" 2>&1

if ! curl -fsS --max-time 5 -o /dev/null http://127.0.0.1:50000/; then
    # Use nvm's default Node rather than a pinned version path. A hardcoded
    # v22.7.0 path kept the bot on a Node build that mis-encodes non-ASCII
    # text once warm, which broke every trade DM until the next restart.
    set +u
    # shellcheck source=/dev/null
    . "$NVM_DIR/nvm.sh"
    nvm use --silent default
    set -u
    cd "$IBLBOT"
    pm2 start ecosystem.config.cjs --update-env
    pm2 save
fi
