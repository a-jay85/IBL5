    new_case
    green_plan
    run_gate --plan "$PLAN"; want_rc 0
    printf 'b\n' >> "$R/ibl5/tracked.txt"
    run_gate --plan "$PLAN"; want_rc 0
    want_cnt phpunit 2
}

test_checks_mutating_tree_refuse() {
    new_case
    green_plan
    printf '#!/usr/bin/env bash\necho run >> "$CNT/phpunit"\necho gen > ../generated.txt\nexit 0\n' > "$D/stubs/phpunit-mut"
    chmod +x "$D/stubs/phpunit-mut"
    export PREFIRE_PHPUNIT_CMD="$D/stubs/phpunit-mut"
    run_gate --plan "$PLAN"
    want_rc 4
    want_out "changed the working tree"
    [ -z "$(pass_files '\.phpunit\.pass$')" ] || note "a phpunit pass record exists"
}

test_adhoc_no_plan_runs_phpunit_only() {
    # A stray `${PREFIRE_MUTATION_CMD:-true}` call would run the exported env stub
    # and bump the mutation counter, so want_cnt mutation 0 catches it.
    new_case
    run_gate
    want_rc 0
    want_out "SKIP matrix: no plan"
    want_out "SKIP exec-mutations: no plan"
    want_cnt phpunit 1
    want_cnt mutation 0
    want_cnt excludes 0
}

