bpt_log_has   "$STUB" tick.out "observed_before=38" "r50: the rejection logs the observed value"
bpt_count     "r50: never ships — post-plan-now not fired" 0 "$STUB/post-plan-now.log"
bpt_log_lacks "$STUB" transition.log "pr_open" "r50: an unreproduced fix never reaches pr_open"
bpt_log_has   "$STUB" transition.log "transition 7 needs_human --release-lease" "r50: climbs the ladder, then hands to a human"

# ── Row 51 — pass-through: no evidence fields at all → 'fixed' still ships ──
