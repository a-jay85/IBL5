grep -qF '**Other held (40)**' "$SCRATCH/dm.argv" \
    || fail "your-turn grouped cap: header lost the full count: $(cat "$SCRATCH/dm.argv")"
grep -qF -- '- …and ' "$SCRATCH/dm.argv" || fail "your-turn grouped cap: no truncation line"
_blk="$(sed -n 's/.*\(Your turn:.*\)/\1/p' "$SCRATCH/dm.argv")"
# Row cap is 1700 chars (the plan said 1800; case 38's 2000-char DM limit needs the lower cap).
[[ "${#_blk}" -le 2000 ]] || fail "your-turn grouped cap: your-turn block is ${#_blk} chars, want <= 2000"
end_case "your-turn grouped cap"

