argv_exists && note_err "bad MIN_INTERVAL: swept"
fresh
mkdir -p "$CD/state"
printf 'garbage\n' > "$CD/state/last-sweep"
run_tick --
chk_rc "garbage stamp" 0
argv_exists || note_err "garbage stamp: did not sweep"
finish_case
fi

