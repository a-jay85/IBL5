# Dependabot dev-dependency patch exemption (ADR-0062 Update 2026-11-13).
# dp_write <root> writes <root>/ibl5/package.json and <root>/ibl5/bun.lock in
# the real files' line shapes. A DP_* variable set on the call changes one field.
DP="$UI_TMP/dp"
DP_SHA_A="$(printf 'A%.0s' {1..86})=="
DP_SHA_B="$(printf 'B%.0s' {1..86})=="
BOT='dependabot[bot]'
dp_write() {
    local runtime="" extra_dev="" nested="" extra_lock="" nl=$'\n'
    if [ -n "${DP_ZOD:-}" ]; then runtime="  \"dependencies\": {${nl}    \"zod\": \"$DP_ZOD\"${nl}  },${nl}"; fi
    if [ -n "${DP_EXTRA_DEV:-}" ]; then extra_dev="    $DP_EXTRA_DEV${nl}"; fi
    if [ "${DP_L_NESTED:-1}" = 1 ]; then
        nested="    \"@typescript-eslint/typescript-estree/minimatch\": [\"minimatch@9.0.5\", \"\", { \"dependencies\": { \"brace-expansion\": \"^2.0.1\" } }, \"sha512-$DP_SHA_A\"],${nl}"
    fi
    if [ -n "${DP_L_EXTRA:-}" ]; then extra_lock="    $DP_L_EXTRA${nl}"; fi
    mkdir -p "$1/ibl5"
    cat > "$1/ibl5/package.json" <<DPEOF
{
  "//pin": "@playwright/test stays an exact pin: bin/playwright-image-tag reads it.",
  "name": "ibl5-design",
  "version": "1.0.0",
  "type": "module",
  "description": "human-signoff dev-patch fixture",
  "scripts": {
    "build": "${DP_BUILD:-tailwindcss -i in.css -o out.css}"
  },
${runtime}  "devDependencies": {
${extra_dev}    "@playwright/test": "${DP_PW:-1.65.0}",
    "@tailwindcss/cli": "${DP_TW:-^4.3.5}",
    "daisyui": "${DP_DAISY:-5}",
    "pixelmatch": "${DP_PIX:-^8.0.0}",
    "typescript": "${DP_TS:-5.9.2}"
  },
  "overrides": {
    "minimatch": "${DP_MM:-9.0.5}"
  }
}
DPEOF
    cat > "$1/ibl5/bun.lock" <<DPEOF
{
  "lockfileVersion": ${DP_L_VER:-1},
  "configVersion": 1,
  "workspaces": {
    "": {
      "name": "ibl5-design",
      "devDependencies": {
        "@playwright/test": "${DP_PW:-1.65.0}",
        "@tailwindcss/cli": "${DP_L_TW_WS:-${DP_TW:-^4.3.5}}",
        "daisyui": "${DP_DAISY:-5}",
        "pixelmatch": "${DP_PIX:-^8.0.0}",
        "typescript": "${DP_TS:-5.9.2}",
      },
    },
  },
  "overrides": {
    "minimatch": "${DP_L_MM:-${DP_MM:-9.0.5}}",
  },
  "packages": {
    "@playwright/test": ["@playwright/test@${DP_L_PW:-1.65.0}", "", { "dependencies": { "playwright": "${DP_L_PW:-1.65.0}" }, "bin": { "playwright": "cli.js" } }, "sha512-${DP_L_PW_SHA:-$DP_SHA_A}"],
    "@tailwindcss/cli": ["@tailwindcss/cli@${DP_L_TW:-4.3.5}", "", { "dependencies": { "tailwindcss": "${DP_L_TW:-4.3.5}" }, "bin": { "tailwindcss": "dist/index.mjs" } }, "sha512-${DP_L_TW_SHA:-$DP_SHA_A}"],
${nested}    "daisyui": ["daisyui@5.5.19", "", {}, "sha512-$DP_SHA_A"],
    "pixelmatch": ["pixelmatch@${DP_L_PIX:-8.0.0}", "", { "dependencies": { "pngjs": "^7.0.0" }, "bin": { "pixelmatch": "bin/pixelmatch" } }, "sha512-${DP_L_PIX_SHA:-$DP_SHA_A}"],
    "playwright-core": ["playwright-core@${DP_L_PWC:-1.65.0}", "", { "bin": { "playwright-core": "cli.js" } }, "sha512-${DP_L_PWC_SHA:-$DP_SHA_A}"],
    "pngjs": ["pngjs@7.0.0", "", {}, "sha512-$DP_SHA_A"],
    "tailwindcss": ["${DP_L_TWCSS_NAME:-tailwindcss}@${DP_L_TW:-4.3.5}", "", {}, "sha512-${DP_L_TW_SHA:-$DP_SHA_A}"],
    "typescript": ["typescript@${DP_L_TS:-5.9.2}", "", { "bin": { "tsc": "bin/tsc", "tsserver": "bin/tsserver" } }, "sha512-${DP_L_TS_SHA:-$DP_SHA_A}"],
${extra_lock}  }
}
DPEOF
}
dp_reset() { rm -rf "$DP"; dp_write "$DP/base"; }
# The #3920 shape: one devDependencies patch bump in package.json; in the lock,
# the workspace line, the package entry, a transitive entry, and a removed
# nested override entry.
dp_head_3920() { DP_TW='^4.3.6' DP_L_TW=4.3.6 DP_L_TW_SHA="$DP_SHA_B" DP_L_NESTED=0 dp_write "$DP/head"; }
# dp_verdict_is <name> <want> <author> <action> <event_label> <path>...
# Runs ui_workflow_verdict on $DP/base vs $DP/head. The stub fetch returns
# DP_GALLERY_FILE (default: the clean gallery) on the first poll.
dp_verdict_is() {
    local name="$1" want_v="$2" author="$3" action="$4" label="$5" pf out
    shift 5
    pf="$UI_TMP/dp-paths-$name.txt"
    printf '%s\n' "$@" > "$pf"
    if cmp -s "$DP/base/ibl5/package.json" "$DP/head/ibl5/package.json" \
        && cmp -s "$DP/base/ibl5/bun.lock" "$DP/head/ibl5/bun.lock"; then
        h_fail "$name" "fixture head equals base"; return 0
    fi
    # shellcheck disable=SC2016  # $1.. expand inside the child bash
    out=$(UI_BASE_DIR="${DP_BASE_DIR-$DP/base}" UI_HEAD_DIR="$DP/head" \
        DP_GALLERY="${DP_GALLERY_FILE:-$UI_TMP/g-clean.json}" UI_VR_ATTEMPTS=1 UI_VR_SLEEP=0 bash -c \
        'set -euo pipefail; source "$1"; dp_fetch() { cp "$DP_GALLERY" "$1"; }; ui_workflow_verdict "$2" "$3" dp_fetch "$4" "$5" || true' \
        _ "$UI_LIB" "$pf" "$author" "$action" "$label" 2>/dev/null)
    same "$name" "$out" "$want_v"
}

