    want_rc 2
    want_out "--stage infection was removed"
    want_out "Infection PHP (per-PR diff)"
    want_cnt phpunit 0
    want_cnt mutation 0
    want_cnt excludes 0
}

test_all_never_invokes_infection() {
    new_case
    green_plan
    mkdir -p "$R/bin" "$R/ibl5/bin"
    printf '#!/usr/bin/env bash\ntouch "%s/mutation-diff-called"\nexit 99\n' "$D" > "$R/bin/mutation-diff"
    printf '#!/usr/bin/env bash\ntouch "%s/excludes-called"\nexit 99\n' "$D" > "$R/ibl5/bin/check-infection-excludes"
    chmod +x "$R/bin/mutation-diff" "$R/ibl5/bin/check-infection-excludes"
    run_gate --plan "$PLAN"
    want_rc 0
    want_out "all requested stages passed (matrix phpunit exec-mutations)"
    want_cnt mutation 0
    want_cnt excludes 0
    [ ! -e "$D/mutation-diff-called" ] || note "bin/mutation-diff ran under --stage all"
    [ ! -e "$D/excludes-called" ] || note "check-infection-excludes ran under --stage all"
}

test_mutation_diff_flags_match_ci() {
    new_case
    local wf="$REPO/.github/workflows/mutation-pr.yml" md="$REPO/bin/mutation-diff"
    local flags f n=0 re
    re='^--(min-msi|min-covered-msi|ignore-msi|git-diff-lines|only-covering|map-source|skip-initial|configuration=infection)'
    flags=$(awk '/vendor\/bin\/infection/ {on=1} on {print} on && !/\\[[:space:]]*$/ {exit}' "$wf" \
        | tr -s ' \\' '\n\n' | command grep -E -- "$re" || true)
    for f in $flags; do
        n=$((n + 1))
        grep -qF -- "$f" "$md" || note "CI flag $f missing from bin/mutation-diff"
    done
    [ "$n" -ge 5 ] || note "extracted only $n CI flags; parsing broke"
}

# ---------------------------------------------------------------------------
# post-plan-now cases (matrix rows 22-29)
# ---------------------------------------------------------------------------
# Builds MAIN (with origin) and a worktree WT on branch feat-x holding an
# untracked file, so post-plan-now passes its nothing-to-ship check.
new_ppn_case() {
    new_case
    local origin="$D/origin.git"
    MAIN="$D/IBL5"
    WT="$D/IBL5-worktrees/feat-x"
    mkdir -p "$D/home"
    git init -q --bare -b master "$origin"
    mkdir -p "$MAIN/bin/lib" "$MAIN/ibl5/vendor/bin"
    (
        cd "$MAIN" || exit 1
        git init -q -b master
        git config user.email t@example.com
        git config user.name Test
        git remote add origin "file://$origin"
        cp "$REPO/bin/lib/git-helpers.sh" bin/lib/git-helpers.sh
        cp "$R/ibl5/vendor/bin/phpunit" ibl5/vendor/bin/phpunit
        printf 'a\n' > ibl5/tracked.txt
        git add -A
        git commit -q -m init
        git push -q origin master
        git fetch -q origin
        git worktree add -q -b feat-x "$WT" master
    ) || { echo "HARNESS-SETUP: ppn fixture failed" >&2; exit 2; }
    git -C "$WT" config branch.feat-x.iblBase master
    printf 'new\n' > "$WT/NewTest.php"
    R="$WT"   # the gate state helpers now point at the worktree
    PLAN="$D/plan.md"
    rm -f "$D"/runlog.* 2>/dev/null || true
    rm -f "$POSTPLAN_LOG_DIR"/post-plan-now-feat-x-*.log 2>/dev/null || true
}

run_ppn() { # extra post-plan-now args; PPN_GATE overrides the gate path
    OUT=$(cd "$WT" && \
        BRANCH_BASE_OFFLINE=1 HOME="$D/home" \
        POST_PLAN_MAIN_ROOT="$MAIN" POST_PLAN_SELF_BIN="$MAIN/bin" \
        PREFIRE_VERIFY_SCRIPT="${PPN_GATE:-$GATE}" \
        "$PPN" "$@" 2>&1); RC=$?
}
fired() { ls "$POSTPLAN_LOG_DIR"/post-plan-now-feat-x-*.log >/dev/null 2>&1; }

test_post_plan_now_refuses_exit_9_on_gate_failure() {
    new_ppn_case
    write_plan "$(row 1 'exit 7')"
    run_ppn --plan "$PLAN"
    want_rc 9
    want_out "pre-fire verification refused"
    ! fired || note "post-plan-now launched despite a red gate"
}

test_post_plan_now_fires_when_gate_green() {
    new_ppn_case
    green_plan
    run_ppn --plan "$PLAN"
    refute_out "pre-fire verification refused"
    fired || note "no runner log; post-plan-now did not get past the gate"
}

test_post_plan_now_adhoc_no_plan_skips_matrix_only() {
    new_ppn_case
    run_ppn
    want_out "SKIP matrix: no plan"
    want_cnt phpunit 1
    refute_out "pre-fire verification refused"
}

test_bypass_logs_line_and_fires() {
    new_ppn_case
    write_plan "$(row 1 'exit 7')"
    local log="$MAIN/.git/prefire-verify-bypass.log" n
    run_ppn --plan "$PLAN" "--skip-verify=fixture bypass reason ok"
    [ "$RC" -ne 9 ] || note "exit 9; the bypass did not fire"
    if [ -f "$log" ]; then
        n=$(wc -l < "$log" | tr -d ' ')
        [ "$n" -eq 1 ] || note "bypass log has $n lines, expected 1"
        grep -qF -- "fixture bypass reason ok" "$log" || note "bypass log lacks the reason"
    else
        note "no bypass log at $log"
    fi
    want_cnt phpunit 0
}

test_bypass_refused_under_headless() {
    new_ppn_case
    write_plan "$(row 1 true)"
    local log="$MAIN/.git/prefire-verify-bypass.log"
    CLAUDE_HEADLESS=1 run_ppn --plan "$PLAN" "--skip-verify=fixture bypass reason ok"
    want_rc 9
    want_out "refused under CLAUDE_HEADLESS"
    [ ! -f "$log" ] || note "bypass log was written under headless"
}

test_bypass_short_reason_rejected() {
    new_ppn_case
    write_plan "$(row 1 true)"
    run_ppn --plan "$PLAN" "--skip-verify=short"
    want_rc 9
    want_out "at least 15 characters"
}

test_rebase_only_skips_gate() {
    new_ppn_case
    write_plan "$(row 1 'exit 7')"
    run_ppn --plan "$PLAN" --rebase-only
    refute_out "pre-fire verification refused"
    want_cnt phpunit 0
}

test_missing_gate_script_refuses() {
    new_ppn_case
    green_plan
    PPN_GATE="$D/no-such-gate" run_ppn --plan "$PLAN"
    want_rc 10
    want_out "pre-fire gate"
    ! fired || note "post-plan-now launched with no gate script"
}

test_gate_environment_failure_exits_10() {
    new_ppn_case
    green_plan
    mkdir -p "$D/stubs"
    printf '#!/bin/sh\nexit 3\n' > "$D/stubs/gate3"
    chmod +x "$D/stubs/gate3"
    PPN_GATE="$D/stubs/gate3" run_ppn --plan "$PLAN"
    want_rc 10
    want_out "could not run (environment)"
    refute_out "pre-fire verification refused"
    ! fired || note "post-plan-now launched when the gate could not run"
}

assert_step_6_9() { # <prompt-impl path>
    local f="$1" l69 l68 l7 body
    l69=$(grep -nF -- '## Step 6.9: Pre-Fire Verification Gate' "$f" | head -n 1 | cut -d: -f1)
    if [ -z "$l69" ]; then
        note "no Step 6.9 heading"
        return 0
    fi
    l68=$(grep -nF -- '## Step 6.8:' "$f" | head -n 1 | cut -d: -f1)
    l7=$(grep -nF -- '## Step 7: Write Handoff File' "$f" | head -n 1 | cut -d: -f1)
    [ -n "$l68" ] || note "no Step 6.8 heading"
    [ -n "$l7" ] || note "no Step 7 heading"
    [ -n "$l68" ] && [ "$l69" -gt "$l68" ] || note "Step 6.9 is not after Step 6.8"
    [ -n "$l7" ] && [ "$l69" -lt "$l7" ] || note "Step 6.9 is not before Step 7"
    if [ -n "$l7" ] && [ "$l69" -lt "$l7" ]; then
        body=$(sed -n "${l69},$((l7 - 1))p" "$f")
        local s
        for s in "--stage matrix" "--stage phpunit" "--stage exec-mutations"; do
            grep -qF -- "$s" <<< "$body" || note "Step 6.9 does not name '$s'"
        done
        grep -qF -- "--stage infection" <<< "$body" && note "Step 6.9 still names '--stage infection'"
    fi
}

test_prompt_impl_step_6_9_precedes_step_7() {
    assert_step_6_9 "$REPO/bin/automouse/prompt-impl"
}

test_prompt_impl_missing_step_6_9_heading_fails() {
    local fixture="$TMP/prompt-impl-no-6-9"
    grep -vF -- '## Step 6.9: Pre-Fire Verification Gate' \
        "$REPO/bin/automouse/prompt-impl" > "$fixture"
    assert_step_6_9 "$fixture"
    if [ "$WHY" = "no Step 6.9 heading" ]; then
        WHY=""
    else
        WHY="a missing heading must fail, got: '${WHY}'"
    fi
}

# Runs each Step 6.9 bash block in its own shell, as the impl agent's Bash calls
# do, against a stub gate. Every block must reach the gate with the resolved plan.
assert_step_6_9_blocks_set_plan_path() { # <prompt-impl path>
    local f="$1" home="$D/home" slug="my-plan" q want i stage got
    q="$home/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/automouse/queue"
    mkdir -p "$q" "$R/bin/lib" "$D/blocks"
    printf '# plan\n' > "$D/real-plan.md"
    ln -s "$D/real-plan.md" "$q/010-$slug.md"
    want="$(cd "$D" && pwd -P)/real-plan.md"
    # shellcheck disable=SC2016  # the stub expands $CNT and $* when it runs
    printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >> "$CNT/gate-args"\n' \
        > "$R/bin/lib/prefire-verify"
    chmod +x "$R/bin/lib/prefire-verify"
    awk -v dir="$D/blocks" '
        /^## Step 6\.9:/ { s = 1; next }
        /^## Step 7:/ { s = 0 }
        s && /^```bash$/ { n++; out = dir "/" n ".sh"; b = 1; next }
        b && /^```$/ { b = 0; close(out); next }
        b { print > out }
    ' "$f"
    i=0
    for stage in matrix phpunit exec-mutations; do
        i=$((i + 1))
        if [ ! -f "$D/blocks/$i.sh" ]; then
            note "Step 6.9 has no bash block for $stage"
            continue
        fi
        sed -e "s|<the PLAN_FILE value from the end of this prompt>|$slug|" \
            -e "s|/Users/ajaynicolas/GitHub/IBL5/bin/lib/|$REPO/bin/lib/|" \
            "$D/blocks/$i.sh" > "$D/blocks/$i.run"
        : > "$CNT/gate-args"
        (cd "$R" && env -u PLAN_PATH HOME="$home" bash "$D/blocks/$i.run") >/dev/null 2>&1
        got=$(cat "$CNT/gate-args")
        [ "$got" = "--plan $want --stage $stage" ] \
            || note "$stage block called the gate with '$got'"
    done
    [ ! -f "$D/blocks/4.sh" ] || note "Step 6.9 has a fourth bash block"
}

test_prompt_impl_step_6_9_blocks_set_plan_path() {
    new_case
    assert_step_6_9_blocks_set_plan_path "$REPO/bin/automouse/prompt-impl"
}

test_prompt_impl_block_without_plan_path_fails() {
    new_case
    local fixture="$D/prompt-impl-unset"
    # Drop the setter from the second Step 6.9 block only.
    awk '
        /^## Step 6\.9:/ { s = 1 }
        /^## Step 7:/ { s = 0 }
        s && /^```bash$/ { n++ }
        s && n == 2 && /PLAN_PATH=/ { next }
        { print }
    ' "$REPO/bin/automouse/prompt-impl" > "$fixture"
    assert_step_6_9_blocks_set_plan_path "$fixture"
    case "$WHY" in
        "phpunit block called the gate with '--plan  --stage phpunit'") WHY="" ;;
        *) WHY="a block with no PLAN_PATH must fail, got: '${WHY}'" ;;
    esac
}

test_stdin_reading_row_does_not_swallow_later_rows() {
    new_case
    write_plan "$(row 1 'cat > /dev/null')" \
               "$(row 2 "echo x >> $CNT/row2; exit 7")"
    run_gate --plan "$PLAN"
    want_rc 1
    want_out "FAIL matrix row 2 exited 7"
    want_cnt row2 1
    [ -z "$(pass_files '\.matrix\..*\.pass$')" ] || note "a matrix pass record exists"
}

test_db_probe_does_not_read_callers_stdin() {
    new_case
    write_plan "$(row 1 "echo x >> $CNT/row1; bin/db-query 'SELECT 1'")"
    # The probe fails if it can read a line, so an inherited stdin refuses.
    local saved="${PREFIRE_DB_PROBE_CMD:-}"
    export PREFIRE_DB_PROBE_CMD='! read -r _line'
    run_gate --plan "$PLAN" <<< "caller stdin"
    refute_out "DB unreachable"
    export PREFIRE_DB_PROBE_CMD="$saved"
}

# ---------------------------------------------------------------------------
# exec-mutations stage (third stage)
# ---------------------------------------------------------------------------
# xm_plan <check> [match] [replace]: plan with matrix row 1 = <check> plus one mutation block
# on ibl5/tracked.txt (fixture content "a"). The check counts its own runs in $CNT/xm.
xm_plan() {
    local chk="echo run >> \"\$CNT/xm\"; $1"
    write_plan "$(row 1 "${chk//|/\\|}")"
    {
        printf '\n## Executable Mutations\n\n'
        printf '%smutation\nrow: 1\nfile: ibl5/tracked.txt\ncheck: %s\n' '```' "$chk"
        printf 'match: %s\nreplace: %s\n%s\n' "${2:-a}" "${3:-b}" '```'
    } >> "$PLAN"
}
xm_journal_empty() { [ -z "$(ls -A "$(git -C "$R" rev-parse --absolute-git-dir)/exec-mutations" 2>/dev/null)" ]; }
xm_tracked() { tr -d '\n' < "$R/ibl5/tracked.txt"; }
xm_passes() { pass_files '\.exec-mutations\..*\.pass$'; }

test_xm_tripped_passes_and_records() {
    new_case
    xm_plan 'grep -qx a ibl5/tracked.txt'
    run_gate --plan "$PLAN" --stage exec-mutations
    want_rc 0
    want_out "TRIPPED row 1"
    want_out "exec-mutations passed"
    local want_name
    want_name="$(tree_hash).exec-mutations.$(git hash-object "$PLAN").pass"
    [ "$(xm_passes)" = "$want_name" ] || note "pass record is '$(xm_passes)', wanted $want_name"
    [ "$(xm_tracked)" = a ] || note "tracked.txt is '$(xm_tracked)', not a"
    xm_journal_empty || note "journal not empty"
    want_cnt xm 2
}

test_xm_held_fails_without_record() {
    new_case
    xm_plan 'true'
    run_gate --plan "$PLAN" --stage exec-mutations
    want_rc 1
    want_out "HELD row 1"
    want_out "NEXT-STEP row 1 — the check passed under mutation; strengthen the test"
    want_out "Never edit a row's check command"
    [ -z "$(xm_passes)" ] || note "an exec-mutations pass record exists"
}

test_xm_baseline_failed_fails() {
