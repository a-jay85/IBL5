fi

# 58 (--holdrepeat --dry-run is inert: no fetch, so an unreachable origin and a dirty tree
# do not change the result, and no temp dir is made)
if should_run "holdrepeat-dry-run-inert"; then
hr_reset
printf 'x\n' > "$WTH/untracked.txt"
HR_URL=$(git -C "$MAIN" remote get-url origin)
git -C "$MAIN" remote set-url origin "$TMP/no-such-origin.git"
mkdir -p "$TMP/dryrun-tmp"
( export TMPDIR="$TMP/dryrun-tmp"; run_fix "$SUT" --holdrepeat --dry-run 77; printf '%s\n%s\n' "$RC" "$STDOUT" > "$TMP/dry.out" )
git -C "$MAIN" remote set-url origin "$HR_URL"
rm -f "$WTH/untracked.txt"
HR_DRY_RC=$(sed -n 1p "$TMP/dry.out"); HR_DRY_OUT=$(sed -n '2,$p' "$TMP/dry.out")
need "rc 0" test "$HR_DRY_RC" = 0
need "final line" final_is "$HR_DRY_OUT" dry-run
need "prompt printed" has_s "$HR_DRY_OUT" "HOLDREPEAT_FIX: fixed"
need "no temp dir made" test -z "$(ls -A "$TMP/dryrun-tmp")"
need "no claude call" no_args
case_end holdrepeat-dry-run-inert
fi

# 58b (a guard reject on a real run prints exactly one result line, keeps rc 21 and removes
# its temp dir: the EXIT trap must not add a second line, change the rc, or skip cleanup)
if should_run "holdrepeat-normal-exit-single-result"; then
hr_reset
mkdir -p "$TMP/hrtmp"
export CLAUDE_STUB_REPLY="$TMP/reply-hr-blocked" CLAUDE_STUB_EFFECT="$TMP/effects/hr-title.sh"
TMPDIR="$TMP/hrtmp" hr_run
need "rc 21" test "$RC" = 21
need "final line" final_is "$STDOUT" gave-up-pr-state
need "exactly one result line" test "$(grep -c 'postplan-fix: holdrepeat result=' <<< "$STDOUT")" = 1
need "temp dir removed" test -z "$(find "$TMP/hrtmp" -name 'postplan-fix-hr.*' -print)"
case_end holdrepeat-normal-exit-single-result
fi

# 58c (a set -e failure inside --holdrepeat still ends with a result line: mktemp -d fails
# under a TMPDIR that does not exist, after eligibility and before any session)
if should_run "holdrepeat-unexpected-exit-prints-result"; then
hr_reset
TMPDIR="$TMP/no-such-tmpdir" hr_run
need "rc 1" test "$RC" = 1
need "dm line before result" line_re "$STDOUT" '^postplan-fix: holdrepeat dm=none$'
need "final line" final_is "$STDOUT" error
need "exactly one result line" test "$(grep -c 'postplan-fix: holdrepeat result=' <<< "$STDOUT")" = 1
need "stderr names the unexpected stop" line_re "$ERR" 'stopped unexpectedly \(rc [1-9][0-9]*\)'
need "no session launched" test ! -e "$TMP/claude.argc"
case_end holdrepeat-unexpected-exit-prints-result
fi
hr_reset

check_only_cases
h_done
