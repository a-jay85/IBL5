#!/usr/bin/env bash
# test-pr-ready-now — generation-slice tests for bin/pr-ready-now.
#
# Covers everything up to and including artifact generation: flag validation, the
# open/non-draft selector, per-PR path uniqueness, plist shape, the env seams, and the
# concurrency cap. It never bootstraps a launchd job and never touches a real PR, so it
# runs identically on macOS and Linux CI — there is deliberately no platform skip.
#
# Driven entirely through bin/pr-ready-now's documented env seams plus a scratch HOME,
# so no state outside the scratch dir is read or written.
#
# Usage: bin/test-pr-ready-now

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
DRIVER="$SCRIPT_DIR/pr-ready-now"
[[ -x "$DRIVER" ]] || { echo "FAIL: $DRIVER missing or not executable" >&2; exit 1; }

SCRATCH="$(mktemp -d)"
TMP_LOGS=()
_cleanup() { rm -rf "$SCRATCH"; [[ ${#TMP_LOGS[@]} -gt 0 ]] && rm -f "${TMP_LOGS[@]}"; }
trap _cleanup EXIT

FAILED=0
CASE_BASE=0
fail() { echo "FAIL: $*" >&2; FAILED=$((FAILED + 1)); }
begin_case() { CASE_BASE=$FAILED; }
end_case() {  # $1 = case name; prints "<name> OK" only if the case added no failures
    if [[ $FAILED -eq $CASE_BASE ]]; then echo "$1 OK"; else echo "$1 FAILED" >&2; fi
}

# --- fixtures ----------------------------------------------------------------------------
mkdir -p "$SCRATCH/.local/bin" "$SCRATCH/.bun/bin"

# Stub claude. /bin/true is not portable (macOS ships /usr/bin/true), so make our own.
printf '#!/usr/bin/env bash\nexit 0\n' > "$SCRATCH/.local/bin/claude-stub"
chmod +x "$SCRATCH/.local/bin/claude-stub"
CLAUDE_STUB="$SCRATCH/.local/bin/claude-stub"

# Worktree listing fixture. The driver's pre-flight check greps this for "[<branch>]";
# without it the check falls back to the REAL `git worktree list`, where none of the
# fixture branches exist, and every fixture PR would skip as "no worktree".
# Format mirrors `git worktree list`: <path>  <sha> [<branch>]. Note the branch name is
# NOT the last path segment -- that is exactly what the -qF "[$b]" form exists to handle.
WTL_FIXTURE="$SCRATCH/wtl.txt"
cat > "$WTL_FIXTURE" <<EOF
/Users/x/GitHub/IBL5                                  1111111 [master]
/Users/x/GitHub/IBL5-worktrees/first-slug/ibl5        2222222 [branch-one]
/Users/x/GitHub/IBL5-worktrees/second-slug/ibl5       3333333 [branch-two]
/Users/x/GitHub/IBL5-worktrees/live-slug/ibl5         4444444 [branch-live]
EOF

cat > "$SCRATCH/two-open.json" <<'JSON'
[
  {"number": 1901, "title": "first",  "isDraft": false, "headRefName": "branch-one", "author": {"login": "a-jay85"}},
  {"number": 1902, "title": "second", "isDraft": false, "headRefName": "branch-two", "author": {"login": "a-jay85"}}
]
JSON

cat > "$SCRATCH/one-draft.json" <<'JSON'
[
  {"number": 1903, "title": "draft",     "isDraft": true,  "headRefName": "branch-draft", "author": {"login": "a-jay85"}},
  {"number": 1904, "title": "not-draft", "isDraft": false, "headRefName": "branch-live",  "author": {"login": "a-jay85"}}
]
JSON

# gh shim, installed where bin/pr-ready-now's PATH prelude will find it ahead of any
# system gh on CI. Only `gh pr list` needs to work here; identity goes through the
# PR_READY_NOW_GH_USER seam.
cat > "$SCRATCH/.local/bin/gh" <<GH_EOF
#!/usr/bin/env bash
if [[ "\${1:-}" == "pr" && "\${2:-}" == "list" ]]; then
    cat "$SCRATCH/two-open.json"
    exit 0
fi
echo "gh shim: unexpected args: \$*" >&2
exit 1
GH_EOF
chmod +x "$SCRATCH/.local/bin/gh"
cp "$SCRATCH/.local/bin/gh" "$SCRATCH/.bun/bin/gh"

# launchctl shim — makes the "already running" skip testable, and testable on Linux CI
# where launchctl does not exist at all. `launchctl list` echoes whatever the current
# case wrote to launchctl-list.txt; everything else is a no-op.
#
# The trailing filler is load-bearing, not padding. The bug case 9 guards is a SIGPIPE
# under `set -o pipefail`, which only reproduces when the writer still has queued output
# after the reader exits. Real `launchctl list` prints hundreds of lines; a three-line
# shim would finish writing before grep -q exited and the buggy code would pass. The
# filler follows the fixture labels so a match always leaves bytes unwritten, and it
# exceeds the 64KB pipe buffer so the writer cannot dump-and-exit.
: > "$SCRATCH/launchctl-list.txt"
cat > "$SCRATCH/.local/bin/launchctl" <<LC_EOF
#!/usr/bin/env bash
if [[ "\${1:-}" == "list" && \$# -eq 1 ]]; then
    cat "$SCRATCH/launchctl-list.txt"
    i=0
    while [[ \$i -lt 6000 ]]; do
        printf -- '-\t0\tcom.apple.filler.service.number.%s\n' "\$i"
        i=\$((i + 1))
    done
fi
if [[ "\${1:-}" == "list" && \$# -eq 2 ]]; then
    grep -qF "\${2}" "$SCRATCH/launchctl-list.txt" 2>/dev/null && exit 0 || exit 1
fi
exit 0
LC_EOF
chmod +x "$SCRATCH/.local/bin/launchctl"

set_live_labels() { printf '%s\n' "$@" > "$SCRATCH/launchctl-list.txt"; }
clear_live_labels() { : > "$SCRATCH/launchctl-list.txt"; }

# Run the driver in a sealed environment: scratch HOME (so plists land in the scratch
# tree), stubbed claude, seamed gh identity, shim dir on PATH.
run_driver() {
    env HOME="$SCRATCH" \
        PATH="$SCRATCH/.local/bin:$PATH" \
        PR_READY_NOW_CLAUDE="$CLAUDE_STUB" \
        PR_READY_NOW_GH_USER=a-jay85 \
        PR_READY_NOW_WTL="${PR_READY_NOW_WTL-$WTL_FIXTURE}" \
        "$DRIVER" "$@"
}

plist_count() {
    local f n=0
    for f in "$SCRATCH/Library/LaunchAgents"/com.ibl5.pr-ready-now-*.plist; do
        if [[ -e "$f" ]]; then n=$((n + 1)); fi
    done
    printf '%s\n' "$n"
}

clean_slots() { rm -rf "$SCRATCH/Library/LaunchAgents"; clear_live_labels; }

field() { grep -o "<key>$2</key><string>[^<]*</string>" "$1" | sed "s|<key>$2</key><string>||; s|</string>||"; }

# --- case 1: --help ----------------------------------------------------------------------
begin_case
out="$(run_driver --help 2>&1)"; rc=$?
[[ $rc -eq 0 ]]                 || fail "--help exited $rc, want 0"
grep -q 'Usage:' <<< "$out"     || fail "--help output has no 'Usage:' line"
grep -q -- '--jobs' <<< "$out"  || fail "--help output does not document --jobs"
end_case help

# --- case 2: flag validation -------------------------------------------------------------
begin_case
check_reject() {  # $1 = expected stderr substring, rest = argv
    local want="$1"; shift
    local e o r
    e="$(mktemp)"
    o="$(run_driver "$@" 2>"$e")"; r=$?
    : "$o"
    [[ $r -ne 0 ]] || fail "'$*' exited 0, want non-zero"
    grep -q "$want" "$e" || fail "'$*' stderr lacks '$want' (got: $(tr '\n' ' ' < "$e"))"
    rm -f "$e"
}
check_reject 'positive integer'  --jobs foo
check_reject 'positive integer'  --jobs 0
check_reject 'positive integers' --pr 0
check_reject 'positive integers' --pr abc
check_reject 'unknown flag'      --bogus
check_reject 'requires a value'  --jobs
end_case flag-validation

# --- case 3: dry-run report, no --go -----------------------------------------------------
begin_case
clean_slots
out="$(PR_READY_NOW_PR_JSON="$SCRATCH/two-open.json" run_driver 2>&1)"; rc=$?
[[ $rc -eq 0 ]]                    || fail "dry-run exited $rc, want 0 (out: $out)"
grep -q '1901' <<< "$out"          || fail "dry-run report omits PR 1901"
grep -q '1902' <<< "$out"          || fail "dry-run report omits PR 1902"
grep -q 'branch-one' <<< "$out"    || fail "dry-run report omits branch-one"
grep -q 'DRY RUN' <<< "$out"       || fail "dry-run report never says DRY RUN"
[[ "$(plist_count)" -eq 0 ]]       || fail "dry-run wrote $(plist_count) plist(s), want 0"
end_case dry-run-report

# --- case 4: draft exclusion -------------------------------------------------------------
begin_case
clean_slots
out="$(PR_READY_NOW_PR_JSON="$SCRATCH/one-draft.json" run_driver 2>&1)"; rc=$?
[[ $rc -eq 0 ]]              || fail "draft-exclusion run exited $rc, want 0 (out: $out)"
grep -q '1904' <<< "$out"    || fail "non-draft PR 1904 missing from report"
grep -q '1903' <<< "$out"    && fail "draft PR 1903 leaked into the fire list"
end_case draft-exclusion

# --- case 5: per-PR path uniqueness (defect class B1 regression) -------------------------
# Every generated path must be keyed to the PR number. A $$- or timestamp-derived name
# would collide here, because both PRs are generated by the same process.
begin_case
clean_slots
out="$(PR_READY_NOW_PR_JSON="$SCRATCH/two-open.json" PR_READY_NOW_DRY_RUN=1 run_driver --go --jobs 3 2>&1)"; rc=$?
[[ $rc -eq 0 ]]                || fail "--go dry-run exited $rc, want 0 (out: $out)"
[[ "$(plist_count)" -eq 2 ]]   || fail "--go dry-run wrote $(plist_count) plist(s), want 2"

P1="$SCRATCH/Library/LaunchAgents/com.ibl5.pr-ready-now-1901.plist"
P2="$SCRATCH/Library/LaunchAgents/com.ibl5.pr-ready-now-1902.plist"
if [[ -f "$P1" && -f "$P2" ]]; then
    for k in Label StandardOutPath; do
        v1="$(field "$P1" "$k")"; v2="$(field "$P2" "$k")"
        [[ -n "$v1" && -n "$v2" ]] || fail "$k empty in a plist (1901='$v1' 1902='$v2')"
        [[ "$v1" != "$v2" ]]       || fail "$k collides across PRs: '$v1'"
    done
    r1="$(grep -o 'exec [^<]*' "$P1")"; r2="$(grep -o 'exec [^<]*' "$P2")"
    [[ -n "$r1" && "$r1" != "$r2" ]] || fail "runner path collides across PRs: '$r1'"
    grep -q 'pr-ready-now-runner-1901.sh' "$P1" || fail "PR 1901 runner path is not PR-keyed"
else
    fail "expected a plist for both 1901 and 1902"
fi
end_case path-uniqueness

# --- case 6: plist shape -----------------------------------------------------------------
begin_case
if [[ -f "$P1" ]]; then
    grep -q '<key>PATH</key>' "$P1"   || fail "plist has no PATH environment key"
    grep -q '/opt/homebrew/bin' "$P1" || fail "plist PATH lacks /opt/homebrew/bin"
    # Nothing may survive as a literal, unexpanded shell variable.
    grep -qE '\$\{?HOME|\$\{?ROOT|\$\{?LABEL' "$P1" && fail "plist contains an unexpanded shell variable"
    # An empty <string> means some value expanded to nothing at write time.
    grep -q '<string></string>' "$P1" && fail "plist contains an empty <string>"
    grep -q '<key>WorkingDirectory</key><string>/' "$P1" \
        || fail "plist WorkingDirectory is not an absolute path"
    # The runner must start in the MAIN checkout, never a worktree.
    grep -q '<key>WorkingDirectory</key><string>[^<]*</string>' "$P1" \
        || fail "plist has no WorkingDirectory key"
else
    fail "no plist to inspect for shape"
fi
end_case plist-shape

# --- case 7: env seams -------------------------------------------------------------------
begin_case
clean_slots
e="$(mktemp)"
out="$(PR_READY_NOW_PR_JSON=/nonexistent/pr.json run_driver 2>"$e")"; rc=$?
: "$out"
[[ $rc -ne 0 ]]                  || fail "missing PR_READY_NOW_PR_JSON exited 0, want non-zero"
grep -q 'not found' "$e"         || fail "missing-fixture error does not say 'not found'"
rm -f "$e"

# Unset: falls through to the gh shim on PATH.
out="$(run_driver 2>&1)"; rc=$?
[[ $rc -eq 0 ]]            || fail "gh-shim path exited $rc, want 0 (out: $out)"
grep -q '1901' <<< "$out"  || fail "gh-shim path did not report PR 1901"
end_case env-seam

# --- case 8: concurrency cap -------------------------------------------------------------
# --jobs 1 with two PRs: the first consumes the only slot, the second must block on it
# rather than firing. Asserted on the emitted wait line, not on surviving plist count —
# reap_stale is what would otherwise decide that question.
begin_case
clean_slots
out="$(PR_READY_NOW_PR_JSON="$SCRATCH/two-open.json" PR_READY_NOW_DRY_RUN=1 run_driver --go --jobs 1 2>&1)"; rc=$?
[[ $rc -eq 0 ]]                        || fail "--jobs 1 run exited $rc, want 0 (out: $out)"
grep -q 'waiting for slot' <<< "$out"  || fail "--jobs 1 never waited for a slot (cap not enforced)"
[[ "$(plist_count)" -eq 1 ]]           || fail "--jobs 1 wrote $(plist_count) plist(s), want 1"
end_case concurrency-cap

# --- case 9: already-running skip ---------------------------------------------------------
# Regression for a live-fire failure on 2026-08-21: the check was
# `launchctl list | grep -q ...` under `set -o pipefail`. grep -q exits on the first
# match, launchctl takes SIGPIPE, and the pipeline reports failure — so a PR whose
# session was already running got fired a second time, booting out the first.
begin_case
clean_slots
set_live_labels "40477	0	com.ibl5.pr-ready-now-1901"
out="$(PR_READY_NOW_PR_JSON="$SCRATCH/two-open.json" run_driver 2>&1)"; rc=$?
[[ $rc -eq 0 ]]                            || fail "already-running run exited $rc, want 0 (out: $out)"
grep -q 'already running' <<< "$out"       || fail "live PR 1901 was not skipped"
grep -qE '1902 +branch-two +WT +WOULD FIRE' <<< "$out" || fail "PR 1902 should still fire with PRE=WT (out: $out)"
end_case already-running-skip

# --- case 10: label match is end-anchored -------------------------------------------------
# A live job for PR 19011 must not suppress PR 1901.
begin_case
clean_slots
set_live_labels "40477	0	com.ibl5.pr-ready-now-19011"
out="$(PR_READY_NOW_PR_JSON="$SCRATCH/two-open.json" run_driver 2>&1)"; rc=$?
[[ $rc -eq 0 ]]                       || fail "anchor run exited $rc, want 0 (out: $out)"
grep -q 'already running' <<< "$out"  && fail "PR 19011's label wrongly suppressed a different PR"
grep -qE '1901 +branch-one +WT +WOULD FIRE' <<< "$out" || fail "PR 1901 should fire with PRE=WT (out: $out)"
clear_live_labels
end_case label-anchor

# --- Phase 8 fixture setup ---------------------------------------------------------------
# Shared fixtures for cases 11-30.

ATTACK_SHA="abc1234"   # 7 valid hex digits — matched against the attack-fresh.md Base: line

# Extended WTL: covers attack-path branches (branch-r1..r8, branch-s1..s3), preflight
# combos (wt-and-plan, wt-only), report-status branches (branch-ready, branch-notready,
# branch-mmtf, branch-nolog), and grep-form branches (foo, foo-bar).
WTL8="$SCRATCH/wtl8.txt"
cat > "$WTL8" <<EOF
/Users/x/IBL5                                 0000abc [master]
/Users/x/IBL5-worktrees/r1/ibl5              1111111 [branch-r1]
/Users/x/IBL5-worktrees/r2/ibl5              2222222 [branch-r2]
/Users/x/IBL5-worktrees/r3/ibl5              3333333 [branch-r3]
/Users/x/IBL5-worktrees/r4/ibl5              4444444 [branch-r4]
/Users/x/IBL5-worktrees/r5/ibl5              5555555 [branch-r5]
/Users/x/IBL5-worktrees/r6/ibl5              6666666 [branch-r6]
/Users/x/IBL5-worktrees/r7/ibl5              7777777 [branch-r7]
/Users/x/IBL5-worktrees/r8/ibl5              8888888 [branch-r8]
/Users/x/IBL5-worktrees/s1/ibl5              aaaaaaa [branch-s1]
/Users/x/IBL5-worktrees/s2/ibl5              bbbbbbb [branch-s2]
/Users/x/IBL5-worktrees/s3/ibl5              ccccccc [branch-s3]
/Users/x/IBL5-worktrees/wt-and-plan/ibl5     ddddddd [wt-and-plan]
/Users/x/IBL5-worktrees/wt-only/ibl5         eeeeeee [wt-only]
/Users/x/IBL5-worktrees/ready/ibl5           fffffff [branch-ready]
/Users/x/IBL5-worktrees/notready/ibl5        1234567 [branch-notready]
/Users/x/IBL5-worktrees/mmtf/ibl5            2345678 [branch-mmtf]
/Users/x/IBL5-worktrees/nolog/ibl5           3456789 [branch-nolog]
/Users/x/IBL5-worktrees/foo/ibl5             4567890 [foo]
/Users/x/IBL5-worktrees/foo-bar/ibl5         5678901 [foo-bar]
EOF

# attack-fresh.md: 8 ranked PRs (1910-1917), 1 excluded (1912), sha=ATTACK_SHA.
cat > "$SCRATCH/attack-fresh.md" <<EOF
# /pr-attack output fixture

Base: \`master\` @ ${ATTACK_SHA} · 8 open · 8 orderable · 1 excluded

| rank | PR | title |
|------|----|----|
| 1 | #1910 | r1 |
| 2 | #1911 | r2 |
| 3 | #1912 | r3 |
| 4 | #1913 | r4 |
| 5 | #1914 | r5 |
| 6 | #1915 | r6 |
| 7 | #1916 | r7 |
| 8 | #1917 | r8 |

## Excluded
- #1912
EOF

# attack-stale.md: same structure but sha=aaaaaaa (mismatches ATTACK_SHA → STALE).
cat > "$SCRATCH/attack-stale.md" <<EOF
# /pr-attack output fixture

Base: \`master\` @ aaaaaaa · 8 open · 8 orderable · 1 excluded

| rank | PR | title |
|------|----|----|
| 1 | #1910 | r1 |
| 2 | #1911 | r2 |
| 3 | #1912 | r3 |

## Excluded
- #1912
EOF

# attack-empty.md: valid Base: sha but no ranked table rows → select_prs errors out.
cat > "$SCRATCH/attack-empty.md" <<EOF
# /pr-attack output fixture

Base: \`master\` @ ${ATTACK_SHA} · 0 open · 0 orderable · 0 excluded

## Excluded
(none)
EOF

# attack-short.md: 3 ranked PRs (1920-1922), no excluded, sha=ATTACK_SHA.
cat > "$SCRATCH/attack-short.md" <<EOF
# /pr-attack output fixture

Base: \`master\` @ ${ATTACK_SHA} · 3 open · 3 orderable · 0 excluded

| rank | PR | title |
|------|----|----|
| 1 | #1920 | s1 |
| 2 | #1921 | s2 |
| 3 | #1922 | s3 |

## Excluded
(none)
EOF

# JSON for the 1910-1922 PR universe (used so the fire loop can resolve headRefName
# for each PR number when --pr-attack is in effect).
cat > "$SCRATCH/attack-8prs.json" <<'JSON'
[
  {"number": 1910, "title": "r1",      "isDraft": false, "headRefName": "branch-r1", "author": {"login": "a-jay85"}},
  {"number": 1911, "title": "r2",      "isDraft": false, "headRefName": "branch-r2", "author": {"login": "a-jay85"}},
  {"number": 1912, "title": "r3-excl", "isDraft": false, "headRefName": "branch-r3", "author": {"login": "a-jay85"}},
  {"number": 1913, "title": "r4",      "isDraft": false, "headRefName": "branch-r4", "author": {"login": "a-jay85"}},
  {"number": 1914, "title": "r5",      "isDraft": false, "headRefName": "branch-r5", "author": {"login": "a-jay85"}},
  {"number": 1915, "title": "r6",      "isDraft": false, "headRefName": "branch-r6", "author": {"login": "a-jay85"}},
  {"number": 1916, "title": "r7",      "isDraft": false, "headRefName": "branch-r7", "author": {"login": "a-jay85"}},
  {"number": 1917, "title": "r8",      "isDraft": false, "headRefName": "branch-r8", "author": {"login": "a-jay85"}},
  {"number": 1920, "title": "s1",      "isDraft": false, "headRefName": "branch-s1", "author": {"login": "a-jay85"}},
  {"number": 1921, "title": "s2",      "isDraft": false, "headRefName": "branch-s2", "author": {"login": "a-jay85"}},
  {"number": 1922, "title": "s3",      "isDraft": false, "headRefName": "branch-s3", "author": {"login": "a-jay85"}}
]
JSON

# four-combo.json: 4 PRs for the preflight-matrix case.
cat > "$SCRATCH/four-combo.json" <<'JSON'
[
  {"number": 2001, "title": "wt-and-plan", "isDraft": false, "headRefName": "wt-and-plan", "author": {"login": "a-jay85"}},
  {"number": 2002, "title": "wt-only",     "isDraft": false, "headRefName": "wt-only",     "author": {"login": "a-jay85"}},
  {"number": 2003, "title": "plan-only",   "isDraft": false, "headRefName": "plan-only",   "author": {"login": "a-jay85"}},
  {"number": 2004, "title": "neither",     "isDraft": false, "headRefName": "neither",     "author": {"login": "a-jay85"}}
]
JSON

# four-fire.json: 4 PRs all with worktrees in WTL8, for report-statuses.
cat > "$SCRATCH/four-fire.json" <<'JSON'
[
  {"number": 3001, "title": "ready",    "isDraft": false, "headRefName": "branch-ready",    "author": {"login": "a-jay85"}},
  {"number": 3002, "title": "notready", "isDraft": false, "headRefName": "branch-notready", "author": {"login": "a-jay85"}},
  {"number": 3003, "title": "mmtf",     "isDraft": false, "headRefName": "branch-mmtf",     "author": {"login": "a-jay85"}},
  {"number": 3004, "title": "nolog",    "isDraft": false, "headRefName": "branch-nolog",    "author": {"login": "a-jay85"}}
]
JSON

# foo-prs.json: 2 PRs with branches "foo" and "foo-bar" for the preflight-grep-form case.
cat > "$SCRATCH/foo-prs.json" <<'JSON'
[
  {"number": 2011, "title": "foo",     "isDraft": false, "headRefName": "foo",     "author": {"login": "a-jay85"}},
  {"number": 2012, "title": "foo-bar", "isDraft": false, "headRefName": "foo-bar", "author": {"login": "a-jay85"}}
]
JSON

# Minimal WTLs for preflight-grep-form: one contains only [foo], the other only [foo-bar].
cat > "$SCRATCH/foo-only.txt" <<EOF
/Users/x/IBL5                          abc0001 [master]
/Users/x/IBL5-worktrees/foo/ibl5       abc0002 [foo]
EOF
cat > "$SCRATCH/foo-bar-only.txt" <<EOF
/Users/x/IBL5                            abc0001 [master]
/Users/x/IBL5-worktrees/foo-bar/ibl5    abc0003 [foo-bar]
EOF

# claude-plans dir: HOME=$SCRATCH in run_driver → driver looks for $SCRATCH/claude-plans/$branch.md.
mkdir -p "$SCRATCH/claude-plans"
touch "$SCRATCH/claude-plans/wt-and-plan.md"
touch "$SCRATCH/claude-plans/plan-only.md"

# --- case 11: attack-selection -----------------------------------------------------------
# select_prs() from a /pr-attack file: top-5 after exclusion. Excluded PR 1912 absent.
# PRs beyond the top-5 cut (1916, 1917) absent.
begin_case
clean_slots
out="$(PR_READY_NOW_MASTER_SHA="$ATTACK_SHA" \
       PR_READY_NOW_WTL="$WTL8" \
       PR_READY_NOW_PR_JSON="$SCRATCH/attack-8prs.json" \
       run_driver --pr-attack "$SCRATCH/attack-fresh.md" --top-n 5 2>&1)"; rc=$?
[[ $rc -eq 0 ]] || fail "attack-selection: exit $rc (out: $out)"
for pr in 1910 1911 1913 1914 1915; do
    grep -q "$pr" <<< "$out" || fail "attack-selection: PR $pr missing (out: $out)"
done
grep -q '1912' <<< "$out" && fail "attack-selection: excluded PR 1912 appeared in output"
grep -q '1916' <<< "$out" && fail "attack-selection: beyond-top PR 1916 appeared in output"
grep -q '1917' <<< "$out" && fail "attack-selection: beyond-top PR 1917 appeared in output"
end_case attack-selection

# --- case 12: attack-excluded ------------------------------------------------------------
# Excluded PR 1912 never appears, even when --top-n 99 would otherwise include it.
begin_case
clean_slots
out="$(PR_READY_NOW_MASTER_SHA="$ATTACK_SHA" \
       PR_READY_NOW_WTL="$WTL8" \
       PR_READY_NOW_PR_JSON="$SCRATCH/attack-8prs.json" \
       run_driver --pr-attack "$SCRATCH/attack-fresh.md" --top-n 99 2>&1)"
grep -q '1912' <<< "$out" && fail "attack-excluded: PR 1912 appeared with --top-n 99 (out: $out)"
end_case attack-excluded

# --- case 13: attack-staleness -----------------------------------------------------------
# Fresh fixture + matching SHA → exit 0.
# Stale fixture (sha=aaaaaaa, ATTACK_SHA=abc1234) → STALE message + exit 1.
begin_case
clean_slots
PR_READY_NOW_MASTER_SHA="$ATTACK_SHA" \
    PR_READY_NOW_WTL="$WTL8" \
    PR_READY_NOW_PR_JSON="$SCRATCH/attack-8prs.json" \
    run_driver --pr-attack "$SCRATCH/attack-fresh.md" --top-n 1 >/dev/null 2>&1
fresh_rc=$?
[[ $fresh_rc -eq 0 ]] || fail "attack-staleness: fresh arm exited $fresh_rc, want 0"
stale_err="$(PR_READY_NOW_MASTER_SHA="$ATTACK_SHA" \
    run_driver --pr-attack "$SCRATCH/attack-stale.md" 2>&1)"; stale_rc=$?
[[ $stale_rc -ne 0 ]] || fail "attack-staleness: stale arm exited 0, want non-zero"
grep -qi 'STALE' <<< "$stale_err" || fail "attack-staleness: stale arm lacks STALE keyword (out: $stale_err)"
end_case attack-staleness

# --- case 14: attack-empty-table ---------------------------------------------------------
# A /pr-attack file with a valid Base: but no ranked rows triggers an error exit.
# No plists must be created.
begin_case
clean_slots
err="$(PR_READY_NOW_MASTER_SHA="$ATTACK_SHA" \
    run_driver --pr-attack "$SCRATCH/attack-empty.md" 2>&1)"; rc=$?
[[ $rc -ne 0 ]] || fail "attack-empty-table: exited 0, want non-zero"
grep -qi 'no orderable' <<< "$err" || fail "attack-empty-table: error lacks 'no orderable' (out: $err)"
[[ "$(plist_count)" -eq 0 ]] || fail "attack-empty-table: $(plist_count) plist(s) written, want 0"
end_case attack-empty-table

# --- case 15: top-n-bounds ---------------------------------------------------------------
# --top-n 99 on a 3-row file selects all 3; --top-n 2 selects exactly 2;
# --top-n 0 and --top-n abc are rejected before any selection runs.
begin_case
clean_slots
out99="$(PR_READY_NOW_MASTER_SHA="$ATTACK_SHA" \
         PR_READY_NOW_WTL="$WTL8" \
         PR_READY_NOW_PR_JSON="$SCRATCH/attack-8prs.json" \
         run_driver --pr-attack "$SCRATCH/attack-short.md" --top-n 99 2>&1)"; rc=$?
[[ $rc -eq 0 ]] || fail "top-n-bounds: top-n 99 exited $rc"
fire99="$(grep -c 'WOULD FIRE' <<< "$out99" || echo 0)"
[[ $fire99 -eq 3 ]] || fail "top-n-bounds: top-n 99 on 3 rows → $fire99 WOULD FIRE lines, want 3"
out2="$(PR_READY_NOW_MASTER_SHA="$ATTACK_SHA" \
        PR_READY_NOW_WTL="$WTL8" \
        PR_READY_NOW_PR_JSON="$SCRATCH/attack-8prs.json" \
        run_driver --pr-attack "$SCRATCH/attack-short.md" --top-n 2 2>&1)"
fire2="$(grep -c 'WOULD FIRE' <<< "$out2" || echo 0)"
[[ $fire2 -eq 2 ]] || fail "top-n-bounds: top-n 2 on 3 rows → $fire2 WOULD FIRE lines, want 2"
e0="$(run_driver --pr-attack "$SCRATCH/attack-fresh.md" --top-n 0 2>&1)"; rc0=$?
[[ $rc0 -ne 0 ]] || fail "top-n-bounds: --top-n 0 exited 0, want non-zero"
grep -q 'positive integer' <<< "$e0" || fail "top-n-bounds: --top-n 0 lacks 'positive integer' (out: $e0)"
eabc="$(run_driver --pr-attack "$SCRATCH/attack-fresh.md" --top-n abc 2>&1)"; rcabc=$?
[[ $rcabc -ne 0 ]] || fail "top-n-bounds: --top-n abc exited 0, want non-zero"
end_case top-n-bounds

# --- case 16: pr-attack-vs-pr-exclusive --------------------------------------------------
# --pr-attack and --pr are mutually exclusive; combining them errors immediately.
begin_case
err="$(run_driver --pr-attack "$SCRATCH/attack-fresh.md" --pr 1910 2>&1)"; rc=$?
[[ $rc -ne 0 ]] || fail "pr-attack-vs-pr-exclusive: combined flags exited 0, want non-zero"
grep -qi 'mutually exclusive' <<< "$err" || \
    fail "pr-attack-vs-pr-exclusive: error lacks 'mutually exclusive' (out: $err)"
end_case pr-attack-vs-pr-exclusive

# --- case 17: preflight-matrix -----------------------------------------------------------
# All four worktree+plan combinations produce the expected PRE and status columns:
#   wt-and-plan (2001) → WT+PLAN  WOULD FIRE
#   wt-only     (2002) → WT       WOULD FIRE
#   plan-only   (2003) → PLAN     SKIP (no worktree)
#   neither     (2004) → —        SKIP (no worktree)
begin_case
clean_slots
out="$(PR_READY_NOW_PR_JSON="$SCRATCH/four-combo.json" \
       PR_READY_NOW_WTL="$WTL8" \
       run_driver 2>&1)"; rc=$?
[[ $rc -eq 0 ]] || fail "preflight-matrix: exit $rc (out: $out)"
grep -qE '2001.*WT\+PLAN.*WOULD FIRE' <<< "$out" || \
    fail "preflight-matrix: 2001 not WT+PLAN WOULD FIRE (out: $out)"
grep -qE '2002.*WOULD FIRE' <<< "$out" || \
    fail "preflight-matrix: 2002 not WOULD FIRE (out: $out)"
grep -qE '2003.*PLAN.*SKIP' <<< "$out" || \
    fail "preflight-matrix: 2003 not PLAN SKIP (out: $out)"
grep -qE '2004.*SKIP' <<< "$out" || \
    fail "preflight-matrix: 2004 not SKIP (out: $out)"
# Neither 2003 nor 2004 should appear as WOULD FIRE.
grep -qE '2003.*WOULD FIRE' <<< "$out" && fail "preflight-matrix: 2003 appeared as WOULD FIRE"
grep -qE '2004.*WOULD FIRE' <<< "$out" && fail "preflight-matrix: 2004 appeared as WOULD FIRE"
end_case preflight-matrix

# --- case 18: preflight-grep-form --------------------------------------------------------
# The pre-flight grep uses -qF "[$branch]" (literal). With only [foo] in the WTL,
# branch "foo-bar" must get SKIP; with only [foo-bar], branch "foo" must get SKIP.
# A grep without -F would treat "[foo]" as a character class and spuriously match.
begin_case
clean_slots
# WTL has only [foo]: foo→FIRE, foo-bar→SKIP (no worktree)
out_fo="$(PR_READY_NOW_PR_JSON="$SCRATCH/foo-prs.json" \
          PR_READY_NOW_WTL="$SCRATCH/foo-only.txt" \
          run_driver 2>&1)"
grep -qE '2011.*WOULD FIRE' <<< "$out_fo" || \
    fail "preflight-grep-form: foo-only WTL: PR 2011 (foo) should WOULD FIRE (out: $out_fo)"
grep -qE '2012.*SKIP' <<< "$out_fo" || \
    fail "preflight-grep-form: foo-only WTL: PR 2012 (foo-bar) should SKIP (out: $out_fo)"
# WTL has only [foo-bar]: foo→SKIP, foo-bar→FIRE
out_fb="$(PR_READY_NOW_PR_JSON="$SCRATCH/foo-prs.json" \
          PR_READY_NOW_WTL="$SCRATCH/foo-bar-only.txt" \
          run_driver 2>&1)"
grep -qE '2012.*WOULD FIRE' <<< "$out_fb" || \
    fail "preflight-grep-form: foo-bar-only WTL: PR 2012 (foo-bar) should WOULD FIRE (out: $out_fb)"
grep -qE '2011.*SKIP' <<< "$out_fb" || \
    fail "preflight-grep-form: foo-bar-only WTL: PR 2011 (foo) should SKIP (out: $out_fb)"
end_case preflight-grep-form

# --- case 19: wait-dry-run-inert ---------------------------------------------------------
# PR_READY_NOW_DRY_RUN=1 skips the real wait block even with --wait --go:
# no "waiting for" line, fast exit.
begin_case
clean_slots
out="$(PR_READY_NOW_PR_JSON="$SCRATCH/two-open.json" \
       PR_READY_NOW_DRY_RUN=1 \
       run_driver --go --wait 2>&1)"; rc=$?
[[ $rc -eq 0 ]] || fail "wait-dry-run-inert: exit $rc (out: $out)"
grep -q 'waiting for' <<< "$out" && fail "wait-dry-run-inert: 'waiting for' printed under DRY_RUN"
end_case wait-dry-run-inert

# --- case 20: wait-drains ----------------------------------------------------------------
# Sub-case A (fast): empty label list → reap_stale reaps all plists in the first
# iteration → live_slots=0 → break without printing "waiting for".
# Sub-case B (~20s): a plist for a PR that is NOT a selection candidate, whose label IS
# live, survives the first reap → "waiting for 1 session(s)…" printed → a background job
# clears the label list → the second iteration reaps it → live_slots hits 0 → exit 0.
#
# Sub-case B needs the wait block to be REACHED, and line 635 exits 0 before it whenever
# FIRE_PRS is empty. So the candidate PRs must actually fire — which is safe here because
# `launchctl bootstrap` resolves to the shim on PATH, never to real launchd. The held-open
# slot therefore has to belong to a label outside the candidate set (9999): a live label on
# 1901/1902 would suppress them as already-running and empty FIRE_PRS again.
begin_case
# Sub-case A — zero live slots at entry breaks immediately, without printing.
clean_slots
clear_live_labels
out_a="$(PR_READY_NOW_PR_JSON="$SCRATCH/two-open.json" \
         run_driver --go --wait 2>&1)"; rc_a=$?
[[ $rc_a -eq 0 ]] || fail "wait-drains/A: exit $rc_a (out: $out_a)"
grep -q 'waiting for' <<< "$out_a" && fail "wait-drains/A: printed 'waiting for' with empty label list"

# Sub-case B — the block must actually wait, then drain to zero.
clean_slots
mkdir -p "$SCRATCH/Library/LaunchAgents"
: > "$SCRATCH/Library/LaunchAgents/com.ibl5.pr-ready-now-9999.plist"
set_live_labels "40477	0	com.ibl5.pr-ready-now-9999"
( sleep 3; : > "$SCRATCH/launchctl-list.txt" ) &
_wd_bg=$!
out_b="$(PR_READY_NOW_PR_JSON="$SCRATCH/two-open.json" \
         run_driver --go --wait 2>&1)"; rc_b=$?
wait "$_wd_bg" 2>/dev/null
[[ $rc_b -eq 0 ]] || fail "wait-drains/B: exit $rc_b (out: $out_b)"
grep -qE 'waiting for [0-9]+ session' <<< "$out_b" \
    || fail "wait-drains/B: never printed a 'waiting for N session(s)' line — the wait block did not wait (out: $out_b)"
[[ "$(plist_count)" -eq 0 ]] || fail "wait-drains/B: drained to $(plist_count) plists, want 0"
clear_live_labels
clean_slots
end_case wait-drains

# --- case 21: report-statuses ------------------------------------------------------------
# Pre-created logs produce all four derive_status() return values in the written report.
begin_case
clean_slots
_rdate="$(date +%F)"
rm -f /tmp/pr-ready-now-300{1,2,3,4}.log
TMP_LOGS+=("/tmp/pr-ready-now-3001.log" "/tmp/pr-ready-now-3002.log" "/tmp/pr-ready-now-3003.log")
printf 'READY\n' > /tmp/pr-ready-now-3001.log
printf 'NOT READY — please fix the issues above.\n' > /tmp/pr-ready-now-3002.log
printf 'master is moving faster than this branch can rebase\n' > /tmp/pr-ready-now-3003.log
# No log for 3004 → NOT READY (no log)
out="$(PR_READY_NOW_PR_JSON="$SCRATCH/four-fire.json" \
       PR_READY_NOW_WTL="$WTL8" \
       PR_READY_NOW_DRY_RUN=1 \
       run_driver --go --jobs 4 2>&1)"; rc=$?
[[ $rc -eq 0 ]] || fail "report-statuses: exit $rc (out: $out)"
rp="$SCRATCH/pr-firstpass-${_rdate}.md"
[[ -f "$rp" ]] || fail "report-statuses: report not found at $rp"
grep -qF '| READY |' "$rp" || fail "report-statuses: READY status missing from report"
grep -qF '| NOT READY |' "$rp" || fail "report-statuses: NOT READY status missing from report"
grep -qF '| MASTER-MOVING-TOO-FAST |' "$rp" || fail "report-statuses: MMTF status missing from report"
grep -qF '| NOT READY (no log) |' "$rp" || fail "report-statuses: NOT READY (no log) status missing"
end_case report-statuses

