test_account_switch_check() {
    new_env
    seed_home uuid-B
    local d="$IBL5_USAGE_GATE_STATE_DIR"
    seed_cache "$(date +%s)" "$BODY_A"
    acct_hash uuid-A > "$d/acct-last"
    printf '%s 1\n' "$(( $(date +%s) + 600 ))" > "$d/fetch-backoff"
    gate_run usage_account_switch_check
    assert_no_file acct_check:cache "$d/cache.json"
    assert_no_file acct_check:backoff "$d/fetch-backoff"
    assert_contains acct_check:log "$(cat "$d/usage-gate.log")" "account-switch cache-dropped"
    assert_eq acct_check:signal "- 0 account" "$(cut -d' ' -f2- "$d/cred-switch")"

    new_env
    seed_home uuid-A
    d="$IBL5_USAGE_GATE_STATE_DIR"
    seed_cache "$(date +%s)" "$BODY_A"
    acct_hash uuid-A > "$d/acct-last"
    gate_run usage_account_switch_check
    assert_file acct_check:same-keeps-cache "$d/cache.json"
    assert_no_file acct_check:same-no-signal "$d/cred-switch"

    new_env
    seed_home uuid-B
    d="$IBL5_USAGE_GATE_STATE_DIR"
    seed_cache "$(date +%s)" "$BODY_A"
    gate_run usage_account_switch_check
    assert_file acct_check:no-last-keeps-cache "$d/cache.json"
    assert_no_file acct_check:no-last-no-signal "$d/cred-switch"
}

# ---------------------------------------------------------------- coordinator switch fast resume

# sw_marker <sid> <acct_uuid|""> [paused_ago]: marker paused under that account, resets an hour ahead.
sw_marker() {
    ( export PATH="$STUB:$ORIG_PATH"; coord_marker "$1" plan-now )
    patch_marker "$1" ".resets_at = $(( $(date +%s) + 3600 )) | .paused_at = $(( $(date +%s) - ${3:-600} ))"
    if [ -n "$2" ]; then patch_marker "$1" ".acct_fp = \"$(acct_hash "$2")\""; else patch_marker "$1" 'del(.acct_fp, .cred_fp)'; fi
}

# sw_signal <age_secs> <fp|-> <count> <kind>: write a cred-switch signal.
sw_signal() {
    printf '%s %s %s %s\n' "$(( $(date +%s) - $1 ))" "$2" "$3" "$4" > "$IBL5_USAGE_GATE_STATE_DIR/cred-switch"
}

# sw_stale_setup: stale tick (no cache), fetch-backoff armed like the incident.
sw_stale_setup() {
    coord_setup 97
    rm -f "$IBL5_USAGE_GATE_STATE_DIR/cache.json"
    printf '%s 1\n' "$(( $(date +%s) + 3598 ))" > "$IBL5_USAGE_GATE_STATE_DIR/fetch-backoff"
}

test_coord_switch_incident_resumes() {
    sw_stale_setup
    seed_home uuid-B
    sw_marker "$SID_A" uuid-A
    sw_marker "$SID_B" uuid-A
    sw_signal 30 - 1 account
    run_coord --once >/dev/null 2>&1
    wait_file "$T/launched.$SID_A"; assert_eq switch_incident:a-launched 0 "$?"
    wait_file "$T/launched.$SID_B"; assert_eq switch_incident:b-launched 0 "$?"
    assert_eq switch_incident:stamp "acct:$(acct_hash uuid-B)" \
        "$(jq -r '.switch_resumed_for' "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json")"
    assert_contains switch_incident:log "$(fetch_log)" "switch-resume sid=$SID_A via=acct"
}

test_coord_switch_resume_once() {
    sw_stale_setup
    seed_home uuid-B
    sw_marker "$SID_A" uuid-A
    sw_signal 30 - 1 account
    run_coord --once >/dev/null 2>&1
    wait_file "$T/launched.$SID_A"; assert_eq switch_once:first 0 "$?"
    rm -f "$T/launched.$SID_A"
    patch_marker "$SID_A" 'del(.resuming_pid)'
    run_coord --once >/dev/null 2>&1
    sleep 1
    assert_no_file switch_once:crashed-not-relaunched "$T/launched.$SID_A"
    sw_marker "$SID_A" uuid-B
    run_coord --once >/dev/null 2>&1
    sleep 1
    assert_no_file switch_once:repaused-not-relaunched "$T/launched.$SID_A"
}

test_coord_same_account_no_fast_resume() {
    sw_stale_setup
    seed_home uuid-A
    sw_marker "$SID_A" uuid-A
    sw_signal 30 - 1 token
    run_coord --once >/dev/null 2>&1
    sleep 1
    assert_no_file same_acct_coord:no-launch "$T/launched.$SID_A"
}

test_coord_switch_respects_runaway_and_hold() {
    sw_stale_setup
    seed_home uuid-B
    sw_marker "$SID_A" uuid-A
    patch_marker "$SID_A" '.resume_count = 5'
    ( export PATH="$STUB:$ORIG_PATH"; coord_marker "$SID_B" plan-now limit-hit )
    patch_marker "$SID_B" ".resets_at = $(( $(date +%s) + 3600 )) | .acct_fp = \"$(acct_hash uuid-A)\""
    sw_signal 30 - 1 account
    run_coord --once >/dev/null 2>&1
    sleep 1
    # A known account switch clears the old account's pause count, so A resumes.
    assert_eq switch_runaway:unstuck false "$(jq -r '.stuck // false' "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json")"
    assert_file switch_runaway:launched "$T/launched.$SID_A"
    assert_no_file switch_hold:limit-hit-waits "$T/launched.$SID_B"
}

test_coord_switch_fallback_signal() {
    sw_stale_setup
    seed_home ""
    sw_marker "$SID_A" ""
    sw_signal 60 "$FP_A" 0 token
    run_coord --once >/dev/null 2>&1
    wait_file "$T/launched.$SID_A"; assert_eq switch_fallback:launched 0 "$?"
    assert_contains switch_fallback:log "$(fetch_log)" "switch-resume sid=$SID_A via=sig"

    sw_stale_setup
    seed_home ""
    sw_marker "$SID_A" "" 0
    sw_signal 60 "$FP_A" 0 token
    run_coord --once >/dev/null 2>&1
    sleep 1
    assert_no_file switch_fallback:paused-after-signal "$T/launched.$SID_A"

    sw_stale_setup
    seed_home ""
    sw_marker "$SID_A" ""
    sw_signal 1800 "$FP_A" 0 token
    run_coord --once >/dev/null 2>&1
    sleep 1
    assert_no_file switch_fallback:expired-signal "$T/launched.$SID_A"
}

test_coord_switch_fallback_fp_mismatch() {
    sw_stale_setup
    seed_home ""
    make_stub_bin "$STUB" tokB '{}' 1
    sw_marker "$SID_A" ""
    patch_marker "$SID_A" ".cred_fp = \"$FP_A\" | .paused_at = $(date +%s)"
    sw_signal 60 - 0 token
    run_coord --once >/dev/null 2>&1
    wait_file "$T/launched.$SID_A"; assert_eq switch_fp_mismatch:launched 0 "$?"

    sw_stale_setup
    seed_home ""
    make_stub_bin "$STUB" tokB '{}' 1
    sw_marker "$SID_A" ""
    patch_marker "$SID_A" ".cred_fp = \"$FP_A\" | .paused_at = $(date +%s)"
    run_coord --once >/dev/null 2>&1
    sleep 1
    assert_no_file switch_fp_mismatch:no-signal "$T/launched.$SID_A"
}

test_coord_account_check_drops_old_cache() {
    coord_setup 99
    seed_home uuid-B
    local d="$IBL5_USAGE_GATE_STATE_DIR" out
    acct_hash uuid-A > "$d/acct-last"
    sw_marker "$SID_A" uuid-A
    out=$(run_coord --once --dry-run 2>&1)
    assert_contains acct_coord:dry-zone "$out" "ZONE stop"
    assert_file acct_coord:dry-keeps-cache "$d/cache.json"
    run_coord --once >/dev/null 2>&1
    wait_file "$T/launched.$SID_A"; assert_eq acct_coord:launched 0 "$?"
    assert_no_file acct_coord:cache-dropped "$d/cache.json"
    assert_contains acct_coord:log "$(fetch_log)" "account-switch cache-dropped"
}

# ---------------------------------------------------------------- stale / switch DMs

dm_text() { cat "$T/dm.txt" 2>/dev/null; }

test_coord_switch_dm_once() {
    sw_stale_setup
    seed_home uuid-B
    sw_marker "$SID_A" uuid-A
    sw_marker "$SID_B" uuid-A
    sw_signal 30 - 1 account
    run_coord --once >/dev/null 2>&1
    wait_file "$T/launched.$SID_B"
    assert_contains switch_dm:text "$(dm_text)" \
        "usage-gate: login switch detected; resumed 2 session(s) paused under the previous account"
    patch_marker "$SID_A" 'del(.resuming_pid)'
    patch_marker "$SID_B" 'del(.resuming_pid)'
    run_coord --once >/dev/null 2>&1
    sleep 1
    assert_eq switch_dm:once 1 "$(grep -c 'login switch detected; resumed' "$T/dm.txt")"
}

test_coord_switch_dm_ignores_stale_throttle() {
    sw_stale_setup
    seed_home uuid-B
    sw_marker "$SID_A" uuid-A
    sw_signal 30 - 1 account
    printf '%s\n' "$(( $(date +%s) - 60 ))" > "$IBL5_USAGE_GATE_STATE_DIR/dm-stale-at"
    run_coord --once >/dev/null 2>&1
    wait_file "$T/launched.$SID_A"
    assert_contains switch_dm_throttle:sent "$(dm_text)" "login switch detected; resumed 1 session(s)"
}

test_coord_stale_dm_backoff_armed() {
    coord_setup 97
    rm -f "$IBL5_USAGE_GATE_STATE_DIR/cache.json"
    seed_home ""
    sw_marker "$SID_A" ""
    printf '%s 1\n' "$(( $(date +%s) + 600 ))" > "$IBL5_USAGE_GATE_STATE_DIR/fetch-backoff"
    run_coord --once >/dev/null 2>&1
    assert_contains stale_dm_bo:text "$(dm_text)" \
        "usage-gate: no usage reading; 1 session(s) waiting. Usage fetch is backing off after a 429 until"
    case "$(dm_text)" in
        *"Run any interactive"*) fail stale_dm_bo:no-prompt-advice "found prompt advice" ;;
        *) pass stale_dm_bo:no-prompt-advice ;;
    esac
}

test_coord_stale_dm_no_backoff() {
    coord_setup 99
    seed_home ""
    seed_cache "$(( $(date +%s) - 400 ))" "$(usage_json 99 0)"
    sw_marker "$SID_A" ""
    run_coord --once >/dev/null 2>&1
    assert_contains stale_dm_nobo:text "$(dm_text)" "s old; 1 session(s) waiting. Run any interactive claude prompt to refresh the cache."
    case "$(dm_text)" in
        *"-1s"*) fail stale_dm_nobo:no-minus-one "found -1s" ;;
        *) pass stale_dm_nobo:no-minus-one ;;
    esac
}

test_coord_stale_dm_names_switch() {
    coord_setup 97
    rm -f "$IBL5_USAGE_GATE_STATE_DIR/cache.json"
    seed_home ""
    sw_marker "$SID_A" "" 0
    sw_signal 60 - 0 token
    run_coord --once >/dev/null 2>&1
    assert_contains stale_dm_switch:names "$(dm_text)" "login switch detected at"
    assert_contains stale_dm_switch:count "$(dm_text)" "1 session(s) waiting"
}

test_coord_stale_dm_dry_run() {
    coord_setup 97
    rm -f "$IBL5_USAGE_GATE_STATE_DIR/cache.json"
    seed_home ""
    sw_marker "$SID_A" ""
    printf '%s 1\n' "$(( $(date +%s) + 600 ))" > "$IBL5_USAGE_GATE_STATE_DIR/fetch-backoff"
    local out
    out=$(run_coord --once --dry-run 2>&1)
    assert_contains stale_dm_dry:action "$out" "ACTION dm usage-gate: no usage reading;"
    assert_no_file stale_dm_dry:no-throttle-write "$IBL5_USAGE_GATE_STATE_DIR/dm-stale-at"
}

# ---------------------------------------------------------------- marker fingerprints

test_marker_records_cred_fp() {
    new_env
    seed_home uuid-A
    local rbin="$T/resume.sh" f
    printf '#!/bin/sh\n' > "$rbin"; chmod +x "$rbin"
    f="$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
    elig_run tokA "usage_marker_write $SID_A plan-now '$rbin' usage-pause drain 95 five_hour 1790625600"
    assert_eq marker_fp:cred "$FP_A" "$(jq -r '.cred_fp' "$f")"
    assert_eq marker_fp:acct "$(acct_hash uuid-A)" "$(jq -r '.acct_fp' "$f")"
    assert_eq marker_fp:no-token 0 "$(grep -c -e tokA -e uuid-A "$f")"
    rm "$HOME/.claude.json"
    elig_run "" "usage_marker_write $SID_A plan-now '$rbin' usage-pause drain 95 five_hour 1790625600"
    assert_eq marker_fp:cred-null null "$(jq -r '.cred_fp' "$f")"
    assert_eq marker_fp:acct-null null "$(jq -r '.acct_fp' "$f")"
}

test_marker_cred_switched() {
    elig_marker usage-pause 60 "$FP_A"
    elig_run tokA "usage_marker_cred_switched $SID_A"
    assert_eq marker_switched:same 1 "$?"
    elig_run tokB "usage_marker_cred_switched $SID_A"
    assert_eq marker_switched:differs 0 "$?"
    elig_run tokB "usage_marker_cred_switched ../x"
    assert_eq marker_switched:bad-sid 1 "$?"
    elig_run "" "usage_marker_cred_switched $SID_A"
    assert_eq marker_switched:no-keychain 1 "$?"
}

test_switch_never_stores_secrets() {
    sw_stale_setup
    seed_home uuid-B
    make_stub_http "$STUB" tokB 429 "$RL_BODY" 3598
    sw_marker "$SID_A" uuid-A
    acct_hash uuid-A > "$IBL5_USAGE_GATE_STATE_DIR/acct-last"
    seed_cache_fp "$(date +%s)" "$BODY_A" "$FP_A"
    run_coord --once >/dev/null 2>&1
    wait_file "$T/launched.$SID_A"
    assert_eq never_secrets:state "" "$(grep -rl -e tokB -e uuid-B -e uuid-A "$IBL5_USAGE_GATE_STATE_DIR" 2>/dev/null)"
}

# ---------------------------------------------------------------- test-mode seam

# stub_security_recorder <stubdir>: `security` shim that counts calls in <stubdir>/security.calls.
stub_security_recorder() {
    mkdir -p "$1"
    printf '#!/bin/sh\necho call >> "%s/security.calls"\necho '"'"'{"claudeAiOauth":{"accessToken":"tok"}}'"'"'\n' "$1" > "$1/security"
    chmod +x "$1/security"
}

security_calls() {  # <stubdir>
    if [ -f "$1/security.calls" ]; then wc -l < "$1/security.calls" | tr -d ' '; else echo 0; fi
}

# real_default_dir: the default state dir for the current (fake) HOME.
real_default_dir() {
    printf '%s\n' "$HOME/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/usage-gate"
}

test_testmode_unset_is_legacy() {
    new_env
    make_stub_bin "$STUB" tok "$BODY_B"; stub_security_recorder "$STUB"
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    local out rc
    out=$(unset IBL5_USAGE_GATE_TEST_MODE; PATH="$STUB:$ORIG_PATH" bash -c ". '$REPO_ROOT/bin/lib/usage-fetch.sh'; usage_fetch 45"); rc=$?
    assert_eq testmode_unset:rc 0 "$rc"
    assert_eq testmode_unset:body 77.0 "$(printf '%s' "$out" | jq -r .five_hour.utilization)"
    assert_eq testmode_unset:curl 1 "$(curl_calls "$STUB")"
    [ "$(security_calls "$STUB")" -ge 1 ] && pass testmode_unset:security || fail testmode_unset:security "no keychain read"
}

test_testmode_empty_is_legacy() {
    new_env
    make_stub_bin "$STUB" tok "$BODY_B"; stub_security_recorder "$STUB"
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    local out rc
    out=$(IBL5_USAGE_GATE_TEST_MODE='' PATH="$STUB:$ORIG_PATH" bash -c ". '$REPO_ROOT/bin/lib/usage-fetch.sh'; usage_fetch 45"); rc=$?
    assert_eq testmode_empty:rc 0 "$rc"
    assert_eq testmode_empty:body 77.0 "$(printf '%s' "$out" | jq -r .five_hour.utilization)"
    assert_eq testmode_empty:curl 1 "$(curl_calls "$STUB")"
}

test_testmode_stale_cache_no_live_fetch() {
    new_env
    make_stub_bin "$STUB" tok "$BODY_B"; stub_security_recorder "$STUB"
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    local before out rc
    before=$(cat "$IBL5_USAGE_GATE_STATE_DIR/cache.json")
    out=$(IBL5_USAGE_GATE_TEST_MODE=1 PATH="$STUB:$ORIG_PATH" bash -c ". '$REPO_ROOT/bin/lib/usage-fetch.sh'; usage_fetch 45"); rc=$?
    assert_eq testmode_stale:rc 2 "$rc"
    assert_eq testmode_stale:body 41.0 "$(printf '%s' "$out" | jq -r .five_hour.utilization)"
    assert_eq testmode_stale:curl 0 "$(curl_calls "$STUB")"
    assert_eq testmode_stale:security 0 "$(security_calls "$STUB")"
    assert_contains testmode_stale:log "$(cat "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log" 2>/dev/null)" "fetch-skipped reason=test-mode"
    assert_eq testmode_stale:cache-unchanged "$before" "$(cat "$IBL5_USAGE_GATE_STATE_DIR/cache.json")"
}

test_testmode_no_cache_fail_open() {
    new_env
