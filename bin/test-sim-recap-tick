# ── prompt_roster_block_is_minified_and_omits_games ──────────────────────────
_rb_line=$(awk '/wrong for anyone traded since/ {n=NR+2} n && NR==n {print; exit}' "$STUB/prompt.out")
if [ -n "$_rb_line" ] \
    && jq -e 'has("roster") and has("active_injuries") and (has("games") | not)' \
        >/dev/null 2>&1 <<< "$_rb_line" \
    && [ "$(printf '%s' "$_rb_line" | wc -l | tr -d ' ')" = "0" ]; then
    srt_ok "prompt_roster_block_is_minified_and_omits_games"
else
    srt_fail "prompt_roster_block_is_minified_and_omits_games — got: ${_rb_line:-<none>}"
fi

# ── prompt_contract_requests_prose_json_only ─────────────────────────────────
if grep -qF -- "prose.json" "$STUB/prompt.out" \
    && ! grep -qF -- "Write payload.json" "$STUB/prompt.out"; then
    srt_ok "prompt_contract_requests_prose_json_only — prose.json named, payload.json not requested"
else
    srt_fail "prompt_contract_requests_prose_json_only — prose.json absent or payload.json still requested"
fi

