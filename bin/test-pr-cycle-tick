no_file "$STATE_DIR/attempts" || fail "dry-run-patchid-inert: wrote attempts/"
no_file "$STATE_DIR/pending" || fail "dry-run-patchid-inert: wrote pending/"
[[ -z "$(pr_refs)" ]] || fail "dry-run-patchid-inert: left refs/pr-cycle refs: $(pr_refs)"
end_case dry-run-patchid-inert

# The real git default, no network: a local bare repo is origin.
reset; begin_case
BARE="$SCRATCH/rg-origin.git"; W="$SCRATCH/rg-work"; C="$SCRATCH/rg-consumer"
RGLIB="$SCRIPT_DIR/lib/pr-cycle-watch.sh"
wg() { git -C "$W" "$@"; }
sub() { sed "s/^$2\$/$3/" "$W/$1" > "$W/$1.tmp" && mv "$W/$1.tmp" "$W/$1"; }
git init -q --bare -b master "$BARE"
git init -q -b master "$W"
wg config user.email t@t.invalid; wg config user.name t; wg config commit.gpgsign false
wg remote add origin "$BARE"
seq 1 20 | sed 's/^/l/' > "$W/a.txt"; echo x > "$W/b.txt"
wg add -A; wg commit -qm base
wg checkout -q -b p7
sub a.txt l10 l10-pr; wg commit -qam p7
P7="$(wg rev-parse HEAD)"
wg checkout -q master
wg push -q origin master p7:refs/pull/7/head
echo y > "$W/b.txt"; wg commit -qam m2; wg push -q origin master
wg checkout -q -b p8 master; wg cherry-pick "$P7" >/dev/null; wg push -q origin p8:refs/pull/8/head
wg checkout -q -b p9 master; sub a.txt l10 l10-other; wg commit -qam p9; wg push -q origin p9:refs/pull/9/head
wg checkout -q master; sub a.txt l8 l8-m; wg commit -qam m3; wg push -q origin master
wg checkout -q -b p10 master; wg cherry-pick "$P7" >/dev/null; wg push -q origin p10:refs/pull/10/head
git clone -q "$BARE" "$C"
(
    unset PR_CYCLE_PATCH_ID_CMD
    # shellcheck source=bin/lib/pr-cycle-watch.sh
    source "$RGLIB"
    pcw_patch_id "$C" 7 > "$SCRATCH/rg-id7"
    pcw_patch_id "$C" 8 > "$SCRATCH/rg-id8"
    pcw_patch_id "$C" 9 > "$SCRATCH/rg-id9"
    pcw_patch_id "$C" 10 > "$SCRATCH/rg-id10"
    pcw_patch_id "$C" 404 > "$SCRATCH/rg-id404"
    pcw_patch_id "$C" 'x;y' > "$SCRATCH/rg-idxy"
)
id7="$(cat "$SCRATCH/rg-id7")"; id8="$(cat "$SCRATCH/rg-id8")"
id9="$(cat "$SCRATCH/rg-id9")"; id10="$(cat "$SCRATCH/rg-id10")"
[[ "$id7" =~ ^[0-9a-f]{40}$ ]] || fail "patch-id-real-git: id7 '$id7' is not 40 hex"
[[ "$id8" == "$id7" ]] || fail "patch-id-real-git: a clean rebase changed the id ($id8 != $id7)"
[[ "$id9" != "$id7" ]] || fail "patch-id-real-git: a content change kept the id"
[[ "$id10" != "$id7" ]] || fail "patch-id-real-git: an edit inside the hunk's context kept the id (documented limit)"
[[ "$(wc -c < "$SCRATCH/rg-id404" | tr -d ' ')" == "0" ]] || fail "patch-id-real-git: unknown PR 404 printed something"
[[ "$(wc -c < "$SCRATCH/rg-idxy" | tr -d ' ')" == "0" ]] || fail "patch-id-real-git: non-numeric PR printed something"
[[ "$(git -C "$C" for-each-ref refs/pr-cycle | wc -l | tr -d ' ')" == "4" ]] \
    || fail "patch-id-real-git: want refs 7..10 only, got: $(git -C "$C" for-each-ref refs/pr-cycle)"
(
    # shellcheck source=bin/lib/pr-cycle-watch.sh
    source "$RGLIB"
    pcw_drop_pr_ref "$C" 7
)
git -C "$C" rev-parse -q --verify refs/pr-cycle/7 >/dev/null 2>&1 && fail "patch-id-real-git: pcw_drop_pr_ref left refs/pr-cycle/7"
git -C "$C" rev-parse -q --verify refs/pr-cycle/8 >/dev/null 2>&1 || fail "patch-id-real-git: pcw_drop_pr_ref swept refs/pr-cycle/8"
(
    # shellcheck source=bin/lib/pr-cycle-watch.sh
    source "$RGLIB"
    pcw_drop_pr_ref "$C" 8; pcw_drop_pr_ref "$C" 9; pcw_drop_pr_ref "$C" 10
)
[[ -z "$(git -C "$C" for-each-ref refs/pr-cycle)" ]] || fail "patch-id-real-git: refs left after dropping all: $(git -C "$C" for-each-ref refs/pr-cycle)"
# Tick wiring, dry-run: the real default against a local origin.
git -C "$REPO" remote add origin "$BARE"
E_PATCHID="$UNSET"
p7sha="$(git ls-remote "$BARE" refs/pull/7/head | cut -f1)"
set_prs "7|p7|$p7sha|BLOCKED|false"; set_checks "$p7sha" red
run_tick --dry-run
out_has 'would run:' || fail "patch-id-real-git: dry-run did not qualify PR 7: $OUT"
out_has 'patch-id unavailable' && fail "patch-id-real-git: the tick fell back despite a reachable origin: $OUT"
[[ -z "$(pr_refs)" ]] || fail "patch-id-real-git: dry-run left refs/pr-cycle refs: $(pr_refs)"
no_file "$STATE_DIR/pending" || fail "patch-id-real-git: dry-run wrote pending/"
git -C "$REPO" remote remove origin
end_case patch-id-real-git

# master-tip-seam: unset and empty PR_CYCLE_MASTER_TIP_CMD both select the git default; a
# junk, empty, or failing seam prints nothing and still returns 0.
reset; begin_case
MT="$SCRATCH/mt-repo"; MTB="$SCRATCH/mt-bare-repo"
git init -q -b master "$MT"; git init -q -b master "$MTB"
for r in "$MT" "$MTB"; do
    git -C "$r" config user.email t@t.invalid; git -C "$r" config user.name t
    git -C "$r" config commit.gpgsign false
    git -C "$r" commit -q --allow-empty -m one
done
git -C "$MT" update-ref refs/remotes/origin/master HEAD
MT_SHA="$(git -C "$MT" rev-parse HEAD)"
set_tip e0002
(
    # shellcheck source=bin/lib/pr-cycle-watch.sh
    source "$RGLIB"
    unset PR_CYCLE_MASTER_TIP_CMD
    pcw_master_tip "$MT" > "$SCRATCH/mt-unset"
    pcw_master_tip "$MTB" > "$SCRATCH/mt-unset-bare"
    PR_CYCLE_MASTER_TIP_CMD=""
    pcw_master_tip "$MT" > "$SCRATCH/mt-empty"
    pcw_master_tip "$MTB" > "$SCRATCH/mt-empty-bare"
    PR_CYCLE_MASTER_TIP_CMD="$SCRATCH/mastertip-file"
    pcw_master_tip "$MT" > "$SCRATCH/mt-file"
    PR_CYCLE_MASTER_TIP_CMD="$SCRATCH/mastertip-empty"
    pcw_master_tip "$MT" > "$SCRATCH/mt-seam-empty"; echo "$?" > "$SCRATCH/mt-seam-empty-rc"
    PR_CYCLE_MASTER_TIP_CMD="$SCRATCH/mastertip-junk"
    pcw_master_tip "$MT" > "$SCRATCH/mt-seam-junk"; echo "$?" > "$SCRATCH/mt-seam-junk-rc"
    PR_CYCLE_MASTER_TIP_CMD=false
    pcw_master_tip "$MT" > "$SCRATCH/mt-seam-false"; echo "$?" > "$SCRATCH/mt-seam-false-rc"
)
[[ "$(cat "$SCRATCH/mt-unset")" == "$MT_SHA" ]] || fail "master-tip-seam: unset did not select the git default"
[[ "$(cat "$SCRATCH/mt-empty")" == "$MT_SHA" ]] || fail "master-tip-seam: empty did not select the git default"
[[ "$(wc -c < "$SCRATCH/mt-unset-bare" | tr -d ' ')" == "0" ]] || fail "master-tip-seam: unset printed for a repo with no origin/master"
[[ "$(wc -c < "$SCRATCH/mt-empty-bare" | tr -d ' ')" == "0" ]] || fail "master-tip-seam: empty printed for a repo with no origin/master"
[[ "$(cat "$SCRATCH/mt-file")" == "$(key_of e0002)" ]] || fail "master-tip-seam: seam file tip not printed"
for m in seam-empty seam-junk seam-false; do
    [[ "$(wc -c < "$SCRATCH/mt-$m" | tr -d ' ')" == "0" ]] || fail "master-tip-seam: $m printed something"
    [[ "$(cat "$SCRATCH/mt-$m-rc")" == "0" ]] || fail "master-tip-seam: $m returned non-zero"
done
end_case master-tip-seam

# conflict-retry-due-codes: 1 no hold, 2 same or malformed tip, 0 new tip under the cap,
# 3 at the cap, 0 again on a new day, `unknown` hold eligible, cleared hold back to 1.
reset; begin_case
CRD="$SCRATCH/crd"; rm -rf "$CRD"; mkdir -p "$CRD"
(
    # shellcheck source=bin/lib/pr-cycle-watch.sh
    source "$RGLIB"
    T1="$(key_of e0001)"; T2="$(key_of e0002)"
    rc() { local r=0; "$@" || r=$?; printf '%s' "$r"; }
    {
        rc pcw_conflict_retry_due "$CRD" 5 "$T2" 2026-10-19
        pcw_record_conflict_hold "$CRD" 5 "$T1"
        rc pcw_conflict_retry_due "$CRD" 5 "$T1" 2026-10-19
        rc pcw_conflict_retry_due "$CRD" 5 "$T2" 2026-10-19
        rc pcw_conflict_retry_due "$CRD" 5 not-a-sha 2026-10-19
        pcw_bump_retry "$CRD" 5 2026-10-19; pcw_bump_retry "$CRD" 5 2026-10-19
        rc pcw_conflict_retry_due "$CRD" 5 "$T2" 2026-10-19
        rc pcw_conflict_retry_due "$CRD" 5 "$T2" 2026-10-20
        pcw_record_conflict_hold "$CRD" 6 ""
        rc pcw_conflict_retry_due "$CRD" 6 "$T2" 2026-10-19
        pcw_clear_conflict_hold "$CRD" 5
        rc pcw_conflict_retry_due "$CRD" 5 "$T2" 2026-10-19
    } > "$SCRATCH/crd-codes"
    cat "$CRD/conflict-hold/6" > "$SCRATCH/crd-hold6"
)
[[ "$(cat "$SCRATCH/crd-codes")" == "12023001" ]] || fail "conflict-retry-due-codes: want 1,2,0,2,3,0,0,1 got $(cat "$SCRATCH/crd-codes")"
[[ "$(cat "$SCRATCH/crd-hold6")" == "unknown" ]] || fail "conflict-retry-due-codes: empty tip did not record unknown"
end_case conflict-retry-due-codes

# prune-conflict-ledgers: pcw_prune drops the new ledgers of a closed PR (999), keeps PR 101's.
reset; begin_case
for l in conflict-hold retries; do
    mkdir -p "$STATE_DIR/$l"; echo x > "$STATE_DIR/$l/999"; echo x > "$STATE_DIR/$l/101"
done
set_prs '101|branch-one|aaa1111|CLEAN|false'; set_checks aaa1111 green
run_tick
for l in conflict-hold retries; do
    no_file "$STATE_DIR/$l/999" || fail "prune-conflict-ledgers: $l/999 survived"
    [[ -f "$STATE_DIR/$l/101" ]] || fail "prune-conflict-ledgers: $l/101 was pruned"
done
end_case prune-conflict-ledgers

# conflict-hold-launch-tip: the tip captured at launch rides the pending row and is what
# settle records, even though master moved before the rescue settled.
reset; begin_case
set_prs '101|branch-one|aaa1111|DIRTY|false'
set_tip e0001
set_result "101\tfired\tconflict\trebase-conflict"
run_tick
PF="$(find "$STATE_DIR/pending" -type f | head -n 1)"
[[ "$(sed -n '2p' "$PF" | awk -F'\t' '{print NF}')" == "4" ]] \
    || fail "conflict-hold-launch-tip: pending row is not 4 fields: $(sed -n '2p' "$PF")"
[[ "$(sed -n '2p' "$PF" | cut -f4)" == "$(key_of e0001)" ]] \
    || fail "conflict-hold-launch-tip: pending tip is '$(sed -n '2p' "$PF" | cut -f4)'"
set_tip e0002
run_tick
[[ "$(conflict_hold 101)" == "$(key_of e0001)" ]] \
    || fail "conflict-hold-launch-tip: held tip is '$(conflict_hold 101)', want the launch tip"
out_has 'PR 101: conflict hold recorded (master e000100)' \
    || fail "conflict-hold-launch-tip: no hold log line: $OUT"
end_case conflict-hold-launch-tip

# conflict-hold-cleared-by-later-settle: a determinate later outcome clears the hold, a
# paused rescue (which never ran) keeps it. The seeded hold is the only hand-written state.
reset; begin_case
mkdir -p "$STATE_DIR/conflict-hold"; key_of e0009 > "$STATE_DIR/conflict-hold/101"
set_prs '101|branch-one|aaa1111|DIRTY|false'
set_result "101\tfired\theld\t-"
run_tick
run_tick
[[ -z "$(conflict_hold 101)" ]] || fail "conflict-hold-cleared-by-later-settle: held settle kept the hold: '$(conflict_hold 101)'"
end_case conflict-hold-cleared-by-later-settle

reset; begin_case
mkdir -p "$STATE_DIR/conflict-hold"; key_of e0009 > "$STATE_DIR/conflict-hold/101"
set_prs '101|branch-one|aaa1111|DIRTY|false'
set_result "101\tfired\tpaused\t-"
run_tick
run_tick
[[ "$(conflict_hold 101)" == "$(key_of e0009)" ]] \
    || fail "conflict-hold-kept-by-paused-settle: paused settle dropped the hold: '$(conflict_hold 101)'"
end_case conflict-hold-kept-by-paused-settle

# pending-legacy-3col (invocation-2-only: legacy files exist only on disk): a pending row
# written before the master-tip column still settles, records the attempt, and records the
# hold as unknown.
reset; begin_case
mkdir -p "$STATE_DIR/pending" "$STATE_DIR/results"
printf '# result=%s started=%s\n101\taaa1111\t%s\n' \
    "$STATE_DIR/results/legacy1.tsv" "$(date +%s)" "$(key_of aaa1111)" > "$STATE_DIR/pending/legacy1"
printf '# pr-cycle-result v1\n101\tfired\tconflict\trebase-conflict\n' > "$STATE_DIR/results/legacy1.tsv"
set_prs '101|branch-one|aaa1111|DIRTY|false'
run_tick
[[ "$(attempt 101)" == "$(key_of aaa1111)" ]] || fail "pending-legacy-3col: attempt is '$(attempt 101)'"
[[ "$(conflict_hold 101)" == "unknown" ]] || fail "pending-legacy-3col: hold is '$(conflict_hold 101)', want unknown"
no_file "$STATE_DIR/pending/legacy1" || fail "pending-legacy-3col: legacy pending file survived"
end_case pending-legacy-3col

# --- conflict re-try on a new master tip ---------------------------------------------------
# Every flow runs real ticks: tick N launches, the stub hands tick N+1 the canned result, and
# tick N+1 settles it and then qualifies.
TODAY_STR="$(date +%F)"
DIRTY101='101|branch-one|aaa1111|DIRTY|false'
WAIT_NOTE='skip PR 101: retry cap (head aaa1111; rebase conflict, waiting for a new master tip)'
CAP_NOTE='skip PR 101: retry cap (head aaa1111; rebase conflict, daily cap of 2 launches reached)'

# conflict-same-tip-skipped (+ conflict-new-tip-launched, conflict-third-launch-skipped,
# conflict-day-rollover as one continuing flow)
reset; begin_case
set_prs "$DIRTY101"; set_result "101\tfired\tconflict\trebase-conflict"
set_tip e0001
run_tick
[[ "$(launch_count)" == "1" ]] || fail "conflict-same-tip-skipped: tick 1 launches $(launch_count), want 1"
run_tick
[[ "$(launch_count)" == "1" ]] || fail "conflict-same-tip-skipped: relaunched on an unchanged tip"
out_has "$WAIT_NOTE" || fail "conflict-same-tip-skipped: no waiting note: $OUT"
end_case conflict-same-tip-skipped

reset; begin_case
set_prs "$DIRTY101"; set_result "101\tfired\tconflict\trebase-conflict"
set_tip e0001
run_tick
set_tip e0002
run_tick
[[ "$(launch_count)" == "2" ]] || fail "conflict-new-tip-launched: launches $(launch_count), want 2"
[[ "$(retries 101)" == "$TODAY_STR 2" ]] || fail "conflict-new-tip-launched: retries/101 is '$(retries 101)'"
end_case conflict-new-tip-launched

reset; begin_case
set_prs "$DIRTY101"; set_result "101\tfired\tconflict\trebase-conflict"
set_tip e0001
run_tick
set_tip e0002
run_tick
set_tip e0003
run_tick
[[ "$(launch_count)" == "2" ]] || fail "conflict-third-launch-skipped: launches $(launch_count), want 2"
out_has "$CAP_NOTE" || fail "conflict-third-launch-skipped: no daily-cap note: $OUT"
# conflict-day-rollover (invocation-2-only for the date: no seam fakes the clock): a stale-dated
# counter at the cap reads as 0.
printf '2000-01-01 2\n' > "$STATE_DIR/retries/101"
set_tip e0004
run_tick
[[ "$(launch_count)" == "3" ]] || fail "conflict-day-rollover: launches $(launch_count), want 3"
[[ "$(retries 101)" == "$TODAY_STR 1" ]] || fail "conflict-day-rollover: retries/101 is '$(retries 101)'"
end_case conflict-third-launch-skipped

# non-conflict-new-tip-skipped: a later held or failed settle clears the hold, and a red PR is
# never a conflict hold, so a new master tip reopens none of them.
for oc in "held\t-" "failed\tterminal=x"; do
    reset; begin_case
    mkdir -p "$STATE_DIR/conflict-hold"; key_of e0009 > "$STATE_DIR/conflict-hold/101"
    set_prs "$DIRTY101"; set_result "101\tfired\t$oc"
    set_tip e0001
    run_tick
    set_tip e0002
    run_tick
    [[ "$(launch_count)" == "1" ]] || fail "non-conflict-new-tip-skipped($oc): relaunched on a new tip"
    out_has 'skip PR 101: retry cap (head aaa1111)' || fail "non-conflict-new-tip-skipped($oc): no plain note: $OUT"
    out_has 'rebase conflict' && fail "non-conflict-new-tip-skipped($oc): conflict wording on a non-conflict hold"
    end_case non-conflict-new-tip-skipped
done
reset; begin_case
set_prs "$RED101"; set_checks aaa1111 red; set_result "101\tfired\tconflict\trebase-conflict"
set_tip e0001
run_tick
set_tip e0002
run_tick
[[ "$(launch_count)" == "1" ]] || fail "non-conflict-new-tip-skipped(red): relaunched on a new tip"
out_has 'skip PR 101: retry cap (head aaa1111)' || fail "non-conflict-new-tip-skipped(red): no plain note: $OUT"
out_has 'rebase conflict' && fail "non-conflict-new-tip-skipped(red): conflict wording on a red PR"
end_case non-conflict-new-tip-skipped

# conflict-declined-still-skipped (invocation-2-only: a state reachable only across many runs):
# the bypass opens only the attempted-key skip, the declined skip still holds.
reset; begin_case
mkdir -p "$STATE_DIR/attempts" "$STATE_DIR/declined" "$STATE_DIR/conflict-hold"
key_of aaa1111 > "$STATE_DIR/attempts/101"; key_of aaa1111 > "$STATE_DIR/declined/101"
key_of e0001 > "$STATE_DIR/conflict-hold/101"
set_prs "$DIRTY101"
set_tip e0002
run_tick
no_file "$SCRATCH/pr-cycle.log" || fail "conflict-declined-still-skipped: launched a declined head"
out_has 'holdrepeat declined (head aaa1111)' || fail "conflict-declined-still-skipped: no declined note: $OUT"
end_case conflict-declined-still-skipped

# conflict-tip-unset-and-empty: an unset or empty seam selects the git default, the fixture has
# no refs/remotes/origin/master, and an unreadable tip never opens the bypass.
for mode in unset empty junk; do
    reset; begin_case
    set_prs "$DIRTY101"; set_result "101\tfired\tconflict\trebase-conflict"
    set_tip e0001
    run_tick
    case "$mode" in
        unset) E_MASTERTIP="$UNSET" ;;
        empty) E_MASTERTIP="" ;;
        junk)  E_MASTERTIP="$SCRATCH/mastertip-junk" ;;
    esac
    run_tick
    [[ "$(launch_count)" == "1" ]] || fail "conflict-tip-unset-and-empty($mode): relaunched without a readable tip"
    out_has "$WAIT_NOTE" || fail "conflict-tip-unset-and-empty($mode): no waiting note: $OUT"
    end_case conflict-tip-unset-and-empty
done

# conflict-dry-run-no-ledger: an eligible conflict PR prints would-run and writes nothing.
reset; begin_case
set_prs "$DIRTY101"; set_result "101\tfired\tconflict\trebase-conflict"
set_tip e0001
run_tick
run_tick
set_tip e0002
run_tick --dry-run
out_has 'would run:' || fail "conflict-dry-run-no-ledger: dry run did not qualify the PR: $OUT"
[[ "$(retries 101)" == "$TODAY_STR 1" ]] || fail "conflict-dry-run-no-ledger: retries/101 is '$(retries 101)'"
[[ "$(pending_count)" == "0" ]] || fail "conflict-dry-run-no-ledger: dry run wrote pending/"
[[ "$(launch_count)" == "1" ]] || fail "conflict-dry-run-no-ledger: dry run launched"
end_case conflict-dry-run-no-ledger

# --- summary -------------------------------------------------------------------------------
h_done
