#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-wt-gc-tick — regression harness for bin/wt-gc-tick (the scheduled
# merged-worktree sweep driver) and bin/wt-gc-cron-setup (its LaunchAgent
# plist emitter), plus the worktree-survival contract (ADR-0165): a real
# `bin/cleanup --all` driven by the tick reaps only the proven-merged
# worktree and leaves STALLED / UNPUSHED / OPEN-PR / EMPTY ones intact.
#
# Fully self-contained: every fixture is built under mktemp. Stub binaries on
# PATH replace gh, docker, launchctl; the tick's env seams point at argv-capture
# stubs for cleanup / wt-status / ioreg. Every run uses HOME=$ROOT/home and a
# per-case WT_GC_LOCK_DIR, so nothing writes to the real ~/.claude, and the
# docker stub always sits first on PATH so a real bin/cleanup can never touch
# real containers, volumes, or images.
#
# Prints `PASS <case-id>` or `FAIL <case-id>: <detail>` per case; exit 1 if any
# case fails.
#
# Env: WT_GC_TICK_UNDER_TEST  path of the tick to test (default: bin/wt-gc-tick)
#
# Run: bin/test-wt-gc-tick [--case NAME]...  (exit 0 = all pass, 1 = a case failed)
# --case runs only the named cases (repeatable); an unknown name fails the run.

set -u
# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TICK="${WT_GC_TICK_UNDER_TEST:-$SCRIPT_DIR/wt-gc-tick}"
CRON_SETUP="$SCRIPT_DIR/wt-gc-cron-setup"

# --case NAME (repeatable): run only the named cases. Shared fixtures and helpers between
# cases still run. A mutation-matrix row uses this to fit one case inside its 30s timeout.
# A name that matches no case fails the run, so a typo cannot pass as a green baseline.
ONLY_CASES=()
while [ $# -gt 0 ]; do
    case "$1" in
        --case)
            [ $# -ge 2 ] && [ -n "$2" ] || { echo "usage: $0 [--case NAME]..." >&2; exit 2; }
            ONLY_CASES+=("$2"); shift 2 ;;
        -*) echo "usage: $0 [--case NAME]... (unknown argument: $1)" >&2; exit 2 ;;
        *) ONLY_CASES+=("$1"); shift ;;   # bare case name, same as --case NAME
    esac
done
RAN_CASES=$'\n'
should_run() {  # $1 = case name; true when no --case was given or $1 was named
    [ ${#ONLY_CASES[@]} -eq 0 ] && return 0
    local c
    for c in "${ONLY_CASES[@]}"; do
        if [ "$c" = "$1" ]; then RAN_CASES+="$1"$'\n'; return 0; fi
    done
    return 1
}
check_only_cases() {  # fail every --case name that matched no case
    local c
    for c in ${ONLY_CASES[@]+"${ONLY_CASES[@]}"}; do
        [[ "$RAN_CASES" == *$'\n'"$c"$'\n'* ]] || h_fail "unknown --case name: $c (no case ran)"
    done
}

# A literal docker path in the tick or its library would bypass the PATH stub
# and reach the real CLI, so refuse to run at all.
if grep -nE '/bin/docker' "$TICK" "$(dirname "$TICK")/lib/wt-gc-reap.sh" >&2; then
    echo "ABORT: the tick under test names a docker binary path; a case could prune for real" >&2
    exit 2
fi

ROOT="$(mktemp -d)"
ROOT="$(cd "$ROOT" && pwd -P)"   # physical path: git worktree list reports it
SLEEPER_PID=""
cleanup_root() {
    [ -n "$SLEEPER_PID" ] && kill "$SLEEPER_PID" 2>/dev/null
    chmod -R u+w "$ROOT" 2>/dev/null
    rm -rf "$ROOT" 2>/dev/null
}
trap cleanup_root EXIT

# shellcheck source=bin/lib/git-helpers.sh disable=SC1091
source "$SCRIPT_DIR/lib/git-helpers.sh"

CASE=""
CD=""
CASE_ERRS=""

mkdir -p "$ROOT/home"
STUBBIN="$ROOT/stubbin"
STUB_REPO="$ROOT/stubrepo"
mkdir -p "$STUBBIN" "$STUB_REPO"

# ── Stub binaries ─────────────────────────────────────────────────────────────
# cleanup-stub: argv one-per-line to $STUB_CASE_DIR/argv, pwd to .../cwd, prints
# a Summary line. STUB_CLEANED / STUB_SKIPPED / STUB_RC / STUB_NO_SUMMARY.
cat > "$STUBBIN/cleanup-stub" <<'SH'
#!/usr/bin/env bash
d="${STUB_CASE_DIR:?STUB_CASE_DIR unset}"
: > "$d/argv"
for a in "$@"; do printf '%s\n' "$a" >> "$d/argv"; done
pwd > "$d/cwd"
if [ -n "${STUB_SKIP_LINES:-}" ]; then cat "$STUB_SKIP_LINES"; fi
if [ "${STUB_NO_SUMMARY:-}" != 1 ]; then
    echo "Summary: ${STUB_CLEANED:-0} cleaned, ${STUB_SKIPPED:-3} skipped"
fi
exit "${STUB_RC:-0}"
SH

# wt-status-stub: the two header rows bin/wt-status emits, then fixed rows.
cat > "$STUBBIN/wt-status-stub" <<'SH'
#!/usr/bin/env bash
printf "%-12s %-30s %s\n" "STATUS" "WORKTREE" "DETAIL"
printf "%-12s %-30s %s\n" "------------" "------------------------------" "------"
printf "%-12s %-30s %s\n" "STALLED" "stalled-a" "(uncommitted/untracked work, never committed)"
printf "%-12s %-30s %s\n" "STALLED" "stalled-b" "(uncommitted/untracked work, never committed)"
printf "%-12s %-30s %s\n" "UNPUSHED" "unpushed-a" "(committed work, no PR)"
printf "%-12s %-30s %s\n" "EMPTY" "empty-a" "(no own commits, clean tree)"
printf "%-12s %-30s %s\n" "EMPTY" "empty-b" "(no own commits, clean tree)"
printf "%-12s %-30s %s\n" "EMPTY" "empty-c" "(no own commits, clean tree)"
printf "%-12s %-30s %s\n" "OPEN-PR" "open-a" "(PR #7)"
printf "%-12s %-30s %s\n" "MERGED" "merged-a" "(PR merged)"
SH

# ioreg-stub: HIDIdleTime in ns from STUB_IDLE seconds (default 7200). A
# non-numeric STUB_IDLE prints "nan": awk's int(nan/1e9) stays non-digit, whereas
# a bare word like abc coerces to 0 and would read as "operator present".
cat > "$STUBBIN/ioreg" <<'SH'
#!/bin/sh
case "${STUB_IDLE:-7200}" in
    *[!0-9]*) echo "\"HIDIdleTime\" = nan" ;;
    *)        echo "\"HIDIdleTime\" = $(( ${STUB_IDLE:-7200} * 1000000000 ))" ;;
esac
SH

# gh stub (survival case).
cat > "$STUBBIN/gh" <<'SH'
#!/usr/bin/env bash
[ "${1:-}" = pr ] || exit 1
sub="${2:-}"
case "$sub" in
    view)
        br="${3:-}"
        case "$*" in
            *"--json state,number,headRefOid"*) ;;
            *) exit 1 ;;
        esac
        # pr_info's combined TSV: state, number, headRefOid. headRefOid is
        # left empty, as the old stub never answered a headRefOid query.
        case "$br" in
            wt-merged) printf 'MERGED\t7\t\n' ;;
            wt-open)   printf 'OPEN\t7\t\n' ;;
            *)         exit 1 ;;
        esac ;;
    list) : ;;
    *) exit 1 ;;
esac
exit 0
SH

# docker stub: never touches a real daemon. Records argv (one call per line)
# to $STUB_CASE_DIR/docker-argv. STUB_DOCKER_INFO_RC / STUB_DOCKER_IMAGE_RC /
# STUB_DOCKER_RC set the exit codes of `info` / `image ...` / everything else.
cat > "$STUBBIN/docker" <<'SH'
#!/usr/bin/env bash
if [ -n "${STUB_CASE_DIR:-}" ]; then printf '%s\n' "$*" >> "$STUB_CASE_DIR/docker-argv"; fi
case "${1:-}" in
    info)  exit "${STUB_DOCKER_INFO_RC:-0}" ;;
    image) exit "${STUB_DOCKER_IMAGE_RC:-${STUB_DOCKER_RC:-0}}" ;;
    ps)
        if [ -n "${STUB_DOCKER_PS:-}" ] && [ -f "$STUB_DOCKER_PS" ]; then cat "$STUB_DOCKER_PS"; fi
        exit "${STUB_DOCKER_PS_RC:-0}" ;;
    inspect)
        last="${*: -1}"
        case " $* " in
            *" --format "*) f="${STUB_DOCKER_INSPECT_DIR:-/nonexistent}/$last.fmt" ;;
            *) f="${STUB_DOCKER_INSPECT_DIR:-/nonexistent}/$last.json" ;;
        esac
        [ -f "$f" ] || exit 1
        cat "$f"; exit 0 ;;
    rm) exit "${STUB_DOCKER_RM_RC:-0}" ;;
esac
exit "${STUB_DOCKER_RC:-0}"
SH

# wt-status-rows: the two header rows, then the case's $STUB_WT_STATUS_ROWS.
cat > "$STUBBIN/wt-status-rows" <<'SH'
#!/usr/bin/env bash
printf "%-12s %-30s %s\n" "STATUS" "WORKTREE" "DETAIL"
printf "%-12s %-30s %s\n" "------------" "------------------------------" "------"
if [ -n "${STUB_WT_STATUS_ROWS:-}" ] && [ -f "$STUB_WT_STATUS_ROWS" ]; then cat "$STUB_WT_STATUS_ROWS"; fi
SH

# gh-stub (reap steps, via WT_GC_GH): answers `pr view <n|branch>` from
# $STUB_GH_DIR/<n>.json or $STUB_GH_DIR/by-head/<branch>.json, and
# `pr list --head <stem>` from by-head/<stem>.json, verbatim (--jq ignored).
# A missing fixture prints []. STUB_GH_FAIL=1 exits 1 with no stdout.
cat > "$STUBBIN/gh-stub" <<'SH'
#!/usr/bin/env bash
if [ -n "${STUB_CASE_DIR:-}" ]; then printf '%s\n' "$*" >> "$STUB_CASE_DIR/gh-argv"; fi
[ "${STUB_GH_FAIL:-}" = 1 ] && exit 1
d="${STUB_GH_DIR:-/nonexistent}"
key=""; sub="${2:-}"
if [ "${1:-}" = pr ] && [ "${2:-}" = view ]; then
    key="${3:-}"
    if [ -f "$d/$key.json" ]; then cat "$d/$key.json"; exit 0; fi
elif [ "${1:-}" = pr ] && [ "${2:-}" = list ]; then
    while [ $# -gt 0 ]; do
        if [ "$1" = --head ]; then key="${2:-}"; break; fi
        shift
    done
else
    exit 1
fi
if [ -n "$key" ] && [ -f "$d/by-head/$key.json" ]; then cat "$d/by-head/$key.json"; exit 0; fi
if [ "$sub" = list ]; then echo none; exit 0; fi
echo '[]'
SH

# discord-dm-stub (alert pass, via WT_GC_DISCORD_DM): appends its argv as one
# line to dm-argv, appends stdin plus a '---END---' line to dm-msg, and exits
# ${STUB_DM_RC:-0}.
cat > "$STUBBIN/discord-dm-stub" <<'SH'
#!/bin/bash
printf '%s\n' "$*" >> "$STUB_CASE_DIR/dm-argv"
{ cat; printf '\n---END---\n'; } >> "$STUB_CASE_DIR/dm-msg"
exit "${STUB_DM_RC:-0}"
SH
chmod +x "$STUBBIN/discord-dm-stub"

# launchctl-stub (reap steps, via WT_GC_LAUNCHCTL): `list` prints the file
# $STUB_LAUNCHCTL_LIST; anything else records argv and exits 1.
cat > "$STUBBIN/launchctl-stub" <<'SH'
#!/usr/bin/env bash
if [ "${1:-}" = list ]; then
    if [ -n "${STUB_LAUNCHCTL_LIST:-}" ]; then cat "$STUB_LAUNCHCTL_LIST"; fi
    exit 0
fi
if [ -n "${STUB_CASE_DIR:-}" ]; then printf '%s\n' "$*" >> "$STUB_CASE_DIR/launchctl-argv"; fi
exit 1
SH

# lsof stub (first on PATH and via WT_GC_LSOF): prints $STUB_LSOF_OUT;
# STUB_LSOF_ERR=1 writes an error and exits 1; else exits STUB_LSOF_RC (1).
cat > "$STUBBIN/lsof" <<'SH'
#!/usr/bin/env bash
if [ "${STUB_LSOF_ERR:-}" = 1 ]; then echo 'lsof: error' >&2; exit 1; fi
if [ -n "${STUB_LSOF_OUT:-}" ]; then cat "$STUB_LSOF_OUT"; fi
exit "${STUB_LSOF_RC:-1}"
SH

# launchctl stub (emitter cases): records argv, succeeds.
cat > "$STUBBIN/launchctl" <<SH
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "$ROOT/launchctl.calls"
exit 0
SH

chmod +x "$STUBBIN"/*

# ── Case plumbing ─────────────────────────────────────────────────────────────
begin_case() {
    CASE="$1"
    CD="$ROOT/$1"
    mkdir -p "$CD"
    CASE_ERRS=""
}

note_err() { CASE_ERRS="${CASE_ERRS:+$CASE_ERRS; }$1"; }

finish_case() {
    if [ -z "$CASE_ERRS" ]; then
        h_pass "$CASE"
    else
        h_fail "$CASE: $CASE_ERRS"
    fi
}

# chk <desc> <cmd...> — error unless the command succeeds.
chk() {
    local desc="$1"; shift
    "$@" >/dev/null 2>&1 || note_err "$desc"
}

# chk_not <desc> <cmd...> — error if the command succeeds.
chk_not() {
    local desc="$1"; shift
    if "$@" >/dev/null 2>&1; then note_err "$desc"; fi
}

# chk_rc <desc> <expected-rc> — compares against RC from the last run.
chk_rc() {
    [ "$RC" = "$2" ] || note_err "$1: rc=$RC, expected $2"
}

# fresh — wipe this case's state dir (stamp, lock, log).
fresh() { rm -rf "$CD/state"; }

LOG()   { printf '%s/state/wt-gc.log' "$CD"; }
final_line() { tail -n 1 "$(LOG)" 2>/dev/null; }

# log_has <ERE> / out_has <ERE> / err_has <ERE> — grep the last run's artifacts.
log_has() { grep -qE -- "$1" "$(LOG)" 2>/dev/null; }
err_has() { grep -qE -- "$1" "$CD/err" 2>/dev/null; }

# docker_guard <VAR=val ...> — the final env of one run. Aborts the whole
# suite before the run when that env could let the tick, its resolver or a
# real bin/cleanup reach a docker binary outside $ROOT (a real prune).
docker_guard() {
    local kv p="" dirs="" dk="" dk_set=0 d found bad=""
    for kv in "$@"; do
        case "$kv" in
            PATH=*)           p="${kv#PATH=}" ;;
            WT_GC_BIN_DIRS=*) dirs="${kv#WT_GC_BIN_DIRS=}" ;;
            WT_GC_DOCKER=*)   dk="${kv#WT_GC_DOCKER=}"; dk_set=1 ;;
        esac
    done
    if [ "$dk_set" = 1 ]; then
        case "$dk" in ''|"$ROOT"/*) ;; *) bad="WT_GC_DOCKER=$dk" ;; esac
    fi
    found="$(PATH="$p" command -v docker 2>/dev/null)" || found=""
    case "$found" in ''|"$ROOT"/*) ;; *) bad="${bad:+$bad; }PATH resolves $found" ;; esac
    local IFS=:
    for d in $dirs; do
        { [ -n "$d" ] && [ -e "$d/docker" ]; } || continue
        case "$d" in "$ROOT"/*) ;; *) bad="${bad:+$bad; }WT_GC_BIN_DIRS has $d/docker" ;; esac
    done
    if [ -n "$bad" ]; then
        printf 'ABORT %s: run could reach a real docker binary (%s)\n' "$CASE" "$bad" >&2
        exit 2
    fi
}

# run_tick [VAR=val ...] [-VAR ...] -- [tick args...]
# Runs the tick under `env -i` with the stub seams; overrides apply after the
# base set, and -VAR drops VAR from the env entirely. NOSTATE=1 (set as a
# prefix) omits WT_GC_LOCK_DIR so the default path resolves. Sets RC; stdout ->
# $CD/out, stderr -> $CD/err. Clears and then archives $CD/argv per run (all
# argv ever seen accumulate in $ROOT/all-argv). docker_guard vets every run.
run_tick() {
    local envs=() final=() drop=" " kv
    while [ $# -gt 0 ] && [ "$1" != "--" ]; do envs+=("$1"); shift; done
    if [ $# -gt 0 ]; then shift; fi
    local base=(
        PATH="$STUBBIN:$PATH"
        WT_GC_BIN_DIRS="$STUBBIN"
        HOME="$ROOT/home"
        STUB_CASE_DIR="$CD"
        WT_GC_IOREG="$STUBBIN/ioreg"
        WT_GC_CLEANUP="$STUBBIN/cleanup-stub"
        WT_GC_WT_STATUS="$STUBBIN/wt-status-stub"
        WT_GC_REPO_ROOT="$STUB_REPO"
        # Reap steps: off unless a case turns them on; every binary stubbed.
        WT_GC_REAP_EMPTY=0
        WT_GC_REAP_T3=0
        WT_GC_T3_ROOT="$CD/t3root"
        WT_GC_REAP_DIRTY_MERGED=0
        WT_GC_REAP_DIRTY_ARCHIVE=0
        WT_GC_REAP_DETACHED=0
        WT_GC_REAP_CLOSED=0
        WT_GC_REAP_LANDED=0
        WT_GC_REAP_UNBORN=0
        WT_GC_REAP_POOL_BRANCHES=0
        WT_GC_DROP_STASHES=0
        WT_GC_REF_FALLBACK=0
        WT_GC_REAP_REFS=0
        WT_GC_REAP_TMP_PACK=0
        WT_GC_DOCKER_PRUNE=0
        WT_GC_DOCKER_CONTAINERS=0
        STUB_DOCKER_PS="$CD/ps"
        STUB_DOCKER_INSPECT_DIR="$CD/insp"
        WT_GC_STALE_LIST=0
        WT_GC_ARCHIVE_PRUNE=0
        WT_GC_WT_REMOVE=/usr/bin/false
        WT_GC_LAUNCHCTL="$STUBBIN/launchctl-stub"
        WT_GC_DISCORD_DM="$STUBBIN/discord-dm-stub"
        IBL5_USAGE_GATE_STATE_DIR="$IBL5_USAGE_GATE_STATE_DIR"
        WT_GC_LSOF="$STUBBIN/lsof"
        WT_GC_GH="$STUBBIN/gh-stub"
        WT_GC_DOCKER="$STUBBIN/docker"
        WT_GC_QUEUE_DIR="$CD/queue"
        WT_GC_SESSION_REGISTRY="$CD/registry.json"
        WT_GC_TIPS_DIR="$CD/tips"
        WT_GC_STALE_FILE="$CD/stale.tsv"
        STUB_GH_DIR="$CD/gh"
    )
    if [ "${NOSTATE:-}" != 1 ]; then base+=(WT_GC_LOCK_DIR="$CD/state"); fi
    for kv in ${envs[@]+"${envs[@]}"}; do
        case "$kv" in -*) drop="$drop${kv#-} " ;; esac
    done
    for kv in "${base[@]}" ${envs[@]+"${envs[@]}"}; do
        case "$kv" in -*) continue ;; esac
        case "$drop" in *" ${kv%%=*} "*) continue ;; esac
        final+=("$kv")
    done
    docker_guard "${final[@]}"
    rm -f "$CD/argv" "$CD/cwd"
    RC=0
    env -i "${final[@]}" "$TICK" "$@" >"$CD/out" 2>"$CD/err" || RC=$?
    if [ -f "$CD/argv" ]; then cat "$CD/argv" >> "$ROOT/all-argv"; fi
}

argv_exists() { [ -f "$CD/argv" ]; }

# ── Throwaway git repo for the survival case ──────────────────────────────────
# new_env <dir> — builds <dir>/{origin.git,main}; main carries a stub
# bin/wt-remove (the real one tears down Docker stacks; this one only removes
# the git worktree). Echoes nothing; sets ENV_MAIN.
ENV_MAIN=""
new_env() {
    local envdir="$1"
    git init -q --bare "$envdir/origin.git" >/dev/null 2>&1
    git clone -q "$envdir/origin.git" "$envdir/main" >/dev/null 2>&1
    git -C "$envdir/main" config user.email t@example.com
    git -C "$envdir/main" config user.name tester
    git -C "$envdir/main" config commit.gpgsign false
    printf 'init\n' > "$envdir/main/README.md"
    mkdir -p "$envdir/main/bin"
    cat > "$envdir/main/bin/wt-remove" <<'SH'
#!/usr/bin/env bash
# Harness stub of bin/wt-remove: remove the git worktree only (no Docker).
# argv: [--force] [--volumes] <name> in any order; recorded to wt-remove-argv.
root="$(cd "$(dirname "$0")/.." && pwd)"
name=""
if [ -n "${STUB_CASE_DIR:-}" ]; then printf '%s\n' "$@" > "$STUB_CASE_DIR/wt-remove-argv"; fi
for a in "$@"; do
    case "$a" in --*) ;; *) [ -z "$name" ] && name="$a" ;; esac
done
exec git -C "$root" worktree remove --force "$(dirname "$root")/IBL5-worktrees/$name"
SH
    chmod +x "$envdir/main/bin/wt-remove"
    git -C "$envdir/main" add README.md bin/wt-remove
    # Backdated 30d so a worktree with no own commits takes its age from the
    # directory mtime (mk_wt age_days=N).
    GIT_AUTHOR_DATE="@$(( $(date +%s) - 30 * 86400 ))" \
        GIT_COMMITTER_DATE="@$(( $(date +%s) - 30 * 86400 ))" \
        git -C "$envdir/main" commit -qm init
    git -C "$envdir/main" branch -q -M master
    git -C "$envdir/main" push -q -u origin master >/dev/null 2>&1
    ENV_MAIN="$envdir/main"
}

# ── Fixture builders for the reap steps (operate on $ENV_MAIN) ────────────────
epoch_ago() { printf '%s\n' "$(( $(date +%s) - $1 * 86400 ))"; }
# iso_ago <days> — a Docker-style FinishedAt that many days (plus 1h) back.
iso_ago() {
    python3 -I -c '
import sys, time
t = time.time() - int(sys.argv[1]) * 86400 - 3600
print(time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(t)) + ".123456789Z")
' "$1"
}
# dk_container <id> <name> <state> <finished> — one ps row plus its inspect files.
dk_container() {
    mkdir -p "$CD/insp"
    printf '%s\t%s\n' "$1" "$2" >> "$CD/ps"
    printf '%s\t%s\n' "$3" "$4" > "$CD/insp/$1.fmt"
    printf '{"Id":"%s","Name":"/%s","State":{"Status":"%s"}}\n' "$1" "$2" "$3" > "$CD/insp/$1.json"
}

# epoch_to_touch <epoch> — the `touch -t` stamp (BSD date -r / GNU date -d @).
epoch_to_touch() {
    if date -r 0 >/dev/null 2>&1; then
        date -r "$1" '+%Y%m%d%H%M.%S'
    else
        date -d "@$1" '+%Y%m%d%H%M.%S'
    fi
}

# bd_commit <dir> <epoch> <msg> — commit the index with a backdated date.
bd_commit() {
    GIT_AUTHOR_DATE="@$2" GIT_COMMITTER_DATE="@$2" git -C "$1" commit -qm "$3"
}

# mk_wt <name> <branch> [ahead=N] [age_days=N] [dirt=KIND] — a worktree off
# origin/master under <env>/IBL5-worktrees/<name>. Own commits and the dir
# mtime are backdated N days. KIND: none|match|diff|untracked-match|
# untracked-diff|staged-diff|deleted|symlink.
mk_wt() {
    local name="$1" br="$2" ahead=0 age=0 dirt=none kv i=1 ep wt
    shift 2
    for kv in "$@"; do
        case "$kv" in
            ahead=*)    ahead="${kv#ahead=}" ;;
            age_days=*) age="${kv#age_days=}" ;;
            dirt=*)     dirt="${kv#dirt=}" ;;
        esac
    done
    wt="$(dirname "$ENV_MAIN")/IBL5-worktrees/$name"
    git -C "$ENV_MAIN" worktree add -q -b "$br" "$wt" origin/master >/dev/null 2>&1
    ep="$(epoch_ago "$age")"
    while [ "$i" -le "$ahead" ]; do
        printf '%s\n' "$i" > "$wt/own-$i.txt"
        git -C "$wt" add "own-$i.txt"
        bd_commit "$wt" "$ep" "own $i"
        i=$((i + 1))
    done
    case "$dirt" in
        match)
            printf 'changed\n' > "$wt/README.md"
            git -C "$wt" add README.md
            bd_commit "$wt" "$ep" "change readme"
            git -C "$wt" show origin/master:README.md > "$wt/README.md" ;;
        diff) printf 'different\n' > "$wt/README.md" ;;
        untracked-match)
            git -C "$wt" rm -q README.md
            bd_commit "$wt" "$ep" "drop readme"
            git -C "$wt" show origin/master:README.md > "$wt/README.md" ;;
        untracked-diff) printf 'new\n' > "$wt/new.txt" ;;
        staged-diff)
            printf 'staged\n' > "$wt/README.md"
            git -C "$wt" add README.md
            git -C "$wt" show origin/master:README.md > "$wt/README.md" ;;
        deleted) rm -f "$wt/README.md" ;;
        symlink) rm -f "$wt/README.md"; ln -s /etc/hosts "$wt/README.md" ;;
    esac
    touch -t "$(epoch_to_touch "$ep")" "$wt"
}

# mk_detached <name> [age_days=N] [dirt=untracked] [rev=<sha>] — a detached
# worktree. Without rev=, origin/master moves forward to a commit dated N days
# ago and the worktree is detached at it, so the HEAD is on master.
mk_detached() {
    local name="$1" age=0 dirt=none rev="" kv ep wt
    shift
    for kv in "$@"; do
        case "$kv" in
            age_days=*) age="${kv#age_days=}" ;;
            dirt=*)     dirt="${kv#dirt=}" ;;
            rev=*)      rev="${kv#rev=}" ;;
        esac
    done
    ep="$(epoch_ago "$age")"
    if [ -z "$rev" ]; then
        rev="$(GIT_AUTHOR_DATE="@$ep" GIT_COMMITTER_DATE="@$ep" \
            git -C "$ENV_MAIN" commit-tree -p origin/master -m "snap $name" 'origin/master^{tree}')"
        git -C "$ENV_MAIN" update-ref refs/remotes/origin/master "$rev"
    fi
    wt="$(wt_dir "$name")"
    git -C "$ENV_MAIN" worktree add -q --detach "$wt" "$rev" >/dev/null 2>&1
    if [ "$dirt" = untracked ]; then printf 'u\n' > "$wt/untracked.txt"; fi
    touch -t "$(epoch_to_touch "$ep")" "$wt"
}

# mk_ref <refname> <age_days> — a backdated commit on origin/master's tree.
mk_ref() {
    local ep sha
    ep="$(epoch_ago "$2")"
    sha="$(GIT_AUTHOR_DATE="@$ep" GIT_COMMITTER_DATE="@$ep" \
        git -C "$ENV_MAIN" commit-tree -p origin/master -m "snap $1" 'origin/master^{tree}')"
    git -C "$ENV_MAIN" update-ref "$1" "$sha"
}

refs_snapshot() { git -C "$ENV_MAIN" for-each-ref --format='%(refname) %(objectname)' | sort; }
wt_snapshot()   { git -C "$ENV_MAIN" worktree list --porcelain; }

# mk_registry <file> <branch>... — the dict shape session-registry.py writes.
mk_registry() {
    local f="$1" b sep="" i=0
    shift
    {
        printf '{'
        for b in "$@"; do
            printf '%s"s%d": {"id": "s%d", "cwd": "/x", "branch": "%s"}' "$sep" "$i" "$i" "$b"
            sep=", "; i=$((i + 1))
        done
        printf '}\n'
    } > "$f"
}

# mk_queue <dir> <entry> — a queued plan: <slug>.md plus the named entry.
mk_queue() {
    mkdir -p "$1"
    touch "$1/${2%%.md*}.md" "$1/$2"
}

# pushed_branch <main> <branch> — branch off master with one pushed commit.
pushed_branch() {
    local main="$1" br="$2"
    git -C "$main" checkout -q -b "$br" master
    printf 'x\n' > "$main/$br.txt"
    git -C "$main" add "$br.txt"
    git -C "$main" commit -qm "feat-$br"
    git -C "$main" push -q -u origin "$br" >/dev/null 2>&1
    git -C "$main" checkout -q master
}

