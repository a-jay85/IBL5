timeout 600 claude -p "$p" --allowedTools 'Read,
Grep,
Bash(python3:*)'
FIX
expect_class perm_multiline_rule_fail "$T/perm_multiline_rule_fail.sh" permission

cat > "$T/perm_printf_runner_fail.sh" <<'FIX'
#!/bin/bash
{
    printf 'cd %s && timeout 600 claude -p %s --dangerously-skip-permissions --model m\n' \
        "$(shq "$WT_ROOT")" "$(shq "$PROMPT")"
} > "$RUNNER"
FIX
expect_class perm_printf_runner_fail "$T/perm_printf_runner_fail.sh" permission

# Strings from the PR #3379 history, wrapped as the call's tool grant.
perm_fix hist_1 "--permission-mode acceptEdits --allowedTools Read"
expect_class perm_hist_1_fail "$T/perm_hist_1.sh" permission
perm_fix hist_2 '--allowedTools "Bash(mysql:*)" "Bash(${SIM_RECAP_MYSQL_BIN}:*)" "Write"'
expect_class perm_hist_2_fail "$T/perm_hist_2.sh" permission
perm_fix hist_3 '--allowedTools "Bash(mysql:*)" "Write"'
expect_class perm_hist_3_fail "$T/perm_hist_3.sh" permission

echo "$PASS passed, $FAIL failed"
[ "$FAIL" -eq 0 ]
