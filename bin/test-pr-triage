assert_match  "S10 bucket=BLOCKED-CHECK"        '^BLOCKED-CHECK$' "$(row_bucket "$OUT" 82)"
assert_absent "S10 never arms"                  'pr merge'        "$(cat "$FIX/calls.log")"
assert_status "S10 exit 0"                      0                 "$ST"

