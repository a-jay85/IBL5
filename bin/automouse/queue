#!/bin/bash
# Queue a plan for automouse autonomous execution.
#
# Creates a symlink NNN-<slug>.md in the automouse queue pointing to the
# original plan in ~/claude-plans/. Run order is the lexical order of the NNN
# prefixes; a new entry is appended last. The original plan stays in place;
# the symlink moves to done/ or skipped/ (as bare <slug>.md) after execution.
#
# Usage:
#   bin/automouse/queue [add] <plan-slug-or-filename> [--force]
#   bin/automouse/queue                          # show current queue
#   bin/automouse/queue requeue                  # move all skipped plans back to queue
#   bin/automouse/queue remove <plan-slug>       # remove a plan from the queue
#   bin/automouse/queue reorder <slug1> ...      # rename the queue into this order
#   bin/automouse/queue dispose <slug> <done|skipped> [--staleness]
#   bin/automouse/queue renumber                 # compact prefixes to 010, 020, …
#   bin/automouse/queue status                   # one next-action line per item needing attention
#   bin/automouse/queue ice <slug> ...           # move queued plans to the icebox
#   bin/automouse/queue thaw                     # move every iceboxed plan back to the queue
#   bin/automouse/queue icebox                   # show the icebox
#
# Examples:
#   bin/automouse/queue velvet-brewing-starlight
#   bin/automouse/queue velvet-brewing-starlight.md
#   bin/automouse/queue ~/claude-plans/velvet-brewing-starlight.md
#   bin/automouse/queue requeue
#   bin/automouse/queue remove velvet-brewing-starlight

set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'HELP'
Usage:
  bin/automouse/queue [add] <plan-slug-or-filename> [--force]
                                                queue a plan; runs bin/check-plan first
  bin/automouse/queue                           show current queue
  bin/automouse/queue requeue                   move all skipped plans back to queue
  bin/automouse/queue remove <plan-slug>        remove a plan from the queue
  bin/automouse/queue reorder <slug1> ...       reorder the full queue
  bin/automouse/queue dispose <slug> <done|skipped> [--staleness]
                                                move a queued plan to done/ or skipped/
  bin/automouse/queue renumber                  compact prefixes to 010, 020, 030, …
  bin/automouse/queue status                    one next-action line per item needing attention
  bin/automouse/queue ice <slug> ...            move queued plans to the icebox (skips a running plan)
  bin/automouse/queue ice --all-except <slug> ...
                                                ice every queued plan except these
  bin/automouse/queue thaw                      append every iceboxed plan back onto the queue
  bin/automouse/queue icebox                    show the icebox

Arguments:
  <plan-slug-or-filename>   plan slug or filename (with or without .md), or path
  --force                   queue even when bin/check-plan fails; logged to
                            queue/<plan>.md.force-override and force-overrides.log.
                            Never bypasses the impl_model gates.

Env vars:
  NIGHTLY_DIR   automouse state directory (default: ~/.claude/projects/.../automouse)
  PLANS_DIR     plan files directory (default: ~/claude-plans)
  AUTOMOUSE_CHECK_PLAN  plan gate executable (default: <repo>/bin/check-plan)

Exit codes: 0 = success, 1 = error or refusal
HELP
    exit 0
fi

: "${NIGHTLY_DIR:=$HOME/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/automouse}"
: "${PLANS_DIR:=$HOME/claude-plans}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
QUEUE_DIR="$NIGHTLY_DIR/queue"
SKIPPED_DIR="$NIGHTLY_DIR/skipped"
DONE_DIR="$NIGHTLY_DIR/done"
# icebox/ holds plans set aside while weekly usage is tight. Entries keep their
# NNN- prefix so `thaw` re-appends them in their old order. bin/usage-gate-coordinator
# writes .frozen-resets-at and runs `thaw` once the weekly window resets.
ICEBOX_DIR="$NIGHTLY_DIR/icebox"

mkdir -p "$QUEUE_DIR"

# shellcheck source=../lib/automouse-queue-order.sh
source "$SCRIPT_DIR/../lib/automouse-queue-order.sh"
# One-shot cutover of a legacy bare-named queue; a no-op once every entry is prefixed.
normalize_queue "$QUEUE_DIR"

# Evict any stale same-basename disposition symlink (and its sidecar counters)
# from skipped/ and done/ before (re)queuing. queue/ is the cut vertex: a plan
# can land in two disposition folders only if a stale sibling survives queue
# entry. rm -f is a no-op when nothing is there.
evict_dispositions() {
    local name=$1
    rm -f "$SKIPPED_DIR/$name" "$SKIPPED_DIR/${name}.attempts" "$SKIPPED_DIR/${name}.staleness" "$SKIPPED_DIR/${name}.failure" "$SKIPPED_DIR/${name}.cap-refunds" "$SKIPPED_DIR/${name}.force-override" \
          "$DONE_DIR/$name" "$DONE_DIR/${name}.attempts" "$DONE_DIR/${name}.staleness" "$DONE_DIR/${name}.failure" "$DONE_DIR/${name}.cap-refunds" "$DONE_DIR/${name}.force-override"
    local iced
    if iced=$(queue_entry_for_slug "$ICEBOX_DIR" "$name"); then
        rm -f "$ICEBOX_DIR/$iced"
        # An emptied icebox must not keep its freeze stamp, or the next ice
        # would inherit a stale reset time and thaw on the coordinator's next tick.
        if [ -z "$(queue_entries "$ICEBOX_DIR")" ]; then
            rm -f "$ICEBOX_DIR/.frozen-resets-at"
        fi
    fi
}

# move_sidecars <from-dir> <to-dir> <name> — move every <name>.* sidecar except a
# run lock. Used by ice and thaw, so attempt counters and force overrides travel
# with the plan.
move_sidecars() {
    local from=$1 to=$2 name=$3 f
    for f in "$from/$name".*; do
        [ -e "$f" ] || continue
        case "$f" in *.lock) continue ;; esac
        mv "$f" "$to/"
    done
}

# --- Run order --------------------------------------------------------------
# Entries are named NNN-<slug>.md and run in plain lexical order (queue_entries,
# from bin/lib/automouse-queue-order.sh). Every ordering change is a rename
# inside queue/, so editing a queued plan's file never moves it.

# append_entry <source-path> <name> — link <source-path> into the queue as the
# LAST entry. Compacts once if the prefix band is exhausted. Holds the queue
# lock from the membership check to the link, so a racing enqueue or a renumber
# parked in the 900-999 band can never hand out the same prefix.
append_entry() {
    local source=$1 name=$2 prefix rc=1
    if ! queue_lock "$QUEUE_DIR"; then
        echo "Error: could not queue $name — another queue rename holds $QUEUE_DIR/.normalize.lock." >&2
        return 1
    fi
    if queue_entry_for_slug "$QUEUE_DIR" "$name" >/dev/null; then
        rc=0
    else
        if ! prefix=$(next_prefix "$QUEUE_DIR"); then
            _renumber_queue_locked "$QUEUE_DIR" || true
            prefix=$(next_prefix "$QUEUE_DIR") || prefix=""
        fi
        if [ -z "$prefix" ]; then
            echo "Error: could not queue $name — the queue is full (89 entries); dispose or remove a plan first." >&2
        elif ln -s "$source" "$QUEUE_DIR/${prefix}-${name}"; then
            rc=0
        fi
    fi
    queue_unlock "$QUEUE_DIR"
    return "$rc"
}

# show_queue [dir] [header] — list a queue-shaped dir (queue/ by default, or icebox/).
show_queue() {
    local dir=${1:-$QUEUE_DIR}
    echo "${2:-Automouse queue (next to run first):}"
    printf "  %4s  %-44s %-17s %-6s  %s\n" "#" "PLAN" "MODEL" "MERGE" "TITLE"
    local found=0
    local i=1
    while IFS= read -r entry; do
        found=1
        local name path impl_model auto_merge title
        name=$(entry_to_name "$entry")
        path="$dir/$entry"
        if [ -e "$path" ]; then
            # Extract frontmatter values (between first pair of --- markers).
            # Title = first H1 outside frontmatter and code fences, so a
            # `# shellcheck` line inside a ```bash block is never picked.
            # || true: awk/grep under set -e + pipefail; keep going on any error.
            impl_model=$(awk '/^---/{if(++n==1)next;exit} n==1&&/^impl_model:/{print $2}' "$path" 2>/dev/null) || true
            auto_merge=$(awk '/^---/{if(++n==1)next;exit} n==1&&/^auto_merge:/{print $2}' "$path" 2>/dev/null) || true
            title=$(awk 'NR==1&&/^---/{fm=1;next} fm{if(/^---/)fm=0;next} /^ ? ? ?(```|~~~)/{fence=!fence;next} !fence&&/^# /{sub(/^# /,"");print;exit}' "$path" 2>/dev/null) || true
            [ -z "$title" ] && title=$(awk '/^---/{if(++n==1)next;exit} n==1&&/^title:/{sub(/^title:[[:space:]]*/,""); gsub(/^["\x27]|["\x27]$/,""); print; exit}' "$path" 2>/dev/null) || true
        else
            impl_model="" auto_merge="" title="(BROKEN LINK -> $(readlink "$path"))"
        fi
        impl_model=${impl_model:-opus}
        auto_merge=${auto_merge:-true}
        printf "  %4d. %-44s %-17s %-6s  %s\n" "$i" "$name" "$impl_model" "$auto_merge" "$title"
        i=$((i + 1))
    done < <(queue_entries "$dir")
    if [ "$found" -eq 0 ]; then
        echo "  (empty)"
    fi
}

if [ $# -eq 0 ]; then
    show_queue
    exit 0
fi

if [ "$1" = "icebox" ]; then
    show_queue "$ICEBOX_DIR" "Automouse icebox (thaws back onto the queue when weekly usage resets):"
    exit 0
fi

# ice <slug>... | ice --all-except <slug>... — move queued plans into icebox/,
# keeping each entry's NNN- prefix and its sidecars. A plan holding a run lock is
# left in place, since a runner is working on it.
if [ "$1" = "ice" ]; then
    shift
    EXCEPT=0
    if [ "${1:-}" = "--all-except" ]; then
        EXCEPT=1
        shift
    fi
    if [ "$EXCEPT" -eq 0 ] && [ $# -eq 0 ]; then
        echo "Error: ice requires at least one plan slug (or --all-except <slug>...)." >&2
        exit 1
    fi
    mkdir -p "$ICEBOX_DIR"
    if ! queue_lock "$QUEUE_DIR"; then
        echo "Error: another queue rename holds $QUEUE_DIR/.normalize.lock; nothing iced." >&2
        exit 1
    fi
    TARGETS=()
    if [ "$EXCEPT" -eq 1 ]; then
        KEEP=" "
        for a in "$@"; do KEEP="$KEEP$(entry_to_name "$(basename "$a")") "; done
        while IFS= read -r entry; do
            name=$(entry_to_name "$entry")
            case "$KEEP" in *" $name "*) continue ;; esac
            TARGETS+=("$name")
        done < <(queue_entries "$QUEUE_DIR")
    else
        for a in "$@"; do TARGETS+=("$(entry_to_name "$(basename "$a")")"); done
    fi
    RC=0
    for name in "${TARGETS[@]+"${TARGETS[@]}"}"; do
        if ! entry=$(queue_entry_for_slug "$QUEUE_DIR" "$name"); then
            echo "Error: $name is not in the queue." >&2
            RC=1
            continue
        fi
        if [ -e "$QUEUE_DIR/${name}.lock" ]; then
            echo "Skipped $name: a runner holds its lock." >&2
            continue
        fi
        mv "$QUEUE_DIR/$entry" "$ICEBOX_DIR/$entry"
        move_sidecars "$QUEUE_DIR" "$ICEBOX_DIR" "$name"
        echo "Iced: $name"
    done
    queue_unlock "$QUEUE_DIR"
    echo ""
    show_queue
    exit "$RC"
fi

# thaw — append every iceboxed plan to the END of the queue in icebox order, with
# its sidecars, and drop the freeze stamp once the icebox is empty. No bin/check-plan
# re-run: each plan passed it (or was forced) when it was first queued, and the run's
# staleness gate still checks it before implementation.
if [ "$1" = "thaw" ]; then
    THAWED=0
    RC=0
    if [ -d "$ICEBOX_DIR" ]; then
        while IFS= read -r entry; do
            name=$(entry_to_name "$entry")
            if ! source=$(readlink "$ICEBOX_DIR/$entry"); then
                echo "Error: $ICEBOX_DIR/$entry is not a symlink; left in the icebox." >&2
                RC=1
                continue
            fi
            if append_entry "$source" "$name"; then
                rm -f "$ICEBOX_DIR/$entry"
                move_sidecars "$ICEBOX_DIR" "$QUEUE_DIR" "$name"
                THAWED=$((THAWED + 1))
            else
                RC=1
            fi
        done < <(queue_entries "$ICEBOX_DIR")
        if [ -z "$(queue_entries "$ICEBOX_DIR")" ]; then
            rm -f "$ICEBOX_DIR/.frozen-resets-at"
        fi
    fi
    echo "Thawed $THAWED plan(s) back onto the queue."
    echo ""
    show_queue
    exit "$RC"
fi

# Read-only triage: one next-action line per skipped/failed/paused/held/forced
# item. Touches nothing. A queue/ entry with several sidecars gets ONE line, by
# precedence failed > paused > held > forced (the most actionable state wins).
if [ "$1" = "status" ]; then
    if [ $# -gt 1 ]; then
        echo "Error: status takes no arguments." >&2
        echo "Usage: bin/automouse/queue status" >&2
        exit 1
    fi
    # Mirrors MAX_ATTEMPTS in bin/automouse/run; a harness row pins the two
    # together so a change to one fails loudly.
    STATUS_MAX_ATTEMPTS=3
    REPORTS_DIR="$NIGHTLY_DIR/reports"
    status_found=0
    status_line() {
        status_found=1
        printf '%-7s  %s  next: %s\n' "$1" "$2" "$3"
    }

    for f in "$SKIPPED_DIR"/*.md; do
        { [ -L "$f" ] || [ -e "$f" ]; } || continue
        name=$(basename "$f"); slug="${name%.md}"
        if [ ! -e "$f" ]; then
            status_line skipped "$slug" "plan file is gone; bin/automouse/self-heal reaps it"
        elif [ -e "$SKIPPED_DIR/${name}.staleness" ]; then
            status_line skipped "$slug" "fix the stale path in the plan, then bin/automouse/self-heal"
        else
            report=""
            for r in "$REPORTS_DIR"/*-skipped-"$slug".md; do
                if [ -e "$r" ]; then report=$(basename "$r"); fi   # lexical = date order; last is newest
            done
            if [ -n "$report" ]; then
                status_line skipped "$slug" "read reports/$report, fix the cause, then bin/automouse/queue $slug"
            else
                status_line skipped "$slug" "fix the cause, then bin/automouse/queue $slug"
            fi
        fi
    done

    for f in "$QUEUE_DIR"/*.md; do
        { [ -L "$f" ] || [ -e "$f" ]; } || continue
        name=$(entry_to_name "$f"); slug="${name%.md}"
        attempts=0
        if [ -f "$QUEUE_DIR/${name}.attempts" ]; then
            attempts=$(tr -cd '0-9' < "$QUEUE_DIR/${name}.attempts")
            attempts=${attempts:-0}
        fi
        if [ "$attempts" -ge 1 ] || [ -e "$QUEUE_DIR/${name}.wt-fail" ]; then
            msg="$attempts/$STATUS_MAX_ATTEMPTS attempts used; retries next run"
            if [ -e "$QUEUE_DIR/${name}.failure" ]; then
                msg="$msg; read queue/${name}.failure"
            fi
            status_line failed "$slug" "$msg; stop it with bin/automouse/queue remove $slug"
        elif [ -e "$QUEUE_DIR/${name}.lock/paused-held" ]; then
            status_line paused "$slug" "usage limit pause; resumes by itself, nothing to do"
        elif [ -e "$QUEUE_DIR/${name}.depends-hold" ]; then
            status_line held "$slug" "waiting on a dependency; nothing to do until it merges"
        elif [ -e "$QUEUE_DIR/${name}.force-override" ]; then
            forced_on=$(awk '/^forced_at: / && !d { print substr($2, 1, 10); d = 1 }' \
                "$QUEUE_DIR/${name}.force-override")
            status_line forced "$slug" "queued past a failing check-plan on ${forced_on:-an unknown date}; nothing to do"
        fi
    done

    if [ "$status_found" -eq 0 ]; then
        echo "Nothing needs attention."
    fi
    exit 0
fi

if [ "$1" = "remove" ] || [ "$1" = "rm" ]; then
    if [ $# -lt 2 ]; then
        echo "Error: remove requires a plan slug or filename." >&2
        echo "Usage: bin/automouse/queue remove <plan-slug>" >&2
        exit 1
    fi
    TARGET=$(entry_to_name "$(basename "$2")")
    # Hold the queue lock from lookup through rm, so a racing reorder/renumber
    # cannot rename the entry between resolving it and deleting it.
    if ! queue_lock "$QUEUE_DIR"; then
        echo "Error: another queue rename holds $QUEUE_DIR/.normalize.lock; nothing removed." >&2
        exit 1
    fi
    if ! ENTRY=$(queue_entry_for_slug "$QUEUE_DIR" "$TARGET"); then
        queue_unlock "$QUEUE_DIR"
        echo "Error: $TARGET is not in the queue." >&2
        echo "" >&2
        show_queue >&2
        exit 1
    fi
    rm -f "$QUEUE_DIR/$ENTRY" "$QUEUE_DIR/${TARGET}.attempts" "$QUEUE_DIR/${TARGET}.failure" "$QUEUE_DIR/${TARGET}.cap-refunds" "$QUEUE_DIR/${TARGET}.force-override"
    queue_unlock "$QUEUE_DIR"
    echo "Removed from queue: $TARGET (original plan in $PLANS_DIR is untouched)"
    echo ""
    show_queue
    exit 0
fi

if [ "$1" = "requeue" ]; then
    if ! ls "$SKIPPED_DIR"/*.md &>/dev/null; then
        echo "No skipped plans to requeue."
        exit 0
    fi
    count=0
    for f in "$SKIPPED_DIR"/*.md; do
        name=$(basename "$f")
        case "$name" in
            [0-9][0-9][0-9]-*)
                echo "  skip: $name (NNN- plan names are reserved for run order; rename the plan)" >&2
                continue ;;
        esac
        if queue_entry_for_slug "$QUEUE_DIR" "$name" >/dev/null; then
            echo "  skip: $name (already queued)"
            continue
        fi
        # Re-link to the same target as the LAST entry, then drop the skipped/ link.
        append_entry "$(readlink "$f")" "$name"
        rm -f "$QUEUE_DIR/${name}.attempts" "$QUEUE_DIR/${name}.failure" "$QUEUE_DIR/${name}.cap-refunds" "$QUEUE_DIR/${name}.force-override"
        evict_dispositions "$name"
        count=$((count + 1))
        echo "  requeued: $name"
    done
    echo ""
    echo "$count plan(s) moved from skipped/ back to queue/."
    echo ""
    show_queue
    exit 0
fi

# Move a queue entry to done/ or skipped/ under its bare <slug>.md name, so
# self-heal and evict_dispositions keep matching it. The impl agent and the
# runner call this instead of `mv`-ing a prefixed entry themselves.
# --staleness also drops the <slug>.md.staleness marker self-heal reads.
# Idempotent: an entry already in the target dir is a no-op success.
if [ "$1" = "dispose" ]; then
    shift
    STALENESS=0
    if [ "${3:-}" = "--staleness" ]; then STALENESS=1; fi
    if [ $# -lt 2 ] || { [ "$2" != "done" ] && [ "$2" != "skipped" ]; } \
       || { [ $# -gt 2 ] && [ "$STALENESS" -eq 0 ]; } || [ $# -gt 3 ]; then
        echo "Usage: bin/automouse/queue dispose <plan-slug> <done|skipped> [--staleness]" >&2
        exit 1
    fi
    if [ "$2" = "done" ]; then TARGET_DIR="$DONE_DIR"; else TARGET_DIR="$SKIPPED_DIR"; fi
    if [ "$STALENESS" -eq 1 ] && [ "$2" != "skipped" ]; then
        echo "Error: --staleness applies only to skipped." >&2
        exit 1
    fi
    # basename strips any leading path -> path-traversal / arbitrary-file defense.
    NAME=$(entry_to_name "$(basename "$1")")
    # Hold the queue lock from lookup through mv, so a racing reorder/renumber
    # cannot rename the entry between resolving it and moving it.
    if ! queue_lock "$QUEUE_DIR"; then
        echo "Error: another queue rename holds $QUEUE_DIR/.normalize.lock; nothing disposed." >&2
        exit 1
    fi
    if ENTRY=$(queue_entry_for_slug "$QUEUE_DIR" "$NAME"); then
        mkdir -p "$TARGET_DIR"
        if ! mv "$QUEUE_DIR/$ENTRY" "$TARGET_DIR/$NAME"; then
            queue_unlock "$QUEUE_DIR"
            exit 1
        fi
        queue_unlock "$QUEUE_DIR"
        echo "Disposed: $ENTRY -> $2/$NAME"
    elif [ -L "$TARGET_DIR/$NAME" ] || [ -e "$TARGET_DIR/$NAME" ]; then
        queue_unlock "$QUEUE_DIR"
        echo "Already disposed (no change): $2/$NAME"
    else
        queue_unlock "$QUEUE_DIR"
        echo "Error: $NAME is in neither queue/ nor $2/." >&2
        exit 1
    fi
    if [ "$STALENESS" -eq 1 ]; then touch "$TARGET_DIR/${NAME}.staleness"; fi
    exit 0
fi

# Compact the queue to 010, 020, 030, … in its current order. A no-op when the
# queue is already canonical.
if [ "$1" = "renumber" ]; then
    renumber_queue "$QUEUE_DIR"
    show_queue
    exit 0
fi

# Reorder the queue by renaming every entry to 010, 020, … in the order given
# (first arg runs first). The argument list must be an EXACT permutation of the
# current queue: every arg queued, none repeated, counts equal. Validation is a
# full first pass — nothing is renamed unless it passes, so a rejected reorder
# leaves the queue untouched.
if [ "$1" = "reorder" ]; then
    shift
    if [ $# -lt 1 ]; then
        echo "Error: reorder requires the full queue in the desired order." >&2
        echo "Usage: bin/automouse/queue reorder <slug1> <slug2> ... <slugN>" >&2
        exit 1
    fi

    # Hold the queue lock from validation through the rename, so the permutation
    # checked is the one renamed. The EXIT trap releases it on every exit below.
    if ! queue_lock "$QUEUE_DIR"; then
        echo "Error: another queue rename holds $QUEUE_DIR/.normalize.lock; nothing reordered." >&2
        exit 1
    fi
    trap 'queue_unlock "$QUEUE_DIR"' EXIT

    # Current queue names, space-wrapped for membership tests (" a.md b.md ").
    queued=" "
    queued_count=0
    while IFS= read -r e; do
        queued="$queued$(entry_to_name "$e") "
        queued_count=$((queued_count + 1))
    done < <(queue_entries "$QUEUE_DIR")

    if [ "$queued_count" -eq 0 ]; then
        echo "Error: the queue is empty; nothing to reorder." >&2
        exit 1
    fi

    # Validate (rename nothing this pass). $ordered collects queue entry names.
    seen=" "
    ordered=()
    given_count=0
    for arg in "$@"; do
        # basename strips any leading path -> path-traversal / arbitrary-file defense.
        name=$(entry_to_name "$(basename "$arg")")
        case "$queued" in
            *" $name "*) ;;
            *)
                echo "Error: $name is not in the queue." >&2
                show_queue >&2
                exit 1 ;;
        esac
        case "$seen" in
            *" $name "*)
                echo "Error: $name given more than once." >&2
                exit 1 ;;
        esac
        seen="$seen$name "
        ordered+=("$(queue_entry_for_slug "$QUEUE_DIR" "$name")")
        given_count=$((given_count + 1))
    done

    # Membership + no-dup + equal counts ⟹ exact permutation (no adds/drops).
    if [ "$given_count" -ne "$queued_count" ]; then
        echo "Error: reorder needs an exact permutation of the queue" \
             "($queued_count queued, $given_count given)." >&2
        show_queue >&2
        exit 1
    fi

    _renumber_queue_locked "$QUEUE_DIR" "${ordered[@]}"

    echo "Reordered $given_count plan(s)."
    echo ""
    show_queue
    exit 0
fi

# Add path: `bin/automouse/queue [add] <plan> [--force]`. `add` is a synonym of
# the bare form (bin/automouse/run prints `queue add <slug>` as a hint).
# `--force` may sit anywhere among the args; the check-plan gate below reads it.
# Any other dash-prefixed token is refused so a typo never becomes a plan name.
if [ "$1" = "add" ]; then
    shift
fi
FORCE=0
INPUT=""
for arg in "$@"; do
    case "$arg" in
        --force) FORCE=1 ;;
        -*)
            echo "Error: unknown option: $arg" >&2
            echo "Usage: bin/automouse/queue [add] <plan-slug-or-filename> [--force]" >&2
            exit 1 ;;
        *)
            if [ -n "$INPUT" ]; then
                echo "Error: more than one plan given: $INPUT $arg" >&2
                echo "Usage: bin/automouse/queue [add] <plan-slug-or-filename> [--force]" >&2
                exit 1
            fi
            INPUT="$arg" ;;
    esac
done
if [ -z "$INPUT" ]; then
    echo "Error: no plan given." >&2
    echo "Usage: bin/automouse/queue [add] <plan-slug-or-filename> [--force]" >&2
    exit 1
fi

# The add path never asks a question, so detach stdin: no gate below (or any
# helper it runs) can sit waiting on the terminal. Every add now runs the way
# `queue add <slug> < /dev/null` does. bin/test-automouse-queue row 50 pins it.
exec </dev/null

# Resolve the plan file path
if [ -f "$INPUT" ]; then
    SOURCE=$(cd "$(dirname "$INPUT")" && pwd)/$(basename "$INPUT")
elif [ -f "$PLANS_DIR/$INPUT" ]; then
    SOURCE="$PLANS_DIR/$INPUT"
elif [ -f "$PLANS_DIR/${INPUT}.md" ]; then
    SOURCE="$PLANS_DIR/${INPUT}.md"
else
    echo "Error: Plan not found: $INPUT" >&2
    echo "Looked in:" >&2
    echo "  $INPUT" >&2
    echo "  $PLANS_DIR/$INPUT" >&2
    echo "  $PLANS_DIR/${INPUT}.md" >&2
    exit 1
fi

FILENAME=$(basename "$SOURCE")

# A plan name that already starts with NNN- reads as a run-order prefix, so
# entry_to_slug would strip the plan's own digits and every slug lookup would miss.
case "$FILENAME" in
    [0-9][0-9][0-9]-*)
        echo "Error: plan name $FILENAME starts with three digits and a dash, which the queue reserves for run order. Rename the plan." >&2
        exit 1 ;;
esac

if QUEUED_ENTRY=$(queue_entry_for_slug "$QUEUE_DIR" "$FILENAME"); then
    EXISTING=$(readlink "$QUEUE_DIR/$QUEUED_ENTRY" 2>/dev/null || true)
    EXISTING_PHYS=""
    if [ -n "$EXISTING" ] && [ -e "$EXISTING" ]; then
        EXISTING_PHYS=$( (cd "$(dirname "$EXISTING")" && printf '%s/%s' "$(pwd)" "$(basename "$EXISTING")") 2>/dev/null || true )
    fi
    if [ "$EXISTING" = "$SOURCE" ] || [ "$EXISTING_PHYS" = "$SOURCE" ]; then
        echo "Already queued (no change): $FILENAME"
        show_queue
        exit 0
    fi
    echo "Error: $FILENAME is already queued, pointing at a different plan:" >&2
    echo "  queued: ${EXISTING:-<not a symlink, or dangling>}" >&2
    echo "  new:    $SOURCE" >&2
    exit 1
fi

# Two independent model gates run before a plan enters the queue:
#   (1) impl_model PRESENCE + VALIDITY (below) — every queued plan must declare a
#       recognized impl_model:. plan-model-consistency cannot cover this: it exits
#       0 on a plan with no Verification Matrix (loop-engineering backlog L46).
#   (2) impl_model <-> Verification Matrix CONSISTENCY (further below), shared with
#       bin/check-plan gate 13 via bin/lib/plan-model-consistency so the two cannot
#       drift. The plan archive predates that gate, so an old unmarked plan can
#       still be sitting in ~/claude-plans/ never having been run through it.
# Order matters: (1) is the more fundamental problem and must report first.
# bin/test-automouse-queue row 15 pins that ordering.
LIB_DIR="$(cd "$(dirname "$0")/.." && pwd)/lib"

# Same awk as bin/lib/plan-model-consistency's, deliberately — the two must agree
# on what "the plan's impl_model" is. `|| true` is required here and not there
# because this script runs under `set -euo pipefail`.
IMPL_MODEL_RAW=$(awk '
  NR==1 && /^---[[:space:]]*$/ {infm=1; next}
  infm && /^---[[:space:]]*$/ {infm=0; exit}
  infm && /^impl_model:[[:space:]]*/ {sub(/^impl_model:[[:space:]]*/,""); gsub(/[[:space:]]/,""); print; exit}
' "$SOURCE" 2>/dev/null || true)

# `if VAR=$(cmd); then` (not a bare assignment) so `set -e` does not abort on the
# helper's non-zero exit. "$IMPL_MODEL_RAW" MUST stay quoted: plan-model-tier
# exits 2 on a missing argument, so an unquoted empty value yields a usage error
# on stderr and an empty TIER instead of the "absent" token this branch needs.
if IMPL_MODEL_TIER=$("$LIB_DIR/plan-model-tier" "$IMPL_MODEL_RAW"); then
    if [ "$IMPL_MODEL_TIER" = "absent" ]; then
        echo "Error: $FILENAME has no usable impl_model: marker:" >&2
        echo "  impl_model: is missing or blank — add it to the plan's line-1 frontmatter (one of: opus, sonnet, haiku, claude-opus-5-5, claude-sonnet-5-5, claude-sonnet-4-6, claude-haiku-5-5, claude-haiku-4-5)" >&2
        echo "Fix the plan's line-1 frontmatter, then requeue." >&2
        exit 1
    fi
else
    echo "Error: $FILENAME declares an unusable impl_model:" >&2
    echo "  $IMPL_MODEL_TIER" >&2
    echo "Fix the plan's line-1 frontmatter, then requeue." >&2
    exit 1
fi
# `if VAR=$(cmd); then` (not a bare assignment) so `set -e` does not abort the
# script on the script's non-zero exit — the exit code is tested, not thrown.
if CONSISTENCY_MSG=$("$LIB_DIR/plan-model-consistency" "$SOURCE"); then
    :
else
    echo "Error: $FILENAME fails impl_model <-> Verification Matrix consistency:" >&2
    echo "  $CONSISTENCY_MSG" >&2
    echo "Fix the plan's line-1 frontmatter (add/adjust the one-line impl_model: or manual_judge: marker), then requeue." >&2
    exit 1
fi

# (3) Full bin/check-plan gate. A plan that would fail a plan gate is refused
# here, at queue time, so it never burns a run and lands in skipped/. Fail
# closed: ANY nonzero exit (1 = violations, 2 = usage/missing file, 126/127 =
# binary missing) refuses. Runs after (1) and (2), so `--force` never bypasses
# them. AUTOMOUSE_CHECK_PLAN is a test seam in bin/plan-now's
# PLAN_NOW_AUTOMOUSE_QUEUE shape; `:-` makes an EMPTY value fall back to the
# real gate, so a blank override can never disable it.
CHECK_PLAN="${AUTOMOUSE_CHECK_PLAN:-${LIB_DIR%/lib}/check-plan}"
CHECK_RC=0
# check-plan prints nothing until it ends, often 30s or more. Say so first, so
# the wait does not look like a hang.
echo "Checking $FILENAME with bin/check-plan (this can take 30s or more)..." >&2
CHECK_OUT=$("$CHECK_PLAN" "$SOURCE" 2>&1) || CHECK_RC=$?
FORCE_SIDECAR="$QUEUE_DIR/${FILENAME}.force-override"
if [ "$CHECK_RC" -ne 0 ]; then
    if [ "$FORCE" -ne 1 ]; then
        echo "Error: $FILENAME fails bin/check-plan (exit $CHECK_RC); not queued:" >&2
        printf '%s\n' "$CHECK_OUT" | sed 's/^/  /' >&2
        echo "Fix the plan, then requeue: bin/automouse/queue $FILENAME" >&2
        echo "To queue it anyway (logged): bin/automouse/queue $FILENAME --force" >&2
        exit 1
    fi
    echo "Warning: $FILENAME fails bin/check-plan (exit $CHECK_RC); queuing anyway (--force):" >&2
    printf '%s\n' "$CHECK_OUT" | sed 's/^/  /' >&2
else
    if [ "$FORCE" -eq 1 ]; then
        echo "Note: --force had no effect; bin/check-plan passed."
    fi
    # A stale sidecar from an earlier forced add must not survive a clean add.
    rm -f "$FORCE_SIDECAR"
fi

# Append first: append_entry can fail (queue full, lock held, ln -s error), and
# a failed add must leave the skipped/ or done/ link and its sidecars intact.
append_entry "$SOURCE" "$FILENAME" || exit 1
evict_dispositions "$FILENAME"
if [ "$CHECK_RC" -ne 0 ]; then
    FORCED_AT=$(date +%Y-%m-%dT%H:%M:%S%z)
    # Gate lines are the `[tag] ...` lines; fall back to raw output when none
    # (exit 2 / 127). Capped at 20 lines x 300 chars. awk reads all input.
    GATE_LINES=$(awk '/^\[/ && n < 20 { print substr($0, 1, 300); n++ }' <<< "$CHECK_OUT")
    if [ -z "$GATE_LINES" ]; then
        GATE_LINES=$(awk 'n < 20 { print substr($0, 1, 300); n++ }' <<< "$CHECK_OUT")
    fi
    {
        echo "forced_at: $FORCED_AT"
        echo "user: ${USER:-unknown}"
        echo "check_plan_exit: $CHECK_RC"
        echo "failing_gates:"
        printf '%s\n' "$GATE_LINES"
    } > "$FORCE_SIDECAR"
    FIRST_GATE=$(awk 'NR == 1 { print substr($0, 1, 200) }' <<< "$GATE_LINES")
    printf '%s\t%s\t%s\texit=%s\t%s\n' "$FORCED_AT" "${USER:-unknown}" "$FILENAME" \
        "$CHECK_RC" "$FIRST_GATE" >> "$NIGHTLY_DIR/force-overrides.log"
    echo "Force override logged: $FORCE_SIDECAR"
fi
QUEUED_ENTRY=$(queue_entry_for_slug "$QUEUE_DIR" "$FILENAME")
echo "Queued: $QUEUED_ENTRY -> $(readlink "$QUEUE_DIR/$QUEUED_ENTRY")"
echo ""
show_queue
