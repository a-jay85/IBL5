#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/lib/plan-impl-model — resolve the automouse impl-agent model for a plan file.
#
# Reads a positionally-constrained `impl_model:` field from the plan's FIRST
# YAML frontmatter block (anchored to line 1) and echoes the model id that
# bin/automouse/run passes to `claude -p --model`. The body is never scanned, so
# a plan that merely *documents* the syntax cannot self-select a model.
#
# Accepted values are whitelisted by bin/lib/plan-model-tier: `opus`, `sonnet`,
# `haiku` and their full ids `claude-opus-5`, `claude-sonnet-4-6`,
# `claude-haiku-4-5`. An ABSENT marker still resolves to the Opus default (the
# ~103 marker-less corpus plans depend on it, as does check-plan gate [T]).
# Anything else is REJECTED: one line on stderr, exit 1, nothing on stdout.
#
# Contract: exit 0 -> stdout is one model id, stderr empty;
#           exit 1 -> stdout empty, stderr is exactly one line.
#
# Usage: bin/lib/plan-impl-model <plan-file>   # echoes exactly one model id

set -u

PLAN_FILE="${1:?Usage: plan-impl-model <plan-file>}"

# Line-1-anchored: only a `---` on line 1 opens the frontmatter block; read
# impl_model inside that block, then stop at its closing `---`. A body example
# (no line-1 frontmatter, or after the block closes) is never matched.
RAW=$(awk '
  NR==1 && /^---[[:space:]]*$/ {infm=1; next}
  infm && /^---[[:space:]]*$/ {infm=0; exit}
  infm && /^impl_model:[[:space:]]*/ {sub(/^impl_model:[[:space:]]*/,""); gsub(/[[:space:]]/,""); print; exit}
' "$PLAN_FILE" 2>/dev/null)

LIB_DIR="$(cd "$(dirname "$0")" && pwd)"

# `if VAR=$(...)` (not a bare assignment) so a rejection is handled, not inherited.
# On rejection plan-model-tier puts its one line on STDOUT; this script's stdout is
# reserved for a model id, so re-emit it on STDERR and exit nonzero.
if TIER=$("$LIB_DIR/plan-model-tier" "$RAW"); then
    :
else
    printf '%s\n' "$TIER" >&2
    exit 1
fi

case "$TIER" in
  absent|opus-tier) echo "claude-opus-5"     ;;
  sonnet-tier)      echo "claude-sonnet-4-6" ;;
  haiku-tier)       echo "claude-haiku-4-5"  ;;
esac
