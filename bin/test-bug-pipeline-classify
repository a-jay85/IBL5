#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-bug-pipeline-classify — classifier routing (§3e), thin-bug ordering,
# feature-regression-never-hunts, and the ★ defensive-JSON safe-fallback.
#
# Run: bin/test-bug-pipeline-classify  (exit 0 = all pass, 1 = a case failed)

set -u
# shellcheck source=bin/lib/bug-pipeline-test-stubs.sh
source "$(cd "$(dirname "$0")" && pwd)/lib/bug-pipeline-test-stubs.sh"

bpt_setup

QUEUED='[{"id":7,"status":"queued","class":null,"original_text":"the box score is wrong","original_message_id":"1420000000000000007","thread_id":null,"issue_number":null}]'

order_of() { grep -n "^$1" "$STUB/calls.log" 2>/dev/null | head -1 | cut -d: -f1; }
# The ROUTING transition, specifically. Since the issue number is now persisted at
# its creation site (before the thread is attempted, so a failed create-thread can
# never lose it), a plain `order_of TRANSITION` would find that earlier write instead.
# Only routing transitions carry --class=.
order_of_routing() { grep -n "^TRANSITION .*--class=" "$STUB/calls.log" 2>/dev/null | head -1 | cut -d: -f1; }

# ── not_a_thing → dropped SILENTLY: no reply, no thread ───────────────────
# "Fixed!" / "Thanks!" chatter is the bulk of this class; answering each one is channel
# noise. The transition is the entire job — a dropped row is already invisible to the
# enumerator, so the reply added nothing.
bpt_reset; bpt_set_actionable "$QUEUED"
bpt_set_claude_result '{"class":"not_a_thing"}'
bpt_run
bpt_expect_eq "not_a_thing exits 0" 0 "$BPT_RC"
bpt_log_has   "$STUB" transition.log "dropped --class=not_a_thing" "not_a_thing → dropped"
bpt_log_lacks "$STUB" calls.log "REPLY_TO_MESSAGE" "not_a_thing posts NO in-channel reply"
bpt_log_lacks "$STUB" calls.log "POST_TO_THREAD" "not_a_thing opens no thread"
bpt_log_lacks "$STUB" calls.log "CREATE_THREAD" "not_a_thing creates no thread"

# ── ★ the reply seam is dead for not_a_thing — a failing bot cannot change the drop ─
# STUB_REPLY_FAIL only bites a path that replies. Silence must make it a no-op, which is
# what proves no reply call survives on this branch.
bpt_reset; bpt_set_actionable "$QUEUED"
bpt_set_claude_result '{"class":"not_a_thing"}'
STUB_REPLY_FAIL=1 bpt_run
bpt_expect_eq "reply-seam failure still exits 0" 0 "$BPT_RC"
bpt_log_has   "$STUB" transition.log "dropped --class=not_a_thing" "reply-seam failure does NOT block the drop transition"
bpt_log_lacks "$STUB" calls.log "REPLY_TO_MESSAGE" "still no reply attempted under STUB_REPLY_FAIL"

# ── roster_error → dropped, redirected in-channel, NO issue, NO thread ────────────
# Ratings / contract / team-assignment complaints are JSB-file data the commissioner owns,
# so the pipeline must file nothing and send the GM to #roster-errors.
bpt_reset; bpt_set_actionable "$QUEUED"
bpt_set_claude_result '{"class":"roster_error"}'
bpt_run
bpt_expect_eq "roster_error exits 0" 0 "$BPT_RC"
bpt_log_has   "$STUB" transition.log "dropped --class=roster_error" "roster_error → dropped"
bpt_log_has   "$STUB" calls.log "REPLY_TO_MESSAGE" "roster_error replies in-channel"
bpt_log_has   "$STUB" curl.log "1119361576856715367" "roster_error reply mentions the #roster-errors channel"
bpt_log_lacks "$STUB" calls.log "POST_TO_THREAD" "roster_error opens no thread"
bpt_log_lacks "$STUB" calls.log "CREATE_THREAD" "roster_error creates no thread"
bpt_file_absent "$STUB/gh.log" "roster_error mints no GitHub issue"

# ── ★ roster_error under FILE_ISSUES_ONLY=1 — still files NOTHING ────────────────
# Regression guard for branch placement: file_and_close_row calls bpgh_ensure_issue
# unconditionally, so a roster_error return placed BELOW the file_issues_only block would
# quietly mint an Issue here. This case is the only thing that catches that ordering slip.
bpt_reset; bpt_set_actionable "$QUEUED"
bpt_set_claude_result '{"class":"roster_error"}'
BUG_PIPELINE_FILE_ISSUES_ONLY=1 bpt_run
bpt_expect_eq "flag-on roster_error exits 0" 0 "$BPT_RC"
bpt_log_has   "$STUB" transition.log "dropped --class=roster_error" "flag-on roster_error still dropped"
bpt_log_lacks "$STUB" transition.log "filed" "flag-on roster_error is never filed"
bpt_file_absent "$STUB/gh.log" "flag-on roster_error mints no GitHub issue"

# ── ★ NEGATIVE — the roster_error redirect fails → the row is still dropped ──────
# Same invariant as the not_a_thing case: the transition is load-bearing, the reply cosmetic.
bpt_reset; bpt_set_actionable "$QUEUED"
bpt_set_claude_result '{"class":"roster_error"}'
STUB_REPLY_FAIL=1 bpt_run
bpt_expect_eq "roster_error reply failure still exits 0" 0 "$BPT_RC"
bpt_log_has "$STUB" transition.log "dropped --class=roster_error" "reply failure does NOT block the roster_error drop"

# ── ★ source message deleted → dropped, with no issue, thread, or reply ───────
bpt_reset; bpt_set_actionable "$QUEUED"
bpt_set_claude_result '{"class":"bug","bug_has_enough_info":true,"issue_title":"Box score wrong","severity":"medium"}'
STUB_GET_MESSAGE_DELETED=1 bpt_run
bpt_expect_eq "deleted source exits 0" 0 "$BPT_RC"
bpt_log_has   "$STUB" transition.log "dropped" "deleted source → dropped"
bpt_log_lacks "$STUB" calls.log "CREATE_THREAD" "deleted source opens no thread"
bpt_log_lacks "$STUB" calls.log "REPLY_TO_MESSAGE" "deleted source posts no reply"
bpt_file_absent "$STUB/gh.log" "deleted source mints no GitHub issue"

# ── ★ live edited text wins over the stored snapshot, for this pass only ──────
bpt_reset; bpt_set_actionable "$QUEUED"
bpt_set_claude_result '{"class":"bug","bug_has_enough_info":true,"issue_title":"Box score wrong","severity":"medium"}'
STUB_GET_MESSAGE_CONTENT='actually the standings page 500s on load' bpt_run
bpt_log_has   "$STUB" claude.args.log "actually the standings page 500s on load" "live message text reaches the classify prompt"
bpt_log_lacks "$STUB" claude.args.log "the box score is wrong" "stale snapshot does not reach the classify prompt"
bpt_log_lacks "$STUB" transition.log "--text=" "live text is never written back to original_text"

# ── the default {} get-message body leaves behaviour byte-identical ───────────
bpt_reset; bpt_set_actionable "$QUEUED"
bpt_set_claude_result '{"class":"bug","bug_has_enough_info":true,"issue_title":"Box score wrong","severity":"medium"}'
bpt_run
bpt_log_has "$STUB" calls.log "GET_MESSAGE" "every classify pass reconciles against the live message"
bpt_log_has "$STUB" claude.args.log "the box score is wrong" "empty get-message body falls back to the stored snapshot"

# ── bug + enough → thread opened, ack posted, thread_id persisted, NEVER hunting ──
bpt_reset; bpt_set_actionable "$QUEUED"
bpt_set_claude_result '{"class":"bug","bug_has_enough_info":true,"issue_title":"Box score wrong","severity":"medium"}'
bpt_run
bpt_log_has  "$STUB" calls.log "CREATE_THREAD" "bug+enough opens a thread"
bpt_log_has  "$STUB" curl.log "Looks like a bug" "bug+enough posts the pickup ack"
bpt_log_has  "$STUB" transition.log "queued --class=bug" "bug+enough → queued --class=bug"
bpt_log_has  "$STUB" transition.log "--thread-id=880000000000000001" "bug+enough persists thread_id on the transition"
bpt_log_lacks "$STUB" transition.log "hunting" "bug+enough never emits hunting"

# ── ★ bug-fast-path ordering: create-thread → post-ack → queued transition ────
bpt_reset; bpt_set_actionable "$QUEUED"
bpt_set_claude_result '{"class":"bug","bug_has_enough_info":true,"issue_title":"Box score wrong","severity":"medium"}'
bpt_run
ct="$(order_of CREATE_THREAD)"; pt="$(order_of POST_TO_THREAD)"; tr_line="$(order_of_routing)"
if [ -n "$ct" ] && [ -n "$pt" ] && [ -n "$tr_line" ] && [ "$ct" -lt "$pt" ] && [ "$pt" -lt "$tr_line" ]; then
    bpt_ok "bug-fast-path order: create-thread < post-ack < queued transition"
else
    bpt_fail "bug-fast-path order wrong (create=$ct post=$pt transition=$tr_line)"
fi

# ── ★ NEGATIVE — create-thread fails → transition still proceeds, no --thread-id ──
bpt_reset; bpt_set_actionable "$QUEUED"
bpt_set_claude_result '{"class":"bug","bug_has_enough_info":true,"issue_title":"Box score wrong","severity":"medium"}'
STUB_CREATE_THREAD_FAIL=1 bpt_run
bpt_log_has  "$STUB" calls.log "CREATE_THREAD" "create-thread was attempted"
bpt_log_lacks "$STUB" calls.log "POST_TO_THREAD" "no thread_id → no ack posted"
bpt_log_has  "$STUB" transition.log "queued --class=bug" "create-thread failure does NOT block the queued transition"
bpt_log_lacks "$STUB" transition.log "--thread-id=" "create-thread failure → transition carries no --thread-id"

# ── feature + new → create-thread then gathering ──────────────────────────────
bpt_reset; bpt_set_actionable "$QUEUED"
bpt_set_claude_result '{"class":"feature","feature_is_regression":false,"issue_title":"Add export","severity":"low"}'
bpt_run
bpt_log_has "$STUB" calls.log "CREATE_THREAD" "feature+new opens a thread"
bpt_log_has "$STUB" transition.log "gathering --class=feature" "feature+new → gathering"

# ── ★ thin-bug ordering: create-thread → post-to-thread → transition ──────────
bpt_reset; bpt_set_actionable "$QUEUED"
bpt_set_claude_result '{"class":"bug","bug_has_enough_info":false,"clarifying_question":"which team?","issue_title":"Bug","severity":"low"}'
bpt_run
ct="$(order_of CREATE_THREAD)"; pt="$(order_of POST_TO_THREAD)"; tr_line="$(order_of_routing)"
if [ -n "$ct" ] && [ -n "$pt" ] && [ -n "$tr_line" ] && [ "$ct" -lt "$pt" ] && [ "$pt" -lt "$tr_line" ]; then
    bpt_ok "thin-bug order: create-thread < post-question < awaiting_info transition"
else
    bpt_fail "thin-bug order wrong (create=$ct post=$pt transition=$tr_line)"
fi
bpt_log_has "$STUB" transition.log "awaiting_info --class=bug" "thin-bug → awaiting_info"
bpt_log_has "$STUB" curl.log "which team?" "clarifying question posted"

# ── feature-regression parks as feature, NEVER hunts ──────────────────────────
bpt_reset; bpt_set_actionable "$QUEUED"
bpt_set_claude_result '{"class":"feature","feature_is_regression":true,"issue_title":"Regressed","severity":"high"}'
bpt_run
bpt_log_has  "$STUB" transition.log "--class=feature" "feature-regression stays class=feature"
bpt_log_lacks "$STUB" transition.log "hunting" "feature-regression never emits hunting"

# ── issue projection: classify bug (issue_number null) → gh create + --issue ──
bpt_reset; bpt_set_actionable "$QUEUED"
bpt_set_claude_result '{"class":"bug","bug_has_enough_info":true,"issue_title":"Box score wrong","severity":"medium"}'
STUB_ISSUE_NUMBER=4242 bpt_run
bpt_log_has "$STUB" gh.log "issue create" "classified bug creates a tracking issue"
bpt_log_has "$STUB" transition.log "--issue=4242" "created issue number persisted via --issue"

# ── advisory-field defaults: missing severity/title still creates the issue ───
bpt_reset; bpt_set_actionable "$QUEUED"
bpt_set_claude_result '{"class":"bug","bug_has_enough_info":true}'
bpt_run
bpt_log_has "$STUB" gh.log "severity:low" "missing severity defaults to low"

# ── ★ NEGATIVE — malformed classifier output → safe fallback (no transition) ──
malformed_case() { # name  ; expects claude.out already set
    bpt_run
    bpt_expect_eq "$1 exits 0" 0 "$BPT_RC"
    bpt_file_absent "$STUB/transition.log" "$1 → no transition (row stays queued,class NULL)"
}
bpt_reset; bpt_set_actionable "$QUEUED"; bpt_set_claude_raw 'not json at all'; malformed_case "malformed(a) non-JSON"
bpt_reset; bpt_set_actionable "$QUEUED"; bpt_set_claude_raw '{"type":"result","is_error":true,"result":""}'; malformed_case "malformed(b) is_error:true"
bpt_reset; bpt_set_actionable "$QUEUED"; bpt_set_claude_result '{"class":"garbage"}'; malformed_case "malformed(c) off-whitelist class"
bpt_reset; bpt_set_actionable "$QUEUED"; : > "$STUB/claude.out"; malformed_case "malformed(d) empty stdout"
bpt_reset; bpt_set_actionable "$QUEUED"; bpt_set_claude_raw '{"type":"result","is_error":false,"result":"{}"}'; bpt_set_claude_rc 3; malformed_case "malformed(e) non-zero exit"

# ── BUG_PIPELINE_FILE_ISSUES_ONLY=1 — classify, file issue, reply, close ───────
# When the flag is on, a bug row must: file a GH issue, reply in-channel, and
# transition to 'filed'. No thread opened, no hunting transition.
bpt_reset; bpt_set_actionable "$QUEUED"
bpt_set_claude_result '{"class":"bug","bug_has_enough_info":true,"issue_title":"Box score wrong","severity":"medium"}'
BUG_PIPELINE_FILE_ISSUES_ONLY=1 bpt_run
bpt_expect_eq "flag-on bug exits 0" 0 "$BPT_RC"
bpt_log_has   "$STUB" transition.log "filed"         "flag-on bug → filed"
bpt_log_has   "$STUB" calls.log     "REPLY_TO_MESSAGE" "flag-on bug replies in-channel"
bpt_log_lacks "$STUB" transition.log "queued --class=bug" "flag-on bug never emits queued"
bpt_log_lacks "$STUB" calls.log     "CREATE_THREAD"  "flag-on bug opens no thread"

# flag-on feature row: filed, not gathering
bpt_reset; bpt_set_actionable "$QUEUED"
bpt_set_claude_result '{"class":"feature","issue_title":"Add dark mode","severity":"low"}'
BUG_PIPELINE_FILE_ISSUES_ONLY=1 bpt_run
bpt_expect_eq "flag-on feature exits 0" 0 "$BPT_RC"
bpt_log_has   "$STUB" transition.log "filed"       "flag-on feature → filed"
bpt_log_lacks "$STUB" transition.log "gathering"   "flag-on feature never emits gathering"

# flag-on not_a_thing: still dropped (not filed)
bpt_reset; bpt_set_actionable "$QUEUED"
bpt_set_claude_result '{"class":"not_a_thing"}'
BUG_PIPELINE_FILE_ISSUES_ONLY=1 bpt_run
bpt_log_has   "$STUB" transition.log "dropped"     "flag-on not_a_thing still dropped"
bpt_log_lacks "$STUB" transition.log "filed"       "flag-on not_a_thing not filed"

# flag-on: gh issue creation attempted; issue number persisted via --issue=
bpt_reset; bpt_set_actionable "$QUEUED"
bpt_set_claude_result '{"class":"bug","bug_has_enough_info":true,"issue_title":"Box score wrong","severity":"medium"}'
BUG_PIPELINE_FILE_ISSUES_ONLY=1 bpt_run
bpt_log_has "$STUB" gh.log "issue create" "flag-on files a GitHub Issue"
bpt_log_has "$STUB" transition.log "--issue=" "flag-on persists issue number via --issue="

# flag-on re-tick: row already has issue_number → no new gh create, no new reply
QUEUED_WITH_ISSUE='[{"id":7,"status":"queued","class":null,"original_text":"the box score is wrong","original_message_id":"1420000000000000007","thread_id":null,"issue_number":42}]'
bpt_reset; bpt_set_actionable "$QUEUED_WITH_ISSUE"
bpt_set_claude_result '{"class":"bug","bug_has_enough_info":true,"issue_title":"Box score wrong","severity":"medium"}'
BUG_PIPELINE_FILE_ISSUES_ONLY=1 bpt_run
bpt_expect_eq "re-tick exits 0" 0 "$BPT_RC"
bpt_log_has   "$STUB" transition.log "filed"           "re-tick still transitions to filed"
bpt_log_lacks "$STUB" gh.log     "issue create"        "re-tick mints no second GitHub issue"
bpt_log_lacks "$STUB" calls.log  "REPLY_TO_MESSAGE"    "re-tick sends no duplicate reply"

# flag-on GH_FAIL: ensure_issue returns empty → row left for next tick, not filed
bpt_reset; bpt_set_actionable "$QUEUED"
bpt_set_claude_result '{"class":"bug","bug_has_enough_info":true,"issue_title":"Box score wrong","severity":"medium"}'
BUG_PIPELINE_FILE_ISSUES_ONLY=1 GH_FAIL=1 bpt_run
bpt_expect_eq "GH_FAIL exits 0" 0 "$BPT_RC"
bpt_log_lacks "$STUB" transition.log "filed"           "GH_FAIL: row NOT transitioned to filed"
grep -qF "no issue number" "$STUB/tick.out" \
    && bpt_ok "GH_FAIL: 'no issue number' logged" \
    || bpt_fail "GH_FAIL: 'no issue number' not found in tick.out"

# ── ★ on-demand real-model smoke: the PROMPT actually separates the classes ─────
# Everything above stubs the classifier, so it proves ROUTING and says nothing about
# whether bin/bug-pipeline-classify-prompt returns the class the routing expects. This
# block is the only check on the prompt itself — in particular that a roster complaint
# ("Jokic's contract is wrong") does not land in `bug` and file an Issue, and that the
# over-capture direction is clean too ("the standings page 500s" must stay `bug`).
# Default-SKIP: it spends real inference, so CI never runs it. Opt in with
# BUG_PIPELINE_CLASSIFY_LIVE=1 after any edit to the classify prompt.
if [ "${BUG_PIPELINE_CLASSIFY_LIVE:-0}" != 1 ]; then
    echo "SKIP live: on-demand classify-prompt smoke (set BUG_PIPELINE_CLASSIFY_LIVE=1 — spends real inference)"
elif ! CLASSIFY_CLAUDE="$(command -v claude)" || [ -z "$CLASSIFY_CLAUDE" ]; then
    echo "SKIP live: real 'claude' CLI not found on PATH"
else
    _TICK="$(cd "$(dirname "$0")" && pwd)/bug-pipeline-tick"
    # Reuse the driver's own schema literal so the smoke can never drift from production.
    _SCHEMA="$(sed -n "s/^CLASSIFY_SCHEMA='\(.*\)'$/\1/p" "$_TICK")"
    _TMPL="$(cat "$(cd "$(dirname "$0")" && pwd)/bug-pipeline-classify-prompt")"
    [ -n "$_SCHEMA" ] || bpt_fail "live: could not read CLASSIFY_SCHEMA out of $_TICK"

    live_probe() { # expected report
        local expect="$1" report="$2" p out res got
        p="${_TMPL//\{\{original_text\}\}/$report}"
        p="${p//\{\{transcript\}\}/(no replies yet)}"
        p="${p//\{\{attachments_text\}\}/}"
        out="$(timeout 120 "$CLASSIFY_CLAUDE" -p "$p" --model claude-sonnet-4-6 \
            --output-format json --json-schema "$_SCHEMA" --allowedTools '' 2>/dev/null)"
        # The exact two-step extraction bin/bug-pipeline-tick uses (envelope_result + .class).
        res="$(printf '%s' "$out" | jq -rc 'if (.is_error // false) == true then empty else (.result // empty) end' 2>/dev/null)"
        got="$(printf '%s' "$res" | jq -r '.class // "PARSE_FAIL"' 2>/dev/null)"
        if [ "$got" = "$expect" ]; then
            bpt_ok "live: $expect ← $report"
        else
            bpt_fail "live: want=$expect got=${got:-EMPTY} ← $report"
        fi
    }

    # roster_error — ratings, contract, team assignment (the redirect cases).
    live_probe roster_error "Jokic's contract on his player page shows 2 years left, it should be 4"
    live_probe roster_error "my center's rebounding rating is way too low, he led the league last season"
    live_probe roster_error "Player X is still showing on my roster even though I traded him last week"
    live_probe roster_error "the ratings didn't update for my guys after the last sim"
    # bug — a PAGE or a CALCULATION misbehaving. The over-capture guard.
    live_probe bug          "the standings page 500s on load"
    live_probe bug          "the box score totals don't add up, the team points don't match the player lines"
    live_probe bug          "the trade screen won't let me submit, the button does nothing"
    live_probe feature      "can we get a dark mode for the site"
    # not_a_thing — the silent-drop class.
    live_probe not_a_thing  "Fixed! thanks"
    live_probe not_a_thing  "gm night is tonight right"
fi

echo "----"
[ "$FAILED" -eq 0 ] && echo "ALL PASS" || echo "FAILURES"
exit "$FAILED"
