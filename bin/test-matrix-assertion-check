#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-matrix-assertion-check — regression test for bin/lib/plan-matrix-assertions.
#
# Run: bin/test-matrix-assertion-check [case-name|all]
#   exit 0 = all selected cases pass, 1 = at least one failed

set -euo pipefail

HELPER="$(cd "$(dirname "$0")/.." && pwd)/bin/lib/plan-matrix-assertions"
MATRIX_ASSERTIONS_SCRIPT="$HELPER"

# Scratch-repo commits need an identity; CI runners have none configured.
export GIT_AUTHOR_NAME=T GIT_AUTHOR_EMAIL=t@t.com GIT_COMMITTER_NAME=T GIT_COMMITTER_EMAIL=t@t.com

FAILED=0

ok() { printf 'PASS %s\n' "$1"; }
fail() { printf 'FAIL %s\n' "$1"; FAILED=1; }

# Remove scratch paths (skips empty args). Used by RETURN traps in the step67-*/prefire-* cases
# so temp dirs are cleaned on every return path, early `return 1` included.
# Constraint: those traps rely on bash NOT inheriting RETURN traps into called functions (e.g.
# plan_fixture). Bash only inherits them under `set -T` (functrace); never add `set -T` to this
# script, or the trap fires when plan_fixture returns and deletes the repo mid-test.
_rm_tmp() {
    local _p
    for _p in "$@"; do
        if [ -n "$_p" ]; then rm -rf -- "$_p"; fi
    done
    return 0
}

# Print the standard Verification Matrix header + separator + given rows.
# Usage: plan_fixture <row> [<row>...] — writes the header and rows to stdout.
# To get a plan file outside the repo (keeps git status clean), redirect into a temp path:
#   plan="$(mktemp -d)/plan.md"; plan_fixture '<row>' > "$plan"
plan_fixture() {
    printf '| # | What to verify | Test type | Timing | Test file / location |\n'
    printf '|---|---------------|-----------|--------|---------------------|\n'
    printf '%s\n' "$@"
}

# deleted_diff_fixture <path> [<path>...]
# Prints one git deletion header per path, exactly as `git diff` renders a removed
# binary: diff --git, deleted file mode, index, Binary files ... differ. No `+` lines,
# so the only evidence of the path is the header itself.
deleted_diff_fixture() {
    local p
    for p in "$@"; do
        printf 'diff --git a/%s b/%s\n' "$p" "$p"
        printf 'deleted file mode 100644\n'
        printf 'index 3b18e51..0000000\n'
        printf 'Binary files a/%s and /dev/null differ\n' "$p"
    done
}

# replay_2578_fixture <dir> [tagged]
# Writes the PR #2578 plan's Verification Matrix (14 rows, verbatim) to <dir>/plan.md,
# the PR's unified diff to <dir>/diff.txt, and commits <dir>/tree.txt carrying the two
# tokens the live tree realises (`--self-test`, `.claude/rules/prose-style.md`) so
# arm 3 behaves as it did on the real replay. With "tagged", rows 12 and 14 carry the
# one-time-check tag at the end of their "What to verify" cell.
replay_2578_fixture() {
    local dir="$1" mode="${2:-untagged}"
    cat > "$dir/plan.md" <<'EOF_PLAN'
## Verification Matrix

| # | What to verify | Test type | Timing | Test file / location |
|---|---------------|-----------|--------|---------------------|
| 1 | Baseline: `--self-test` prints `59 cases passed, 20 tells covered` on master (fails if any fixture is edited before Phase 1). | CLI-executable | pre-impl | `bin/check-prose --self-test \| grep '59 cases passed, 20 tells covered'` |
| 2 | Baseline false positive: `#1 seed` and `#1 pick` fire `bare-hash-ref` in chat scope on master (count 1: first-match search). Locks the behavior Phase 1 removes. | CLI-executable | pre-impl | `test "$(printf 'He was the #1 seed and the #1 pick.\n' \| bin/check-prose --stdin --chat \| grep -c bare-hash-ref)" = 1` |
