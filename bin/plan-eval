#!/bin/sh
# Usage: bin/plan-eval <validate|run|compare|smoke|mine> [args]
# Task-completion eval for the /plan skill. See ibl5/docs/plan-eval.md.
# Exit codes: 0 ok, 1 failure, 2 usage, 3 degraded or leaked, 4 runs pending.
# ---
# Default `run` replays the 4 core cases once each with detached workers.
# Repeat `bin/plan-eval run` until it prints the score line; start with --dry-run.
#
set -eu
case "${1:-}" in
    ""|-h|--help)
        sed -n '/^# Usage:/,/^#$/p' "$0" | sed 's/^# \{0,1\}//'
        exit 0 ;;
esac
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PYTHONPATH="$ROOT/tools/postplan-harness${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
exec python3 -m harness.plan_eval "$@"
