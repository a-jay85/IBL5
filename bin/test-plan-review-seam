    seam_case_approve_cap
    seam_case_approve_cntrl
    seam_case_approve_actor
    seam_case_approve_claim_409
    seam_case_approve_send_closed
    seam_case_approve_send_display_merged
    seam_case_approve_send_gadget_fails
    seam_case_approve_send_gadget_junk
    seam_case_approve_send_gadget_timeout
    seam_case_approve_send_gadget_oversize
    seam_case_approve_send_gadget_pr_override
    seam_case_approve_send_timeout_env_empty
    seam_case_approve_send_gadget_bin_empty
    seam_case_approve_send_decision_from_body
    seam_case_approve_send_closed_no_gadget
    seam_case_approve_schedule
    seam_case_approve_cron_flag
    seam_case_approve_fleet_wiring
}
