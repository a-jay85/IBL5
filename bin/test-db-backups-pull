#!/usr/bin/env bash
# bin/test-db-backups-pull — stubbed regression harness for bin/db-backups-pull.
#
# Stubs rsync (copies from a fake "remote" dir) and discord-dm (records calls)
# through env seams, with a fixed NOW. Runs on Linux CI — no ssh, no network.
#
# Run: bin/test-db-backups-pull  (exit 0 = all pass, 1 = a case failed)
set -u
# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
h_tmp TMP

ok() { h_pass "$1"; }
fail() { h_fail "$1" "$2"; }

# Fixed NOW: 2026-03-15 12:00:00 UTC
NOW_EPOCH="$(date -u -d '2026-03-15 12:00:00' +%s 2>/dev/null || date -u -j -f '%Y-%m-%d %H:%M:%S' '2026-03-15 12:00:00' +%s)"

# setup_case <name> — creates remote/, stubs, and exports env seams.
setup_case() {
  CASE="$TMP/$1"
  mkdir -p "$CASE/remote/backups/db" "$CASE/bin"
  cat > "$CASE/rsync-stub" <<'STUB'
#!/usr/bin/env bash
# Args end with: <host>:<path>/ <local>/ . Log all args, refuse --delete.
CASE_DIR="$(dirname "$0")"
printf '%s\n' "$*" >> "$CASE_DIR/rsync-args.log"
for a in "$@"; do
  [ "$a" = "--delete" ] && { echo "stub: --delete passed" >> "$CASE_DIR/delete-seen"; }
done
[ -f "$CASE_DIR/rsync-fail" ] && { echo "ssh: connection refused" >&2; exit 255; }
src="${*: -2:1}"; dst="${*: -1}"
case "$src" in *db-predeploy*) [ -f "$CASE_DIR/rsync-fail-predeploy" ] && { echo "ssh: connection reset" >&2; exit 12; } ;; esac
rel="${src#*:}"
remote="$CASE_DIR/remote/${rel%/}"
if [ ! -d "$remote" ]; then
  echo "rsync: change_dir \"$remote\" failed: No such file or directory (2)" >&2
  # Large trailing output so a printf|grep -q SIGPIPE regression would show.
  [ -f "$CASE_DIR/rsync-noisy" ] && { yes 'rsync: filler diagnostic line to inflate captured stderr' | head -n 5000 >&2; }
  exit 23
fi
for f in "$remote"/*; do [ -f "$f" ] && cp -p "$f" "$dst"; done
# Mimic rsync -a: it copies the remote modes (dir 755, files 644).
chmod 755 "$dst"; for f in "$dst"/*; do [ -f "$f" ] && chmod 644 "$f"; done
exit 0
STUB
  cat > "$CASE/dm-stub" <<'STUB'
#!/usr/bin/env bash
CASE_DIR="$(dirname "$0")"
echo "CALL $*" >> "$CASE_DIR/dm.log"
cat >> "$CASE_DIR/dm.log"
STUB
  chmod +x "$CASE/rsync-stub" "$CASE/dm-stub"
  export DB_BACKUPS_PULL_RSYNC_BIN="$CASE/rsync-stub"
  export DISCORD_DM_BIN="$CASE/dm-stub"
  export DB_BACKUPS_PULL_NOW_EPOCH="$NOW_EPOCH"
  export IBL5_DB_BACKUP_DIR="$CASE/local"
  unset DB_BACKUP_MAX_AGE_HOURS
}

mkgz() { printf 'select 1;\n' | gzip > "$1"; }

run() { OUT="$("$SCRIPT_DIR/db-backups-pull" --ssh-host test@host 2>&1)"; RC=$?; }

# Portable date arithmetic for fixtures: day N before 2026-03-15.
day_before() { date -u -d "2026-03-15 - $1 days" +%F 2>/dev/null || date -u -j -v-"$1"d -f %F 2026-03-15 +%F; }

# (a) pull copies files, dir mode 700
setup_case a
mkgz "$CASE/remote/backups/db/ibl5-2026-03-15.sql.gz"
mkgz "$CASE/remote/backups/db/ibl5-2026-03-14.sql.gz"
run
mode="$(stat -c %a "$CASE/local" 2>/dev/null || stat -f %Lp "$CASE/local")"
fmode="$(stat -c %a "$CASE/local/ibl5-2026-03-15.sql.gz" 2>/dev/null || stat -f %Lp "$CASE/local/ibl5-2026-03-15.sql.gz")"
if [ "$RC" -eq 0 ] && [ -f "$CASE/local/ibl5-2026-03-15.sql.gz" ] && [ -f "$CASE/local/ibl5-2026-03-14.sql.gz" ] && [ "$mode" = 700 ] && [ "$fmode" = 600 ]; then
  ok "a pull copies files, mode 700"
else fail a "rc=$RC mode=$mode out=$OUT"; fi

# (b) never --delete, no -z, rsync-path pinned
if [ ! -f "$CASE/delete-seen" ] && ! grep -qE ' -[a-zA-Z]*z|--compress' "$CASE/rsync-args.log" \
   && grep -q -- '--rsync-path=bin/rsync' "$CASE/rsync-args.log" && grep -q -- '-a --partial' "$CASE/rsync-args.log"; then
  ok "b no --delete, no -z, rsync-path pinned"
else fail b "$(cat "$CASE/rsync-args.log" "$CASE/delete-seen" 2>&1)"; fi

# (c) retention: 60 daily files across 3 months
setup_case c
for i in $(seq 0 59); do mkgz "$CASE/remote/backups/db/ibl5-$(day_before "$i").sql.gz"; done
run
count="$(find "$CASE/local" -maxdepth 1 -name "ibl5-*.sql.gz" | wc -l | tr -d ' ')"
# newest 30 = 03-15..02-14 ; month firsts older than that: 2026-01-15 is the earliest (60 days back = 01-14)
oldest="$(day_before 59)"
jan_first="$(find "$CASE/remote/backups/db" -name "ibl5-*" -exec basename -a {} + | sed 's/ibl5-//;s/.sql.gz//' | grep '^2026-01' | sort | head -1)"
feb_first="$(find "$CASE/remote/backups/db" -name "ibl5-*" -exec basename -a {} + | sed 's/ibl5-//;s/.sql.gz//' | grep '^2026-02' | sort | head -1)"
if [ "$RC" -eq 0 ] && [ -f "$CASE/local/ibl5-$jan_first.sql.gz" ] && [ -f "$CASE/local/ibl5-$feb_first.sql.gz" ] \
   && [ -f "$CASE/local/ibl5-$(day_before 29).sql.gz" ] && [ ! -f "$CASE/local/ibl5-$(day_before 30).sql.gz" ] \
   && [ ! -f "$CASE/local/ibl5-$(day_before 58).sql.gz" ] && [ "$count" -eq 32 ]; then
  ok "c retention keeps 30 newest + month firsts ($count files, oldest $oldest)"
else fail c "rc=$RC count=$count jan=$jan_first feb=$feb_first"; fi

# (d) predeploy keep 20
setup_case d
mkdir -p "$CASE/remote/backups/db-predeploy"
mkgz "$CASE/remote/backups/db/ibl5-2026-03-15.sql.gz"
for i in $(seq 1 25); do mkgz "$CASE/remote/backups/db-predeploy/pre-$(printf '%02d' "$i").sql.gz"; done
run
pcount="$(find "$CASE/local/predeploy" -type f | wc -l | tr -d ' ')"
if [ "$RC" -eq 0 ] && [ "$pcount" -eq 20 ] && [ -f "$CASE/local/predeploy/pre-25.sql.gz" ] && [ ! -f "$CASE/local/predeploy/pre-05.sql.gz" ]; then
  ok "d predeploy keeps newest 20"
else fail d "rc=$RC pcount=$pcount out=$OUT"; fi

# (e) stale -> DM + exit 1; fresh -> no DM + exit 0
setup_case e1
mkgz "$CASE/remote/backups/db/ibl5-2026-03-13.sql.gz"   # 07:30 on 03-13 is 52.5h before NOW
run
if [ "$RC" -eq 1 ] && grep -q 'ibl5-2026-03-13.sql.gz' "$CASE/dm.log" && grep -q 'db-backup.yml' "$CASE/dm.log" \
   && grep -qxF 'CALL --ping --chunk -' "$CASE/dm.log"; then
  ok "e stale -> DM, exit 1"
else fail e1 "rc=$RC dm=$(cat "$CASE/dm.log" 2>&1)"; fi
setup_case e2
mkgz "$CASE/remote/backups/db/ibl5-2026-03-15.sql.gz"
run
if [ "$RC" -eq 0 ] && [ ! -f "$CASE/dm.log" ]; then ok "e fresh -> no DM, exit 0"; else fail e2 "rc=$RC out=$OUT"; fi

# (f) corrupt gzip -> non-zero
setup_case f
mkgz "$CASE/remote/backups/db/ibl5-2026-03-15.sql.gz"
printf 'not gzip' > "$CASE/remote/backups/db/ibl5-2026-03-14.sql.gz"
run
if [ "$RC" -ne 0 ] && grep -q 'CORRUPT' <<< "$OUT" && grep -q 'ibl5-2026-03-14.sql.gz' "$CASE/dm.log" 2>/dev/null; then
  ok "f corrupt gzip -> DM, non-zero"
else fail f "rc=$RC out=$OUT dm=$(cat "$CASE/dm.log" 2>&1)"; fi

# (g) rsync failure -> DM + exit 1
setup_case g
touch "$CASE/rsync-fail"
run
if [ "$RC" -eq 1 ] && [ -f "$CASE/dm.log" ]; then ok "g rsync failure -> DM, exit 1"; else fail g "rc=$RC out=$OUT"; fi

# (g2) predeploy rsync failure still re-locks the already-pulled dailies
setup_case g2
mkgz "$CASE/remote/backups/db/ibl5-2026-03-15.sql.gz"
mkdir -p "$CASE/remote/backups/db-predeploy"
touch "$CASE/rsync-fail-predeploy"
run
mode="$(stat -c %a "$CASE/local" 2>/dev/null || stat -f %Lp "$CASE/local")"
fmode="$(stat -c %a "$CASE/local/ibl5-2026-03-15.sql.gz" 2>/dev/null || stat -f %Lp "$CASE/local/ibl5-2026-03-15.sql.gz")"
if [ "$RC" -eq 1 ] && [ -f "$CASE/dm.log" ] && [ "$mode" = 700 ] && [ "$fmode" = 600 ]; then
  ok "g2 predeploy rsync failure -> DM, exit 1, modes re-locked"
else fail g2 "rc=$RC mode=$mode fmode=$fmode out=$OUT"; fi

# (h) missing remote predeploy dir is not an error
setup_case h
mkgz "$CASE/remote/backups/db/ibl5-2026-03-15.sql.gz"
run
if [ "$RC" -eq 0 ] && [ ! -f "$CASE/dm.log" ]; then ok "h missing predeploy dir tolerated"; else fail h "rc=$RC out=$OUT"; fi

# (h2) missing predeploy dir with large rsync output: logs the skip, sends no DM
setup_case h2
mkgz "$CASE/remote/backups/db/ibl5-2026-03-15.sql.gz"
touch "$CASE/rsync-noisy"
run
if [ "$RC" -eq 0 ] && [ ! -f "$CASE/dm.log" ] && grep -q 'No remote db-predeploy dir yet; skipping' <<< "$OUT"; then
  ok "h2 missing predeploy dir (large output) -> skip logged, no DM"
else fail h2 "rc=$RC dm=$(cat "$CASE/dm.log" 2>&1)"; fi

# (i) --print-schedule
OUT="$("$SCRIPT_DIR/db-backups-pull" --print-schedule 2>&1)"; RC=$?
MAIN_WT="$(git -C "$SCRIPT_DIR" worktree list --porcelain | awk '/^worktree / && !f {print $2; f=1}')"
if [ "$RC" -eq 0 ] && grep -q '<string>com.ibl5.db-backups-pull</string>' <<< "$OUT" \
   && grep -q "<string>$MAIN_WT/bin/db-backups-pull</string>" <<< "$OUT" \
   && grep -q '<integer>10</integer>' <<< "$OUT" && grep -q '<integer>30</integer>' <<< "$OUT"; then
  ok "i print-schedule plist"
else fail i "rc=$RC out=$OUT"; fi

echo "---"
h_done
