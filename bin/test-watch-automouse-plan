#!/usr/bin/env bash
# shellcheck shell=bash
# bin/test-watch-automouse-plan — regression harness for bin/watch-automouse-plan.
# Run: bin/test-watch-automouse-plan  (exit 0 = all pass, 1 = a case failed)
#
# The watcher derives REPO from its own path, so each case copies the script into
# a temp tree with a stub bin/discord-dm and points AUTOMOUSE_DIR at a temp state
# dir. Nothing touches the real queue or sends a real DM.
#
# Counterfactual mutations (point WATCHER_UNDER_TEST at a mutated copy; the named
# case must go red):
#   slug_log greps "$SLUG/" without the phase        -> case 5
#   slug_log first match wins (drop the -nt test)    -> case 4
#   GH_BIN=${WATCH_AUTOMOUSE_GH_BIN-gh} (no colon)   -> case 22
#   fire() without the `date > "$SENTINEL"` line     -> case 1
#
# no-adr: stub-driven regression harness copying the bin/test-watch-run pattern; it adds no architectural constraint and no new governance gate
set -uo pipefail
# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"
REPO_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# WATCHER_UNDER_TEST lets the mutation checks point the harness at a mutated copy.
SRC="${WATCHER_UNDER_TEST:-$REPO_ROOT/bin/watch-automouse-plan}"
# An ambient GH_REPO/GH_HOST would let a real gh resolve a repo from the temp tree.
unset GH_REPO GH_HOST
h_tmp TMP_ROOT
pass() { h_pass "$1"; }
fail() { h_fail "$1"; }
want() { if grep -qF -- "$3" <<< "$2"; then pass "$1"; else fail "$1 (missing: $3)"; fi; }
deny() { if grep -qF -- "$3" <<< "$2"; then fail "$1 (unexpected: $3)"; else pass "$1"; fi; }

# make_tree <name> — fresh copied tree + automouse state dir; sets T and AM.
make_tree() {
    T="$TMP_ROOT/$1"; AM="$T/am"
    mkdir -p "$T/bin" "$AM/queue" "$AM/done" "$AM/skipped" "$AM/logs"
    cp "$SRC" "$T/bin/watch-automouse-plan"; chmod +x "$T/bin/watch-automouse-plan"
    cat > "$T/bin/discord-dm" <<'STUB'
#!/bin/bash
d=$(cd "$(dirname "$0")/.." && pwd)
printf '%s\n' "$*" > "$d/dm.args"
cat > "$d/dm.body"
exit "${STUB_DM_RC:-0}"
STUB
    chmod +x "$T/bin/discord-dm"
}
# run_watch <args...> — bounded run: --poll/--wait/--timeout keep a broken case from hanging.
run_watch() {
    OUT=$(AUTOMOUSE_DIR="$AM" "$T/bin/watch-automouse-plan" --poll 1 --wait 3 --timeout 3 "$@" 2>&1); RC=$?
}
# make_gh_stub — $T/gh-stub records its args and prints one fixed PR.
make_gh_stub() {
    cat > "$T/gh-stub" <<'STUB'
#!/bin/bash
printf '%s\n' "$*" > "$(dirname "$0")/gh.args"
printf '%s\n' '[{"number":42,"url":"https://github.com/a-jay85/IBL5/pull/42","state":"OPEN","title":"Smoke title"}]'
STUB
    chmod +x "$T/gh-stub"
}
# body_is <label> <expected> — compare the stub's captured DM body exactly.
body_is() {
    if [ -f "$T/dm.body" ] && [ "$(cat "$T/dm.body")" = "$2" ]; then pass "$1"
    else fail "$1 (body: $(cat "$T/dm.body" 2>/dev/null || echo '<none>'))"; fi
}
FIRE_MSG='✅ automouse finished **s1** — plan landed in done/.'

echo "== 1. fire happy path (exact body)"
make_tree c1
touch "$AM/done/s1.md"
run_watch --slug s1 --force
expected=$(printf '%s\n\n%s' "$FIRE_MSG" "log: $AM/logs/")
[ "$RC" = 0 ] && pass "exit 0" || fail "exit 0 (got $RC)"
body_is "exact DM body" "$expected"
[ "$(cat "$T/dm.args" 2>/dev/null)" = "-" ] && pass "dm args are -" || fail "dm args are - (got $(cat "$T/dm.args" 2>/dev/null))"
[ -e "$AM/.notified-s1-postplan" ] && pass "sentinel written" || fail "sentinel written"
want "prints notified." "$OUT" "notified."

echo "== 2. fire forwards --to"
make_tree c2
touch "$AM/done/s1.md"
run_watch --slug s1 --force --to 123
[ "$(cat "$T/dm.args" 2>/dev/null)" = "--to 123 -" ] && pass "dm args carry --to" || fail "dm args carry --to (got $(cat "$T/dm.args" 2>/dev/null))"

echo "== 3. fire undelivered"
make_tree c3
touch "$AM/done/s1.md"
OUT=$(STUB_DM_RC=1 AUTOMOUSE_DIR="$AM" "$T/bin/watch-automouse-plan" --poll 1 --wait 3 --timeout 3 --slug s1 --force 2>&1); RC=$?
[ "$RC" = 1 ] && pass "exit 1" || fail "exit 1 (got $RC)"
want "flags undelivered" "$OUT" "NOTIFICATION UNDELIVERED"
want "prints the message" "$OUT" "plan landed in done/."
[ ! -e "$AM/.notified-s1-postplan" ] && pass "no sentinel" || fail "no sentinel"

echo "== 4. slug_log picks the newest matching per-runner log"
make_tree c4
touch "$AM/done/s1.md"
printf '[00:01:00] s1/postplan exit: stop_reason=end_turn\n' > "$AM/logs/2026-08-18-111.log"
printf '[00:01:00] s1/postplan exit: stop_reason=end_turn\n' > "$AM/logs/2026-08-18-222.log"
printf '[00:01:00] s2/postplan exit: stop_reason=end_turn\n' > "$AM/logs/2026-08-18-333.log"
printf '[00:01:00] s1/postplan exit: stop_reason=end_turn\n' > "$AM/logs/2026-08-18.log"
touch -t 202608180100 "$AM/logs/2026-08-18-111.log"
touch -t 202608180200 "$AM/logs/2026-08-18-222.log"
touch -t 202608180300 "$AM/logs/2026-08-18-333.log" "$AM/logs/2026-08-18.log"
run_watch --slug s1 --force
[ "$(tail -n 1 "$T/dm.body" 2>/dev/null)" = "log: $AM/logs/2026-08-18-222.log" ] \
    && pass "newest matching per-runner log linked" \
    || fail "newest matching per-runner log linked (got $(tail -n 1 "$T/dm.body" 2>/dev/null))"

echo "== 5. slug_log is phase-specific"
make_tree c5
touch "$AM/done/s1.md"
printf '[00:01:00] s1/impl exit: stop_reason=end_turn\n' > "$AM/logs/2026-08-18-111.log"
run_watch --slug s1 --force
[ "$(tail -n 1 "$T/dm.body" 2>/dev/null)" = "log: $AM/logs/" ] \
    && pass "other-phase log ignored, falls back to logs dir" \
    || fail "other-phase log ignored, falls back to logs dir (got $(tail -n 1 "$T/dm.body" 2>/dev/null))"

echo "== 6. slug_log fallback with an empty logs dir"
make_tree c6
touch "$AM/done/s1.md"
run_watch --slug s1 --force
want "fallback names the logs dir" "$(cat "$T/dm.body" 2>/dev/null)" "log: $AM/logs/"

echo "== 7. sentinel short-circuit"
make_tree c7
date > "$AM/.notified-s1-postplan"
touch "$AM/done/s1.md"
run_watch --slug s1 --force
[ "$RC" = 0 ] && pass "exit 0" || fail "exit 0 (got $RC)"
want "reports the sentinel" "$OUT" "sentinel present"
[ ! -e "$T/dm.body" ] && pass "no DM sent" || fail "no DM sent"

echo "== 8. queue/ precondition"
make_tree c8
touch "$AM/done/s1.md"
run_watch --slug s1
[ "$RC" = 2 ] && pass "exit 2" || fail "exit 2 (got $RC)"
want "names the disposition dir" "$OUT" "is done/ (already shipped), not in queue/"
[ ! -e "$T/dm.body" ] && pass "no DM sent" || fail "no DM sent"

echo "== 9. empty-env run"
make_tree c9
touch "$AM/done/s1.md"
OUT=$(env -i PATH=/usr/bin:/bin AUTOMOUSE_DIR="$AM" "$T/bin/watch-automouse-plan" --slug s1 --force --poll 1 --wait 3 --timeout 3 2>&1); RC=$?
expected=$(printf '%s\n\n%s' "$FIRE_MSG" "log: $AM/logs/")
[ "$RC" = 0 ] && pass "exit 0 without HOME" || fail "exit 0 without HOME (got $RC: $OUT)"
body_is "same exact body" "$expected"

echo "== 10. seam set: PR block lands between verdict and log"
if command -v jq > /dev/null 2>&1; then
    make_tree c10
    make_gh_stub
    touch "$AM/done/s1.md"
    WATCH_AUTOMOUSE_GH_BIN="$T/gh-stub" run_watch --slug s1 --force
    expected=$(printf '%s\n\n%s\n%s\n\n%s' "$FIRE_MSG" "PR #42 [OPEN] Smoke title" \
        "https://github.com/a-jay85/IBL5/pull/42" "log: $AM/logs/")
    [ "$RC" = 0 ] && pass "exit 0" || fail "exit 0 (got $RC)"
    body_is "body carries the PR block" "$expected"
    want "stub got the pr list args" "$(cat "$T/gh.args" 2>/dev/null)" "pr list --head s1 --state all"
else
    echo "SKIP: case 10 needs jq"
fi

echo "== 11. seam empty: falls back to plain gh"
make_tree c11
make_gh_stub
touch "$AM/done/s1.md"
WATCH_AUTOMOUSE_GH_BIN="" run_watch --slug s1 --force
expected=$(printf '%s\n\n%s' "$FIRE_MSG" "log: $AM/logs/")
[ "$RC" = 0 ] && pass "exit 0" || fail "exit 0 (got $RC)"
body_is "same body as the unset case" "$expected"
[ ! -e "$T/gh.args" ] && pass "stub never called" || fail "stub never called"

echo "== 12. seam points at a missing binary: delivery still happens"
make_tree c12
touch "$AM/done/s1.md"
WATCH_AUTOMOUSE_GH_BIN="$T/no-such-gh" run_watch --slug s1 --force
expected=$(printf '%s\n\n%s' "$FIRE_MSG" "log: $AM/logs/")
[ "$RC" = 0 ] && pass "exit 0" || fail "exit 0 (got $RC)"
body_is "same body as the unset case" "$expected"
[ -e "$AM/.notified-s1-postplan" ] && pass "sentinel written" || fail "sentinel written"

# smoke_run <args...> — --smoke-test exits before the poll loop, so no bounds are needed.
smoke_run() {
    OUT=$(AUTOMOUSE_DIR="$AM" WATCH_AUTOMOUSE_GH_BIN="$T/gh-stub" "$T/bin/watch-automouse-plan" --slug s1 "$@" 2>&1); RC=$?
}
# nothing_sent — a smoke run must leave no DM, sentinel or watcher log behind.
nothing_sent() {
    [ ! -e "$T/dm.body" ] && pass "no DM sent" || fail "no DM sent"
    [ ! -e "$AM/.notified-s1-postplan" ] && pass "no sentinel written" || fail "no sentinel written"
    [ ! -e "$AM/watch-s1-postplan.log" ] && pass "no watcher log" || fail "no watcher log"
}

if command -v jq > /dev/null 2>&1; then HAVE_JQ=1; else HAVE_JQ=0; fi

echo "== 13. smoke happy path, plan nowhere"
if [ "$HAVE_JQ" = 1 ]; then
    make_tree c13
    make_gh_stub
    smoke_run --smoke-test
    [ "$RC" = 0 ] && pass "exit 0" || fail "exit 0 (got $RC)"
    want "discord-dm check" "$OUT" "ok: discord-dm executable"
    want "plan location" "$OUT" "info: plan location nowhere"
    want "message header" "$OUT" "--- message (not sent) ---"
    want "smoke verdict line" "$OUT" "🧪 smoke test for **s1** (postplan) — nothing was sent."
    want "PR block" "$OUT" "PR #42 [OPEN] Smoke title"
    want "log link" "$OUT" "log: $AM/logs/"
    want "pass line" "$OUT" "smoke-test: PASS"
    nothing_sent
else
    echo "SKIP: case 13 needs jq"
fi

echo "== 14. smoke ignores the sentinel"
if [ "$HAVE_JQ" = 1 ]; then
    make_tree c14
    make_gh_stub
    printf 'old\n' > "$AM/.notified-s1-postplan"
    smoke_run --smoke-test
    [ "$RC" = 0 ] && pass "exit 0" || fail "exit 0 (got $RC)"
    deny "no short-circuit" "$OUT" "already notified"
    want "sentinel noted" "$OUT" "info: sentinel present (ignored by --smoke-test)"
    [ "$(cat "$AM/.notified-s1-postplan")" = "old" ] && pass "sentinel untouched" || fail "sentinel untouched"
    [ ! -e "$T/dm.body" ] && pass "no DM sent" || fail "no DM sent"
else
    echo "SKIP: case 14 needs jq"
fi

echo "== 15. smoke renders the same log link fire would"
if [ "$HAVE_JQ" = 1 ]; then
    make_tree c15
    make_gh_stub
    printf '[00:01:00] s1/postplan exit: stop_reason=end_turn\n' > "$AM/logs/2026-08-18-111.log"
    printf '[00:01:00] s1/postplan exit: stop_reason=end_turn\n' > "$AM/logs/2026-08-18-222.log"
    printf '[00:01:00] s2/postplan exit: stop_reason=end_turn\n' > "$AM/logs/2026-08-18-333.log"
    printf '[00:01:00] s1/postplan exit: stop_reason=end_turn\n' > "$AM/logs/2026-08-18.log"
    touch -t 202608180100 "$AM/logs/2026-08-18-111.log"
    touch -t 202608180200 "$AM/logs/2026-08-18-222.log"
    touch -t 202608180300 "$AM/logs/2026-08-18-333.log" "$AM/logs/2026-08-18.log"
    smoke_run --smoke-test
    want "newest matching per-runner log" "$OUT" "log: $AM/logs/2026-08-18-222.log"
else
    echo "SKIP: case 15 needs jq"
fi

echo "== 16. a missing discord-dm fails loudly"
make_tree c16
make_gh_stub
rm "$T/bin/discord-dm"
smoke_run --smoke-test
[ "$RC" = 1 ] && pass "exit 1" || fail "exit 1 (got $RC)"
want "names the failed check" "$OUT" "FAIL: discord-dm executable"
want "counts the failure" "$OUT" "smoke-test: FAIL (1 checks failed)"

echo "== 17. a missing logs dir fails loudly"
make_tree c17
make_gh_stub
rm -rf "$AM/logs"
smoke_run --smoke-test
[ "$RC" = 1 ] && pass "exit 1" || fail "exit 1 (got $RC)"
want "names the failed check" "$OUT" "FAIL: logs dir"
want "fail line" "$OUT" "smoke-test: FAIL"

echo "== 18. --smoke-test --detach is rejected"
make_tree c18
smoke_run --smoke-test --detach
[ "$RC" = 2 ] && pass "exit 2" || fail "exit 2 (got $RC)"
want "names the conflict" "$OUT" "--smoke-test cannot be combined with --detach"
[ ! -e "$AM/watch-s1-postplan.log" ] && pass "no detached re-exec" || fail "no detached re-exec"
[ ! -e "$T/dm.body" ] && pass "no DM sent" || fail "no DM sent"

echo "== 19. --smoke-test=1 is rejected"
make_tree c19
smoke_run --smoke-test=1
[ "$RC" = 2 ] && pass "exit 2" || fail "exit 2 (got $RC)"
want "unknown argument" "$OUT" "unknown argument --smoke-test=1"

echo "== 20. help lists the flag and its exit codes"
make_tree c20
OUT=$("$T/bin/watch-automouse-plan" --help 2>&1); RC=$?
[ "$RC" = 0 ] && pass "exit 0" || fail "exit 0 (got $RC)"
want "flag line" "$OUT" "--smoke-test       one-shot dry run"
want "exit-code line" "$OUT" "--smoke-test: 0 every check ok"

echo "== 21. smoke under an empty env"
if [ "$HAVE_JQ" = 1 ]; then
    make_tree c21
    make_gh_stub
    OUT=$(env -i PATH=/usr/bin:/bin AUTOMOUSE_DIR="$AM" WATCH_AUTOMOUSE_GH_BIN="$T/gh-stub" "$T/bin/watch-automouse-plan" --slug s1 --smoke-test 2>&1); RC=$?
    [ "$RC" = 0 ] && pass "exit 0 without HOME" || fail "exit 0 without HOME (got $RC: $OUT)"
    want "pass line" "$OUT" "smoke-test: PASS"
else
    echo "SKIP: case 21 needs jq"
fi

echo "== 22. empty seam falls back to gh in the smoke check"
make_tree c22
OUT=$(AUTOMOUSE_DIR="$AM" WATCH_AUTOMOUSE_GH_BIN="" "$T/bin/watch-automouse-plan" --slug s1 --smoke-test 2>&1); RC=$?
want "empty seam falls back to gh" "$OUT" "gh resolves (gh)"

h_done
