cp "$SCRIPT_DIR/launchd-health-check" "$CASE/lhc/launchd-health-check"
ln -s "$SCRIPT_DIR/lib" "$CASE/lhc/lib"
printf '#!/bin/sh\nprintf "SIGNAL: stale:rows-stuck — sibling default\\n"\nexit 1\n' > "$CASE/lhc/bug-pipeline-check"
chmod +x "$CASE/lhc/bug-pipeline-check"
OUT="$(env -u BUG_PIPELINE_CHECK_BIN bash "$CASE/lhc/launchd-health-check" 2>/dev/null)"
RC=$?
teardown_case
eq "B11 unset seam runs the sibling checker" 1 "$(count_fail bug-pipeline:stale:rows-stuck)"
eq "B11 no check-failed" 0 "$(count_fail bug-pipeline:check-failed)"
healthy_fixture B12
mkdir -p "$CASE/lhc"
cp "$SCRIPT_DIR/launchd-health-check" "$CASE/lhc/launchd-health-check"
ln -s "$SCRIPT_DIR/lib" "$CASE/lhc/lib"
printf '#!/bin/sh\nprintf "SIGNAL: stale:rows-stuck — sibling default\\n"\nexit 1\n' > "$CASE/lhc/bug-pipeline-check"
chmod +x "$CASE/lhc/bug-pipeline-check"
OUT="$(BUG_PIPELINE_CHECK_BIN='' bash "$CASE/lhc/launchd-health-check" 2>/dev/null)"
RC=$?
teardown_case
eq "B12 empty seam runs the sibling checker" 1 "$(count_fail bug-pipeline:stale:rows-stuck)"
eq "B12 no check-failed" 0 "$(count_fail bug-pipeline:check-failed)"

# B13: launchd-like empty environment under pipefail, set -u stays quiet
healthy_fixture B13
bpc_set 1 'SIGNAL: botkey:missing — no active ibl_api_keys row' 'VERDICT: degraded [botkey:missing]'
OUT="$(env -i HOME="$CASE/home" PATH="$CASE/bin:/usr/bin:/bin" \
    DOCKER_BIN="$DOCKER_BIN" DB_QUERY_BIN="$DB_QUERY_BIN" DISCORD_DM_BIN="$DISCORD_DM_BIN" \
    LAUNCHD_HEALTH_LOG_DIR="$LAUNCHD_HEALTH_LOG_DIR" LAUNCHD_HEALTH_TODAY="$LAUNCHD_HEALTH_TODAY" \
    BUG_PIPELINE_CHECK_BIN="$BUG_PIPELINE_CHECK_BIN" \
    IBL5_USAGE_GATE_STATE_DIR="$IBL5_USAGE_GATE_STATE_DIR" IBL5_USAGE_CLAUDE_PROJECTS="$IBL5_USAGE_CLAUDE_PROJECTS" \
    IBL5_USAGE_GATE_TEST_MODE="$IBL5_USAGE_GATE_TEST_MODE" \
    "$BASH" -o pipefail "$SCRIPT_DIR/launchd-health-check" 2>"$CASE/b13.err")"
RC=$?
teardown_case
eq "B13 rc 1" 1 "$RC"
eq "B13 one botkey:missing" 1 "$(count_fail bug-pipeline:botkey:missing)"
lacks "B13 no unbound variable" "$(cat "$CASE/b13.err")" "unbound variable"

# B13b: same environment with no SIGNAL line, so the final "$n" test reads the counter
healthy_fixture B13b
bpc_set 1 'VERDICT: degraded []'
OUT="$(env -i HOME="$CASE/home" PATH="$CASE/bin:/usr/bin:/bin" \
    DOCKER_BIN="$DOCKER_BIN" DB_QUERY_BIN="$DB_QUERY_BIN" DISCORD_DM_BIN="$DISCORD_DM_BIN" \
    LAUNCHD_HEALTH_LOG_DIR="$LAUNCHD_HEALTH_LOG_DIR" LAUNCHD_HEALTH_TODAY="$LAUNCHD_HEALTH_TODAY" \
    BUG_PIPELINE_CHECK_BIN="$BUG_PIPELINE_CHECK_BIN" \
    IBL5_USAGE_GATE_STATE_DIR="$IBL5_USAGE_GATE_STATE_DIR" IBL5_USAGE_CLAUDE_PROJECTS="$IBL5_USAGE_CLAUDE_PROJECTS" \
    IBL5_USAGE_GATE_TEST_MODE="$IBL5_USAGE_GATE_TEST_MODE" \
    "$BASH" -o pipefail "$SCRIPT_DIR/launchd-health-check" 2>"$CASE/b13.err")"
RC=$?
teardown_case
eq "B13b one check-failed" 1 "$(count_fail bug-pipeline:check-failed)"
lacks "B13b no unbound variable" "$(cat "$CASE/b13.err")" "unbound variable"

# B14/B14b: the real bin/bug-pipeline-check, driven through its own seams
b14_run() {
    healthy_fixture "$1"
    R="$CASE/bpc-real"
    mkdir -p "$R"
    cat > "$R/launchctl" <<'STUB'
#!/bin/sh
case "$1" in
    list)  exit 0 ;;
    print) printf 'last exit code = 0\nruns = 1\n'; exit 0 ;;
    *)     exit 1 ;;
esac
STUB
    cat > "$R/db-query" <<'STUB'
#!/bin/sh
D="$(dirname "$0")"
printf '%s\n' "${DB_QUERY_TARGET:-}" >> "$D/db-target"
case "$*" in
    *ibl_api_keys*) printf '| n |\n|---|\n| %s |\n' "$(cat "$D/botkey-count")" ;;
    *)              printf '| n |\n|---|\n| 0 |\n' ;;
esac
exit 0
STUB
    cat > "$R/curl" <<'STUB'
#!/bin/sh
printf '200'
exit 0
STUB
    chmod +x "$R/launchctl" "$R/db-query" "$R/curl"
    printf '%s\n' "$(date +%s)" > "$R/heartbeat"
    printf '%s\n' "$2" > "$R/botkey-count"
    export BUG_PIPELINE_CHECK_BIN="$SCRIPT_DIR/bug-pipeline-check"
    export BUG_PIPELINE_CHECK_LAUNCHCTL_BIN="$R/launchctl"
    export BUG_PIPELINE_CHECK_DB_QUERY_BIN="$R/db-query"
    export BUG_PIPELINE_CHECK_CURL_BIN="$R/curl"
    export BUG_PIPELINE_TICK_HEARTBEAT="$R/heartbeat"
    run_checker
    unset BUG_PIPELINE_CHECK_LAUNCHCTL_BIN BUG_PIPELINE_CHECK_DB_QUERY_BIN \
          BUG_PIPELINE_CHECK_CURL_BIN BUG_PIPELINE_TICK_HEARTBEAT
}

b14_run B14 0
eq "B14 rc 1" 1 "$RC"
eq "B14 one botkey:missing" 1 "$(count_fail bug-pipeline:botkey:missing)"
eq "B14 exactly one bug-pipeline problem" 1 "$(grep -c 'FAIL: bug-pipeline:' <<< "$OUT")"
has "B14 dm body" "$(cat "$CASE/dm.log" 2>/dev/null)" "botkey:missing"
eq "B14 db-query ran" yes "$([ -s "$R/db-target" ] && echo yes || echo no)"
eq "B14 every db-query call targets main" 0 "$(grep -cvx main "$R/db-target")"

b14_run B14b 1
eq "B14b rc 0" 0 "$RC"
eq "B14b no bug-pipeline lines" 0 "$(grep -c 'bug-pipeline:' <<< "$OUT")"
eq "B14b no DM" 0 "$(dm_blocks)"

# ---------------------------------------------------------------------------
echo ""
h_done
