# ---------------------------------------------------------------------------
# Phase 4 cases
# ---------------------------------------------------------------------------
fixfirst_records() {
    fresh fixfirst_records
    run_oa "$PR" "fix the copy first" "--fix-first=rename the button"
    want_rc 6
    want_out "RESULT: fix-first-recorded"
    grep -qF 'Condition: rename the button' "$FX/posted.1.md" 2>/dev/null || note "no Condition line"
    grep -qF "<!-- owner-approve mode=fix-first head=$H diff=" "$FX/posted.1.md" 2>/dev/null || note "no record line"
    command grep -qE "^<!-- owner-approve mode=fix-first head=$H diff=([0-9a-f]{40}|unread) -->\$" "$FX/posted.1.md" 2>/dev/null \
        || note "record line does not end in diff=<40-hex|unread> -->"
    [ ! -e "$FX/launchctl.log" ] || note "the script waited"
    refute_gh "pr edit"
    refute_gh "pr merge"
}
finish_no_record() {
    fresh finish_no_record
    run_oa "$PR" --finish
    want_rc 4
    want_posted "no owner approval comment"
}
finish_head_unmoved() {
