pra_setup pra-wt pra-br
rt -- --force
chk_rc "alert run" 0
log_has 'PR-ALERT sent pra-br head=' || note_err "no sent line"
[ "$(dm_calls)" = 1 ] || note_err "dm_calls=$(dm_calls), expected 1"
for want in 'https://github.com/a-jay85/IBL5/pull/4242' 'Branch: pra-br' "Worktree: $PRA_WT" \
    "Local head: $(pra_head)" 'pra: stranded change'; do
    grep -qF -- "$want" "$CD/dm-msg" 2>/dev/null || note_err "dm-msg lacks '$want'"
done
grep -qF -- '--attempts 2 -' "$CD/dm-argv" 2>/dev/null || note_err "dm-argv lacks '--attempts 2 -'"
[ "$(pra_marker pra-br)" = "$(pra_head)" ] || note_err "marker is not the head SHA"
log_has 'pr-alert done sent=1' || note_err "no pr-alert done sent=1"
finish_case
fi

