#!/bin/bash
# shellcheck shell=bash
#
# bin/pre-commit-hook — the git pre-commit gate body, version-controlled.
#
# Installed by bin/install-git-hooks, which writes a thin shim to the COMMON git
# hooks dir (git rev-parse --git-common-dir) that exec's this file. Living in the
# repo means the gate is editable from any worktree and travels with a clone,
# instead of being a machine-local untracked hook one developer happens to have.
#
# Six independent blocks. Only the codebase-map regen is advisory; the rest fail the
# commit. The first five are gated on what is staged; the ADR gate is scoped to this
# branch's commits UNION the index, so it runs whenever origin/master resolves.

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Auto-regenerate codebase map when classes/ files are staged.
# Never fails the commit — map freshness is a convenience, not a gate.
if git diff --cached --name-only | grep -q '^ibl5/classes/.*\.php$'; then
    if [ -x "$REPO_ROOT/bin/generate-codebase-map" ]; then
        "$REPO_ROOT/bin/generate-codebase-map" 2>/dev/null
        git add "$REPO_ROOT/.claude/rules/codebase-map.md" 2>/dev/null
    fi
fi

# Enforce gofmt on staged Go files.
staged_go=$(git diff --cached --name-only | grep '\.go$')
if [ -n "$staged_go" ]; then
    unformatted=$(echo "$staged_go" | xargs gofmt -l 2>/dev/null)
    if [ -n "$unformatted" ]; then
        echo "gofmt: unformatted Go files (run gofmt -w):"
        echo "$unformatted"
        exit 1
    fi
fi

# Validate doc frontmatter and references when .md files are staged.
if git diff --cached --name-only | grep -qE '\.md$'; then
    if ! "$REPO_ROOT/bin/check-docs" --no-staleness 2>&1; then
        echo ""
        echo "Fix the above doc issues before committing."
        exit 1
    fi

    # On-touch bump rule. Only --since mode evaluates it, so the full scan above
    # is structurally unable to catch a missing last_verified bump -- that is how
    # PR #1878 merged one. check-docs unions the staged view into its changed set,
    # so this sees the very edit being committed. Fail-and-tell, never --fix-dates:
    # auto-bumping would stamp "verified" on content nobody re-read.
    # Scope note: like the --no-staleness pass above, this reads the WORKING TREE,
    # so an unbumped doc you left unstaged blocks a commit of some other file.
    # Accepted, not a bug: that doc fails CI either way, and --no-verify is the
    # escape hatch for a deliberate partial commit.
    # Skipped when origin/master is unresolvable, so a fetch-less clone still commits.
    doc_base=$(git merge-base HEAD origin/master 2>/dev/null) || doc_base=""
    if [ -n "$doc_base" ]; then
        if ! "$REPO_ROOT/bin/check-docs" --since="$doc_base" 2>&1; then
            echo ""
            echo "Bump last_verified on the doc(s) above (and confirm the content is"
            echo "still accurate) before committing."
            exit 1
        fi
    fi
fi

# Cap the always-loaded rules byte budget when a path-unscoped .claude/rules/*.md
# file is staged. Mirrors the check-docs gate above so a byte-budget overflow is
# caught at commit time instead of surfacing only in CI (Static guards job).
if git diff --cached --name-only | grep -qE '^\.claude/rules/.*\.md$'; then
    if ! "$REPO_ROOT/bin/check-rules-byte-budget" 2>&1; then
        echo ""
        echo "Trim the rule(s) above (or move detail into a path-scoped *-detail.md"
        echo "companion) before committing."
        exit 1
    fi
fi

# Run shellcheck on staged shell scripts.
# CI enforces this check across the full corpus; the pre-commit hook covers only staged files.
# Skip silently if shellcheck is not installed locally.
if command -v shellcheck >/dev/null 2>&1; then
    staged_shell=$(git diff --cached --name-only | "$REPO_ROOT/bin/lib/shell-scripts.sh" --filter \
        | while IFS= read -r f; do [ -e "$f" ] && printf '%s\n' "$f"; done)
    if [ -n "$staged_shell" ]; then
        if ! echo "$staged_shell" | xargs shellcheck --severity=warning --shell=bash \
               --exclude=SC2034,SC1090,SC2207 2>&1; then
            echo ""
            echo "Fix the shellcheck warning(s) above before committing."
            exit 1
        fi
    fi
fi

# Decision-trigger ADR gate. Scoped with bin/adr-check --commit, which reads this
# branch's commits since the merge-base UNION the index -- never --cached alone, so
# an ADR committed earlier on the branch satisfies a trigger staged now. That is the
# "create the ADR first" workflow ibl5/docs/decisions/README.md documents, and a
# --cached-only scope would reject it.
#
# Bypass body is the branch's own commit messages, the same composition
# bin/pre-push-adr-hook pipes in. The message of the commit being made does not
# exist yet at pre-commit time and bin/install-git-hooks installs no commit-msg hook,
# so a deliberate bypass at this point uses git commit --no-verify, the same escape
# hatch the gates above document.
#
# Skipped when origin/master is unresolvable, so a fetch-less clone still commits.
adr_base=$(git merge-base HEAD origin/master 2>/dev/null) || adr_base=""
if [ -n "$adr_base" ]; then
    if ! git log --format=%B "$adr_base..HEAD" 2>/dev/null \
        | "$REPO_ROOT/bin/adr-check" --commit --bypass-from-stdin 2>&1; then
        echo ""
        echo "pre-commit-adr-gate: write the ADR (bin/next-adr \"kebab-title\") and stage it,"
        echo "or add a <!-- no-adr: reason at least 15 characters --> marker to a commit"
        echo "message on this branch, before committing."
        exit 1
    fi
fi
