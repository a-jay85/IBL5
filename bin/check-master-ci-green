#!/bin/bash

# Verifies that all GitHub CI check-runs are green on a given SHA.
# Used by bin/merge-master-to-prod to prevent shipping a red build.
#
# Exit codes: 0 = pass, 1 = CI failure, 2 = usage error.

set -euo pipefail

MIN_REQUIRED_CHECKS="${MIN_REQUIRED_CHECKS:-1}"
GH_API_CMD="${GH_API_CMD:-gh api}"
# Comma-separated EXACT check-run names to ignore. Empty by default: this gate
# stays policy-free, and every caller that needs a skip states it explicitly
# (bin/merge-master-to-prod below, .github/workflows/promote-to-production.yml).
SKIP_CHECKS="${SKIP_CHECKS:-}"

usage() {
    cat <<'EOF'
Usage: bin/check-master-ci-green [SHA] [--skip-ci-check] [--help|-h]

Checks that all GitHub CI check-runs are green on the given SHA
(defaults to origin/master).

Options:
  --skip-ci-check   Emergency bypass — prints a warning and exits 0.
  --help, -h        Show this message.

Environment:
  GH_API_CMD            Override the API command (default: "gh api").
                        For testing: GH_API_CMD='cat /tmp/fixture.json #'
  MIN_REQUIRED_CHECKS   Minimum number of check-runs expected (default: 1).
                        Guards against the post-push race where workflows
                        have not started yet.
  MAX_WALKBACK          How many ancestor commits to check when HEAD has no
                        check-runs (default: 10). Handles path-filtered
                        commits (e.g. Dependabot bumps outside workflow
                        path globs).
  SKIP_CHECKS           Comma-separated EXACT check-run names to ignore
                        (default: none). Matching is exact — a name that
                        merely contains a listed name is NOT skipped.
                        Applied BEFORE the MIN_REQUIRED_CHECKS floor, so
                        skipping everything fails rather than passing.
                        Matched names are echoed to stdout.

Trade-off: uses an "all-must-pass" model rather than a hardcoded check-name
list. A new optional check that lands red will block. Use --skip-ci-check
as the escape hatch, or SKIP_CHECKS for a named, logged exclusion.

Limitation: fetches one page of check-runs (100 results). IBL5's combined
workflow count is well under 50, so a single page suffices. Results are
deduplicated by check name (most recent run wins), so re-runs of flaky
checks are handled correctly.

Exit codes: 0 = pass, 1 = CI failure, 2 = usage error.
EOF
}

SHA=""
SKIP=0

for arg in "$@"; do
    case "$arg" in
        --skip-ci-check)
            SKIP=1
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --*)
            echo "unknown flag: $arg" >&2
            usage >&2
            exit 2
            ;;
        *)
            SHA="$arg"
            ;;
    esac
done

if [ "$SKIP" = "1" ]; then
    echo "BYPASS: --skip-ci-check flag set — skipping CI verification."
    exit 0
fi

if ! gh auth status >/dev/null 2>&1; then
    echo "ERROR: GitHub CLI is not authenticated." >&2
    echo "Run 'gh auth login' to authenticate, then retry." >&2
    exit 2
fi

if [ -z "$SHA" ]; then
    SHA="$(git rev-parse origin/master 2>/dev/null)" || {
        echo "ERROR: cannot resolve origin/master" >&2
        exit 2
    }
fi

REMOTE_URL="$(git remote get-url origin 2>/dev/null)" || {
    echo "ERROR: cannot read origin remote URL" >&2
    exit 2
}

REPO="$(echo "$REMOTE_URL" | sed -E 's#^(https://github\.com/|ssh://git@github\.com/|git@github\.com:)##; s#\.git$##')"
if [ -z "$REPO" ]; then
    echo "ERROR: cannot parse repo slug from origin URL: $REMOTE_URL" >&2
    exit 2
fi

JSON="$(bash -c "$GH_API_CMD \"repos/$REPO/commits/$SHA/check-runs?per_page=100\"" 2>/dev/null)" || {
    echo "ERROR: GitHub API request failed" >&2
    exit 2
}

# Exact-name skip list as a JSON array. "" -> [""] -> [] after the length filter,
# so an unset SKIP_CHECKS is byte-for-byte a no-op.
SKIP_JSON="$(printf '%s\n' "$SKIP_CHECKS" \
  | jq -R 'split(",") | map(sub("^ +";"") | sub(" +$";"")) | map(select(length > 0))')"

# Drop skipped names, then keep only the most recent run per check name
# (re-runs supersede earlier failures). $skip is a jq variable, not shell.
# shellcheck disable=SC2016
DEDUPE_JQ='
  [ .check_runs[] | select(.name | IN($skip[]) | not) ]
  | group_by(.name) | map(sort_by(.completed_at // .started_at) | last)
  | { total_count: length, check_runs: . }
'

if [ "$(printf '%s\n' "$SKIP_JSON" | jq 'length')" -gt 0 ]; then
    MATCHED="$(echo "$JSON" | jq -r --argjson skip "$SKIP_JSON" \
      '[.check_runs[].name] | unique | map(select(IN($skip[]))) | join(", ")')"
    echo "SKIP_CHECKS active — ignoring: ${MATCHED:-<none matched>}"
fi

JSON="$(echo "$JSON" | jq --argjson skip "$SKIP_JSON" "$DEDUPE_JQ")"

TOTAL="$(echo "$JSON" | jq '.check_runs | length')"

if [ "$TOTAL" -eq 0 ]; then
    MAX_WALKBACK="${MAX_WALKBACK:-10}"
    FOUND=0
    for ANCESTOR_SHA in $(git log --format=%H "$SHA" --skip=1 --max-count="$MAX_WALKBACK"); do
        ANCESTOR_JSON="$(bash -c "$GH_API_CMD \"repos/$REPO/commits/$ANCESTOR_SHA/check-runs?per_page=100\"" 2>/dev/null)" || continue
        ANCESTOR_JSON="$(echo "$ANCESTOR_JSON" | jq --argjson skip "$SKIP_JSON" "$DEDUPE_JQ")"
        ANCESTOR_TOTAL="$(echo "$ANCESTOR_JSON" | jq '.check_runs | length')"
        if [ "$ANCESTOR_TOTAL" -ge "$MIN_REQUIRED_CHECKS" ]; then
            echo "HEAD ${SHA:0:11} has no check-runs (path-filtered). Falling back to ancestor ${ANCESTOR_SHA:0:11} ($ANCESTOR_TOTAL run(s))."
            JSON="$ANCESTOR_JSON"
            TOTAL="$ANCESTOR_TOTAL"
            SHA="$ANCESTOR_SHA"
            FOUND=1
            break
        fi
    done
    if [ "$FOUND" = "0" ]; then
        echo "FAIL: only 0 check-run(s) found on HEAD and $MAX_WALKBACK ancestors (minimum: $MIN_REQUIRED_CHECKS)." >&2
        echo "Workflows may not have started yet. Wait and retry." >&2
        exit 1
    fi
elif [ "$TOTAL" -lt "$MIN_REQUIRED_CHECKS" ]; then
    echo "FAIL: only $TOTAL check-run(s) found (minimum: $MIN_REQUIRED_CHECKS)." >&2
    echo "Workflows may not have started yet. Wait and retry." >&2
    exit 1
fi

STILL_RUNNING="$(echo "$JSON" | jq -r '[.check_runs[] | select(.status != "completed")] | map(.name) | join(", ")')"
if [ -n "$STILL_RUNNING" ]; then
    echo "FAIL: checks still running: $STILL_RUNNING" >&2
    exit 1
fi

FAILED="$(echo "$JSON" | jq -r '[.check_runs[] | select(.status == "completed" and (.conclusion | IN("success","skipped","neutral") | not))] | map(.name + " (" + .conclusion + ")") | join(", ")')"
if [ -n "$FAILED" ]; then
    echo "FAIL: checks failed: $FAILED" >&2
    exit 1
fi

echo "PASS: $TOTAL check-run(s) all green on $SHA"
exit 0
