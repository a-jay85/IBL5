# 6: 80 notes under a short your-turn list: every your-turn row stays, the Skipped block is
# cut with a pointer line, and the DM stays inside case 38's length bound.
begin_case
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 FEAT-AWAITING-SIGNOFF sign-off" > "$SCRATCH/triage-out"
i=1
while [[ $i -le 80 ]]; do
    printf '%d\tchecks green\n' "$((5000 + i))"
    i=$((i + 1))
done > "$SKIPIN"
PR_CYCLE_SKIP_NOTES="$SKIPIN" run --worker
[[ $RC -eq 0 ]] || fail "skip-notes-cap-order: exit $RC, want 0"
_dm="$(cat "$SCRATCH/dm.argv")"
grep -qF '#101' <<< "$_dm" || fail "skip-notes-cap-order: your-turn row missing: $_dm"
grep -qF '**Skipped (80)**' <<< "$_dm" || fail "skip-notes-cap-order: Skipped (80) header missing"
grep -qF 'more skipped:' <<< "$_dm" || fail "skip-notes-cap-order: no 'more skipped:' pointer"
_dm_len="$(wc -m < "$SCRATCH/dm.argv" | tr -d ' ')"
[[ "$_dm_len" -le 2000 ]] || fail "skip-notes-cap-order: DM exceeds 2000 chars ($_dm_len)"

# your-turn rows alone overflow: no Skipped block at all.
reset_state
printf '%s' "$ATTACK_4PR" > "$SCRATCH/attack-out"
i=1
while [[ $i -le 40 ]]; do
    printf '#%d  UNCLEARED  run manual tests for this very long title PR number %d\n' \
        "$((2100 + i))" "$i" >> "$SCRATCH/triage-out"
    printf '%d\thttps://github.com/a-jay85/IBL5/pull/%d\tThis is a very long title for pull request number %d that eats characters\n' \
        "$((2100 + i))" "$((2100 + i))" "$i" >> "$SCRATCH/prlist.tsv"
    i=$((i + 1))
done
PR_CYCLE_SKIP_NOTES="$SKIPIN" run --worker
[[ $RC -eq 0 ]] || fail "skip-notes-cap-order overflow: exit $RC, want 0"
grep -qF 'more:' "$SCRATCH/dm.argv" || fail "skip-notes-cap-order overflow: your-turn rows did not overflow"
grep -qF '**Skipped' "$SCRATCH/dm.argv" && fail "skip-notes-cap-order overflow: Skipped block printed after the overflow line"
_dm_len="$(wc -m < "$SCRATCH/dm.argv" | tr -d ' ')"
[[ "$_dm_len" -le 2000 ]] || fail "skip-notes-cap-order overflow: DM exceeds 2000 chars ($_dm_len)"
end_case "case skip-notes-cap-order"

# 7: the launcher bakes the seam into the runner header.
begin_case
reset_state
TSPIN="${TSBASE}4"
RUNNER="/tmp/pr-cycle-$TSPIN.sh"
rm -f "$RUNNER" "/tmp/pr-cycle-$TSPIN.log"
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
PR_CYCLE_SKIP_NOTES="$SCRATCH/notes dir/in.tsv" PR_CYCLE_DRY_LAUNCH=1 TSPIN="$TSPIN" run --go
[[ $RC -eq 0 ]] || fail "launcher-exports-skip-notes: --go exit $RC, want 0"
grep -qF 'export PR_CYCLE_SKIP_NOTES=' "$RUNNER" || fail "launcher-exports-skip-notes: runner lacks the export"
_seam="$(bash -c "$(grep -m1 '^export PR_CYCLE_SKIP_NOTES=' "$RUNNER"); printf '%s' \"\$PR_CYCLE_SKIP_NOTES\"")"
[[ "$_seam" == "$SCRATCH/notes dir/in.tsv" ]] || fail "launcher-exports-skip-notes: runner holds '$_seam'"
rm -f "$RUNNER" "/tmp/pr-cycle-$TSPIN.log" "$SCRATCH/Library/LaunchAgents/com.ibl5.pr-cycle-$TSPIN.plist"
PR_CYCLE_DRY_LAUNCH=1 TSPIN="$TSPIN" run --go
[[ $RC -eq 0 ]] || fail "launcher-exports-skip-notes unset: --go exit $RC, want 0"
grep -qxF "export PR_CYCLE_SKIP_NOTES=''" "$RUNNER" || fail "launcher-exports-skip-notes: unset var not baked as ''"
rm -f "$RUNNER" "/tmp/pr-cycle-$TSPIN.log" "$SCRATCH/Library/LaunchAgents/com.ibl5.pr-cycle-$TSPIN.plist"
unset TSPIN
end_case "case launcher-exports-skip-notes"

# 8: nothing left for the human, one tick note: "Your turn: nothing" then the Skipped block.
begin_case
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 ARMABLE armed" > "$SCRATCH/triage-out"
echo MERGED > "$SCRATCH/state-101"
install_verdict 101 "$TREE_A"
printf '777\tdraft\n' > "$SKIPIN"
PR_CYCLE_SKIP_NOTES="$SKIPIN" run --worker
[[ $RC -eq 0 ]] || fail "your-turn-nothing-with-skips: exit $RC, want 0"
_dm="$(cat "$SCRATCH/dm.argv")"
[[ "$_dm" == *'Your turn: nothing'*'**Skipped (1)**'*'- #777 — draft'* ]] \
    || fail "your-turn-nothing-with-skips: wrong DM: $_dm"
end_case "case your-turn-nothing-with-skips"

# 9: a halted run builds no notes and keeps its stage-2 line.
begin_case
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
printf '777\tdraft\n' > "$SKIPIN"
PR_CYCLE_SKIP_NOTES="$SKIPIN" AUTHPROBE=false run --worker
unset AUTHPROBE
_dm="$(cat "$SCRATCH/dm.argv")"
grep -qF 'Your turn: unknown — stage 2 did not run' <<< "$_dm" || fail "halt-no-skip-block: stage-2 line missing: $_dm"
grep -qF '**Skipped' <<< "$_dm" && fail "halt-no-skip-block: Skipped block on a halted run: $_dm"
[[ -e "$(rundir)/skip-notes.tsv" ]] && fail "halt-no-skip-block: skip-notes.tsv built on a halted run"
end_case "case halt-no-skip-block"

# 10: a fired PR left in your-turn shows what the rescue did.
begin_case
reset_state
mkdir -p "$SCRATCH/fleetlogs"
printf 'post-plan-fleet: outcome=held\npost-plan-fleet: reason=plan sets auto_merge false\n' > "$SCRATCH/fleetlogs/post-plan-fleet-101.log"
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 BLOCKED-CHECK fix-ci" > "$SCRATCH/triage-out"
run --worker
[[ $RC -eq 0 ]] || fail "fired-pr-rescue-outcome-suffix: exit $RC, want 0"
grep -qF '(rescue: held)' "$SCRATCH/dm.argv" || fail "fired-pr-rescue-outcome-suffix: (rescue: held) missing: $(cat "$SCRATCH/dm.argv")"
rm -f "$SCRATCH/fleetlogs/post-plan-fleet-101.log"
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 BLOCKED-CHECK fix-ci" > "$SCRATCH/triage-out"
run --worker
grep -qF '(rescue: failed)' "$SCRATCH/dm.argv" || fail "fired-pr-rescue-outcome-suffix: (rescue: failed) missing: $(cat "$SCRATCH/dm.argv")"
end_case "case fired-pr-rescue-outcome-suffix"

# --- result file: PR_CYCLE_RESULT_FILE holds one TSV row per PR in scope ---------------------
# 101 is skipped by holdrepeat, 102 fires, 103 is over the --max-ready cap.
RES="$SCRATCH/res/result.tsv"
begin_case
hr_cleanup
reset_state
rm -rf "$SCRATCH/res"
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
triage_report "101 NEEDS-WORK rebase" "102 NEEDS-WORK rebase" "103 NEEDS-WORK rebase" \
    > "$SCRATCH/triage-out"
hr_fixture 101 first-slug "7,8"
rm -rf "$SCRATCH/fleetlogs"; mkdir -p "$SCRATCH/fleetlogs"
printf 'post-plan-fleet: %s\n' outcome=shipped 'reason=PR #102' > "$SCRATCH/fleetlogs/post-plan-fleet-102.log"
PR_CYCLE_RESULT_FILE="$RES" HRHARNESS="$HRH" run --worker --only 101,102,103 --max-ready 1
[[ $RC -eq 0 ]] || fail "result-file-rows: exit $RC, want 0"
[[ "$(sed -n 1p "$RES" 2>/dev/null)" == "# pr-cycle-result v1" ]] \
    || fail "result-file-rows: header is '$(sed -n 1p "$RES" 2>/dev/null)'"
[[ "$(sed -n 2p "$RES" 2>/dev/null)" == "$(printf '101\tholdrepeat\t-\t-')" ]] \
    || fail "result-file-rows: row 101 is '$(sed -n 2p "$RES" 2>/dev/null)'"
[[ "$(sed -n 3p "$RES" 2>/dev/null)" == "$(printf '102\tfired\tshipped\tPR #102')" ]] \
    || fail "result-file-rows: row 102 is '$(sed -n 3p "$RES" 2>/dev/null)'"
[[ "$(sed -n 4p "$RES" 2>/dev/null)" == "$(printf '103\tnot-fired\t-\tnot-selected')" ]] \
    || fail "result-file-rows: row 103 is '$(sed -n 4p "$RES" 2>/dev/null)'"
[[ "$(wc -l < "$RES" | tr -d ' ')" == "4" ]] || fail "result-file-rows: want exactly 4 lines"
ls "$SCRATCH/res"/*.tmp.* >/dev/null 2>&1 && fail "result-file-rows: temp file left behind"
hr_cleanup
end_case "result-file-rows"

# A HALT before Stage 1 fires leaves every PR in scope not-fired with reason halt.
begin_case
reset_state
rm -rf "$SCRATCH/res"
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
triage_report "101 NEEDS-WORK rebase" "102 NEEDS-WORK rebase" > "$SCRATCH/triage-out"
touch "$SCRATCH/.ibl5-pr-cycle.stop"
PR_CYCLE_RESULT_FILE="$RES" run --worker --only 101,102
[[ "$(calls ready)" == "0" ]] || fail "result-file-halt: fleet ran under a stop file"
[[ "$(sed -n 2p "$RES" 2>/dev/null)" == "$(printf '101\tnot-fired\t-\thalt')" ]] \
    || fail "result-file-halt: row 101 is '$(sed -n 2p "$RES" 2>/dev/null)'"
[[ "$(sed -n 3p "$RES" 2>/dev/null)" == "$(printf '102\tnot-fired\t-\thalt')" ]] \
    || fail "result-file-halt: row 102 is '$(sed -n 3p "$RES" 2>/dev/null)'"
end_case "result-file-halt"

# A fired PR whose fleet log is missing reads failed/no-log.
begin_case
reset_state
rm -rf "$SCRATCH/res" "$SCRATCH/fleetlogs"
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
triage_report "101 NEEDS-WORK rebase" > "$SCRATCH/triage-out"
PR_CYCLE_RESULT_FILE="$RES" run --worker --only 101
[[ "$(calls ready)" == "1" ]] || fail "result-file-fleet-no-log: fleet did not fire"
[[ "$(sed -n 2p "$RES" 2>/dev/null)" == "$(printf '101\tfired\tfailed\tno-log')" ]] \
    || fail "result-file-fleet-no-log: row 101 is '$(sed -n 2p "$RES" 2>/dev/null)'"
end_case "result-file-fleet-no-log"

# An unset seam and an empty seam both write nothing.
begin_case
reset_state
rm -rf "$SCRATCH/res"
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
triage_report "101 NEEDS-WORK rebase" > "$SCRATCH/triage-out"
run --worker --only 101
[[ $RC -eq 0 ]] || fail "result-file-unset: exit $RC, want 0"
[[ -e "$RES" ]] && fail "result-file-unset: a result file appeared"
grep -qF 'WARN result file' "$ERR" && fail "result-file-unset: warned about a file nobody asked for"
reset_state
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
triage_report "101 NEEDS-WORK rebase" > "$SCRATCH/triage-out"
PR_CYCLE_RESULT_FILE="" run --worker --only 101
[[ $RC -eq 0 ]] || fail "result-file-empty: exit $RC, want 0"
[[ -e "$SCRATCH/res" ]] && fail "result-file-empty: a result directory appeared"
grep -qF 'WARN result file' "$ERR" && fail "result-file-empty: warned about a file nobody asked for"
end_case "result-file-unset and result-file-empty"

# --go bakes the seam into the runner header, %q-quoted, so it survives launchd.
begin_case
reset_state
TSPIN="${TSBASE}3"
RUNNER="/tmp/pr-cycle-$TSPIN.sh"
rm -f "$RUNNER" "/tmp/pr-cycle-$TSPIN.log"
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
PR_CYCLE_RESULT_FILE="$SCRATCH/res dir/out.tsv" PR_CYCLE_DRY_LAUNCH=1 TSPIN="$TSPIN" run --go
[[ $RC -eq 0 ]] || fail "launch-passes-result-file-seam: --go exit $RC, want 0"
grep -qF 'export PR_CYCLE_RESULT_FILE=' "$RUNNER" \
    || fail "launch-passes-result-file-seam: runner lacks the export"
_seam="$(bash -c "$(grep -m1 '^export PR_CYCLE_RESULT_FILE=' "$RUNNER"); printf '%s' \"\$PR_CYCLE_RESULT_FILE\"")"
[[ "$_seam" == "$SCRATCH/res dir/out.tsv" ]] \
    || fail "launch-passes-result-file-seam: runner holds '$_seam'"
rm -f "$RUNNER" "/tmp/pr-cycle-$TSPIN.log" "$SCRATCH/Library/LaunchAgents/com.ibl5.pr-cycle-$TSPIN.plist"
unset TSPIN
end_case "launch-passes-result-file-seam"

begin_case
# Case A: details-shaped sticky, matching diff -> skip pr-ready
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 ARMABLE armed" > "$SCRATCH/triage-out"
install_harness_verdict 101 "$DIFF_A" "$DIFF_A" 'READY' details
run --worker
[[ "$(calls ready)" == "0" ]] || fail "fix5 details READY: fleet ran $(calls ready) time(s), want 0"
grep -qF 'skipping pr-ready' <<< "$OUT" || fail "fix5 details READY: skip line missing"

# Case B: details-shaped sticky, stale diff -> must run pr-ready
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 ARMABLE armed" > "$SCRATCH/triage-out"
install_harness_verdict 101 "$DIFF_A" "$DIFF_B" 'READY' details
run --worker
[[ "$(calls ready)" == "1" ]] || fail "fix5 details stale diff: fleet skipped; want 1 ready call, got $(calls ready)"

# Case C: legacy READY WITH NOTES suffix and bare READY WITH NOTES behave identically
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 ARMABLE armed" > "$SCRATCH/triage-out"
install_harness_verdict 101 "$DIFF_A" "$DIFF_A" 'READY WITH NOTES — notes left for the merging reviewer; the compiled harness remediates only NOT READY' details
run --worker
_fix5_legacy="$(calls ready)"
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 ARMABLE armed" > "$SCRATCH/triage-out"
install_harness_verdict 101 "$DIFF_A" "$DIFF_A" 'READY WITH NOTES' details
run --worker
_fix5_bare="$(calls ready)"
[[ "$_fix5_legacy" == "$_fix5_bare" ]] || fail "fix5 READY WITH NOTES: suffix form ran fleet $_fix5_legacy time(s), bare form $_fix5_bare"
end_case "case fix5 details-shaped harness sticky"

# bin/pr-cycle-tick hands bin/pr-cycle the exact argv shape `--go --only <csv> --max-ready <n>`.
# Pin the dry-run form of it here, so a _normalize_prs change that drops comma input fails
# this case before the tick breaks silently.
begin_case
reset_state
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
run --dry-run --only 101,102 --max-ready 2
[[ $RC -eq 0 ]] || fail "tick argv contract: '--dry-run --only 101,102 --max-ready 2' exit $RC, want 0"
reset_state
run --dry-run --only 101,abc --max-ready 2
[[ $RC -eq 2 ]] || fail "tick argv contract: '--only 101,abc' exit $RC, want 2"
end_case "tick-argv-contract"

# --- summary --------------------------------------------------------------------------------
if [[ $FAILED -eq 0 ]]; then
    echo "test-pr-cycle: ALL PASS"
    exit 0
fi
echo "test-pr-cycle: $FAILED failure(s)" >&2
exit 1
