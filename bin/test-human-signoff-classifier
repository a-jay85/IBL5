# Every registry entry in the real ibl5/bun.lock fits the entry shape, so the
# exemption cannot hold a PR only because bun writes a shape it does not know.
# shellcheck disable=SC2016  # $1.. expand inside the child bash
DP_REAL=$(bash -c 'set -euo pipefail; source "$1"; n=0; : > "$3"
    while IFS= read -r l; do
        if [[ $l =~ $UI_LOCK_PKG_RE ]]; then n=$((n + 1)); printf "%s\n" "${BASH_REMATCH[2]}" >> "$3"; fi
    done < "$2"
    # UI_LOCK_ENTRY_JQ prints the package name for an entry that fits and errors otherwise.
    ok=$(jq -r --arg re "$UI_LOCK_NAME_RE" --arg spec "$UI_LOCK_SPEC_RE" "$UI_LOCK_ENTRY_JQ" "$3" | grep -c . || true)
    echo "n=$n ok=$ok"' _ "$UI_LIB" "$REPO_ROOT/ibl5/bun.lock" "$UI_TMP/dp-real-entries.txt" 2>&1)
if [[ $DP_REAL =~ ^n=([0-9]+)\ ok=([0-9]+)$ ]] && [ "${BASH_REMATCH[1]}" = "${BASH_REMATCH[2]}" ] \
    && [ "${BASH_REMATCH[1]}" -ge 100 ]; then
    h_pass "dp: every registry entry in ibl5/bun.lock fits the entry shape"
else
    h_fail "dp: every registry entry in ibl5/bun.lock fits the entry shape" "$DP_REAL"
fi

