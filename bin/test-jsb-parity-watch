case_fix_pr_stale_dms_once() {
    sandbox fix_young
    quiet_row
    one_fix $((BASE - 172800))
    run_watch
    h_eq "no PR at exactly 48h: no DM" 0 "$(cnt discord-dm)"
    sandbox fix_stale
    quiet_row
    one_fix $((BASE - 172801))
    fix_pr_dm_case "no fix PR after 48h" fixer-no-pr
}

case_fix_gh_error_no_action() {
    sandbox fix_gh_error
    arm_fixer
    one_fix "$BASE"
    : > "$S/fix/gh-fail-$FIX_SLUG"
    run_watch
    rc_is "fix gh failure: exit 0" 0
    no_actions "fix gh failure"
    h_contains "fix gh failure: line names the slug" "$(out)" "gh pr list failed for $FIX_SLUG"
    h_absent "fix gh failure: nothing queued" "$S/home/.cache/jsb-parity-fixer-queue.txt"
}

case_fixer_dry_run_prints_decisions() {
    sandbox fixer_dry
    quiet_row
    arm_fixer
    write_blockers "$(jq -nc '{active: {"days-empty": {fix: "f", bucket: "fixer", dm_sent: false}},
        fixer: {open: {"capture-thin:pl-0002": {slug: "jsb-fix-capture-thin-pl-0002-t1", at: 1, jsbn_base: "a"},
                       "capture-thin:pl-0003": {slug: "jsb-fix-capture-thin-pl-0003-t1", at: 1, jsbn_base: "b"}}}}')"
    gh_pr jsb-fix-capture-thin-pl-0002-t1 98 MERGED no f1 "$GREEN"
    gh_pr jsb-fix-capture-thin-pl-0003-t1 99 CLOSED no f2 "$GREEN"
    run_watch --dry-run
    rc_is "dry run: exit 0" 0
    h_contains "dry run: wake line" "$(out)" "fixer: wake days-empty"
    h_contains "dry run: merged line" "$(out)" "fixer: fix-merged jsb-fix-capture-thin-pl-0002-t1"
    h_contains "dry run: dm line" "$(out)" "fixer: dm fixer-pr-closed:capture-thin:pl-0003:jsb-fix-capture-thin-pl-0003-t1"
    h_not_contains "dry run: no ERR trap line" "$(out)" "error at line"
    no_actions "fixer dry run"
    h_absent "dry run: nothing under the cache" "$S/home/.cache"
}

case_missing_blockers_json_as_today() {
    local body
    for body in missing '{not json' '[1]' '{"active":"x","fixer":7}'; do
        sandbox "no_blockers_${#body}"
        arm_fixer
        [ "$body" = missing ] || write_blockers "$body"
        gh_pr jsb-port-pl-0001 7 MERGED no sha1 "$GREEN"
        run_watch
        rc_is "blockers $body: exit 0" 0
        h_eq "blockers $body: the parity fire happens" 1 "$(posts parity)"
        h_eq "blockers $body: no fixer POST" 0 "$(posts fixer)"
        h_eq "blockers $body: one gh call" 1 "$(cnt gh)"
        h_not_contains "blockers $body: no ERR trap line" "$(out)" "error at line"
    done
}

case_fixer_prunes_resolved_keys() {
    sandbox fixer_prune
    quiet_row
    arm_fixer
    one_blocker days-empty
    run_watch
    h_contains "queued while active" "$(QUEUE)" "days-empty"
    one_blocker replay-missing
    reset_logs
    NOW=$((BASE + 3600)) run_watch
    h_not_contains "a resolved key leaves the queue" "$(QUEUE)" "days-empty"
    h_contains "the live key is queued" "$(QUEUE)" "replay-missing"
    h_not_contains "a resolved key loses its wake line" \
        "$(slurp "$S/home/.cache/jsb-parity-fixer-wakes.txt")" "days-empty"
    one_blocker days-empty
    reset_logs
    NOW=$((BASE + 7200)) run_watch
    h_eq "a recurrence wakes the fixer again" 1 "$(posts fixer)"
    write_blockers 'not json'
    NOW=$((BASE + 10800)) run_watch
    h_contains "an unreadable state file prunes nothing" "$(QUEUE)" "days-empty"
}

case_fixer_keeps_hidden_stall() {
    local key="stall:no-trace:pl-0001" wakes
    sandbox fixer_hidden_stall
    wakes="$S/home/.cache/jsb-parity-fixer-wakes.txt"
    arm_fixer
    run_watch
    h_eq "before hiding: one fixer POST" 1 "$(posts fixer)"
    # An unrelated plan-now job with no log hides the stall for one run.
    printf -- '-\t0\tcom.ibl5.plan-now-20261123-012805-44230\n' > "$S/fix/launchctl-list"
    reset_logs
    NOW=$((BASE + 3600)) run_watch
    h_contains "hidden run: verdict is a wait" "$(out)" "WAIT:plan-now-unattributed"
    h_contains "hidden stall stays queued" "$(QUEUE)" "$key"
    h_contains "hidden stall keeps its wake line" "$(slurp "$wakes")" \
        "$(printf '%s\t%s\t%s' "$key" "$BASE" "$BASE")"
    rm -f "$S/fix/launchctl-list"
    reset_logs
    NOW=$((BASE + 7200)) run_watch
    h_eq "stall back inside 6h: no second wake" 0 "$(posts fixer)"
    NOW=$((BASE + 10801)) run_watch
    h_eq "stall past 3h from the first wake: one DM" 1 "$(cnt discord-dm)"
    printf -- '-\t0\tcom.ibl5.plan-now-20261123-012805-44230\n' > "$S/fix/launchctl-list"
    NOW=$((BASE + 14400)) run_watch
    rm -f "$S/fix/launchctl-list"
    NOW=$((BASE + 18000)) run_watch
    h_eq "hidden again after the DM: still one DM" 1 "$(cnt discord-dm)"
    # A row with a PR has really left the stall, so its lines go.
    quiet_row
    NOW=$((BASE + 19000)) run_watch
    h_not_contains "a recovered row leaves the queue" "$(QUEUE)" "$key"
    h_not_contains "a recovered row loses its wake line" "$(slurp "$wakes")" "$key"
}

case_setup_save_fixer_webhook_mode_600() {
    local file mode
    sandbox setup_save_hook
    file="$S/home/.config/jsb-parity/fixer-webhook-url"
    printf 'https://t3.example/hook/FIXER-SECRET\n' > "$S/url.in"
    run_setup --save-fixer-webhook < "$S/url.in"
    rc_is "save: exit 0" 0
    h_eq "save: file holds the URL" "https://t3.example/hook/FIXER-SECRET" "$(slurp "$file")"
    mode=$(stat -c %a "$file" 2>/dev/null || stat -f %Lp "$file" 2>/dev/null || echo unknown)
    h_eq "save: mode 600" 600 "$mode"
    h_contains "save: says it saved" "$(out)" "saved fixer webhook (mode 600)"
    h_not_contains "save: stdout hides the URL" "$(out)" "FIXER-SECRET"
    h_not_contains "save: stderr hides the URL" "$(slurp "$S/err")" "FIXER-SECRET"
    h_eq "save: parity webhook-url untouched" "$SECRET" "$(slurp "$S/home/.config/jsb-parity/webhook-url")"
}

case_setup_save_fixer_webhook_rejects_non_https() {
    local bad
    sandbox setup_save_bad
    for bad in 'http://t3.example/hook/FIXER-SECRET' 'https://t3.example/a b' ''; do
        printf '%s\n' "$bad" > "$S/url.in"
        run_setup --save-fixer-webhook < "$S/url.in"
        rc_is "reject '$bad': exit 2" 2
        h_absent "reject '$bad': no file" "$S/home/.config/jsb-parity/fixer-webhook-url"
        h_not_contains "reject '$bad': stderr hides the input" "$(slurp "$S/err")" "FIXER-SECRET"
    done
}

case_setup_rejects_unknown_flag() {
    local a
    sandbox setup_fixer_flag
    for a in --save-fixer-webhooks --print-fixer-prompt=1; do
        run_setup "$a"
        rc_is "$a: exit 2" 2
        h_contains "$a: usage names the fixer flag" "$(slurp "$S/err")" "--save-fixer-webhook "
    done
    h_absent "unknown flag: no webhook file" "$S/home/.config/jsb-parity/fixer-webhook-url"
}

case_setup_fixer_prompt_brief_passes_guard() {
    local prompt rc=0
    sandbox setup_fixer_prompt
    run_setup --print-fixer-prompt
    rc_is "prompt: exit 0" 0
    prompt=$(out)
    h_contains "prompt: claims before work" "$prompt" "fix claim"
    h_contains "prompt: checks the brief" "$prompt" "--brief"
    h_contains "prompt: records a failure" "$prompt" "fix fail"
    h_contains "prompt: names the try cap" "$prompt" '"status": "over-cap" with "cap": "try"'
    h_contains "prompt: skips a blocked key" "$prompt" "Skip it for this wake"
    h_contains "prompt: ends on the daily cap" "$prompt" 'including "cap": "daily", end.'
    h_absent "prompt: no plist written" "$S/home/Library/LaunchAgents/$PLIST_NAME"
    # The brief prompt step 4 describes.
    {
        printf '/plan Fix the parity blocker %s\n' "$FIX_KEY"
        printf -- '- Branch slug: `%s`\n' "$FIX_SLUG"
        "$REPO/bin/check-parity-rule-guard" --print-rule-block
        printf 'Diagnosis: the capture hook sits on the wrong address.\n'
        printf 'Use plan-architect (Opus) for this plan.\n'
    } > "$S/brief.prompt"
    "$REPO/bin/check-parity-rule-guard" --brief "$S/brief.prompt" > "$S/guard.out" 2>&1 || rc=$?
    h_eq "prompt: the described brief passes the guard" 0 "$rc"
}

case_secret_never_leaks() {
    sandbox secret_merged
    gh_pr jsb-port-pl-0001 7 MERGED no sha1 "$GREEN"
    run_watch
    no_secret_in "merged fire"
    h_contains "positive control: curl stdin holds the secret" "$(slurp "$S/log/curl.stdin")" "T3-SECRET"
    sandbox secret_held
    gh_pr jsb-port-pl-0001 42 OPEN no aaa "$GREEN"
    run_watch
    no_secret_in "held-for-owner DM"
    sandbox secret_500
    gh_pr jsb-port-pl-0001 7 MERGED no sha1 "$GREEN"
    printf '500' > "$S/fix/curl-code"
    run_watch
    no_secret_in "curl 500"
    local before after code
    for code in 204 500; do
        sandbox "secret_fixer_$code"
        quiet_row
        arm_fixer
        one_blocker days-empty
        printf '%s' "$code" > "$S/fix/curl-code"
        before=$(cksum < "$S/parity/state/blockers.json")
        run_watch
        after=$(cksum < "$S/parity/state/blockers.json")
        no_secret_in "fixer wake HTTP $code"
        h_contains "positive control: curl stdin holds the fixer secret ($code)" "$(slurp "$S/log/curl.stdin")" "FIXER-SECRET"
        h_eq "blockers.json byte-identical ($code)" "$before" "$after"
    done
}

case_read_only_surfaces() {
    local before after
    sandbox read_only
    gh_pr jsb-port-pl-0001 42 OPEN no aaa "$ROLL_FAILED"
    before=$(find "$S/parity" -type f -exec cksum {} + | sort)
    run_watch
    after=$(find "$S/parity" -type f -exec cksum {} + | sort)
    h_eq "a fire leaves the parity dir byte-identical" "$before" "$after"
    h_eq "the check-failed fire happened" 1 "$(cnt curl)"
    sandbox read_only_fixer
    quiet_row
    arm_fixer
    one_fix $((BASE - 172801))
    gh_pr "$FIX_SLUG" 99 MERGED no f1 "$GREEN"
    before=$(sha256_file "$S/parity/state/blockers.json")
    run_watch
    after=$(sha256_file "$S/parity/state/blockers.json")
    h_eq "fixer paths leave blockers.json byte-identical" "$before" "$after"
    h_eq "the merged-fix fire happened" 1 "$(posts parity)"
}

case_gh_read_only() {
    local bad
    sandbox gh_ro
    gh_pr jsb-port-pl-0001 42 OPEN no aaa "$GREEN"
    run_watch
    h_exists "gh was called" "$S/log/gh.argv"
    bad=$(grep -vc '^pr list' "$S/log/gh.argv" || true)
    h_eq "every gh call is pr list" 0 "$bad"
    sandbox gh_ro_fixer
    arm_fixer
    one_fix "$BASE"
    run_watch
    h_contains "the fix PR is read" "$(slurp "$S/log/gh.argv")" "--head $FIX_SLUG"
    bad=$(grep -vc '^pr list' "$S/log/gh.argv" || true)
    h_eq "every fixer gh call is pr list" 0 "$bad"
}

# --- CLI cases (rows 33-39) ---------------------------------------------------------

case_dry_run_no_action() {
    sandbox dry_run
    ledger "pl-0001:captured:jsb-port-pl-0001" "pl-0002:captured:jsb-port-pl-0002" "pl-0003:captured:jsb-port-pl-0003"
    gh_pr jsb-port-pl-0001 7 MERGED no sha1 "$GREEN"
    : > "$(AM)/queue/010-jsb-port-pl-0002.md"
    gh_pr jsb-port-pl-0003 42 OPEN no aaa "$GREEN"
    run_watch --dry-run
    rc_is "dry-run: exit 0" 0
    h_contains "dry-run: config line" "$(out)" "config: parity_dir="
    h_eq "dry-run: one row line per row" 3 "$(grep -c '^row ' "$S/out")"
    h_contains "dry-run: says what it would do" "$(out)" "dry-run: would"
    h_contains "dry-run: decision line" "$(out)" "decision: "
    no_actions "dry-run"
    h_absent "dry-run: no cache dir" "$S/home/.cache"
}

case_unknown_flag_rejected() {
    local a
    sandbox unknown_flag
    for a in --bogus --dry-run=1; do
        run_watch "$a"
        rc_is "$a: exit 2" 2
        h_contains "$a: stderr says so" "$(slurp "$S/err")" "unknown argument"
        h_absent "$a: gh never called" "$S/log/gh.argv"
    done
}

# config_value <key>: the value of key=... on the dry-run config line.
config_value() {
    local line
    line=$(grep '^config:' "$S/out" | head -n 1)
    line="${line#*"$1"=}"
    printf '%s' "${line%% *}"
}

main_checkout() { git -C "$REPO" worktree list --porcelain | awk '/^worktree / && !f {print $2; f=1}'; }

case_env_empty_parity_dir() {
    sandbox env_parity
    JSB_WATCH_PARITY_DIR='' run_watch --dry-run
    h_eq "empty parity dir falls back to the main checkout" "$(main_checkout)/jsb-native/parity" "$(config_value parity_dir)"
}

case_env_empty_bin() {
    sandbox env_bin
    JSB_WATCH_BIN='' run_watch --dry-run
    h_eq "empty bin falls back to the script dir" "$REPO/bin" "$(config_value bin)"
}

case_env_empty_plannow_dir() {
    sandbox env_plannow
    JSB_WATCH_PLANNOW_DIR='' run_watch --dry-run
    h_eq "empty plan-now dir falls back to /tmp" "/tmp" "$(config_value plannow_dir)"
}

case_env_empty_now() {
    local got real diff
    sandbox env_now
    JSB_WATCH_NOW='' run_watch --dry-run
    got=$(config_value now)
    real=$(date +%s)
    case "$got" in
        ''|*[!0-9]*) h_fail "empty now falls back to the clock" "got [$got]"; return 0 ;;
    esac
    diff=$((real - got))
    if [ "$diff" -lt 0 ]; then diff=$((0 - diff)); fi
    if [ "$diff" -le 5 ]; then h_pass "empty now falls back to the clock"; else h_fail "empty now falls back to the clock" "off by ${diff}s"; fi
}

case_env_invalid_now() {
    sandbox env_bad_now
    JSB_WATCH_NOW=abc run_watch
    rc_is "invalid now: exit 2" 2
    h_contains "invalid now: usage message" "$(slurp "$S/err")" "epoch seconds"
}

# --- Installer cases (rows 40-49) ---------------------------------------------------

# plist_get <file> <python expression over d>
plist_get() {
    python3 -I -c 'import plistlib, sys; d = plistlib.load(open(sys.argv[1], "rb")); print(eval(sys.argv[2]))' "$1" "$2"
}

PLIST_NAME="com.ibl5.jsb-parity-watch.plist"

case_setup_print_schedule() {
    sandbox setup_print
    run_setup --print-schedule
    rc_is "print-schedule: exit 0" 0
    cp "$S/out" "$S/print.plist"
    h_eq "label" "com.ibl5.jsb-parity-watch" "$(plist_get "$S/print.plist" 'd["Label"]')"
    h_eq "StartInterval" 3600 "$(plist_get "$S/print.plist" 'd["StartInterval"]')"
    h_eq "RunAtLoad" True "$(plist_get "$S/print.plist" 'd["RunAtLoad"]')"
    h_contains "wrapper points at the main checkout" "$(plist_get "$S/print.plist" 'd["ProgramArguments"][2]')" "$S/main/bin/jsb-parity-watch"
    h_eq "log path" "$S/home/Library/Logs/jsb-parity-watch.log" "$(plist_get "$S/print.plist" 'd["StandardOutPath"]')"
    h_absent "no plist written" "$S/home/Library/LaunchAgents/$PLIST_NAME"
    h_absent "launchctl never called" "$S/log/launchctl.argv"
}

case_setup_plist_no_empty_string() {
    sandbox setup_empty
    run_setup --print-schedule
    h_not_contains "no empty string element" "$(out)" "<string></string>"
}

case_setup_plist_no_unexpanded_var() {
    local hits
    sandbox setup_var
    run_setup --print-schedule
    hits=$(grep -cE '\$(\{|[A-Za-z_])' "$S/out" || true)
    h_eq "no unexpanded variable reference" 0 "$hits"
}

case_setup_install_idempotent() {
    local a b
    sandbox setup_install
    run_setup
    rc_is "first install: exit 0" 0
    a=$(cksum < "$S/home/Library/LaunchAgents/$PLIST_NAME")
    run_setup
    rc_is "second install: exit 0" 0
    b=$(cksum < "$S/home/Library/LaunchAgents/$PLIST_NAME")
    h_eq "plist is byte-identical after the second install" "$a" "$b"
    h_eq "a bootstrap per run" 2 "$(grep -c '^bootstrap' "$S/log/launchctl.argv")"
    h_contains "install notes that the program is not there yet" "$(out)" "appears when the PR merges"
}

case_setup_uninstall_idempotent() {
    sandbox setup_uninstall
    run_setup
    h_exists "installed first" "$S/home/Library/LaunchAgents/$PLIST_NAME"
    run_setup --uninstall
    rc_is "first uninstall: exit 0" 0
    run_setup --uninstall
    rc_is "second uninstall: exit 0" 0
    h_absent "plist removed" "$S/home/Library/LaunchAgents/$PLIST_NAME"
}

case_setup_from_worktree_points_main() {
    sandbox setup_worktree
    mkdir -p "$S/wt"
    SETUP_REPO_ROOT="$S/wt" run_setup
    rc_is "install from a worktree: exit 0" 0
    h_contains "wrapper names the main checkout" "$(plist_get "$S/home/Library/LaunchAgents/$PLIST_NAME" 'd["ProgramArguments"][2]')" "$S/main/bin/jsb-parity-watch"
    h_not_contains "wrapper never names the worktree" "$(plist_get "$S/home/Library/LaunchAgents/$PLIST_NAME" 'd["ProgramArguments"][2]')" "$S/wt"
}

case_setup_wrapper_missing_target() {
    local w rc
    sandbox setup_wrapper
    run_setup --print-schedule
    cp "$S/out" "$S/print.plist"
    w=$(plist_get "$S/print.plist" 'd["ProgramArguments"][2]')
    /bin/sh -c "$w"
    rc=$?
    h_eq "missing program: wrapper exits 0" 0 "$rc"
    mkdir -p "$S/main/bin"
    printf '#!/bin/sh\nexit 3\n' > "$S/main/bin/jsb-parity-watch"
    chmod 755 "$S/main/bin/jsb-parity-watch"
    /bin/sh -c "$w"
    rc=$?
    h_eq "present program: wrapper passes its exit code through" 3 "$rc"
}

case_setup_unknown_flag_rejected() {
    local a
    sandbox setup_flag
    for a in --bogus --uninstall=1; do
        run_setup "$a"
        rc_is "$a: exit 2" 2
        h_contains "$a: stderr says so" "$(slurp "$S/err")" "unknown argument"
        h_absent "$a: no plist written" "$S/home/Library/LaunchAgents/$PLIST_NAME"
    done
    run_setup --print-schedule --uninstall
    rc_is "a second argument: exit 2" 2
}

case_setup_main_wt_empty() {
    sandbox setup_main_empty
    SETUP_MAIN_WT='' run_setup --print-schedule
    cp "$S/out" "$S/print.plist"
    h_contains "empty MAIN_WT falls back to the first worktree" "$(plist_get "$S/print.plist" 'd["ProgramArguments"][2]')" "$(main_checkout)/bin/jsb-parity-watch"
    # An unset MAIN_WT falls back the same way. A guard written as ${MAIN_WT+set}
    # would keep the empty value above, so the first assertion would fail.
    env -u MAIN_WT HOME="$S/home" REPO_ROOT="$REPO" "$REPO/bin/jsb-parity-watch-setup" --print-schedule > "$S/print-unset.plist" 2> "$S/err"
    h_contains "unset MAIN_WT falls back to the first worktree" "$(plist_get "$S/print-unset.plist" 'd["ProgramArguments"][2]')" "$(main_checkout)/bin/jsb-parity-watch"
}

# --- Dispatch ------------------------------------------------------------------------

ALL_CASES=""
while read -r _ _ fn; do
    case "$fn" in
        case_*) ALL_CASES="$ALL_CASES $fn" ;;
    esac
done < <(declare -F)

if [ $# -gt 0 ]; then
    CASES="$*"
else
    CASES="$ALL_CASES"
fi

for c in $CASES; do
    case "$ALL_CASES " in
        *" $c "*) "$c" ;;
        *) h_fail "unknown case: $c" ;;
    esac
done

h_done
