#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/wt-gc-tick — scheduled merged-worktree sweep driver (ADR-0165).
#
# Fired hourly by the launchd LaunchAgent installed by bin/wt-gc-cron-setup.
# Runs the unchanged `bin/cleanup --all` (reaps only proven-merged worktrees;
# in-use and dirty worktrees are skipped by cleanup itself), then counts what
# the sweep must never delete (STALLED, UNPUSHED, EMPTY, OPEN-PR) via the
# read-only bin/wt-status and logs it.
#
# NEVER passes --discard-generated, --discard-closed, or --drop-merged-stashes to bin/cleanup.
# The cleanup argv is a literal; no flag of this script forwards to it.
#
# Gates, in order: kill switch (WT_GC_ENABLED=0), fail-closed HID-idle gate,
# 6h minimum-interval stamp, single-flight PID lock. Every gated skip is exit 0.
# Exit 1 only for a bad flag, an unresolvable repo root, a failed
# bin/cleanup / bin/wt-status, or a failed reap step (so the launchd health
# check alerts).
#
# After the surface counts, six reap steps from bin/lib/wt-gc-reap.sh run in
# order, each in a subshell behind its own kill switch ("0" disables it):
#   empty         WT_GC_REAP_EMPTY         EMPTY worktrees older than
#                                          WT_GC_EMPTY_DAYS (7), re-verified
#   dirty-merged  WT_GC_REAP_DIRTY_MERGED  merged worktrees whose dirt is
#                                          byte-identical to origin/master
#   refs          WT_GC_REAP_REFS          backup branches (PR merged >
#                                          WT_GC_BACKUP_DAYS, 7), refs/tmp,
#                                          refs/wt-sync-backup, refs/backup
#                                          (> WT_GC_REF_DAYS, 14), refs of
#                                          remotes absent from `git remote`
#   tmp-pack      WT_GC_REAP_TMP_PACK      objects/pack/tmp_pack_* older than
#                                          WT_GC_TMP_PACK_DAYS (1), not open
#   docker        WT_GC_DOCKER_PRUNE       image + builder prune, filter
#                                          until=WT_GC_DOCKER_UNTIL (168h)
#   stale-list    WT_GC_STALE_LIST         STALLED/UNPUSHED older than
#                                          WT_GC_STALE_DAYS (7) to
#                                          WT_GC_STALE_FILE for the digest
# Every deleted branch/ref is first written as "<sha> <ref>" to a dated file
# under WT_GC_TIPS_DIR. Every probe that gates a delete keeps on error. A step
# failure logs, exits 1 and withholds the stamp, so the next idle tick retries.
#
# Usage: bin/wt-gc-tick [--dry-run] [--force] [--help]
#   --dry-run         Pass --dry-run to cleanup; never write the stamp.
#   --force           Bypass the HID-idle gate and the min-interval stamp.
#   --help            Print this header comment.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=bin/lib/tick-guards.sh disable=SC1091
source "$SCRIPT_DIR/lib/tick-guards.sh"

# launchd and `env -i` runs may lack HOME.
if [ -z "${HOME:-}" ]; then HOME="$(cd ~ 2>/dev/null && pwd)"; export HOME; fi

# ── Env seams (defaults = production; tests override) ─────────────────────────
WT_GC_ENABLED="${WT_GC_ENABLED:-1}"            # "0" = kill switch; any other value = enabled
WT_GC_IDLE_SECS="${WT_GC_IDLE_SECS:-1800}"     # HID idle required before a sweep
WT_GC_MIN_INTERVAL_SECS="${WT_GC_MIN_INTERVAL_SECS:-21600}"  # one real sweep per 6h at most
WT_GC_LOCK_DIR="${WT_GC_LOCK_DIR:-$HOME/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/wt-gc}"
WT_GC_LOG="${WT_GC_LOG:-$WT_GC_LOCK_DIR/wt-gc.log}"
# Absolute on purpose: the launchd PATH once omitted /usr/sbin and a bare
# `ioreg` fail-closed every tick (see bin/wt-sync-tick).
WT_GC_IOREG="${WT_GC_IOREG:-/usr/sbin/ioreg}"
WT_GC_REPO_ROOT="${WT_GC_REPO_ROOT:-}"         # empty = derive main checkout (below)
WT_GC_CLEANUP="${WT_GC_CLEANUP:-$SCRIPT_DIR/cleanup}"        # test seam: argv-capture stub
WT_GC_WT_STATUS="${WT_GC_WT_STATUS:-$SCRIPT_DIR/wt-status}"  # test seam: fixture output
# Per-step kill switches: "0" disables that step only; unset/empty = enabled.
WT_GC_REAP_EMPTY="${WT_GC_REAP_EMPTY:-1}"
WT_GC_REAP_DIRTY_MERGED="${WT_GC_REAP_DIRTY_MERGED:-1}"
WT_GC_REAP_REFS="${WT_GC_REAP_REFS:-1}"
WT_GC_REAP_TMP_PACK="${WT_GC_REAP_TMP_PACK:-1}"
WT_GC_DOCKER_PRUNE="${WT_GC_DOCKER_PRUNE:-1}"
WT_GC_STALE_LIST="${WT_GC_STALE_LIST:-1}"
# Ages (days) / Docker until-filter. Non-numeric or empty = that step skipped, rc=1.
WT_GC_EMPTY_DAYS="${WT_GC_EMPTY_DAYS-7}"
WT_GC_BACKUP_DAYS="${WT_GC_BACKUP_DAYS-7}"
WT_GC_REF_DAYS="${WT_GC_REF_DAYS-14}"
WT_GC_TMP_PACK_DAYS="${WT_GC_TMP_PACK_DAYS-1}"
WT_GC_STALE_DAYS="${WT_GC_STALE_DAYS-7}"
WT_GC_DOCKER_UNTIL="${WT_GC_DOCKER_UNTIL-168h}"
# Paths / binaries.
WT_GC_TIPS_DIR="${WT_GC_TIPS_DIR:-$WT_GC_LOCK_DIR/tips}"
WT_GC_STALE_FILE="${WT_GC_STALE_FILE:-$WT_GC_LOCK_DIR/stale-worktrees.tsv}"
WT_GC_WT_REMOVE="${WT_GC_WT_REMOVE:-$SCRIPT_DIR/wt-remove}"
WT_GC_QUEUE_DIR="${WT_GC_QUEUE_DIR:-$HOME/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/automouse/queue}"
WT_GC_SESSION_REGISTRY="${WT_GC_SESSION_REGISTRY:-$HOME/.claude/session-registry/active.json}"
WT_GC_LAUNCHCTL="${WT_GC_LAUNCHCTL:-/bin/launchctl}"
# The launchd PATH is minimal, so WT_GC_LSOF / WT_GC_GH / WT_GC_DOCKER are
# resolved after the library loads: PATH first, then these dirs. A seam that
# is set, even to "", is used as given and never resolved. "" or a missing
# file means "not found", and the step that needs it keeps everything.
WT_GC_BIN_DIRS="${WT_GC_BIN_DIRS-/usr/sbin:/opt/homebrew/bin:/usr/local/bin}"

# ── Logging ───────────────────────────────────────────────────────────────────
log() {
    local line
    line="$(printf '[%s] %s' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*")"
    printf '%s\n' "$line"
    { mkdir -p "$(dirname "$WT_GC_LOG")" && printf '%s\n' "$line" >> "$WT_GC_LOG"; } 2>/dev/null || true
}

DRY_RUN=0
FORCE=0
while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DRY_RUN=1; shift ;;
        --force)   FORCE=1;   shift ;;
        -h|--help)
            awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"
            exit 0 ;;
        *) log "Unknown option: $1" >&2; exit 1 ;;
    esac
done

# ── Kill switch ───────────────────────────────────────────────────────────────
if [ "$WT_GC_ENABLED" = 0 ]; then
    log "disabled (WT_GC_ENABLED=0) — exiting"
    exit 0
fi

# ── Interval seam validation (fail-closed) ────────────────────────────────────
case "$WT_GC_IDLE_SECS" in
    ''|*[!0-9]*)
        log "invalid WT_GC_IDLE_SECS '$WT_GC_IDLE_SECS' — fail-closed"
        exit 0 ;;
esac
case "$WT_GC_MIN_INTERVAL_SECS" in
    ''|*[!0-9]*)
        log "invalid WT_GC_MIN_INTERVAL_SECS '$WT_GC_MIN_INTERVAL_SECS' — fail-closed"
        exit 0 ;;
esac

# ── Repo root ─────────────────────────────────────────────────────────────────
# shellcheck source=bin/lib/git-helpers.sh disable=SC1091
source "$SCRIPT_DIR/lib/git-helpers.sh"
# shellcheck source=bin/lib/wt-guards.sh disable=SC1091
source "$SCRIPT_DIR/lib/wt-guards.sh"
# shellcheck source=bin/lib/wt-gc-reap.sh disable=SC1091
source "$SCRIPT_DIR/lib/wt-gc-reap.sh"
[ -n "${WT_GC_LSOF+x}" ]   || WT_GC_LSOF="$(_gc_resolve_bin lsof)"
[ -n "${WT_GC_GH+x}" ]     || WT_GC_GH="$(_gc_resolve_bin gh)"
[ -n "${WT_GC_DOCKER+x}" ] || WT_GC_DOCKER="$(_gc_resolve_bin docker)"
if [ -z "$WT_GC_REPO_ROOT" ]; then
    WT_GC_REPO_ROOT="$(main_checkout_root "$SCRIPT_DIR/..")" || WT_GC_REPO_ROOT=""
fi
if [ -z "$WT_GC_REPO_ROOT" ]; then
    log "cannot resolve repo root — aborting"
    exit 1
fi

# ── Presence gate (HID idle) ──────────────────────────────────────────────────
# Fail-closed: missing reader, empty, or non-numeric idle means operator present.
if [ "$FORCE" = 0 ]; then
    idle_rc=0
    idle="$(hid_idle_secs "$WT_GC_IOREG")" || idle_rc=$?
    case "$idle_rc" in
        0) ;;
        1)
            log "idle reader missing or not executable ('$WT_GC_IOREG') — treating as operator present (fail-closed)"
            exit 0
            ;;
        *)
            log "idle value unreadable ('${idle:-<empty>}') — treating as operator present (fail-closed)"
            exit 0
            ;;
    esac
    if [ "$idle" -lt "$WT_GC_IDLE_SECS" ]; then
        log "operator present (idle ${idle}s < threshold ${WT_GC_IDLE_SECS}s) — exiting"
        exit 0
    fi
    log "idle ${idle}s >= threshold ${WT_GC_IDLE_SECS}s — proceeding"
fi

mkdir -p "$WT_GC_LOCK_DIR" 2>/dev/null || true
STAMP_FILE="$WT_GC_LOCK_DIR/last-sweep"
LOCK_FILE="$WT_GC_LOCK_DIR/wt-gc.lock"

# ── Min-interval gate ─────────────────────────────────────────────────────────
# A missing or non-numeric stamp means "never swept".
if [ "$FORCE" = 0 ] && [ "$DRY_RUN" = 0 ] && [ -f "$STAMP_FILE" ]; then
    stamp="$(cat "$STAMP_FILE" 2>/dev/null || true)"
    case "$stamp" in
        ''|*[!0-9]*) ;;
        *)
            ago=$(( $(date +%s) - stamp ))
            if [ "$ago" -lt "$WT_GC_MIN_INTERVAL_SECS" ]; then
                log "last sweep ${ago}s ago < ${WT_GC_MIN_INTERVAL_SECS}s — exiting"
                exit 0
            fi
            ;;
    esac
fi

# ── Single-flight lock ────────────────────────────────────────────────────────
# Event shim for tick_lock_acquire: keeps this tick's log wording.
_gc_lock_event() {
    case "$1" in
        held)         log "previous tick (pid $2) still running — exiting" ;;
        stale)        log "stale lock (pid ${2:-<unreadable>}) — reclaiming" ;;
        write-failed) log "could not write lock file $2 — aborting" ;;
    esac
}
if ! tick_lock_acquire "$LOCK_FILE" _gc_lock_event; then
    exit 0
fi
TMP_OUT="$(mktemp "${TMPDIR:-/tmp}/wt-gc-out.XXXXXX")"
TMP_STATUS="$(mktemp "${TMPDIR:-/tmp}/wt-gc-status.XXXXXX")"
TMP_STEP="$(mktemp "${TMPDIR:-/tmp}/wt-gc-step.XXXXXX")"
trap 'tick_lock_release "$LOCK_FILE"; rm -f "$TMP_OUT" "$TMP_STATUS" "$TMP_STEP"' EXIT

EXIT_CODE=0

# ── Sweep ─────────────────────────────────────────────────────────────────────
# The argv is a literal, never built from caller input.
if [ "$DRY_RUN" = 1 ]; then set -- --all --dry-run; else set -- --all; fi
cleanup_rc=0
(cd "$WT_GC_REPO_ROOT" && "$WT_GC_CLEANUP" "$@") > "$TMP_OUT" 2>&1 || cleanup_rc=$?
{ cat "$TMP_OUT" >> "$WT_GC_LOG"; } 2>/dev/null || true

summary="$(sed -nE 's/^Summary: ([0-9]+) cleaned, ([0-9]+) skipped$/\1 \2/p' "$TMP_OUT" | tail -1)"
cleaned="?"
skipped="?"
summary_state=missing
if [ -n "$summary" ]; then
    cleaned="${summary% *}"
    skipped="${summary#* }"
    summary_state=present
fi
if [ "$cleanup_rc" -ne 0 ] || [ "$summary_state" = missing ]; then
    log "cleanup failed (rc=$cleanup_rc, summary=$summary_state)"
    EXIT_CODE=1
fi

# ── Surface (read-only classifier; never fetches) ─────────────────────────────
status_rc=0
(cd "$WT_GC_REPO_ROOT" && "$WT_GC_WT_STATUS") > "$TMP_STATUS" 2>/dev/null || status_rc=$?
if [ "$status_rc" -ne 0 ]; then
    log "wt-status failed (rc=$status_rc)"
    EXIT_CODE=1
fi

counts="$(awk '
    $1=="STALLED"  {s++}
    $1=="UNPUSHED" {u++}
    $1=="EMPTY"    {e++}
    $1=="OPEN-PR"  {o++}
    $1=="MERGED"   {m++}
    END {printf "%d %d %d %d %d", s, u, e, o, m}' "$TMP_STATUS")"
read -r n_stalled n_unpushed n_empty n_open_pr n_merged <<EOF
$counts
EOF

awk '$1=="STALLED" || $1=="UNPUSHED" {print $1, $2}' "$TMP_STATUS" | while read -r cls wt; do
    log "SURFACE $cls $wt"
done

# ── Reap steps (bin/lib/wt-gc-reap.sh) ────────────────────────────────────────
STEPS_FAILED=0
# run_step <name> <switch-value> <switch-name> <fn>: kill switch, then the step
# in a subshell so `set -e` inside it can never abort the sweep. Step log()
# lines reach stdout and the log directly; stray stderr is appended to the log.
run_step() {
    local name="$1" sw="$2" swname="$3" fn="$4" rc=0
    if [ "$sw" = 0 ]; then log "step $name disabled ($swname=0)"; return 0; fi
    # Background + wait: a `( ... ) || cmd` list would run the subshell in a
    # context where bash ignores errexit. errexit covers the step's own
    # commands; helpers a step calls as `f || rc=1` run without it and rely on
    # their explicit returns.
    ( set -euo pipefail; "$fn" ) 2> "$TMP_STEP" &
    wait $! || rc=$?
    { cat "$TMP_STEP" >> "$WT_GC_LOG"; } 2>/dev/null || true
    if [ "$rc" -ne 0 ]; then
        log "step $name failed (rc=$rc) — continuing"
        STEPS_FAILED=$((STEPS_FAILED + 1)); EXIT_CODE=1
    fi
}
run_step empty        "$WT_GC_REAP_EMPTY"        WT_GC_REAP_EMPTY        reap_empty_worktrees
run_step dirty-merged "$WT_GC_REAP_DIRTY_MERGED" WT_GC_REAP_DIRTY_MERGED reap_dirty_merged_worktrees
run_step refs         "$WT_GC_REAP_REFS"         WT_GC_REAP_REFS         reap_stale_refs
run_step tmp-pack     "$WT_GC_REAP_TMP_PACK"     WT_GC_REAP_TMP_PACK     reap_tmp_packs
run_step docker       "$WT_GC_DOCKER_PRUNE"      WT_GC_DOCKER_PRUNE      docker_prune
run_step stale-list   "$WT_GC_STALE_LIST"        WT_GC_STALE_LIST        write_stale_list
log "reap done steps_failed=$STEPS_FAILED"

log "done dry_run=$DRY_RUN cleaned=$cleaned skipped=$skipped stalled=$n_stalled unpushed=$n_unpushed empty=$n_empty open_pr=$n_open_pr merged=$n_merged rc=$EXIT_CODE"

if [ "$EXIT_CODE" -eq 0 ] && [ "$DRY_RUN" = 0 ]; then
    date +%s > "$STAMP_FILE" 2>/dev/null || true
fi
exit "$EXIT_CODE"
