rm -f "$HOME/.claude/hooks/sneaky.sh"
need "rc 21" test "$RC" = 21
need "final line" final_is "$STDOUT" gave-up-gate-path
need "DM names the hooks dir" dm_has ".claude/hooks"
case_end holdrepeat-user-hook-blocked
fi

