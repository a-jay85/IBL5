# ── Binary resolution (lsof / gh / docker) ────────────────────────────────────
# A launchd-style PATH: one dir of symlinks to every tool on this PATH except
# docker, gh and lsof. The binary seams are dropped (-VAR) so the tick resolves
# them from PATH and then WT_GC_BIN_DIRS.
P_SYS="$ROOT/sys-nobin"
mkdir -p "$P_SYS" "$ROOT/seam" "$ROOT/seam-empty" "$ROOT/seam-lsof"
IFS=: read -r -a P_DIRS <<< "$PATH"
for d in "${P_DIRS[@]}"; do
    case "$d" in ''|"$ROOT"/*) continue ;; esac
    for f in "$d"/*; do
        n="${f##*/}"
        case "$n" in docker|gh|lsof) continue ;; esac
        if [ -x "$f" ] && [ ! -d "$f" ] && [ ! -e "$P_SYS/$n" ] && [ ! -L "$P_SYS/$n" ]; then
            ln -s "$f" "$P_SYS/$n"
        fi
    done
done
ln -s "$STUBBIN/docker" "$ROOT/seam/docker"
ln -s "$STUBBIN/gh-stub" "$ROOT/seam/gh"
ln -s "$STUBBIN/lsof" "$ROOT/seam/lsof"
ln -s "$STUBBIN/lsof" "$ROOT/seam-lsof/lsof"
P_RES=(-WT_GC_LSOF -WT_GC_GH -WT_GC_DOCKER PATH="$P_SYS")
# p_fixture — one candidate per binary: EMPTY worktree (lsof live-work probe),
# old tmp_pack (lsof), dirty-merged worktree and merged backup branch (gh),
# docker prune.
p_fixture() {
    mk_wt e-old e-old age_days=10; row EMPTY e-old
    d_wt d2 match
    mk_ref refs/heads/backup/3382-pre-rebase 1
    epoch_ago 8 > "$CD/gh/3382.json"
    mkdir -p "$ENV_MAIN/.git/objects/pack"
    printf 'x' > "$ENV_MAIN/.git/objects/pack/tmp_pack_old"
    touch -t "$(epoch_to_touch "$(epoch_ago 2)")" "$ENV_MAIN/.git/objects/pack/tmp_pack_old"
}

# P1 — found in WT_GC_BIN_DIRS under a PATH that lacks them: each is used.
if should_run P1-bins-resolved; then
fx P1-bins-resolved
p_fixture
rt "${ALL_ON[@]}" "${P_RES[@]}" WT_GC_BIN_DIRS="$ROOT/seam" STUB_SKIP_LINES="$CD/skips" -- --force
chk_rc P1 0
log_has 'not found' && note_err "a binary was reported not found"
grep -q '^image prune' "$CD/docker-argv" 2>/dev/null || note_err "resolved docker not used"
grep -q '^pr view' "$CD/gh-argv" 2>/dev/null || note_err "resolved gh not used"
[ -e "$ENV_MAIN/.git/objects/pack/tmp_pack_old" ] && note_err "tmp_pack kept (resolved lsof not used)"
log_has 'empty reaped e-old' || note_err "EMPTY worktree not reaped (resolved lsof not used)"
log_has 'dirty reaped d2' || note_err "dirty-merged worktree not reaped"
has_ref refs/heads/backup/3382-pre-rebase && note_err "merged backup kept"
finish_case
fi

# P2 — absent from PATH and WT_GC_BIN_DIRS: nothing is deleted, each is named.
if should_run P2-bins-missing; then
fx P2-bins-missing
p_fixture
B_REFS="$(refs_snapshot)"; B_WT="$(wt_snapshot)"
rt "${ALL_ON[@]}" "${P_RES[@]}" WT_GC_BIN_DIRS="$ROOT/seam-empty" STUB_SKIP_LINES="$CD/skips" -- --force
chk_rc P2 1
[ "$(refs_snapshot)" = "$B_REFS" ] || note_err "refs changed"
[ "$(wt_snapshot)" = "$B_WT" ] || note_err "worktrees changed"
[ -e "$ENV_MAIN/.git/objects/pack/tmp_pack_old" ] || note_err "tmp_pack deleted"
[ -e "$CD/docker-argv" ] && note_err "a docker ran"
log_has "docker not found \(''\) — nothing pruned" || note_err "no docker-not-found line"
log_has "dirty keep d2: probe error" || note_err "d2 not kept on the lsof probe error"
log_has "ref keep refs/heads/backup/3382-pre-rebase: gh not found" || note_err "no gh-not-found line (refs)"
log_has "tmp_pack keep .*tmp_pack_old: lsof not found" || note_err "no lsof-not-found line (tmp_pack)"
log_has "live-work probe error e-old: lsof not found" || note_err "no lsof-not-found line (live work)"
finish_case
fi

# P2b — only lsof found: the dirty-merged reap reaches its gh check and keeps.
if should_run P2b-gh-missing; then
