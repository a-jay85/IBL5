  || fail "6c.3 absent: 'unconfirmed' verdict absent — absent result not treated as a hold"
end_case result-absent-holds

# --- 6c.4: unparseable result.json produces a hold (static assertion) --------------------
begin_case
# The verdict extraction must be guarded so a parse failure does not propagate non-zero.
grep -qF '"verdict_1"' "$SCRIPT_DIR/../bin/post-plan-fleet" \
  || fail "6c.4 unparseable: no verdict_1 extraction from result.json — parse missing entirely"
grep -qF '|| true)' "$SCRIPT_DIR/../bin/post-plan-fleet" \
  || fail "6c.4 unparseable: no '|| true' guard on the parse pipeline — malformed JSON would abort"
end_case result-unparseable-holds

# --- 6c.5: --wait timeout prints 'TIMED OUT waiting for' on stderr and exits 0 ------
begin_case
out="$(POST_PLAN_FLEET_ROOT="$SCRIPT_DIR/.." POST_PLAN_FLEET_GH_USER=a-jay85 \
    bin/post-plan-fleet --dry-run --pr 9999 --wait --jobs 1 2>&1)"; rc=$?
[[ $rc -eq 0 ]] || fail "6c.5: want exit 0 on dry-run with --wait, got $rc"
# When no session is actually running, wait exits immediately. The TIMED OUT path
# fires only when a slot is held. Test the text exists in the script instead.
grep -qF 'TIMED OUT waiting for' "$SCRIPT_DIR/../bin/post-plan-fleet" \
  || fail "6c.5: bin/post-plan-fleet does not contain 'TIMED OUT waiting for' — the timeout text was removed"
end_case timed-out-text-present

# --- verdict -----------------------------------------------------------------------------
if [[ $FAILED -ne 0 ]]; then
    echo "test-post-plan-fleet: FAILED ($FAILED assertion failure(s))" >&2
    exit 1
fi
echo "test-post-plan-fleet: all cases passed"
