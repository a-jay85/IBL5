#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/bun-audit-triage — triage bun audit --json output, selecting high/critical advisories.
#
# Usage:
#   bun audit --json | bin/bun-audit-triage [options]
#   bin/bun-audit-triage [options] <file>
#
# Options:
#   --level=<high|critical>  Minimum severity to report (default: high).
#                            high     = high OR critical
#                            critical = critical only
#   --json                   Emit selected advisories as a JSON array instead of text.
#
# Text output (default): one line per advisory:
#   ADVISORY: <package> <vulnerable_versions> <severity> <title>
#
# JSON output (--json): a JSON array of the matching advisory objects.
#
# Exit codes:
#   0 = clean (no advisories at or above the selected level)
#   1 = one or more advisories found
#   2 = usage error or malformed JSON input
#
# Reads from stdin unless a file argument is given. Empty stdin is treated as {}.
#
# JSON contract (bun 1.3.6):
#   bun audit --json emits {"package": [{advisory}, ...], ...}
#   A clean tree emits {} and exits 0. No lockfile: empty stdout, exits 1.
#   --audit-level=high does NOT filter --json; severity selection is the consumer's job.

set -u

LEVEL="high"
JSON_MODE=0
INPUT_FILE=""

usage() {
    printf 'Usage: %s [--level=<high|critical>] [--json] [<file>]\n' "$(basename "$0")" >&2
    printf '  --level=high      report high and critical advisories (default)\n' >&2
    printf '  --level=critical  report critical advisories only\n' >&2
    printf '  --json            emit advisories as JSON array instead of text lines\n' >&2
    printf 'Exit: 0=clean, 1=advisories found, 2=usage error or malformed JSON\n' >&2
}

for arg in "$@"; do
    case "$arg" in
        --level=high)
            LEVEL="high"
            ;;
        --level=critical)
            LEVEL="critical"
            ;;
        --json)
            JSON_MODE=1
            ;;
        --level=*)
            printf 'Error: unknown --level value: %s\n' "$arg" >&2
            usage
            exit 2
            ;;
        -*)
            printf 'Error: unknown flag: %s\n' "$arg" >&2
            usage
            exit 2
            ;;
        *)
            if [ -n "$INPUT_FILE" ]; then
                printf 'Error: too many positional arguments\n' >&2
                usage
                exit 2
            fi
            INPUT_FILE="$arg"
            ;;
    esac
done

# Buffer input to a temp file so we can validate with python3 then process with jq
# from the same source (stdin is consumable only once).
TMP_INPUT="$(mktemp)"
trap 'rm -f "$TMP_INPUT"' EXIT

if [ -n "$INPUT_FILE" ]; then
    if [ ! -f "$INPUT_FILE" ]; then
        printf 'Error: file not found: %s\n' "$INPUT_FILE" >&2
        usage
        exit 2
    fi
    cp "$INPUT_FILE" "$TMP_INPUT"
else
    # Read all of stdin; empty stdin is treated as a clean tree ({}).
    cat > "$TMP_INPUT" || true
    if [ ! -s "$TMP_INPUT" ]; then
        printf '{}' > "$TMP_INPUT"
    fi
fi

# Validate JSON using python3 — jq silently accepts some malformed input.
if ! python3 -c "import sys,json; json.load(open(sys.argv[1]))" "$TMP_INPUT" 2>/dev/null; then
    printf 'Error: input is not valid JSON\n' >&2
    exit 2
fi

# Select advisories matching the requested level.
# critical: critical only. high (default): high OR critical.
# jq filter uses --arg lvl so no shell interpolation is needed.

if [ "$JSON_MODE" = "1" ]; then
    OUTPUT=$(jq --arg lvl "$LEVEL" \
        '[to_entries[] | .key as $p | .value[] | select(.severity == "critical" or ($lvl == "high" and .severity == "high"))]' \
        "$TMP_INPUT")
    printf '%s\n' "$OUTPUT"
    COUNT=$(jq -n --argjson a "$OUTPUT" '$a | length')
    if [ "$COUNT" -gt 0 ]; then
        exit 1
    fi
    exit 0
else
    OUTPUT=$(jq -r --arg lvl "$LEVEL" \
        '[to_entries[] | .key as $p | .value[] | select(.severity == "critical" or ($lvl == "high" and .severity == "high")) | "ADVISORY: \($p) \(.vulnerable_versions) \(.severity) \(.title)"] | .[]' \
        "$TMP_INPUT")
    if [ -n "$OUTPUT" ]; then
        printf '%s\n' "$OUTPUT"
        exit 1
    fi
    exit 0
fi
