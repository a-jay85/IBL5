# Test-only bug-bot credentials. Copy to .env.bugbot.test (untracked) and fill in.
# The SECOND Discord application, invited ONLY to the personal testing guild.
BUG_BOT_DISCORD_TOKEN=REPLACE_WITH_TEST_APP_BOT_TOKEN
DISCORD_CLIENT_ID=REPLACE_WITH_TEST_APP_CLIENT_ID
DISCORD_GUILD_ID=REPLACE_WITH_TEST_GUILD_SNOWFLAKE
# Snowflakes are strings — never int-cast, never quote-strip.
BUG_CHANNEL_ID=REPLACE_WITH_TEST_CHANNEL_SNOWFLAKE
# Tick-side only (not read by the bot): the id the pipeline @-mentions for approval.
BUG_PIPELINE_APPROVER_ID=REPLACE_WITH_TEST_APPROVER_SNOWFLAKE
# The always-up main-stack base URL INCLUDING the /ibl5 app prefix, exactly as
# documented at config.ts:27-29. Never a worktree slug host, never prod.
BUG_PIPELINE_API_BASE_URL=REPLACE_WITH_MAIN_STACK_BASE_URL
API_KEY=REPLACE_WITH_MAIN_STACK_API_KEY
