# Completion token. A harness that asserts nothing reads as passing, so the count
# is printed and an independently wired harness (bin/test-plan-now) asserts it is
# nonzero. If a future edit reintroduces an early `exit 0`, this line is missing.
printf '\nplan-review-seam: %d assertions\n' "$(( PASS + FAIL ))"
printf '%d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ] && [ "$(( PASS + FAIL ))" -gt 0 ]
