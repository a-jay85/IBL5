B_REFS="$(refs_snapshot)"; B_WT="$(wt_snapshot)"
rt "${E_ON[@]}" -- --dry-run --force
chk_rc E9 0
[ "$(refs_snapshot)" = "$B_REFS" ] || note_err "refs changed"
[ "$(wt_snapshot)" = "$B_WT" ] || note_err "worktrees changed"
log_has 'DRY-RUN would: .*wt-remove e-old --volumes' || note_err "no DRY-RUN wt-remove line"
finish_case
fi

# E10 — an old worktree whose only work is a new, never-added file in a
# subdirectory is kept (the root dir mtime and branch tip stay old).
if should_run E10-untracked-kept; then
fx E10-untracked-kept
mk_wt e-old e-old age_days=10; row EMPTY e-old
mkdir -p "$(wt_dir e-old)/notes"
printf 'draft\n' > "$(wt_dir e-old)/notes/new.md"
touch -t "$(epoch_to_touch "$(epoch_ago 10)")" "$(wt_dir e-old)"
rt "${E_ON[@]}" -- --force
chk_rc E10 0
log_has 'empty keep e-old: dirty' || note_err "untracked-only worktree not kept as dirty"
[ -f "$(wt_dir e-old)/notes/new.md" ] || note_err "untracked file lost"
has_branch e-old || note_err "branch deleted"
finish_case
fi

# ── T3 scheduled-run worktree reap ────────────────────────────────────────────
T_ON=(WT_GC_REAP_T3=1)
# t3_dir <name> — where T3 Code puts a scheduled run's worktree.
t3_dir() { printf '%s/t3root/%s' "$CD" "$1"; }
# mk_t3 <name> <branch> [ahead=N] [age_days=N] — a worktree off origin/master
# under $CD/t3root, backdated like mk_wt.
mk_t3() {
    local name="$1" br="$2" ahead=0 age=0 kv i=1 ep wt
    shift 2
    for kv in "$@"; do
        case "$kv" in
            ahead=*)    ahead="${kv#ahead=}" ;;
            age_days=*) age="${kv#age_days=}" ;;
        esac
    done
    wt="$(t3_dir "$name")"
    mkdir -p "$CD/t3root"
    git -C "$ENV_MAIN" worktree add -q -b "$br" "$wt" origin/master >/dev/null 2>&1
    ep="$(epoch_ago "$age")"
    while [ "$i" -le "$ahead" ]; do
        printf '%s\n' "$i" > "$wt/own-$i.txt"
        git -C "$wt" add "own-$i.txt"
        bd_commit "$wt" "$ep" "own $i"
        i=$((i + 1))
    done
    touch -t "$(epoch_to_touch "$ep")" "$wt"
}

# T1 — an old, clean T3 run worktree with no own commits is reaped: tips
# line and keep-ref first, git worktree remove (wt-remove never runs), then
# the branch is deleted.
if should_run T1-t3-reaped; then
fx T1-t3-reaped
mk_t3 t3-aaaa1111 t3/weekly-digest age_days=5
SHA="$(git -C "$ENV_MAIN" rev-parse refs/heads/t3/weekly-digest)"
rt "${T_ON[@]}" -- --force
chk_rc T1 0
log_has 'step t3 threshold=1d' || note_err "no step line"
log_has 't3 reaped t3-aaaa1111 branch=t3/weekly-digest age=5d' || note_err "no reaped line"
[ -d "$(t3_dir t3-aaaa1111)" ] && note_err "worktree still present"
has_branch t3/weekly-digest && note_err "branch still present"
tips_has "$SHA refs/heads/t3/weekly-digest" || note_err "tips lacks sha"
KEEP="$(git -C "$ENV_MAIN" for-each-ref --format='%(refname) %(objectname)' refs/wt-gc-archive/)"
grep -qE "^refs/wt-gc-archive/[0-9]+/heads/t3/weekly-digest $SHA\$" <<< "$KEEP" || note_err "no keep-ref"
[ -f "$CD/wt-remove-argv" ] && note_err "wt-remove ran for a T3 worktree"
finish_case
fi

# T2 — the keep reasons: young, ahead, dirty (untracked), live session.
if should_run T2-t3-kept; then
fx T2-t3-kept
mk_t3 t3-young001 t3/young age_days=0
mk_t3 t3-ahead001 t3/ahead ahead=1 age_days=5
mk_t3 t3-dirty001 t3/dirty age_days=5
mk_t3 t3-live0001 t3/live age_days=5
printf 'scratch\n' > "$(t3_dir t3-dirty001)/notes.md"
touch -t "$(epoch_to_touch "$(epoch_ago 5)")" "$(t3_dir t3-dirty001)"
mk_registry "$CD/registry.json" t3/live
rt "${T_ON[@]}" -- --force
chk_rc T2 0
log_has 't3 keep t3-young001: age=0d' || note_err "young not kept by age"
log_has 't3 keep t3-ahead001: no merged PR' || note_err "ahead not kept"
log_has 't3 keep t3-dirty001: dirty' || note_err "dirty not kept"
log_has 'live-work t3-live0001: live Claude session' || note_err "live session not seen"
log_has 't3 keep t3-live0001: live work' || note_err "live not kept"
for n in t3-young001 t3-ahead001 t3-dirty001 t3-live0001; do
    [ -d "$(t3_dir "$n")" ] || note_err "$n removed"
done
[ -f "$(t3_dir t3-dirty001)/notes.md" ] || note_err "untracked file lost"
for b in t3/young t3/ahead t3/dirty t3/live; do has_branch "$b" || note_err "$b deleted"; done
log_has 'reap done steps_failed=0' || note_err "a step failed"
finish_case
fi

# T3 — only t3-* worktrees directly under the root are candidates: a
# non-t3 name under the root, a t3-* name in IBL5-worktrees and a t3-* name
# one level deeper are all ignored.
if should_run T3-t3-scope; then
fx T3-t3-scope
mk_t3 dependabot-x dependabot/x age_days=5
mk_wt t3-elsewhere t3/elsewhere age_days=10
mkdir -p "$CD/t3root/nested"
git -C "$ENV_MAIN" worktree add -q -b t3/nested "$CD/t3root/nested/t3-deep0001" origin/master >/dev/null 2>&1
touch -t "$(epoch_to_touch "$(epoch_ago 5)")" "$CD/t3root/nested/t3-deep0001"
B_WT="$(wt_snapshot)"; B_REFS="$(refs_snapshot)"
rt "${T_ON[@]}" WT_GC_REAP_T3_MERGED=0 -- --force
chk_rc T3 0
[ "$(wt_snapshot)" = "$B_WT" ] || note_err "worktrees changed"
[ "$(refs_snapshot)" = "$B_REFS" ] || note_err "refs changed"
log_has 't3 (keep|reaped) (dependabot-x|t3-elsewhere|t3-deep0001)' && note_err "out-of-scope worktree considered"
finish_case
fi

# T4 — dry-run is inert and names the git worktree remove it would run; an
# absent root is a no-op success.
if should_run T4-t3-dry-run; then
fx T4-t3-dry-run
mk_t3 t3-bbbb2222 t3/dry age_days=5
B_WT="$(wt_snapshot)"; B_REFS="$(refs_snapshot)"
rt "${T_ON[@]}" -- --dry-run --force
chk_rc "T4 dry-run" 0
[ "$(wt_snapshot)" = "$B_WT" ] || note_err "worktrees changed"
[ "$(refs_snapshot)" = "$B_REFS" ] || note_err "refs changed"
log_has 'DRY-RUN would: git -C .* worktree remove .*/t3root/t3-bbbb2222$' || note_err "no DRY-RUN remove line"
rt "${T_ON[@]}" WT_GC_T3_ROOT="$CD/no-such-root" -- --force
chk_rc "T4 absent root" 0
log_has 'reap done steps_failed=0' || note_err "absent root failed the step"
[ -d "$(t3_dir t3-bbbb2222)" ] || note_err "absent-root run removed a worktree"
finish_case
fi

# T2b — with the merged proof switched off, a t3-* worktree with own commits
# is kept on the old ahead check, as before the proof existed.
if should_run T2b-t3-ahead-switch-off; then
fx T2b-t3-ahead-switch-off
mk_t3 t3-ahead001 t3/ahead ahead=1 age_days=5
rt "${T_ON[@]}" WT_GC_REAP_T3_MERGED=0 -- --force
chk_rc T2b 0
log_has 't3 keep t3-ahead001: ahead=1' || note_err "ahead not kept by the old check"
[ -d "$(t3_dir t3-ahead001)" ] || note_err "removed"
finish_case
fi

# gh_head <branch> <value> — the answer the gh stub gives `pr list --head <branch>`
# after the reaper's --jq filter: open, none, or the merged PR's head oid.
gh_head() {
    mkdir -p "$(dirname "$CD/gh/by-head/$1.json")"
    printf '%s\n' "$2" > "$CD/gh/by-head/$1.json"
}

# TM1 — a T3-root worktree with own commits is reaped when its branch has one
# MERGED PR and the proof accepts the tip. Any name qualifies, not only t3-*.
if should_run TM1-t3-merged-reaped; then
fx TM1-t3-merged-reaped
mk_t3 t3-bbbb2222 t3/merged ahead=2 age_days=5
mk_t3 dependabot-npm dependabot/npm/foo ahead=1 age_days=5
SHA1="$(git -C "$ENV_MAIN" rev-parse refs/heads/t3/merged)"
SHA2="$(git -C "$ENV_MAIN" rev-parse refs/heads/dependabot/npm/foo)"
gh_head t3/merged "$SHA1"
gh_head dependabot/npm/foo "$SHA2"
rt "${T_ON[@]}" -- --force
chk_rc TM1 0
log_has "t3 reaped-merged t3-bbbb2222 branch=t3/merged age=5d pr_head=$SHA1" || note_err "no merged reaped line (t3 name)"
log_has "t3 reaped-merged dependabot-npm branch=dependabot/npm/foo age=5d pr_head=$SHA2" || note_err "no merged reaped line (dependabot name)"
[ -d "$(t3_dir t3-bbbb2222)" ] && note_err "t3 worktree still present"
[ -d "$(t3_dir dependabot-npm)" ] && note_err "dependabot worktree still present"
has_branch t3/merged && note_err "t3 branch still present"
has_branch dependabot/npm/foo && note_err "dependabot branch still present"
tips_has "$SHA1 refs/heads/t3/merged" || note_err "tips lacks t3 sha"
tips_has "$SHA2 refs/heads/dependabot/npm/foo" || note_err "tips lacks dependabot sha"
KEEP="$(git -C "$ENV_MAIN" for-each-ref --format='%(refname) %(objectname)' refs/wt-gc-archive/)"
grep -qE "^refs/wt-gc-archive/[0-9]+/heads/t3/merged $SHA1\$" <<< "$KEEP" || note_err "no keep-ref (t3)"
grep -qE "^refs/wt-gc-archive/[0-9]+/heads/dependabot/npm/foo $SHA2\$" <<< "$KEEP" || note_err "no keep-ref (dependabot)"
[ -f "$CD/wt-remove-argv" ] && note_err "wt-remove ran for a T3 worktree"
finish_case
fi

# TM2 — every way the merged proof can say no keeps the worktree, its branch
# and its files.
if should_run TM2-t3-merged-kept; then
fx TM2-t3-merged-kept
mk_t3 tm-open tm/open ahead=1 age_days=5;       gh_head tm/open open
mk_t3 tm-none tm/none ahead=1 age_days=5
mk_t3 tm-unproven tm/unproven ahead=1 age_days=5
gh_head tm/unproven "$(git -C "$ENV_MAIN" rev-parse origin/master)"
mk_t3 tm-ghfail tm/ghfail ahead=1 age_days=5
mk_t3 tm-dirty tm/dirty ahead=1 age_days=5
printf 'scratch\n' > "$(t3_dir tm-dirty)/notes.md"
touch -t "$(epoch_to_touch "$(epoch_ago 5)")" "$(t3_dir tm-dirty)"
gh_head tm/dirty "$(git -C "$ENV_MAIN" rev-parse refs/heads/tm/dirty)"
mkdir -p "$CD/t3root/sub"
git -C "$ENV_MAIN" worktree add -q -b tm/nested "$CD/t3root/sub/tm-nested" origin/master >/dev/null 2>&1
touch -t "$(epoch_to_touch "$(epoch_ago 5)")" "$CD/t3root/sub/tm-nested"
gh_head tm/nested "$(git -C "$ENV_MAIN" rev-parse refs/heads/tm/nested)"
rt "${T_ON[@]}" -- --force
chk_rc TM2 0
log_has 't3 keep tm-open: open PR' || note_err "open PR not kept"
log_has 't3 keep tm-none: no merged PR' || note_err "no-PR not kept"
log_has 't3 keep tm-unproven: merge not proven' || note_err "unproven merge not kept"
log_has 't3 keep tm-dirty: dirty' || note_err "dirty not kept"
grep -q 'tm/dirty' "$CD/gh-argv" 2>/dev/null && note_err "dirty worktree cost a gh call"
log_has 't3 (keep|reaped|reaped-merged) tm-nested' && note_err "nested worktree considered"
rt "${T_ON[@]}" STUB_GH_FAIL=1 -- --force
chk_rc "TM2 gh failure" 0
log_has 't3 keep tm-ghfail: gh error' || note_err "gh failure not kept"
for n in tm-open tm-none tm-unproven tm-ghfail tm-dirty; do
    [ -d "$(t3_dir "$n")" ] || note_err "$n removed"
done
[ -d "$CD/t3root/sub/tm-nested" ] || note_err "nested removed"
[ -f "$(t3_dir tm-dirty)/notes.md" ] || note_err "untracked file lost"
for b in tm/open tm/none tm/unproven tm/ghfail tm/dirty tm/nested; do has_branch "$b" || note_err "$b deleted"; done
log_has 'reap done steps_failed=0' || note_err "a step failed"
finish_case
fi

# TM3 — WT_GC_REAP_T3_MERGED=0 restores the old behavior: own commits keep a
# t3-* worktree, and a non-t3 name is never looked at.
if should_run TM3-t3-merged-switch-off; then
fx TM3-t3-merged-switch-off
mk_t3 t3-bbbb2222 t3/merged ahead=2 age_days=5
mk_t3 dependabot-npm dependabot/npm/foo ahead=1 age_days=5
gh_head t3/merged "$(git -C "$ENV_MAIN" rev-parse refs/heads/t3/merged)"
gh_head dependabot/npm/foo "$(git -C "$ENV_MAIN" rev-parse refs/heads/dependabot/npm/foo)"
rt "${T_ON[@]}" WT_GC_REAP_T3_MERGED=0 -- --force
chk_rc TM3 0
log_has 't3 keep t3-bbbb2222: ahead=2' || note_err "t3 name not kept by ahead"
log_has 'dependabot-npm' && note_err "non-t3 name was looked at"
[ -d "$(t3_dir t3-bbbb2222)" ] || note_err "t3 worktree removed"
[ -d "$(t3_dir dependabot-npm)" ] || note_err "dependabot worktree removed"
has_branch t3/merged || note_err "t3 branch deleted"
has_branch dependabot/npm/foo || note_err "dependabot branch deleted"
finish_case
fi

# ── Content-landed worktree reap ──────────────────────────────────────────────
CLD_ON=(WT_GC_REAP_LANDED=1)
# land_on_master — origin/master gains own-1.txt (the file mk_wt ahead=1 commits)
# and a README.md edit, so a branch that added the same own-1.txt adds nothing.
land_on_master() {
    printf '1\n' > "$ENV_MAIN/own-1.txt"
    printf 'master-side\n' > "$ENV_MAIN/README.md"
    git -C "$ENV_MAIN" add own-1.txt README.md
    git -C "$ENV_MAIN" commit -qm "land own-1 under another sha"
    git -C "$ENV_MAIN" push -q origin master
    git -C "$ENV_MAIN" fetch -q origin
}
# landed_wt <name> <branch> [mk_wt args...] — a landed-shape worktree (the gh
# stub reports no open PR for it) and its UNPUSHED status row.
landed_wt() {
    local name="$1" br="$2"
    shift 2
    mk_wt "$name" "$br" ahead=1 "$@"
    gh_head "$br" 0
    row UNPUSHED "$name"
}

# CL1 — a clean landed branch is reaped (tips line, keep-ref, wt-remove, branch
# delete) and drops out of the stale list; a kept UNPUSHED row stays listed.
if should_run CL1-landed-reaped; then
fx CL1-landed-reaped
landed_wt cl-landed br/landed age_days=5
mk_wt cl-extra br/extra ahead=2 age_days=5; gh_head br/extra 0; row UNPUSHED cl-extra
land_on_master
SHA="$(git -C "$ENV_MAIN" rev-parse refs/heads/br/landed)"
rt "${CLD_ON[@]}" WT_GC_STALE_LIST=1 WT_GC_STALE_DAYS=0 -- --force
chk_rc CL1 0
log_has 'step landed threshold=3d' || note_err "no step line"
log_has 'landed reaped cl-landed branch=br/landed age=5d' || note_err "no reaped line"
[ -d "$(wt_dir cl-landed)" ] && note_err "worktree still present"
has_branch br/landed && note_err "branch still present"
tips_has "$SHA refs/heads/br/landed" || note_err "tips lacks sha"
KEEP="$(git -C "$ENV_MAIN" for-each-ref --format='%(refname) %(objectname)' refs/wt-gc-archive/)"
grep -qE "^refs/wt-gc-archive/[0-9]+/heads/br/landed $SHA\$" <<< "$KEEP" || note_err "no keep-ref"
[ "$(cat "$CD/wt-remove-argv" 2>/dev/null)" = "$(printf 'cl-landed\n--volumes')" ] || note_err "wt-remove argv not exactly cl-landed --volumes"
log_has 'landed keep cl-extra: adds content' || note_err "extra-content branch not kept"
grep -q 'cl-landed' "$CD/stale.tsv" 2>/dev/null && note_err "reaped worktree is in the stale list"
grep -q 'cl-extra' "$CD/stale.tsv" 2>/dev/null || note_err "kept row missing from the stale list"
finish_case
fi

# CL2 — every reason to keep: extra content, dirty, conflict, open PR, gh
# failure, young, pool slot; plus EMPTY and OPEN-PR rows the filter must skip.
# Each landed-shaped fixture has exactly one reason to be kept.
if should_run CL2-landed-kept; then
fx CL2-landed-kept
mk_wt cl-extra br/extra ahead=2 age_days=5; gh_head br/extra 0; row UNPUSHED cl-extra
landed_wt cl-dirty br/dirty age_days=5
landed_wt cl-openpr br/openpr age_days=5
gh_head br/openpr 1
landed_wt cl-ghfail br/ghfail age_days=5
rm -f "$CD/gh/by-head/br/ghfail.json"   # second run: stub answers 'none', not an open count, so it is kept
landed_wt cl-young br/young age_days=0
landed_wt _pool-7 br/pool7 age_days=5
mk_wt cl-conflict br/conflict age_days=5; gh_head br/conflict 0; row UNPUSHED cl-conflict
mk_wt cl-empty br/empty ahead=1 age_days=5; gh_head br/empty 0; row EMPTY cl-empty
mk_wt cl-open br/open ahead=1 age_days=5; gh_head br/open 0; row OPEN-PR cl-open
printf 'wip\n' > "$(wt_dir cl-dirty)/notes.md"
touch -t "$(epoch_to_touch "$(epoch_ago 5)")" "$(wt_dir cl-dirty)"
printf 'branch-side\n' > "$(wt_dir cl-conflict)/README.md"
git -C "$(wt_dir cl-conflict)" add README.md
bd_commit "$(wt_dir cl-conflict)" "$(epoch_ago 5)" "branch edits readme"
touch -t "$(epoch_to_touch "$(epoch_ago 5)")" "$(wt_dir cl-conflict)"
land_on_master
rt "${CLD_ON[@]}" STUB_GH_FAIL=1 -- --force
chk_rc "CL2 gh failure" 0
log_has 'landed keep cl-ghfail: gh error' || note_err "gh failure not kept"
rt "${CLD_ON[@]}" -- --force
chk_rc CL2 0
log_has 'landed keep cl-extra: adds content' || note_err "extra content not kept"
log_has 'landed keep cl-dirty: dirty' || note_err "dirty not kept"
log_has 'landed keep cl-conflict: merge conflict' || note_err "conflict not kept"
log_has 'landed keep cl-openpr: open PR' || note_err "open PR not kept"
log_has 'landed keep cl-young: age=0d' || note_err "young not kept"
log_has 'landed keep _pool-7: pool worktree' || note_err "pool slot not kept"
log_has 'landed (keep|reaped) (cl-empty|cl-open)\b' && note_err "EMPTY or OPEN-PR row was considered"
for n in cl-extra cl-dirty cl-openpr cl-ghfail cl-young _pool-7 cl-conflict cl-empty cl-open; do
    [ -d "$(wt_dir "$n")" ] || note_err "$n removed"
done
[ -f "$(wt_dir cl-dirty)/notes.md" ] || note_err "untracked file lost"
for b in br/extra br/dirty br/openpr br/ghfail br/young br/pool7 br/conflict br/empty br/open; do
    has_branch "$b" || note_err "$b deleted"
done
[ -f "$CD/wt-remove-argv" ] && note_err "wt-remove ran for a kept worktree"
log_has 'reap done steps_failed=0' || note_err "a step failed"
finish_case
fi

# CL3 — WT_GC_REAP_LANDED=0 leaves CL1's landed branch alone.
if should_run CL3-landed-switch-off; then
fx CL3-landed-switch-off
landed_wt cl-landed br/landed age_days=5
land_on_master
rt WT_GC_REAP_LANDED=0 -- --force
chk_rc CL3 0
log_has 'step landed threshold' && note_err "landed step ran with the switch at 0"
log_has 'step landed disabled \(WT_GC_REAP_LANDED=0\)' || note_err "no disabled line"
[ -d "$(wt_dir cl-landed)" ] || note_err "worktree removed"
has_branch br/landed || note_err "branch deleted"
finish_case
fi

# ── Unborn-HEAD worktree reap and orphan wt-pool branch delete ────────────────
UB_ON=(WT_GC_REAP_UNBORN=1)
PB_ON=(WT_GC_REAP_POOL_BRANCHES=1)
# mk_unborn <name> <branch> <age_days> — a worktree whose HEAD names a branch
# with no commit: notes/a.md untracked, b.txt staged, dir mtime backdated.
mk_unborn() {
    local wt
    wt="$(wt_dir "$1")"
    git -C "$ENV_MAIN" worktree add -q --orphan -b "$2" "$wt" >/dev/null 2>&1
    mkdir -p "$wt/notes"
    printf 'note\n' > "$wt/notes/a.md"
    printf 'b\n' > "$wt/b.txt"
    git -C "$wt" add b.txt
    touch -t "$(epoch_to_touch "$(epoch_ago "$3")")" "$wt"
}
# rt_seen [rt args...] — rt, but pool-orphans.txt (the pool-branches step's
# previous-sweep sighting file) survives the per-run state wipe.
rt_seen() {
    local keep="$CD/pool-orphans.keep"
    if [ -f "$CD/state/pool-orphans.txt" ]; then cp "$CD/state/pool-orphans.txt" "$keep"; fi
    rm -f "$CD/docker-argv" "$CD/wt-remove-argv" "$CD/gh-argv"
    fresh
    mkdir -p "$CD/state"
    if [ -f "$keep" ]; then cp "$keep" "$CD/state/pool-orphans.txt"; fi
    run_tick WT_GC_REPO_ROOT="$ENV_MAIN" WT_GC_WT_STATUS="$STUBBIN/wt-status-rows" \
        STUB_WT_STATUS_ROWS="$CD/rows" WT_GC_WT_REMOVE="$ENV_MAIN/bin/wt-remove" "$@"
}

# UB1 — an old unborn worktree is archived as a parentless commit, then removed.
if should_run UB1-unborn-reaped; then
fx UB1-unborn-reaped
mk_unborn ub-old br/ub-old 5
rt "${UB_ON[@]}" -- --force
chk_rc UB1 0
log_has 'step unborn threshold=3d' || note_err "no step line"
log_has 'unborn reaped ub-old branch=br/ub-old age=5d archive=[0-9a-f]{40}' || note_err "no reaped line"
SNAP="$(sed -n 's/.*unborn reaped ub-old .*archive=\([0-9a-f]\{40\}\).*/\1/p' "$(LOG)")"
[ -n "$SNAP" ] || note_err "no archive sha in the log"
KEEP="$(git -C "$ENV_MAIN" for-each-ref --format='%(refname) %(objectname)' refs/wt-gc-archive/)"
grep -qE "^refs/wt-gc-archive/[0-9]+/heads/br/ub-old $SNAP\$" <<< "$KEEP" || note_err "no keep-ref at the snapshot"
PARENTS="$(git -C "$ENV_MAIN" rev-list --parents -n1 "$SNAP" 2>/dev/null)"
[ "$(wc -w <<< "$PARENTS" | tr -d ' ')" = 1 ] || note_err "snapshot has a parent: $PARENTS"
FILES="$(git -C "$ENV_MAIN" ls-tree -r --name-only "$SNAP" 2>/dev/null)"
grep -qxF 'notes/a.md' <<< "$FILES" || note_err "notes/a.md not in the snapshot"
grep -qxF 'b.txt' <<< "$FILES" || note_err "b.txt not in the snapshot"
tips_has "$SNAP refs/heads/br/ub-old" || note_err "tips lacks the snapshot"
[ "$(cat "$CD/wt-remove-argv" 2>/dev/null)" = "$(printf 'ub-old\n--volumes')" ] || note_err "wt-remove argv not exactly ub-old --volumes"
[ -d "$(wt_dir ub-old)" ] && note_err "worktree still present"
log_has 'reap done steps_failed=0' || note_err "a step failed"
finish_case
fi

# UB2 — every reason to keep an unborn worktree: young, pool slot, live work.
# A normal committed worktree is no candidate.
if should_run UB2-unborn-kept; then
fx UB2-unborn-kept
mk_unborn ub-young br/ub-young 2
mk_unborn _pool-9 wt-pool/9 5
mk_unborn ub-live br/ub-live 5
mk_registry "$CD/registry.json" br/ub-live
mk_wt ub-norm br/ub-norm ahead=1 age_days=5
rt "${UB_ON[@]}" -- --force
chk_rc UB2 0
log_has 'unborn keep ub-young: age=2d' || note_err "young not kept"
log_has 'unborn keep _pool-9: pool worktree' || note_err "pool slot not kept"
log_has 'unborn keep ub-live: live work' || note_err "live work not kept"
log_has 'unborn (keep|reaped) ub-norm' && note_err "a committed worktree was considered"
[ -f "$CD/wt-remove-argv" ] && note_err "wt-remove ran for a kept worktree"
for n in ub-young _pool-9 ub-live; do
    [ -f "$(wt_dir "$n")/notes/a.md" ] || note_err "$n lost an untracked file"
    [ -f "$(wt_dir "$n")/b.txt" ] || note_err "$n lost a staged file"
done
[ -d "$(wt_dir ub-norm)" ] || note_err "committed worktree removed"
finish_case
fi

# UB3 — an orphan wt-pool/<N> ref is kept on the first sweep and deleted on the
# second, after its sha lands in the tips file and a keep-ref.
if should_run UB3-pool-branch-deleted; then
fx UB3-pool-branch-deleted
git -C "$ENV_MAIN" update-ref refs/heads/wt-pool/31 origin/master
SHA="$(git -C "$ENV_MAIN" rev-parse refs/heads/wt-pool/31)"
rt_seen "${PB_ON[@]}" -- --force
chk_rc "UB3 first" 0
log_has 'step pool-branches' || note_err "no step line"
log_has 'pool-branches keep refs/heads/wt-pool/31: first sighting' || note_err "no first-sighting line"
has_branch wt-pool/31 || note_err "deleted on first sighting"
rt_seen "${PB_ON[@]}" -- --force
chk_rc "UB3 second" 0
log_has 'pool-branches deleted refs/heads/wt-pool/31' || note_err "no deleted line"
has_branch wt-pool/31 && note_err "ref still present"
tips_has "$SHA refs/heads/wt-pool/31" || note_err "tips lacks the sha"
KEEP="$(git -C "$ENV_MAIN" for-each-ref --format='%(refname) %(objectname)' refs/wt-gc-archive/)"
grep -qE "^refs/wt-gc-archive/[0-9]+/heads/wt-pool/31 $SHA\$" <<< "$KEEP" || note_err "no keep-ref"
finish_case
fi

# UB4 — every reason to keep a pool ref, across two sweeps.
if should_run UB4-pool-branch-kept; then
fx UB4-pool-branch-kept
mk_wt _pool-32 wt-pool/32 age_days=1
mkdir -p "$(wt_dir _pool-33)"
git -C "$ENV_MAIN" update-ref refs/heads/wt-pool/33 origin/master
AHEAD="$(git -C "$ENV_MAIN" commit-tree -p origin/master -m ahead 'origin/master^{tree}')"
git -C "$ENV_MAIN" update-ref refs/heads/wt-pool/34 "$AHEAD"
git -C "$ENV_MAIN" update-ref refs/heads/wt-pool/feature origin/master
git -C "$ENV_MAIN" update-ref refs/heads/wt-pool/35 origin/master
rt_seen "${PB_ON[@]}" -- --force
chk_rc "UB4 first" 0
log_has 'pool-branches keep refs/heads/wt-pool/35: first sighting' || note_err "run 1: no first sighting for 35"
land_on_master
git -C "$ENV_MAIN" update-ref refs/heads/wt-pool/35 origin/master
rt_seen "${PB_ON[@]}" -- --force
chk_rc "UB4 second" 0
log_has 'pool-branches keep refs/heads/wt-pool/35: first sighting' || note_err "run 2: a moved sha was not a first sighting"
log_has 'pool-branches keep refs/heads/wt-pool/33: slot dir exists' || note_err "slot dir not kept"
log_has 'pool-branches keep refs/heads/wt-pool/34: ahead=1' || note_err "ahead ref not kept"
log_has 'pool-branches keep refs/heads/wt-pool/feature: not a slot name' || note_err "non-slot name not kept"
log_has 'pool-branches .*wt-pool/32' && note_err "a checked-out pool ref was considered"
log_has 'pool-branches deleted' && note_err "something was deleted"
for b in wt-pool/32 wt-pool/33 wt-pool/34 wt-pool/feature wt-pool/35; do
    has_branch "$b" || note_err "$b deleted"
done
finish_case
fi

# UB5 — both switches at 0: neither step runs across two sweeps.
if should_run UB5-switches-off; then
fx UB5-switches-off
mk_unborn ub-old br/ub-old 5
git -C "$ENV_MAIN" update-ref refs/heads/wt-pool/31 origin/master
rt_seen WT_GC_REAP_UNBORN=0 WT_GC_REAP_POOL_BRANCHES=0 -- --force
rt_seen WT_GC_REAP_UNBORN=0 WT_GC_REAP_POOL_BRANCHES=0 -- --force
chk_rc UB5 0
log_has 'step unborn threshold' && note_err "unborn step ran with the switch at 0"
log_has 'step pool-branches$' && note_err "pool-branches step ran with the switch at 0"
log_has 'step unborn disabled \(WT_GC_REAP_UNBORN=0\)' || note_err "no unborn disabled line"
log_has 'step pool-branches disabled \(WT_GC_REAP_POOL_BRANCHES=0\)' || note_err "no pool-branches disabled line"
[ -d "$(wt_dir ub-old)" ] || note_err "worktree removed"
[ -f "$(wt_dir ub-old)/notes/a.md" ] || note_err "untracked file lost"
has_branch wt-pool/31 || note_err "pool ref deleted"
finish_case
fi

# ── Merged-but-dirty worktree reap ────────────────────────────────────────────
D_ON=(WT_GC_REAP_DIRTY_MERGED=1)
# d_wt <name> <dirt> [oid] — MERGED row, cleanup dirty-skip line, gh fixture.
d_wt() {
    local tip
    mk_wt "$1" "$1" ahead=1 age_days=10 "dirt=$2"
    row MERGED "$1"
    printf '  SKIP %s: has uncommitted changes\n' "$1" >> "$CD/skips"
    tip="$(git -C "$ENV_MAIN" rev-parse "refs/heads/$1")"
    printf 'MERGED\t7\t%s\n' "${3:-$tip}" > "$CD/gh/by-head/$1.json"
}

if should_run D1-differs-kept; then
fx D1-differs-kept
d_wt d1 diff
rt "${D_ON[@]}" STUB_SKIP_LINES="$CD/skips" -- --force
chk_rc D1 0
log_has 'dirty keep d1: path README.md differs' || note_err "no differs keep"
[ -d "$(wt_dir d1)" ] || note_err "removed"
finish_case
fi

if should_run D2-match-reaped; then
fx D2-match-reaped
d_wt d2 match
SHA="$(git -C "$ENV_MAIN" rev-parse refs/heads/d2)"
rt "${D_ON[@]}" STUB_SKIP_LINES="$CD/skips" -- --force
chk_rc D2 0
log_has 'dirty reaped d2 paths=1' || note_err "not reaped"
[ -d "$(wt_dir d2)" ] && note_err "worktree still present"
[ "$(cat "$CD/wt-remove-argv" 2>/dev/null)" = "$(printf 'd2\n--volumes')" ] || note_err "wt-remove argv"
has_branch d2 && note_err "branch still present"
tips_has "$SHA refs/heads/d2" || note_err "tips lacks sha"
finish_case
fi

if should_run D3-deleted-kept; then
fx D3-deleted-kept
d_wt d3 deleted
rt "${D_ON[@]}" STUB_SKIP_LINES="$CD/skips" -- --force
log_has 'dirty keep d3: path README.md deleted but present on master' || note_err "no deleted keep"
[ -d "$(wt_dir d3)" ] || note_err "removed"
finish_case
fi

if should_run D4-untracked; then
fx D4-untracked
d_wt d4a untracked-diff
d_wt d4b untracked-match
rt "${D_ON[@]}" STUB_SKIP_LINES="$CD/skips" -- --force
log_has 'dirty keep d4a: path new.txt absent on master' || note_err "untracked-diff not kept"
[ -d "$(wt_dir d4a)" ] || note_err "d4a removed"
log_has 'dirty reaped d4b' || note_err "untracked-match not reaped"
[ -d "$(wt_dir d4b)" ] && note_err "d4b still present"
finish_case
fi

if should_run D5-symlink-kept; then
fx D5-symlink-kept
d_wt d5 symlink
rt "${D_ON[@]}" STUB_SKIP_LINES="$CD/skips" -- --force
log_has 'dirty keep d5: path README.md' || note_err "symlink not kept"
[ -d "$(wt_dir d5)" ] || note_err "removed"
finish_case
fi

# D5b — MM: the index holds an edit, the working copy matches master. The
# staged blob is never in the tips file, so reaping would lose it.
if should_run D5b-staged-diff-kept; then
fx D5b-staged-diff-kept
d_wt d5b staged-diff
rt "${D_ON[@]}" STUB_SKIP_LINES="$CD/skips" -- --force
chk_rc D5b 0
