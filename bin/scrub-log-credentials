#!/usr/bin/env bash
# scrub-log-credentials — remove call arguments from historical exception traces in
# IBL5 JSON logs. Historical files only; new leaks are prevented at the source by
# Bootstrap\ErrorHandlerRegistrar::buildArgFreeTrace().
#
# The rewriting itself lives in bin/lib/scrub-log-credentials.php. This script only
# decides which files to feed it, and where. PHP rather than jq because the prod
# host is a shared cPanel box with no jq — but always with PHP, since PHP is the
# application's own runtime. One implementation means a local dry-run genuinely
# exercises the --prod code path.
#
# MANUAL OPERATOR TOOL. Never wire this into CI, cron, a deploy hook, or another
# script. It rewrites log files in place. Defaults to dry-run.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WRITE=false
LOG_DIR="${REPO_ROOT}/ibl5/logs"
PROD=false
SSH_HOST=""
SSH_PORT=""
SSH_KEY=""
SCRUBBER="${REPO_ROOT}/bin/lib/scrub-log-credentials.php"

usage() {
    cat >&2 <<'USAGE'
Usage: bin/scrub-log-credentials [OPTIONS]

Remove call arguments from historical exception traces in IBL5 JSON logs.
Defaults to dry-run — use --write to actually modify files.

Options:
  --write               Modify files in place (with backup)
  --log-dir=<path>      Local directory to scan (default: ibl5/logs)
  --prod                Operate over SSH against the prod log directory
  --ssh-host=<host>     SSH user@host (overrides .env PROD_SSH_HOST)
  --ssh-port=<port>     SSH port
  --ssh-key=<file>      SSH private key file
  -h, --help            Show this help and exit
USAGE
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --write)          WRITE=true; shift ;;
        --log-dir=*)      LOG_DIR="${1#--log-dir=}"; shift ;;
        --prod)           PROD=true; shift ;;
        --ssh-host=*)     SSH_HOST="${1#--ssh-host=}"; shift ;;
        --ssh-port=*)     SSH_PORT="${1#--ssh-port=}"; shift ;;
        --ssh-key=*)      SSH_KEY="${1#--ssh-key=}"; shift ;;
        -h|--help)        usage; exit 0 ;;
        *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
    esac
done

require_scrubber() {
    [[ -f "$SCRUBBER" ]] || {
        echo "scrub-log-credentials: missing scrubber ${SCRUBBER}" >&2
        exit 1
    }
}

# Count entries in a comma-separated list of line numbers ("" -> 0).
count_hits() {
    [[ -n "$1" ]] || { echo 0; return; }
    printf '%s' "$1" | awk -F, '{print NF}'
}

# Pull the line numbers out of the scrubber's HITS report.
#
# Do NOT assume the report is the only thing on stdout: PHP CLI sends startup
# diagnostics ("Unable to load dynamic library ...") there, and prod is a shared
# cPanel host whose php.ini we do not control. Anchor on the marker and keep only
# its own line. Parameter expansion rather than `| tail -n1` because a pipe would
# hide php's exit status from the caller's `||` guard.
# Returns 1 when no marker is present at all — a silent empty parse would report
# "0 hits" for a file that was never scrubbed.
parse_hits() {
    local report="$1"
    case "$report" in
        *HITS:*) ;;
        *) return 1 ;;
    esac
    report="${report##*HITS:}"
    printf '%s' "${report%%$'\n'*}"
}

# ---------------------------------------------------------------------------
# Local mode
# ---------------------------------------------------------------------------
run_local() {
    command -v php >/dev/null 2>&1 || { echo "scrub-log-credentials: php is required" >&2; exit 1; }
    require_scrubber

    local total_hits=0

    for f in "${LOG_DIR}"/*.log; do
        [[ -f "$f" ]] || continue
        # Skip backup files — they are read-only archives, not active logs. Without
        # this, a second --write run scrubs run 1's backup and backs *that* up.
        [[ "$f" == *.bak-*.log ]] && continue

        local tmpout hits_report hit_lines file_hits
        tmpout=$(mktemp "${TMPDIR:-/tmp}/scrub-log-credentials.XXXXXX")

        hits_report=$(php "$SCRUBBER" "$f" "$tmpout") || {
            echo "scrub-log-credentials: scrub failed for $f" >&2
            rm -f "$tmpout"
            exit 1
        }
        hit_lines=$(parse_hits "$hits_report") || {
            echo "scrub-log-credentials: no HITS report for $f" >&2
            rm -f "$tmpout"
            exit 1
        }
        file_hits=$(count_hits "$hit_lines")
        [[ "$file_hits" -gt 0 ]] && printf '%s: lines %s\n' "$f" "$hit_lines"
        total_hits=$((total_hits + file_hits))

        if [[ "$WRITE" == "true" && "$file_hits" -gt 0 ]]; then
            local backup
            backup="${f%.log}.bak-$(date -u +%Y%m%dT%H%M%SZ).log"
            cp -p "$f" "$backup"
            if [[ ! -s "$backup" ]]; then
                echo "scrub-log-credentials: backup failed for $f" >&2
                rm -f "$tmpout"
                exit 1
            fi
            mv "$tmpout" "$f"
        else
            rm -f "$tmpout"
        fi
    done

    echo "Total hits: ${total_hits}"
    if [[ "$WRITE" == "false" ]]; then
        echo "DRY RUN — no files modified. Re-run with --write to apply."
    fi
}

# ---------------------------------------------------------------------------
# Prod SSH mode
# ---------------------------------------------------------------------------
run_prod() {
    # Resolve SSH_HOST from .env if not given on command line
    if [[ -z "$SSH_HOST" ]]; then
        ENV_FILE="${REPO_ROOT}/.env"
        if [[ ! -f "$ENV_FILE" ]]; then
            local git_root
            git_root="$(git -C "$REPO_ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null | sed 's|/\.git$||')" || true
            if [[ -n "$git_root" && -f "${git_root}/.env" ]]; then
                ENV_FILE="${git_root}/.env"
            fi
        fi
        if [[ -f "$ENV_FILE" ]]; then
            # shellcheck source=/dev/null
            source "$ENV_FILE"
        fi

        # Distinct checks for unset vs set-but-empty
        if [[ -z "${PROD_SSH_HOST+x}" ]]; then
            echo "scrub-log-credentials: PROD_SSH_HOST is not set — provide --ssh-host or set PROD_SSH_HOST in .env" >&2
            exit 1
        fi
        if [[ -z "${PROD_SSH_HOST}" ]]; then
            echo "scrub-log-credentials: PROD_SSH_HOST is set but empty — provide --ssh-host or set a valid PROD_SSH_HOST in .env" >&2
            exit 1
        fi
        SSH_HOST="${PROD_SSH_HOST}"
    fi

    require_scrubber

    # Build SSH_ARGS
    SSH_ARGS=""
    [[ -n "$SSH_PORT" ]] && SSH_ARGS="$SSH_ARGS -p $SSH_PORT"
    [[ -n "$SSH_KEY" ]]  && SSH_ARGS="$SSH_ARGS -i $SSH_KEY"

    local write_flag=""
    [[ "$WRITE" == "true" ]] && write_flag="--write"

    # base64 so the PHP source reaches the remote byte-for-byte. Inlining it into
    # the unquoted heredoc below would require escaping every '$' in the program.
    scrubber_b64=$(base64 < "$SCRUBBER")

    # shellcheck disable=SC2086
    ssh $SSH_ARGS "$SSH_HOST" bash << REMOTE
set -euo pipefail
command -v php >/dev/null 2>&1 || { echo "scrub-log-credentials: php is required on remote" >&2; exit 1; }

cd www/ibl5/logs 2>/dev/null || cd ~/www/ibl5/logs 2>/dev/null || {
    echo "scrub-log-credentials: prod log dir not found" >&2
    exit 1
}

scrubber=\$(mktemp)
trap 'rm -f "\$scrubber"' EXIT
printf '%s' "${scrubber_b64}" | base64 -d > "\$scrubber"

NL=\$'\n'
total_hits=0
for f in *.log; do
    [[ -f "\$f" ]] || continue
    # Same backup skip as local mode — otherwise a second --write run compounds
    # backups of backups (foo.bak-T1.bak-T2.log).
    case "\$f" in *.bak-*.log) continue ;; esac

    tmpout=\$(mktemp)
    hits_report=\$(php "\$scrubber" "\$f" "\$tmpout") || {
        echo "scrub-log-credentials: scrub failed for \$f" >&2
        rm -f "\$tmpout"
        exit 1
    }
    # Same tolerant parse as local mode's parse_hits(): PHP CLI sends startup
    # diagnostics to stdout, and this shared host's php.ini is not ours, so the
    # report is not necessarily alone there. Anchor on the marker, keep its line.
    case "\$hits_report" in
        *HITS:*) ;;
        *) echo "scrub-log-credentials: no HITS report for \$f" >&2; rm -f "\$tmpout"; exit 1 ;;
    esac
    hit_lines="\${hits_report##*HITS:}"
    hit_lines="\${hit_lines%%\$NL*}"
    if [[ -n "\$hit_lines" ]]; then
        hits=\$(printf '%s' "\$hit_lines" | awk -F, '{print NF}')
        echo "\$f: lines \$hit_lines"
    else
        hits=0
    fi
    total_hits=\$((total_hits + hits))

    if [[ "${write_flag}" == "--write" && "\$hits" -gt 0 ]]; then
        backup="\${f%.log}.bak-\$(date -u +%Y%m%dT%H%M%SZ).log"
        cp -p "\$f" "\$backup"
        [[ -s "\$backup" ]] || { echo "scrub-log-credentials: backup failed for \$f" >&2; rm -f "\$tmpout"; exit 1; }
        mv "\$tmpout" "\$f"
    else
        rm -f "\$tmpout"
    fi
done

echo "Total hits: \${total_hits}"
[[ "${write_flag}" == "--write" ]] || echo "DRY RUN — no files modified. Re-run with --write to apply."
REMOTE
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
if [[ "$PROD" == "true" ]]; then
    run_prod
else
    run_local
fi
