# C48g / C48h: git ls-files failure and empty list die 3
for kind in lsfail lsempty; do
    cat > "$T/git-$kind" <<STUB
#!/usr/bin/env bash
case "\$*" in
    *"worktree list --porcelain"*)
        cat "\${GH_FX_DIR:-/dev/null}/worktrees.txt" 2>/dev/null || true
        ;;
    *) $([ "$kind" = lsfail ] && echo 'exit 1' || echo 'exit 0') ;;
esac
STUB
    chmod +x "$T/git-$kind"
    OUT="$(GH_LOG="$T/gh.log" GH_FX_DIR="$T/fx" \
        BACKLOG_GH="$T/gh" BURNDOWN_GIT="$T/git-$kind" BURNDOWN_TIER_HINT="$T/tier" \
        HOME="$T/home" "$SCRIPT" burndown 2>&1)"; RC=$?
    if [ "$kind" = lsfail ]; then
        [ "$RC" -eq 3 ] && grep -qF 'git ls-files failed' <<< "$OUT" \
            && ok "C48g: git ls-files failure exits 3" \
            || fail "C48g: git ls-files failure exits 3 (got $RC: $OUT)"
    else
        [ "$RC" -eq 3 ] && grep -qF 'git ls-files listed no files' <<< "$OUT" \
            && ok "C48h: empty file list exits 3" \
            || fail "C48h: empty file list exits 3 (got $RC: $OUT)"
    fi
done

