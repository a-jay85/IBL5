#!/usr/bin/env bash
# Harness tests for bin/scrub-log-credentials.
# Uses synthetic credentials only — no real log content is read, copied, or committed.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SCRIPT="${REPO_ROOT}/bin/scrub-log-credentials"

pass=0
fail=0

ok() { pass=$((pass + 1)); echo "  PASS: $1"; }
fail_msg() { fail=$((fail + 1)); echo "  FAIL: $1"; }

run_case() {
    local label="$1"; echo "--- case: $label ---"
}

# ---------------------------------------------------------------------------
# Build fixtures in a temp dir
# ---------------------------------------------------------------------------
TMP=$(mktemp -d)
# One trap for all temp dirs: a second `trap ... EXIT` REPLACES the first, so a
# per-dir trap would silently leak every dir but the last.
CLEANUP_DIRS=("$TMP")
trap 'rm -rf "${CLEANUP_DIRS[@]}"' EXIT

# file_a.log — 5 lines (3 contaminated + 1 unparseable + 1 already-clean line from file_c)
# Line 1: contaminated — context.trace with regular frames
LINE1=$(jq -nc '{
  "level": 400,
  "level_name": "ERROR",
  "channel": "app",
  "message": "Uncaught exception",
  "context": {
    "exception": "RuntimeException",
    "trace": "#0 /app/ibl5/classes/Auth/AuthService.php(78): Auth\\AuthService->loginWithUsername('\''gm_user'\'', '\''SYNTH_SECRET_PASSWORD'\'', 3600)\n#1 {main}"
  }
}')
# Line 2: clean — info record, no trace key
LINE2=$(jq -nc '{
  "level": 200,
  "level_name": "INFO",
  "channel": "app",
  "message": "user logged in",
  "context": {}
}')
# Line 3: contaminated — context.trace with internal frame
LINE3=$(jq -nc '{
  "level": 400,
  "level_name": "ERROR",
  "channel": "app",
  "message": "Uncaught exception",
  "context": {
    "trace": "#0 [internal function]: Auth\\AuthService->loginWithUsername('\''gm_user'\'', '\''SYNTH_SECRET_PASSWORD'\'', 3600)\n#1 {main}"
  }
}')
# Line 4: deliberately unparseable
LINE4='{"truncated": '
# Line 5: PHP 8.4+ closure frame with parens in name
LINE5=$(jq -nc '{
  "level": 400,
  "level_name": "ERROR",
  "channel": "app",
  "message": "Uncaught exception",
  "context": {
    "trace": "#0 [internal function]: {closure:probe():2}('\''SYNTH_SECRET_PASSWORD'\'')\n#1 {main}"
  }
}')

printf '%s\n' "$LINE1" "$LINE2" "$LINE3" "$LINE4" "$LINE5" > "${TMP}/file_a.log"

# file_b.log — 2 clean lines, no trace key
jq -nc '{"level":200,"channel":"app","message":"ok","context":{}}' > "${TMP}/file_b.log"
jq -nc '{"level":200,"channel":"app","message":"ok2","context":{}}' >> "${TMP}/file_b.log"

# file_c.log — 1 already-arg-free trace (new format) — must NOT be a hit
jq -nc '{
  "level": 400,
  "channel": "app",
  "message": "Uncaught exception",
  "context": {
    "trace": "#0 Auth\\AuthService->loginWithUsername() at /app/x.php:78\n#1 {main}"
  }
}' > "${TMP}/file_c.log"

# Save pristine copies for comparison
cp "${TMP}/file_a.log" "${TMP}/file_a.log.orig"
cp "${TMP}/file_b.log" "${TMP}/file_b.log.orig"
cp "${TMP}/file_c.log" "${TMP}/file_c.log.orig"

# ---------------------------------------------------------------------------
# Case 1: dry-run
# ---------------------------------------------------------------------------
run_case "dry-run"

output=$("$SCRIPT" --log-dir="$TMP" 2>&1)

# Files unchanged
if cmp -s "${TMP}/file_a.log" "${TMP}/file_a.log.orig"; then ok "file_a unchanged"; else fail_msg "file_a was modified in dry-run"; fi
if cmp -s "${TMP}/file_b.log" "${TMP}/file_b.log.orig"; then ok "file_b unchanged"; else fail_msg "file_b was modified in dry-run"; fi
if cmp -s "${TMP}/file_c.log" "${TMP}/file_c.log.orig"; then ok "file_c unchanged"; else fail_msg "file_c was modified in dry-run"; fi

# Reports hit count 3 (lines 1, 3, 5 — not line 2 or 4, not idempotent line in file_c)
if printf '%s\n' "$output" | grep -q 'Total hits: 3'; then ok "dry-run reports 3 hits"; else fail_msg "dry-run hit count wrong (expected 3): $output"; fi

# Secret never in output
if printf '%s\n' "$output" | grep -q 'SYNTH_SECRET_PASSWORD'; then fail_msg "secret appeared in dry-run output"; else ok "no secret in dry-run output"; fi

# No backup files
if ls "${TMP}"/*.bak-*.log 2>/dev/null | grep -q .; then fail_msg "backup files created in dry-run"; else ok "no backups in dry-run"; fi

# ---------------------------------------------------------------------------
# Case 2: write mode
# ---------------------------------------------------------------------------
run_case "write mode"

"$SCRIPT" --log-dir="$TMP" --write 2>&1 >/dev/null || true

# Secret gone from file_a
if grep -q 'SYNTH_SECRET_PASSWORD' "${TMP}/file_a.log" 2>/dev/null; then
    fail_msg "secret still in file_a after --write"
else
    ok "secret removed from file_a"
fi

# Frame identity preserved
if grep -q 'loginWithUsername' "${TMP}/file_a.log" 2>/dev/null; then ok "loginWithUsername preserved"; else fail_msg "loginWithUsername missing after scrub"; fi
if grep -q 'AuthService.php(78)' "${TMP}/file_a.log" 2>/dev/null; then ok "file:line preserved"; else fail_msg "file:line (78) missing after scrub"; fi

# Lines 1, 2, 3, 5 still parse as JSON (line 4 is unparseable)
if sed -n '1p;2p;3p;5p' "${TMP}/file_a.log" | jq -e . >/dev/null 2>&1; then ok "valid lines still parse"; else fail_msg "valid lines no longer parse"; fi

# Line 5 (closure): secret gone, not wholesale-redacted
line5_after=$(sed -n '5p' "${TMP}/file_a.log")
if printf '%s\n' "$line5_after" | grep -q 'SYNTH_SECRET_PASSWORD'; then
    fail_msg "secret in closure line after scrub"
else
    ok "closure line secret removed"
fi
# Closure frame: not wholesale-redacted (secret gone, but frame identity kept)
if printf '%s\n' "$line5_after" | grep -q 'REDACTED'; then fail_msg "closure line was wholesale-redacted"; else ok "closure line not wholesale-redacted"; fi

# Line 4 (unparseable) byte-identical
line4_after=$(sed -n '4p' "${TMP}/file_a.log")
if [[ "$line4_after" == '{"truncated": ' ]]; then ok "unparseable line preserved"; else fail_msg "unparseable line changed: $line4_after"; fi

# Exactly one backup for file_a
backup_count=$(ls "${TMP}/file_a.bak-"*.log 2>/dev/null | wc -l | tr -d ' ')
if [[ "$backup_count" -eq 1 ]]; then ok "exactly 1 backup for file_a"; else fail_msg "wrong backup count for file_a: $backup_count"; fi
backup_file=$(ls "${TMP}/file_a.bak-"*.log 2>/dev/null | head -1)
if [[ -s "$backup_file" ]]; then ok "backup is non-empty"; else fail_msg "backup is empty"; fi

# file_b and file_c untouched, no backup for them
if cmp -s "${TMP}/file_b.log" "${TMP}/file_b.log.orig"; then ok "file_b untouched"; else fail_msg "file_b was modified"; fi
if cmp -s "${TMP}/file_c.log" "${TMP}/file_c.log.orig"; then ok "file_c untouched"; else fail_msg "file_c was modified"; fi
if ls "${TMP}/file_b.bak-"*.log 2>/dev/null | grep -q .; then fail_msg "spurious backup for file_b"; else ok "no backup for file_b"; fi
if ls "${TMP}/file_c.bak-"*.log 2>/dev/null | grep -q .; then fail_msg "spurious backup for file_c"; else ok "no backup for file_c"; fi

# No secret in combined output
write_output=$("$SCRIPT" --log-dir="$TMP" --write 2>&1 || true)
if printf '%s\n' "$write_output" | grep -q 'SYNTH_SECRET_PASSWORD'; then fail_msg "secret in --write output"; else ok "no secret in --write output"; fi

# ---------------------------------------------------------------------------
# Case 3: idempotence
# ---------------------------------------------------------------------------
run_case "idempotence"

file_a_before=$(cat "${TMP}/file_a.log")
idempotent_output=$("$SCRIPT" --log-dir="$TMP" --write 2>&1 || true)

if printf '%s\n' "$idempotent_output" | grep -q 'Total hits: 0'; then ok "second write reports 0 hits"; else fail_msg "second write hit count wrong: $idempotent_output"; fi
file_a_after=$(cat "${TMP}/file_a.log")
if [[ "$file_a_before" == "$file_a_after" ]]; then ok "file_a byte-identical after idempotent write"; else fail_msg "file_a changed on second write"; fi

# ---------------------------------------------------------------------------
# Case 4: unknown flag
# ---------------------------------------------------------------------------
run_case "unknown flag rejection"

if "$SCRIPT" --unknown-flag 2>/dev/null; then
    fail_msg "--unknown-flag should have failed"
else
    ok "--unknown-flag exits non-zero"
fi
# Capture stderr separately — piping a failing command through grep trips pipefail
unknown_stderr=$("$SCRIPT" --unknown-flag 2>&1 || true)
if printf '%s\n' "$unknown_stderr" | grep -q 'Unknown option'; then ok "stderr contains 'Unknown option'"; else fail_msg "stderr missing 'Unknown option': $unknown_stderr"; fi

# ---------------------------------------------------------------------------
# Case 5: PROD_SSH_HOST env var states
# ---------------------------------------------------------------------------
run_case "PROD_SSH_HOST env checks"

# Create a PATH shim that stubs ssh to exit 97
SSH_SHIM_DIR=$(mktemp -d)
CLEANUP_DIRS+=("$SSH_SHIM_DIR")
cat > "${SSH_SHIM_DIR}/ssh" << 'SSHSTUB'
#!/usr/bin/env bash
exit 97
SSHSTUB
chmod +x "${SSH_SHIM_DIR}/ssh"

# Create a fake repo root that has no .env and is not a git repo.
# The script derives REPO_ROOT from dirname($0), so we symlink the script
# into a temp bin/ dir; the git common-dir lookup will fail silently (not
# a git repo), so no .env fallback can override the env var.
FAKE_ROOT=$(mktemp -d)
CLEANUP_DIRS+=("$FAKE_ROOT")
mkdir -p "${FAKE_ROOT}/bin/lib"
ln -s "$SCRIPT" "${FAKE_ROOT}/bin/scrub-log-credentials"
ln -s "${REPO_ROOT}/bin/lib/scrub-log-credentials.php" "${FAKE_ROOT}/bin/lib/scrub-log-credentials.php"
FAKE_SCRIPT="${FAKE_ROOT}/bin/scrub-log-credentials"

# 5a: unset PROD_SSH_HOST
unset_exit=0
env -u PROD_SSH_HOST PATH="${SSH_SHIM_DIR}:${PATH}" "$FAKE_SCRIPT" --prod 2>/dev/null || unset_exit=$?
if [[ "$unset_exit" -ne 0 ]]; then ok "unset PROD_SSH_HOST exits non-zero"; else fail_msg "unset PROD_SSH_HOST should have failed"; fi
if [[ "$unset_exit" -eq 97 ]]; then fail_msg "unset: ssh was invoked before config check"; else ok "unset: ssh not invoked"; fi
unset_stderr=$(env -u PROD_SSH_HOST PATH="${SSH_SHIM_DIR}:${PATH}" "$FAKE_SCRIPT" --prod 2>&1 || true)
if printf '%s\n' "$unset_stderr" | grep -q 'PROD_SSH_HOST'; then ok "unset: stderr names PROD_SSH_HOST"; else fail_msg "unset: stderr missing PROD_SSH_HOST: $unset_stderr"; fi

# 5b: set-but-empty PROD_SSH_HOST
empty_exit=0
PROD_SSH_HOST= PATH="${SSH_SHIM_DIR}:${PATH}" "$FAKE_SCRIPT" --prod 2>/dev/null || empty_exit=$?
if [[ "$empty_exit" -ne 0 ]]; then ok "empty PROD_SSH_HOST exits non-zero"; else fail_msg "empty PROD_SSH_HOST should have failed"; fi
if [[ "$empty_exit" -eq 97 ]]; then fail_msg "empty: ssh was invoked before config check"; else ok "empty: ssh not invoked"; fi
empty_stderr=$(PROD_SSH_HOST= PATH="${SSH_SHIM_DIR}:${PATH}" "$FAKE_SCRIPT" --prod 2>&1 || true)
if printf '%s\n' "$empty_stderr" | grep -q 'PROD_SSH_HOST'; then ok "empty: stderr names PROD_SSH_HOST"; else fail_msg "empty: stderr missing PROD_SSH_HOST: $empty_stderr"; fi

# ---------------------------------------------------------------------------
# Case 6: never auto-run
# ---------------------------------------------------------------------------
run_case "never auto-run"

cd "$REPO_ROOT"

# Nothing in CI or Docker may reference it (excluding the harness itself)
if ! grep -rn 'scrub-log-credentials' .github/ docker/ 2>/dev/null | grep -v 'test-scrub-log-credentials'; then
    ok "no CI/Docker reference to scrub-log-credentials (outside harness)"
else
    fail_msg "found unexpected CI/Docker reference to scrub-log-credentials"
fi

# No other bin/ script may invoke it. bin/lib/scrub-log-credentials.php is the
# scrubber this script drives, not an invoker, so it is excluded too.
if ! grep -rn 'scrub-log-credentials' bin/ 2>/dev/null | grep -v '^bin/scrub-log-credentials:\|^bin/test-scrub-log-credentials:\|^bin/lib/scrub-log-credentials\.php:'; then
    ok "no other bin/ script invokes scrub-log-credentials"
else
    fail_msg "found unexpected bin/ invocation of scrub-log-credentials"
fi

# ---------------------------------------------------------------------------
# Case 7: backup files are gitignored
# ---------------------------------------------------------------------------
run_case "backups are gitignored"

if git check-ignore -q "ibl5/logs/ibl5-2026-01-01.bak-20260101T000000Z.log" 2>/dev/null; then
    ok "backup .log files are gitignored"
else
    fail_msg "backup .log files are NOT gitignored"
fi

# ---------------------------------------------------------------------------
# Case 8: prod path — capture the generated remote script and check it
#
# The remote path used to be untestable without SSH, which is how four bugs
# shipped in it. It is now a heredoc that base64-ships bin/lib/scrub-log-credentials.php
# and drives it exactly the way local mode does, so the whole script can be
# captured through a stub ssh and then executed (case 9) without a connection.
# ---------------------------------------------------------------------------
run_case "prod path: generated remote script"

CAP_DIR=$(mktemp -d)
CLEANUP_DIRS+=("$CAP_DIR")

# Stub ssh: the remote script arrives on stdin, so dump it instead of connecting.
cat > "${CAP_DIR}/ssh" << 'SSHCAP'
#!/usr/bin/env bash
cat > "${SCRUB_TEST_CAPTURE}"
SSHCAP
chmod +x "${CAP_DIR}/ssh"

# --ssh-host bypasses the .env lookup, so no real host is ever resolved.
capture_remote() {
    local dest="$1"; shift
    SCRUB_TEST_CAPTURE="$dest" PATH="${CAP_DIR}:${PATH}" \
        "$SCRIPT" --prod --ssh-host=stub@example.invalid "$@" >/dev/null 2>&1 || true
}

REMOTE_DRY="${CAP_DIR}/remote-dry.sh"
capture_remote "$REMOTE_DRY"

if [[ -s "$REMOTE_DRY" ]]; then ok "remote script captured"; else fail_msg "remote script empty — ssh stub never received it"; fi

# 8a: it must be valid bash. A quoting slip in the heredoc used to be invisible.
if bash -n "$REMOTE_DRY" 2>/dev/null; then ok "remote script is syntactically valid bash"; else fail_msg "remote script is not valid bash"; fi

# 8b: prod is a shared cPanel host with no jq and no durable way to add one.
# Comments are stripped first — prose explaining *why* jq is gone is welcome; a
# line of code that runs it is not.
if grep -v '^[[:space:]]*#' "$REMOTE_DRY" | grep -q 'jq'; then fail_msg "remote script runs jq (prod has none)"; else ok "remote script has no jq dependency"; fi
if grep -v '^[[:space:]]*#' "$SCRIPT" | grep -q 'jq'; then fail_msg "script still runs jq"; else ok "script has no jq dependency"; fi

# 8c: check for php up front rather than failing partway through a scrub.
if grep -q 'php is required on remote' "$REMOTE_DRY"; then ok "remote checks for php"; else fail_msg "remote does not check for php"; fi

# 8d: single source of truth — the remote runs the same file local mode runs.
# Without this link, cases 1-3 prove nothing about the prod path.
if grep -qF 'base64 < "$SCRUBBER"' "$SCRIPT"; then
    ok "remote ships base64 of \$SCRUBBER (single source of truth)"
else
    fail_msg "remote does not base64 \$SCRUBBER — cases 1-3 prove nothing about the prod path"
fi
if grep -qF 'php "$SCRUBBER" "$f" "$tmpout"' "$SCRIPT"; then
    ok "local mode drives the same scrubber file"
else
    fail_msg "local mode does not drive \$SCRUBBER — local and prod can drift"
fi
if grep -qE 'strip_args|is_clean|process_trace|preg_replace' "$REMOTE_DRY"; then
    fail_msg "remote script inlines scrub logic — it can drift from the PHP scrubber"
else
    ok "remote script inlines no scrub logic (no drift surface)"
fi

# 8e: backups must be skipped remotely too, or a second --write scrubs the
# backup and backs *that* up (foo.bak-T1.bak-T2.log). Local mode already skips.
if grep -q 'bak-\*\.log' "$REMOTE_DRY"; then ok "remote skips .bak-*.log files"; else fail_msg "remote does not skip .bak-*.log (backups will compound)"; fi

# ---------------------------------------------------------------------------
# Case 9: execute that captured remote script against a simulated prod log dir
# ---------------------------------------------------------------------------
run_case "prod path: execute remote script end-to-end"

PRODSIM=$(mktemp -d)
CLEANUP_DIRS+=("$PRODSIM")
PRODLOGS="${PRODSIM}/www/ibl5/logs"
mkdir -p "$PRODLOGS"
cp "${TMP}/file_a.log.orig" "${PRODLOGS}/file_a.log"
cp "${TMP}/file_b.log.orig" "${PRODLOGS}/file_b.log"
cp "${TMP}/file_c.log.orig" "${PRODLOGS}/file_c.log"

# 9a: dry run — finds the same 3 hits local mode found, changes nothing.
remote_dry_out=$(cd "$PRODSIM" && bash "$REMOTE_DRY" 2>&1) || true
if printf '%s\n' "$remote_dry_out" | grep -q 'Total hits: 3'; then ok "remote dry-run reports 3 hits"; else fail_msg "remote dry-run hit count wrong: $remote_dry_out"; fi
if printf '%s\n' "$remote_dry_out" | grep -q 'SYNTH_SECRET_PASSWORD'; then fail_msg "secret appeared in remote dry-run output"; else ok "no secret in remote dry-run output"; fi
if cmp -s "${PRODLOGS}/file_a.log" "${TMP}/file_a.log.orig"; then ok "remote dry-run left file_a unchanged"; else fail_msg "remote dry-run modified file_a"; fi
if ls "${PRODLOGS}"/*.bak-*.log 2>/dev/null | grep -q .; then fail_msg "remote dry-run created backups"; else ok "remote dry-run created no backups"; fi

# 9b: write run — scrubs, backs up, preserves frame identity.
REMOTE_WRITE="${CAP_DIR}/remote-write.sh"
capture_remote "$REMOTE_WRITE" --write
remote_write_out=$(cd "$PRODSIM" && bash "$REMOTE_WRITE" 2>&1) || true

if grep -q 'SYNTH_SECRET_PASSWORD' "${PRODLOGS}/file_a.log" 2>/dev/null; then
    fail_msg "secret still in file_a after remote --write"
else
    ok "remote --write removed the secret"
fi
if printf '%s\n' "$remote_write_out" | grep -q 'SYNTH_SECRET_PASSWORD'; then fail_msg "secret in remote --write output"; else ok "no secret in remote --write output"; fi
if grep -q 'loginWithUsername' "${PRODLOGS}/file_a.log" 2>/dev/null; then ok "remote --write preserved frame identity"; else fail_msg "remote --write lost loginWithUsername"; fi
if grep -q 'AuthService.php(78)' "${PRODLOGS}/file_a.log" 2>/dev/null; then ok "remote --write preserved file:line"; else fail_msg "remote --write lost file:line"; fi
if sed -n '1p;2p;3p;5p' "${PRODLOGS}/file_a.log" | jq -e . >/dev/null 2>&1; then ok "remote output still parses as JSON"; else fail_msg "remote output no longer parses"; fi
if [[ "$(sed -n '4p' "${PRODLOGS}/file_a.log")" == '{"truncated": ' ]]; then ok "remote preserved the unparseable line"; else fail_msg "remote changed the unparseable line"; fi

remote_backups=$(ls "${PRODLOGS}/file_a.bak-"*.log 2>/dev/null | wc -l | tr -d ' ')
if [[ "$remote_backups" -eq 1 ]]; then ok "remote made exactly 1 backup for file_a"; else fail_msg "remote backup count wrong: $remote_backups"; fi
if cmp -s "${PRODLOGS}/file_b.log" "${TMP}/file_b.log.orig"; then ok "remote left clean file_b byte-identical"; else fail_msg "remote modified clean file_b"; fi
if cmp -s "${PRODLOGS}/file_c.log" "${TMP}/file_c.log.orig"; then ok "remote left already-scrubbed file_c byte-identical"; else fail_msg "remote modified file_c"; fi

# 9c: idempotence — a second --write finds nothing AND does not re-scrub the
# backup it just made. Regression guard for compounding backups.
prod_a_before=$(cat "${PRODLOGS}/file_a.log")
remote_second_out=$(cd "$PRODSIM" && bash "$REMOTE_WRITE" 2>&1) || true
if printf '%s\n' "$remote_second_out" | grep -q 'Total hits: 0'; then ok "remote second --write reports 0 hits"; else fail_msg "remote second --write hit count wrong: $remote_second_out"; fi
if [[ "$prod_a_before" == "$(cat "${PRODLOGS}/file_a.log")" ]]; then ok "remote second --write left file_a byte-identical"; else fail_msg "remote second --write changed file_a"; fi
if ls "${PRODLOGS}"/*.bak-*.bak-*.log 2>/dev/null | grep -q .; then
    fail_msg "remote re-scrubbed a backup — backups are compounding"
else
    ok "remote did not back up a backup"
fi

# ---------------------------------------------------------------------------
# Case 10: the PHP scrubber itself
# ---------------------------------------------------------------------------
run_case "PHP scrubber contract"

SCRUBBER_PHP="${REPO_ROOT}/bin/lib/scrub-log-credentials.php"
if [[ -f "$SCRUBBER_PHP" ]]; then ok "scrubber file exists"; else fail_msg "missing bin/lib/scrub-log-credentials.php"; fi
if php -l "$SCRUBBER_PHP" >/dev/null 2>&1; then ok "scrubber passes php -l"; else fail_msg "scrubber fails php -l"; fi

# The prod path ships this ONE file, so it may not pull in anything else.
if grep -qE '^[[:space:]]*(require|require_once|include|include_once|use)[[:space:]]' "$SCRUBBER_PHP"; then
    fail_msg "scrubber has an include/require/use — it must be standalone to ship over SSH"
else
    ok "scrubber is standalone (no include/require/use)"
fi

# An empty trace carries no arguments: not a hit, not redacted. PHP's explode()
# and jq's split() disagree on the empty string; jq's answer is the right one.
EMPTY_DIR=$(mktemp -d)
CLEANUP_DIRS+=("$EMPTY_DIR")
jq -nc '{"level":400,"channel":"app","context":{"trace":""}}' > "${EMPTY_DIR}/empty.log"
cp "${EMPTY_DIR}/empty.log" "${EMPTY_DIR}/empty.log.orig"
empty_out=$("$SCRIPT" --log-dir="$EMPTY_DIR" --write 2>&1 || true)
if printf '%s\n' "$empty_out" | grep -q 'Total hits: 0'; then ok "empty trace is not a hit"; else fail_msg "empty trace counted as a hit: $empty_out"; fi
if cmp -s "${EMPTY_DIR}/empty.log" "${EMPTY_DIR}/empty.log.orig"; then ok "empty trace left untouched"; else fail_msg "empty trace was rewritten"; fi

# A final line with no trailing newline must survive, not be silently dropped.
NONL_DIR=$(mktemp -d)
CLEANUP_DIRS+=("$NONL_DIR")
jq -nc '{"level":200,"channel":"app","message":"first","context":{}}' > "${NONL_DIR}/nonl.log"
printf '%s' '{"level":200,"channel":"app","message":"last-no-newline","context":{}}' >> "${NONL_DIR}/nonl.log"
"$SCRIPT" --log-dir="$NONL_DIR" --write >/dev/null 2>&1 || true
if grep -q 'last-no-newline' "${NONL_DIR}/nonl.log"; then ok "final newline-less line preserved"; else fail_msg "final newline-less line was dropped"; fi
# ---------------------------------------------------------------------------
# Case 11: php writing noise to stdout ahead of the HITS report
# ---------------------------------------------------------------------------
run_case "noisy php stdout"

# Prod is a shared cPanel host whose php.ini we do not control, and PHP CLI sends
# startup diagnostics ("Unable to load dynamic library ...") to STDOUT, not stderr.
# A naive "${hits_report#HITS:}" strips nothing when such a line arrives first, and
# the multi-line result then blows up the arithmetic test under set -e.
NOISY_DIR=$(mktemp -d)
CLEANUP_DIRS+=("$NOISY_DIR")
NOISY_BIN="${NOISY_DIR}/bin"
mkdir -p "$NOISY_BIN"
REAL_PHP=$(command -v php)
{
    echo '#!/bin/sh'
    echo "echo \"PHP Warning:  PHP Startup: Unable to load dynamic library 'imagick.so'\""
    echo "exec \"${REAL_PHP}\" \"\$@\""
} > "${NOISY_BIN}/php"
chmod +x "${NOISY_BIN}/php"

NOISY_LOGS="${NOISY_DIR}/logs"
mkdir -p "$NOISY_LOGS"
printf '%s\n' "{\"level\":400,\"channel\":\"app\",\"context\":{\"trace\":\"#0 /app/a.php(1): f('SECRET_PW')\\n#1 {main}\"}}" > "${NOISY_LOGS}/noisy.log"

noisy_rc=0
noisy_out=$(PATH="${NOISY_BIN}:${PATH}" "$SCRIPT" --log-dir="$NOISY_LOGS" --write 2>&1) || noisy_rc=$?
if [[ "$noisy_rc" -eq 0 ]]; then ok "survives php noise on stdout"; else fail_msg "php stdout noise broke the run (rc=$noisy_rc): $noisy_out"; fi
if printf '%s\n' "$noisy_out" | grep -q 'Total hits: 1'; then ok "hit count correct despite php noise"; else fail_msg "wrong hit count with php noise: $noisy_out"; fi
if grep -q 'SECRET_PW' "${NOISY_LOGS}/noisy.log"; then fail_msg "secret survived the scrub under php noise"; else ok "secret scrubbed despite php noise"; fi

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
echo ""
echo "Results: ${pass} passed, ${fail} failed"
if [[ "$fail" -gt 0 ]]; then
    exit 1
fi
