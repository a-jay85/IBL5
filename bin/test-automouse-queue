# ---------------------------------------------------------------------------
# Phase 4 rows — read-only `status` subcommand
# ---------------------------------------------------------------------------
# st_check <label> <rc> <out> <grep -E pattern>: pass when rc is 0 and the pattern matches.
st_check() {
    local label="$1" rc="$2" out="$3" pat="$4"
    if [ "$rc" -eq 0 ] && grep -qE -- "$pat" <<< "$out"; then
        h_pass "$label"
    else
        h_fail "$label (rc=$rc, pattern: $pat): $out"
    fi
}

setup
out=$(run_queue status 2>&1); rc=$?
mkplan plan-ok.md
run_queue plan-ok >/dev/null 2>&1
out2=$(run_queue status 2>&1); rc2=$?
if [ "$rc" -eq 0 ] && [ "$out" = "Nothing needs attention." ] \
    && [ "$rc2" -eq 0 ] && [ "$out2" = "Nothing needs attention." ]; then
    h_pass "row-status-empty"
else
    h_fail "row-status-empty (rc=$rc/$rc2): $out / $out2"
fi

