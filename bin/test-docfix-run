  && ok "(24) veronly: untracked file holds (rc 1)" \
  || bad "(24) veronly: untracked file"

# Case 25: backwards date (2025-12-31 < 2026-01-01) → rc 1
SB2="$(build_veronly_repo)"
R="$SB2/repo"
PLAN_V="$SB2/home/claude-plans/$VR_SLUG.md"
printf 'last_verified: 2025-12-31\n' > "$R/docs/x.md"
( cd "$R" && HOME="$SB2/home" DOCFIX_BASE_REF=master \
