# --- Cases 41-47: bin/docfix-check-veronly boundaries ------------------------
# Verification Matrix rows 11-14, 18, 19: the fail-open holes the predicate is
# the sole defense against. Each asserts the verdict LINE, not just the exit
# code, so a case cannot pass by holding for an unrelated reason.

# Case 41: renamed file → rc 1 (name-status is R/D+A, never M)
SB2="$(build_veronly_repo)"
R="$SB2/repo"
PLAN_V="$SB2/home/claude-plans/$VR_SLUG.md"
git -C "$R" mv docs/x.md docs/y.md
printf 'last_verified: 2026-08-13\n' > "$R/docs/y.md"
VOUT="$( cd "$R" && HOME="$SB2/home" DOCFIX_BASE_REF=master \
    "$REAL_VERONLY" "$VR_SLUG" 2>&1 )" && VRC=0 || VRC=$?
{ [ "$VRC" -eq 1 ] && grep -q '^auto_merge: false$' "$PLAN_V" \
    && printf '%s' "$VOUT" | grep -qF 'non-M change in diff'; } \
  && ok "(41) veronly: renamed file holds (rc 1, non-M status)" \
  || bad "(41) veronly: renamed file"

# Case 42: deleted file → rc 1 (status D)
SB2="$(build_veronly_repo)"
R="$SB2/repo"
PLAN_V="$SB2/home/claude-plans/$VR_SLUG.md"
git -C "$R" rm -q docs/x.md
VOUT="$( cd "$R" && HOME="$SB2/home" DOCFIX_BASE_REF=master \
    "$REAL_VERONLY" "$VR_SLUG" 2>&1 )" && VRC=0 || VRC=$?
{ [ "$VRC" -eq 1 ] && grep -q '^auto_merge: false$' "$PLAN_V" \
    && printf '%s' "$VOUT" | grep -qF "status 'D'"; } \
  && ok "(42) veronly: deleted file holds (rc 1, status D)" \
  || bad "(42) veronly: deleted file"

# Case 43: equal date → rc 1. The pair is realized by MOVING the date line, the
# only way a diff carries a -/+ last_verified pair whose dates are identical.
SB2="$(build_veronly_repo)"
R="$SB2/repo"
PLAN_V="$SB2/home/claude-plans/$VR_SLUG.md"
veronly_reseed_base "$R" 'last_verified: 2026-01-01' 'body'
printf '%s\n' 'body' 'last_verified: 2026-01-01' > "$R/docs/x.md"
VOUT="$( cd "$R" && HOME="$SB2/home" DOCFIX_BASE_REF=master \
    "$REAL_VERONLY" "$VR_SLUG" 2>&1 )" && VRC=0 || VRC=$?
{ [ "$VRC" -eq 1 ] && grep -q '^auto_merge: false$' "$PLAN_V" \
    && printf '%s' "$VOUT" | grep -qF 'not strictly advancing'; } \
  && ok "(43) veronly: equal date holds (rc 1, not strictly advancing)" \
  || bad "(43) veronly: equal date"

# Case 44: malformed date (2026-8-9) → rc 1 on the anchored regex
SB2="$(build_veronly_repo)"
R="$SB2/repo"
PLAN_V="$SB2/home/claude-plans/$VR_SLUG.md"
printf 'last_verified: 2026-8-9\n' > "$R/docs/x.md"
VOUT="$( cd "$R" && HOME="$SB2/home" DOCFIX_BASE_REF=master \
    "$REAL_VERONLY" "$VR_SLUG" 2>&1 )" && VRC=0 || VRC=$?
{ [ "$VRC" -eq 1 ] && grep -q '^auto_merge: false$' "$PLAN_V" \
    && printf '%s' "$VOUT" | grep -qF 'non-date change line'; } \
  && ok "(44) veronly: malformed date holds (rc 1)" \
  || bad "(44) veronly: malformed date"

# Case 45: two last_verified pairs in one file (fenced example + real
# frontmatter) → rc 1. Both dates advance, so only the pair count catches it.
SB2="$(build_veronly_repo)"
R="$SB2/repo"
PLAN_V="$SB2/home/claude-plans/$VR_SLUG.md"
veronly_reseed_base "$R" 'last_verified: 2026-01-01' '' 'example:' 'last_verified: 2026-01-01'
printf '%s\n' 'last_verified: 2026-08-13' '' 'example:' 'last_verified: 2026-08-13' \
    > "$R/docs/x.md"
VOUT="$( cd "$R" && HOME="$SB2/home" DOCFIX_BASE_REF=master \
    "$REAL_VERONLY" "$VR_SLUG" 2>&1 )" && VRC=0 || VRC=$?
{ [ "$VRC" -eq 1 ] && grep -q '^auto_merge: false$' "$PLAN_V" \
    && printf '%s' "$VOUT" | grep -qF 'expected exactly 1 date-change pair'; } \
  && ok "(45) veronly: two date pairs in one file hold (rc 1)" \
  || bad "(45) veronly: two date pairs"

# Case 46: a removed markdown --- delimiter renders as "----", which has no
# space in the 4th position and so must NOT be swallowed by the "--- " header
# skip. Guards the load-bearing trailing space in the predicate's case pattern.
SB2="$(build_veronly_repo)"
R="$SB2/repo"
PLAN_V="$SB2/home/claude-plans/$VR_SLUG.md"
veronly_reseed_base "$R" '---' 'last_verified: 2026-01-01' '---'
printf '%s\n' 'last_verified: 2026-08-13' > "$R/docs/x.md"
VOUT="$( cd "$R" && HOME="$SB2/home" DOCFIX_BASE_REF=master \
    "$REAL_VERONLY" "$VR_SLUG" 2>&1 )" && VRC=0 || VRC=$?
{ [ "$VRC" -eq 1 ] && grep -q '^auto_merge: false$' "$PLAN_V" \
    && printf '%s' "$VOUT" | grep -qF 'non-date change line'; } \
  && ok "(46) veronly: removed --- delimiter holds (rc 1, not a header line)" \
  || bad "(46) veronly: removed --- delimiter"

# Case 47: valid date bump but the plan file is gone → rc 2, no silent grant
SB2="$(build_veronly_repo)"
R="$SB2/repo"
PLAN_V="$SB2/home/claude-plans/$VR_SLUG.md"
printf 'last_verified: 2026-08-13\n' > "$R/docs/x.md"
rm -f "$PLAN_V"
VOUT="$( cd "$R" && HOME="$SB2/home" DOCFIX_BASE_REF=master \
    "$REAL_VERONLY" "$VR_SLUG" 2>&1 )" && VRC=0 || VRC=$?
{ [ "$VRC" -eq 2 ] && [ ! -f "$PLAN_V" ] \
    && printf '%s' "$VOUT" | grep -qF 'plan file not found'; } \
  && ok "(47) veronly: missing plan file is rc 2, not a grant" \
  || bad "(47) veronly: missing plan file"

# --- Cases 20a-23 (plan matrix #13-16): prompt-safety + fail-closed guard --------

# Case 20a (plan #13): injection chars in SIG — not executed, written literally to plist.
# shq() single-quotes the prompt, so $() spans are never evaluated by the plist shell.
SB="$(build_sandbox)"
SIG13='ibl5/docs/foo.md,$(touch /tmp/pr13-pwned-backtick)'
run_docfix "$SB" "" "" "13p" "$SIG13" >/dev/null
P_INJ="$(plist_of "$SB")"
{ [ ! -f /tmp/pr13-pwned-backtick ] \
    && [ -n "$P_INJ" ] \
    && grep -qF '$(touch /tmp/pr13-pwned-backtick)' "$P_INJ"; } \
  && ok "(20a/plan13) injection chars in SIG written literally to plist, not executed" \
  || bad "(20a/plan13) prompt injection guard"

# Case 20b (plan #14): malicious $SIG — not executed during plist construction.
# $SIG is substituted into PROMPT as a literal; no second expansion occurs in bash.
SB="$(build_sandbox)"
SIG14='ibl5/docs/foo.md $(touch /tmp/pr14-pwned-sig)'
run_docfix "$SB" "" "" "14p" "$SIG14" >/dev/null
{ [ ! -f /tmp/pr14-pwned-sig ]; } \
  && ok "(20b/plan14) malicious SIG not executed during plist construction" \
  || bad "(20b/plan14) malicious SIG executed"

# Case 22 (plan #15): XML metacharacters in SIG — plist still parses.
# xml_escape() converts & → &amp; and < → &lt; so the plist XML stays well-formed.
SB="$(build_sandbox)"
SIG15='ibl5/docs/foo.md &amp; <tag>'
run_docfix "$SB" "" "" "15p" "$SIG15" >/dev/null
PLIST22="$(plist_of "$SB")"
# plutil is macOS-only; use python3 xml.etree (available on macOS + Linux CI) as a
# portable plist/XML validator so the test passes on ubuntu-latest runners.
{ [ -n "$PLIST22" ] && python3 -c "import xml.etree.ElementTree as ET; ET.parse('$PLIST22')" >/dev/null 2>&1; } \
  && ok "(22/plan15) SIG with & and < yields a plutil-lint-clean plist" \
  || bad "(22/plan15) XML metacharacters broke plist"

# Case 23 (plan #16): gh API unreachable → fail-closed open-PR guard.
# run_docfix suppresses output; call docfix-run directly to capture stderr.
SB="$(build_sandbox)"
OUT23="$(SHIM_GH_FAIL=1 IBL5_MAIN="$SB" HOME="$SB/home" PATH="$SB/shim:$PATH" \
    "$REAL_DOCFIX" "16p" "a.md" 2>&1)"
RC23=$?
{ [ "$RC23" -eq 0 ] \
    && [ -z "$(plist_of "$SB")" ] \
    && printf '%s' "$OUT23" | grep -q 'API unreachable'; } \
  && ok "(23/plan16) gh API unreachable → exit 0, no plist, 'API unreachable' message" \
  || bad "(23/plan16) fail-closed open-PR guard"

# --- Case 48: static — prompt still carries the append-only + disclosure clauses
# These are prose constraints inside $PROMPT, not code, so nothing else fails when a
# future edit drops them. Assert them the way Case 6/8 assert workflow invariants.
{ grep -qF 'DECISION RECORDS ARE APPEND-ONLY' "$REAL_DOCFIX" \
    && grep -qF 'NEVER SWAP A FIGURE WITHOUT RE-READING ITS SENTENCE' "$REAL_DOCFIX" \
    && grep -qF '## Addendum' "$REAL_DOCFIX" \
    && grep -qF '## Content rewritten' "$REAL_DOCFIX"; } \
  && ok "(48) prompt: ADR append-only + figure-resubstitution + content-rewrite disclosure clauses present" \
  || bad "(48) prompt: an append-only/disclosure clause was dropped from \$PROMPT"

if [ "$FAILED" -eq 0 ]; then echo "All docfix-run checks passed."; else echo "Some docfix-run checks FAILED."; fi
exit "$FAILED"
