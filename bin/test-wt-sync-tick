assert_eq "only: no-value exits 2"  "2" "$ONLY_ST30b"

# ── Test 31: only: lock is waited on, never taken ─────────────────────────────
MAIN31="$(new_env)"
WT31="$(add_worktree "$MAIN31" "wt-lock31" current)"
# Write a live PID into the lock file to simulate a running fleet tick
_TICK_LOCK31="$_TICK_LOCKD/wt-sync.lock"
printf '%d\n' "$$" > "$_TICK_LOCK31"
WT_SYNC_ONDEMAND_LOCK_WAIT=2 run_only "$WT31"
if [ -n "$ONLY_OUT" ]; then
    pass "only: lock waited — verdict still emitted ($ONLY_OUT)"
else
    failcase "only: lock wait blocked verdict entirely"
fi
# Assert the lock was never overwritten (it must still hold our shell PID)
if [ -f "$_TICK_LOCK31" ]; then
    LOCK_PID31="$(cat "$_TICK_LOCK31" 2>/dev/null || true)"
    assert_eq "only: lock file holds original PID (never taken)" "$$" "$LOCK_PID31"
else
    failcase "only: lock file was removed by on-demand mode (must not take the lock)"
fi
rm -f "$_TICK_LOCK31"

# ── Test 32: fleet: stale copy (all ahead commits cherry-equivalent) → RESET-STALE ─
MAIN32="$(new_env)"
WT32="$(add_worktree "$MAIN32" "wt-stale32" stale-copy)"
LOG32="$(fresh_log t32)"; LOCKD32="$(fresh_lockd t32)"
HEAD32_BEFORE="$(git -C "$WT32" rev-parse HEAD)"
ORIGIN32="$(git -C "$MAIN32" rev-parse origin/wt-stale32)"
# Fixture self-check: prove the fixture is a stale copy before judging the tick.
if [ "$HEAD32_BEFORE" != "$ORIGIN32" ]; then
    pass "stale-fixture: local tip differs from rewritten origin tip"
else
    failcase "stale-fixture: cherry-pick produced identical SHAs (fixture broken)"
fi
assert_eq    "stale-fixture: ahead=2 behind=2" "2	2" \
    "$(git -C "$WT32" rev-list --left-right --count "origin/wt-stale32...HEAD")"
assert_absent "stale-fixture: no unique ('+') commits" '^\+' \
    "$(git -C "$WT32" cherry origin/wt-stale32 HEAD)"
run_with_repo "$MAIN32" "$LOG32" "$LOCKD32" -- --force
assert_eq     "stale-fleet: exit 0" "0" "$ST"
assert_match  "stale-fleet: RESET-STALE emitted" "RESET-STALE.*wt-stale32" "$OUT"
assert_absent "stale-fleet: no STRAGGLER for the reset branch" \
    "STRAGGLER branch=wt-stale32" "$(cat "$LOG32" 2>/dev/null)"
assert_eq     "stale-fleet: HEAD moved to origin tip" "$ORIGIN32" \
    "$(git -C "$WT32" rev-parse HEAD)"
assert_eq     "stale-fleet: worktree clean after reset" "" \
    "$(git -C "$WT32" status --porcelain)"
assert_eq     "stale-fleet: patch content preserved" "work 2" "$(cat "$WT32/work2.txt")"

# ── Test 33: fleet: backup ref records the pre-reset HEAD ─────────────────────
# Reuses Test 32's post-reset state; refs/ is shared across worktrees.
assert_eq "stale-backup: refs/wt-sync-backup/<branch> = pre-reset HEAD" \
    "$HEAD32_BEFORE" \
    "$(git -C "$WT32" rev-parse --verify -q refs/wt-sync-backup/wt-stale32 2>/dev/null)"

# ── Test 34: fleet: real unique commit → STRAGGLER, never RESET-STALE ─────────
MAIN34="$(new_env)"
WT34="$(add_worktree "$MAIN34" "wt-uniq34" stale-copy-plus-unique)"
LOG34="$(fresh_log t34)"; LOCKD34="$(fresh_lockd t34)"
HEAD34_BEFORE="$(git -C "$WT34" rev-parse HEAD)"
run_with_repo "$MAIN34" "$LOG34" "$LOCKD34" -- --force
assert_eq     "stale-unique: exit 0" "0" "$ST"
assert_absent "stale-unique: no RESET-STALE" "RESET-STALE" "$OUT"
assert_match  "stale-unique: STRAGGLER in log" "STRAGGLER branch=wt-uniq34" \
    "$(cat "$LOG34" 2>/dev/null)"
assert_eq     "stale-unique: HEAD unchanged" "$HEAD34_BEFORE" "$(git -C "$WT34" rev-parse HEAD)"
if git -C "$WT34" rev-parse --verify -q refs/wt-sync-backup/wt-uniq34 >/dev/null 2>&1; then
    failcase "stale-unique: backup ref written for an untouched branch"
else
    pass "stale-unique: no backup ref"
fi

# ── Test 35: fleet: dirty stale copy → DIRTY, never RESET-STALE ───────────────
MAIN35="$(new_env)"
WT35="$(add_worktree "$MAIN35" "wt-sdirty35" stale-copy)"
printf 'dirty\n' >> "$WT35/README.md"          # unstaged tracked edit
LOG35="$(fresh_log t35)"; LOCKD35="$(fresh_lockd t35)"
HEAD35_BEFORE="$(git -C "$WT35" rev-parse HEAD)"
CONTENT35_BEFORE="$(cat "$WT35/README.md")"
run_with_repo "$MAIN35" "$LOG35" "$LOCKD35" -- --force
assert_eq     "stale-dirty: exit 0" "0" "$ST"
assert_match  "stale-dirty: DIRTY logged" "DIRTY.*wt-sdirty35" "$OUT"
assert_absent "stale-dirty: no RESET-STALE" "RESET-STALE" "$OUT"
assert_eq     "stale-dirty: HEAD unchanged" "$HEAD35_BEFORE" "$(git -C "$WT35" rev-parse HEAD)"
assert_eq     "stale-dirty: edit preserved" "$CONTENT35_BEFORE" "$(cat "$WT35/README.md")"

# ── Test 36: fleet: in-use stale copy → IN-USE, never RESET-STALE ─────────────
MAIN36="$(new_env)"
WT36="$(add_worktree "$MAIN36" "wt-sinuse36" stale-copy)"
WT36_REAL="$(cd "$WT36" && pwd -P)"
LOG36="$(fresh_log t36)"; LOCKD36="$(fresh_lockd t36)"
HEAD36_BEFORE="$(git -C "$WT36" rev-parse HEAD)"
run_with_repo "$MAIN36" "$LOG36" "$LOCKD36" \
    STUB_LSOF_LINE="lsof    999 user   3   DIR   $WT36_REAL" -- --force
assert_eq     "stale-inuse: exit 0" "0" "$ST"
assert_match  "stale-inuse: IN-USE logged" "IN-USE.*wt-sinuse36" "$OUT"
assert_absent "stale-inuse: no RESET-STALE" "RESET-STALE" "$OUT"
assert_eq     "stale-inuse: HEAD unchanged" "$HEAD36_BEFORE" "$(git -C "$WT36" rev-parse HEAD)"

# ── Test 37: only: stale copy → RESET-STALE, HEAD at origin, backup written ───
MAIN37="$(new_env)"
WT37="$(add_worktree "$MAIN37" "wt-stale37" stale-copy)"
HEAD37_BEFORE="$(git -C "$WT37" rev-parse HEAD)"
ORIGIN37="$(git -C "$MAIN37" rev-parse origin/wt-stale37)"
run_only "$WT37"
assert_eq "only: RESET-STALE stdout" "RESET-STALE" "$ONLY_OUT"
assert_eq "only: RESET-STALE exit 0" "0" "$ONLY_ST"
assert_eq "only: RESET-STALE HEAD at origin" "$ORIGIN37" "$(git -C "$WT37" rev-parse HEAD)"
assert_eq "only: RESET-STALE backup ref" "$HEAD37_BEFORE" \
    "$(git -C "$WT37" rev-parse --verify -q refs/wt-sync-backup/wt-stale37 2>/dev/null)"

# ── Test 38: only: --dry-run on stale copy reports, writes nothing ────────────
MAIN38="$(new_env)"
WT38="$(add_worktree "$MAIN38" "wt-stale38" stale-copy)"
HEAD38_BEFORE="$(git -C "$WT38" rev-parse HEAD)"
run_only "$WT38" --dry-run
assert_match "only-dry: stale state reported" "RESET-STALE" "$ONLY_OUT"
assert_eq    "only-dry: exit 0" "0" "$ONLY_ST"
assert_eq    "only-dry: HEAD unchanged" "$HEAD38_BEFORE" "$(git -C "$WT38" rev-parse HEAD)"
if git -C "$WT38" rev-parse --verify -q refs/wt-sync-backup/wt-stale38 >/dev/null 2>&1; then
    failcase "only-dry: backup ref written under --dry-run"
else
    pass "only-dry: no backup ref"
fi

# ── Test 39: fleet: stale copy (minimal fixture) → RESET-STALE, backup preserved ─
MAIN39="$(new_env)"
WT39="$(add_worktree "$MAIN39" "wt-stale39" stale)"
LOG39="$(fresh_log t39)"; LOCKD39="$(fresh_lockd t39)"
L_SHA39="$(git -C "$WT39" rev-parse HEAD)"
ORIGIN39="$(git -C "$MAIN39" rev-parse origin/wt-stale39)"
run_with_repo "$MAIN39" "$LOG39" "$LOCKD39" -- --force
assert_eq    "reset-stale: exit 0" "0" "$ST"
assert_eq    "reset-stale: HEAD at origin tip" "$ORIGIN39" "$(git -C "$WT39" rev-parse HEAD)"
assert_match "reset-stale: log has reset-stale=1" "reset-stale=1" "$(cat "$LOG39" 2>/dev/null)"
assert_match "reset-stale: RESET-STALE branch in log" "RESET-STALE branch=wt-stale39" \
    "$(cat "$LOG39" 2>/dev/null)"
assert_match "reset-stale: stdout has reset-stale" "reset-stale" "$OUT"
if git -C "$MAIN39" for-each-ref --contains "$L_SHA39" 2>/dev/null | grep -q .; then
    pass "reset-stale: backup ref reachable from pre-reset commit"
else
    failcase "reset-stale: backup ref not found for pre-reset commit"
fi

# ── Test 40: fleet: untracked file blocks stale reset → STRAGGLER ────────────
MAIN40="$(new_env)"
WT40="$(add_worktree "$MAIN40" "wt-stale40" stale)"
HEAD40_BEFORE="$(git -C "$WT40" rev-parse HEAD)"
printf 'x\n' > "$WT40/scratch.txt"
LOG40="$(fresh_log t40)"; LOCKD40="$(fresh_lockd t40)"
run_with_repo "$MAIN40" "$LOG40" "$LOCKD40" -- --force
assert_eq    "stale-untracked: exit 0" "0" "$ST"
assert_eq    "stale-untracked: HEAD unchanged" "$HEAD40_BEFORE" "$(git -C "$WT40" rev-parse HEAD)"
assert_match "stale-untracked: STRAGGLER reason=ahead in log" \
    "STRAGGLER branch=wt-stale40.*reason=ahead" "$(cat "$LOG40" 2>/dev/null)"
assert_match "stale-untracked: reset-stale=0" "reset-stale=0" "$(cat "$LOG40" 2>/dev/null)"
if [ -f "$WT40/scratch.txt" ]; then
    pass "stale-untracked: scratch.txt preserved"
else
    failcase "stale-untracked: scratch.txt removed"
fi

# ── Test 41: fleet: --dry-run on stale copy reports, writes nothing ──────────
MAIN41="$(new_env)"
WT41="$(add_worktree "$MAIN41" "wt-stale41" stale)"
HEAD41_BEFORE="$(git -C "$WT41" rev-parse HEAD)"
L_SHA41="$(git -C "$WT41" rev-parse HEAD)"
LOG41="$(fresh_log t41)"; LOCKD41="$(fresh_lockd t41)"
run_with_repo "$MAIN41" "$LOG41" "$LOCKD41" -- --force --dry-run
assert_eq    "stale-dry: exit 0" "0" "$ST"
assert_eq    "stale-dry: HEAD unchanged" "$HEAD41_BEFORE" "$(git -C "$WT41" rev-parse HEAD)"
assert_match "stale-dry: WOULD-RESET-STALE in stdout" "WOULD-RESET-STALE" "$OUT"
assert_match "stale-dry: 1 reset-stale in stdout" "1 reset-stale" "$OUT"
if git -C "$MAIN41" for-each-ref --contains "$L_SHA41" 2>/dev/null | grep -qF "refs/wt-sync-backup/"; then
    failcase "stale-dry: backup ref written under --dry-run"
else
    pass "stale-dry: no backup ref written"
fi

# ── Test 42: only: dirty stale copy → DIVERGED-DIRTY, HEAD/edit preserved ─────
MAIN42="$(new_env)"
WT42="$(add_worktree "$MAIN42" "wt-stale42" stale-copy)"
HEAD42_BEFORE="$(git -C "$WT42" rev-parse HEAD)"
printf 'dirty\n' >> "$WT42/README.md"
CONTENT42_BEFORE="$(cat "$WT42/README.md")"
run_only "$WT42"
assert_eq "only-dirty-stale: DIVERGED-DIRTY stdout" "DIVERGED-DIRTY" "$ONLY_OUT"
assert_eq "only-dirty-stale: exit 0" "0" "$ONLY_ST"
assert_eq "only-dirty-stale: HEAD unchanged" "$HEAD42_BEFORE" "$(git -C "$WT42" rev-parse HEAD)"
assert_eq "only-dirty-stale: tracked edit preserved" "$CONTENT42_BEFORE" "$(cat "$WT42/README.md")"
if git -C "$WT42" rev-parse --verify -q refs/wt-sync-backup/wt-stale42 >/dev/null 2>&1; then
    failcase "only-dirty-stale: backup ref written on dirty stale"
else
    pass "only-dirty-stale: no backup ref"
fi

# ── Test 43: only: untracked-file stale copy → DIVERGED-DIRTY ─────────────────
MAIN43="$(new_env)"
WT43="$(add_worktree "$MAIN43" "wt-stale43" stale-copy)"
HEAD43_BEFORE="$(git -C "$WT43" rev-parse HEAD)"
printf 'untracked\n' > "$WT43/untracked.txt"
run_only "$WT43"
assert_eq "only-untracked-stale: DIVERGED-DIRTY stdout" "DIVERGED-DIRTY" "$ONLY_OUT"
assert_eq "only-untracked-stale: exit 0" "0" "$ONLY_ST"
assert_eq "only-untracked-stale: HEAD unchanged" "$HEAD43_BEFORE" "$(git -C "$WT43" rev-parse HEAD)"
if [ -f "$WT43/untracked.txt" ]; then
    pass "only-untracked-stale: untracked file preserved"
else
    failcase "only-untracked-stale: untracked file removed"
fi
if git -C "$WT43" rev-parse --verify -q refs/wt-sync-backup/wt-stale43 >/dev/null 2>&1; then
    failcase "only-untracked-stale: backup ref written on untracked stale"
else
    pass "only-untracked-stale: no backup ref"
fi

# ── Test 44: only: backup failure → DIVERGED-CONFLICT, HEAD unchanged ────────
# Force a D/F collision: create a ref with the branch name as a directory
# component so refs/wt-sync-backup/<branch> can't be created as a file ref.
MAIN44="$(new_env)"
WT44="$(add_worktree "$MAIN44" "wt-stale44" stale-copy)"
HEAD44_BEFORE="$(git -C "$WT44" rev-parse HEAD)"
# Pre-create wt-stale44/child so wt-stale44 becomes a directory in the ref namespace
git -C "$WT44" update-ref "refs/wt-sync-backup/wt-stale44/child" HEAD >/dev/null 2>&1 || true
run_only "$WT44"
assert_eq "only-backup-fail: DIVERGED-CONFLICT stdout" "DIVERGED-CONFLICT" "$ONLY_OUT"
assert_eq "only-backup-fail: exit 0" "0" "$ONLY_ST"
assert_eq "only-backup-fail: HEAD unchanged" "$HEAD44_BEFORE" "$(git -C "$WT44" rev-parse HEAD)"
# Confirm no in-progress merge was left
if git -C "$WT44" rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    failcase "only-backup-fail: in-progress merge left"
else
    pass "only-backup-fail: no in-progress merge"
fi

# ── Test 45: only: existing reflog-less backup ref → DIVERGED-CONFLICT ────────
# Simulates the six live hand-made refs/wt-sync-backup/* that have no reflog.
# backup_and_reset must refuse; the existing backup SHA must stay unchanged.
MAIN45="$(new_env)"
WT45="$(add_worktree "$MAIN45" "wt-stale45" stale-copy)"
HEAD45_BEFORE="$(git -C "$WT45" rev-parse HEAD)"
SAVED45="$(git -C "$WT45" rev-parse refs/remotes/origin/wt-stale45)"
# Write a reflog-less backup ref: no --create-reflog, namespace not in
# core.logAllRefUpdates=true's auto-set (branches/remotes/notes only).
git -C "$WT45" update-ref "refs/wt-sync-backup/wt-stale45" "$SAVED45" >/dev/null 2>&1 || true
run_only "$WT45"
assert_eq "reflog-guard: DIVERGED-CONFLICT stdout" "DIVERGED-CONFLICT" "$ONLY_OUT"
assert_eq "reflog-guard: exit 0" "0" "$ONLY_ST"
assert_eq "reflog-guard: HEAD unchanged" "$HEAD45_BEFORE" "$(git -C "$WT45" rev-parse HEAD)"
assert_eq "reflog-guard: backup ref preserved" "$SAVED45" \
    "$(git -C "$WT45" rev-parse --verify -q refs/wt-sync-backup/wt-stale45 2>/dev/null)"

# ── Hook wrapper tests ────────────────────────────────────────────────────────
HOOK="$SCRIPT_DIR/hooks/wt-sync-session-start.sh"
# Create a synthetic git env with a linked worktree and a fake tick.
MAIN_HOOK="$(new_env)"
WT_HOOK="$(add_worktree "$MAIN_HOOK" "wt-hooktest" current)"
mkdir -p "$MAIN_HOOK/bin"
# Fake tick: ignores args, always emits CURRENT (tests hook routing, not tick logic).
cat > "$MAIN_HOOK/bin/wt-sync-tick" <<'SH'
#!/bin/sh
echo "CURRENT"
SH
chmod +x "$MAIN_HOOK/bin/wt-sync-tick"

# Row 1: linked worktree → verdict printed
HOOK_OUT1="$(CLAUDE_PROJECT_DIR="$WT_HOOK" PATH="$STUBBIN:$PATH" bash "$HOOK" 2>/dev/null || true)"
assert_match "hook: linked worktree yields wt-sync verdict" "^wt-sync: " "$HOOK_OUT1"
HOOK_ST1=0
CLAUDE_PROJECT_DIR="$WT_HOOK" PATH="$STUBBIN:$PATH" bash "$HOOK" >/dev/null 2>/dev/null || HOOK_ST1=$?
assert_eq "hook: linked worktree exits 0" "0" "$HOOK_ST1"

# Row 2: main checkout → silent
HOOK_OUT2="$(CLAUDE_PROJECT_DIR="$MAIN_HOOK" PATH="$STUBBIN:$PATH" bash "$HOOK" 2>/dev/null || true)"
assert_eq "hook: main checkout is silent" "" "$HOOK_OUT2"
HOOK_ST2=0
CLAUDE_PROJECT_DIR="$MAIN_HOOK" PATH="$STUBBIN:$PATH" bash "$HOOK" >/dev/null 2>/dev/null || HOOK_ST2=$?
assert_eq "hook: main checkout exits 0" "0" "$HOOK_ST2"

# Row 3a: non-git directory → silent, exit 0
HOOK_OUT3a="$(CLAUDE_PROJECT_DIR="$TMP" PATH="$STUBBIN:$PATH" bash "$HOOK" 2>/dev/null || true)"
assert_eq "hook: non-git dir is silent" "" "$HOOK_OUT3a"
HOOK_ST3a=0
CLAUDE_PROJECT_DIR="$TMP" PATH="$STUBBIN:$PATH" bash "$HOOK" >/dev/null 2>/dev/null || HOOK_ST3a=$?
assert_eq "hook: non-git dir exits 0" "0" "$HOOK_ST3a"

# Row 3b: tick not executable → silent, exit 0
chmod 0644 "$MAIN_HOOK/bin/wt-sync-tick"
HOOK_OUT3b="$(CLAUDE_PROJECT_DIR="$WT_HOOK" PATH="$STUBBIN:$PATH" bash "$HOOK" 2>/dev/null || true)"
assert_eq "hook: non-executable tick is silent" "" "$HOOK_OUT3b"
HOOK_ST3b=0
CLAUDE_PROJECT_DIR="$WT_HOOK" PATH="$STUBBIN:$PATH" bash "$HOOK" >/dev/null 2>/dev/null || HOOK_ST3b=$?
assert_eq "hook: non-executable tick exits 0" "0" "$HOOK_ST3b"
chmod +x "$MAIN_HOOK/bin/wt-sync-tick"   # restore

# ── Source-level anti-pattern row ─────────────────────────────────────────────
if grep -nE '(reset[[:space:]]+--hard|[[:space:]]stash[[:space:]]|[[:space:]]rebase[[:space:]]|push[[:space:]]+origin|git[[:space:]].*--force)' "$TICK" | grep -vE '^[0-9]+:[[:space:]]*#' | grep -v '# stale-copy-reset$'; then
    failcase "source-level: wt-sync-tick contains a forbidden git write verb"
else
    pass "source-level: no reset --hard / stash / rebase / push in the tick"
fi

# ── cron-setup hook flags ─────────────────────────────────────────────────────
HOOK_JSON="$("$CRON_SETUP" --print-hook 2>&1)"
if printf '%s\n' "$HOOK_JSON" | python3 -c \
    'import json,sys; d=json.load(sys.stdin); assert d["hooks"][0]["command"].endswith("wt-sync-session-start.sh")' \
    2>/dev/null; then
    pass "cron-setup: --print-hook emits valid JSON with correct command"
else
    failcase "cron-setup: --print-hook JSON invalid or command wrong (got: $HOOK_JSON)"
fi
INVALID_ST=0
INVALID_OUT="$("$CRON_SETUP" --invalid-flag 2>&1)" || INVALID_ST=$?
if [ "$INVALID_ST" -ne 0 ] && printf '%s\n' "$INVALID_OUT" | grep -q "Unknown option"; then
    pass "cron-setup: --invalid-flag exits non-zero with Unknown option"
else
    failcase "cron-setup: --invalid-flag did not exit non-zero or missing 'Unknown option' (got: $INVALID_OUT)"
fi

# ── Final report ──────────────────────────────────────────────────────────────
echo ""
if [ "$FAILED" -eq 0 ]; then
    echo "All tests passed."
    exit 0
else
    echo "${FAILED} test(s) FAILED."
    exit 1
fi
