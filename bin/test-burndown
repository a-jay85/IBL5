#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-burndown — offline harness for bin/backlog burndown* subcommands.
set -uo pipefail

PASS=0
FAIL=0
FAILURES=()

ok()   { printf '[PASS] %s\n' "$1"; PASS=$((PASS + 1)); }
fail() { printf '[FAIL] %s\n' "$1"; FAIL=$((FAIL + 1)); FAILURES+=("$1"); }
want() {
    local label="$1" output="$2" token="$3"
    if grep -qF -- "$token" <<< "$output"; then
        ok "$label"
    else
        fail "$label (missing: $token)"
    fi
}

SCRIPT="$(cd "$(dirname "$0")" && pwd)/backlog"

T="$(mktemp -d)"
trap 'rm -rf "$T"' EXIT

mkdir -p "$T/home" "$T/fx"

# gh stub: dispatches by args
cat > "$T/gh" <<'STUB'
#!/usr/bin/env bash
set -uo pipefail
# Log the invocation (every test can inspect $T/gh.log)
printf '%s\n' "$*" >> "${GH_LOG:-/dev/null}"
if [ -n "${GH_FAIL_ON:-}" ]; then
    if grep -qF -- "$GH_FAIL_ON" <<< "$*"; then
        exit 1
    fi
fi
# Dispatch
case "$*" in
    *"issue list"*) cat "${GH_FX_DIR:-/dev/null}/issues.json" 2>/dev/null || echo '[]' ;;
    *"pr list"*"--state open"*) cat "${GH_FX_DIR:-/dev/null}/prs-open.json" 2>/dev/null || echo '[]' ;;
    *"pr list"*"--head "*)
        SLUG=$(printf '%s' "$*" | sed 's/.*--head //' | awk '{print $1}')
        cat "${GH_FX_DIR:-/dev/null}/pr-${SLUG}.json" 2>/dev/null || echo '[]'
        ;;
    *"issue view"*)
        NUM=$(printf '%s' "$*" | awk '{for(i=1;i<=NF;i++) if($i=="view") print $(i+1)}')
        cat "${GH_FX_DIR:-/dev/null}/issue-${NUM}.json" 2>/dev/null || echo '{}'
        ;;
    *"issue close"*) exit 0 ;;
    *) exit 0 ;;
esac
STUB
chmod +x "$T/gh"

# git stub: porcelain worktree list
cat > "$T/git" <<'STUB'
#!/usr/bin/env bash
case "$*" in
    *"worktree list --porcelain"*)
        cat "${GH_FX_DIR:-/dev/null}/worktrees.txt" 2>/dev/null || true
        ;;
    *) exec git "$@" ;;
esac
STUB
chmod +x "$T/git"

# tier stub: xhigh for XHIGH, exit 1 for TIERFAIL, else default
cat > "$T/tier" <<'STUB'
#!/usr/bin/env bash
case "$*" in
    *XHIGH*) echo "xhigh" ;;
    *TIERFAIL*) exit 1 ;;
    *) echo "default" ;;
esac
STUB
chmod +x "$T/tier"

# Helper: run bin/backlog burndown* with all stubs and HOME pointing at $T/home
bd() {
    GH_LOG="$T/gh.log" GH_FX_DIR="$T/fx" \
    BACKLOG_GH="$T/gh" BURNDOWN_GIT="$T/git" BURNDOWN_TIER_HINT="$T/tier" \
    HOME="$T/home" \
    "$SCRIPT" "$@"
}

# Helper: run bin/backlog with all stubs and an explicit HOME (sweep tests use a
# private HOME so the shared $T/home ledgers never leak into their walk).
bd_home() {
    local h="$1"; shift
    GH_LOG="$T/gh.log" GH_FX_DIR="$T/fx" \
    BACKLOG_GH="$T/gh" BURNDOWN_GIT="$T/git" BURNDOWN_TIER_HINT="$T/tier" \
    HOME="$h" TZ=UTC \
    "$SCRIPT" "$@"
}

# ── C1: --help lists new subcommands ──────────────────────────────────────────
OUT="$("$SCRIPT" --help 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "--help exits 0" || fail "--help exits 0 (got $RC)"
want "--help: burndown-status listed" "$OUT" "burndown-status"
want "--help: burndown-close-merged listed" "$OUT" "burndown-close-merged"

# ── C2: unknown burndown subcommand rejected ──────────────────────────────────
OUT="$(bd burndown-bogus 2>&1)"; RC=$?
[ "$RC" -eq 2 ] && ok "unknown subcommand exits 2" || fail "unknown subcommand exits 2 (got $RC)"
want "unknown subcommand: message" "$OUT" "unknown burndown subcommand"

# ── C3: --dry-run rejected for burndown ──────────────────────────────────────
OUT="$(bd --dry-run burndown 2>&1)"; RC=$?
[ "$RC" -eq 2 ] && ok "--dry-run rejected exits 2" || fail "--dry-run rejected exits 2 (got $RC)"
want "--dry-run rejected: message" "$OUT" "--dry-run is not supported"
# gh must not have been called
if [ ! -f "$T/gh.log" ] || [ ! -s "$T/gh.log" ]; then
    ok "--dry-run: no gh call"
else
    fail "--dry-run: no gh call (gh.log non-empty)"
fi

# ── C4: missing HOME fails closed ─────────────────────────────────────────────
OUT="$(env -u HOME BACKLOG_GH="$T/gh" "$SCRIPT" burndown-status 2>&1)"; RC=$?
[ "$RC" -eq 3 ] && ok "missing HOME exits 3" || fail "missing HOME exits 3 (got $RC)"
want "missing HOME: message" "$OUT" "HOME is unset"
# gh must not have been called when HOME unset
GH_LOG_EMPTY=0
if [ ! -f "$T/gh.log" ] || [ ! -s "$T/gh.log" ]; then GH_LOG_EMPTY=1; fi
[ "$GH_LOG_EMPTY" -eq 1 ] && ok "missing HOME: no gh call" || fail "missing HOME: no gh call (gh.log non-empty)"

# ── Phase 2: report loading and delta extraction ──────────────────────────────
mkdir -p "$T/home/claude-plans/_reports"

# ── C5: missing report aborts before gh call (run BEFORE fixture exists) ──────
rm -f "$T/gh.log"
OUT="$(bd burndown-delta 2>&1)"; RC=$?
[ "$RC" -eq 3 ] && ok "C5: missing report exits 3" || fail "C5: missing report exits 3 (got $RC)"
want "C5: missing report: message" "$OUT" "no triage report"
if ! grep -q "issue list" "$T/gh.log" 2>/dev/null; then
    ok "C5: missing report: no gh issue list call"
else
    fail "C5: missing report: no gh issue list call (called anyway)"
fi

# Fixture report — used by C6-C13
cat > "$T/home/claude-plans/_reports/backlog-triage-2026-09-26.md" <<'REPORT'
# Backlog triage 2026-09-26

## P2 (2)

- [#10](https://github.com/a-jay85/IBL5-backlog/issues/10) Issue ten — rationale ten
- [#11](https://github.com/a-jay85/IBL5-backlog/issues/11) Issue eleven — rationale eleven

## P3 (1)

- [#12](https://github.com/a-jay85/IBL5-backlog/issues/12) Issue twelve — rationale twelve

## Notes

- [#99](https://github.com/a-jay85/IBL5-backlog/issues/99) unranked note — should not rank

## P5 (0)

REPORT
touch -t 202609260000 "$T/home/claude-plans/_reports/backlog-triage-2026-09-26.md"

# Fixture open issues
cat > "$T/fx/issues.json" <<'JSON'
[
  {"number":10,"title":"Issue ten","body":"","url":"u10","updatedAt":"2026-09-01T00:00:00Z","labels":[]},
  {"number":11,"title":"Issue eleven","body":"","url":"u11","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":12,"title":"Issue twelve","body":"","url":"u12","updatedAt":"2026-09-01T00:00:00Z","labels":[]},
  {"number":13,"title":"Issue thirteen","body":"","url":"u13","updatedAt":"2026-09-01T00:00:00Z","labels":[]},
  {"number":99,"title":"Unranked note","body":"","url":"u99","updatedAt":"2026-09-01T00:00:00Z","labels":[]}
]
JSON

# ── C6: delta happy path (stdout only — stderr carries the debug line) ────────
rm -f "$T/gh.log"
OUT="$(bd burndown-delta 2>/dev/null)"; RC=$?
[ "$RC" -eq 0 ] && ok "C6: delta exits 0" || fail "C6: delta exits 0 (got $RC)"
NUMS="$(jq -c '[.issues[].number]' <<< "$OUT" 2>/dev/null)"
[ "$NUMS" = "[11,13,99]" ] && ok "C6: delta issues [11,13,99]" || fail "C6: delta issues [11,13,99] (got $NUMS)"
DROPPED="$(jq -c '.dropped' <<< "$OUT" 2>/dev/null)"
[ "$DROPPED" = "[]" ] && ok "C6: delta dropped []" || fail "C6: delta dropped [] (got $DROPPED)"

# ── C7: awk boundaries and dropped ────────────────────────────────────────────
cat > "$T/fx/issues.json" <<'JSON'
[
  {"number":10,"title":"Issue ten","body":"","url":"u10","updatedAt":"2026-09-01T00:00:00Z","labels":[]},
  {"number":11,"title":"Issue eleven","body":"","url":"u11","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":13,"title":"Issue thirteen","body":"","url":"u13","updatedAt":"2026-09-01T00:00:00Z","labels":[]},
  {"number":99,"title":"Unranked note","body":"","url":"u99","updatedAt":"2026-09-01T00:00:00Z","labels":[]}
]
JSON
OUT="$(bd burndown-delta 2>/dev/null)"; RC=$?
[ "$RC" -eq 0 ] && ok "C7: delta with dropped exits 0" || fail "C7: delta with dropped exits 0 (got $RC)"
DROPPED="$(jq -c '.dropped' <<< "$OUT" 2>/dev/null)"
[ "$DROPPED" = "[12]" ] && ok "C7: dropped=[12]" || fail "C7: dropped=[12] (got $DROPPED)"
# Restore issues
cat > "$T/fx/issues.json" <<'JSON'
[
  {"number":10,"title":"Issue ten","body":"","url":"u10","updatedAt":"2026-09-01T00:00:00Z","labels":[]},
  {"number":11,"title":"Issue eleven","body":"","url":"u11","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":12,"title":"Issue twelve","body":"","url":"u12","updatedAt":"2026-09-01T00:00:00Z","labels":[]},
  {"number":13,"title":"Issue thirteen","body":"","url":"u13","updatedAt":"2026-09-01T00:00:00Z","labels":[]},
  {"number":99,"title":"Unranked note","body":"","url":"u99","updatedAt":"2026-09-01T00:00:00Z","labels":[]}
]
JSON

# ── C8: gh failure aborts ─────────────────────────────────────────────────────
OUT="$(GH_FAIL_ON="issue list" GH_LOG="$T/gh.log" GH_FX_DIR="$T/fx" \
    BACKLOG_GH="$T/gh" BURNDOWN_GIT="$T/git" BURNDOWN_TIER_HINT="$T/tier" \
    HOME="$T/home" "$SCRIPT" burndown-delta 2>&1)"; RC=$?
[ "$RC" -eq 3 ] && ok "C8: gh failure exits 3" || fail "C8: gh failure exits 3 (got $RC)"
want "C8: gh failure message" "$OUT" "gh issue list failed"

# ── C9: malformed report (headings only) ──────────────────────────────────────
cat > "$T/home/claude-plans/_reports/backlog-triage-2026-09-27.md" <<'REPORT'
# Backlog triage

## P2 (0)

## P3 (0)
REPORT
touch -t 202609270000 "$T/home/claude-plans/_reports/backlog-triage-2026-09-27.md"
OUT="$(bd burndown-delta 2>&1)"; RC=$?
[ "$RC" -eq 3 ] && ok "C9: malformed report exits 3" || fail "C9: malformed report exits 3 (got $RC)"
want "C9: malformed report message" "$OUT" "no ranked lines"
rm -f "$T/home/claude-plans/_reports/backlog-triage-2026-09-27.md"

# ── C10: duplicate rank aborts ────────────────────────────────────────────────
cat > "$T/home/claude-plans/_reports/backlog-triage-2026-09-27.md" <<'REPORT'
# Backlog triage

## P2 (2)

- [#10](https://github.com/a-jay85/IBL5-backlog/issues/10) Issue ten — dup
- [#10](https://github.com/a-jay85/IBL5-backlog/issues/10) Issue ten again — dup

## P3 (1)

- [#12](https://github.com/a-jay85/IBL5-backlog/issues/12) Issue twelve — ok
REPORT
touch -t 202609270000 "$T/home/claude-plans/_reports/backlog-triage-2026-09-27.md"
OUT="$(bd burndown-delta 2>&1)"; RC=$?
[ "$RC" -eq 3 ] && ok "C10: duplicate rank exits 3" || fail "C10: duplicate rank exits 3 (got $RC)"
want "C10: duplicate rank message" "$OUT" "ranks #10 twice"
rm -f "$T/home/claude-plans/_reports/backlog-triage-2026-09-27.md"

# ── C11: newest report wins ────────────────────────────────────────────────────
cp "$T/home/claude-plans/_reports/backlog-triage-2026-09-26.md" \
   "$T/home/claude-plans/_reports/backlog-triage-2026-09-20.md"
touch -t 202609200000 "$T/home/claude-plans/_reports/backlog-triage-2026-09-20.md"
echo "# notes" > "$T/home/claude-plans/_reports/backlog-triage-notes.md"
OUT="$(bd burndown-delta 2>/dev/null)"; RC=$?
[ "$RC" -eq 0 ] && ok "C11: newest report exits 0" || fail "C11: newest report exits 0 (got $RC)"
REPORT_PATH="$(jq -r '.report' <<< "$OUT" 2>/dev/null)"
if grep -qF "backlog-triage-2026-09-26.md" <<< "$REPORT_PATH"; then
    ok "C11: newest report selected"
else
    fail "C11: newest report selected (got $REPORT_PATH)"
fi
rm -f "$T/home/claude-plans/_reports/backlog-triage-2026-09-20.md" \
      "$T/home/claude-plans/_reports/backlog-triage-notes.md"

# ── C12: truncation guard ─────────────────────────────────────────────────────
jq -n '[range(1000) | {number: ., title: "t", body: "", url: "u", updatedAt: "2026-09-27T00:00:00Z", labels: []}]' \
    > "$T/fx/issues.json"
OUT="$(bd burndown-delta 2>&1)"; RC=$?
[ "$RC" -eq 3 ] && ok "C12: truncation guard exits 3" || fail "C12: truncation guard exits 3 (got $RC)"
want "C12: truncation guard message" "$OUT" "may be truncated"
# Restore issues
cat > "$T/fx/issues.json" <<'JSON'
[
  {"number":10,"title":"Issue ten","body":"","url":"u10","updatedAt":"2026-09-01T00:00:00Z","labels":[]},
  {"number":11,"title":"Issue eleven","body":"","url":"u11","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":12,"title":"Issue twelve","body":"","url":"u12","updatedAt":"2026-09-01T00:00:00Z","labels":[]},
  {"number":13,"title":"Issue thirteen","body":"","url":"u13","updatedAt":"2026-09-01T00:00:00Z","labels":[]},
  {"number":99,"title":"Unranked note","body":"","url":"u99","updatedAt":"2026-09-01T00:00:00Z","labels":[]}
]
JSON

# ── C13: arity check ─────────────────────────────────────────────────────────
OUT="$(bd burndown-delta extra 2>&1)"; RC=$?
[ "$RC" -eq 2 ] && ok "C13: arity exits 2" || fail "C13: arity exits 2 (got $RC)"
want "C13: arity message" "$OUT" "takes no arguments"

# ── Phase 3: in-flight filter, cost, and selection (burndown) ─────────────────

# Phase 3 report (newer than Phase 2, picked by bd_latest_report)
cat > "$T/home/claude-plans/_reports/backlog-triage-2026-09-28.md" <<'REPORT'
# Phase 3 triage

## P2 (many)

- [#21](u21) Twenty-one — ref
- [#22](u22) Twenty-two — ref
- [#23](u23) Twenty-three — ref
- [#24](u24) Twenty-four — ref
- [#25](u25) Twenty-five — ref
- [#26](u26) Twenty-six — ref
- [#30](u30) Thirty — ref
- [#31](u31) Thirty-one — ref
- [#35](u35) Thirty-five noref — ref
- [#40](u40) Forty stale — ref
- [#50](u50) Fifty — ref
- [#51](u51) Fifty-one — ref
- [#60](u60) XHIGH a sixty — ref
- [#61](u61) Sixty-one — ref
- [#62](u62) Sixty-two — ref
- [#63](u63) XHIGH b sixty-three — ref
- [#64](u64) Sixty-four — ref
- [#16](u16) TIERFAIL issue sixteen — ref
- [#100](u100) Hundred — ref
- [#101](u101) Hundred-one — ref
- [#102](u102) Hundred-two — ref
- [#103](u103) Hundred-three — ref
- [#104](u104) Hundred-four — ref
- [#105](u105) Hundred-five — ref

## P1 (1)

- [#70](u70) P1 issue seventy — p1 reason
REPORT
touch -t 202609280000 "$T/home/claude-plans/_reports/backlog-triage-2026-09-28.md"

# Default fixtures: empty PRs and worktrees for burndown tests
echo '[]' > "$T/fx/prs-open.json"
touch "$T/fx/worktrees.txt"

# Helper: run burndown (not delta) — cleans up any ledger from a prior call
# shellcheck disable=SC2120
bd_b() {
    # Only remove timestamp ledgers (20XXXXXXTXXXXXX.json), not named fixtures
    rm -f "$T/home/claude-plans/_reports"/burndown-batch-[0-9]*.json
    bd burndown "$@"
}

# ── C14: budget fill ──────────────────────────────────────────────────────────
# 6 P2 issues with distinct paths; 5 fit, 6th is over budget
cat > "$T/fx/issues.json" <<'JSON'
[
  {"number":100,"title":"Hundred","body":"bin/a:1 title thing","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":101,"title":"Hundred-one","body":"bin/b:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":102,"title":"Hundred-two","body":"bin/c:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":103,"title":"Hundred-three","body":"bin/d:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":104,"title":"Hundred-four","body":"bin/e:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":105,"title":"Hundred-five","body":"bin/f:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]}
]
JSON
OUT="$(bd_b 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "C14: fill exits 0" || fail "C14: fill exits 0 (got $RC)"
PICK_COUNT=$(grep -cE '^PICK' <<< "$OUT" || true)
[ "$PICK_COUNT" -eq 5 ] && ok "C14: 5 PICK rows" || fail "C14: 5 PICK rows (got $PICK_COUNT)"
want "C14: units 5/5" "$OUT" "units: 5/5"

# ── C15: xhigh + skip-continue ───────────────────────────────────────────────
# P2 order: XHIGH #60(cost2), #61(1), #62(1), XHIGH #63(cost2 skip), #64(1 fits)
cat > "$T/fx/issues.json" <<'JSON'
[
  {"number":60,"title":"XHIGH a sixty","body":"bin/aa:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":61,"title":"Sixty-one","body":"bin/bb:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":62,"title":"Sixty-two","body":"bin/cc:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":63,"title":"XHIGH b sixty-three","body":"bin/dd:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":64,"title":"Sixty-four","body":"bin/ee:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]}
]
JSON
OUT="$(bd_b 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "C15: xhigh exits 0" || fail "C15: xhigh exits 0 (got $RC)"
# #60 picked, #63 skipped over budget, #64 picked (continue not break)
want "C15: #60 PICK" "$OUT" "PICK  #60"
want "C15: #63 SKIP over budget" "$OUT" "over budget"
want "C15: #64 PICK" "$OUT" "PICK  #64"
# Mutation guard: #64 must be present (continue, not break)
grep -qE 'PICK\s+#64' <<< "$OUT" && ok "C15: #64 reached (continue)" || fail "C15: #64 reached (continue)"

# ── C16: tier failure costs 1 ─────────────────────────────────────────────────
cat > "$T/fx/issues.json" <<'JSON'
[{"number":16,"title":"TIERFAIL issue sixteen","body":"bin/tierfail:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]}]
JSON
OUT="$(bd_b 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "C16: tier fail exits 0" || fail "C16: tier fail exits 0 (got $RC)"
want "C16: tier=error in detail" "$OUT" "tier=error"
grep -qE 'PICK\s+#16\s+\S+\s+1' <<< "$OUT" && ok "C16: cost=1 on tier fail" || fail "C16: cost=1 on tier fail"

# ── C17: in-flight, one per source ────────────────────────────────────────────
# Six issues #21-#26; #21-#25 each blocked by a different source; #26 PICK
cat > "$T/fx/issues.json" <<'JSON'
[
  {"number":21,"title":"Twenty-one","body":"bin/s1:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":22,"title":"Twenty-two","body":"bin/s2:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":23,"title":"Twenty-three","body":"bin/s3:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":24,"title":"Twenty-four","body":"bin/s4:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":25,"title":"Twenty-five","body":"bin/s5:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]},
  {"number":26,"title":"Twenty-six","body":"bin/s6:1 stuff","url":"u","updatedAt":"2026-09-27T00:00:00Z","labels":[]}
]
JSON
# Source 1: PR body names #21
cat > "$T/fx/prs-open.json" <<'JSON'
[{"number":901,"body":"Closes a-jay85/IBL5-backlog#21 bin/foo:1"}]
JSON
# Source 2: plan file names #22 (put in BD_PLANS_DIR = $T/home/claude-plans)
cat > "$T/home/claude-plans/some-feature.md" <<'PLAN'
# Some feature plan
IBL5-backlog#22 is the tracking issue
PLAN
# Source 3: queue symlink → file naming #23
mkdir -p "$T/home/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/automouse/queue"
cat > "$T/home/elsewhere.md" <<'QF'
# Queue plan
IBL5-backlog#23 needs doing
QF
ln -sf "$T/home/elsewhere.md" "$T/home/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/automouse/queue/some-task.md"
# Live queues hold subdirectories (done/, <entry>.lock/); they are not entries
mkdir -p "$T/home/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/automouse/queue/done" \
    "$T/home/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/automouse/queue/some-task.md.lock"
# Source 4: ledger with #24 status=queued (in-flight)
cat > "$T/home/claude-plans/_reports/burndown-batch-test.json" <<'LEDGER'
{"items":[
  {"issue_num":24,"also_closes":[],"slug":"wt-24","status":"queued","route":"plan","pr_url":"","units_used":1}
]}
LEDGER
# Source 5: ledger item #25 slug=wt-25, status=skipped; worktree branch wt-25 exists
# Rewrite ledger to include both items
cat > "$T/home/claude-plans/_reports/burndown-batch-test.json" <<'LEDGER'
{"items":[
  {"issue_num":24,"also_closes":[],"slug":"wt-24","status":"queued","route":"plan","pr_url":"","units_used":1},
  {"issue_num":25,"also_closes":[],"slug":"wt-25","status":"skipped","route":"ad-hoc","pr_url":"","units_used":1}
]}
LEDGER
# Worktree fixture has branch wt-25
cat > "$T/fx/worktrees.txt" <<'WT'
worktree /some/path
HEAD abc123
branch refs/heads/wt-25

WT
# Boundary: plan names #260 (NOT #26)
cat > "$T/home/claude-plans/boundary-plan.md" <<'BPLAN'
# Boundary
IBL5-backlog#260 is the issue
BPLAN
OUT="$(bd_b 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "C17: in-flight exits 0" || fail "C17: in-flight exits 0 (got $RC)"
want "C17: #21 SKIP open PR" "$OUT" "open PR"
want "C17: #22 SKIP plan" "$OUT" "plan some-feature.md"
want "C17: #23 SKIP queue" "$OUT" "automouse queue some-task.md"
want "C17: #24 SKIP ledger" "$OUT" "ledger burndown-batch-test.json (queued)"
