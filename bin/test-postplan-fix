# 46 (a session that retitles, adds human-approved and arms auto-merge, then ends "blocked",
# is caught and repaired: the pr-state guard runs on every marker outcome)
printf 'SUMMARY: blocked\nHOLDREPEAT_FIX: blocked could not do it\n' > "$TMP/reply-hr-blocked"
{ cat "$TMP/effects/hr-fix.sh"; printf 'printf "Other title\\tbug,human-approved\\tyes\\n" > "%s"\n' "$TMP/gh.snap.after"; } > "$TMP/effects/hr-prall.sh"
if should_run "holdrepeat-pr-state-every-outcome"; then
for HR_END in blocked nomarker nothing gate; do
    hr_reset
    export CLAUDE_STUB_REPLY="$TMP/reply-hr-$HR_END" CLAUDE_STUB_EFFECT="$TMP/effects/hr-prall.sh"
    hr_run
    need "$HR_END: rc 21" test "$RC" = 21
    need "$HR_END: final line" final_is "$STDOUT" gave-up-pr-state
    need "$HR_END: title restored" gh_has "--title Fix widget"
    need "$HR_END: label removed" gh_has "--remove-label human-approved"
    need "$HR_END: auto-merge disabled" gh_has "--disable-auto"
    need "$HR_END: DM names pr-state" dm_has "rejected by pr-state"
    need "$HR_END: worktree clean" wt_clean
    need "$HR_END: no post-plan call" no_ppn
done
case_end holdrepeat-pr-state-every-outcome
fi

# 47 (a session that commits AND retitles still gets its PR state repaired)
if should_run "holdrepeat-refs-and-pr-state"; then
hr_reset
{ cat "$TMP/effects/hr-commit.sh"; printf 'printf "Other title\\tbug\\tno\\n" > "%s"\n' "$TMP/gh.snap.after"; } > "$TMP/effects/hr-commit-title.sh"
export CLAUDE_STUB_REPLY="$TMP/reply-hr-blocked" CLAUDE_STUB_EFFECT="$TMP/effects/hr-commit-title.sh"
hr_run
need "rc 21" test "$RC" = 21
need "title restored" gh_has "--title Fix widget"
need "HEAD restored" head_is_tip
need "origin unchanged" origin_is_tip
case_end holdrepeat-refs-and-pr-state
fi

# 47b (a session that merges, closes or gets the PR reviewed is caught: the snapshot reads
# state, reviewDecision and mergedAt. JSON fixtures run the launcher's real --json/--jq.)
HR_PRJSON='{"title":"Fix widget","labels":[{"name":"bug"}],"autoMergeRequest":null,"baseRefName":"master","isDraft":false,"state":"OPEN","reviewDecision":"REVIEW_REQUIRED","mergedAt":null,"body":"x"}'
jq -c '.state = "MERGED"' <<< "$HR_PRJSON" > "$TMP/snap-merged.json"
jq -c '.state = "CLOSED"' <<< "$HR_PRJSON" > "$TMP/snap-closed.json"
jq -c '.reviewDecision = "APPROVED"' <<< "$HR_PRJSON" > "$TMP/snap-approved.json"
jq -c '.mergedAt = "2026-10-24T12:00:00Z"' <<< "$HR_PRJSON" > "$TMP/snap-mergedat.json"
if should_run "holdrepeat-pr-state-merge-review"; then
for HR_SNAP in merged closed approved mergedat; do
    hr_reset
    printf '%s\n' "$HR_PRJSON" > "$TMP/gh.snap.before.json"
    { cat "$TMP/effects/hr-fix.sh"; printf 'cp "%s" "%s"\n' "$TMP/snap-$HR_SNAP.json" "$TMP/gh.snap.after.json"; } > "$TMP/effects/hr-snap.sh"
    export CLAUDE_STUB_REPLY="$TMP/reply-hr-fixed" CLAUDE_STUB_EFFECT="$TMP/effects/hr-snap.sh"
    hr_run
    need "$HR_SNAP: rc 21" test "$RC" = 21
    need "$HR_SNAP: final line" final_is "$STDOUT" gave-up-pr-state
    need "$HR_SNAP: DM names the field group" dm_has "base, draft, state, review, merge or body changed"
    need "$HR_SNAP: origin unchanged" origin_is_tip
    need "$HR_SNAP: no post-plan call" no_ppn
done
# Control: an unchanged JSON snapshot still lets a real fix through.
hr_reset
printf '%s\n' "$HR_PRJSON" > "$TMP/gh.snap.before.json"
{ cat "$TMP/effects/hr-fix.sh"; printf 'printf "%%s\\n" %q > "%s"\n' "$HR_PRJSON" "$TMP/gh.snap.after.json"; } > "$TMP/effects/hr-snap.sh"
export CLAUDE_STUB_REPLY="$TMP/reply-hr-fixed" CLAUDE_STUB_EFFECT="$TMP/effects/hr-snap.sh"
hr_run
need "unchanged: rc 0 (stderr: $ERR)" test "$RC" = 0
need "unchanged: final line" final_is "$STDOUT" fixed
case_end holdrepeat-pr-state-merge-review
fi

# 47c (any label change rejects; a removed hold label goes back, an added arming label comes off)
if should_run "holdrepeat-pr-state-any-label"; then
hr_reset
printf 'Fix widget\tbug,pipeline-authored\tno\n' > "$TMP/gh.snap.before"
{ cat "$TMP/effects/hr-fix.sh"; printf 'printf "Fix widget\\tbug\\tno\\n" > "%s"\n' "$TMP/gh.snap.after"; } > "$TMP/effects/hr-unlabel.sh"
export CLAUDE_STUB_REPLY="$TMP/reply-hr-fixed" CLAUDE_STUB_EFFECT="$TMP/effects/hr-unlabel.sh"
hr_run
need "removed hold: rc 21" test "$RC" = 21
need "removed hold: final line" final_is "$STDOUT" gave-up-pr-state
need "removed hold: label put back" gh_has "--add-label pipeline-authored"
need "removed hold: DM names labels" dm_has "labels changed"
hr_reset
{ cat "$TMP/effects/hr-fix.sh"; printf 'printf "Fix widget\\tauto-mergeable,bug\\tno\\n" > "%s"\n' "$TMP/gh.snap.after"; } > "$TMP/effects/hr-amlabel.sh"
export CLAUDE_STUB_REPLY="$TMP/reply-hr-fixed" CLAUDE_STUB_EFFECT="$TMP/effects/hr-amlabel.sh"
hr_run
need "auto-mergeable: rc 21" test "$RC" = 21
need "auto-mergeable: final line" final_is "$STDOUT" gave-up-pr-state
need "auto-mergeable: label removed" gh_has "--remove-label auto-mergeable"
case_end holdrepeat-pr-state-any-label
fi

# 47d (a session that pushes straight to origin master is caught; a GitHub-committed master
# move during the session is a normal merge and passes)
HR_MASTER_ORIG=$(git --git-dir="$TMP/origin.git" rev-parse refs/heads/master)
cat > "$TMP/effects/hr-masterpush.sh" <<'EFFEOF'
git fetch -q origin master
sha=$(git commit-tree "origin/master^{tree}" -p origin/master -m direct)
git push -q origin "$sha:refs/heads/master"
EFFEOF
if should_run "holdrepeat-master-direct-push"; then
hr_reset
{ cat "$TMP/effects/hr-fix.sh"; cat "$TMP/effects/hr-masterpush.sh"; } > "$TMP/effects/hr-master.sh"
export CLAUDE_STUB_REPLY="$TMP/reply-hr-blocked" CLAUDE_STUB_EFFECT="$TMP/effects/hr-master.sh"
hr_run
git --git-dir="$TMP/origin.git" update-ref refs/heads/master "$HR_MASTER_ORIG"
need "direct push: rc 21" test "$RC" = 21
need "direct push: final line" final_is "$STDOUT" gave-up-master-push
need "direct push: DM names it" dm_has "origin/master got a direct push"
need "direct push: no post-plan call" no_ppn
hr_reset
{ cat "$TMP/effects/hr-fix.sh"; printf 'export GIT_COMMITTER_EMAIL=noreply@github.com\n'; cat "$TMP/effects/hr-masterpush.sh"; } > "$TMP/effects/hr-master.sh"
export CLAUDE_STUB_REPLY="$TMP/reply-hr-fixed" CLAUDE_STUB_EFFECT="$TMP/effects/hr-master.sh"
hr_run
git --git-dir="$TMP/origin.git" update-ref refs/heads/master "$HR_MASTER_ORIG"
need "github merge: rc 0 (stderr: $ERR)" test "$RC" = 0
need "github merge: final line" final_is "$STDOUT" fixed
case_end holdrepeat-master-direct-push
fi

# 48 (a ~/.claude/hooks edit behind a "blocked" ending is caught)
if should_run "holdrepeat-user-hook-blocked"; then
hr_reset
{ cat "$TMP/effects/hr-fix.sh"; printf 'printf "x\\n" > "%s/.claude/hooks/sneaky.sh"\n' "$HOME"; } > "$TMP/effects/hr-hook.sh"
export CLAUDE_STUB_REPLY="$TMP/reply-hr-blocked" CLAUDE_STUB_EFFECT="$TMP/effects/hr-hook.sh"
