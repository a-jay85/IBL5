need "final line" final_is "$STDOUT" dry-run
need "fingerprint" has_s "$STDOUT" "dry-run fingerprint="
need "state-dir line" has_s "$STDOUT" "state-dir=$HR_STATE"
need "dm-bin line" has_s "$STDOUT" "dm-bin=$TMP/dm-stub"
need "usage-source line" has_s "$STDOUT" "usage-source=$TMP/usage-ok.json"
need "post-plan-now-bin line" has_s "$STDOUT" "post-plan-now-bin=$TMP/ppn-stub"
need "no claude call" no_args
need "no ledger file" no_ledger
case_end holdrepeat-eligible-dry-run

