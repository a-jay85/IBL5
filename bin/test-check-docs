#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

# Test harness for bin/check-docs: checkSkillDraftPlaceholder() (tests 1-4) and
# the iterChangedDocs() local-date fallback (tests 5-6), and the engine
# lint-pin drift cases (pin A-C).
# Follows bin/test-check-plan style.
#
# Each fixture is a minimal git repo so bin/check-docs can locate the root.
# Assertions check for the specific FAIL label in output, not bare exit code,
# because a sparse fixture may trip unrelated checks.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REAL_SCRIPT="$SCRIPT_DIR/check-docs"

label_present() {   grep -qF 'skill DRAFT= command-substitution' <<< "$1"; }
label_absent()  { ! grep -qF 'skill DRAFT= command-substitution' <<< "$1"; }

pass() { h_pass "$1"; }
fail() { h_fail "$@"; }
skip() { echo "SKIP: $1"; }

make_repo() {
    local repo
    repo=$(mktemp -d)
    git -C "$repo" init -q
    git -C "$repo" config user.email "test@example.com"
    git -C "$repo" config user.name "check-docs test"
    # Copy check-docs into the temp repo's bin/ so __DIR__ resolves to the temp repo root.
    mkdir -p "$repo/bin"
    cp "$REAL_SCRIPT" "$repo/bin/check-docs"
    echo "$repo"
}

make_skill_md() {   # make_skill_md <repo> <content>
    local repo="$1" content="$2"
    mkdir -p "$repo/.claude/skills/foo"
    printf '%s' "$content" > "$repo/.claude/skills/foo/SKILL.md"
}

# Valid frontmatter prefix so frontmatter checks don't interfere
FM=$'---\ndescription: Test fixture\nlast_verified: 2026-09-04\n---\n'

# ── Test 1: positive — DRAFT=$(...) inside fenced block → label present ──────

REPO=$(make_repo)
make_skill_md "$REPO" "${FM}"'# Foo

```bash
DRAFT=$(git rev-parse HEAD)
echo "$DRAFT"
```
'
OUT=$(cd "$REPO" && bin/check-docs --no-staleness 2>&1) || true
rm -rf "$REPO"
if label_present "$OUT"; then
    pass "positive: DRAFT=\$(...) in fenced block triggers violation"
else
    fail "positive: DRAFT=\$(...) in fenced block should trigger violation"
    echo "  output: $OUT"
fi

# ── Test 2: negative — DRAFT=<slug> in fenced block → label absent ───────────

REPO=$(make_repo)
make_skill_md "$REPO" "${FM}"'# Foo

```bash
DRAFT="$HOME/claude-plans/.drafts/<slug>.draft.md"
echo "$DRAFT"
```
'
OUT=$(cd "$REPO" && bin/check-docs --no-staleness 2>&1) || true
rm -rf "$REPO"
if label_absent "$OUT"; then
    pass "negative: DRAFT=<slug> in fenced block is clean"
else
    fail "negative: DRAFT=<slug> in fenced block should not trigger violation"
    echo "  output: $OUT"
fi

# ── Test 3: prose-scope — DRAFT=$(...) in prose (not fenced) → label absent ──

REPO=$(make_repo)
make_skill_md "$REPO" "${FM}"'# Foo

Run: DRAFT=$(git rev-parse HEAD)

No fenced block here.
'
OUT=$(cd "$REPO" && bin/check-docs --no-staleness 2>&1) || true
rm -rf "$REPO"
if label_absent "$OUT"; then
    pass "prose-scope: DRAFT=\$(...) in prose is not flagged"
else
    fail "prose-scope: DRAFT=\$(...) in prose should not be flagged"
    echo "  output: $OUT"
fi

# ── Test 4: skill-dir sibling — DRAFT=$(...) in a non-SKILL.md → label absent ─

# The fixture must sit INSIDE .claude/skills/<name>/. That directory is the only
# place checkSkillDraftPlaceholder() looks: it globs .claude/skills/*/SKILL.md
# itself and never consults IN_SCOPE_GLOBS, so a fixture anywhere else (docs/,
# say) is not merely out of scope — it is never opened, and the assertion holds
# no matter how the filename filter is written. A sibling inside the skill dir
# exercises the SKILL.md part of the glob, which is the boundary under test.

REPO=$(make_repo)
make_skill_md "$REPO" "${FM}"'# Foo

```bash
DRAFT=<slug>
```
'
printf '%s' "${FM}"'# Notes

```bash
DRAFT=$(git rev-parse HEAD)
```
' > "$REPO/.claude/skills/foo/NOTES.md"
OUT=$(cd "$REPO" && bin/check-docs --no-staleness 2>&1) || true
rm -rf "$REPO"
if label_absent "$OUT"; then
    pass "skill-dir sibling: DRAFT=\$(...) in a non-SKILL.md is not flagged"
else
    fail "skill-dir sibling: DRAFT=\$(...) in a non-SKILL.md should not be flagged"
    echo "  output: $OUT"
fi

# ── Local-date fallback (iterChangedDocs null-editCommitDate path) ────────────
#
# When base..HEAD is empty — the pre-commit hook's shape: dirty tree, no commit
# on the branch yet — editCommitDate() returns null and check-docs falls back to
# localToday(). That clock must be the author machine's LOCAL calendar day, not
# PHP's UTC default: after ~17:00 PDT the UTC day is already tomorrow, so a doc
# verified today was compared against tomorrow and false-failed with "last_verified
# not bumped". CHECK_DOCS_TODAY pins the clock, because a CI runner is UTC and the
# evening-PDT offset cannot occur there naturally.

bump_present() {   grep -qF 'last_verified not bumped' <<< "$1"; }
bump_absent()  { ! grep -qF 'last_verified not bumped' <<< "$1"; }

# Both dates come from PHP's default (UTC) clock, so PINNED is guaranteed to differ
# from UTC-today by one day — the same offset an evening-PDT edit carries.
PINNED=$(php -r 'echo (new DateTimeImmutable("yesterday"))->format("Y-m-d");')
STALER=$(php -r 'echo (new DateTimeImmutable("-2 days"))->format("Y-m-d");')

# .claude/rules/ is an IN_SCOPE_GLOBS path — docs/ at the repo root is NOT, so a
# fixture there is silently skipped and every assertion passes vacuously.
write_doc() {   # write_doc <repo> <last_verified> <body>
    local repo="$1" lv="$2" body="$3"
    mkdir -p "$repo/.claude/rules"
    printf -- '---\ndescription: Test fixture\nlast_verified: %s\n---\n# Doc\n\n%s\n' \
        "$lv" "$body" > "$repo/.claude/rules/fixture.md"
}

commit_doc() {  # commit_doc <repo>
    local repo="$1"
    git -C "$repo" add -A
    git -C "$repo" commit -qm fixture
}

# ── Edit-date ref (CHECK_DOCS_EDIT_DATE_REF) ─────────────────────────────────
#
# A squash replay reads the merge-day squash author date, which can be later than
# the branch edit that carried last_verified. The gate backtest sets
# CHECK_DOCS_EDIT_DATE_REF to the PR's pre-squash head so editCommitDate() reads the
# branch's own per-file dates. CI never sets it. Fixture shape:
#   B : doc with last_verified 2026-10-23
#   T : parent B, body edit only, author date 2026-10-23T12:00:00-05:00
#   S : parent B, tree of T, author date 2026-10-24T00:35:00-05:00 (checked out)

EDR_LV="2026-10-23"
EDR_TODAY="2026-10-24"

make_edit_ref_fixture() {   # make_edit_ref_fixture <repo> <squash|branch>; sets EDR_BASE EDR_TIP
    local repo="$1" shape="$2"
    write_doc "$repo" "$EDR_LV" "Original body."
    commit_doc "$repo"
    EDR_BASE=$(git -C "$repo" rev-parse HEAD)
    write_doc "$repo" "$EDR_LV" "Branch edit, verified that day."
    git -C "$repo" add -A
    GIT_AUTHOR_DATE="${EDR_LV}T12:00:00-05:00" git -C "$repo" commit -qm branch-edit
    EDR_TIP=$(git -C "$repo" rev-parse HEAD)
    if [[ "$shape" == squash ]]; then
        local squash
        squash=$(GIT_AUTHOR_DATE="2026-10-24T00:35:00-05:00" git -C "$repo" commit-tree "${EDR_TIP}^{tree}" -p "$EDR_BASE" -m squash)
        git -C "$repo" reset -q --hard "$squash"
    fi
}

# run_edit_ref <repo> <base> <unset|set> [ref]; sets EDR_RC EDR_OUT EDR_ERR
run_edit_ref() {
    local repo="$1" base="$2" mode="$3" ref="${4:-}"
    local of ef
    of=$(mktemp)
    ef=$(mktemp)
    EDR_RC=0
    if [[ "$mode" == unset ]]; then
        (cd "$repo" && env -u CHECK_DOCS_EDIT_DATE_REF CHECK_DOCS_TODAY="$EDR_TODAY" \
            bin/check-docs --since="$base" --no-staleness > "$of" 2> "$ef") || EDR_RC=$?
    else
        (cd "$repo" && CHECK_DOCS_EDIT_DATE_REF="$ref" CHECK_DOCS_TODAY="$EDR_TODAY" \
            bin/check-docs --since="$base" --no-staleness > "$of" 2> "$ef") || EDR_RC=$?
    fi
    EDR_OUT=$(cat "$of")
    EDR_ERR=$(cat "$ef")
    rm -f "$of" "$ef"
}

# Case: the quirk. Unset ref on a squash replay reads the squash date and fails.
REPO=$(make_repo)
make_edit_ref_fixture "$REPO" squash
run_edit_ref "$REPO" "$EDR_BASE" unset
rm -rf "$REPO"
if [[ $EDR_RC -ne 0 ]]; then
    pass "squash-dated edit fails without edit-date ref: rc nonzero"
else
    fail "squash-dated edit fails without edit-date ref: expected nonzero rc"
    echo "  output: $EDR_OUT"
fi
if bump_present "$EDR_OUT"; then
    pass "squash-dated edit fails without edit-date ref: stdout has the bump message"
else
    fail "squash-dated edit fails without edit-date ref: expected the bump message"
    echo "  output: $EDR_OUT"
fi

# Case: ref names the branch tip, so the branch edit date wins.
REPO=$(make_repo)
make_edit_ref_fixture "$REPO" squash
run_edit_ref "$REPO" "$EDR_BASE" set "$EDR_TIP"
rm -rf "$REPO"
if [[ $EDR_RC -eq 0 ]]; then
    pass "edit-date ref to branch tip passes squash replay: rc 0"
else
    fail "edit-date ref to branch tip passes squash replay: expected rc 0 (got $EDR_RC)"
    echo "  output: $EDR_OUT"
fi
if bump_absent "$EDR_OUT"; then
    pass "edit-date ref to branch tip passes squash replay: no bump message"
else
    fail "edit-date ref to branch tip passes squash replay: bump message present"
    echo "  output: $EDR_OUT"
fi
if ! grep -qF 'CHECK_DOCS_EDIT_DATE_REF ignored' <<< "$EDR_ERR"; then
    pass "edit-date ref to branch tip passes squash replay: no ignored warning"
else
    fail "edit-date ref to branch tip passes squash replay: unexpected ignored warning"
    echo "  stderr: $EDR_ERR"
fi

# Case: set-but-empty behaves as unset and stays silent.
REPO=$(make_repo)
make_edit_ref_fixture "$REPO" squash
run_edit_ref "$REPO" "$EDR_BASE" set ""
rm -rf "$REPO"
if [[ $EDR_RC -ne 0 ]]; then
    pass "empty edit-date ref behaves as unset: rc nonzero"
else
    fail "empty edit-date ref behaves as unset: expected nonzero rc"
    echo "  output: $EDR_OUT"
fi
if bump_present "$EDR_OUT"; then
    pass "empty edit-date ref behaves as unset: stdout has the bump message"
else
    fail "empty edit-date ref behaves as unset: expected the bump message"
    echo "  output: $EDR_OUT"
fi
if ! grep -qF 'CHECK_DOCS_EDIT_DATE_REF ignored' <<< "$EDR_ERR"; then
    pass "empty edit-date ref behaves as unset: no ignored warning"
else
    fail "empty edit-date ref behaves as unset: unexpected ignored warning"
    echo "  stderr: $EDR_ERR"
fi

# Case: unset on a plain branch checkout, same-day re-edit passes (CI shape).
REPO=$(make_repo)
make_edit_ref_fixture "$REPO" branch
run_edit_ref "$REPO" "$EDR_BASE" unset
rm -rf "$REPO"
if [[ $EDR_RC -eq 0 ]]; then
    pass "unset edit-date ref keeps same-day re-edit pass"
else
    fail "unset edit-date ref keeps same-day re-edit pass: expected rc 0 (got $EDR_RC)"
    echo "  output: $EDR_OUT"
    echo "  stderr: $EDR_ERR"
fi

# Case: HEAD~1 is a valid revision but not a sha, so it is rejected.
REPO=$(make_repo)
make_edit_ref_fixture "$REPO" squash
run_edit_ref "$REPO" "$EDR_BASE" set "HEAD~1"
rm -rf "$REPO"
if grep -qF 'CHECK_DOCS_EDIT_DATE_REF ignored (not a commit sha): HEAD~1' <<< "$EDR_ERR"; then
    pass "non-sha edit-date ref HEAD~1 is ignored with warning: stderr"
else
    fail "non-sha edit-date ref HEAD~1 is ignored with warning: expected stderr line"
    echo "  stderr: $EDR_ERR"
fi
if [[ $EDR_RC -ne 0 ]]; then
    pass "non-sha edit-date ref HEAD~1 is ignored with warning: rc nonzero"
else
    fail "non-sha edit-date ref HEAD~1 is ignored with warning: expected nonzero rc"
fi
if bump_present "$EDR_OUT"; then
    pass "non-sha edit-date ref HEAD~1 is ignored with warning: bump message"
else
    fail "non-sha edit-date ref HEAD~1 is ignored with warning: expected the bump message"
    echo "  output: $EDR_OUT"
fi

# Case: six hex chars is one short of a sha.
REPO=$(make_repo)
make_edit_ref_fixture "$REPO" squash
run_edit_ref "$REPO" "$EDR_BASE" set "${EDR_TIP:0:6}"
rm -rf "$REPO"
if grep -qF '(not a commit sha)' <<< "$EDR_ERR"; then
    pass "six-hex edit-date ref is rejected as not a sha"
else
    fail "six-hex edit-date ref is rejected as not a sha: expected '(not a commit sha)'"
    echo "  stderr: $EDR_ERR"
fi

# Case: a well-formed sha naming no commit.
REPO=$(make_repo)
make_edit_ref_fixture "$REPO" squash
run_edit_ref "$REPO" "$EDR_BASE" set "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef"
rm -rf "$REPO"
if grep -qF '(no such commit)' <<< "$EDR_ERR"; then
    pass "missing-commit edit-date ref is ignored with warning: stderr"
else
    fail "missing-commit edit-date ref is ignored with warning: expected '(no such commit)'"
    echo "  stderr: $EDR_ERR"
fi
if [[ $EDR_RC -ne 0 ]]; then
    pass "missing-commit edit-date ref is ignored with warning: rc nonzero"
else
    fail "missing-commit edit-date ref is ignored with warning: expected nonzero rc"
fi

# Fail fast: this section runs first so a planted bug in the edit-date ref path
# (Executable Mutations rows 3-8) fails in seconds. Running the rest of the suite
# would push a mutated run past the mutation runner's time limit.
if [ "$H_FAIL" -gt 0 ]; then h_done; fi

# ── Test 5: doc verified on the local day passes with no commit on the branch ─

REPO=$(make_repo)
write_doc "$REPO" "$PINNED" "Original body."
commit_doc "$REPO"
BR=$(git -C "$REPO" rev-parse --abbrev-ref HEAD)
# Body changes in the working tree only; last_verified deliberately unchanged.
write_doc "$REPO" "$PINNED" "Edited body."
OUT=$(cd "$REPO" && CHECK_DOCS_TODAY="$PINNED" bin/check-docs --since="$BR" --no-staleness 2>&1) || true
rm -rf "$REPO"
if bump_absent "$OUT"; then
    pass "local-date fallback: last_verified == local today passes pre-commit"
else
    fail "local-date fallback: last_verified == local today should pass pre-commit"
    echo "  output: $OUT"
fi

# ── Test 6: the fallback stays tight — a staler date still fails ──────────────

REPO=$(make_repo)
write_doc "$REPO" "$STALER" "Original body."
commit_doc "$REPO"
BR=$(git -C "$REPO" rev-parse --abbrev-ref HEAD)
write_doc "$REPO" "$STALER" "Edited body."
OUT=$(cd "$REPO" && CHECK_DOCS_TODAY="$PINNED" bin/check-docs --since="$BR" --no-staleness 2>&1) || true
rm -rf "$REPO"
if bump_present "$OUT"; then
    pass "local-date fallback: last_verified older than local today still fails"
else
    fail "local-date fallback: last_verified older than local today should still fail"
    echo "  output: $OUT"
fi

# ── Test 6b: an uncommitted edit is dated today, not by the branch's last commit ─
#
# PR #2405's shape: the branch already committed an edit to the doc on an earlier
# day (author date == last_verified, so that commit passes), and a new body edit
# is staged today without a bump. editCommitDate() sees only base..HEAD, so it
# returned the earlier commit's date and the pre-commit hook passed an edit CI
# then failed. A dirty doc's edit date is local today.

REPO=$(make_repo)
write_doc "$REPO" "$STALER" "Original body."
commit_doc "$REPO"
BASE=$(git -C "$REPO" rev-parse HEAD)
write_doc "$REPO" "$STALER" "Branch edit, verified that day."
git -C "$REPO" add -A
GIT_AUTHOR_DATE="${STALER}T12:00:00" git -C "$REPO" commit -qm branch-edit
write_doc "$REPO" "$STALER" "Second edit, staged today without a bump."
git -C "$REPO" add -A
OUT=$(cd "$REPO" && CHECK_DOCS_TODAY="$PINNED" bin/check-docs --since="$BASE" --no-staleness 2>&1) || true
write_doc "$REPO" "$PINNED" "Second edit, staged today without a bump."
git -C "$REPO" add -A
OUT_BUMPED=$(cd "$REPO" && CHECK_DOCS_TODAY="$PINNED" bin/check-docs --since="$BASE" --no-staleness 2>&1) || true
rm -rf "$REPO"
if bump_present "$OUT"; then
    pass "dirty edit: unbumped staged edit fails even when the last branch commit was verified"
else
    fail "dirty edit: unbumped staged edit should fail (edit date is today, not the last commit's)"
    echo "  output: $OUT"
fi
if bump_absent "$OUT_BUMPED"; then
    pass "dirty edit: staged edit bumped to local today passes"
else
    fail "dirty edit: staged edit bumped to local today should pass"
    echo "  output: $OUT_BUMPED"
fi

# ── Backward-moving last_verified ────────────────────────────────────────────
#
# A changed doc whose last_verified is EARLIER than its merge-base value fails.

back_present() {   grep -qF 'last_verified moved backward' <<< "$1"; }
LATER=$(php -r 'echo (new DateTimeImmutable("today"))->format("Y-m-d");')

run_since() {   # run_since <repo> <base>
    (cd "$1" && CHECK_DOCS_TODAY="$LATER" bin/check-docs --since="$2" --no-staleness 2>&1) || true
}

# (1) backward move fails with the new message
REPO=$(make_repo)
write_doc "$REPO" "$PINNED" "Original body."
commit_doc "$REPO"
BASE=$(git -C "$REPO" rev-parse HEAD)
write_doc "$REPO" "$STALER" "Edited body."
commit_doc "$REPO"
OUT=$(run_since "$REPO" "$BASE")
rm -rf "$REPO"
if back_present "$OUT" && grep -qF "($PINNED -> $STALER)" <<< "$OUT"; then
    pass "backward: last_verified moved earlier fails with the new message"
else
    fail "backward: moved-earlier last_verified should fail"
    echo "  output: $OUT"
fi

# (2) forward bump still passes
REPO=$(make_repo)
write_doc "$REPO" "$STALER" "Original body."
commit_doc "$REPO"
BASE=$(git -C "$REPO" rev-parse HEAD)
write_doc "$REPO" "$PINNED" "Edited body."
commit_doc "$REPO"
OUT=$(run_since "$REPO" "$BASE")
rm -rf "$REPO"
if ! back_present "$OUT" && bump_absent "$OUT"; then
    pass "backward: forward bump still passes"
else
    fail "backward: forward bump should pass"
    echo "  output: $OUT"
fi

# (3) equal values still follow the old rules (stale -> not-bumped; no backward report)
REPO=$(make_repo)
write_doc "$REPO" "$STALER" "Original body."
commit_doc "$REPO"
BASE=$(git -C "$REPO" rev-parse HEAD)
write_doc "$REPO" "$STALER" "Edited body."
commit_doc "$REPO"
OUT=$(run_since "$REPO" "$BASE")
rm -rf "$REPO"
if ! back_present "$OUT" && bump_present "$OUT"; then
    pass "backward: equal values keep the old not-bumped rule, no backward report"
else
    fail "backward: equal values should only follow the old rule"
    echo "  output: $OUT"
fi

# (4) newly added doc with a date passes
REPO=$(make_repo)
write_doc "$REPO" "$PINNED" "Seed body."
commit_doc "$REPO"
BASE=$(git -C "$REPO" rev-parse HEAD)
printf -- '---\ndescription: Test fixture\nlast_verified: %s\n---\n# New\n' "$STALER" > "$REPO/.claude/rules/added.md"
commit_doc "$REPO"
OUT=$(run_since "$REPO" "$BASE")
rm -rf "$REPO"
if ! back_present "$OUT"; then
    pass "backward: newly added doc with a date does not trip the rule"
else
    fail "backward: newly added doc should not trip the rule"
    echo "  output: $OUT"
fi

# (5) behind-master: master bumps the date after the branch point; branch never
# touched the date, so the tip's newer value must not false-fail the branch.
REPO=$(make_repo)
write_doc "$REPO" "$STALER" "Original body."
commit_doc "$REPO"
MAIN=$(git -C "$REPO" rev-parse --abbrev-ref HEAD)
git -C "$REPO" checkout -qb feature
printf -- '---\ndescription: o\nlast_verified: %s\n---\n# O\n' "$STALER" > "$REPO/.claude/rules/other.md"
commit_doc "$REPO"
git -C "$REPO" checkout -q "$MAIN"
write_doc "$REPO" "$PINNED" "Original body."
commit_doc "$REPO"
git -C "$REPO" checkout -q feature
write_doc "$REPO" "$STALER" "Original body plus branch edit."
commit_doc "$REPO"
OUT=$(run_since "$REPO" "$MAIN")
rm -rf "$REPO"
if ! back_present "$OUT"; then
    pass "backward: branch behind a master date bump is not flagged (merge-base compare)"
else
    fail "backward: behind-master branch must compare against the merge-base"
    echo "  output: $OUT"
fi

# ── UTC freshness clock (checkFile / stalenessAgeDays) ───────────────────────
#
# The freshness verdict is pinned to UTC on BOTH sides: $today is built with an
# explicit UTC zone, and every last_verified is parsed with one. Drop either pin
# and the pair goes mixed-zone — on a box whose `date.timezone` is a negative
# offset, midnight-local is 07:00 UTC, so a doc dated UTC-today reads as
# "last_verified in the future" and the gate false-fails.
#
# `php -d date.timezone=...` is the only way to exercise this: `date.timezone`
# is unset so PHP defaults to UTC, and the mixed-zone path is unreachable naturally.
# These invoke the checker through `php -d` rather than its `#!/usr/bin/env php`
# shebang, because the -d override has to sit on the interpreter invocation.

future_present() {   grep -qF 'in the future' <<< "$1"; }
future_absent()  { ! grep -qF 'in the future' <<< "$1"; }

UTC_TODAY=$(php -r 'echo (new DateTimeImmutable("now", new DateTimeZone("UTC")))->format("Y-m-d");')
UTC_TOMORROW=$(php -r 'echo (new DateTimeImmutable("+1 day", new DateTimeZone("UTC")))->format("Y-m-d");')
LA_TODAY=$(php -r 'echo (new DateTimeImmutable("now", new DateTimeZone("America/Los_Angeles")))->format("Y-m-d");')

# ── Test 7: a doc dated UTC-today is not future-dated under a negative-offset tz
#
# This test only discriminates fixed from unfixed code when the UTC calendar date
# is ahead of the LA calendar date (00:00–06:59 UTC under PDT/PST). Outside that
# window both fixed and unfixed code agree on the date and the test is vacuous.
# Skip rather than vacuously pass so the gap is visible in CI output.

if [ "$UTC_TODAY" = "$LA_TODAY" ]; then
    skip "UTC clock: UTC and LA share calendar date — test only fires 00:00–07:00 UTC"
else
    REPO=$(make_repo)
    write_doc "$REPO" "$UTC_TODAY" "Body."
    OUT=$(cd "$REPO" && php -d date.timezone=America/Los_Angeles bin/check-docs --no-staleness 2>&1) || true
    rm -rf "$REPO"
    if future_absent "$OUT"; then
        pass "UTC clock: last_verified == UTC today passes under a PDT php timezone"
    else
        fail "UTC clock: last_verified == UTC today should pass under a PDT php timezone"
        echo "  output: $OUT"
    fi
fi

# ── Test 8: the UTC clock stays tight — a genuinely future date still fails ───

REPO=$(make_repo)
write_doc "$REPO" "$UTC_TOMORROW" "Body."
OUT=$(cd "$REPO" && php -d date.timezone=America/Los_Angeles bin/check-docs --no-staleness 2>&1) || true
rm -rf "$REPO"
if future_present "$OUT"; then
    pass "UTC clock: last_verified one UTC day ahead still fails as future-dated"
else
    fail "UTC clock: last_verified one UTC day ahead should still fail as future-dated"
    echo "  output: $OUT"
fi

# ── Test 9: stalenessAgeDays UTC pin — exact age under a negative-offset tz ──
#
# stalenessAgeDays() parses last_verified with an explicit UTC timezone. Without
# the pin, createFromFormat() uses the ambient timezone: under America/Los_Angeles
# a date parsed at LA midnight lands at 07:00 UTC, not 00:00 UTC. Against a $today
# anchored at UTC midnight the diff is 89d17h rather than 90d exactly, and
# (int)->days truncates to 89. The assertion age_days==90 catches that truncation
# at every hour of the day — no 00:00–07:00 UTC window required.

STALE_DATE=$(php -r 'echo (new DateTimeImmutable("-90 days", new DateTimeZone("UTC")))->format("Y-m-d");')

REPO=$(make_repo)
write_doc "$REPO" "$STALE_DATE" "Body."
REPORT=$(cd "$REPO" && php -d date.timezone=America/Los_Angeles bin/check-docs --staleness-report 2>&1) || true
rm -rf "$REPO"
AGE=$(php -r 'echo json_decode(file_get_contents("php://stdin"), true)[0]["age_days"] ?? "none";' <<< "$REPORT")
if [ "$AGE" = "90" ]; then
    pass "UTC clock: stalenessAgeDays reports age_days 90 for a 90-day-old doc under PDT"
else
    fail "UTC clock: stalenessAgeDays should report age_days 90, got $AGE"
    echo "  report: $REPORT"
fi

# ── Results ───────────────────────────────────────────────────────────────────

# ── Test 9b: frozen engine/ docs are dropped from the staleness report ───────
#
# bin/check-engine-freeze rejects any edit under engine/, so a stale engine doc
# can never be fixed. The report omits it; other stale docs stay listed.

REPO=$(make_repo)
write_doc "$REPO" "$STALE_DATE" "Body."
mkdir -p "$REPO/engine/.claude/rules"
printf -- '---\ndescription: Test fixture\nlast_verified: %s\n---\n# Doc\n\nBody.\n' \
    "$STALE_DATE" > "$REPO/engine/.claude/rules/frozen.md"
REPORT=$(cd "$REPO" && bin/check-docs --staleness-report 2>&1) || true
rm -rf "$REPO"
if grep -qF '"path": ".claude/rules/fixture.md"' <<< "$REPORT" \
    && ! grep -qF 'engine/.claude/rules/frozen.md' <<< "$REPORT"; then
    pass "frozen engine/ docs are omitted from the staleness report"
else
    fail "frozen engine/ docs are omitted from the staleness report"
    echo "  report: $REPORT"
fi

# ── Tests 10-12: engine lint-pin drift (checkEngineLintPins) ─────────────────
#
# engine.yml is the source of truth; the two tracked docs restate its pins.

pin_present() {   grep -qF 'engine lint pin drift' <<< "$1"; }
pin_absent()  { ! grep -qF 'engine lint pin drift' <<< "$1"; }

make_pin_fixture() {   # make_pin_fixture <repo> <binary-version>
    local repo="$1" ver="$2"
    mkdir -p "$repo/.github/workflows" "$repo/.claude/rules" \
        "$repo/engine/.claude/rules"
    printf '%s\n' 'jobs:' '  lint:' '    steps:' \
        '      - name: Lint' \
        '        uses: golangci/golangci-lint-action@ba0d7d2ec06a0ea1cb5fa41b2e4a3ab91d21278a # v9.3.0' \
        '        with:' "          version: $ver" \
        > "$repo/.github/workflows/engine.yml"
    local body='Action `golangci/golangci-lint-action@ba0d7d2… # v9.3.0`, binary `v2.12.2`.'
    printf '%s%s\n' "$FM" "$body" > "$repo/.claude/rules/engine-go.md"
    printf '%s%s\n' "$FM" "$body" > "$repo/engine/.claude/rules/engine-context.md"
    git -C "$repo" add -A >/dev/null && git -C "$repo" commit -qm fixture
}

# Test 10: matching pins pass
REPO=$(make_repo)
make_pin_fixture "$REPO" v2.12.2
OUT=$(cd "$REPO" && bin/check-docs --no-staleness 2>&1) || true
rm -rf "$REPO"
if pin_absent "$OUT"; then
    pass "pin A: matching engine.yml and docs produce no drift label"
else
    fail "pin A: matching pins should not report drift"
    echo "  output: $OUT"
fi

# Test 11: bumped engine.yml, untouched docs, fails and names both docs
REPO=$(make_repo)
make_pin_fixture "$REPO" v2.13.0
RC=0
OUT=$(cd "$REPO" && bin/check-docs --no-staleness 2>&1) || RC=$?
rm -rf "$REPO"
if pin_present "$OUT" && [[ $RC -ne 0 ]] \
    && grep -qF '.claude/rules/engine-go.md:' <<< "$OUT" \
    && grep -qF 'engine/.claude/rules/engine-context.md:' <<< "$OUT"; then
    pass "pin B: bumped engine.yml binary fails and names both tracked docs"
else
    fail "pin B: expected drift label, non-zero exit, both docs named (rc=$RC)"
    echo "  output: $OUT"
fi

# Test 12: unparseable workflow fails loudly
REPO=$(make_repo)
make_pin_fixture "$REPO" latest
RC=0
OUT=$(cd "$REPO" && bin/check-docs --no-staleness 2>&1) || RC=$?
rm -rf "$REPO"
if pin_present "$OUT" && [[ $RC -ne 0 ]] && grep -qF 'cannot parse' <<< "$OUT"; then
    pass "pin C: version: latest fails with 'cannot parse'"
else
    fail "pin C: expected drift label, non-zero exit, 'cannot parse' (rc=$RC)"
    echo "  output: $OUT"
fi

# ── Tests 13-15: required-status claims (backlog #711) ────────────────────────

claims_present() { grep -qF 'FAIL required-status claims drift' <<< "$1"; }
claims_absent()  { ! claims_present "$1"; }

READBACK="gh api repos/a-jay85/IBL5/branches/master/protection --jq '.required_status_checks.contexts'"
DOC_OK="Live list: \`${READBACK}\`. Auto-merge waits on \`All checks settled\`."
DOC_ENUM="${DOC_OK} Required: Tests and Analysis, E2E Tests, Meta checks."

make_claims_fixture() {   # make_claims_fixture <repo> <ignore-csv> <doc-body>
    local repo="$1" ignore="$2" body="$3"
    mkdir -p "$repo/.github/workflows" "$repo/.claude/rules"
    printf '%s\n' 'jobs:' '  aggregate:' '    steps:' '      - run: |' \
        '          bin/check-pr-checks-green \' \
        "            --anchor='Tests and Analysis,E2E Tests,Meta checks,Infection PHP (per-PR diff)' \\" \
        "            --ignore='${ignore}'" \
        > "$repo/.github/workflows/all-checks-settled.yml"
    printf '%s\n' 'jobs:' '  engine:' '    name: Go build, vet, lint, test' \
        '  gate:' '    name: Engine' \
        > "$repo/.github/workflows/engine.yml"
    printf '%s%s\n' "$FM" "$body" > "$repo/.claude/rules/engine-go.md"
    git -C "$repo" add -A >/dev/null && git -C "$repo" commit -qm fixture
}

# Test 13: pointer-style doc, Engine not ignored, passes
REPO=$(make_repo)
make_claims_fixture "$REPO" 'human-signoff,Infection PHP' "$DOC_OK"
OUT=$(cd "$REPO" && bin/check-docs --no-staleness 2>&1) || true
rm -rf "$REPO"
if claims_absent "$OUT"; then
    pass "claims D: pointer doc plus gated Engine produce no claims label"
else
    fail "claims D: clean fixture should not report claims drift"
    echo "  output: $OUT"
fi

# Test 14: Engine added to --ignore fails and names the check
REPO=$(make_repo)
make_claims_fixture "$REPO" 'human-signoff,Infection PHP,Engine' "$DOC_OK"
RC=0
OUT=$(cd "$REPO" && bin/check-docs --no-staleness 2>&1) || RC=$?
rm -rf "$REPO"
if claims_present "$OUT" && [[ $RC -ne 0 ]] \
    && grep -qF "check 'Engine' is in --ignore" <<< "$OUT"; then
    pass "claims E: Engine in --ignore fails with the check named"
else
    fail "claims E: expected claims label, non-zero exit, Engine named (rc=$RC)"
    echo "  output: $OUT"
fi

# Test 15: doc enumerating contexts fails and names the doc
REPO=$(make_repo)
make_claims_fixture "$REPO" 'human-signoff,Infection PHP' "$DOC_ENUM"
RC=0
OUT=$(cd "$REPO" && bin/check-docs --no-staleness 2>&1) || RC=$?
rm -rf "$REPO"
if claims_present "$OUT" && [[ $RC -ne 0 ]] \
    && grep -qF '.claude/rules/engine-go.md: names 4 required-context names' <<< "$OUT"; then
    pass "claims F: enumerating doc fails with the doc and count named"
else
    fail "claims F: expected claims label, non-zero exit, doc named (rc=$RC)"
    echo "  output: $OUT"
fi

# ── Results ───────────────────────────────────────────────────────────────────

h_done
