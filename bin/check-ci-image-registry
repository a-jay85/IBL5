#!/bin/bash
# bin/check-ci-image-registry — CI gate: CI pulls Docker Hub images only through the
# GHCR mirror (ghcr.io/a-jay85/mirror/<name>:<tag>) listed in .github/ci-image-mirror.txt,
# so a Docker Hub timeout cannot fail a job. Rules (each violation prints
# <file>:<line>: <rule>: <fix>):
#   A  an `image:` / `uses: docker://` value that resolves to docker.io
#   B  a bare manifest ref anywhere on the surface (not preceded by `mirror/`)
#   C  a Dockerfile FROM that is neither a variable nor an earlier stage name
#   E  a mirror service image without `needs: mirror-ready` and `credentials:`
#   F  a job calling the mirror workflow (directly or through reusable-workflow
#      callers) without `packages: write` in its own block
# See bin/test-check-ci-image-registry and ADR-0191.
#
# Usage: bin/check-ci-image-registry [--root=DIR]
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)

usage() {
    cat <<'EOF'
Usage: bin/check-ci-image-registry [--root=DIR]

CI gate: CI pulls Docker Hub images only through the GHCR mirror.

Options:
  --root=DIR   tree to scan (default: repo root of this script). Fixtures use it.

Surface (under ROOT): .github/workflows/*.yml, .github/actions/*/action.yml,
  docker-compose.ci.yml, Dockerfile, bin/test-* except bin/test-check-ci-image-registry
  and bin/test-ci-image-mirror (they hold fixture literals).
  Not scanned: .github/ci-image-mirror.txt, the manifest of record.

Exit codes: 0 = clean, 1 = violation(s), each printed as <file>:<line>: <rule>: <fix>,
  2 = usage error or unreadable ROOT/.github/ci-image-mirror.txt
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --root=*) ROOT="${1#--root=}" ;;
        -h|--help) usage; exit 0 ;;
        *) echo "check-ci-image-registry: unknown argument: $1" >&2; exit 2 ;;
    esac
    shift
done

if [ -z "$ROOT" ] || [ ! -d "$ROOT" ]; then
    echo "check-ci-image-registry: cannot read root: $ROOT" >&2
    exit 2
fi
if [ "$ROOT" != "/" ]; then ROOT="${ROOT%/}"; fi

MANIFEST="$ROOT/.github/ci-image-mirror.txt"
if [ ! -r "$MANIFEST" ] || [ -d "$MANIFEST" ]; then
    echo "check-ci-image-registry: cannot read manifest: $MANIFEST" >&2
    exit 2
fi

# Manifest refs (comments and blanks dropped), space-joined. Each ref also adds its
# short form, so a manifest line spelled docker.io/library/x:t still catches x:t.
REFS=""
add_ref() {
    case " $REFS " in
        *" $1 "*) ;;
        *) REFS="$REFS $1" ;;
    esac
}
while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    line="${line%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [ -n "$line" ] || continue
    add_ref "$line"
    short="${line#docker.io/}"
    short="${short#library/}"
    add_ref "$short"
done < "$MANIFEST"
REFS="${REFS# }"
if [ -z "$REFS" ]; then
    echo "check-ci-image-registry: manifest has no refs: $MANIFEST" >&2
    exit 2
fi

# Per-file rules A, B, C, E. kind: workflow | action | compose | dockerfile | bin
read -r -d '' FILE_AWK <<'EOF' || true
function strip(v) {
    sub(/[[:space:]]+#.*$/, "", v)
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
    gsub("[\"" q "]", "", v)
    return v
}
function report(ln, rule, fix) {
    printf "%s:%d: %s: %s\n", rel, ln, rule, fix
    fail = 1
}
function is_hub(v,   n, first) {
    if (v == "" || substr(v, 1, 1) == "$") return 0
    if (index(v, "docker.io/") == 1) return 1
    n = index(v, "/")
    if (n == 0) return 1
    first = substr(v, 1, n - 1)
    if (first ~ /[.:]/ || first == "localhost") return 0
    return 1
}
function check_b(line, ln,   i, r, pos, rest, off, abs, pre, before, after, hit) {
    for (i = 1; i <= nr; i++) {
        r = R[i]
        off = 0
        rest = line
        while ((pos = index(rest, r)) > 0) {
            abs = off + pos
            pre = (abs > 7) ? substr(line, abs - 7, 7) : ""
            hit = (pre != "mirror/")
            if (hit && kind == "bin") {
                before = substr(line, 1, abs - 1)
                after = substr(line, abs + length(r), 1)
                if (before ~ /\$\{[A-Za-z_][A-Za-z0-9_]*:-$/ && after == "}") hit = 0
            }
            if (hit && kind == "dockerfile") {
                if (match(line, /^ARG [A-Z0-9_]+_IMAGE=/) && abs == RLENGTH + 1 && substr(line, RLENGTH + 1) == r) hit = 0
            }
            if (hit) {
                report(ln, "B", "bare " r " - use ghcr.io/a-jay85/mirror/<name>:<tag> (Dockerfile: an ARG <NAME>_IMAGE default; bin/test-*: a ${VAR:-ref} default)")
                return
            }
            off = abs + length(r) - 1
            rest = substr(line, off + 1)
        }
    }
}
function flush_job(   n) {
    if (job != "" && img_line > 0) {
        if (!has_needs) report(img_line, "E", "job " job " pulls a mirror image but has no needs: mirror-ready - add the mirror-ready job to needs:")
        if (!has_cred) report(img_line, "E", "job " job " pulls a mirror image but has no credentials: - add credentials: (ghcr.io login) to the service")
    }
    img_line = 0; has_needs = 0; has_cred = 0; inneeds = 0
}
BEGIN {
    q = sprintf("%c", 39)
    nr = split(refs, R, " ")
    img_pat = "image:[ \t]*[\"" q "]?ghcr[.]io/a-jay85/mirror/"
    fix_a = "add the ref to .github/ci-image-mirror.txt and use ghcr.io/a-jay85/mirror/<name>:<tag>"
}
{ sub(/\r$/, "") }
/^[[:space:]]*#/ { next }
{
    line = $0
    sub(/[[:space:]]+$/, "", line)

    # Rule B, every surface file.
    check_b(line, FNR)

    # Rule A, workflows / actions / compose.
    if (kind != "dockerfile" && kind != "bin") {
        v = ""
        if (match(line, /^[[:space:]]*(-[[:space:]]+)?image:[[:space:]]*/)) {
            v = strip(substr(line, RLENGTH + 1))
        } else if (match(line, /^[[:space:]]*(-[[:space:]]+)?uses:[[:space:]]*/)) {
            v = strip(substr(line, RLENGTH + 1))
            if (index(v, "docker://") == 1) v = substr(v, 10); else v = ""
        }
        if (is_hub(v)) report(FNR, "A", "docker.io image " v " - " fix_a)
    }

    # Rule C, Dockerfile FROM.
    if (kind == "dockerfile" && line ~ /^[[:space:]]*[Ff][Rr][Oo][Mm][[:space:]]/) {
        i = 2
        while (substr($i, 1, 2) == "--") i++
        img = $i
        if (substr(img, 1, 1) != "$" && !(tolower(img) in stage)) {
            report(FNR, "C", "FROM " img " is a literal - declare ARG <NAME>_IMAGE=" img " and use FROM ${<NAME>_IMAGE}")
        }
        if (tolower($(i + 1)) == "as") stage[tolower($(i + 2))] = 1
    }

    # Rule E, workflows: per-job wiring of mirror service images.
    if (kind == "workflow") {
        if (line ~ /^jobs:[[:space:]]*$/) { injobs = 1; next }
        if (injobs && line ~ /^[^[:space:]]/) { flush_job(); injobs = 0; job = "" }
        if (injobs && line ~ /^  [A-Za-z0-9_-]+:[[:space:]]*$/) {
            flush_job()
            job = line; sub(/:.*/, "", job); gsub(/[[:space:]]/, "", job)
            next
        }
        if (injobs && job != "") {
            if (line ~ img_pat && img_line == 0) img_line = FNR
            if (line ~ /^[[:space:]]*credentials:/) has_cred = 1
            if (line ~ /^[[:space:]]*needs:/) {
                inneeds = 1
                if (line ~ /mirror-ready/) has_needs = 1
            } else if (inneeds && line ~ /^[[:space:]]*-[[:space:]]/) {
                if (line ~ /mirror-ready/) has_needs = 1
            } else {
                inneeds = 0
            }
        }
    }
}
END {
    if (kind == "workflow") flush_job()
    exit (fail ? 1 : 0)
}
EOF

# Rule F over all workflows: a job reaching the mirror workflow needs packages: write.
read -r -d '' F_AWK <<'EOF' || true
BEGIN { q = sprintf("%c", 39) }
{ sub(/\r$/, "") }
FNR == 1 { injobs = 0; job = ""; nparts = split(FILENAME, parts, "/"); base = parts[nparts]; rel = substr(FILENAME, length(root) + 2) }
/^[[:space:]]*#/ { next }
/^jobs:[[:space:]]*$/ { injobs = 1; next }
injobs && /^[^[:space:]]/ { injobs = 0; job = "" }
injobs && /^  [A-Za-z0-9_-]+:[[:space:]]*$/ {
    job = $0; sub(/:.*/, "", job); gsub(/[[:space:]]/, "", job)
    next
}
injobs && job != "" {
    if ($0 ~ /^[[:space:]]*packages:[[:space:]]*write/) hasw[FILENAME SUBSEP job] = 1
    if (match($0, /^[[:space:]]*(-[[:space:]]+)?uses:[[:space:]]*["\047]?\.\/\.github\/workflows\//)) {
        name = substr($0, RSTART + RLENGTH)
        sub(/[[:space:]"#@].*$/, "", name)
        gsub("[\"" q "]", "", name)
        nc++
        cfile[nc] = FILENAME; cbase[nc] = base; crel[nc] = rel; cjob[nc] = job; cline[nc] = FNR; cname[nc] = name
    }
}
END {
    M["mirror-ci-images.yml"] = 1
    do {
        grew = 0
        for (i = 1; i <= nc; i++) {
            if ((cname[i] in M) && !(cbase[i] in M)) { M[cbase[i]] = 1; grew = 1 }
        }
    } while (grew)
    for (i = 1; i <= nc; i++) {
        if ((cname[i] in M) && !((cfile[i] SUBSEP cjob[i]) in hasw)) {
            printf "%s:%d: F: job %s calls %s, which reaches the mirror workflow - add packages: write to the permissions of this job\n", crel[i], cline[i], cjob[i], cname[i]
            fail = 1
        }
    }
    exit (fail ? 1 : 0)
}
EOF

rc=0
scan() { # kind file
    local kind="$1" file="$2" st=0
    awk -v kind="$kind" -v refs="$REFS" -v rel="${file#"$ROOT"/}" "$FILE_AWK" "$file" >&2 || st=$?
    case "$st" in
        0) ;;
        1) rc=1 ;;
        *) echo "check-ci-image-registry: awk failed on $file" >&2; exit 2 ;;
    esac
}

WF_FILES=()
for f in "$ROOT"/.github/workflows/*.yml; do
    [ -f "$f" ] || continue
    WF_FILES+=("$f")
    scan workflow "$f"
done
for f in "$ROOT"/.github/actions/*/action.yml; do
    [ -f "$f" ] || continue
    scan action "$f"
done
[ ! -f "$ROOT/docker-compose.ci.yml" ] || scan compose "$ROOT/docker-compose.ci.yml"
[ ! -f "$ROOT/Dockerfile" ] || scan dockerfile "$ROOT/Dockerfile"
for f in "$ROOT"/bin/test-*; do
    [ -f "$f" ] || continue
    case "${f##*/}" in
        test-check-ci-image-registry|test-ci-image-mirror) continue ;;
    esac
    scan bin "$f"
done

if [ "${#WF_FILES[@]}" -gt 0 ]; then
    st=0
    awk -v root="$ROOT" "$F_AWK" "${WF_FILES[@]}" >&2 || st=$?
    case "$st" in
        0) ;;
        1) rc=1 ;;
        *) echo "check-ci-image-registry: awk failed on rule F" >&2; exit 2 ;;
    esac
fi

exit "$rc"
