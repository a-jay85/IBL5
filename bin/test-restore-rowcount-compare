#!/usr/bin/env bash
# shellcheck shell=bash
#
# test-restore-rowcount-compare — behavioural harness for bin/lib/restore-rowcount-compare.sh.
#
# Drives the helper's snapshot / extract / compare subcommands with a fake SQL
# client and fixture files, and asserts on exit codes and exact output lines.
#
# Run: bin/test-restore-rowcount-compare  (exit 0 = all pass, 1 = a case failed)

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
HELPER="${HELPER:-$SCRIPT_DIR/lib/restore-rowcount-compare.sh}"
BASE_TMP="$(mktemp -d)"
trap 'rm -rf "$BASE_TMP"' EXIT

FAILED=0
OUT="$BASE_TMP/out"
ERR="$BASE_TMP/err"

check() { # name cmd [args...]: passes when the command succeeds
    local name="$1"
    shift
    if "$@"; then
        echo "ok: $name"
    else
        echo "FAIL: $name"
        sed 's/^/      | /' "$OUT" 2>/dev/null | head -20
        sed 's/^/      ! /' "$ERR" 2>/dev/null | head -20
        FAILED=1
    fi
}

# Fake SQL client: logs argv, branches on the table named in the -e SQL text.
FAKE="$BASE_TMP/fake-mysql"
CALLS="$BASE_TMP/client-calls.log"
cat > "$FAKE" <<'FAKE_EOF'
#!/bin/sh
echo "$*" >> "$CALLS_LOG"
sql=""
while [ "$#" -gt 0 ]; do
    if [ "$1" = "-e" ]; then
        sql="$2"
    fi
    shift
done
case "$sql" in
    *'`t_fail`'*) echo "ERROR 1146 (42S02): Table doesn't exist" >&2; exit 1 ;;
    *'`t_junk`'*) echo "N/A"; exit 0 ;;
    *'`t_a`'*) echo 120 ;;
    *'`t_b`'*) echo 0 ;;
    *) echo 7 ;;
esac
FAKE_EOF
chmod +x "$FAKE"
export CALLS_LOG="$CALLS"

# Same fake, but it drains stdin first like a real client reading a script from a pipe.
STDIN_FAKE="$BASE_TMP/fake-mysql-stdin"
printf '#!/bin/sh\ncat > /dev/null\nexec "%s" "$@"\n' "$FAKE" > "$STDIN_FAKE"
chmod +x "$STDIN_FAKE"

# fixture <name> <line>... writes $BASE_TMP/<name> and prints its path.
fixture() {
    local path="$BASE_TMP/$1"
    shift
    : > "$path"
    local line
    for line in "$@"; do
        printf '%s\n' "$line" >> "$path"
    done
    printf '%s' "$path"
}

# run_cmd <cmd>...: capture stdout to $OUT, stderr to $ERR, keep the exit code in $RC.
RC=0
run_cmd() {
    if "$@" > "$OUT" 2> "$ERR"; then
        RC=0
    else
        RC=$?
    fi
    return 0
}

out_has() { grep -qxF -- "$1" "$OUT"; }
err_has() { grep -qF -- "$1" "$ERR"; }

# --- 1. match passes ---------------------------------------------------------
case_1() {
    local e a
    e="$(fixture c1e 'ROWCOUNT t_a 120' 'ROWCOUNT t_b 5')"
    a="$(fixture c1a 'ROWCOUNT t_a 120' 'ROWCOUNT t_b 5')"
    run_cmd "$HELPER" compare "$e" "$a" t_a t_b
    [ "$RC" -eq 0 ] && out_has 'Row-count check passed (2 tables).'
}
check "1 equal counts pass" case_1

# --- 2. truncated table fails, log line pinned --------------------------------
case_2() {
    local e a
    e="$(fixture c2e 'ROWCOUNT t_a 120')"
    a="$(fixture c2a 'ROWCOUNT t_a 10')"
    run_cmd "$HELPER" compare "$e" "$a" t_a
    [ "$RC" -eq 1 ] \
        && out_has 'rowcount t_a: pre-dump=120 restored=10 FAIL (restored below pre-dump)' \
        && err_has 'ERROR: row-count check failed for 1 of 1 tables'
}
check "2 truncated table fails" case_2

# --- 3. grew during dump passes -----------------------------------------------
case_3() {
    local e a
    e="$(fixture c3e 'ROWCOUNT t_a 120')"
    a="$(fixture c3a 'ROWCOUNT t_a 121')"
    run_cmd "$HELPER" compare "$e" "$a" t_a
    [ "$RC" -eq 0 ] && out_has 'rowcount t_a: pre-dump=120 restored=121 OK'
}
check "3 restored above pre-dump passes" case_3

# --- 4. required table missing from expected fails ------------------------------
case_4() {
    local e a
    e="$(fixture c4e 'ROWCOUNT t_a 120')"
    a="$(fixture c4a 'ROWCOUNT t_a 120' 'ROWCOUNT t_b 5')"
    run_cmd "$HELPER" compare "$e" "$a" t_a t_b
    [ "$RC" -eq 1 ] && out_has 'rowcount t_b: pre-dump=- restored=5 FAIL (missing pre-dump count)'
}
check "4 table missing from expected fails" case_4

# --- 5. invalid or duplicate counts fail ----------------------------------------
case_5a() {
    local e a
    e="$(fixture c5ae 'ROWCOUNT t_a ERROR')"
    a="$(fixture c5aa 'ROWCOUNT t_a 120')"
    run_cmd "$HELPER" compare "$e" "$a" t_a
    [ "$RC" -eq 1 ] && out_has 'rowcount t_a: pre-dump=ERROR restored=120 FAIL (pre-dump count invalid)'
}
case_5b() {
    local e a
    e="$(fixture c5be 'ROWCOUNT t_a 120')"
    a="$(fixture c5ba 'ROWCOUNT t_a abc')"
    run_cmd "$HELPER" compare "$e" "$a" t_a
    [ "$RC" -eq 1 ] && out_has 'rowcount t_a: pre-dump=120 restored=abc FAIL (restored count invalid)'
}
case_5c() {
    local e a
    e="$(fixture c5ce 'ROWCOUNT t_a 120' 'ROWCOUNT t_a 120')"
    a="$(fixture c5ca 'ROWCOUNT t_a 120')"
    run_cmd "$HELPER" compare "$e" "$a" t_a
    [ "$RC" -eq 1 ] && grep -qF 'FAIL (duplicate count line)' "$OUT"
}
check "5a ERROR pre-dump count fails" case_5a
check "5b non-numeric restored count fails" case_5b
check "5c duplicate count line fails" case_5c

# --- 6. empty expected fails ----------------------------------------------------
case_6() {
    local e a
    e="$(fixture c6e)"
    a="$(fixture c6a 'ROWCOUNT t_a 120' 'ROWCOUNT t_b 5')"
    run_cmd "$HELPER" compare "$e" "$a" t_a t_b
    [ "$RC" -eq 1 ] \
        && out_has 'rowcount t_a: pre-dump=- restored=120 FAIL (missing pre-dump count)' \
        && out_has 'rowcount t_b: pre-dump=- restored=5 FAIL (missing pre-dump count)'
}
check "6 empty expected fails" case_6

# --- 7. restored-side table missing fails ---------------------------------------
case_7() {
    local e a
    e="$(fixture c7e 'ROWCOUNT t_a 120')"
    a="$(fixture c7a)"
    run_cmd "$HELPER" compare "$e" "$a" t_a
    [ "$RC" -eq 1 ] && out_has 'rowcount t_a: pre-dump=120 restored=- FAIL (missing after restore)'
}
check "7 table missing after restore fails" case_7

# --- 8. zero/zero passes --------------------------------------------------------
case_8() {
    local e a
    e="$(fixture c8e 'ROWCOUNT t_b 0')"
    a="$(fixture c8a 'ROWCOUNT t_b 0')"
    run_cmd "$HELPER" compare "$e" "$a" t_b
    [ "$RC" -eq 0 ] && out_has 'rowcount t_b: pre-dump=0 restored=0 OK'
}
check "8 zero and zero pass" case_8

# --- 9. extract keeps only well-formed lines ------------------------------------
case_9() {
    local log want
    log="$BASE_TMP/c9.log"
    {
        printf 'Dump size: 5 bytes\n'
        printf 'Retained dumps:\n'
        printf 'ROWCOUNT t_a 120\n'
        printf 'ROWCOUNT t_b ERROR\n'
        printf 'ROWCOUNT t_c 1.5\n'
        printf 'ROWCOUNT bad-name 3\n'
        printf ' ROWCOUNT t_d 4\n'
        printf 'ROWCOUNT t_e 9\r\n'
    } > "$log"
    want="$(fixture c9want 'ROWCOUNT t_a 120' 'ROWCOUNT t_b ERROR' 'ROWCOUNT t_e 9')"
    run_cmd "$HELPER" extract "$log"
    [ "$RC" -eq 0 ] && diff "$want" "$OUT" > /dev/null || return 1
    run_cmd "$HELPER" extract "$BASE_TMP/no-such.log"
    [ "$RC" -eq 2 ]
}
check "9 extract filters noise" case_9

# --- 10. snapshot records ERROR and keeps going ----------------------------------
case_10() {
    local want
    : > "$CALLS"
    want="$(fixture c10want \
        'ROWCOUNT t_a 120' 'ROWCOUNT t_fail ERROR' 'ROWCOUNT t_junk ERROR' \
        'ROWCOUNT x;DROP ERROR' 'ROWCOUNT t_b 0')"
    ROWCOUNT_MYSQL="$FAKE" run_cmd "$HELPER" snapshot db t_a t_fail t_junk 'x;DROP' t_b
    [ "$RC" -eq 0 ] && diff "$want" "$OUT" > /dev/null || return 1
    [ "$(wc -l < "$CALLS" | tr -d ' ')" -eq 4 ] || return 1
    ! grep -q 'DROP' "$CALLS" || return 1
    [ "$(grep -c -e '-N' -e '-B' "$CALLS")" -eq 4 ] && [ "$(grep -c ' db$' "$CALLS")" -eq 4 ] || return 1
    ROWCOUNT_MYSQL="$FAKE" run_cmd "$HELPER" snapshot db
    [ "$RC" -eq 2 ]
}
check "10 snapshot records ERROR and continues" case_10

# --- 11. dispatch guard ----------------------------------------------------------
case_11() {
    local sh=/bin/bash
    [ -x "$sh" ] || sh=bash
    "$sh" -s < "$HELPER" > "$OUT" 2> "$ERR" || return 1
    [ ! -s "$OUT" ] || return 1
    local want
    want="$(fixture c11want 'ROWCOUNT t_a 120' 'ROWCOUNT t_fail ERROR' 'ROWCOUNT t_b 0' 'AFTER')"
    {
        cat "$HELPER"
        printf 'set -euo pipefail\nrrc_snapshot db t_a t_fail t_b\necho AFTER\n'
    } | ROWCOUNT_MYSQL="$STDIN_FAKE" "$sh" -s > "$OUT" 2> "$ERR" || return 1
    diff "$want" "$OUT" > /dev/null
}
check "11 piped helper defines functions only and survives set -e" case_11

# --- 12. usage errors exit 2 -----------------------------------------------------
case_12() {
    local e a
    e="$(fixture c12e 'ROWCOUNT t_a 1')"
    a="$(fixture c12a 'ROWCOUNT t_a 1')"
    run_cmd "$HELPER"
    [ "$RC" -eq 2 ] && err_has usage || return 1
    run_cmd "$HELPER" bogus
    [ "$RC" -eq 2 ] && err_has usage || return 1
    run_cmd "$HELPER" compare "$e" "$a"
    [ "$RC" -eq 2 ] && err_has usage
}
check "12 usage errors exit 2" case_12

exit "$FAILED"
