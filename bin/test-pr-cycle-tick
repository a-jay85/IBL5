# --- stale post-plan-running sweep ----------------------------------------------------------
iso_ago() { jq -rn --argjson t $(( $(date +%s) - $1 * 60 )) '$t | todate'; }
rc_is() {  # rc_is <label> <want-rc> <cmd>...
    local label="$1" want="$2" got
    shift 2
    "$@" >/dev/null 2>&1; got=$?
    [[ $got -eq $want ]] || fail "$label: rc $got, want $want"
}
# sweep_fixture: PR 41 (worktree $WT) carries the label, 240 min old; PR 42 has no worktree
# and no label. Zone cooldown makes guard (b) exit right after the sweep, so every case also
# pins placement: the block moved below guard (b) loses its output.
sweep_fixture() {
    reset; set_out_root; E_ZONE=cooldown
    set_prs "41|branch-one|aaaaaaa|BEHIND|false" "42|branch-two|bbbbbbb|BEHIND|false"
    set_labels 41 post-plan-running auto-mergeable
    set_label_age 41 240
}
no_label_call() { [[ -z "$(label_log)" ]]; }
one_delete_41() { [[ "$(label_log)" == "DELETE 41 post-plan-running" ]]; }

reset; begin_case
# shellcheck source=/dev/null
. "$REPO/bin/lib/pr-cycle-watch.sh"
rc_is "label-too-young 179" 0 pcw_label_too_young "$(iso_ago 179)"
rc_is "label-too-young 180" 1 pcw_label_too_young "$(iso_ago 180)"
rc_is "label-too-young 240" 1 pcw_label_too_young "$(iso_ago 240)"
rc_is "label-too-young empty" 2 pcw_label_too_young ""
rc_is "label-too-young garbage" 2 pcw_label_too_young garbage
rc_is "label-age empty" 2 pcw_label_age_min ""
rc_is "label-age garbage" 2 pcw_label_age_min garbage
[[ "$(pcw_label_age_min "$(iso_ago 90)")" == "90" ]] || fail "label-age: 90 min old did not print 90"
PS_LINES="$(printf '%s\n' "11 /bin/bash -lc cd /wt/foo-bar && x" "12 sleep 1")"
rc_is "argv foo vs foo-bar" 1 pcw_postplan_argv_live /wt/foo s "$PS_LINES"
rc_is "argv foo exact" 0 pcw_postplan_argv_live /wt/foo-bar s "$PS_LINES"
rc_is "argv foo child path" 0 pcw_postplan_argv_live /wt/foo-bar s "13 /bin/bash -lc cd /wt/foo-bar/ibl5 && x"
rc_is "argv foo exact (no foo-bar)" 0 pcw_postplan_argv_live /wt/foo s "13 /bin/bash -lc cd /wt/foo && x"
rc_is "argv /x/foo vs /x/foo-bar" 1 pcw_postplan_argv_live /x/foo s "13 /bin/bash -lc cd /x/foo-bar && x"
rc_is "argv /x/foo exact" 0 pcw_postplan_argv_live /x/foo s "13 /bin/bash -lc cd /x/foo && x"
rc_is "argv /x/foo child /x/foo/ibl5" 0 pcw_postplan_argv_live /x/foo s "13 /bin/bash -lc cd /x/foo/ibl5 && x"
rc_is "argv log token" 0 pcw_postplan_argv_live "" foo "14 tail /logs/post-plan-now-foo-20261018-004740-25853.log"
rc_is "argv run-dir token" 0 pcw_postplan_argv_live "" foo "15 py tools/postplan-harness/out/live-foo-20261018-004740"
rc_is "argv slug boundary" 1 pcw_postplan_argv_live "" foo "16 tail /logs/post-plan-now-foo-bar-20261018-004740-25853.log"
rc_is "argv empty text" 2 pcw_postplan_argv_live "" foo ""
rc_is "argv excluded pid" 1 pcw_postplan_argv_live "" foo "77 py out/live-foo-20261018-004740" "77 5"
rc_is "argv not-excluded pid" 0 pcw_postplan_argv_live "" foo "78 py out/live-foo-20261018-004740" "77 5"
CLP="$(pcw_claude_print_pids "$(printf '%s\n' "4242 /usr/local/bin/claude -p prompt --session-id x" "4243 claude" "4244 /opt/claude-launcher --print")")"
[[ "$CLP" == "4242" ]] || fail "claude-print-pids: printed '$CLP', want 4242"
rc_is "claude-print-pids interactive" 1 pcw_claude_print_pids "4243 claude"
rc_is "claude-print-pids launcher" 1 pcw_claude_print_pids "4244 /opt/claude-launcher --print"
rc_is "claude-print-pids --print" 0 pcw_claude_print_pids "4245 claude --print hi"
rc_is "claude-print-pids empty" 2 pcw_claude_print_pids ""
rc_is "cwd in worktree" 0 pcw_cwd_in_worktree /wt/foo "$(printf 'p4242\nfcwd\nn/wt/foo/ibl5')"
rc_is "cwd in worktree root" 0 pcw_cwd_in_worktree /wt/foo "$(printf 'p4242\nfcwd\nn/wt/foo')"
rc_is "cwd foo-bar" 1 pcw_cwd_in_worktree /wt/foo "$(printf 'p4242\nfcwd\nn/wt/foo-bar')"
rc_is "cwd empty text" 2 pcw_cwd_in_worktree /wt/foo ""
rc_is "cwd empty root" 2 pcw_cwd_in_worktree "" "$(printf 'n/wt/foo')"
POUT="$SCRATCH/pout"
rm -rf "$POUT"
rc_is "out-dir root absent" 2 pcw_live_out_dir_fresh foo "$POUT"
mkdir -p "$POUT/live-foo-20261018-000000"
: > "$POUT/live-foo-20261018-000000/f"
OLD_ST="$(_stamp_at $(( $(date +%s) - 240 * 60 )))"
touch -t "$OLD_ST" "$POUT/live-foo-20261018-000000/f" "$POUT/live-foo-20261018-000000"
rc_is "out-dir 4h old" 1 pcw_live_out_dir_fresh foo "$POUT"
touch "$POUT/live-foo-20261018-000000/f"
rc_is "out-dir touched" 0 pcw_live_out_dir_fresh foo "$POUT"
rc_is "out-dir other branch" 1 pcw_live_out_dir_fresh baz "$POUT"
rm -rf "$POUT"
# gh shim self-tests: a later edit that breaks the shim must fail here, not in the tick.
set_label_age 7 240 600
SHIM_TL="$(env PATH="$SHIMS:$PATH" gh api repos/o/r/issues/7/timeline --paginate \
    --jq '.[] | select(.event=="labeled" and .label.name=="post-plan-running") | .created_at')"
[[ "$(wc -l <<< "$SHIM_TL" | tr -d ' ')" == "2" ]] || fail "gh-shim: --jq timeline printed '$SHIM_TL', want two dates"
set_timeline_fail 7
SHIM_OUT="$(env PATH="$SHIMS:$PATH" gh api repos/o/r/issues/7/timeline --paginate 2>/dev/null)"; SHIM_RC=$?
[[ $SHIM_RC -eq 1 && -z "$SHIM_OUT" ]] || fail "gh-shim: timeline-fail gave rc $SHIM_RC out '$SHIM_OUT'"
end_case sweep-predicates

