assert_match  "S2 real payload ALLCHECKS=green" '^green$'   "$(row_col "$OUT" 71 ALLCHECKS)"
assert_match  "S2 real payload bucket=ARMABLE"  '^ARMABLE$' "$(row_bucket "$OUT" 71)"
assert_match  "S2 real payload arms"            'pr merge'  "$(cat "$FIX/calls.log")"
assert_status "S2 exit 0"                       0           "$ST"

# --- S3: status pending -> pending, BLOCKED-CHECK, never arms ---
