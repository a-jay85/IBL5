#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-postplan-arm-conditions — regression guard for the fallback /post-plan skill
# and the shared arming predicates it no longer carries.
#
# The compiled harness (tools/postplan-harness) owns arming; its pytest suite covers
# conditions 1-18, Phase 5.0 conformance, and the Phase 2/6/7 flows. What stays here:
#   - the shared predicates in bin/lib/pr-armable.sh (exit-status invariant, Manual-Testing
#     clearance), plus the bin/pr-triage merge-state allowlist and clearance wiring;
#   - bin/lib/critical-files.sh and bin/lib/plan-scope-conformance, driven directly;
#   - the Phase 5.5 fidelity blocks in _phase-5.5-fidelity.md and the /plan SKILL.md pins;
#   - a guard that the fallback skill (.claude/skills/post-plan) carries no arming logic.
#
# Run: bin/test-postplan-arm-conditions  (exit 0 = all pass, 1 = a case failed)

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
P55_SKILL="$REPO_ROOT/.claude/skills/post-plan/_phase-5.5-fidelity.md"
PLAN_SKILL="$REPO_ROOT/.claude/skills/plan/SKILL.md"

BASE_TMP="$(mktemp -d)"
trap 'rm -rf "$BASE_TMP"' EXIT
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/usage-test-isolation.sh"; usage_test_isolate "$BASE_TMP/usage"
FAILED=0

# A gh shim emulating the only calls the condition blocks make:
#   gh pr diff --name-only               -> $GH_DIFF_FIXTURE contents (or exit 1 if unset/missing)
#   gh pr view <n> --json state          -> predecessor state (#1100 OPEN else MERGED)
#   gh pr view --json <fields> --jq F    -> jq -r F applied to $GH_PR_FIXTURE
#   gh pr edit --body-file|--body       -> appends the body to $GH_EDIT_RECORD
SHIMD="$BASE_TMP/shim"
mkdir -p "$SHIMD"
cat > "$SHIMD/gh" <<'SHIM'
#!/usr/bin/env bash
if [ "$1" = "pr" ] && [ "$2" = "diff" ]; then
  # gh pr diff --name-only -> the fixture path list. An unset/missing fixture
  # emulates a gh failure (no PR, network error), which the Phase 2.5 block must
  # survive with BL_TRIGGER=none rather than aborting.
  [ -n "${GH_DIFF_FIXTURE:-}" ] && [ -f "$GH_DIFF_FIXTURE" ] || exit 1
  cat "$GH_DIFF_FIXTURE"
  exit 0
fi
if [ "$1" = "pr" ] && [ "$2" = "view" ]; then
  # GH_PR_FAIL set -> emulate an unreadable PR body (condition (17) fail-closed case).
  [ -n "${GH_PR_FAIL:-}" ] && exit 1
  if [[ "$3" =~ ^[0-9]+$ ]]; then
    case "$3" in 1100) echo '{"state":"OPEN"}' ;; *) echo '{"state":"MERGED"}' ;; esac
    exit 0
  fi
  filter='.'
  for ((i=1; i<=$#; i++)); do
    if [ "${!i}" = "--jq" ]; then j=$((i+1)); filter="${!j}"; fi
  done
  jq -r "$filter" "$GH_PR_FIXTURE"
  exit 0
fi
if [ "$1" = "pr" ] && [ "$2" = "edit" ]; then
  # Record what post-plan would have written, so a repair write is observable.
  for ((i=1; i<=$#; i++)); do
    if [ "${!i}" = "--body-file" ]; then j=$((i+1)); cat "${!j}" >> "${GH_EDIT_RECORD:-/dev/null}"; fi
    if [ "${!i}" = "--body" ];      then j=$((i+1)); printf '%s' "${!j}" >> "${GH_EDIT_RECORD:-/dev/null}"; fi
  done
  exit 0
fi
if [ "$1" = "api" ] && [[ "$2" == repos/*/branches/master ]]; then
  # gh api repos/<slug>/branches/master --jq F -> jq -r F over GH_PROTECTION_FIXTURE,
  # or exit 1 when unset/missing (unreadable protection -> pr_aggregator_required fails closed).
  [ -n "${GH_PROTECTION_FIXTURE:-}" ] && [ -f "$GH_PROTECTION_FIXTURE" ] || exit 1
  filter='.'
  for ((i=1; i<=$#; i++)); do
    if [ "${!i}" = "--jq" ]; then j=$((i+1)); filter="${!j}"; fi
  done
  jq -r "$filter" "$GH_PROTECTION_FIXTURE"
  exit 0
fi
if [ "$1" = "pr" ] && [ "$2" = "checks" ]; then
  # gh pr checks <pr> --json name,bucket -> GH_CHECKS_FIXTURE contents, or exit 1 if unset/missing.
  # pr_red_check_hold is fail-open on exit 1, so an unset fixture exercises the clear path.
  [ -n "${GH_CHECKS_FIXTURE:-}" ] && [ -f "$GH_CHECKS_FIXTURE" ] || exit 1
  cat "$GH_CHECKS_FIXTURE"
  # REAL gh EXITS 8 WHEN ANY CHECK IS FAILING. The shim must model that or the
  # (15) cases below pass against a predicate that is a no-op in production: a
  # `return 0 on any non-zero rc` guard swallows exactly the red-check payload.
  # Caught in review on the first cut of pr_red_check_hold; keep this arm.
  grep -q '"bucket"[[:space:]]*:[[:space:]]*"fail"' "$GH_CHECKS_FIXTURE" && exit 8
  exit 0
fi
exit 1
SHIM
chmod +x "$SHIMD/gh"

# extract_block <literal-marker> [file] — print the first ```bash fenced block
# whose body contains the literal marker substring (e.g. "# condition (8)").
# Uses index() (literal), not regex, so the parens in the marker are matched
# verbatim. The file argument is required.
extract_block() {
    awk -v want="$1" '
        /^```bash$/ { inb=1; buf=""; next }
        /^```$/     { if (inb && index(buf, want) > 0) { printf "%s", buf } ; inb=0; next }
        inb         { buf = buf $0 "\n" }
    ' "$2"
}

run_p55() {
    local vf="$BASE_TMP/p55-verdict.md"
    mk_verdict_fixture "$2" "$vf"
    printf '{"number":2100}' > "$BASE_TMP/fixture.json"
    PATH="$SHIMD:$PATH" GH_PR_FIXTURE="$BASE_TMP/fixture.json" \
        FIDELITY_VERDICT_FILE="$vf" bash -c "$1" 2>&1
}
# run_findings <block> <fixture-kind|absent> <spawn|skip> — run the Phase 5.8
# findings-render block in its own shell.  Writes the -2 fixture (when kind !=
# absent) to $BASE_TMP/findings-verdict-2.md via mk_verdict_fixture.  Substitutes
# the block's hardcoded VERDICT_2_FILE= assignment with a $BASE_TMP-scoped path so
# no /tmp verdict-path collision is possible.  spawn + real fixture (mode=spawn,
# kind!=absent): block's VERDICT_2_FILE points to the fixture.  mode=skip or
# kind=absent: block's VERDICT_2_FILE points to findings-verdict-2-none.md (never
# written), so the block always sees a missing file on both paths — skip and absent
# are behaviorally identical here.  Skip mode is guarded structurally (case 4).
# Exports FIDELITY_VERDICT_FILE_2 (unset when kind=absent) and RE_REVIEW for seam
# completeness.  Always exits 0 so callers can use $() capture freely.
run_findings() {
    local blk="$1" kind="$2" mode="$3"
    local vf2="$BASE_TMP/findings-verdict-2.md"
    local vf2_none="$BASE_TMP/findings-verdict-2-none.md"
    mk_verdict_fixture "$kind" "$vf2"
    local sub_path
    if [ "$mode" = "spawn" ] && [ "$kind" != "absent" ]; then
        sub_path="$vf2"
    else
        sub_path="$vf2_none"
    fi
    local exec_blk
    exec_blk="$(printf '%s' "$blk" | sed 's|VERDICT_2_FILE="[^"]*"|VERDICT_2_FILE="'"$sub_path"'"|')"
    if [ "$kind" = "absent" ]; then
        bash -c "$exec_blk" 2>&1 || true
    else
        FIDELITY_VERDICT_FILE_2="$vf2" RE_REVIEW="$mode" bash -c "$exec_blk" 2>&1 || true
    fi
}
# compose_fixture_body <re-reviewed-line|""> <raw-run-findings-output> — emit the
# Step-6 sticky-comment body template with distinguishable sentinel values for the
# five digest labels.  Extracts findings content from the second arg (lines after
# the '--- V2_FINDINGS ---' marker produced by the render block); embeds them in
# template order before ### Merge digest.  When the second arg carries no
# '--- V2_FINDINGS ---' marker the findings slot is omitted entirely.
# Template order: banner, `Findings: none.`, findings slot, ### Merge digest and its
# five labels, `---`, the <details> audit trail holding **Reviewed tree:** and
# **Re-reviewed tree:**, terminal line, marker.
compose_fixture_body() {
    local rr_line="$1" raw_slot="$2"
    local slot=""
    if grep -q '^--- V2_FINDINGS ---$' <<< "$raw_slot"; then
        slot="$(awk '/^--- V2_FINDINGS ---$/{found=1;next} found{print}' <<< "$raw_slot")"
    fi
    printf '**READY** — 2026-09-30 00:00:00 UTC\n'
    printf '\n'
    printf 'Findings: none.\n'
    if [ -n "$slot" ]; then
        printf '\n'
        printf '%s\n' "$slot"
        printf '\n'
    fi
    printf '\n'
    printf '### Merge digest\n'
    printf '**What changed:** WC-VAL\n'
    printf '**Why:** WHY-VAL\n'
    printf '**Watch:** WATCH-VAL\n'
    printf '**Touches:** TOUCH-VAL\n'
    printf '**Machine-authored fixes:** MAF-VAL\n'
    printf '\n'
    printf '%s\n' '---'
    printf '\n'
    printf '<details><summary>Audit trail</summary>\n'
    printf '\n'
    printf '**Reviewed tree:** deadbeef0000\n'
    [ -n "$rr_line" ] && printf '%s\n' "$rr_line"
    printf '\n'
    printf '</details>\n'
    printf '\n'
    printf ': READY — synthetic terminal line.\n'
    printf '<!-- pr-ready-verdict -->\n'
}
# Binding loop: assert each composer token still appears in $P55_SKILL so the
# fixture cannot silently drift from the live template (same shape as the
# 'REVIEWED_TREE=' / 'Re-reviewed tree:' prose loop above).
for _cft in \
    '**What changed:**' \
    '**Why:**' \
    '**Watch:**' \
    '**Touches:**' \
    '**Machine-authored fixes:**' \
    '### Merge digest' \
    '<details><summary>Audit trail</summary>' \
    '**Re-reviewed tree:**'; do
    grep -qF "$_cft" "$P55_SKILL" || {
        echo "FAIL: compose_fixture_body binding — '$_cft' no longer in $P55_SKILL; update composer to match"
        FAILED=1
    }
done
expect_fidelity() {
    if printf '%s' "$3" | grep -qxF "FIDELITY=$2"; then
        echo "ok: $1"
    else
        echo "FAIL: $1 — expected FIDELITY=$2, got: '$3'"
        FAILED=1
    fi
}

# expect_rc0 <name> <predicate call> — assert a pr-armable.sh predicate exits 0 on
# its CLEAR path (found nothing to hold).
#
# Why a dedicated runner: the harness-retired Phase 6.5 blocks PIPE the predicate
# (`pr_dep_holds ... | while read`), which DISCARDS its exit status, so a block-driven
# case passes against a predicate that returns 1. bin/pr-triage
# is the caller that cares: it CAPTURES the predicate (`deps="$(pr_dep_holds ...)"`)
# under `set -euo pipefail`, where a nonzero rc aborts the whole cross-PR sweep
# mid-loop. pr_dep_holds did exactly that from its introduction until 2026-08-22 (a
# trailing bare `[ "$st" != "MERGED" ] && echo` as the last command in its `while`
# body), silently hiding 25 of 30 open PRs behind a table that looked complete.
# The defect CLASS is "predicate returns nonzero when clear", so assert it for all six.
expect_rc0() { # name  predicate-call
    local script="$BASE_TMP/rc0.sh" out
    {
        echo 'set -euo pipefail'
        echo "source '$REPO_ROOT/bin/lib/pr-armable.sh'"
        # Capture exactly as bin/pr-triage does — the shape that makes rc load-bearing.
        echo "captured=\"\$($2 | tr '\\n' ' ')\""
        echo 'printf "%s" "$captured"'
    } > "$script"
    if out="$(PATH="$SHIMD:$PATH" bash "$script" 2>&1)"; then
        echo "ok: $1"
    else
        echo "FAIL: $1 — predicate exited nonzero on its clear path; captured under"
        echo "      set -euo pipefail this ABORTS bin/pr-triage's sweep. output: '$out'"
        FAILED=1
    fi
}

# expect_mss <name> <mergeStateStatus> <block|arm> — exercise bin/pr-triage's
# mss_blocks_merge allowlist. Extracted rather than sourced because bin/pr-triage is
# an executable script, not a lib; the extraction is anchored on the function's own
# `name() {` .. `}` lines, so a rename fails loudly here instead of silently passing.
expect_mss() { # name  mss  block|arm
    local fn script="$BASE_TMP/mss.sh" rc=0
    fn="$(sed -n '/^mss_blocks_merge() {/,/^}/p' "$REPO_ROOT/bin/pr-triage")"
    if [ -z "$fn" ]; then
        echo "FAIL: $1 — mss_blocks_merge() not found in bin/pr-triage"
        FAILED=1
        return
    fi
    printf '%s\nmss_blocks_merge "%s"\n' "$fn" "$2" > "$script"
    bash "$script" || rc=$?
    if { [ "$3" = "block" ] && [ "$rc" -eq 0 ]; } || { [ "$3" = "arm" ] && [ "$rc" -ne 0 ]; }; then
        echo "ok: $1"
    else
        echo "FAIL: $1 — mergeStateStatus=$2 expected to $3, but mss_blocks_merge returned $rc"
        FAILED=1
    fi
}

mk_verdict_fixture() {
    rm -f "$2"
    case "$1" in
        ready)       printf 'Findings: none.\n\nREADY\n\n## DIGEST\n**What changed:** x\n' > "$2" ;;
        notes)       printf 'Findings: two advisory notes.\n\nREADY WITH NOTES\n\n## DIGEST\n**What changed:** x\n' > "$2" ;;
        notready)    printf 'Findings: intent gap on phase 3.\n\nNOT READY\n\n## DIGEST\n**What changed:** x\n' > "$2" ;;
        noverdict)   printf 'Findings: prose only, reviewer never emitted a verdict word.\n\n## DIGEST\n**What changed:** x\n' > "$2" ;;
        digestready)    printf 'Findings: intent gap.\n\nNOT READY\n\n## DIGEST\n**What changed:** the READY gate\n' > "$2" ;;
        findings)       printf 'READY\n\n## FINDINGS\n\nXYZZY-FINDING-SENTINEL\n\nSome finding detail.\n\n## DIGEST\n**What changed:** x\n' > "$2" ;;
        findingsempty)  printf 'READY\n\n## FINDINGS\n\n## DIGEST\n**What changed:** x\n' > "$2" ;;
        empty)          : > "$2" ;;
        absent)      ;;
    esac
}

B55="$(extract_block '# phase 5.5 verdict parse' "$P55_SKILL")"
# The findings-render block added in Phase 2. The literal marker is the ONLY binding
# between the spec and this suite: if Phase 2's fence carries a different first-line
# comment, change the FENCE to match this string — never the other way round.
B58F="$(extract_block '# phase 5.8 findings render' "$P55_SKILL")"
if [ -z "$B58F" ]; then
    echo "FAIL: no block matching '# phase 5.8 findings render' in $P55_SKILL — marker drifted"
    FAILED=1
fi

# --- Critical Files parser: bin/lib/critical-files.sh vs planfile.py agreement ----
# TWO-WAY AGREEMENT. Every shape below is corpus-derived; the indented entry
# pins the leading-whitespace divergence check-plan's old `^- ` awk had.
CF_FIX="$BASE_TMP/cf-agreement.md"
cat > "$CF_FIX" <<'CFEOF'
````bash
# Outer 4-backtick fence: contains a decoy ## Critical Files heading.
# Width-aware fence regression — naive parity toggle would swallow real section.
```text
inner 3-backtick block — fence_len=3 < 4, does NOT close the outer fence
```
## Critical Files

- `decoy01` (reference)
- `decoy02` — decoy must-appear inside fence, must be ignored

````

## Critical Files

- `bin/check-plan` — add gate [F]
- `ibl5/schema.sql` (reference)
- `ibl5/docs/README.md` (conditional)
- `ibl5/docs/other.md` (conditional — only if diff touches it)
- `tools/postplan-harness/harness/planfile.py` (read-only reference)
- `ibl5/a.php` — add the context menu helper
- `ibl5/b.php` (reference — pattern to mirror; unchanged)
  - `ibl5/c.php` — indented change target
- `ibl5/d.php` (conditional Phase 4 only)
- `ibl5/e.php` (filename references the affected class)
CFEOF

CF_LIB=$( cd "$REPO_ROOT" && bash -c 'source bin/lib/critical-files.sh && cf_parse_section "$1"' _ "$CF_FIX" \
            | sed -n 's/^MUST_APPEAR://p' )
CF_PY=$( cd "$REPO_ROOT/tools/postplan-harness" && python3 -c '
import sys
from harness.planfile import parse_critical_files
for p, _a, ex in parse_critical_files(open(sys.argv[1]).read()):
    if not ex:
        print(p)
' "$CF_FIX" )

if [ "$CF_LIB" = "$CF_PY" ]; then
    echo "ok: parser agreement (lib == planfile.py)"
else
    echo "FAIL: parser divergence"
    echo "  lib:   $(printf '%s' "$CF_LIB"   | tr '\n' ' ')"
    echo "  py:    $(printf '%s' "$CF_PY"    | tr '\n' ' ')"
    FAILED=1
fi

# Negative half: the agreement must be on the RIGHT answer, not merely mutual.
# Five prose/described entries are must-appear; five marked entries are not.
# decoy01/decoy02 (inside the 4-backtick fence) must contribute zero entries.
_want=$(printf 'bin/check-plan\nibl5/a.php\nibl5/c.php\nibl5/d.php\nibl5/e.php')
if [ "$CF_LIB" = "$_want" ]; then
    echo "ok: agreed classification is correct (5 must-appear, 5 exempt)"
else
    echo "FAIL: agreed-but-wrong — expected 5 must-appear, got: $(printf '%s' "$CF_LIB" | tr '\n' ' ')"
    FAILED=1
fi

# --- backlog#1211: absolute Critical Files paths normalise to repo-relative --
# Shapes mirror tests/test_planfile.py::ABS_PARITY_CASES. Every consumer of
# cf_parse_section (Phase 5.0, CF_PRINT_ONLY, gate [C]) sees the stripped form;
# only gate [F] reads cf_parse_section_raw.
CF_ABS="$BASE_TMP/cf-abs.md"
cat > "$CF_ABS" <<'CFEOF'
## Critical Files

- `/Users/ajaynicolas/GitHub/IBL5/ibl5/classes/Foo.php` — main checkout
- `/Users/ajaynicolas/GitHub/IBL5-worktrees/my-slug/bin/check-plan` — worktree
- `/a/IBL5/b/IBL5/c` — greedy: last root wins
- `/a/IBL5-worktrees/x` — no slash after the slug: unchanged
- `/a/IBL5` — no trailing slash: unchanged
- `/a/ibl5/y` — lowercase: unchanged
- `/Users/ajaynicolas/claude-plans/z.md` — out-of-repo: unchanged
- `docs/IBL5/rel.md` — relative with IBL5 mid-string: unchanged
- `ibl5/schema.sql` (reference)
CFEOF
_abs_lib=$( cd "$REPO_ROOT" && bash -c 'source bin/lib/critical-files.sh && cf_parse_section "$1"' _ "$CF_ABS" )
_abs_want=$(printf '%s\n' \
    'MUST_APPEAR:ibl5/classes/Foo.php' \
    'MUST_APPEAR:bin/check-plan' \
    'MUST_APPEAR:c' \
    'MUST_APPEAR:/a/IBL5-worktrees/x' \
    'MUST_APPEAR:/a/IBL5' \
    'MUST_APPEAR:/a/ibl5/y' \
    'MUST_APPEAR:/Users/ajaynicolas/claude-plans/z.md' \
    'MUST_APPEAR:docs/IBL5/rel.md' \
    'EXEMPT:ibl5/schema.sql')
if [ "$_abs_lib" = "$_abs_want" ]; then
    echo "ok: cf-abs lib normalises absolute paths (5 unchanged edge shapes, 3 stripped)"
else
    echo "FAIL: cf-abs lib — got: $(printf '%s' "$_abs_lib" | tr '\n' ' ')"; FAILED=1
fi

# Agreement holds on the absolute fixture too.
_abs_lib_ma=$(printf '%s\n' "$_abs_lib" | sed -n 's/^MUST_APPEAR://p')
_abs_py=$( cd "$REPO_ROOT/tools/postplan-harness" && python3 -c '
import sys
from harness.planfile import parse_critical_files
for p, _a, ex in parse_critical_files(open(sys.argv[1]).read()):
    if not ex:
        print(p)
' "$CF_ABS" )
if [ "$_abs_lib_ma" = "$_abs_py" ]; then
    echo "ok: cf-abs parser agreement on absolute paths (lib == planfile.py)"
else
    echo "FAIL: cf-abs parser divergence"
    echo "  lib:   $(printf '%s' "$_abs_lib_ma" | tr '\n' ' ')"
    echo "  py:    $(printf '%s' "$_abs_py"     | tr '\n' ' ')"
    FAILED=1
fi

# Empty-result edge: a bare root entry stays as written (fail-closed). Python
# returns "" here; the divergence is deliberate and pinned on both sides
# (tests/test_planfile.py::test_lib_empty_normalisation_divergence_pinned).
CF_ROOT="$BASE_TMP/cf-root.md"
printf '## Critical Files\n\n- `/Users/ajaynicolas/GitHub/IBL5/`\n' > "$CF_ROOT"
_root=$( cd "$REPO_ROOT" && bash -c 'source bin/lib/critical-files.sh && cf_parse_section "$1"' _ "$CF_ROOT" )
if [ "$_root" = 'MUST_APPEAR:/Users/ajaynicolas/GitHub/IBL5/' ]; then
    echo "ok: cf-abs bare root entry passes through unchanged (no empty MUST_APPEAR row)"
else
    echo "FAIL: cf-abs bare root — got: '$_root'"; FAILED=1
fi

# Raw entry point is byte-identical to the pre-#1211 parser (gate [F]'s view).
_raw=$( cd "$REPO_ROOT" && bash -c 'source bin/lib/critical-files.sh && cf_parse_section_raw "$1"' _ "$CF_ABS" | head -1 )
if [ "$_raw" = 'MUST_APPEAR:/Users/ajaynicolas/GitHub/IBL5/ibl5/classes/Foo.php' ]; then
    echo "ok: cf-abs cf_parse_section_raw keeps the absolute path"
else
    echo "FAIL: cf-abs raw — got: '$_raw'"; FAILED=1
fi

# --- plan-scope-conformance helper wiring + direct conformance case ---
# The Phase 5.0 skill block is gone (the harness owns conformance). These checks pin the
# helper itself, and the direct case below replaces the old block-driven U1 case.
if grep -v '^[[:space:]]*#' "$REPO_ROOT/bin/lib/plan-scope-conformance" \
        | grep -qE '^[[:space:]]*(source|\.)[[:space:]].*critical-files\.sh'; then
    echo "ok: plan-scope-conformance helper sources bin/lib/critical-files.sh"
else
    echo "FAIL: plan-scope-conformance helper does not source bin/lib/critical-files.sh"; FAILED=1
fi
_ub_no_comments="$(grep -v '^[[:space:]]*#' "$REPO_ROOT/bin/lib/plan-scope-conformance")"
if grep -qF 'cf_is_exempt' <<< "$_ub_no_comments"; then
    echo "FAIL: plan-scope-conformance helper filters on cf_is_exempt (polarity inversion)"; FAILED=1
else
    echo "ok: plan-scope-conformance helper does not call cf_is_exempt (polarity correct)"
fi

# plan_scope_conformance_direct (formerly U1, which drove the helper through the deleted
# Phase 5.0 block): both parse verdicts count as planned (MUST_APPEAR and EXEMPT both
# dismiss); the unplanned .claude/ path holds, the unplanned non-.claude/ path is a note.
_u1_plan="$BASE_TMP/u1-plan.md"
_u1_changed="$BASE_TMP/u1-changed.txt"
_u1_body="$BASE_TMP/u1-body.md"
_u1_added="$BASE_TMP/u1-added.txt"
cat > "$_u1_plan" <<'U1PLANEOF'
## Critical Files

- `.claude/skills/post-plan/SKILL.md` — add paragraph
- `.claude/rules/doc-freshness.md` (reference)
U1PLANEOF
printf '%s\n' \
    '.claude/skills/post-plan/SKILL.md' \
    '.claude/rules/doc-freshness.md' \
    '.claude/rules/rogue.md' \
    'ibl5/index.php' > "$_u1_changed"
printf 'no scope section\n' > "$_u1_body"
: > "$_u1_added"
_u1_out="$("$REPO_ROOT/bin/lib/plan-scope-conformance" "$_u1_plan" "$_u1_changed" "$_u1_body" "$_u1_added" 2>&1)"
_u1_count="$(grep -c '^UNPLANNED-FILE:' <<< "$_u1_out" || true)"
if [ "$_u1_count" -eq 1 ] \
        && grep -qF 'UNPLANNED-FILE: .claude/rules/rogue.md' <<< "$_u1_out" \
        && grep -qF 'SCOPE-NOTE: unplanned ibl5/index.php' <<< "$_u1_out" \
        && ! grep -q '^UNPLANNED-FILE:.*ibl5/index.php' <<< "$_u1_out" \
        && ! grep -qF 'SKILL.md' <<< "$_u1_out" \
        && ! grep -qF 'doc-freshness.md' <<< "$_u1_out"; then
    echo "ok: plan_scope_conformance_direct"
else
    echo "FAIL: plan_scope_conformance_direct — expected 1 UNPLANNED-FILE: naming rogue.md plus SCOPE-NOTE: unplanned ibl5/index.php, got: '$_u1_out'"
    FAILED=1
fi

# ── plan-scope-conformance helper ──
# S1..S9 call bin/lib/plan-scope-conformance directly. The Phase 5.0 block and
