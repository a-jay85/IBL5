#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-automouse-canary — regression test for the between-plans master
# health canary in bin/automouse/run (run_between_plans_canary,
# write_canary_park_report, and the loop-bottom dispatch block).
#
# The canary runs at a plan boundary, freshens the main checkout's master, and
# checks two signals: bin/check-master-ci-green, then a curl smoke (15s per
# try, up to 3 tries on curl exit 7 or 28) against
# the main Docker stack. A genuinely red signal PARKS the queue — the loop
# breaks, every remaining plan stays in queue/, and no attempt counter moves.
#
# The load-bearing polarity this locks: bin/check-master-ci-green exits 1 for
# THREE distinct conditions, and only "checks failed:" means master is poisoned.
# "checks still running:" and "check-run(s) found" mean the verdict is not known
# yet — and /post-plan arms `gh pr merge --auto` BEFORE watching CI, so a
# just-merged master is pending at exactly this moment on every successful
# night. Parking on pending would convert the loop's own success into a stall,
# so those two return 4 (proceed with a warning) instead of 1 (park).
#
# Since the post-merge jobs `deploy` and `Promote master to production` are
# pending at every boundary, the canary passes
# IGNORE_PENDING_CHECKS="deploy,Promote master to production" to the script.
# Those two names are dropped ONLY while status != completed; a completed red
# run of either is still "checks failed:" and parks. Cases 12-15 pin the exact
# list the canary passes and drive the real script through the extracted
# function for green / red / non-listed-pending.
# The canary also passes IGNORE_FAILED_CHECKS="Keep the merge-line head
# current": a COMPLETED red run of that helper workflow (it tests no code) no
# longer parks. Case 12 pins that exact list too; cases 16-18 drive the real
# script for helper-red (green), helper-red plus real-red (parks), and
# helper-pending (proceeds with a warning, as before).
#
# Cases 8 and 9 run the REAL bin/check-master-ci-green against fixture JSON via
# its documented GH_API_CMD stub, so the two stderr strings the proceed/park
# split keys on are pinned to the shipped implementation rather than to a stub.
# A reword of those messages fails here instead of silently flipping polarity.
#
# The two functions are EXTRACTED from bin/automouse/run and eval'd rather than
# copied, so the test can never drift from the implementation.
#
# Run: bin/test-automouse-canary  (exit 0 = all pass, 1 = a case failed)

set -u
# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
RUNNER="$SCRIPT_DIR/automouse/run"
GREEN="$SCRIPT_DIR/check-master-ci-green"

if [ ! -f "$RUNNER" ]; then
    echo "FAIL: cannot find $RUNNER"
    exit 1
fi

h_tmp TMP

# --- extract the implementation under test -------------------------------

# extract_fn <name> — from the definition line to the first lone `}`.
extract_fn() {
    awk -v fn="$1" '
        $0 ~ "^" fn "\\(\\) \\{" { capture = 1 }
        capture { print }
        capture && /^\}/ { exit }
    ' "$RUNNER"
}

for fn in write_canary_park_report run_between_plans_canary; do
    FN_SRC="$(extract_fn "$fn")"
    if [ -z "$FN_SRC" ]; then
        echo "FAIL: could not extract $fn from $RUNNER"
        exit 1
    fi
    eval "$FN_SRC"
done

# --- assertion helpers ---------------------------------------------------

expect() { # label want got
    if [ "$2" -eq "$3" ]; then h_pass "$1"
    else h_fail "$1" "want exit $2, got $3"; fi
}
want() { h_contains "$1" "$2" "$3"; }  # label haystack needle
refuse() { h_not_contains "$1" "$2" "$3"; }  # label haystack needle (needle must be ABSENT)
same() { h_eq "$1" "$2" "$3"; }  # label want got
curl_calls() { cat "$TMP/curl-calls" 2>/dev/null || echo 0; }
sleep_args() { cat "$TMP/sleep-args" 2>/dev/null || true; }
retry_lines() { grep -c 'canary: smoke try ' "$LOG" || true; }

# --- per-case sandbox ----------------------------------------------------

# A PATH-prepended curl stub. Every call bumps $TMP/curl-calls and appends its
# argv to $TMP/curl-args. Exit code: line N of $TMP/curl-seq when that file
# exists (the last line repeats past the end), else the single code in
# $TMP/curl-rc. A case can flip the smoke signal without rebuilding the sandbox.
STUBBIN="$TMP/stubbin"
mkdir -p "$STUBBIN"
cat > "$STUBBIN/curl" <<'STUBEOF'
#!/bin/sh
d="$CANARY_TEST_TMP"
n=$(( $(cat "$d/curl-calls" 2>/dev/null || echo 0) + 1 ))
printf '%s\n' "$n" > "$d/curl-calls"
printf '%s\n' "$*" >> "$d/curl-args"
if [ -f "$d/curl-seq" ]; then
    rc=$(sed -n "${n}p" "$d/curl-seq")
    [ -n "$rc" ] || rc=$(tail -n 1 "$d/curl-seq")
    exit "$rc"
fi
exit "$(cat "$d/curl-rc" 2>/dev/null || echo 0)"
STUBEOF
chmod +x "$STUBBIN/curl"

# A PATH-prepended sleep stub: records its argument and returns at once, so the
# retry back-off is assertable and costs no wall time. Nothing else this test
# drives calls sleep (bin/check-master-ci-green has no sleep call).
cat > "$STUBBIN/sleep" <<'STUBEOF'
#!/bin/sh
printf '%s\n' "$1" >> "$CANARY_TEST_TMP/sleep-args"
exit 0
STUBEOF
chmod +x "$STUBBIN/sleep"
export PATH="$STUBBIN:$PATH"
export CANARY_TEST_TMP="$TMP"
export AUTOMOUSE_CANARY_RETRY_SLEEP=0

CASE_N=0

# setup_case <ci-stderr-text> <ci-exit> <curl-exit>
# Builds a fresh REPO/NIGHTLY_DIR/QUEUE_DIR/LOG sandbox and a
# $REPO/bin/check-master-ci-green stub. Populates the queue with two real plan
# files plus a matching .attempts counter so the queue-unchanged assertion is
# behavioural, not vacuous.
setup_case() {
    CASE_N=$(( CASE_N + 1 ))
    SANDBOX="$TMP/case$CASE_N"
    REPO="$SANDBOX/repo"
    NIGHTLY_DIR="$SANDBOX/nightly"
    QUEUE_DIR="$NIGHTLY_DIR/queue"
    LOG="$SANDBOX/run.log"
    PLANS_RUN=1
    export REPO NIGHTLY_DIR QUEUE_DIR LOG PLANS_RUN

    mkdir -p "$REPO/bin" "$QUEUE_DIR" "$NIGHTLY_DIR/reports"
    git init -q "$REPO"
    : > "$LOG"

    # Two queued plans + an attempt counter — the bytes the park path must not touch.
    printf '# Plan alpha\n' > "$QUEUE_DIR/alpha.md"
    printf '# Plan beta\n'  > "$QUEUE_DIR/beta.md"
    printf '1\n'            > "$QUEUE_DIR/alpha.md.attempts"

    # Signal-1 stub. Touches a sentinel so "never invoked" is assertable.
    CI_SENTINEL="$SANDBOX/ci-invoked"
    cat > "$REPO/bin/check-master-ci-green" <<STUBEOF
#!/bin/sh
touch "$CI_SENTINEL"
printf '%s\n' "\${IGNORE_PENDING_CHECKS-<unset>}" > "$SANDBOX/ci-env"
printf '%s\n' "\${IGNORE_FAILED_CHECKS-<unset>}" > "$SANDBOX/ci-env-failed"
echo "$1" >&2
exit $2
STUBEOF
    chmod +x "$REPO/bin/check-master-ci-green"

    printf '%s\n' "$3" > "$TMP/curl-rc"
    rm -f "$TMP/curl-seq" "$TMP/curl-calls" "$TMP/curl-args" "$TMP/sleep-args"
}

# snapshot_queue — content-addressed snapshot of every file under QUEUE_DIR.
snapshot_queue() {
    find "$QUEUE_DIR" -type f -exec shasum {} \; | sort
}

# --- Case 1: both signals green ------------------------------------------

setup_case "PASS: 12 check-run(s) all green" 0 0
BEFORE="$(snapshot_queue)"
RC=0; run_between_plans_canary || RC=$?
expect "green-returns-0" 0 "$RC"
PARK_REPORTS="$(find "$NIGHTLY_DIR/reports" -name '*-canary-park.md' | wc -l | tr -d ' ')"
same "green-writes-no-park-report" "0" "$PARK_REPORTS"
same "green-queue-unchanged" "$BEFORE" "$(snapshot_queue)"

# --- Case 2: CI genuinely red → park -------------------------------------

setup_case "FAIL: checks failed: phpunit (failure)" 1 0
BEFORE="$(snapshot_queue)"
RC=0; run_between_plans_canary || RC=$?
expect "ci-red-returns-1" 1 "$RC"
want "ci-red-detail-names-failure" "$CANARY_DETAIL" "checks failed"
same "ci-red-queue-unchanged" "$BEFORE" "$(snapshot_queue)"

# --- Case 3: CI pending → PROCEED (4), not park (1) ----------------------
# This inverts the handed spec deliberately: /post-plan manufactures a pending
# master at exactly this moment on every night a plan auto-merges.

setup_case "FAIL: checks still running: e2e" 1 0
BEFORE="$(snapshot_queue)"
RC=0; run_between_plans_canary || RC=$?
expect "ci-pending-returns-4-not-1" 4 "$RC"
PARK_REPORTS="$(find "$NIGHTLY_DIR/reports" -name '*-canary-park.md' | wc -l | tr -d ' ')"
same "ci-pending-writes-no-park-report" "0" "$PARK_REPORTS"
same "ci-pending-queue-unchanged" "$BEFORE" "$(snapshot_queue)"

# --- Case 3b: too-few / walkback-exhausted check-runs → PROCEED (4) -------

setup_case "FAIL: only 0 check-run(s) found (minimum: 1)." 1 0
BEFORE="$(snapshot_queue)"
RC=0; run_between_plans_canary || RC=$?
expect "ci-too-few-returns-4" 4 "$RC"
same "ci-too-few-queue-unchanged" "$BEFORE" "$(snapshot_queue)"

# --- Case 4: smoke red → park --------------------------------------------

setup_case "PASS: 12 check-run(s) all green" 0 7
BEFORE="$(snapshot_queue)"
RC=0; run_between_plans_canary || RC=$?
expect "smoke-red-returns-3" 3 "$RC"
want "smoke-red-detail-names-curl-exit" "$CANARY_DETAIL" "curl exit 7"
want "smoke-red-detail-names-ibl5-path" "$CANARY_DETAIL" "/ibl5/"
same "smoke-red-queue-unchanged" "$BEFORE" "$(snapshot_queue)"

SMOKE_URL="${AUTOMOUSE_CANARY_URL:-http://main.localhost/ibl5/}"

# --- Case 4b: one timeout, then up -> retry recovers, no park -------------

setup_case "PASS: 12 check-run(s) all green" 0 0
printf '28\n0\n' > "$TMP/curl-seq"
BEFORE="$(snapshot_queue)"
RC=0; run_between_plans_canary || RC=$?
expect "smoke-timeout-then-ok-returns-0"      0 "$RC"
same   "smoke-timeout-then-ok-two-calls"      "2" "$(curl_calls)"
same   "smoke-timeout-then-ok-one-retry-line" "1" "$(retry_lines)"
want   "smoke-timeout-then-ok-retry-line-text" "$(cat "$LOG")" \
       "canary: smoke try 1/3: curl exit 28 for $SMOKE_URL"
refuse "smoke-timeout-then-ok-no-park-line"   "$(cat "$LOG")" "canary: smoke: curl exit"
same   "smoke-retry-sleeps-env-value"         "0" "$(sleep_args)"
want   "smoke-curl-max-time-15"               "$(cat "$TMP/curl-args")" "max-time 15"
same   "smoke-timeout-then-ok-queue-unchanged" "$BEFORE" "$(snapshot_queue)"

# --- Case 4c: three timeouts -> park with the byte-identical detail -------

setup_case "PASS: 12 check-run(s) all green" 0 0
printf '28\n28\n28\n' > "$TMP/curl-seq"
BEFORE="$(snapshot_queue)"
RC=0; run_between_plans_canary || RC=$?
expect "smoke-timeout-x3-returns-3"        3 "$RC"
same   "smoke-timeout-x3-detail-exact"     "smoke: curl exit 28 for $SMOKE_URL" "$CANARY_DETAIL"
same   "smoke-timeout-x3-three-calls"      "3" "$(curl_calls)"
same   "smoke-timeout-x3-two-retry-lines"  "2" "$(retry_lines)"
same   "smoke-timeout-x3-queue-unchanged"  "$BEFORE" "$(snapshot_queue)"

# --- Case 4d: connection refused x3 -> exit 7 is retried, then parks ------

setup_case "PASS: 12 check-run(s) all green" 0 0
printf '7\n7\n7\n' > "$TMP/curl-seq"
RC=0; run_between_plans_canary || RC=$?
expect "smoke-refused-x3-returns-3"        3 "$RC"
want   "smoke-refused-x3-detail"           "$CANARY_DETAIL" "curl exit 7"
same   "smoke-refused-x3-three-calls"      "3" "$(curl_calls)"

# --- Case 4e: HTTP error (22) is not transient -> parks after ONE call ----
# The seq's second entry is 0, so a retry on every non-zero exit would
# recover to rc 0 with 2 calls and fail both assertions below.

setup_case "PASS: 12 check-run(s) all green" 0 0
printf '22\n0\n' > "$TMP/curl-seq"
RC=0; run_between_plans_canary || RC=$?
expect "smoke-http-error-returns-3"        3 "$RC"
same   "smoke-http-error-one-call"         "1" "$(curl_calls)"
same   "smoke-http-error-no-retry-line"    "0" "$(retry_lines)"
want   "smoke-http-error-detail"           "$CANARY_DETAIL" "curl exit 22"

# --- Cases 4f-4h: AUTOMOUSE_CANARY_RETRY_SLEEP falls back to 15 -----------
# Unset, empty, and non-numeric all sleep the 15s default. The sleep stub
# records the argument, so no wall time is spent.

setup_case "PASS: 12 check-run(s) all green" 0 0
printf '28\n0\n' > "$TMP/curl-seq"
RC=0; ( unset AUTOMOUSE_CANARY_RETRY_SLEEP; run_between_plans_canary ) || RC=$?
expect "retry-sleep-unset-returns-0"       0 "$RC"
same   "retry-sleep-unset-defaults-15"     "15" "$(sleep_args)"

setup_case "PASS: 12 check-run(s) all green" 0 0
printf '28\n0\n' > "$TMP/curl-seq"
RC=0; AUTOMOUSE_CANARY_RETRY_SLEEP='' run_between_plans_canary || RC=$?
expect "retry-sleep-empty-returns-0"       0 "$RC"
same   "retry-sleep-empty-defaults-15"     "15" "$(sleep_args)"

setup_case "PASS: 12 check-run(s) all green" 0 0
printf '28\n0\n' > "$TMP/curl-seq"
RC=0; AUTOMOUSE_CANARY_RETRY_SLEEP=abc run_between_plans_canary || RC=$?
expect "retry-sleep-non-numeric-returns-0" 0 "$RC"
same   "retry-sleep-non-numeric-defaults-15" "15" "$(sleep_args)"

# --- Case 5: AUTOMOUSE_SKIP_CANARY=1 bypasses everything ------------------

setup_case "FAIL: checks failed: phpunit (failure)" 1 0
BEFORE="$(snapshot_queue)"
RC=0; AUTOMOUSE_SKIP_CANARY=1 run_between_plans_canary || RC=$?
expect "skip-returns-0-despite-red-ci" 0 "$RC"
want "skip-logs-bypass" "$(cat "$LOG")" "skipped (AUTOMOUSE_SKIP_CANARY=1)"
if [ -e "$CI_SENTINEL" ]; then
    h_fail "skip-never-invokes-ci-stub" "sentinel present"
else
    h_pass "skip-never-invokes-ci-stub"
fi
same "skip-queue-unchanged" "$BEFORE" "$(snapshot_queue)"

# --- Case 6: CI auth/usage error (exit 2) → env-stop ----------------------

setup_case "ERROR: GitHub CLI is not authenticated." 2 0
RC=0; run_between_plans_canary || RC=$?
expect "ci-auth-error-returns-2" 2 "$RC"

# --- Case 7: the park report's contents ----------------------------------

setup_case "PASS: 12 check-run(s) all green" 0 0
write_canary_park_report "ci-red" "detail text"
REPORT="$NIGHTLY_DIR/reports/$(date +%Y-%m-%d)-canary-park.md"
if [ -f "$REPORT" ]; then
    echo "ok: park-report-written-at-dated-path"
    BODY="$(cat "$REPORT")"
    want "park-report-names-signal"    "$BODY" "ci-red"
    want "park-report-names-detail"    "$BODY" "detail text"
    want "park-report-counts-remaining" "$BODY" "Plans left in queue (untouched):** 2"
    want "park-report-names-bypass"    "$BODY" "AUTOMOUSE_SKIP_CANARY=1"
else
    h_fail "park-report-written-at-dated-path" "no $REPORT"
fi

# --- Cases 8 & 9: the REAL bin/check-master-ci-green ----------------------
# Pins the two stderr strings the proceed/park split keys on. Uses the script's
# documented GH_API_CMD stub plus a `gh` stub whose auth check passes, so no
# network and no gh credentials are needed. MAX_WALKBACK=0 keeps it off git log.

cat > "$STUBBIN/gh" <<'STUBEOF'
#!/bin/sh
case "$1" in auth) exit 0 ;; *) exit 1 ;; esac
STUBEOF
chmod +x "$STUBBIN/gh"

DSHA="deadbeefdeadbeefdeadbeefdeadbeefdeadbeef"

printf '%s\n' '{"check_runs":[{"name":"e2e","status":"in_progress","conclusion":null,"completed_at":null,"started_at":"2026-09-06T09:00:00Z"}]}' \
    > "$TMP/real-inprogress.json"
OUT="$(MIN_REQUIRED_CHECKS=1 MAX_WALKBACK=0 GH_API_CMD="cat $TMP/real-inprogress.json #" \
    "$GREEN" "$DSHA" 2>&1)"; RC=$?
expect "real-inprogress-exits-1" 1 "$RC"
want "real-inprogress-says-still-running" "$OUT" "checks still running"

printf '%s\n' '{"check_runs":[{"name":"phpunit","status":"completed","conclusion":"failure","completed_at":"2026-09-06T10:00:00Z","started_at":"2026-09-06T09:00:00Z"}]}' \
    > "$TMP/real-failure.json"
OUT="$(MIN_REQUIRED_CHECKS=1 MAX_WALKBACK=0 GH_API_CMD="cat $TMP/real-failure.json #" \
    "$GREEN" "$DSHA" 2>&1)"; RC=$?
expect "real-failure-exits-1" 1 "$RC"
want "real-failure-says-checks-failed" "$OUT" "checks failed"

# --- Case 10: the dispatch block never refunds an attempt ----------------
# The plan that just finished already had its .attempts file deleted on success,
# so a refund here would credit a plan that did not fail. Every OTHER env-stop
# call site in the runner calls refund_attempt first, which makes copying that
# pattern into this block the obvious mistake.

DISPATCH="$(awk '
    /# --- Between-plans master health canary dispatch ---/ { capture = 1 }
    capture { print }
    capture && /^[[:space:]]*fi[[:space:]]*$/ { exit }
' "$RUNNER")"

if [ -z "$DISPATCH" ]; then
    h_fail "dispatch-block-extractable" "empty extraction from $RUNNER"
else
    h_pass "dispatch-block-extractable"
    refuse "dispatch-block-has-no-refund" "$DISPATCH" "refund_attempt"
    want "dispatch-block-guards-on-queue" "$DISPATCH" 'ls "$QUEUE_DIR"/*.md'
    want "dispatch-block-parks-on-ci-red" "$DISPATCH" 'write_canary_park_report "ci-red"'
    want "dispatch-block-parks-on-smoke-red" "$DISPATCH" 'write_canary_park_report "smoke-red"'
fi

# --- Case 11: the runner still parses ------------------------------------

if bash -n "$RUNNER" 2>/dev/null; then
    h_pass "runner-parses-after-edit"
else
    h_fail "runner-parses-after-edit" "bash -n failed"
fi

# --- Case 12: the canary passes the EXACT ignore list -----------------------
# The stub records what it saw in IGNORE_PENDING_CHECKS. A missing prefix reads
# "<unset>"; a reworded or reordered list fails the equality.

setup_case "PASS: 3 check-run(s) all green" 0 0
RC=0; run_between_plans_canary || RC=$?
expect "ignore-list-stub-rc"         0 "$RC"
same   "canary-passes-exact-ignore-list" "deploy,Promote master to production" "$(cat "$SANDBOX/ci-env")"
same   "canary-passes-exact-failed-ignore-list" "Keep the merge-line head current" "$(cat "$SANDBOX/ci-env-failed")"

# --- Cases 13-15: real script THROUGH the extracted canary function ----------
# setup_case's stub is replaced by a wrapper that execs the real script against
# a per-case fixture. IGNORE_PENDING_CHECKS reaches the real script only via
# the canary's inline assignment, so these cases prove the whole path and that
# the rc mapping needs no change: PASS -> 0, "checks failed:" -> 1, other
# pending -> 4.

real_canary_case() { # <fixture-json-line>
    printf '%s\n' "$1" > "$TMP/canary-fixture.json"
    cat > "$REPO/bin/check-master-ci-green" <<STUBEOF
#!/bin/sh
exec env MIN_REQUIRED_CHECKS=1 MAX_WALKBACK=0 GH_API_CMD="cat $TMP/canary-fixture.json #" "$GREEN" "$DSHA"
STUBEOF
    chmod +x "$REPO/bin/check-master-ci-green"
}

# 13. others green + both post-merge jobs pending -> green (rc 0), smoke runs
setup_case "unused" 0 0
real_canary_case '{"check_runs":[{"name":"phpunit","status":"completed","conclusion":"success","completed_at":"2026-09-06T10:00:00Z","started_at":"2026-09-06T09:00:00Z"},{"name":"deploy","status":"in_progress","conclusion":null,"completed_at":null,"started_at":"2026-09-06T10:01:00Z"},{"name":"Promote master to production","status":"in_progress","conclusion":null,"completed_at":null,"started_at":"2026-09-06T10:01:00Z"}]}'
RC=0; run_between_plans_canary || RC=$?
expect "real-ignored-pending-is-green"      0 "$RC"
want   "real-ignored-pending-logs-pass"     "$(cat "$LOG")" "PASS: 1 check-run(s) all green"
want   "real-ignored-pending-logs-ignore"   "$(cat "$LOG")" "IGNORE_PENDING_CHECKS active — ignoring while pending: Promote master to production, deploy"

# 14. deploy completed failure -> "checks failed:" -> rc 1 (park)
setup_case "unused" 0 0
real_canary_case '{"check_runs":[{"name":"phpunit","status":"completed","conclusion":"success","completed_at":"2026-09-06T10:00:00Z","started_at":"2026-09-06T09:00:00Z"},{"name":"deploy","status":"completed","conclusion":"failure","completed_at":"2026-09-06T10:05:00Z","started_at":"2026-09-06T10:01:00Z"}]}'
RC=0; run_between_plans_canary || RC=$?
expect "real-ignored-red-parks"             1 "$RC"
want   "real-ignored-red-detail"            "$CANARY_DETAIL" "checks failed: deploy (failure)"

# 15. a NON-listed check pending -> still "checks still running" -> rc 4 (proceed)
setup_case "unused" 0 0
real_canary_case '{"check_runs":[{"name":"e2e","status":"in_progress","conclusion":null,"completed_at":null,"started_at":"2026-09-06T10:01:00Z"},{"name":"deploy","status":"in_progress","conclusion":null,"completed_at":null,"started_at":"2026-09-06T10:01:00Z"}]}'
RC=0; run_between_plans_canary || RC=$?
expect "real-non-listed-pending-proceeds"   4 "$RC"
want   "real-non-listed-pending-detail"     "$CANARY_DETAIL" "checks still running: e2e"

# 16. helper "Keep the merge-line head current" completed failure, real tests
# green, deploy pending -> green (rc 0). Reproduces the 2026-10-20 ci-red park.
setup_case "unused" 0 0
real_canary_case '{"check_runs":[{"name":"phpunit","status":"completed","conclusion":"success","completed_at":"2026-09-06T10:00:00Z","started_at":"2026-09-06T09:00:00Z"},{"name":"Keep the merge-line head current","status":"completed","conclusion":"failure","completed_at":"2026-09-06T10:03:00Z","started_at":"2026-09-06T10:02:00Z"},{"name":"deploy","status":"in_progress","conclusion":null,"completed_at":null,"started_at":"2026-09-06T10:01:00Z"}]}'
RC=0; run_between_plans_canary || RC=$?
expect "real-helper-failure-is-green"       0 "$RC"
want   "real-helper-failure-logs-ignore"    "$(cat "$LOG")" "IGNORE_FAILED_CHECKS active — ignoring failed: Keep the merge-line head current (failure)"
want   "real-helper-failure-logs-pass"      "$(cat "$LOG")" "PASS: 1 check-run(s) all green"

# 17. helper failure AND a real test failure -> the real one still parks (rc 1)
setup_case "unused" 0 0
real_canary_case '{"check_runs":[{"name":"phpunit","status":"completed","conclusion":"failure","completed_at":"2026-09-06T10:00:00Z","started_at":"2026-09-06T09:00:00Z"},{"name":"Keep the merge-line head current","status":"completed","conclusion":"failure","completed_at":"2026-09-06T10:03:00Z","started_at":"2026-09-06T10:02:00Z"}]}'
RC=0; run_between_plans_canary || RC=$?
expect "real-helper-plus-real-red-parks"    1 "$RC"
want   "real-helper-plus-real-red-detail"   "$CANARY_DETAIL" "checks failed: phpunit (failure)"

# 18. helper pending (newest run) -> still "checks still running" -> rc 4, as today
setup_case "unused" 0 0
real_canary_case '{"check_runs":[{"name":"phpunit","status":"completed","conclusion":"success","completed_at":"2026-09-06T10:00:00Z","started_at":"2026-09-06T09:00:00Z"},{"name":"Keep the merge-line head current","status":"in_progress","conclusion":null,"completed_at":null,"started_at":"2026-09-06T10:02:00Z"}]}'
