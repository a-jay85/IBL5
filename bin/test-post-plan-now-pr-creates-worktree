#!/usr/bin/env bash
# Tests that bin/post-plan-now --pr creates a worktree via bin/wt-new --existing
# when no worktree has the PR's head branch, reuses an existing one, refuses fork
# PRs, and maps slash-bearing branch names to hostname-safe slugs. Cases 11-14 cover
# the --auto headless guard and its IBL5_BURNDOWN_LOOP=1 opt-in.
#
# Fifteen cases, exit 0 iff all pass.
set -euo pipefail

# ---- environment --------------------------------------------------------
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
REPO="$(cd "$(dirname "$0")/.." && pwd)"
ORIGIN="$TMP/origin.git"
MAIN="$TMP/IBL5"         # named IBL5 so worktrees_parent_dir() derives IBL5-worktrees
WT_PARENT="$TMP/IBL5-worktrees"
SHIMS="$TMP/shims"; mkdir -p "$SHIMS"
export PATH="$SHIMS:$PATH"
WTNEW_LOG="$TMP/wtnew.log"
LAUNCHCTL_LOG="$TMP/launchctl.log"
export WTNEW_LOG LAUNCHCTL_LOG

# Usage gate (ADR-0143): post-plan-now asks the gate before it launches. Point the gate at a
# private state dir and shadow `security` so no case reads the real keychain, cache or
# network; no token means no usage data, which fails open.
export IBL5_USAGE_GATE_STATE_DIR="$TMP/gate"
mkdir -p "$IBL5_USAGE_GATE_STATE_DIR"
printf '#!/bin/sh\nexit 1\n' > "$SHIMS/security"
chmod +x "$SHIMS/security"

# ---- pass/fail counters -------------------------------------------------
PASS=0; FAIL=0
pass() { echo "PASS: $1"; PASS=$((PASS+1)); }
fail() { echo "FAIL: $1"; FAIL=$((FAIL+1)); }

# ---- scratch git repo setup ---------------------------------------------
git init --bare -b master "$ORIGIN" >/dev/null 2>&1

mkdir -p "$MAIN"
git -C "$MAIN" init -b master >/dev/null 2>&1
git -C "$MAIN" config user.email "test@example.com"
git -C "$MAIN" config user.name "Test"
git -C "$MAIN" remote add origin "file://$ORIGIN"

# Populate master: commit bin/lib/git-helpers.sh so worktrees have it
# (post-plan-now sources $ROOT/bin/lib/git-helpers.sh from within the worktree).
# ibl5/config.php must be non-empty for materialize_worktree_config ([ -s ] check).
mkdir -p "$MAIN/bin/lib" "$MAIN/ibl5/themes/IBL/style"
cp "$REPO/bin/lib/git-helpers.sh" "$MAIN/bin/lib/git-helpers.sh"
# wt-new also sources the pool and launchd libs; the pool itself stays off here.
cp "$REPO/bin/lib/wt-pool.sh" "$REPO/bin/lib/launchd-job.sh" "$MAIN/bin/lib/"
export WT_POOL=0 WT_POOL_KICK=none
printf '<?php // test config\n' > "$MAIN/ibl5/config.php"
printf 'placeholder\n' > "$MAIN/ibl5/themes/IBL/style/style.css"
git -C "$MAIN" add .
git -C "$MAIN" commit --quiet -m "init"
git -C "$MAIN" push --quiet origin master

# feat-x: based on master plus one commit; keep local branch for case 1 pre-creation
git -C "$MAIN" checkout -b feat-x >/dev/null 2>&1
printf 'feat\n' > "$MAIN/feat.txt"
git -C "$MAIN" add feat.txt
git -C "$MAIN" commit --quiet -m "feat-x"
git -C "$MAIN" push --quiet origin feat-x
FEAT_X_SHA="$(git -C "$ORIGIN" rev-parse refs/heads/feat-x)"
git -C "$MAIN" checkout master >/dev/null 2>&1

# dependabot/npm-and-yarn/foo: push to origin, delete local (wt-new uses --track path)
git -C "$MAIN" checkout -b "dependabot/npm-and-yarn/foo" >/dev/null 2>&1
printf 'dep\n' > "$MAIN/dep.txt"
git -C "$MAIN" add dep.txt
git -C "$MAIN" commit --quiet -m "dependabot"
git -C "$MAIN" push --quiet origin "dependabot/npm-and-yarn/foo"
git -C "$MAIN" checkout master >/dev/null 2>&1
git -C "$MAIN" branch -D "dependabot/npm-and-yarn/foo" >/dev/null 2>&1

mkdir -p "$WT_PARENT" "$TMP/Library/LaunchAgents"

# ---- shims --------------------------------------------------------------
# gh: serves GH_PR_JSON; applies --jq filter via real jq
cat > "$SHIMS/gh" << 'SHIM_EOF'
#!/usr/bin/env bash
jq_filter=""
while [ $# -gt 0 ]; do
    case "$1" in
        --jq) jq_filter="$2"; shift 2 ;;
        *)    shift ;;
    esac
done
[ -n "${GH_PR_JSON:-}" ] || exit 1
# GH_NO_FORK_FIELD: answer the isCrossRepository query with nothing (fork status unknown)
if [ -n "${GH_NO_FORK_FIELD:-}" ] && [ "$jq_filter" = ".isCrossRepository" ]; then exit 0; fi
if [ -n "$jq_filter" ]; then
    jq -r "$jq_filter" <<< "$GH_PR_JSON"
else
    printf '%s\n' "$GH_PR_JSON"
fi
SHIM_EOF
chmod +x "$SHIMS/gh"

# launchctl: log argv and exit 0 (prevents real launchd interaction)
cat > "$SHIMS/launchctl" << 'SHIM_EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "${LAUNCHCTL_LOG:-/dev/null}"
exit 0
SHIM_EOF
chmod +x "$SHIMS/launchctl"

# wt-new spy wrapper: logs argv to WTNEW_LOG then execs the real copy.
# Installed at MAIN/bin/wt-new so POST_PLAN_SELF_BIN=$MAIN/bin finds it.
# The real copy (wt-new-real) has SCRIPT_ROOT=$MAIN so REPO_ROOT=$MAIN and
# WT_PARENT=$TMP/IBL5-worktrees — isolated from the live IBL5-worktrees dir.
cp "$REPO/bin/wt-new" "$MAIN/bin/wt-new-real"
chmod +x "$MAIN/bin/wt-new-real"
cat > "$MAIN/bin/wt-new" << 'SHIM_EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "${WTNEW_LOG:-/dev/null}"
exec "$(dirname "$0")/wt-new-real" "$@"
SHIM_EOF
chmod +x "$MAIN/bin/wt-new"
cp "$MAIN/bin/wt-new" "$SHIMS/wt-new"

# ---- run_ppn helper -----------------------------------------------------
# Runs post-plan-now --pr <n> with test overrides; sets RC and ERR.
RC=0; ERR=""
run_ppn() {
    local pr_num="$1" self_bin="${2:-$MAIN/bin}"
    RC=0; ERR=""
    set +e
    ERR="$(POST_PLAN_MAIN_ROOT="$MAIN" POST_PLAN_SELF_BIN="$self_bin" \
           HOME="$TMP" \
           "$REPO/bin/post-plan-now" --pr "$pr_num" 2>&1 >/dev/null)"
    RC=$?
    set -e
}

# ==========================================================================
# Case 1 — existing worktree is reused
# ==========================================================================
export GH_PR_JSON='{"headRefName":"feat-x","isCrossRepository":false}'
# Pre-create the worktree (local feat-x branch exists from setup above)
git -C "$MAIN" worktree add "$WT_PARENT/feat-x" feat-x >/dev/null 2>&1
rm -f "$WTNEW_LOG"

run_ppn 101

FAIL_BEFORE=$FAIL
if [ -s "$WTNEW_LOG" ]; then
    fail "reuse: wt-new was called unexpectedly"
fi
if grep -qF -- "wt-new" <<< "${ERR:-}"; then
    fail "reuse: stderr mentions wt-new"
fi
if grep -qF -- "no worktree has '" <<< "${ERR:-}"; then
    fail "reuse: stderr mentions worktree-not-found message"
fi
[ "$FAIL" -eq "$FAIL_BEFORE" ] && pass "reuse: existing worktree is not re-created"

# Remove case 1 worktree so case 2 finds no existing one
rm -rf "$WT_PARENT/feat-x"
git -C "$MAIN" worktree prune >/dev/null 2>&1

# ==========================================================================
# Case 2 — missing worktree is created on the right branch at the origin tip
# ==========================================================================
# Advance origin's feat-x from a scratch clone so the local feat-x branch is stale
# (one commit behind): wt-new --existing must fetch and fast-forward it to the origin tip.
SCRATCH="$TMP/scratch"
git clone --quiet "file://$ORIGIN" "$SCRATCH" >/dev/null 2>&1
git -C "$SCRATCH" config user.email "test@example.com"
git -C "$SCRATCH" config user.name "Test"
git -C "$SCRATCH" checkout --quiet feat-x
printf 'more\n' > "$SCRATCH/more.txt"
git -C "$SCRATCH" add more.txt
git -C "$SCRATCH" commit --quiet -m "feat-x advance"
git -C "$SCRATCH" push --quiet origin feat-x
STALE_SHA="$FEAT_X_SHA"
FEAT_X_SHA="$(git -C "$ORIGIN" rev-parse refs/heads/feat-x)"
[ "$FEAT_X_SHA" != "$STALE_SHA" ] || { echo "setup: origin feat-x did not advance"; exit 1; }
[ "$(git -C "$MAIN" rev-parse refs/heads/feat-x)" = "$STALE_SHA" ] \
    || { echo "setup: local feat-x is not stale"; exit 1; }
export GH_PR_JSON='{"headRefName":"feat-x","isCrossRepository":false}'
rm -f "$WTNEW_LOG"

run_ppn 102

FAIL_BEFORE=$FAIL
if [ -d "$WT_PARENT/feat-x" ]; then
    ACTUAL_BRANCH="$(git -C "$WT_PARENT/feat-x" rev-parse --abbrev-ref HEAD 2>/dev/null || echo error)"
    ACTUAL_SHA="$(git -C "$WT_PARENT/feat-x" rev-parse HEAD 2>/dev/null || echo error)"
    if [ "$ACTUAL_BRANCH" != "feat-x" ]; then
        fail "create: checked-out branch is '$ACTUAL_BRANCH', expected feat-x"
    fi
    if [ "$ACTUAL_SHA" != "$FEAT_X_SHA" ]; then
        fail "create: HEAD is $ACTUAL_SHA, expected origin tip $FEAT_X_SHA"
    fi
else
    fail "create: $WT_PARENT/feat-x was not created"
fi
[ "$FAIL" -eq "$FAIL_BEFORE" ] && pass "create: missing worktree is created for the PR head branch"

# ==========================================================================
# Case 3 — a fork PR is refused
# ==========================================================================
export GH_PR_JSON='{"headRefName":"patch-1","isCrossRepository":true}'
rm -f "$WTNEW_LOG"

run_ppn 103

FAIL_BEFORE=$FAIL
if [ "$RC" -ne 1 ]; then
    fail "fork PR: expected RC=1, got $RC"
fi
if ! grep -qF -- "fork" <<< "${ERR:-}"; then
    fail "fork PR: expected 'fork' in stderr (got: $ERR)"
fi
if [ -s "$WTNEW_LOG" ]; then
    fail "fork PR: wt-new was called unexpectedly"
fi
if [ -d "$WT_PARENT/patch-1" ]; then
    fail "fork PR: worktree was created despite fork guard"
fi
[ "$FAIL" -eq "$FAIL_BEFORE" ] && pass "fork PR is refused with a specific message"

# ==========================================================================
# Case 4 — slash branch maps to a hostname-safe slug
# ==========================================================================
export GH_PR_JSON='{"headRefName":"dependabot/npm-and-yarn/foo","isCrossRepository":false}'
rm -f "$WTNEW_LOG"

run_ppn 104

FAIL_BEFORE=$FAIL
SLUG_ARG=""
if [ -f "$WTNEW_LOG" ]; then
    SLUG_ARG="$(awk 'NR==1{print $1; exit}' "$WTNEW_LOG")"
fi
if [ "$SLUG_ARG" != "dependabot-npm-and-yarn-foo" ]; then
    fail "slash branch: wt-new first arg was '$SLUG_ARG', expected 'dependabot-npm-and-yarn-foo'"
fi
if ! [ -d "$WT_PARENT/dependabot-npm-and-yarn-foo" ]; then
    fail "slash branch: $WT_PARENT/dependabot-npm-and-yarn-foo was not created"
else
    ACTUAL_BRANCH4="$(git -C "$WT_PARENT/dependabot-npm-and-yarn-foo" rev-parse --abbrev-ref HEAD 2>/dev/null || echo error)"
    if [ "$ACTUAL_BRANCH4" != "dependabot/npm-and-yarn/foo" ]; then
        fail "slash branch: checked-out branch is '$ACTUAL_BRANCH4', expected 'dependabot/npm-and-yarn/foo'"
    fi
fi
[ "$FAIL" -eq "$FAIL_BEFORE" ] && pass "slash branch maps to a hostname-safe slug"

# ==========================================================================
# Case 5 — bin/wt-new --existing with no value is rejected
# ==========================================================================
ERR5=""
RC5=0
set +e
ERR5="$("$REPO/bin/wt-new" --existing 2>&1)"
RC5=$?
set -e

FAIL_BEFORE=$FAIL
if [ "$RC5" -eq 0 ]; then
    fail "wt-new --existing with no value: expected non-zero RC but got 0"
fi
if ! grep -qF -- "Error: --existing requires a branch name" <<< "${ERR5:-}"; then
    fail "wt-new --existing with no value: expected error message not found (got: $ERR5)"
fi
[ "$FAIL" -eq "$FAIL_BEFORE" ] && pass "wt-new --existing with no value exits with usage"

# ==========================================================================
# Case 6 — loaded-idle phantom is reaped before the inflight check
# ==========================================================================
# A previous run left a loaded-idle plist for feat-x.  Without the reaper it
# would make postplan_inflight_label report an in-flight run → exit 6.  The
# reaper fires here because POST_PLAN_MAIN_ROOT and POST_PLAN_SELF_BIN are
# NOT set, and HOME=$TMP keeps the LaunchAgents dir under $TMP (not real ~/Library).
# The stateful launchctl stub clears the loaded-idle row when bootout is called,
# so the inflight check finds nothing and post-plan-now proceeds (exit != 6).
WT6="$WT_PARENT/feat-x"
[ -d "$WT6" ] || git -C "$MAIN" worktree add "$WT6" feat-x >/dev/null 2>&1

PHANTOM_LABEL="com.ibl5.postplan-now-feat-x-20260101-000000-12345"
PHANTOM_PLIST="$TMP/Library/LaunchAgents/${PHANTOM_LABEL}.plist"
LAUNCHCTL_LIST_STATE="$TMP/launchctl_list_state"
export LAUNCHCTL_LIST_STATE

# Old phantom plist (will be reaped)
touch "$PHANTOM_PLIST"
touch -t 202601010000 "$PHANTOM_PLIST"

# Loaded-idle row for the phantom label
printf '%s\t%s\t%s\n' '-' '78' "$PHANTOM_LABEL" > "$LAUNCHCTL_LIST_STATE"

# Stateful launchctl stub: list returns the state file; bootout clears it
cat > "$SHIMS/launchctl" << 'SHIM_EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "${LAUNCHCTL_LOG:-/dev/null}"
case "${1:-}" in
    list)    [ -f "${LAUNCHCTL_LIST_STATE:-}" ] && cat "${LAUNCHCTL_LIST_STATE}" ;;
    bootout) rm -f "${LAUNCHCTL_LIST_STATE:-}" ;;
esac
exit 0
SHIM_EOF
chmod +x "$SHIMS/launchctl"

RC6=0
set +e
# Run from within the feat-x worktree without the test-only overrides
ERR6="$(cd "$WT6" && POST_PLAN_SKILL=1 HOME="$TMP" "$REPO/bin/post-plan-now" 2>&1)"
RC6=$?
set -e

FAIL_BEFORE=$FAIL
if [ "$RC6" -eq 6 ]; then
    fail "loaded-idle-reap-before-inflight: exited 6 (phantom in-flight not reaped)"
fi
if [ -e "$PHANTOM_PLIST" ]; then
    fail "loaded-idle-reap-before-inflight: phantom plist still exists ($PHANTOM_PLIST)"
fi
# LAUNCHCTL_LOG may hold lines from earlier cases; match the phantom label.
if ! grep -Eq "^bootout gui/[0-9]+/${PHANTOM_LABEL}\$" "$LAUNCHCTL_LOG" 2>/dev/null; then
    fail "loaded-idle-reap-before-inflight: no 'bootout gui/<uid>/$PHANTOM_LABEL' in launchctl log"
fi
[ "$FAIL" -eq "$FAIL_BEFORE" ] && pass "loaded-idle-reap-before-inflight"

# Restore simple launchctl stub for any future tests
cat > "$SHIMS/launchctl" << 'SHIM_EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "${LAUNCHCTL_LOG:-/dev/null}"
exit 0
SHIM_EOF
chmod +x "$SHIMS/launchctl"

# ==========================================================================
# Case 7 — a paused or limit-hit skill run is RESULT paused, never a FAIL-DM
# ==========================================================================
# Runs the far-side $CMD that post-plan-now writes into its plist, with a fake claude
# behind a caffeinate shim. POST_PLAN_SKILL=1 selects the skill-only engine, so the
# harness (which lives in the main checkout) never runs.
unset GH_PR_JSON
HOME7="$TMP/home7"
mkdir -p "$HOME7/Library/LaunchAgents" "$HOME7/.local/bin" "$WT6/bin/lib"
cp "$REPO/bin/lib/usage-gate.sh" "$REPO/bin/lib/usage-fetch.sh" "$WT6/bin/lib/"
# The gate refuses a marker whose resume binary does not exist, and the far side names
# $ROOT/bin/post-plan-now (here $WT6), so the fixture needs an executable copy.
cp "$REPO/bin/post-plan-now" "$WT6/bin/post-plan-now"
chmod +x "$WT6/bin/post-plan-now"
FAILDM_LOG="$TMP/faildm.log"
export FAILDM_LOG
cat > "$WT6/bin/post-plan-fail-dm" << 'SHIM_EOF'
#!/usr/bin/env bash
printf 'called\n' >> "${FAILDM_LOG:-/dev/null}"
exit 0
SHIM_EOF
chmod +x "$WT6/bin/post-plan-fail-dm"
printf '#!/bin/sh\nexit 1\n' > "$SHIMS/gh-none"
chmod +x "$SHIMS/gh-none"
GATE_LIB="$REPO/bin/lib/usage-gate.sh"
export GATE_LIB
RESUME_BIN7="$REPO/bin/post-plan-now"
export RESUME_BIN7

cat > "$HOME7/.local/bin/caffeinate" << 'SHIM_EOF'
#!/usr/bin/env bash
while [ $# -gt 0 ]; do case "$1" in -*) shift ;; *) break ;; esac; done
shift
exec "$FAKE_CLAUDE" "$@"
SHIM_EOF
chmod +x "$HOME7/.local/bin/caffeinate"

FAKE_CLAUDE="$TMP/fake-claude"
export FAKE_CLAUDE
cat > "$FAKE_CLAUDE" << 'SHIM_EOF'
#!/usr/bin/env bash
case "${FAKE_MODE:-}" in
    marker)
        sid=""; prev=""
        for a in "$@"; do [ "$prev" = "--session-id" ] && sid="$a"; prev="$a"; done
        . "$GATE_LIB"
        usage_marker_write "$sid" post-plan-now "$RESUME_BIN7" usage-pause drain 94 five_hour ""
        exit 0 ;;
    limit) echo "You've hit your limit"; exit 1 ;;
    auth)  echo "API Error: 401"; exit 1 ;;
    envprobe) printf '%s\n' "${IBL5_BURNDOWN_LOOP-unset}" > "$PROBE_FILE"; exit 0 ;;
esac
exit 0
SHIM_EOF
chmod +x "$FAKE_CLAUDE"

# run_far_side <mode> → P7_OUT (the log the run wrote), P7_MARKERS (marker count)
run_far_side() {
    local mode="$1" plist log cmd
    rm -f "$HOME7"/Library/LaunchAgents/*.plist "$FAILDM_LOG"
    rm -rf "$IBL5_USAGE_GATE_STATE_DIR"; mkdir -p "$IBL5_USAGE_GATE_STATE_DIR/markers"
    set +e
    (cd "$WT6" && POST_PLAN_SKILL=1 HOME="$HOME7" "$REPO/bin/post-plan-now" >/dev/null 2>&1)
    set -e
    plist=$(ls "$HOME7"/Library/LaunchAgents/com.ibl5.postplan-now-feat-x-*.plist 2>/dev/null | head -1)
    P7_OUT="no plist written"; P7_MARKERS=0
    [ -n "$plist" ] || return 0
    cmd=$(python3 -c 'import plistlib,sys; print(plistlib.load(open(sys.argv[1],"rb"))["ProgramArguments"][2])' "$plist")
    log=$(python3 -c 'import plistlib,sys; print(plistlib.load(open(sys.argv[1],"rb"))["StandardOutPath"])' "$plist")
    set +e
    HOME="$HOME7" FAKE_MODE="$mode" GH_CMD="$SHIMS/gh-none" /bin/bash -c "$cmd" > "$log" 2>&1
    set -e
    P7_OUT=$(cat "$log")
    P7_MARKERS=$(find "$IBL5_USAGE_GATE_STATE_DIR/markers" -name '*.json' 2>/dev/null | wc -l | tr -d ' ')
    rm -f "$log" "${log%.log}.session"
}

FAIL_BEFORE=$FAIL
run_far_side marker
grep -qF -- "RESULT paused" <<< "$P7_OUT" || fail "paused marker: output has no 'RESULT paused' (got: $P7_OUT)"
[ ! -s "$FAILDM_LOG" ] || fail "paused marker: FAIL-DM fired"
[ "$P7_MARKERS" = 1 ] || fail "paused marker: marker count is $P7_MARKERS, expected 1"
[ "$FAIL" -eq "$FAIL_BEFORE" ] && pass "marker written by the run: RESULT paused, no FAIL-DM"

FAIL_BEFORE=$FAIL
run_far_side limit
grep -qF -- "RESULT paused" <<< "$P7_OUT" || fail "limit hit: output has no 'RESULT paused' (got: $P7_OUT)"
[ ! -s "$FAILDM_LOG" ] || fail "limit hit: FAIL-DM fired"
[ "$P7_MARKERS" = 1 ] || fail "limit hit: marker count is $P7_MARKERS, expected 1"
[ "$FAIL" -eq "$FAIL_BEFORE" ] && pass "limit-hit log on a failing exit: RESULT paused, no FAIL-DM"

FAIL_BEFORE=$FAIL
run_far_side auth
if grep -qF -- "RESULT paused" <<< "$P7_OUT"; then fail "auth error: wrongly reported paused"; fi
[ "$(wc -l < "$FAILDM_LOG" 2>/dev/null | tr -d ' ')" = 1 ] || fail "auth error: FAIL-DM count is not 1 (got: $(cat "$FAILDM_LOG" 2>/dev/null))"
[ "$P7_MARKERS" = 0 ] || fail "auth error: a marker was written"
[ "$FAIL" -eq "$FAIL_BEFORE" ] && pass "API Error 401: not paused, one FAIL-DM"

# ==========================================================================
# Case 8 — wt-new failure (e.g. slug collision) is reported and exits 1
# ==========================================================================
export GH_PR_JSON='{"headRefName":"ghost-branch","isCrossRepository":false}'
STUB_FAIL="$TMP/stub-fail"; mkdir -p "$STUB_FAIL"
printf '#!/usr/bin/env bash\necho "stub wt-new: slug collision" >&2\nexit 1\n' > "$STUB_FAIL/wt-new"
chmod +x "$STUB_FAIL/wt-new"

run_ppn 108 "$STUB_FAIL"

FAIL_BEFORE=$FAIL
if [ "$RC" -ne 1 ]; then
    fail "wt-new failure: expected RC=1, got $RC"
fi
if ! grep -qF -- "bin/wt-new failed for branch 'ghost-branch' (slug 'ghost-branch')" <<< "${ERR:-}"; then
    fail "wt-new failure: expected 'bin/wt-new failed' message (got: $ERR)"
fi
[ "$FAIL" -eq "$FAIL_BEFORE" ] && pass "wt-new failure exits 1 with a specific message"

# ==========================================================================
# Case 9 — wt-new exits 0 but creates nothing: the re-scan miss is reported
# ==========================================================================
STUB_NOOP="$TMP/stub-noop"; mkdir -p "$STUB_NOOP"
printf '#!/usr/bin/env bash\nexit 0\n' > "$STUB_NOOP/wt-new"
chmod +x "$STUB_NOOP/wt-new"

run_ppn 109 "$STUB_NOOP"

FAIL_BEFORE=$FAIL
if [ "$RC" -ne 1 ]; then
    fail "re-scan miss: expected RC=1, got $RC"
fi
if ! grep -qF -- "bin/wt-new succeeded but no worktree has 'ghost-branch' checked out." <<< "${ERR:-}"; then
    fail "re-scan miss: expected 'succeeded but no worktree' message (got: $ERR)"
fi
[ "$FAIL" -eq "$FAIL_BEFORE" ] && pass "re-scan miss after wt-new success exits 1 with a specific message"

# ==========================================================================
# Case 10 — unknown fork status refuses to create a worktree
# ==========================================================================
export GH_NO_FORK_FIELD=1
rm -f "$WTNEW_LOG"

run_ppn 110

FAIL_BEFORE=$FAIL
if [ "$RC" -ne 1 ]; then
    fail "unknown fork status: expected RC=1, got $RC"
fi
if ! grep -qF -- "could not determine whether PR #110 is from a fork" <<< "${ERR:-}"; then
    fail "unknown fork status: expected 'could not determine' message (got: $ERR)"
fi
if [ -s "$WTNEW_LOG" ]; then
    fail "unknown fork status: wt-new was called unexpectedly"
fi
unset GH_NO_FORK_FIELD
[ "$FAIL" -eq "$FAIL_BEFORE" ] && pass "unknown fork status is refused before wt-new runs"

# ==========================================================================
# Cases 11-14 — --auto headless guard + IBL5_BURNDOWN_LOOP opt-in
# ==========================================================================
# run_auto_headless <opt-in-state> → G_OUT (stdout+stderr), G_RC, G_PLIST (0/1)
# opt-in-state: "unset" | "empty" | any literal value
run_auto_headless() {
    local state="$1"
    rm -f "$HOME7"/Library/LaunchAgents/*.plist
    set +e
    if [ "$state" = "unset" ]; then
        G_OUT=$(cd "$WT6" && env -u IBL5_BURNDOWN_LOOP CLAUDE_HEADLESS=1 \
            POST_PLAN_SKILL=1 HOME="$HOME7" "$REPO/bin/post-plan-now" --auto 2>&1)
    elif [ "$state" = "empty" ]; then
        G_OUT=$(cd "$WT6" && IBL5_BURNDOWN_LOOP='' CLAUDE_HEADLESS=1 \
            POST_PLAN_SKILL=1 HOME="$HOME7" "$REPO/bin/post-plan-now" --auto 2>&1)
    else
        G_OUT=$(cd "$WT6" && IBL5_BURNDOWN_LOOP="$state" CLAUDE_HEADLESS=1 \
            POST_PLAN_SKILL=1 HOME="$HOME7" "$REPO/bin/post-plan-now" --auto 2>&1)
    fi
    G_RC=$?
    set -e
    G_PLIST=0
    ls "$HOME7"/Library/LaunchAgents/com.ibl5.postplan-now-feat-x-*.plist >/dev/null 2>&1 && G_PLIST=1
    rm -f "$HOME7"/Library/LaunchAgents/*.plist
}

# assert_skips <label> — the last run_auto_headless must have skipped
assert_skips() {
    [ "$G_RC" = 0 ] || fail "$1: expected RC=0, got $G_RC"
    grep -qF -- "skipping auto-fire" <<< "$G_OUT" || fail "$1: no 'skipping auto-fire' (got: $G_OUT)"
    [ "$G_PLIST" = 0 ] || fail "$1: a plist was written"
}

FAIL_BEFORE=$FAIL
run_auto_headless unset
assert_skips "unset opt-in"
[ "$FAIL" -eq "$FAIL_BEFORE" ] && pass "headless --auto without opt-in skips"

FAIL_BEFORE=$FAIL
run_auto_headless empty
assert_skips "empty opt-in"
[ "$FAIL" -eq "$FAIL_BEFORE" ] && pass "headless --auto with empty opt-in skips"

FAIL_BEFORE=$FAIL
run_auto_headless 0
assert_skips "opt-in=0"
[ "$FAIL" -eq "$FAIL_BEFORE" ] && pass "headless --auto with opt-in=0 skips"

FAIL_BEFORE=$FAIL
run_auto_headless 1
if grep -qF -- "skipping auto-fire" <<< "$G_OUT"; then fail "opt-in=1: still skipped (got: $G_OUT)"; fi
grep -qF -- "IBL5_BURNDOWN_LOOP=1" <<< "$G_OUT" || fail "opt-in=1: no opt-in message (got: $G_OUT)"
[ "$G_PLIST" = 1 ] || fail "opt-in=1: no plist written (got: $G_OUT)"
[ "$FAIL" -eq "$FAIL_BEFORE" ] && pass "headless --auto with IBL5_BURNDOWN_LOOP=1 fires"

# Case 14 — the launchd path never inherits the caller's env, so only --foreground
# can prove the scrub: the far-side claude must see IBL5_BURNDOWN_LOOP as unset.
FAIL_BEFORE=$FAIL
PROBE_FILE="$TMP/optin.probe"; export PROBE_FILE; rm -f "$PROBE_FILE"
set +e
(cd "$WT6" && IBL5_BURNDOWN_LOOP=1 CLAUDE_HEADLESS=1 POST_PLAN_SKILL=1 \
    HOME="$HOME7" FAKE_MODE=envprobe GH_CMD="$SHIMS/gh-none" \
    "$REPO/bin/post-plan-now" --auto --foreground >/dev/null 2>&1)
set -e
if [ ! -f "$PROBE_FILE" ]; then
    fail "scrub: probe file missing (far-side claude never ran)"
elif [ "$(cat "$PROBE_FILE")" != "unset" ]; then
    fail "scrub: far side saw IBL5_BURNDOWN_LOOP=$(cat "$PROBE_FILE"), expected unset"
fi
rm -f "$PROBE_FILE"
rm -f "$HOME7"/Library/LaunchAgents/*.plist
[ "$FAIL" -eq "$FAIL_BEFORE" ] && pass "opt-in is scrubbed before the far-side claude runs"

# ==========================================================================
# Case 15 — a live fleet slot refuses a detaching run (post-plan-fleet race)
# ==========================================================================
# bin/post-plan-fleet runs `post-plan-now --pr N --foreground` under the label
# com.ibl5.post-plan-fleet-<N>, which postplan_inflight_label cannot see. A detaching run
# for the same PR would race it, so it must exit 6. Placed after Case 14 because the
# --foreground sub-case needs the fake claude and caffeinate shim set up for Case 7.
cat > "$SHIMS/gh-fleet" << 'SHIM_EOF'
#!/usr/bin/env bash
if [ "${1:-}" = "pr" ] && [ "${2:-}" = "list" ]; then
    for a in "$@"; do
        if [ "$a" = "feat-x" ]; then echo 777; exit 0; fi
    done
fi
exit 0
SHIM_EOF
chmod +x "$SHIMS/gh-fleet"
LAUNCHCTL_LIST_STATE="$TMP/launchctl_list_state15"
export LAUNCHCTL_LIST_STATE
cat > "$SHIMS/launchctl" << 'SHIM_EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "${LAUNCHCTL_LOG:-/dev/null}"
case "${1:-}" in
    list) [ -f "${LAUNCHCTL_LIST_STATE:-}" ] && cat "${LAUNCHCTL_LIST_STATE}" ;;
esac
exit 0
SHIM_EOF
chmod +x "$SHIMS/launchctl"

# run_fleet_case <extra post-plan-now args...> → F_OUT, F_RC
run_fleet_case() {
    rm -f "$HOME7"/Library/LaunchAgents/*.plist
    set +e
    F_OUT=$(cd "$WT6" && POST_PLAN_SKILL=1 HOME="$HOME7" FAKE_MODE='' \
        GH_CMD="$SHIMS/gh-fleet" GH_PR_JSON='{"headRefName":"feat-x","isCrossRepository":false}' \
        "$REPO/bin/post-plan-now" "$@" 2>&1)
    F_RC=$?
    set -e
    rm -f "$HOME7"/Library/LaunchAgents/*.plist
}

# 15.1 refuse
FAIL_BEFORE=$FAIL
printf '%s\t%s\t%s\n' 40477 0 'com.ibl5.post-plan-fleet-777' > "$LAUNCHCTL_LIST_STATE"
run_fleet_case
[ "$F_RC" -eq 6 ] || fail "fleet-slot-refuse: exited $F_RC, want 6 (out: $F_OUT)"
grep -qF -- "fleet rescue for PR #777 is already in flight" <<< "$F_OUT" \
    || fail "fleet-slot-refuse: no refusal message (out: $F_OUT)"
[ "$FAIL" -eq "$FAIL_BEFORE" ] && pass "fleet-slot-refuse: a live fleet slot refuses a detaching run"

# 15.2 a different PR's slot does not block (end-anchored compare)
FAIL_BEFORE=$FAIL
printf '%s\t%s\t%s\n' 40477 0 'com.ibl5.post-plan-fleet-7770' > "$LAUNCHCTL_LIST_STATE"
run_fleet_case
[ "$F_RC" -ne 6 ] || fail "fleet-slot-other-pr: PR 7770's slot wrongly refused PR 777 (out: $F_OUT)"
[ "$FAIL" -eq "$FAIL_BEFORE" ] && pass "fleet-slot-other-pr: a different PR's slot does not block"

# 15.3 the fleet's own runner (--pr N --foreground) is not refused by its own slot
FAIL_BEFORE=$FAIL
printf '%s\t%s\t%s\n' 40477 0 'com.ibl5.post-plan-fleet-777' > "$LAUNCHCTL_LIST_STATE"
run_fleet_case --pr 777 --foreground
[ "$F_RC" -ne 6 ] || fail "fleet-slot-foreground: fleet runner refused its own slot (out: $F_OUT)"
grep -qF -- "foreground mode" <<< "$F_OUT" \
    || fail "fleet-slot-foreground: run never reached foreground mode (out: $F_OUT)"
[ "$FAIL" -eq "$FAIL_BEFORE" ] && pass "fleet-slot-foreground: the fleet runner is not self-refused"

# 15.4 --force bypasses
FAIL_BEFORE=$FAIL
printf '%s\t%s\t%s\n' 40477 0 'com.ibl5.post-plan-fleet-777' > "$LAUNCHCTL_LIST_STATE"
run_fleet_case --force
[ "$F_RC" -ne 6 ] || fail "fleet-slot-force: --force did not bypass the slot (out: $F_OUT)"
[ "$FAIL" -eq "$FAIL_BEFORE" ] && pass "fleet-slot-force: --force bypasses a live slot"

rm -f "$LAUNCHCTL_LIST_STATE"
cat > "$SHIMS/launchctl" << 'SHIM_EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "${LAUNCHCTL_LOG:-/dev/null}"
exit 0
SHIM_EOF
chmod +x "$SHIMS/launchctl"

# ==========================================================================
# Summary
# ==========================================================================
echo ""
echo "Results: $PASS passed, $FAIL failed"
[ "$FAIL" -eq 0 ]
