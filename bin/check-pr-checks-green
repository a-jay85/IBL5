#!/bin/bash

# Decides whether every non-ignored check-run on a PR head SHA has settled green,
# optionally polling until it has. Read by bin/settle-pr-status, which
# .github/workflows/all-checks-settled.yml runs once per sibling completion and turns the
# exit code into the `All checks settled` commit status (ADR-0149 addendum).
#
# Verdict logic is shared with bin/check-master-ci-green via bin/lib/ci-checks-green.sh.
# Legacy commit statuses are deliberately NOT read. Every check on this repo is a
# check-run, and the one status context that exists, `All checks settled`, is this
# script's own output. Reading statuses would let the verdict see the aggregator's
# status and loop on itself (--self only covers check-runs), so do not add it.
#
# Exit codes: 0 = settled green, 1 = failed / stacked base / deadline hit, 2 = usage or API error, 3 = still pending (one-shot only).

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: bin/check-pr-checks-green --repo=<owner/repo> --sha=<40-hex> [options]

  --self=<csv>             Exact check-run names of the caller (job name and status context); always ignored.
  --ignore=<csv>           Extra exact check-run names to ignore (advisory-by-design).
  --ignore-workflows=<csv>  Workflow display names whose ACTIVE runs never hold V4 (a generic option; no workflow passes it now).
  --ghost-grace-seconds=<n>  A run the runs API still calls active is treated as settled
                           only when every job of its latest attempt completed in
                           {success, skipped, neutral} AND its updated_at is older than
                           this many seconds (default 600). Zero jobs, a pending job, a
                           red job, a jobs read error or a younger run all hold.
  --anchor=<csv>           Exact names that MUST exist and be completed before any
                           PASS verdict (the other required contexts).
  --wait                   Poll until settled or deadline. Without it: one shot.
  --interval-seconds=<n>   Poll interval (default 60).
  --timeout-seconds=<n>    Deadline for --wait (default 2400). Hitting it FAILS.
  --base-ref=<branch>      PR base branch. Not master/develop -> FAIL at once
                           (exit 1) with a stacked-base message, before any API call.
                           Omitted: no base check (today's behavior).
  --startup-grace-seconds=<n>  Sleep before the first poll (default 0). Skipped on
                           a stacked-base FAIL; not counted against the deadline.
  --help, -h

Every value flag takes the --key=value form; the space form is an unknown flag.

Verdict order per poll (first match wins):
  V1 a completed check-run concluded outside {success, skipped, neutral} -> FAIL now
  V2 an --anchor name is absent or not completed                          -> WAIT
  V3 a non-ignored check-run is not completed                              -> WAIT
  V4 a workflow run on the SHA (other than $GITHUB_WORKFLOW) is active and not a settled ghost (see --ghost-grace-seconds) -> WAIT
  V5 otherwise                                                             -> PASS

An API error or unparseable response is a WAIT under --wait (so the deadline fails
closed) and exit 2 in one-shot mode. It is never a pass.

Environment:
  GH_API_CMD       Override the API command (default "gh api"). Tests point it at a
                   shim that returns the Nth fixture on the Nth call.
  IBL5_GH_RETRY_DELAYS  Sleeps between retries of each API read (default "2 5": 3 attempts). Unset and empty both select the default.
  GITHUB_WORKFLOW  Display name of the calling workflow. Its own active run is
                   excluded from V4 so the aggregator never waits on itself.
                   Unset or empty means no self-exclusion.
  CCG_NOW_EPOCH    Test seam: epoch seconds used as "now" for the ghost age. Unset or
                   empty means the wall clock. Anything else is a usage error (exit 2).

Exit codes: 0 = every non-ignored check settled in {success, skipped, neutral};
            1 = a check failed, the base is stacked (--base-ref), or the deadline
                hit with checks still pending (fail-closed);
            2 = usage error, unparseable API response;
            3 = still pending (one-shot only; --wait polls instead).
EOF
}

REPO=""
SHA=""
SELF=""
IGNORE=""
IGNORE_WF=""
ANCHOR=""
WAIT=0
INTERVAL=60
TIMEOUT=2400
BASE_REF=""
BASE_REF_SET=0
GRACE=0
# Ghost grace in seconds. bin/check-composite-contracts A7 reads this line and requires
# the sweep workflow's --sweep-stale-minutes to be at least this long.
GHOST_GRACE=600
# Bases whose PRs run the full CI suite. Mirrors `branches: [ master, develop ]`
# in .github/workflows/tests.yml and .github/workflows/pr-meta-checks.yml. A PR on
# any other base never receives the Tests and Analysis / E2E Tests / Meta checks
# anchors, so waiting for them only burns the deadline.
MASTER_LIKE_BASES="master develop"

for arg in "$@"; do
    case "$arg" in
        --help|-h)            usage; exit 0 ;;
        --repo=*)             REPO="${arg#--repo=}" ;;
        --sha=*)              SHA="${arg#--sha=}" ;;
        --self=*)             SELF="${arg#--self=}" ;;
        --ignore=*)           IGNORE="${arg#--ignore=}" ;;
        --ignore-workflows=*) IGNORE_WF="${arg#--ignore-workflows=}" ;;
        --anchor=*)           ANCHOR="${arg#--anchor=}" ;;
        --wait)               WAIT=1 ;;
        --interval-seconds=*) INTERVAL="${arg#--interval-seconds=}" ;;
        --timeout-seconds=*)  TIMEOUT="${arg#--timeout-seconds=}" ;;
        --base-ref=*)         BASE_REF="${arg#--base-ref=}"; BASE_REF_SET=1 ;;
        --startup-grace-seconds=*) GRACE="${arg#--startup-grace-seconds=}" ;;
        --ghost-grace-seconds=*) GHOST_GRACE="${arg#--ghost-grace-seconds=}" ;;
        --*)
            echo "unknown flag: $arg" >&2
            usage >&2
            exit 2
            ;;
        *)
            echo "unexpected argument: $arg" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if ! [[ "$REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || [[ "$REPO" == *..* ]]; then
    echo "invalid --repo: '$REPO' (want owner/repo)" >&2
    exit 2
fi
if ! [[ "$SHA" =~ ^[0-9a-f]{40}$ ]]; then
    echo "invalid --sha: '$SHA' (want 40 lowercase hex)" >&2
    exit 2
fi
if ! [[ "$INTERVAL" =~ ^[0-9]+$ ]] || ! [[ "$TIMEOUT" =~ ^[0-9]+$ ]]; then
    echo "invalid --interval-seconds/--timeout-seconds: must be non-negative integers" >&2
    exit 2
fi
if ! [[ "$GRACE" =~ ^[0-9]+$ ]]; then
    echo "invalid --startup-grace-seconds: must be a non-negative integer" >&2
    exit 2
fi
if ! [[ "$GHOST_GRACE" =~ ^[0-9]+$ ]]; then
    echo "invalid --ghost-grace-seconds: must be a non-negative integer" >&2
    exit 2
fi
if [ -n "${CCG_NOW_EPOCH:-}" ] && ! [[ "$CCG_NOW_EPOCH" =~ ^[0-9]+$ ]]; then
    echo "invalid CCG_NOW_EPOCH: '$CCG_NOW_EPOCH' (want epoch seconds, or unset)" >&2
    exit 2
fi
if [ "$BASE_REF_SET" -eq 1 ]; then
    if ! [[ "$BASE_REF" =~ ^[A-Za-z0-9._/-]+$ ]] || [[ "$BASE_REF" == -* ]] \
            || [[ "$BASE_REF" == *..* ]]; then
        echo "invalid --base-ref: '$BASE_REF' (want a branch name)" >&2
        exit 2
    fi
    case " $MASTER_LIKE_BASES " in
        *" $BASE_REF "*) ;;
        *)
            {
                echo "FAIL: stacked on $BASE_REF: this PR's base is '$BASE_REF', not master."
                echo "Full CI (Tests and Analysis, E2E Tests, Meta checks) runs only on PRs based on master, so those anchors never report here."
                echo "After the parent PR merges and GitHub retargets this PR to master, push (merge or rebase onto origin/master) so CI starts."
                echo "A 'gh run rerun' does not help: it replays the old event, which still carries base '$BASE_REF'."
            } >&2
            exit 1
            ;;
    esac
fi

# Sourced only after --help and flag validation, so --help works with no jq on PATH.
# shellcheck source=bin/lib/ci-checks-green.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/ci-checks-green.sh"
# shellcheck source=bin/lib/gh-retry.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/gh-retry.sh"

GH_API_CMD="${GH_API_CMD:-gh api}"
: "${IBL5_GH_RETRY_DELAYS:=2 5}"
SELF_WORKFLOW="${GITHUB_WORKFLOW:-}"
SKIP_JSON="$(ccg_skip_json "$SELF,$IGNORE")"
ANCHOR_JSON="$(ccg_skip_json "$ANCHOR")"
IGNORE_WF_JSON="$(ccg_skip_json "$IGNORE_WF")"
IGNORED_LIST="$(printf '%s' "$SKIP_JSON" | jq -r 'join(", ")')"
ANCHOR_LIST="$(printf '%s' "$ANCHOR_JSON" | jq -r 'join(", ")')"

# poll_once — one verdict. Sets VERDICT (fail|wait|pass|apierr) and LINE.
poll_once() {
    local raw runs_raw candidates checks failed missing pending active ghosts total now run id name jobs_raw jobs reason
    if ! raw="$(gh_retry_json bash -c "$GH_API_CMD --paginate --slurp \"repos/$REPO/commits/$SHA/check-runs?per_page=100\"" 2>/dev/null)" \
        || ! checks="$(printf '%s' "$raw" | jq -e '{check_runs: [.[].check_runs[]]}' 2>/dev/null)"; then
        VERDICT=apierr; LINE="check-runs read failed"; return 0
    fi
    if ! runs_raw="$(gh_retry_json bash -c "$GH_API_CMD --paginate --slurp \"repos/$REPO/actions/runs?head_sha=$SHA&per_page=100\"" 2>/dev/null)" \
        || ! candidates="$(printf '%s' "$runs_raw" | jq -ec --arg self_wf "$SELF_WORKFLOW" --argjson skipwf "$IGNORE_WF_JSON" \
            '[.[].workflow_runs[] | select(.status != "completed") | select(.name != $self_wf) | select(.name as $n | $skipwf | index($n) | not)
              | {id, name, status, run_attempt, updated_at}]' 2>/dev/null)"; then
        VERDICT=apierr; LINE="workflow-runs read failed"; return 0
    fi
    checks="$(printf '%s' "$checks" | ccg_dedupe "$SKIP_JSON")"

    failed="$(printf '%s' "$checks" | ccg_failed)"
    if [ -n "$failed" ]; then
        VERDICT="fail"; LINE="FAIL: checks failed: $failed"; return 0
    fi
    missing="$(printf '%s' "$checks" | jq -r --argjson a "$ANCHOR_JSON" '
        [ $a[] as $n | select([.check_runs[] | select(.name == $n and .status == "completed")] | length == 0) | $n ]
        | join(", ")')"
    if [ -n "$missing" ]; then
        VERDICT="wait"; LINE="WAIT: anchors not reported/completed: $missing"; return 0
    fi
    pending="$(printf '%s' "$checks" | ccg_pending)"
    if [ -n "$pending" ]; then
        VERDICT="wait"; LINE="WAIT: checks still running: $pending"; return 0
    fi
    # V4 with the ghost check (ADR-0149 addendum 2026-10-22). A run the runs API still
    # calls active holds unless every job of its latest attempt completed green and its
    # updated_at has sat unchanged for more than GHOST_GRACE seconds. Jobs are read only
    # here, after V1-V3, so a red or pending check-run never costs a jobs call. A run
    # without a numeric id gets an empty jobs list and holds (no-run-id).
    now="${CCG_NOW_EPOCH:-$(date +%s)}"
    active=""; ghosts=""
    while IFS= read -r run; do
        [ -n "$run" ] || continue
        id="$(jq -r 'if (.id | type) == "number" then .id else "" end' <<< "$run")"
        name="$(jq -r '.name // "?"' <<< "$run")"
        jobs='[]'
        if [ -n "$id" ]; then
            if ! jobs_raw="$(gh_retry_json bash -c "$GH_API_CMD --paginate --slurp \"repos/$REPO/actions/runs/$id/jobs?filter=latest&per_page=100\"" 2>/dev/null)" \
                || ! jobs="$(printf '%s' "$jobs_raw" | jq -ec '[.[].jobs[]]' 2>/dev/null)"; then
                VERDICT=apierr; LINE="jobs read failed for run $id ($name)"; return 0
            fi
        fi
        reason="$(jq -nc --argjson r "$run" --argjson j "$jobs" '{run: $r, jobs: $j}' | ccg_ghost_reason "$now" "$GHOST_GRACE")"
        if [ "$reason" = "settled" ]; then
            jq -r --argjson now "$now" --argjson grace "$GHOST_GRACE" \
                '"GHOST: run \(.id) (\(.name)) status=\(.status) run_attempt=\(.run_attempt) updated_at=\(.updated_at) age=\($now - (.updated_at | fromdateiso8601))s > grace \($grace)s: every latest-attempt job completed green; treating as settled"' \
                <<< "$run" >&2
            ghosts="${ghosts:+$ghosts, }$name#$id"
        else
            echo "ghost-check: run ${id:-?} ($name): $reason; still holding" >&2
            active="${active:+$active, }$name"
        fi
    done < <(jq -c '.[]' <<< "$candidates")
    if [ -n "$active" ]; then
        VERDICT="wait"; LINE="WAIT: workflow runs still active: $active"; return 0
    fi
    total="$(printf '%s' "$checks" | jq '.check_runs | length')"
    VERDICT=pass
    LINE="PASS: ${ghosts:+ghost-settled by jobs: $ghosts; }$total check-run(s) settled green on $SHA (anchors settled: ${ANCHOR_LIST:-<none>}) (ignored: ${IGNORED_LIST:-<none>})"
}

# Startup grace: give sibling workflows time to register their check-runs before
# the first poll. Slept after the base check, so a stacked PR fails in seconds,
# and before START, so the grace never eats into --timeout-seconds (the workflow
# used to sleep outside the script, and the deadline is unchanged from then).
if [ "$GRACE" -gt 0 ]; then
    sleep "$GRACE"
fi
API_ERRORS=0
START=$SECONDS
while :; do
    poll_once
    case "$VERDICT" in
        pass) echo "$LINE"; exit 0 ;;
        fail) echo "$LINE" >&2; exit 1 ;;
        apierr)
            API_ERRORS=$((API_ERRORS + 1))
            LINE="WAIT: api error ($API_ERRORS consecutive): $LINE"
            if [ "$WAIT" -ne 1 ]; then
                echo "$LINE" >&2
                exit 2
            fi
            ;;
        wait)
            API_ERRORS=0
            if [ "$WAIT" -ne 1 ]; then
                echo "$LINE" >&2
                exit 3
            fi
            ;;
    esac
    echo "$LINE" >&2
    if [ $((SECONDS - START)) -ge "$TIMEOUT" ]; then
        echo "TIMEOUT: $LINE — failing closed after $((SECONDS - START))s" >&2
        exit 1
    fi
    sleep "$INTERVAL"
done
