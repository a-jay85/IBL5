# --- Cases 28-31: bin/docfix-run dedupe and fail-closed gates ----------------

# Case 28: SHIM_PR_UNARMED set → unarmed-PR dedupe skips (no plist)
SB="$(build_sandbox)"
SHIM_PR_UNARMED="docs-stale-refresh-20260703" run_docfix "$SB" "" "" "1" "a.md" >/dev/null
[ -z "$(plist_of "$SB")" ] \
  && ok "(28) veronly: unarmed-PR dedupe skips (no plist)" \
  || bad "(28) veronly: unarmed-PR dedupe"

# Case 29: prior-day SHIM_BRANCH_OUT + empty SHIM_PR_UNARMED → plist created
SB="$(build_sandbox)"
SHIM_PR_UNARMED="" run_docfix "$SB" "docs-stale-refresh-20260703" "" "1" "a.md" >/dev/null
[ -n "$(plist_of "$SB")" ] \
  && ok "(29) veronly: prior-day branch allows today's run (plist created)" \
  || bad "(29) veronly: prior-day branch blocked today's run"

# Case 30: today's SHIM_BRANCH_OUT → branch dedupe skips (no plist)
SB="$(build_sandbox)"
run_docfix "$SB" "docs-stale-refresh-$(date +%Y%m%d)" "" "1" "a.md" >/dev/null
[ -z "$(plist_of "$SB")" ] \
  && ok "(30) veronly: today's branch dedupe skips (no plist)" \
  || bad "(30) veronly: today's branch dedupe"

# Case 31: SHIM_GH_FAIL=1 → fail-closed skip (no plist)
SB="$(build_sandbox)"
SHIM_GH_FAIL=1 run_docfix "$SB" "" "" "1" "a.md" >/dev/null
[ -z "$(plist_of "$SB")" ] \
  && ok "(31) veronly: gh-fail skips fail-closed (no plist)" \
  || bad "(31) veronly: gh-fail should skip"

# --- Cases 32-36: poll DM dispatch -------------------------------------------

# Case 32: SHIM_PR_DM="4242" → dispatch logged; marker created
SB="$(build_sandbox)"
CALLS32="$SB/gh-calls"
SHIM_PR_DM="4242" SHIM_GH_CALLS="$CALLS32" SHIM_STALE_JSON='[]' run_poll "$SB"
MARKER32="$(dm_marker_of "$SB" 4242)"
{ grep -qF 'workflow run docs-refreshed-notify.yml' "$CALLS32" \
    && grep -qF 'pr_number=4242' "$CALLS32" \
    && [ -e "$MARKER32" ]; } \
  && ok "(32) poll: DM dispatched for unarmed PR #4242 (marker + gh-calls logged)" \
  || bad "(32) poll: DM dispatch"

# Case 33: SHIM_PR_DM="" → no dispatch; no marker
SB="$(build_sandbox)"
CALLS33="$SB/gh-calls"
SHIM_PR_DM="" SHIM_GH_CALLS="$CALLS33" SHIM_STALE_JSON='[]' run_poll "$SB"
MARKER33="$(dm_marker_of "$SB" 4242)"
{ [ ! -e "$MARKER33" ] && { [ ! -e "$CALLS33" ] || [ ! -s "$CALLS33" ]; }; } \
  && ok "(33) poll: no DM when no unarmed PRs" \
  || bad "(33) poll: DM should not fire for empty PR_DM"

# Case 34: marker pre-created → no re-dispatch
SB="$(build_sandbox)"
CALLS34="$SB/gh-calls"
MARKER34="$(dm_marker_of "$SB" 4242)"
mkdir -p "$(dirname "$MARKER34")"
: > "$MARKER34"
SHIM_PR_DM="4242" SHIM_GH_CALLS="$CALLS34" SHIM_STALE_JSON='[]' run_poll "$SB"
{ [ ! -e "$CALLS34" ] || [ ! -s "$CALLS34" ]; } \
  && ok "(34) poll: no DM re-dispatch when marker pre-exists" \
  || bad "(34) poll: DM re-dispatch with existing marker"

# Case 35: SHIM_WFRUN_RC=1 → gh call logged but no marker written
SB="$(build_sandbox)"
CALLS35="$SB/gh-calls"
SHIM_PR_DM="4242" SHIM_GH_CALLS="$CALLS35" SHIM_STALE_JSON='[]' SHIM_WFRUN_RC=1 run_poll "$SB"
MARKER35="$(dm_marker_of "$SB" 4242)"
{ [ ! -e "$MARKER35" ] && grep -qF 'workflow run' "$CALLS35"; } \
  && ok "(35) poll: failed dispatch preserved for retry (no marker)" \
  || bad "(35) poll: marker written despite dispatch failure"

# Case 36: SHIM_STALE_JSON='[]' + SHIM_PR_DM set → DM fires before stale-count exit
SB="$(build_sandbox)"
CALLS36="$SB/gh-calls"
SHIM_STALE_JSON='[]' SHIM_PR_DM="4242" SHIM_GH_CALLS="$CALLS36" run_poll "$SB"
MARKER36="$(dm_marker_of "$SB" 4242)"
{ grep -qF 'workflow run docs-refreshed-notify.yml' "$CALLS36" \
    && [ -e "$MARKER36" ]; } \
  && ok "(36) poll: DM fires before stale-count exit (proves Step 6.1 placement)" \
  || bad "(36) poll: DM should fire even on empty stale set"

# --- Cases 37-40: bin/lib/docfix-dm.sh compose function ----------------------

