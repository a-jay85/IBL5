#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-adr-check — regression test for the local pre-push ADR gate.
#
# Covers the two compositions Part C relies on:
#   1. bin/adr-check --pr --bypass-from-stdin reading the bypass body from STDIN
#      (the commit-message blob the hook pipes in), against an origin/master..HEAD
#      range built in a throwaway repo.
#   2. bin/pre-push-adr-hook driving that composition end-to-end, including the
#      origin/master-absent degrade-open path.
#   3. adr-check --exclude-from=<file>, and bin/pre-commit-hook's merge-commit
#      exclusion (new_merge_repo): paths staged byte-identical to origin/master
#      under MERGE_HEAD skip the doc, destructive-migration, and ADR gates.
#
# Each case builds a temp git repo with a fake origin/master ref (no real remote
# needed: `git update-ref refs/remotes/origin/master <base>`). The repo's bin/
# gets UNTRACKED copies of adr-check + pre-push-adr-hook + bin/lib/branch-base.sh
# so REPO_ROOT resolves to the temp repo — untracked, so they never appear in
# `git diff` and can't become triggers themselves. The trigger file (bin/foo) is
# the only thing committed into bin/, so the diff sees exactly one added bin/ script.
#
# NOTE: The skip-observability-* structural assertions read the tracked file
# .github/workflows/pr-meta-checks.yml rather than a throwaway repo.
#
# Run: bin/test-adr-check  (exit 0 = all pass, 1 = a case failed)

set -u

# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
h_tmp BASE_TMP

REPO=""
GH_DIR=""
NO_GH=""

expect() { # name want got
    if [ "$3" -eq "$2" ]; then
        h_pass "$1 (exit $3)"
    else
        h_fail "$1" "expected exit $2, got $3"
    fi
}

# new_repo <with-origin: 1|0> — create a fresh temp repo with a base commit and
# (optionally) a fake origin/master ref. Sets $REPO.
new_repo() {
    REPO="$(mktemp -d "$BASE_TMP/repo.XXXXXX")"
    mkdir -p "$REPO/bin/lib"
    cp "$SCRIPT_DIR/adr-check" "$REPO/bin/adr-check"
    cp "$SCRIPT_DIR/pre-push-adr-hook" "$REPO/bin/pre-push-adr-hook"
    cp "$SCRIPT_DIR/lib/branch-base.sh" "$REPO/bin/lib/branch-base.sh"
    cp "$SCRIPT_DIR/pre-commit-hook" "$REPO/bin/pre-commit-hook"
    cp "$SCRIPT_DIR/lib/shell-scripts.sh" "$REPO/bin/lib/shell-scripts.sh"
    chmod +x "$REPO/bin/adr-check" "$REPO/bin/pre-push-adr-hook" \
             "$REPO/bin/pre-commit-hook" "$REPO/bin/lib/shell-scripts.sh"
    h_git_repo "$REPO" --no-commit
    echo base > "$REPO/README.md"
    mkdir -p "$REPO/ibl5"
    printf '{\n  "require": {\n    "vendor/base": "^1.0"\n  }\n}\n' \
        > "$REPO/ibl5/composer.json"
    git -C "$REPO" add README.md ibl5/composer.json   # NOT bin/* — keep the bin copies untracked
    git -C "$REPO" commit -qm base
    if [ "$1" -eq 1 ]; then
        git -C "$REPO" update-ref refs/remotes/origin/master "$(git -C "$REPO" rev-parse HEAD)"
    fi
}

# add_bin_trigger <commit-message> — commit a >=50-line bin/ script with a shebang
# (the new-tool-script trigger).
add_bin_trigger() {
    printf '#!/usr/bin/env bash\n' > "$REPO/bin/foo"
    i=1
    while [ "$i" -le 60 ]; do
        echo "# line $i" >> "$REPO/bin/foo"
        i=$((i + 1))
    done
    git -C "$REPO" add bin/foo
    git -C "$REPO" commit -qm "$1"
}

# add_no_trigger — commit a plain .txt file (no trigger surface).
add_no_trigger() {
    echo "notes" > "$REPO/notes.txt"
    git -C "$REPO" add notes.txt
    git -C "$REPO" commit -qm "add notes"
}

# add_misplaced_rule — commit a rule doc under ibl5/.claude/rules/ (a path
# bin/adr-check's preg_match('#^\.claude/rules/.+\.md$#') does NOT cover — the
# pattern is root-anchored, so ibl5/.claude/rules/ falls outside it — confirming
# adr-check correctly exits 0 for a miss rather than a suppressed require).
add_misplaced_rule() {
    mkdir -p "$REPO/ibl5/.claude/rules"
    echo "# a rule doc committed under the wrong prefix" > "$REPO/ibl5/.claude/rules/something.md"
    git -C "$REPO" add "ibl5/.claude/rules/something.md"
    git -C "$REPO" commit -q -m "docs: add rule doc"
}

# new_stack_repo — master -> parent -> child, with origin/master ADVANCED past the fork
# so origin/master is genuinely NOT an ancestor of child. Sets $REPO.
new_stack_repo() {
    new_repo 1
    git -C "$REPO" branch -M master
    git -C "$REPO" checkout -qb parent
    echo p > "$REPO/p.txt"; git -C "$REPO" add p.txt; git -C "$REPO" commit -qm "parent work"
    git -C "$REPO" update-ref refs/remotes/origin/parent "$(git -C "$REPO" rev-parse HEAD)"
    git -C "$REPO" checkout -q master
    echo m > "$REPO/m.txt"; git -C "$REPO" add m.txt; git -C "$REPO" commit -qm "master moves"
    git -C "$REPO" update-ref refs/remotes/origin/master "$(git -C "$REPO" rev-parse HEAD)"
    git -C "$REPO" checkout -q parent; git -C "$REPO" checkout -qb child
}

# fake_gh <answer> [<sleep-secs>] — PATH shim printing <answer> as baseRefName. Sets $GH_DIR.
fake_gh() {
    GH_DIR="$(mktemp -d "$BASE_TMP/gh.XXXXXX")"
    printf '%s\n' "$1" > "$GH_DIR/answer"
    { echo '#!/bin/sh'
      [ -n "${2:-}" ] && echo "sleep $2"
      echo 'cat "$(dirname "$0")/answer"'; } > "$GH_DIR/gh"
    chmod +x "$GH_DIR/gh"
}

run_hook_env() { # <env-assignments...> — runs the hook in $REPO with extra env
    ( cd "$REPO" && env "$@" "$REPO/bin/pre-push-adr-hook" </dev/null ) >/dev/null 2>&1
}

run_adr_check() { # runs the stdin composition inside $REPO
    ( cd "$REPO" && git log origin/master..HEAD --format='%B' \
        | "$REPO/bin/adr-check" --pr --bypass-from-stdin ) >/dev/null 2>&1
}

run_hook() { # runs the pre-push hook inside $REPO
    ( cd "$REPO" && "$REPO/bin/pre-push-adr-hook" ) >/dev/null 2>&1
}

BYPASS='<!-- no-adr: documented in an existing decision record -->'

# --- adr-check stdin composition (rows 8-9) ---

new_repo 1; add_bin_trigger "add foo tool"
run_adr_check; expect "adrcheck-trigger-no-bypass" 1 $?

new_repo 1; add_bin_trigger "add foo tool

$BYPASS"
run_adr_check; expect "adrcheck-bypass-via-stdin" 0 $?

new_repo 1; add_no_trigger
run_adr_check; expect "adrcheck-no-trigger" 0 $?

# --- pre-push hook script (rows 10-11) ---

new_repo 1; add_bin_trigger "add foo tool"
run_hook; expect "hook-trigger-no-adr" 1 $?

new_repo 1; add_no_trigger
run_hook; expect "hook-no-trigger" 0 $?

new_repo 1; add_bin_trigger "add foo tool

$BYPASS"
run_hook; expect "hook-bypass-trailer" 0 $?

# origin/master absent → degrade-open (exit 0) even with a trigger present.
new_repo 0; add_bin_trigger "add foo tool"
run_hook; expect "hook-no-origin-master" 0 $?

# --- stacked-PR base-resolution hook cases ---

# config base: no-trigger commit on child, config resolves to origin/parent, offline → pass
new_stack_repo
add_no_trigger
git -C "$REPO" config branch.child.iblBase parent
run_hook_env "BRANCH_BASE_OFFLINE=1"; expect "hook-stacked-config-base" 0 $?

# trigger on child with config base: trigger fires, no bypass → block
new_stack_repo
git -C "$REPO" config branch.child.iblBase parent
add_bin_trigger "add foo tool"
run_hook_env "BRANCH_BASE_OFFLINE=1"; expect "hook-stacked-trigger-still-blocks" 1 $?

# bypass marker in commit message: trigger fires but bypass honoured → pass
new_stack_repo
git -C "$REPO" config branch.child.iblBase parent
printf '#!/usr/bin/env bash\n' > "$REPO/bin/foo2"
i=1; while [ "$i" -le 60 ]; do echo "# line $i" >> "$REPO/bin/foo2"; i=$((i + 1)); done
git -C "$REPO" add bin/foo2
git -C "$REPO" commit -qm "add tool
<!-- no-adr: stacked PR uses parent base no ADR needed -->"
run_hook_env "BRANCH_BASE_OFFLINE=1"; expect "hook-stacked-bypass-honoured" 0 $?

# empty range: child has no commits beyond parent, config resolves base → pass
new_stack_repo
git -C "$REPO" config branch.child.iblBase parent
run_hook_env "BRANCH_BASE_OFFLINE=1"; expect "hook-stacked-empty-range" 0 $?

# parent branch not rebased onto master, no config, offline → block
new_stack_repo
git -C "$REPO" checkout -q parent
run_hook_env "BRANCH_BASE_OFFLINE=1"; expect "hook-behind-master-blocks" 1 $?

# child branch, no config, offline → unresolvable → block
new_stack_repo
run_hook_env "BRANCH_BASE_OFFLINE=1"; expect "hook-unresolvable-blocks" 1 $?

# stale config pointing at master (non-ancestor of child) → D6 rejects → block
new_stack_repo
git -C "$REPO" config branch.child.iblBase master
run_hook_env "BRANCH_BASE_OFFLINE=1"; expect "hook-stale-config-master-blocks" 1 $?

# missing branch-base.sh → fail-closed
new_stack_repo
git -C "$REPO" config branch.child.iblBase parent
rm "$REPO/bin/lib/branch-base.sh"
run_hook_env "BRANCH_BASE_OFFLINE=1"; expect "hook-missing-lib-blocks" 1 $?

# gh resolves base: no config, fake_gh returns "parent", offline unset → pass
new_stack_repo
fake_gh parent
run_hook_env "PATH=$GH_DIR:$PATH"; expect "hook-gh-resolves-base" 0 $?

# BRANCH_BASE_OFFLINE empty (not "1") → gh still called → resolves → pass
new_stack_repo
fake_gh parent
run_hook_env "PATH=$GH_DIR:$PATH" "BRANCH_BASE_OFFLINE="; expect "hook-gh-offline-empty-still-calls-gh" 0 $?

# BRANCH_BASE_OFFLINE=1 → gh skipped → unresolvable → block
new_stack_repo
fake_gh parent
run_hook_env "PATH=$GH_DIR:$PATH" "BRANCH_BASE_OFFLINE=1"; expect "hook-gh-offline-one-skips-gh" 1 $?

# hostile baseRefName from gh: starts with "--" → validation rejects → block
new_stack_repo
fake_gh "--upload-pack=evil"
run_hook_env "PATH=$GH_DIR:$PATH"; expect "hook-gh-hostile-baserefname" 1 $?

# injection: gh returns shell-metachar string; must not exec it, sentinel absent
new_stack_repo
fake_gh "p;touch $BASE_TMP/pwned"
run_hook_env "PATH=$GH_DIR:$PATH"; ex=$?
expect "hook-gh-injection-no-exec" 1 "$ex"
[ ! -e "$BASE_TMP/pwned" ] || h_fail "hook-gh-injection-no-exec" "sentinel created"

# timeout: fake_gh sleeps 30s; hook must exit within 15s total
new_stack_repo
fake_gh parent 30
start=$SECONDS
run_hook_env "PATH=$GH_DIR:$PATH"; expect "hook-gh-timeout-bounded" 1 $?
elapsed=$(( SECONDS - start ))
if [ "$elapsed" -lt 15 ]; then
    h_pass "hook-gh-timeout-bounded-elapsed (${elapsed}s < 15)"
else
    h_fail "hook-gh-timeout-bounded-elapsed" "took ${elapsed}s (expected < 15)"
fi

# --- adrcheck --base=<ref> flag cases ---

# Shared setup: trigger on parent branch, origin/parent advanced, child merges parent.
# A null gh shim prevents any accidental call to the real gh binary.
NO_GH="$(mktemp -d "$BASE_TMP/nogh.XXXXXX")"
printf '#!/bin/sh\nexit 1\n' > "$NO_GH/gh"; chmod +x "$NO_GH/gh"

new_stack_repo
git -C "$REPO" checkout -q parent
printf '#!/usr/bin/env bash\n' > "$REPO/bin/foo"
i=1; while [ "$i" -le 60 ]; do echo "# line $i" >> "$REPO/bin/foo"; i=$((i + 1)); done
git -C "$REPO" add bin/foo
git -C "$REPO" commit -qm "add foo tool"
git -C "$REPO" update-ref refs/remotes/origin/parent "$(git -C "$REPO" rev-parse HEAD)"
git -C "$REPO" checkout -q child
git -C "$REPO" merge -q parent -m merge

( cd "$REPO" && PATH="$NO_GH:$PATH" "$REPO/bin/adr-check" --pr --base=origin/parent ) >/dev/null 2>&1
expect "adrcheck-base-parent-clean" 0 $?

( cd "$REPO" && PATH="$NO_GH:$PATH" "$REPO/bin/adr-check" --pr --base=origin/master ) >/dev/null 2>&1
expect "adrcheck-base-master-trips" 1 $?

( cd "$REPO" && PATH="$NO_GH:$PATH" "$REPO/bin/adr-check" --base=origin/parent --pr ) >/dev/null 2>&1
expect "adrcheck-base-order-swapped" 0 $?

( cd "$REPO" && PATH="$NO_GH:$PATH" "$REPO/bin/adr-check" --pr --base origin/parent ) >/dev/null 2>&1
expect "adrcheck-base-space-form" 2 $?

( cd "$REPO" && PATH="$NO_GH:$PATH" "$REPO/bin/adr-check" --pr --base= ) >/dev/null 2>&1
expect "adrcheck-base-empty" 2 $?

( cd "$REPO" && PATH="$NO_GH:$PATH" "$REPO/bin/adr-check" --pr --base=-x ) >/dev/null 2>&1
expect "adrcheck-base-leading-dash" 2 $?

( cd "$REPO" && PATH="$NO_GH:$PATH" "$REPO/bin/adr-check" --pr --base=a..b ) >/dev/null 2>&1
expect "adrcheck-base-dotdot" 2 $?

( cd "$REPO" && PATH="$NO_GH:$PATH" "$REPO/bin/adr-check" --staged --base=origin/parent ) >/dev/null 2>&1
expect "adrcheck-base-with-staged" 2 $?

# staged mode with a non-trigger file: no triggers → pass
new_repo 1
echo "plain" > "$REPO/notes.txt"
git -C "$REPO" add notes.txt
( cd "$REPO" && "$REPO/bin/adr-check" --staged ) >/dev/null 2>&1
expect "adrcheck-staged-unchanged" 0 $?

# --- install-git-hooks idempotency + backup-once ---
# install-git-hooks resolves the hooks dir from cwd's git (--git-common-dir), so
# running the worktree copy inside $REPO targets $REPO/.git/hooks. Seed a fake
# non-shim pre-push (the default git-lfs hook) and assert it is backed up once and
# replaced by our sentinel shim, idempotently.
ok_check() { # name condition-already-evaluated($?-style via [ ])
    if [ "$2" -eq 0 ]; then h_pass "$1"; else h_fail "$1"; fi
}

new_repo 1
printf '#!/bin/sh\n# original git-lfs hook\ngit lfs pre-push "$@"\n' > "$REPO/.git/hooks/pre-push"
chmod +x "$REPO/.git/hooks/pre-push"
( cd "$REPO" && "$SCRIPT_DIR/install-git-hooks" ) >/dev/null 2>&1
grep -qF '# IBL5-ADR-HOOK' "$REPO/.git/hooks/pre-push"; ok_check "install-writes-shim" $?
grep -qF 'original git-lfs hook' "$REPO/.git/hooks/pre-push.pre-adr.bak" 2>/dev/null; ok_check "install-backs-up-original-once" $?

# Re-run: still our shim, backup unchanged (no second overwrite), exits clean.
( cd "$REPO" && "$SCRIPT_DIR/install-git-hooks" ) >/dev/null 2>&1; reinstall_exit=$?
ok_check "install-rerun-clean-exit" "$reinstall_exit"
grep -qF '# IBL5-ADR-HOOK' "$REPO/.git/hooks/pre-push"; ok_check "install-idempotent-shim" $?
grep -qF 'original git-lfs hook' "$REPO/.git/hooks/pre-push.pre-adr.bak" 2>/dev/null; ok_check "install-backup-preserved" $?

# --- adrcheck misplaced-rules prefix does not trigger ADR requirement ---
new_repo 1
add_misplaced_rule
run_adr_check; expect "adrcheck-misplaced-rules-prefix-no-trigger" 0 $?

# --- skip-observability: assert the workflow carries a visible skip step ---
WF="$SCRIPT_DIR/../.github/workflows/pr-meta-checks.yml"
SKIP_IF="$(grep -A3 -F -e '- name: adr-check skipped' "$WF" 2>/dev/null | grep -m1 -F 'if:' || true)"

[ -f "$WF" ] && ok_check "skip-observability-workflow-file-present" 0 \
    || ok_check "skip-observability-workflow-file-present" 1
grep -qF 'adr-check skipped' "$WF" 2>/dev/null; ok_check "skip-observability-else-branch-exists" $?
grep -qF 'adr-check skipped: no decision-trigger paths in diff' "$WF" 2>/dev/null; ok_check "skip-observability-message-exact" $?
echo "$SKIP_IF" | grep -qF "steps.filter.outputs.adr != 'true'"; ok_check "skip-observability-if-is-filter-complement" $?
echo "$SKIP_IF" | grep -qF "github.event_name == 'pull_request'"; ok_check "skip-observability-if-guards-pull-request" $?
echo "$SKIP_IF" | grep -qF '!cancelled()'; ok_check "skip-observability-if-runs-when-job-red" $?

# ============================================================
# Phase 3 — bin/adr-check --commit and pre-commit-hook cases
# ============================================================

# --- additional helpers ---

# stage_bin_trigger — write a 60-line shebang script and stage it (no commit).
stage_bin_trigger() {
    printf '#!/usr/bin/env bash\n' > "$REPO/bin/foo"
    i=1
    while [ "$i" -le 60 ]; do
        echo "# line $i" >> "$REPO/bin/foo"
        i=$((i + 1))
    done
    git -C "$REPO" add bin/foo
}

# stage_no_trigger — stage a plain .txt file (no trigger surface, no commit).
stage_no_trigger() {
    echo "notes" > "$REPO/notes.txt"
    git -C "$REPO" add notes.txt
}

# stage_adr — create ADR file and stage it (no commit).
stage_adr() {
    mkdir -p "$REPO/ibl5/docs/decisions"
    echo "# Decision record" > "$REPO/ibl5/docs/decisions/0042-test-decision.md"
    git -C "$REPO" add ibl5/docs/decisions/0042-test-decision.md
}

# commit_adr — create ADR file, stage, and commit.
commit_adr() {
    mkdir -p "$REPO/ibl5/docs/decisions"
    echo "# Decision record" > "$REPO/ibl5/docs/decisions/0042-test-decision.md"
    git -C "$REPO" add ibl5/docs/decisions/0042-test-decision.md
    git -C "$REPO" commit -qm "docs: add ADR-0042"
}

# stage_trigger <kind> — stage exactly one trigger file of the given kind (no commit).
stage_trigger() {
    case "$1" in
        phpstan)
            mkdir -p "$REPO/ibl5/phpstan-rules"
            echo '<?php class NoFooRule {}' > "$REPO/ibl5/phpstan-rules/NoFooRule.php"
            git -C "$REPO" add ibl5/phpstan-rules/NoFooRule.php
            ;;
        rule)
            mkdir -p "$REPO/.claude/rules"
            echo "# rule" > "$REPO/.claude/rules/foo.md"
            git -C "$REPO" add .claude/rules/foo.md
            ;;
        workflow)
            mkdir -p "$REPO/.github/workflows"
            echo "on: push" > "$REPO/.github/workflows/foo.yml"
            git -C "$REPO" add .github/workflows/foo.yml
            ;;
        migration)
            mkdir -p "$REPO/ibl5/migrations"
            printf 'DROP TABLE foo;\n' > "$REPO/ibl5/migrations/2026_01_01_drop.sql"
            git -C "$REPO" add ibl5/migrations/2026_01_01_drop.sql
            ;;
        script)
            stage_bin_trigger
            ;;
        dependency)
            printf '{\n  "require": {\n    "vendor/base": "^1.0",\n    "vendor/pkg": "^1.0"\n  }\n}\n' \
                > "$REPO/ibl5/composer.json"
            git -C "$REPO" add ibl5/composer.json
            ;;
        *)
            echo "stage_trigger: unknown kind: $1" >&2
            return 1
            ;;
    esac
}

# run_adr_check_commit — pipe branch commit messages into adr-check --commit.
run_adr_check_commit() {
    git -C "$REPO" log --format=%B \
        "$(git -C "$REPO" merge-base HEAD origin/master 2>/dev/null)..HEAD" 2>/dev/null \
        | (cd "$REPO" && ./bin/adr-check --commit --bypass-from-stdin >/dev/null 2>&1)
}

# run_adr_check_commit_stdin <body> — pipe an explicit body instead.
run_adr_check_commit_stdin() {
    printf '%s' "$1" \
        | (cd "$REPO" && ./bin/adr-check --commit --bypass-from-stdin >/dev/null 2>&1)
}

# run_pre_commit_hook — run the pre-commit hook; capture all output to .hookout.
run_pre_commit_hook() {
    (cd "$REPO" && ./bin/pre-commit-hook >"$REPO/.hookout" 2>&1)
}

# --- adr-check --commit mode cases ---

# trigger staged alongside an ADR in the same staged set → pass
new_repo 1; stage_bin_trigger; stage_adr
run_adr_check_commit; expect "commit-trigger-and-adr-same-staged-set" 0 $?

# trigger staged; ADR was committed in an earlier commit on this branch → pass (regression)
new_repo 1; commit_adr; stage_bin_trigger
run_adr_check_commit; expect "commit-trigger-staged-adr-in-earlier-commit" 0 $?

# trigger staged with no ADR anywhere → fail
new_repo 1; stage_bin_trigger
run_adr_check_commit; expect "commit-trigger-staged-no-adr" 1 $?

# each of the six trigger kinds staged with no ADR → fail
new_repo 1; stage_trigger phpstan
run_adr_check_commit; expect "commit-trigger-phpstan-no-adr" 1 $?

new_repo 1; stage_trigger rule
run_adr_check_commit; expect "commit-trigger-rule-no-adr" 1 $?

new_repo 1; stage_trigger workflow
run_adr_check_commit; expect "commit-trigger-workflow-no-adr" 1 $?

new_repo 1; stage_trigger migration
run_adr_check_commit; expect "commit-trigger-migration-no-adr" 1 $?

new_repo 1; stage_trigger script
run_adr_check_commit; expect "commit-trigger-script-no-adr" 1 $?

new_repo 1; stage_trigger dependency
run_adr_check_commit; expect "commit-trigger-dependency-no-adr" 1 $?

# script trigger staged with ADR → pass
new_repo 1; stage_trigger script; stage_adr
run_adr_check_commit; expect "commit-trigger-script-with-adr" 0 $?

# migration trigger staged with ADR → pass
new_repo 1; stage_trigger migration; stage_adr
run_adr_check_commit; expect "commit-trigger-migration-with-adr" 0 $?

# bypass marker long enough → pass
new_repo 1; stage_bin_trigger
run_adr_check_commit_stdin '<!-- no-adr: this reason is definitely long enough -->'
expect "commit-bypass-long-enough" 0 $?

# bypass marker too short → fail
new_repo 1; stage_bin_trigger
run_adr_check_commit_stdin '<!-- no-adr: too short -->'
expect "commit-bypass-too-short" 1 $?

# workflow trigger + runner-shaped bypass body (marker prepended above the
# PR body, as runner.py _upsert_no_adr_markers writes it) → pass
new_repo 1; stage_trigger workflow
run_adr_check_commit_stdin $'<!-- no-adr: new CI workflow governed by existing ADR-0059 -->\n\n## Summary\n- x\n'
expect "commit-workflow-bypass-runner-shape" 0 $?

# workflow trigger + two prepended markers → pass
new_repo 1; stage_trigger workflow
run_adr_check_commit_stdin $'<!-- no-adr: first marker reason long enough -->\n<!-- no-adr: second marker reason long enough -->\n\n## Summary\n- x\n'
expect "commit-workflow-bypass-two-markers" 0 $?

# workflow trigger + marker whose reason spans lines → pass
# (pins the /s modifier on BYPASS_REGEX at bin/adr-check:24)
new_repo 1; stage_trigger workflow
run_adr_check_commit_stdin $'<!-- no-adr:\n  reason line one long\n  line two -->\n\n## Summary\n- x\n'
expect "commit-workflow-bypass-multiline" 0 $?

# workflow trigger + reason under 15 chars → fail
new_repo 1; stage_trigger workflow
run_adr_check_commit_stdin $'<!-- no-adr: ADR-0059 -->\n\n## Summary\n- x\n'
expect "commit-workflow-bypass-too-short" 1 $?

# workflow trigger + wrong comment form (no "no-" prefix) → fail
# (a prefix of (?:no-)?adr: would wrongly bypass)
new_repo 1; stage_trigger workflow
run_adr_check_commit_stdin $'<!-- adr: new CI workflow governed by existing ADR-0059 -->\n\n## Summary\n- x\n'
expect "commit-workflow-bypass-wrong-form" 1 $?

# --- extractBypassReason characterization (pins the shared gate-common.php core) ---
# Each row: fresh repo, staged bin/ trigger, explicit body on stdin, exit code.
adr_bypass_row() { # <name> <want-exit> <body>
    new_repo 1; stage_bin_trigger
    run_adr_check_commit_stdin "$3"
    expect "$1" "$2" $?
}
adr_bypass_row "adr-bypass-exact-min-length"     0 '<!-- no-adr: abcdefghijklmno -->'
adr_bypass_row "adr-bypass-one-under-min"        1 '<!-- no-adr: abcdefghijklmn -->'
adr_bypass_row "adr-bypass-trim-before-length"   1 '<!--    no-adr:     abcdefghijklmn     -->'
adr_bypass_row "adr-bypass-strlen-counts-bytes"  0 '<!-- no-adr: ééééé12345 -->'
adr_bypass_row "adr-bypass-first-match-only"     1 $'<!-- no-adr: short -->\n<!-- no-adr: second marker reason long enough -->'
adr_bypass_row "adr-bypass-literal-null-body"    1 'null'
adr_bypass_row "adr-bypass-empty-body"           1 ''
adr_bypass_row "adr-bypass-refactor-marker-rejected" 1 '<!-- no-refactor-tests: a reason that is long enough -->'

# --- fetchPrBody characterization: gh argv, PR_NUMBER set/empty/unset, gh failure ---
# recording_gh <exit-code> <body> — PATH shim: logs argv one per line to
# $GH_DIR/argv, prints <body>, exits <exit-code>. Sets $GH_DIR.
recording_gh() {
    GH_DIR="$(mktemp -d "$BASE_TMP/rgh.XXXXXX")"
    printf '%s\n' "$2" > "$GH_DIR/body"
    { echo '#!/bin/sh'
      echo 'd="$(dirname "$0")"'
      echo 'printf "%s\n" "$@" >> "$d/argv"'
      echo 'cat "$d/body"'
      echo "exit $1"; } > "$GH_DIR/gh"
    chmod +x "$GH_DIR/gh"
}
ADR_STUB_BODY='<!-- no-adr: stub body reason that is long enough -->'

new_repo 1; add_bin_trigger "add tool"; recording_gh 0 "$ADR_STUB_BODY"
( cd "$REPO" && env PATH="$GH_DIR:$PATH" PR_NUMBER=4242 \
    ./bin/adr-check --pr --base=origin/master </dev/null ) >/dev/null 2>&1
expect "adr-fetch-pr-number-set-bypasses" 0 $?
printf '%s\n' pr view 4242 --json body --jq .body | cmp -s - "$GH_DIR/argv"
ok_check "adr-fetch-pr-number-set-argv" $?

new_repo 1; add_bin_trigger "add tool"; recording_gh 0 "$ADR_STUB_BODY"
( cd "$REPO" && env -u PR_NUMBER PATH="$GH_DIR:$PATH" \
    ./bin/adr-check --pr --base=origin/master </dev/null ) >/dev/null 2>&1
expect "adr-fetch-pr-number-unset-bypasses" 0 $?
printf '%s\n' pr view --json body --jq .body | cmp -s - "$GH_DIR/argv"
ok_check "adr-fetch-pr-number-unset-argv" $?

new_repo 1; add_bin_trigger "add tool"; recording_gh 0 "$ADR_STUB_BODY"
( cd "$REPO" && env PATH="$GH_DIR:$PATH" PR_NUMBER= \
    ./bin/adr-check --pr --base=origin/master </dev/null ) >/dev/null 2>&1
printf '%s\n' pr view --json body --jq .body | cmp -s - "$GH_DIR/argv"
ok_check "adr-fetch-pr-number-empty-omits-number" $?

new_repo 1; add_bin_trigger "add tool"; recording_gh 1 "$ADR_STUB_BODY"
( cd "$REPO" && env PATH="$GH_DIR:$PATH" PR_NUMBER=4242 \
    ./bin/adr-check --pr --base=origin/master </dev/null ) >/dev/null 2>&1
expect "adr-fetch-gh-failure-null-body-rejects" 1 $?

# no trigger → pass
new_repo 1; add_no_trigger
run_adr_check_commit; expect "commit-no-trigger-clean" 0 $?

# empty commit range: HEAD == origin/master, trigger staged but not committed.
# merge-base..HEAD range is empty so bypass body is empty; diff still sees staged trigger.
new_repo 1; stage_bin_trigger
run_adr_check_commit; expect "commit-empty-range-first-commit" 1 $?
_erf_out=$(cd "$REPO" && ./bin/adr-check --commit --bypass-from-stdin </dev/null 2>/dev/null)
[ -n "$_erf_out" ] && ok_check "commit-empty-range-first-commit-output" 0 \
    || ok_check "commit-empty-range-first-commit-output" 1

# twin: same empty range, no-trigger file staged only → pass
new_repo 1; stage_no_trigger
run_adr_check_commit; expect "commit-empty-range-no-trigger" 0 $?

# no origin/master → degrade open (exit 0) with a diagnostic message
new_repo 0; stage_bin_trigger
_nod_out=$(cd "$REPO" && ./bin/adr-check --commit --bypass-from-stdin </dev/null 2>/dev/null)
_nod_exit=$?
expect "commit-no-origin-master-degrades-open" 0 "$_nod_exit"
grep -qF 'cannot resolve a merge-base' <<< "$_nod_out"
ok_check "commit-no-origin-master-degrades-open-msg" $?

# stacked: feature branches from parent (which has the ADR committed); merge-base against
# origin/master is the initial commit, so the diff window covers parent's ADR → pass.
new_repo 1
git -C "$REPO" checkout -qb parent
commit_adr
git -C "$REPO" checkout -qb feature
git -C "$REPO" config branch.feature.iblBase parent
stage_bin_trigger
run_adr_check_commit; expect "commit-stacked-base-resolves-to-origin-master" 0 $?

# stacked: parent has a tool commit but no ADR; feature also has no ADR → fail.
new_repo 1
git -C "$REPO" checkout -qb parent
add_bin_trigger "parent work"
git -C "$REPO" checkout -qb feature
git -C "$REPO" config branch.feature.iblBase parent
stage_bin_trigger
run_adr_check_commit; expect "commit-stacked-base-no-adr-anywhere" 1 $?

# --base=origin/master accepted for --commit (not a usage error, but trigger fires → exit 1)
new_repo 1; stage_bin_trigger
(cd "$REPO" && ./bin/adr-check --commit --base=origin/master </dev/null >/dev/null 2>&1)
expect "commit-base-flag-accepted" 1 $?

# --base= rejected for --staged (usage error → exit 2)
(cd "$REPO" && ./bin/adr-check --staged --base=origin/master </dev/null >/dev/null 2>&1)
expect "staged-base-flag-rejected" 2 $?

# --- pre-commit-hook cases ---

# trigger staged with no ADR → hook denies and prints the marker
new_repo 1; stage_bin_trigger
run_pre_commit_hook; expect "hook-trigger-staged-no-adr-denies" 1 $?
grep -qF 'pre-commit-adr-gate:' "$REPO/.hookout"; ok_check "hook-trigger-staged-no-adr-denies-marker" $?

# ADR committed earlier, trigger staged → hook passes
new_repo 1; commit_adr; stage_bin_trigger
run_pre_commit_hook; expect "hook-trigger-staged-adr-earlier-commit-passes" 0 $?

# no origin/master → ADR gate block skipped → hook passes
new_repo 0; stage_bin_trigger
run_pre_commit_hook; expect "hook-no-origin-master-degrades-open" 0 $?

# no trigger staged → hook passes
new_repo 1; stage_no_trigger
run_pre_commit_hook; expect "hook-no-trigger-passes" 0 $?

# --- --exclude-from cases (adr-check flag, then the pre-commit hook's merge exclusion) ---

# want <name> <haystack> <needle> — the haystack contains the needle.
want() { h_contains "$1" "$2" "$3"; }

# want_not <name> <haystack> <needle> — the haystack does not contain the needle.
want_not() { h_not_contains "$1" "$2" "$3"; }

# write_tool <repo-relative path> — a 60-line shebang script (the new-tool-script trigger).
write_tool() {
    printf '#!/usr/bin/env bash\n' > "$REPO/$1"
    i=1
    while [ "$i" -le 60 ]; do
        echo "# line $i" >> "$REPO/$1"
        i=$((i + 1))
    done
}

# merge_exclude_file — absolute path of the hook's merge-exclusion list in $REPO.
merge_exclude_file() {
    printf '%s/%s\n' "$REPO" "$(cd "$REPO" && git rev-parse --git-path pre-commit-merge-exclude)"
}

# new_merge_repo [stacked|delete] — new_repo 1 plus the doc and destructive-migration
# gates, a branch `feat`, and a master that moved on with a body-edited doc (date not
# bumped), an unmarked DROP TABLE migration, and a 60-line bin/ tool. Ends on `feat`
# mid `git merge --no-commit --no-ff origin/master`: MERGE_HEAD exists and master's
# three files sit in the index byte-identical to origin/master.
#   stacked: stop on `feat` before master moves and before any merge.
#   delete:  the base also tracks src/old.txt, feat edits it, master deletes it, and
#            the modify/delete conflict is resolved by keeping feat's version.
new_merge_repo() {
    new_repo 1
    cp -p "$SCRIPT_DIR/check-docs" "$REPO/bin/check-docs"
    cp -p "$SCRIPT_DIR/check-destructive-migrations" "$REPO/bin/check-destructive-migrations"
    cp -p "$SCRIPT_DIR/lib/destructive-migration-scan.py" "$REPO/bin/lib/destructive-migration-scan.py"
    git -C "$REPO" branch -M master
    # last_verified three days back: fresh for the 60-day staleness rule, older than
    # every commit here, so an unbumped body edit trips only the on-touch bump.
    MERGE_LV=$(php -r 'echo gmdate("Y-m-d", time() - 3 * 86400);')
    mkdir -p "$REPO/ibl5/docs" "$REPO/ibl5/migrations" "$REPO/src"
    printf -- '---\ndescription: g\nlast_verified: %s\n---\nA1\n' "$MERGE_LV" > "$REPO/ibl5/docs/guide.md"
    printf -- '---\ndescription: r\nlast_verified: %s\n---\nbase\n' "$MERGE_LV" > "$REPO/README.md"
    : > "$REPO/ibl5/migrations/.gitkeep"
    echo old > "$REPO/src/old.txt"
    git -C "$REPO" add README.md ibl5/docs/guide.md ibl5/migrations/.gitkeep
    [ "${1:-}" = delete ] && git -C "$REPO" add src/old.txt
    git -C "$REPO" commit -qm "guide and migrations dir"
    git -C "$REPO" update-ref refs/remotes/origin/master "$(git -C "$REPO" rev-parse HEAD)"
    [ "${1:-}" = delete ] || rm -f "$REPO/src/old.txt"
    # The full-scan doc check reads the copied bin/ scripts' comments; give every repo
    # path they cite an untracked placeholder (a directory, or a valid doc for *.md)
    # so the scratch repo passes it and only the gates under test can fail.
    (cd "$REPO" && ./bin/check-docs --no-staleness 2>/dev/null) \
        | sed -n 's/.*dead reference in comment: `\([^`]*\)`.*/\1/p' | sort -u \
        | while IFS= read -r ref; do
            case "$ref" in
                *.md) mkdir -p "$REPO/$(dirname "$ref")"
                      printf -- '---\ndescription: p\nlast_verified: %s\n---\np\n' "$MERGE_LV" > "$REPO/$ref" ;;
                *) mkdir -p "$REPO/$ref" ;;
            esac
        done
    git -C "$REPO" checkout -qb feat
    echo x > "$REPO/src/x.txt"
    git -C "$REPO" add src/x.txt
    [ "${1:-}" = delete ] && { echo branch-edit >> "$REPO/src/old.txt"; git -C "$REPO" add src/old.txt; }
    git -C "$REPO" commit -qm "feat work"
    [ "${1:-}" = stacked ] && return 0
    git -C "$REPO" checkout -q master
    echo A2 >> "$REPO/ibl5/docs/guide.md"
    printf 'DROP TABLE foo;\n' > "$REPO/ibl5/migrations/900_master_drop.sql"
    write_tool bin/master-tool
    git -C "$REPO" add ibl5/docs/guide.md ibl5/migrations/900_master_drop.sql bin/master-tool
    [ "${1:-}" = delete ] && git -C "$REPO" rm -q src/old.txt
    git -C "$REPO" commit -qm "master moves"
    git -C "$REPO" update-ref refs/remotes/origin/master "$(git -C "$REPO" rev-parse HEAD)"
    git -C "$REPO" checkout -q feat
    git -C "$REPO" merge --no-commit --no-ff origin/master >/dev/null 2>&1
    if [ "${1:-}" = delete ]; then
        git -C "$REPO" checkout -q feat -- src/old.txt
        git -C "$REPO" add src/old.txt
    fi
    git -C "$REPO" rev-parse -q --verify MERGE_HEAD >/dev/null \
        || h_fail "new_merge_repo left no MERGE_HEAD"
}

# adr-check --commit --exclude-from=<file> (equals form only)
new_repo 1; write_tool bin/new-tool; git -C "$REPO" add bin/new-tool
printf 'bin/new-tool\n' > "$REPO/.excl"
_xo=$(cd "$REPO" && ./bin/adr-check --commit --exclude-from="$REPO/.excl" </dev/null 2>&1)
expect "adr-exclude-from-listed-trigger-skipped" 0 $?
want "adr-exclude-from-listed-trigger-skipped: reports no trigger" "$_xo" "No decision-trigger surfaces touched"
_xo=$(cd "$REPO" && ./bin/adr-check --commit </dev/null 2>&1)
expect "adr-exclude-from-absent-trigger-fires" 1 $?
want "adr-exclude-from-absent-trigger-fires: names bin/new-tool" "$_xo" "bin/new-tool"
printf 'bin/other-tool\n\n' > "$REPO/.excl-other"
_xo=$(cd "$REPO" && ./bin/adr-check --commit --exclude-from="$REPO/.excl-other" </dev/null 2>&1)
expect "adr-exclude-from-unlisted-trigger-fires" 1 $?
want "adr-exclude-from-unlisted-trigger-fires: names bin/new-tool" "$_xo" "[new-tool-script] bin/new-tool"
_xo=$(cd "$REPO" && ./bin/adr-check --commit --exclude-from="$REPO/missing" </dev/null 2>&1)
expect "adr-exclude-from-missing-file-exits-2" 2 $?
want "adr-exclude-from-missing-file-exits-2: cannot read --exclude-from file" "$_xo" "cannot read --exclude-from file"
want "adr-exclude-from-missing-file-exits-2: names the path" "$_xo" "$REPO/missing"
_xo=$(cd "$REPO" && ./bin/adr-check --commit --exclude-from "$REPO/.excl" </dev/null 2>&1)
expect "adr-exclude-from-space-form-exits-2" 2 $?
want "adr-exclude-from-space-form-exits-2: unknown flag" "$_xo" "unknown flag: --exclude-from"

# merge: master-identical doc, migration and tool pass
new_merge_repo
run_pre_commit_hook; expect "merge: master-identical doc, migration and tool pass" 0 $?
_ho=$(cat "$REPO/.hookout")
want_not "merge: master-identical pass: no Bump last_verified" "$_ho" "Bump last_verified"
want_not "merge: master-identical pass: no Add a tagged marker" "$_ho" "Add a tagged marker"
want_not "merge: master-identical pass: no pre-commit-adr-gate" "$_ho" "pre-commit-adr-gate"
_xl=$(cat "$(merge_exclude_file)" 2>/dev/null)
want "merge: master-identical pass: list has the doc" "$_xl" "ibl5/docs/guide.md"
want "merge: master-identical pass: list has the migration" "$_xl" "ibl5/migrations/900_master_drop.sql"
want "merge: master-identical pass: list has the tool" "$_xl" "bin/master-tool"

# merge: branch-authored doc edit without bump still fails
new_merge_repo
echo B1 >> "$REPO/ibl5/docs/guide.md"; git -C "$REPO" add ibl5/docs/guide.md
run_pre_commit_hook; expect "merge: branch-authored doc edit without bump still fails" 1 $?
_ho=$(cat "$REPO/.hookout")
want "merge: branch-authored doc edit: Bump last_verified" "$_ho" "Bump last_verified"
want "merge: branch-authored doc edit: names the doc as not bumped" "$_ho" "ibl5/docs/guide.md: body changed but last_verified not bumped"

# merge: branch-authored destructive migration still fails
new_merge_repo
printf 'DROP TABLE bar;\n' > "$REPO/ibl5/migrations/901_branch_drop.sql"
git -C "$REPO" add ibl5/migrations/901_branch_drop.sql
run_pre_commit_hook; expect "merge: branch-authored destructive migration still fails" 1 $?
_ho=$(cat "$REPO/.hookout")
want "merge: branch-authored destructive migration: Add a tagged marker" "$_ho" "Add a tagged marker"
want "merge: branch-authored destructive migration: names 901_branch_drop.sql" "$_ho" "901_branch_drop.sql"
want_not "merge: branch-authored destructive migration: master's 900_master_drop.sql not named" "$_ho" "900_master_drop.sql"

# merge: branch-authored bin trigger still needs an ADR
new_merge_repo
write_tool bin/branch-tool; git -C "$REPO" add bin/branch-tool
run_pre_commit_hook; expect "merge: branch-authored bin trigger still needs an ADR" 1 $?
_ho=$(cat "$REPO/.hookout")
want "merge: branch-authored bin trigger: pre-commit-adr-gate" "$_ho" "pre-commit-adr-gate"
want "merge: branch-authored bin trigger: names bin/branch-tool" "$_ho" "bin/branch-tool"
want_not "merge: branch-authored bin trigger: master's bin/master-tool not named" "$_ho" "bin/master-tool"

# no merge: exclusion file is ignored. The staged doc is byte-identical to
# origin/master, so honouring the stale list (or dropping the MERGE_HEAD guard)
# would exclude it and pass.
new_merge_repo
git -C "$REPO" merge --abort
echo A2 >> "$REPO/ibl5/docs/guide.md"; git -C "$REPO" add ibl5/docs/guide.md
printf 'ibl5/docs/guide.md\n' > "$(merge_exclude_file)"
run_pre_commit_hook; expect "no merge: exclusion file is ignored" 1 $?
_ho=$(cat "$REPO/.hookout")
want "no merge: exclusion file is ignored: Bump last_verified" "$_ho" "Bump last_verified"
want "no merge: exclusion file is ignored: names the doc" "$_ho" "ibl5/docs/guide.md: body changed"

# merge: path master deleted is not excluded
new_merge_repo delete
run_pre_commit_hook
_xf=$(merge_exclude_file)
if [ -f "$_xf" ]; then _rc=0; else _rc=1; fi
ok_check "merge: path master deleted: exclusion list written" "$_rc"
_xl=$(cat "$_xf" 2>/dev/null)
want "merge: path master deleted: list still has master's doc" "$_xl" "ibl5/docs/guide.md"
! grep -qxF src/old.txt "$_xf"; ok_check "merge: path master deleted is not excluded" $?

# stacked: a branch on an unmerged parent, no MERGE_HEAD — doc_base and adr_base
# still derive from merge-base HEAD origin/master, the exclusion list stays empty,
# and the parent's unbumped doc edit is gated as before.
new_merge_repo stacked
git -C "$REPO" checkout -qb parent
echo P1 >> "$REPO/ibl5/docs/guide.md"; git -C "$REPO" add ibl5/docs/guide.md
git -C "$REPO" commit -qm "parent doc edit"
git -C "$REPO" checkout -qb child
printf -- '---\ndescription: c\nlast_verified: %s\n---\nC1\n' "$MERGE_LV" > "$REPO/ibl5/docs/child.md"
git -C "$REPO" add ibl5/docs/child.md
run_pre_commit_hook; expect "stacked: no MERGE_HEAD, parent's doc edit still gated" 1 $?
_ho=$(cat "$REPO/.hookout")
want "stacked: parent's doc edit: Bump last_verified" "$_ho" "Bump last_verified"
want "stacked: parent's doc edit: names the doc" "$_ho" "ibl5/docs/guide.md: body changed"
_sb=$(git -C "$REPO" merge-base HEAD origin/master)
want "stacked: doc_base is merge-base HEAD origin/master" "$_ho" "--since=$_sb"
if [ -s "$(merge_exclude_file)" ]; then _rc=1; else _rc=0; fi
ok_check "stacked: exclusion list stays empty" "$_rc"

# stacked, ADR side: the parent's committed 60-line bin/ tool is still in adr_base's
# window (merge-base HEAD origin/master) while the child stages a non-doc file.
new_merge_repo stacked
git -C "$REPO" checkout -qb parent
write_tool bin/parent-tool; git -C "$REPO" add bin/parent-tool
git -C "$REPO" commit -qm "parent tool"
git -C "$REPO" checkout -qb child
echo c > "$REPO/src/child.txt"; git -C "$REPO" add src/child.txt
run_pre_commit_hook; expect "stacked: no MERGE_HEAD, parent's bin tool still needs an ADR" 1 $?
_ho=$(cat "$REPO/.hookout")
want "stacked: parent's bin tool: pre-commit-adr-gate" "$_ho" "pre-commit-adr-gate"
want "stacked: parent's bin tool: names bin/parent-tool" "$_ho" "bin/parent-tool"
if [ -s "$(merge_exclude_file)" ]; then _rc=1; else _rc=0; fi
ok_check "stacked: parent's bin tool: exclusion list stays empty" "$_rc"

h_done
