#!/usr/bin/env bun
// bin/vr-refresh-targets — pick stale visual-review PRs to refresh, and list the
// gh-pages gallery dirs that open PRs still link (the retention keep-list).
//
// Thin I/O glue over ibl5/tests/e2e/vr-refresh.ts: this file runs `gh` and `git`
// and prints. Every decision lives in the module, which vitest covers.
//
// Modes (flags take the `=` form only):
//   --mode=select --pages-dir=PATH [--pr=N | --all] [--stale-days=N] [--max-prs=N]
//       stdout: one JSON line {"count":N,"matrix":[...],"skipped":[...]}
//       stderr: the markdown decision table
//       stdout JSON also carries "tidy" (stale-screenshot actions) and, when a
//       single dispatch skipped the named PR, "error"
//   --mode=keep
//       stdout: one 40-hex gallery SHA per line (every SHA any open PR links,
//       plus every open PR head SHA)
//   --mode=tidy [--pr=N] [--dry-run]
//       removes stale screenshots: cleans stacked PRs, banners galleries shot
//       against an older master. --dry-run lists the edits and writes nothing.
//
// Exit codes: 0 success, 1 runtime or fail-closed failure, 2 usage error,
// 3 single dispatch skipped the named PR.
// Fail closed: any gh/git error, JSON parse failure, or a PR list that may be
// truncated at --limit 500 exits 1 with EMPTY stdout. Stdout is buffered and
// written only after every call succeeded, so a consumer that checks the exit
// code never sees a partial keep-list. The empty-stdout guarantee covers select
// and keep modes. Tidy mode exits 1 after writing its per-PR lines when one PR's
// edit fails (the other PRs' lines still print). Exit 3 in select mode writes
// the selection JSON, including "error".
//
// Run it after oven-sh/setup-bun. Under an empty PATH, `#!/usr/bin/env bun`
// cannot resolve bun and the shell reports exit 127.
import { mkdtempSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { resolve, dirname, join } from 'path';
import { fileURLToPath } from 'url';

const __dir = dirname(fileURLToPath(import.meta.url));
const modulePath = resolve(__dir, '..', 'ibl5', 'tests', 'e2e', 'vr-refresh.ts');
const {
  parseRefreshArgs,
  computeKeepList,
  selectRefreshTargets,
  renderSelectionTable,
  linkedGalleryDir,
  classifyTidy,
  masterAdvancedInVrPaths,
  parseBaseSha,
  refreshGalleryDir,
  renderTidyTable,
  singleDispatchError,
  VISUAL_REVIEW_MARKER,
} = await import(modulePath);

type OpenPr = import('../ibl5/tests/e2e/vr-refresh').OpenPr;
type TidyPlan = import('../ibl5/tests/e2e/vr-refresh').TidyPlan;
type GhComment = { id: number; body: string };

const PR_LIST_LIMIT = 500;

const USAGE =
  'Usage: bin/vr-refresh-targets --mode=select --pages-dir=PATH [--pr=N | --all] [--stale-days=N] [--max-prs=N]\n' +
  '   or: bin/vr-refresh-targets --mode=keep\n' +
  '   or: bin/vr-refresh-targets --mode=tidy [--pr=N] [--dry-run]\n' +
  'Flags take the --flag=VALUE form only.';

function run(cmd: string[], cwd?: string): string {
  const proc = Bun.spawnSync(cmd, { cwd, stdout: 'pipe', stderr: 'pipe' });
  if (proc.exitCode !== 0) {
    throw new Error(`${cmd.join(' ')} exited ${proc.exitCode}: ${proc.stderr.toString().trim()}`);
  }
  return proc.stdout.toString();
}

interface RawPr {
  number: number;
  headRefOid: string;
  baseRefName: string;
  isCrossRepository: boolean;
  isDraft: boolean;
  labels: { name: string }[];
  body: string | null;
}

function listOpenPrs(): RawPr[] {
  const out = run([
    'gh', 'pr', 'list', '--state', 'open', '--limit', String(PR_LIST_LIMIT),
    '--json', 'number,headRefOid,baseRefName,isCrossRepository,isDraft,labels,body',
  ]);
  const raw = JSON.parse(out) as RawPr[];
  if (!Array.isArray(raw)) throw new Error('gh pr list did not return an array');
  if (raw.length >= PR_LIST_LIMIT) {
    throw new Error(`open PR list may be truncated at --limit ${PR_LIST_LIMIT}`);
  }
  return raw;
}

function fetchComments(prNumber: number): GhComment[] {
  const out = run(['gh', 'api', '--paginate', '--slurp', `repos/{owner}/{repo}/issues/${prNumber}/comments`]);
  const pages = JSON.parse(out) as { id: number; body: string | null }[][];
  return pages.flat().map((c) => ({ id: c.id, body: c.body ?? '' }));
}

function gatherPrs(raws: RawPr[], only: number | null): OpenPr[] {
  return raws
    .filter((r) => only === null || r.number === only)
    .map((r) => toOpenPr(r, r.isCrossRepository ? [] : fetchComments(r.number).map((c) => c.body)));
}

function fetchBody(prNumber: number): string {
  const out = run(['gh', 'api', `repos/{owner}/{repo}/pulls/${prNumber}`, '--jq', '.body // ""']);
  return out.replace(/\n$/, '');
}

function fetchMasterSha(): string {
  const sha = run(['gh', 'api', 'repos/{owner}/{repo}/commits/master', '--jq', '.sha']).trim().toLowerCase();
  if (!/^[0-9a-f]{40}$/.test(sha)) throw new Error(`master SHA lookup returned '${sha}'`);
  return sha;
}

// For each distinct base-sha marker on a master-based gallery comment: did master change a
// VR-relevant path since? A failed compare (unknown or garbage-collected SHA) counts as yes.
function fetchAdvanced(prs: OpenPr[], masterSha: string): Record<string, boolean> {
  const out: Record<string, boolean> = {};
  for (const pr of prs) {
    if (pr.isCrossRepository || pr.baseRefName !== 'master') continue;
    const visual = pr.comments.filter((c) => c.includes(VISUAL_REVIEW_MARKER));
    const sha = parseBaseSha(visual[visual.length - 1] ?? '');
    if (sha === null || sha === masterSha || sha in out) continue;
    try {
      const cmp = JSON.parse(
        run(['gh', 'api', `repos/{owner}/{repo}/compare/${sha}...${masterSha}`, '--jq', '{n: (.files | length), f: [.files[].filename]}'])
      ) as { n: number; f: string[] };
      out[sha] = masterAdvancedInVrPaths(cmp.f, cmp.n);
    } catch {
      out[sha] = true;
    }
  }
  return out;
}

function applyTidyEdit(prNumber: number, e: { op: string; id?: number; body?: string }, dir: string): void {
  if (e.op === 'delete-comment') {
    run(['gh', 'api', '-X', 'DELETE', `repos/{owner}/{repo}/issues/comments/${e.id}`]);
    return;
  }
  const file = join(dir, `${prNumber}-${e.op}-${e.id ?? 'body'}.md`);
  writeFileSync(file, e.body ?? '');
  const path = e.op === 'patch-comment' ? `issues/comments/${e.id}` : `pulls/${prNumber}`;
  run(['gh', 'api', '-X', 'PATCH', `repos/{owner}/{repo}/${path}`, '-F', `body=@${file}`]);
}

function fetchBehindBy(headRefOid: string): number | null {
  try {
    const n = parseInt(run(['gh', 'api', `repos/{owner}/{repo}/compare/master...${headRefOid}`, '--jq', '.behind_by']).trim(), 10);
    return Number.isInteger(n) ? n : null;
  } catch {
    return null;
  }
}

function toOpenPr(raw: RawPr, comments: string[]): OpenPr {
  return {
    number: raw.number,
    headRefOid: raw.headRefOid,
    baseRefName: raw.baseRefName,
    isCrossRepository: raw.isCrossRepository,
    isDraft: raw.isDraft,
    labels: raw.labels.map((l) => l.name),
    body: raw.body ?? '',
    comments,
    behindBy: null,
  };
}

const opts = parseRefreshArgs(process.argv.slice(2));
if ('error' in opts) {
  process.stderr.write(`vr-refresh-targets: ${opts.error}\n${USAGE}\n`);
  process.exit(2);
}
if (opts.mode === 'help') {
  process.stdout.write(`${USAGE}\n`);
  process.exit(0);
}

let stdoutBuf = '';
let stderrBuf = '';
let exitCode = 0;
try {
  const raws = listOpenPrs();

  if (opts.mode === 'keep') {
    const prs = raws.map((r) => toOpenPr(r, fetchComments(r.number).map((c) => c.body)));
    stdoutBuf = computeKeepList(prs).map((s: string) => `${s}\n`).join('');
  } else if (opts.mode === 'tidy') {
    const { planTidyEdits } = await import(resolve(__dir, '..', 'ibl5', 'tests', 'e2e', 'vr-review-comment.ts'));
    const prs = gatherPrs(raws, opts.pr);
    if (opts.pr !== null && prs.length === 0) throw new Error(`PR #${opts.pr} is not open`);
    const masterSha = fetchMasterSha();
    const plan: TidyPlan = classifyTidy(prs, masterSha, fetchAdvanced(prs, masterSha));
    const dir = mkdtempSync(join(tmpdir(), 'vr-tidy-'));
    let failures = 0;
    for (const action of plan.actions) {
      try {
        const edits = planTidyEdits(action, fetchComments(action.pr), fetchBody(action.pr));
        stdoutBuf += `${opts.dryRun ? 'would ' : ''}${action.kind} PR #${action.pr}: ${edits.map((e: { op: string }) => e.op).join(', ') || 'no edits'}\n`;
        if (opts.dryRun) continue;
        for (const e of edits) applyTidyEdit(action.pr, e, dir);
      } catch (err) {
        failures++;
        stderrBuf += `tidy PR #${action.pr} failed: ${err instanceof Error ? err.message : String(err)}\n`;
      }
    }
    for (const n of plan.noops) stdoutBuf += `${n.kind} PR #${n.pr}: already applied\n`;
    if (failures > 0) exitCode = 1;
  } else {
    const prs = gatherPrs(raws, null);
    for (const pr of prs) {
      const eligible =
        pr.baseRefName === 'master' &&
        !pr.isCrossRepository &&
        !pr.labels.includes('update-baselines') &&
        refreshGalleryDir(pr) !== null;
      if (eligible) pr.behindBy = fetchBehindBy(pr.headRefOid);
    }

    const ages: Record<string, number | null> = {};
    for (const pr of prs) {
      // dir is `<sha>` or `pr/<N>/visual-review`, relative to the gh-pages root.
      const dir = linkedGalleryDir(pr);
      if (dir === null || dir in ages) continue;
      const ct = run(['git', '-C', opts.pagesDir, 'log', '-1', '--format=%ct', '--', dir]).trim();
      ages[dir] = ct === '' ? null : parseInt(ct, 10);
    }

    const nowSec = Math.floor(Date.now() / 1000);
    const sel = selectRefreshTargets(prs, ages, nowSec, opts.select, opts.maxPrs);
    const masterSha = fetchMasterSha();
    const tidy: TidyPlan = classifyTidy(prs, masterSha, fetchAdvanced(prs, masterSha));
    const dispatchError: string | null = singleDispatchError(opts.select, sel, tidy);
    if (dispatchError !== null) exitCode = 3;
    stdoutBuf = `${JSON.stringify({
      count: sel.targets.length,
      matrix: sel.targets,
      skipped: sel.skipped,
      tidy: tidy.actions,
      ...(dispatchError === null ? {} : { error: dispatchError }),
    })}\n`;
    stderrBuf = `${renderSelectionTable(sel)}\n\n${renderTidyTable(tidy)}\n`;
  }
} catch (e) {
  process.stderr.write(`vr-refresh-targets: ${e instanceof Error ? e.message : String(e)}\n`);
  process.exit(1);
}

if (stderrBuf !== '') process.stderr.write(stderrBuf);
process.stdout.write(stdoutBuf);
if (exitCode !== 0) process.exit(exitCode);
