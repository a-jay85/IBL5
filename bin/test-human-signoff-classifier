# ---- gallery trust: ui_fetch_gallery_gh against a fake gh ----
# The gallery counts only when the run API shows this PR's own E2E Tests run
# on the exact head SHA. The fake gh serves the run list, the run's artifacts
# and the artifact zip from MOCK_* values. Each case drives the full
# ui_workflow_verdict path with a non-UI renderable change, so a rejected
# gallery shows as vr-missing (hold) and an accepted clean one as not-ui.
UI_HEAD=2222222222222222222222222222222222222222
UI_OTHER=3333333333333333333333333333333333333333
UI_SRC=4444444444444444444444444444444444444444
mkdir -p "$UI_TMP/fakebin" "$UI_TMP/zip-clean" "$UI_TMP/zip-dirty"
printf '%s\n' '{"renderedCells":4,"changedCells":[],"newCells":[]}' > "$UI_TMP/zip-clean/vr-gallery.json"
printf '%s\n' '{"renderedCells":4,"changedCells":[{"title":"x"}],"newCells":[]}' > "$UI_TMP/zip-dirty/vr-gallery.json"
(cd "$UI_TMP/zip-clean" && zip -q ../clean.zip vr-gallery.json)
(cd "$UI_TMP/zip-dirty" && zip -q ../dirty.zip vr-gallery.json)
cat > "$UI_TMP/fakebin/gh" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
url="" filter="."
while [ $# -gt 0 ]; do
    case "$1" in
        api) ;;
        --jq) filter="$2"; shift ;;
        *) url="$1" ;;
    esac
    shift
done
case "$url" in
    */actions/workflows/e2e-tests.yml/runs\?*) json="$MOCK_RUNS" ;;
    */actions/runs/*/artifacts*) json="$MOCK_ARTS" ;;
    */actions/artifacts/*/zip) cat "$MOCK_ZIP"; exit 0 ;;
    */actions/runs/*/jobs*) [ -n "${MOCK_JOBS:-}" ] || exit 1; printf '%s\n' "$MOCK_JOBS"; exit 0 ;;
    */compare/*) [ -n "${MOCK_COMPARE:-}" ] || exit 1; printf '%s\n' "$MOCK_COMPARE"; exit 0 ;;
    *) exit 1 ;;
esac
jq -r "$filter" <<< "$json"
SH
chmod +x "$UI_TMP/fakebin/gh"
printf '%s\n' ibl5/classes/Team/TeamService.php > "$UI_TMP/backend-paths.txt"

# ui_run <id> <head_sha> <path> <event> <pr_numbers_json> <head_branch> <head_repo> <status> [conclusion]
ui_run() {
    printf '{"id":%s,"head_sha":"%s","path":"%s","event":"%s","pull_requests":%s,"head_branch":"%s","head_repository":{"full_name":"%s"},"status":"%s","conclusion":"%s","created_at":"2026-11-01T00:00:00Z"}' \
        "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$8" "${9:-success}"
}
# ui_art <id> <run_id> <run_head_sha>
ui_art() {
    printf '{"artifacts":[{"id":%s,"name":"vr-gallery-json-%s","expired":false,"created_at":"2026-11-01T00:00:00Z","workflow_run":{"id":%s,"head_sha":"%s"}}]}' \
        "$1" "$3" "$2" "$3"
}
UI_E2E=.github/workflows/e2e-tests.yml
UI_RUN_OK=$(ui_run 5 "$UI_HEAD" "$UI_E2E" pull_request '[{"number":42}]' feat o/r completed)
UI_ART_OK=$(ui_art 77 5 "$UI_HEAD")

# ui_trust_case <name> <want_verdict> <runs_json> <arts_json> [zip] [env...]
ui_trust_case() {
    local name="$1" want="$2" runs="$3" arts="$4" zipf="${5:-$UI_TMP/clean.zip}" got
    shift 5 2>/dev/null || shift $#
    # shellcheck disable=SC2016  # $1 and $2 expand inside the child bash
    got=$(env PATH="$UI_TMP/fakebin:$PATH" GH_REPO=o/r HEAD_SHA="$UI_HEAD" PR=42 \
        HEAD_REF=feat HEAD_REPO=o/r UI_VR_ATTEMPTS=1 UI_VR_SLEEP=0 \
        MOCK_RUNS="$runs" MOCK_ARTS="$arts" MOCK_ZIP="$zipf" "$@" \
        bash -c 'set -euo pipefail; source "$1"; ui_workflow_verdict "$2" someone ui_fetch_gallery_gh || true' \
        _ "$UI_LIB" "$UI_TMP/backend-paths.txt" 2>/dev/null)
    same "$name" "$got" "$want"
}
ui_trust_case "gallery trust: this PR's own E2E run on the head SHA is accepted" not-ui \
    "{\"workflow_runs\":[$UI_RUN_OK]}" "$UI_ART_OK"
ui_trust_case "gallery trust: an accepted gallery with a changed cell holds" ui-vr \
    "{\"workflow_runs\":[$UI_RUN_OK]}" "$UI_ART_OK" "$UI_TMP/dirty.zip"
ui_trust_case "gallery trust: a run of another workflow is rejected (holds)" vr-missing \
    "{\"workflow_runs\":[$(ui_run 5 "$UI_HEAD" .github/workflows/other.yml pull_request '[{"number":42}]' feat o/r completed)]}" "$UI_ART_OK"
ui_trust_case "gallery trust: a run on another SHA is rejected (holds)" vr-missing \
    "{\"workflow_runs\":[$(ui_run 5 "$UI_OTHER" "$UI_E2E" pull_request '[{"number":42}]' feat o/r completed)]}" "$(ui_art 77 5 "$UI_OTHER")"
ui_trust_case "gallery trust: a run for another PR is rejected (holds)" vr-missing \
    "{\"workflow_runs\":[$(ui_run 5 "$UI_HEAD" "$UI_E2E" pull_request '[{"number":99}]' other o/r completed)]}" "$UI_ART_OK"
ui_trust_case "gallery trust: a non-pull_request run is rejected (holds)" vr-missing \
    "{\"workflow_runs\":[$(ui_run 5 "$UI_HEAD" "$UI_E2E" workflow_dispatch '[{"number":42}]' feat o/r completed)]}" "$UI_ART_OK"
ui_trust_case "gallery trust: an artifact stamped with another SHA is rejected (holds)" vr-missing \
    "{\"workflow_runs\":[$UI_RUN_OK]}" "$(ui_art 77 5 "$UI_OTHER")"
ui_trust_case "gallery trust: an artifact from another run is rejected (holds)" vr-missing \
    "{\"workflow_runs\":[$UI_RUN_OK]}" "$(ui_art 77 6 "$UI_HEAD")"
ui_trust_case "gallery trust: a fork PR matches on head branch and repo" not-ui \
    "{\"workflow_runs\":[$(ui_run 5 "$UI_HEAD" "$UI_E2E" pull_request '[]' feat fork/r completed)]}" "$UI_ART_OK" \
    "$UI_TMP/clean.zip" HEAD_REPO=fork/r
ui_trust_case "gallery trust: a same-branch run from another repo is rejected (holds)" vr-missing \
    "{\"workflow_runs\":[$(ui_run 5 "$UI_HEAD" "$UI_E2E" pull_request '[]' feat evil/r completed)]}" "$UI_ART_OK" \
    "$UI_TMP/clean.zip" HEAD_REPO=fork/r
ui_trust_case "gallery trust: a missing PR number holds" vr-missing \
    "{\"workflow_runs\":[$UI_RUN_OK]}" "$UI_ART_OK" "$UI_TMP/clean.zip" PR=
ui_trust_case "gallery trust: no E2E run holds" vr-missing '{"workflow_runs":[]}' "$UI_ART_OK"

# ---- memo-hit gallery fallback (_ui_memo_fallback) ----
# A memo hit uploads no gallery for the new SHA. The fallback reuses the gallery
# of an earlier same-PR run when nothing UI-relevant changed since. The fake gh
# also serves MOCK_JOBS (run jobs) and MOCK_COMPARE (compare API).
cp "$REPO_ROOT/.github/ci-memo/e2e.paths" "$UI_TMP/e2e.paths"
RENDERABLE="$UI_TMP/backend-paths.txt"
# ui_jobs <memo_concl> <vr_concl> <gate_concl>
ui_jobs() {
    printf '{"jobs":[{"name":"E2E Tests (1/2)","conclusion":"skipped"},{"name":"E2E Memo Check","conclusion":"%s"},{"name":"Visual Regression","conclusion":"%s"},{"name":"E2E Tests","conclusion":"%s"}]}' \
        "$1" "$2" "$3"
}
# ui_compare <status> [file | old=>new | @300]...
ui_compare() {
    local status="$1" f out="" sep="" n
    shift
    for f in "$@"; do
        case "$f" in
            @300) n=1; while [ "$n" -le 300 ]; do out="$out$sep{\"filename\":\"docs/f$n.txt\"}"; sep=","; n=$((n + 1)); done ;;
            *'=>'*) out="$out$sep{\"filename\":\"${f#*=>}\",\"previous_filename\":\"${f%%=>*}\"}"; sep="," ;;
            *) out="$out$sep{\"filename\":\"$f\"}"; sep="," ;;
        esac
    done
    printf '{"status":"%s","files":[%s]}' "$status" "$out"
}
# ui_memo_case <name> <want> <paths_file> <runs> <arts> <jobs> <compare> [zip] [env...]
# env args: NAME=value sets, -NAME unsets, both applied after the defaults.
ui_memo_case() {
    local name="$1" want="$2" paths="$3" runs="$4" arts="$5" jobs="$6" cmp="$7" zipf="${8:-$UI_TMP/clean.zip}" got a unset_list=""
    local -a envargs=()
    shift 8 2>/dev/null || shift $#
    for a in "$@"; do
        case "$a" in
            -*) unset_list="$unset_list ${a#-}" ;;
            *) envargs+=("$a") ;;
        esac
    done
    # shellcheck disable=SC2016  # $1, $2 and $UI_UNSET expand inside the child bash
    got=$(env PATH="$UI_TMP/fakebin:$PATH" GH_REPO=o/r HEAD_SHA="$UI_HEAD" PR=42 \
        HEAD_REF=feat HEAD_REPO=o/r UI_VR_ATTEMPTS=1 UI_VR_SLEEP=0 \
        UI_MEMO_PATHS_FILE="$UI_TMP/e2e.paths" UI_UNSET="$unset_list" \
        MOCK_RUNS="$runs" MOCK_ARTS="$arts" MOCK_ZIP="$zipf" MOCK_JOBS="$jobs" MOCK_COMPARE="$cmp" \
        ${envargs[@]+"${envargs[@]}"} \
        bash -c 'set -euo pipefail; for v in $UI_UNSET; do unset "$v"; done; source "$1"; ui_workflow_verdict "$2" someone ui_fetch_gallery_gh || true' \
        _ "$UI_LIB" "$paths" 2>/dev/null)
    same "$name" "$got" "$want"
}
UI_RUN_HEAD=$(ui_run 900 "$UI_HEAD" "$UI_E2E" pull_request '[{"number":42}]' feat o/r completed)
UI_RUN_SRC=$(ui_run 800 "$UI_SRC" "$UI_E2E" pull_request '[{"number":42}]' feat o/r completed success)
ui_memo_case "memo-same-pr-clean: same-PR memo hit reuses the source gallery" not-ui \
    "$RENDERABLE" "{\"workflow_runs\":[$UI_RUN_HEAD,$UI_RUN_SRC]}" "$(ui_art 81 800 "$UI_SRC")" \
    "$(ui_jobs success skipped success)" "$(ui_compare ahead README.md)"

# ui_fetch_rc <runs_json> <arts_json>: prints the fetch rc (3 = finished, no artifact).
ui_fetch_rc() {
    local rc=0
    # shellcheck disable=SC2016  # $1 expands inside the child bash
    env PATH="$UI_TMP/fakebin:$PATH" GH_REPO=o/r HEAD_SHA="$UI_HEAD" PR=42 HEAD_REF=feat HEAD_REPO=o/r \
        MOCK_RUNS="$1" MOCK_ARTS="$2" MOCK_ZIP="$UI_TMP/clean.zip" \
        bash -c 'set -euo pipefail; source "$1"; ui_fetch_gallery_gh "$2"' _ "$UI_LIB" "$UI_TMP/out.json" \
        > /dev/null 2>&1 || rc=$?
    printf '%s' "$rc"
}
expect "ui_fetch_gallery_gh: a completed trusted run with no artifact stops the wait" 3 \
    "$(ui_fetch_rc "{\"workflow_runs\":[$UI_RUN_OK]}" '{"artifacts":[]}')"
expect "ui_fetch_gallery_gh: an in-progress trusted run with no artifact keeps waiting" 1 \
    "$(ui_fetch_rc "{\"workflow_runs\":[$(ui_run 5 "$UI_HEAD" "$UI_E2E" pull_request '[{"number":42}]' feat o/r in_progress)]}" '{"artifacts":[]}')"
expect "ui_fetch_gallery_gh: an untrusted completed run never stops the wait" 1 \
    "$(ui_fetch_rc "{\"workflow_runs\":[$(ui_run 5 "$UI_HEAD" "$UI_E2E" pull_request '[{"number":99}]' other o/r completed)]}" '{"artifacts":[]}')"

rm -rf "$UI_TMP"

# ---- human-signoff.yml wiring for the UI hold (static) ----
HS_YML="$REPO_ROOT/.github/workflows/human-signoff.yml"
E2E_YML="$REPO_ROOT/.github/workflows/e2e-tests.yml"

# workflow_title_free: no title expression, and the gallery wait can read artifacts.
if grep -F 'pull_request.title' "$HS_YML" > /dev/null; then
    h_fail "workflow_title_free: human-signoff.yml holds no pull_request.title token"
else
    h_pass "workflow_title_free: human-signoff.yml holds no pull_request.title token"
fi
if grep -qE '^  actions: read' "$HS_YML"; then
    h_pass "workflow_title_free: human-signoff.yml grants actions: read"
else
    h_fail "workflow_title_free: human-signoff.yml grants actions: read"
fi

# workflow_label_sync_uses_github_token: a label written with github.token
# starts no workflow run, so the label the job adds cannot retrigger the gate.
LABEL_JOB=$(wf_job_block "$HS_YML" needs-a-human-label)
# shellcheck disable=SC2016 # literal workflow expression text, not shell expansion
if grep -qxF '          GH_TOKEN: ${{ github.token }}' <<< "$LABEL_JOB"; then
    h_pass "workflow_label_sync_uses_github_token"
else
    h_fail "workflow_label_sync_uses_github_token" "needs-a-human-label GH_TOKEN is not github.token"
fi
if grep -q 'secrets\.' <<< "$LABEL_JOB"; then
    h_fail "workflow_label_sync_uses_github_token: label job reads no secret"
else
    h_pass "workflow_label_sync_uses_github_token: label job reads no secret"
fi

# workflow_e2e_uploads_gallery_json: the upload name starts with the prefix the
# classifier looks up.
UI_PREFIX=$(bash -c 'source "$1"; printf %s "$UI_GALLERY_ARTIFACT_PREFIX"' _ "$UI_LIB")
if [ -n "$UI_PREFIX" ] && grep -qF "name: ${UI_PREFIX}" "$E2E_YML"; then
    h_pass "workflow_e2e_uploads_gallery_json"
else
    h_fail "workflow_e2e_uploads_gallery_json" "e2e-tests.yml has no artifact named ${UI_PREFIX}..."
fi

# ---- live PR re-read after the gallery wait (stale-event-payload) ----
# The sync run can wait UI_VR_ATTEMPTS x UI_VR_SLEEP seconds. Its payload
# labels and head SHA are frozen at trigger time, so the gate re-reads both.
LV_TMP=$(mktemp -d)
LV_HEAD=$(printf 'a%.0s' {1..40})
LV_NEW=$(printf 'b%.0s' {1..40})
# live_run <stub_json|FAIL> — runs ui_live_pr_state "$LV_HEAD" under strict mode.
live_run() {
    printf '%s' "$1" > "$LV_TMP/pr.json"
    # shellcheck disable=SC2016  # $1.. expand inside the child bash
    LV_OUT=$(bash -c 'set -euo pipefail; source "$1"; stub="$3"
        lv_fetch() { [ "$(cat "$stub")" != FAIL ] && cat "$stub"; }
        rc=0; ui_live_pr_state "$2" lv_fetch || rc=$?; echo "RC=$rc"' \
        _ "$UI_LIB" "$LV_HEAD" "$LV_TMP/pr.json" 2>&1)
}
live_run "{\"head\":{\"sha\":\"$LV_HEAD\"},\"labels\":[{\"name\":\"human-approved\"},{\"name\":\"x\"}]}"
same "live re-read: same head prints the live labels" "$LV_OUT" "$(printf 'human-approved,x\nRC=0')"
live_run "{\"head\":{\"sha\":\"$LV_HEAD\"},\"labels\":[]}"
same "live re-read: a removed label reads as no labels" "$LV_OUT" "$(printf '\nRC=0')"
live_run "{\"head\":{\"sha\":\"$LV_NEW\"},\"labels\":[{\"name\":\"human-approved\"}]}"
same "live re-read: a moved head is rc 3 and prints no labels" "$LV_OUT" "RC=3"
live_run FAIL
same "live re-read: a failed fetch is rc 1" "$LV_OUT" "RC=1"
live_run "{\"head\":{\"sha\":\"$LV_HEAD\"}}"
same "live re-read: missing labels is rc 1" "$LV_OUT" "RC=1"
live_run '{"head":{"sha":"short"},"labels":[]}'
same "live re-read: a malformed head SHA is rc 1" "$LV_OUT" "RC=1"
live_run 'not json'
same "live re-read: unparseable JSON is rc 1" "$LV_OUT" "RC=1"

# hs_live_reread_ok <workflow-file> — 0 when the eval step re-reads the live PR
# after ui_workflow_verdict and before the first hs_pr_cleared, takes the live
# labels, posts superseded on a moved head, and the label job skips superseded.
hs_live_reread_ok() {
    local v l a s c
    v=$(command grep -n -F -m1 'UI_VERDICT=$(ui_workflow_verdict' "$1" | cut -d: -f1)
    l=$(command grep -n -F -m1 'LIVE_LABELS=$(ui_live_pr_state "$HEAD_SHA" ui_fetch_pr_gh) || LIVE_RC=$?' "$1" | cut -d: -f1)
    a=$(command grep -n -F -m1 '0) LABELS="$LIVE_LABELS" ;;' "$1" | cut -d: -f1)
    s=$(command grep -n -F -m1 'echo "verdict=superseded" >> "$GITHUB_OUTPUT"' "$1" | cut -d: -f1)
    c=$(command grep -n -F -m1 'hs_pr_cleared "$UI_VERDICT" "$LABELS"' "$1" | cut -d: -f1)
    [ -n "$v" ] && [ -n "$l" ] && [ -n "$a" ] && [ -n "$s" ] && [ -n "$c" ] || return 1
    [ "$v" -lt "$l" ] && [ "$l" -lt "$a" ] && [ "$a" -lt "$c" ] && [ "$s" -lt "$c" ] || return 1
    [ "$(sed -n "$((s + 1))p" "$1" | tr -d ' ')" = "exit0;;" ] || return 1
    wf_job_block "$1" needs-a-human-label | command grep -qF 'if [ "$VERDICT" = "superseded" ]; then' || return 1
}
if hs_live_reread_ok "$HS_YML"; then
    h_pass "live re-read: human-signoff.yml re-reads the PR between the wait and the verdict"
else
    h_fail "live re-read: human-signoff.yml re-reads the PR between the wait and the verdict" "wiring not found or out of order"
fi
LV_M1="$LV_TMP/m-no-reread.yml"
sed '/LIVE_LABELS=$(ui_live_pr_state/d' "$HS_YML" > "$LV_M1"
if cmp -s "$HS_YML" "$LV_M1"; then
    h_fail "mutant identical: no-reread"
elif hs_live_reread_ok "$LV_M1"; then
    h_fail "mutant no-reread: guard catches a deleted re-read" "guard still passed"
else
    h_pass "mutant no-reread: guard catches a deleted re-read"
fi
LV_M2="$LV_TMP/m-stale-labels.yml"
sed 's/0) LABELS="\$LIVE_LABELS" ;;/0) : ;;/' "$HS_YML" > "$LV_M2"
if cmp -s "$HS_YML" "$LV_M2"; then
    h_fail "mutant identical: stale-labels"
elif hs_live_reread_ok "$LV_M2"; then
    h_fail "mutant stale-labels: guard catches the payload labels kept" "guard still passed"
else
    h_pass "mutant stale-labels: guard catches the payload labels kept"
fi
LV_M3="$LV_TMP/m-superseded-falls-through.yml"
awk 'p && /exit 0 ;;/ { sub(/exit 0 ;;/, ";;") } { p = index($0, "verdict=superseded") > 0; print }' "$HS_YML" > "$LV_M3"
if cmp -s "$HS_YML" "$LV_M3"; then
    h_fail "mutant identical: superseded-falls-through"
elif hs_live_reread_ok "$LV_M3"; then
    h_fail "mutant superseded-falls-through: guard catches a moved head reaching the verdict" "guard still passed"
else
    h_pass "mutant superseded-falls-through: guard catches a moved head reaching the verdict"
fi
LV_M4="$LV_TMP/m-label-job-writes.yml"
sed '/if \[ "\$VERDICT" = "superseded" \]; then/d' "$HS_YML" > "$LV_M4"
if cmp -s "$HS_YML" "$LV_M4"; then
    h_fail "mutant identical: label-job-writes"
elif hs_live_reread_ok "$LV_M4"; then
    h_fail "mutant label-job-writes: guard catches a label write on superseded" "guard still passed"
else
    h_pass "mutant label-job-writes: guard catches a label write on superseded"
fi
rm -rf "$LV_TMP"

h_done
