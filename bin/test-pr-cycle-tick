# Threshold pin: the stale-label age stays at least twice the per-phase post-plan cap.
reset; begin_case
MAXPP="$(grep -oE '^MAX_PP_SECS=[0-9]+' "$SCRIPT_DIR/automouse/run" | cut -d= -f2)"
[[ "$MAXPP" =~ ^[1-9][0-9]*$ ]] || fail "threshold-pin: MAX_PP_SECS not found in bin/automouse/run"
STALE_MIN="$(. "$REPO/bin/lib/pr-cycle-watch.sh"; printf '%s' "$PCW_STALE_LABEL_MIN")"
[[ "$STALE_MIN" =~ ^[1-9][0-9]*$ ]] || fail "threshold-pin: PCW_STALE_LABEL_MIN not found"
if [[ "$MAXPP" =~ ^[1-9][0-9]*$ && "$STALE_MIN" =~ ^[1-9][0-9]*$ ]]; then
    (( STALE_MIN * 60 >= 2 * MAXPP )) || fail "threshold-pin: PCW_STALE_LABEL_MIN=$STALE_MIN is under 2x MAX_PP_SECS=$MAXPP"
fi
end_case sweep-threshold-pin

# Mutated copy: the always-dead override flips case (b), so (b) is driven by the real predicate.
sweep_fixture; begin_case
[[ "$(grep -c '# stale-label: argv probe' "$TICK")" == "1" ]] || fail "mutated-copy: argv-probe anchor is not unique"
awk '{print} /# stale-label: argv probe/ {print "pcw_postplan_argv_live() { return 1; }"}' "$TICK" \
    > "$REPO/bin/pr-cycle-tick-mut"
chmod +x "$REPO/bin/pr-cycle-tick-mut"
set_ps "5555 /bin/bash -lc cd $WT && caffeinate x"
run_tick
no_label_call || fail "mutated-copy: unmutated tick removed the label"
TICK_OVERRIDE="$REPO/bin/pr-cycle-tick-mut"
run_tick
one_delete_41 || fail "mutated-copy: an always-dead probe did not flip (b) to removed: '$(label_log)'"
TICK_OVERRIDE=""
end_case sweep-mutated-copy

reset; begin_case
# Run from the linked worktree: Program must still name the MAIN checkout.
MAIN_REAL="$(cd "$REPO" && pwd -P)"
PLIST="$(env HOME="$HOME_DIR" PATH="$SHIMS:$PATH" "$WT/bin/pr-cycle-tick-cron-setup" --print-schedule 2>/dev/null)"
grep -qF '<integer>1800</integer>' <<< "$PLIST" || fail "print-schedule-shape: no 1800 interval"
grep -qF "<string>$MAIN_REAL/bin/pr-cycle-tick</string>" <<< "$PLIST" \
    || fail "print-schedule-shape: Program is not the main checkout's tick: $PLIST"
for want in /opt/homebrew/bin /usr/bin /bin "$HOME_DIR/.local/bin"; do
    grep -qF -- "$want" <<< "$PLIST" || fail "print-schedule-shape: PATH lacks $want"
done
grep -qF '$' <<< "$PLIST" && fail "print-schedule-shape: a literal \$ leaked into the plist"
grep -qF '<string></string>' <<< "$PLIST" && fail "print-schedule-shape: empty <string>"
if command -v plutil >/dev/null 2>&1; then
    plutil -lint - <<< "$PLIST" >/dev/null 2>&1 || fail "print-schedule-shape: plutil -lint failed"
else
    echo "SKIP: print-schedule-shape plutil sub-check (no plutil on this platform)"
fi
end_case print-schedule-shape

