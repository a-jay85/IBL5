bpt_run
bpt_log_has "$STUB" gh.log      "issue comment 4242" "r54: findings mirrored onto the tracking issue"
bpt_log_has "$STUB" gh.args.log "observed_before=38" "r54: the comment body carries the evidence numbers"
bpt_reset
