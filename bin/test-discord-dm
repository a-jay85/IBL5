#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-discord-dm — harness for bin/discord-dm Phase-11 chunking contract.
#
# Verification rows 27-29 from the Phase 11 matrix:
#   27. A 5619-char fixture sent with --chunk arrives complete and in order.
#   28. Without --chunk, the same fixture produces exactly one truncated message.
#   29. A partial multi-chunk delivery exits non-zero; spool holds the full original.
# Plus an edge case: an under-cap message with --chunk produces one unmodified message.
#
# Row 28's verification that bin/plan-now and bin/watch-automouse-plan callers are
# unaffected is done by running bin/test-plan-now separately (not inlined here, so
# a test-plan-now regression does not misreport as a test-discord-dm failure).
#
# Run: bin/test-discord-dm  (exit 0 = all pass, 1 = a case failed)

set -u

ROOT=$(cd "$(dirname "$0")/.." && pwd)
DM="$ROOT/bin/discord-dm"

FAILS=0
ok()   { printf '  ok   %s\n' "$1"; }
fail() { printf '  FAIL %s\n' "$1"; FAILS=$(( FAILS + 1 )); }

# A full template rather than -t <prefix>: GNU mktemp rejects a -t argument
# with too few X's, so the BSD spelling would fail on the Linux CI runner.
TMP=$(mktemp -d "${TMPDIR:-/tmp}/test-discord-dm.XXXXXX")
trap 'rm -rf "$TMP"' EXIT

# Shim osascript so the T29 fallback path does not fire a macOS notification
# banner on every local run. Matches the caffeinate shim in bin/test-plan-now.
SHIM="$TMP/bin"
mkdir -p "$SHIM"
cat > "$SHIM/osascript" <<'SHIM_EOF'
#!/usr/bin/env bash
exit 0
SHIM_EOF
chmod +x "$SHIM/osascript"
export PATH="$SHIM:$PATH"

# Never let a case read the real ~/.iblbot-dev-webhook-url or ~/.iblbot-dm-id.
# HOME points into $TMP for the whole run; the webhook seam defaults to an
# absent file. Cases that want the webhook path opt in per call.
export HOME="$TMP/home"
mkdir -p "$HOME"
export DISCORD_DM_WEBHOOK_FILE="$TMP/no-webhook-url"
case "$HOME" in
    "$TMP"/*) : ;;
    *) echo "test-discord-dm: HOME isolation failed ($HOME)"; exit 1 ;;
esac
OWNER_ID="283183467804491776"
FAKE_WEBHOOK_URL="https://example.invalid/api/webhooks/0/test"
FAKE_WEBHOOK_FILE="$TMP/webhook-url"
printf '%s\n' "$FAKE_WEBHOOK_URL" > "$FAKE_WEBHOOK_FILE"
# curl seam stub: records that it ran. Phase 2 wires DISCORD_DM_CURL_BIN; before
# that it is ignored, so "curl stub never ran" holds trivially pre-impl.
CURL_CAP="$TMP/curl-cap.txt"
CURL_NEVER="$TMP/curl-never"
cat > "$CURL_NEVER" <<'STUB_EOF'
#!/bin/bash
printf 'CURL-RAN\n' >> "$CURL_CAP"
printf '\nHTTP=200\n'
STUB_EOF
chmod +x "$CURL_NEVER"
export CURL_CAP

FAKE_TO="123456789012345678"
CAP="$TMP/cap.txt"
SPOOL="$TMP/spool.log"
FIXTURE="$TMP/big.txt"

# ── Stubs ─────────────────────────────────────────────────────────────────────
# Transport seam: discord-dm invokes "$SSH_BIN" -o ... "$SSH_HOST" "$REMOTE_CMD"
# with the JSON payload on stdin. The stub records the payload to $DM_CAPTURE
# (env var set by the harness) and prints the HTTP status line that discord-dm
# greps for from the combined ssh output.

# ssh-ok: records each incoming JSON payload, always answers HTTP 200.
SSH_OK="$TMP/ssh-ok"
cat > "$SSH_OK" <<'STUB_EOF'
#!/bin/bash
cat >> "$DM_CAPTURE"
printf '\n---MSGEND---\n' >> "$DM_CAPTURE"
printf '\nHTTP=200 curl_rc=0\n'
STUB_EOF
chmod +x "$SSH_OK"

# ssh-fail2: succeeds on chunk 1 (first ---MSGEND--- in the file), returns
# HTTP 400 (permanent failure, forces no retry) from chunk 2 onward.
# Uses the accumulated ---MSGEND--- count as the delivery-attempt counter.
SSH_FAIL2="$TMP/ssh-fail2"
cat > "$SSH_FAIL2" <<'STUB_EOF'
#!/bin/bash
cat >> "$DM_CAPTURE"
printf '\n---MSGEND---\n' >> "$DM_CAPTURE"
n=$(grep -c -- '---MSGEND---' "$DM_CAPTURE")
if [ "$n" -ge 2 ]; then
    printf '\nHTTP=400 curl_rc=0\n'
else
    printf '\nHTTP=200 curl_rc=0\n'
fi
STUB_EOF
chmod +x "$SSH_FAIL2"

# ── Fixture ───────────────────────────────────────────────────────────────────
# 5619-char fixture with realistic multi-line structure, matching the smoke test
# in /tmp/dmtest/run.sh. Generates output until at least 5619 bytes have been
# produced, then truncates. head -c is POSIX since 2017 and works on macOS and
# Linux. The subshell may receive SIGPIPE once head exits; that is expected.
{
    i=0
    n=0
    while [ "$n" -lt 5700 ]; do
        line="step $i: change the thing in the file and then verify the behaviour flips"
        printf '%s\n' "$line"
        n=$(( n + ${#line} + 1 ))
        i=$(( i + 1 ))
    done
} 2>/dev/null | head -c 5619 > "$FIXTURE"

fixture_len=$(wc -c < "$FIXTURE" | tr -d ' ')
if [ "$fixture_len" != "5619" ]; then
    printf 'test-discord-dm: fixture is %s chars, expected 5619\n' "$fixture_len" >&2
    exit 1
fi

# ── Helpers ───────────────────────────────────────────────────────────────────
# read_cap <capfile>: populates global array MSGS and scalar N_MSGS.
# Splits on ---MSGEND--- delimiters, writes each JSON block to a numbered temp
# file, then extracts .content.message via jq.
read_cap() {
    local cap="$1" blkdir
    MSGS=()
    N_MSGS=0
    blkdir=$(mktemp -d "${TMP}/blk.XXXXXX")
    awk -v out="$blkdir" '
    BEGIN { idx=0; buf="" }
    /^---MSGEND---$/ {
        if (buf != "") {
            print buf > (out "/" idx)
            close(out "/" idx)
            idx++
        }
        buf = ""; next
    }
    { buf = (buf == "") ? $0 : buf "\n" $0 }
    END {
        if (buf != "") {
            print buf > (out "/" idx)
        }
    }' "$cap"

    local i=0
    while [ -f "$blkdir/$i" ]; do
        MSGS+=("$(jq -r '.content.message' "$blkdir/$i")")
        i=$(( i + 1 ))
    done
    N_MSGS="$i"
}

# ── T27: --chunk delivers the fixture complete and in order ───────────────────
printf '\n── T27: --chunk complete + in order ──\n'
: > "$CAP"
DM_CAPTURE="$CAP" DISCORD_DM_SSH_BIN="$SSH_OK" DISCORD_DM_SPOOL="$SPOOL" \
    "$DM" --to "$FAKE_TO" --attempts 1 --quiet --chunk - < "$FIXTURE"
t27_exit=$?
if [ "$t27_exit" = 0 ]; then
    ok "T27: exit 0"
else
    fail "T27: exit $t27_exit (expected 0)"
fi

read_cap "$CAP"

if [ "$N_MSGS" -gt 1 ]; then
    ok "T27: multiple chunks sent ($N_MSGS)"
else
    fail "T27: expected multiple chunks, got $N_MSGS"
fi

# No truncation marker in any chunk.
found_trunc=0
i=0
while [ "$i" -lt "$N_MSGS" ]; do
    case "${MSGS[$i]}" in
        *'(truncated)'*) found_trunc=1 ;;
    esac
    i=$(( i + 1 ))
done
if [ "$found_trunc" = 0 ]; then
    ok "T27: no truncation marker in any chunk"
else
    fail "T27: found truncation marker in a chunk"
fi

# Chunk ordering: chunk i (0-indexed, i>0) must start with "(i+1/total): ".
order_ok=1
i=1
while [ "$i" -lt "$N_MSGS" ]; do
    expected="($(( i + 1 ))/$N_MSGS): "
    case "${MSGS[$i]}" in
        "$expected"*) ;;
        *) order_ok=0 ;;
    esac
    i=$(( i + 1 ))
done
if [ "$order_ok" = 1 ]; then
    ok "T27: chunk ordering correct (2/$N_MSGS … $N_MSGS/$N_MSGS)"
else
    fail "T27: chunk ordering wrong"
fi

# No single chunk exceeds Discord's 2000-char cap.
cap_ok=1
i=0
while [ "$i" -lt "$N_MSGS" ]; do
    if [ "${#MSGS[$i]}" -gt 2000 ]; then
        cap_ok=0
    fi
    i=$(( i + 1 ))
done
if [ "$cap_ok" = 1 ]; then
    ok "T27: all chunks <= 2000 chars"
else
    fail "T27: a chunk exceeds 2000 chars"
fi

# Content matches input whitespace-insensitively. Reassemble by stripping the
# (N/M): prefix from chunks 2+. The splitter consumes the whitespace it breaks
# on, so byte-exact equality after reassembly does not hold; whitespace-
# insensitive comparison (strip all whitespace from both sides) is the correct
# criterion. Anchor the strip to line 1 of each chunk so a body line that
# resembles a prefix is not eaten.
reassembled="${MSGS[0]}"
i=1
while [ "$i" -lt "$N_MSGS" ]; do
    stripped=$(printf '%s' "${MSGS[$i]}" | sed '1s/^([0-9][0-9]*\/[0-9][0-9]*): //')
    reassembled="${reassembled}${stripped}"
    i=$(( i + 1 ))
done
orig_compact=$(tr -d '[:space:]' < "$FIXTURE")
reassembled_compact=$(printf '%s' "$reassembled" | tr -d '[:space:]')
if [ "$orig_compact" = "$reassembled_compact" ]; then
    ok "T27: reassembled content matches input (whitespace-insensitive)"
else
    fail "T27: content mismatch after reassembly"
fi

# ── T28: no --chunk still produces exactly one truncated message ──────────────
printf '\n── T28: no --chunk still truncates ──\n'
: > "$CAP"
DM_CAPTURE="$CAP" DISCORD_DM_SSH_BIN="$SSH_OK" DISCORD_DM_SPOOL="$SPOOL" \
    "$DM" --to "$FAKE_TO" --attempts 1 --quiet - < "$FIXTURE"
t28_exit=$?
if [ "$t28_exit" = 0 ]; then
    ok "T28: exit 0"
else
    fail "T28: exit $t28_exit (expected 0)"
fi

read_cap "$CAP"

if [ "$N_MSGS" = 1 ]; then
    ok "T28: exactly one message sent"
else
    fail "T28: expected 1 message, got $N_MSGS"
fi

case "${MSGS[0]}" in
    *'(truncated)'*) ok "T28: truncation marker present" ;;
    *)               fail "T28: missing truncation marker" ;;
esac

# ── T29: partial delivery exits non-zero, spools the full original ────────────
printf '\n── T29: partial delivery → non-zero exit + full spool ──\n'
: > "$CAP"
: > "$SPOOL"
DM_CAPTURE="$CAP" DISCORD_DM_SSH_BIN="$SSH_FAIL2" DISCORD_DM_SPOOL="$SPOOL" \
    "$DM" --to "$FAKE_TO" --attempts 1 --quiet --chunk - < "$FIXTURE"
t29_exit=$?
if [ "$t29_exit" -ne 0 ]; then
    ok "T29: exit non-zero ($t29_exit)"
else
    fail "T29: exit was 0 (expected non-zero)"
fi

# ssh-fail2 delivers chunk 1 (HTTP 200) then hard-fails chunk 2 (HTTP 400,
# permanent). Exactly 2 payloads must be in the capture — one success + one
# refused — pinning the "stop immediately" half of the all-or-nothing contract.
read_cap "$CAP"
if [ "$N_MSGS" = 2 ]; then
    ok "T29: exactly 2 payloads captured (deliver-then-stop)"
else
    fail "T29: expected 2 payloads in cap (deliver-then-stop), got $N_MSGS"
fi

# Spool holds the full original message (whitespace-insensitive to tolerate
# the timestamp header line discord-dm prepends to the spool entry).
orig_compact=$(tr -d '[:space:]' < "$FIXTURE")
spool_compact=$(tr -d '[:space:]' < "$SPOOL")
case "$spool_compact" in
    *"$orig_compact"*) ok "T29: spool holds full original message" ;;
    *)                 fail "T29: spool does not contain full original" ;;
esac

# Spool must not contain a chunk prefix — the spool holds FULL_MSG, which is
# the pre-chunked original, never a partially assembled fragment.
if grep -qF '(2/' "$SPOOL"; then
    fail "T29: spool contains (2/ chunk prefix"
else
    ok "T29: spool has no chunk prefix"
fi

# ── Edge: under-cap message with --chunk → one message, byte-identical ────────
printf '\n── Edge: under-cap + --chunk → single message, no prefix ──\n'
: > "$CAP"
# printf has no trailing newline. jq captures the message exactly as given;
# $() strips any trailing newline from jq's output — both sides of the
# byte-identity comparison lose no content.
printf 'short and sweet' | \
    DM_CAPTURE="$CAP" DISCORD_DM_SSH_BIN="$SSH_OK" DISCORD_DM_SPOOL="$SPOOL" \
    "$DM" --to "$FAKE_TO" --attempts 1 --quiet --chunk -
edge_exit=$?
if [ "$edge_exit" = 0 ]; then
    ok "edge: exit 0"
else
    fail "edge: exit $edge_exit (expected 0)"
fi

read_cap "$CAP"

if [ "$N_MSGS" = 1 ]; then
    ok "edge: exactly one message"
else
    fail "edge: expected 1 message, got $N_MSGS"
fi

if [ "${MSGS[0]}" = "short and sweet" ]; then
    ok "edge: message byte-identical to input"
else
    fail "edge: message differs — got '${MSGS[0]}'"
fi

# -- Phase 2: --route / --raw seam (Verification Matrix rows 2-5) -------------
# A second stub: records the remote command string (argv) as well as the body,
# because the route lives in the command, not in the payload.
SSH_ARGV="$TMP/ssh-argv"
cat > "$SSH_ARGV" <<'STUB_EOF'
#!/bin/bash
# The remote command is the LAST argument ssh is given.
for a in "$@"; do last="$a"; done
printf 'CMD: %s\n' "$last" >> "$DM_CAPTURE"
printf 'BODY: ' >> "$DM_CAPTURE"
cat >> "$DM_CAPTURE"
printf '\n' >> "$DM_CAPTURE"
printf '\nHTTP=200 curl_rc=0\n'
STUB_EOF
chmod +x "$SSH_ARGV"

R_CAP="$TMP/route-cap.txt"
run_route() { # ...args  -- captures R_OUT / R_RC, resets R_CAP
    : > "$R_CAP"
    R_OUT=$(DM_CAPTURE="$R_CAP" DISCORD_DM_SSH_BIN="$SSH_ARGV" \
        DISCORD_DM_TO="$FAKE_TO" DISCORD_DM_SPOOL="$SPOOL" \
        "$DM" --quiet --no-fallback --attempts 1 "$@" 2>&1)
    R_RC=$?
}
want()     { if grep -qF -- "$3" <<< "$2"; then ok "$1"; else fail "$1 -- missing '$3'"; fi }
want_not() { if grep -qF -- "$3" <<< "$2"; then fail "$1 -- unexpected '$3'"; else ok "$1"; fi }

printf '\n-- Phase 2: --route / --raw --\n'

# Row 2: --route retargets the POST; the default route is untouched without it.
run_route "plain message"
want "default route: POSTs /discordDM" "$(cat "$R_CAP")" "http://localhost:50000/discordDM"
want "default route: keeps the content envelope" "$(cat "$R_CAP")" "receivingUserDiscordID"

run_route --route /discordPlanReviewDM --raw - <<< '{"slug":"demo-plan","digest":"hi"}'
[ "$R_RC" = 0 ] && ok "raw+route: exit 0" || fail "raw+route: exit $R_RC (expected 0)"
want "row 2: --route retargets the POST" "$(cat "$R_CAP")" "http://localhost:50000/discordPlanReviewDM"

# Row 3: --raw sends the body verbatim -- no envelope, no recipient field.
want     "row 3: raw body is sent verbatim" "$(cat "$R_CAP")" '{"slug":"demo-plan","digest":"hi"}'
want_not "row 3: raw body carries no envelope" "$(cat "$R_CAP")" "receivingUserDiscordID"

# Row 4: the route is a shell-injection surface -- reject before the remote leg.
for bad in '/dm; touch /tmp/pwned' '/dm$(id)' '/dm with space' 'discordDM' '/dm`id`' "/dm'x'"; do
    run_route --route "$bad" --raw - <<< '{"a":1}'
    if [ "$R_RC" = 2 ]; then ok "row 4: rejects route '$bad'"; else fail "row 4: route '$bad' gave exit $R_RC (expected 2)"; fi
    if [ -s "$R_CAP" ]; then fail "row 4: route '$bad' reached the remote leg"; else ok "row 4: route '$bad' never reached ssh"; fi
done

# Flag form is the SPACE form; --flag=value must not be silently accepted.
run_route --route=/discordPlanReviewDM --raw - <<< '{"a":1}'
[ "$R_RC" = 2 ] && ok "row 4: --route=value is rejected" || fail "row 4: --route=value gave exit $R_RC (expected 2)"

# Row 5: --raw guards -- needs a route, refuses --chunk, requires valid JSON.
run_route --raw - <<< '{"a":1}'
[ "$R_RC" = 2 ] && ok "row 5: --raw without --route is rejected" || fail "row 5: --raw without --route gave exit $R_RC"

run_route --route /discordPlanReviewDM --chunk --raw - <<< '{"a":1}'
[ "$R_RC" = 2 ] && ok "row 5: --raw with --chunk is rejected" || fail "row 5: --raw with --chunk gave exit $R_RC"

run_route --route /discordPlanReviewDM --raw - <<< 'not json at all'
[ "$R_RC" = 2 ] && ok "row 5: --raw rejects a non-JSON body" || fail "row 5: non-JSON body gave exit $R_RC"

# Row 5: a raw body over the 1900-char cap must NOT be truncated -- truncating a
# JSON document ships invalid JSON to a route that will 400 on it.
BIG_DIGEST=$(printf 'x%.0s' $(seq 1 2500))
run_route --route /discordPlanReviewDM --raw - <<< "{\"slug\":\"demo-plan\",\"digest\":\"$BIG_DIGEST\"}"
[ "$R_RC" = 0 ] && ok "row 5: over-cap raw body still sends" || fail "row 5: over-cap raw body gave exit $R_RC"
want_not "row 5: over-cap raw body is not truncated" "$(cat "$R_CAP")" "(truncated)"
if sed -n 's/^BODY: //p' "$R_CAP" | jq -e . >/dev/null 2>&1; then
    ok "row 5: over-cap raw body is still valid JSON"
else
    fail "row 5: over-cap raw body arrived as invalid JSON"
fi

# -- Characterization: SSH path invariants the webhook change must not move ----
SSH_CODE="$TMP/ssh-code"
cat > "$SSH_CODE" <<'STUB_EOF'
#!/bin/bash
for a in "$@"; do last="$a"; done
printf 'CMD: %s\n' "$last" >> "$DM_CAPTURE"
printf 'BODY: ' >> "$DM_CAPTURE"; cat >> "$DM_CAPTURE"; printf '\n' >> "$DM_CAPTURE"
printf '\nHTTP=%s curl_rc=0\n' "${STUB_HTTP:-200}"
STUB_EOF
chmod +x "$SSH_CODE"

run_ssh() { # <http> <webhook-file> ...dm-args -- captures S_OUT / S_RC, resets caps
    local code="$1" wh="$2"; shift 2
    : > "$R_CAP"; : > "$CURL_CAP"; : > "$SPOOL"
    S_OUT=$(DM_CAPTURE="$R_CAP" STUB_HTTP="$code" DISCORD_DM_SSH_BIN="$SSH_CODE" \
        DISCORD_DM_CURL_BIN="$CURL_NEVER" DISCORD_DM_WEBHOOK_FILE="$wh" \
        DISCORD_DM_SPOOL="$SPOOL" "$DM" --quiet --attempts 1 "$@" 2>&1)
    S_RC=$?
}
ssh_calls() { grep -c '^CMD:' "$R_CAP"; }

printf '\n-- Characterization: SSH path --\n'

# C1: another recipient stays on SSH even when a webhook file exists.
run_ssh 200 "$FAKE_WEBHOOK_FILE" --to "$FAKE_TO" "approver note"
[ "$S_RC" = 0 ] && ok "C1: --to other exits 0" || fail "C1: --to other exit $S_RC"
want "C1: --to other POSTs /discordDM over ssh" "$(cat "$R_CAP")" "http://localhost:50000/discordDM"
want "C1: --to other keeps its recipient" "$(cat "$R_CAP")" "\"receivingUserDiscordID\": \"$FAKE_TO\""
[ -s "$CURL_CAP" ] && fail "C1: --to other reached the webhook curl" || ok "C1: --to other never ran curl"

# C2: the owner with NO webhook file falls back to the SSH DM.
run_ssh 200 "$TMP/absent-webhook-url" --to "$OWNER_ID" "owner note"
[ "$S_RC" = 0 ] && ok "C2: owner, no webhook file exits 0" || fail "C2: exit $S_RC"
want "C2: owner, no webhook file uses ssh" "$(cat "$R_CAP")" "\"receivingUserDiscordID\": \"$OWNER_ID\""
[ -s "$CURL_CAP" ] && fail "C2: missing webhook file still ran curl" || ok "C2: never ran curl"

# C3: --raw --route stays on SSH even for the owner with a webhook file present.
run_ssh 200 "$FAKE_WEBHOOK_FILE" --to "$OWNER_ID" --route /discordPlanReviewDM --raw - <<< '{"slug":"s"}'
[ "$S_RC" = 0 ] && ok "C3: raw+route exits 0" || fail "C3: exit $S_RC"
want "C3: raw+route POSTs its route over ssh" "$(cat "$R_CAP")" "http://localhost:50000/discordPlanReviewDM"
[ -s "$CURL_CAP" ] && fail "C3: raw+route reached the webhook curl" || ok "C3: raw+route never ran curl"

# C4: SSH path 4xx stays permanent: one attempt, exit 1, spool names the status.
# --attempts 2 (overrides run_ssh's 1): a passing run returns on the 400 with no
# sleep; a regressed run would retry, so the call count is non-vacuous.
run_ssh 400 "$TMP/absent-webhook-url" --no-fallback --attempts 2 --to "$FAKE_TO" "bad"
[ "$S_RC" = 1 ] && ok "C4: ssh 400 exits 1" || fail "C4: ssh 400 exit $S_RC"
[ "$(ssh_calls)" = 1 ] && ok "C4: ssh 400 is not retried" || fail "C4: ssh 400 made $(ssh_calls) calls"
run_ssh 400 "$TMP/absent-webhook-url" --to "$FAKE_TO" "bad"
want "C4: spool header names recipient + status" "$(cat "$SPOOL")" "UNDELIVERED (to=$FAKE_TO http=400)"

# C5: SSH path stays 200-only. The 2xx widening in Phase 2 is webhook-scoped.
run_ssh 204 "$TMP/absent-webhook-url" --no-fallback --to "$FAKE_TO" "odd status"
[ "$S_RC" = 1 ] && ok "C5: ssh 204 is not success" || fail "C5: ssh 204 exit $S_RC (expected 1)"

# C6: default recipient still comes from ~/.iblbot-dm-id (inside the isolated HOME).
printf '%s\n' "$FAKE_TO" > "$HOME/.iblbot-dm-id"
: > "$R_CAP"
DM_CAPTURE="$R_CAP" DISCORD_DM_SSH_BIN="$SSH_CODE" DISCORD_DM_SPOOL="$SPOOL" \
    "$DM" --quiet --attempts 1 "from id file" >/dev/null 2>&1
want "C6: recipient defaults from the id file" "$(cat "$R_CAP")" "\"receivingUserDiscordID\": \"$FAKE_TO\""
rm -f "$HOME/.iblbot-dm-id"

# -- Webhook path: owner notices go to the #dev channel webhook ----------------
CURL_STUB="$TMP/curl-stub"; CURL_N="$TMP/curl-n"; export CURL_N
cat > "$CURL_STUB" <<'STUB_EOF'
#!/bin/bash
n=$(( $(cat "$CURL_N" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$CURL_N"
printf 'ARGV:%s\n' "$*" >> "$CURL_CAP"; printf 'CONF:%s\n' "$(cat)" >> "$CURL_CAP"
for a in "$@"; do case "$a" in @*) printf 'BODY:%s\n' "$(jq -c . "${a#@}")" >> "$CURL_CAP" ;; esac; done
code=$(cut -d, -f"$n" <<< "$CURL_STATUSES"); code=${code:-200}
[ "$code" = 429 ] && printf '{"retry_after":0.2}'
printf '\nHTTP=%s' "$code"
STUB_EOF
chmod +x "$CURL_STUB"
run_wh() { # <statuses> ...dm-args  -> W_OUT / W_RC
    local st="$1"; shift; : > "$CURL_CAP"; rm -f "$CURL_N"; : > "$SPOOL"; : > "$R_CAP"
    W_OUT=$(CURL_STATUSES="$st" DM_CAPTURE="$R_CAP" DISCORD_DM_TO="$OWNER_ID" \
        DISCORD_DM_CURL_BIN="$CURL_STUB" DISCORD_DM_SSH_BIN="$SSH_CODE" \
        DISCORD_DM_WEBHOOK_FILE="${WH_FILE:-$FAKE_WEBHOOK_FILE}" DISCORD_DM_SPOOL="$SPOOL" \
        "$DM" --attempts 3 "$@" 2>&1); W_RC=$?
}
curl_calls() { grep -c '^ARGV:' "$CURL_CAP"; }
body() { sed -n 's/^BODY://p' "$CURL_CAP" | sed -n "${1}p"; }

printf '\n-- Webhook path --\n'

# W1/W2: 200 and 204 both deliver on one call; no spool; ssh never runs.
run_wh 200 "hi"
[ "$W_RC" = 0 ] && ok "W1: webhook 200 exits 0" || fail "W1: exit $W_RC"
[ "$(curl_calls)" = 1 ] && ok "W1: one curl call" || fail "W1: $(curl_calls) curl calls"
[ ! -s "$SPOOL" ] && ok "W1: nothing spooled" || fail "W1: spooled a delivered message"
[ ! -s "$R_CAP" ] && ok "W1: ssh never ran" || fail "W1: webhook send also ran ssh"
run_wh 204 "hi"
[ "$W_RC" = 0 ] && ok "W2: webhook 204 exits 0" || fail "W2: 204 exit $W_RC"
[ "$(curl_calls)" = 1 ] && ok "W2: 204 is one curl call" || fail "W2: $(curl_calls) curl calls"
[ ! -s "$SPOOL" ] && ok "W2: 204 not spooled" || fail "W2: 204 spooled"

# W3: 429 waits retry_after (0.2 rounds up to 1s), not the 15s backoff.
SECONDS=0; run_wh 429,200 "hi"; W3_SECS=$SECONDS
[ "$W_RC" = 0 ] && ok "W3: 429 then 200 exits 0" || fail "W3: exit $W_RC"
[ "$(curl_calls)" = 2 ] && ok "W3: 429 retried once" || fail "W3: $(curl_calls) curl calls"
[ "$W3_SECS" -lt 10 ] && ok "W3: waited retry_after, not the backoff" || fail "W3: took ${W3_SECS}s"

# W4: other 4xx is permanent: one call, exit 1, spooled.
run_wh 400,200 "hi"
[ "$W_RC" = 1 ] && ok "W4: webhook 400 exits 1" || fail "W4: exit $W_RC"
[ "$(curl_calls)" = 1 ] && ok "W4: 400 is not retried" || fail "W4: $(curl_calls) curl calls"
want "W4: spool names recipient + status" "$(cat "$SPOOL")" "UNDELIVERED (to=$OWNER_ID http=400)"
W4_LEAK="$W_OUT$(cat "$SPOOL")"

# W5: default payload cannot mention anyone.
run_wh 200 "@everyone <@1> x"
[ "$(body 1 | jq -r '.allowed_mentions.parse | length')" = 0 ] \
    && ok "W5: allowed_mentions.parse is empty" || fail "W5: allowed_mentions.parse not empty"
[ "$(body 1 | jq -r '.content | startswith("<@")')" = false ] \
    && ok "W5: no ping prefix by default" || fail "W5: content starts with a mention"

# W6/W7: --ping mentions the owner on chunk 1 only; every body suppresses embeds.
run_wh 200,200,200,200 --ping --chunk - < "$FIXTURE"
[ "$(body 1 | jq -r '.content | startswith("<@283183467804491776> ")')" = true ] \
    && ok "W6: chunk 1 carries the owner mention" || fail "W6: chunk 1 has no mention"
[ "$(body 1 | jq -c '.allowed_mentions.users')" = '["283183467804491776"]' ] \
    && ok "W6: chunk 1 allows only the owner ID (string)" || fail "W6: chunk 1 allowed_mentions.users wrong"
[ "$(body 2 | jq -r '.content | startswith("(2/")')" = true ] \
    && ok "W6: chunk 2 has no mention prefix" || fail "W6: chunk 2 content wrong"
[ "$(body 2 | jq -c '.allowed_mentions.parse')" = '[]' ] \
    && ok "W6: chunk 2 allows no mentions" || fail "W6: chunk 2 allowed_mentions wrong"
W7_BAD=0
while IFS= read -r line; do
    jq -e '.flags == 4' <<< "$line" >/dev/null 2>&1 || W7_BAD=$(( W7_BAD + 1 ))
done < <(sed -n 's/^BODY://p' "$CURL_CAP")
[ "$W7_BAD" = 0 ] && ok "W7: every webhook body sets flags=4" || fail "W7: $W7_BAD bodies missing flags=4"

# W8: the URL reaches curl only through the stdin config, never argv, never output.
run_wh 200 "hi"
want_not "W8: URL is not in curl argv" "$(grep '^ARGV:' "$CURL_CAP")" "example.invalid"
want "W8: URL arrives via the -K - config" "$(grep '^CONF:' "$CURL_CAP")" "url = \"$FAKE_WEBHOOK_URL?wait=true\""
want_not "W8: a failed send never echoes the URL" "$W4_LEAK" "example.invalid"

# W9: --ping is rejected with --raw and in --flag=value form, before any send.
run_wh 200 --ping --raw --route /discordPlanReviewDM - <<< '{}'
[ "$W_RC" = 2 ] && [ "$(curl_calls)" = 0 ] && ok "W9: --ping --raw exits 2, no curl" || fail "W9: --ping --raw rc=$W_RC curl=$(curl_calls)"
run_wh 200 --ping=1 "x"
[ "$W_RC" = 2 ] && [ "$(curl_calls)" = 0 ] && ok "W9: --ping=1 exits 2, no curl" || fail "W9: --ping=1 rc=$W_RC curl=$(curl_calls)"

# W10: a malformed webhook file falls back to the DM without echoing the URL.
printf '%s\n' 'https://ex.invalid/a"b' > "$TMP/bad-webhook-url"
WH_FILE="$TMP/bad-webhook-url" run_wh 200 "hi"
[ "$W_RC" = 0 ] && ok "W10: malformed file still delivers" || fail "W10: exit $W_RC"
want "W10: malformed file falls back to ssh" "$(cat "$R_CAP")" "http://localhost:50000/discordDM"
[ "$(curl_calls)" = 0 ] && ok "W10: malformed file never ran curl" || fail "W10: curl ran"
want_not "W10: warning omits the URL" "$W_OUT" "ex.invalid"
want "W10: warning names the DM fallback" "$W_OUT" "using the DM path"

# W11: unset and empty DISCORD_DM_WEBHOOK_FILE both use the $HOME default.
# Mutation check: switching the default to ${VAR-…} (no colon) makes the empty case fail.
printf '%s\n' "$FAKE_WEBHOOK_URL" > "$HOME/.iblbot-dev-webhook-url"
: > "$CURL_CAP"; rm -f "$CURL_N"
DISCORD_DM_WEBHOOK_FILE="" DISCORD_DM_TO="$OWNER_ID" DISCORD_DM_CURL_BIN="$CURL_STUB" \
    DISCORD_DM_SSH_BIN="$SSH_CODE" DISCORD_DM_SPOOL="$SPOOL" DM_CAPTURE="$R_CAP" \
    "$DM" --quiet "hi" >/dev/null 2>&1
[ "$(curl_calls)" = 1 ] && ok "W11: empty webhook-file var uses the default path" || fail "W11: empty var made $(curl_calls) curl calls"
: > "$CURL_CAP"; rm -f "$CURL_N"
env -u DISCORD_DM_WEBHOOK_FILE DISCORD_DM_TO="$OWNER_ID" DISCORD_DM_CURL_BIN="$CURL_STUB" \
    DISCORD_DM_SSH_BIN="$SSH_CODE" DISCORD_DM_SPOOL="$SPOOL" DM_CAPTURE="$R_CAP" \
    "$DM" --quiet "hi" >/dev/null 2>&1
[ "$(curl_calls)" = 1 ] && ok "W11: unset webhook-file var uses the default path" || fail "W11: unset var made $(curl_calls) curl calls"

# W11b: an empty curl seam falls back to the real curl (which cannot resolve
# example.invalid) instead of "command not found".
# Mutation check: a ${VAR-curl} default (no colon) keeps the empty value and fails here.
: > "$SPOOL"
W11B_OUT=$(DISCORD_DM_CURL_BIN="" DISCORD_DM_TO="$OWNER_ID" DISCORD_DM_WEBHOOK_FILE="$FAKE_WEBHOOK_FILE" \
    DISCORD_DM_SSH_BIN="$SSH_CODE" DISCORD_DM_SPOOL="$SPOOL" DM_CAPTURE="$R_CAP" \
    "$DM" --quiet --attempts 1 "hi" 2>&1); W11B_RC=$?
[ "$W11B_RC" = 1 ] && ok "W11b: empty curl seam runs real curl and fails" || fail "W11b: exit $W11B_RC"
want "W11b: spool records the failed status" "$(cat "$SPOOL")" "http=000"
want_not "W11b: no command-not-found" "$W11B_OUT" "command not found"
rm -f "$HOME/.iblbot-dev-webhook-url"

# W12: --ping adds nothing on the ssh fallback.
WH_FILE="$TMP/absent-webhook-url" run_wh 200 --ping "hi"
want_not "W12: ssh body carries no mention" "$(cat "$R_CAP")" "<@"
[ "$(curl_calls)" = 0 ] && ok "W12: fallback never ran curl" || fail "W12: curl ran"

# -- notify-discord action: send.sh with a stub curl ---------------------------
SEND="$ROOT/.github/actions/notify-discord/send.sh"
ACT_CAP="$TMP/act-cap.txt"; ACT_N="$TMP/act-n"; export ACT_CAP ACT_N
cat > "$TMP/curl-act" <<'STUB_EOF'
#!/bin/bash
n=$(( $(cat "$ACT_N" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$ACT_N"
printf 'ARGV:%s\n' "$*" >> "$ACT_CAP"; printf 'CONF:%s\n' "$(cat)" >> "$ACT_CAP"
out=""; prev=""
for a in "$@"; do
    [ "$prev" = "-o" ] && out="$a"
    case "$a" in @*) printf 'BODY:%s\n' "$(jq -c . "${a#@}")" >> "$ACT_CAP" ;; esac
    prev="$a"
done
code=$(cut -d, -f"$n" <<< "$ACT_STATUSES"); code=${code:-200}
if [ "$code" = 429 ]; then printf '{"retry_after":0.2}' > "$out"; else printf '{}' > "$out"; fi
printf '%s' "$code"
STUB_EOF
chmod +x "$TMP/curl-act"
ACT_MSG="$TMP/act-msg.txt"; printf 'deploy failed on prod\n' > "$ACT_MSG"
run_act() { # <statuses> <fail-on-delivery> <ping> <msg-file> -> A_OUT / A_RC
    : > "$ACT_CAP"; rm -f "$ACT_N"
    A_OUT=$(ACT_STATUSES="$1" WEBHOOK_URL="${ACT_URL-$FAKE_WEBHOOK_URL}" MSG_FILE="$4" \
        PING="$3" FAIL_ON_DELIVERY="$2" NOTIFY_CURL_BIN="$TMP/curl-act" bash "$SEND" 2>&1)
    A_RC=$?
}
act_calls() { grep -c '^ARGV:' "$ACT_CAP"; }
act_body() { sed -n 's/^BODY://p' "$ACT_CAP" | sed -n "${1}p"; }

printf '\n-- notify-discord action (send.sh) --\n'

# A1/A2: 200 and 204 both deliver on one call.
run_act 200 true false "$ACT_MSG"
[ "$A_RC" = 0 ] && [ "$(act_calls)" = 1 ] && ok "A1: 200 delivers on one call" || fail "A1: rc=$A_RC calls=$(act_calls)"
want "A1: reports delivered" "$A_OUT" "delivered"
run_act 204 true false "$ACT_MSG"
[ "$A_RC" = 0 ] && [ "$(act_calls)" = 1 ] && ok "A2: 204 delivers on one call" || fail "A2: rc=$A_RC calls=$(act_calls)"
want "A2: reports delivered" "$A_OUT" "delivered"

# A3: 429 retries once retry_after has passed.
run_act 429,200 true false "$ACT_MSG"
[ "$A_RC" = 0 ] && [ "$(act_calls)" = 2 ] && ok "A3: 429 then 200 delivers on the retry" || fail "A3: rc=$A_RC calls=$(act_calls)"

# A4/A5: other 4xx is not retried; loud reds the step, soft warns and exits 0.
run_act 400,200 true false "$ACT_MSG"
[ "$A_RC" = 1 ] && [ "$(act_calls)" = 1 ] && ok "A4: 400 loud exits 1, one call" || fail "A4: rc=$A_RC calls=$(act_calls)"
want "A4: loud failure is an ::error::" "$A_OUT" "::error::Discord webhook POST failed (HTTP 400)"
run_act 400,200 false false "$ACT_MSG"
[ "$A_RC" = 0 ] && ok "A5: 400 soft exits 0" || fail "A5: soft rc=$A_RC"
want "A5: soft failure is a ::warning::" "$A_OUT" "::warning::"

# A6: an empty URL (unset secret, fork PR) makes no call.
ACT_URL="" run_act 200 true false "$ACT_MSG"
[ "$A_RC" = 1 ] && [ "$(act_calls)" = 0 ] && ok "A6: empty URL loud exits 1, no call" || fail "A6: loud rc=$A_RC calls=$(act_calls)"
want "A6: names the empty URL" "$A_OUT" "::error::webhook-url is empty"
ACT_URL="" run_act 200 false false "$ACT_MSG"
[ "$A_RC" = 0 ] && [ "$(act_calls)" = 0 ] && ok "A6: empty URL soft exits 0, no call" || fail "A6: soft rc=$A_RC calls=$(act_calls)"
want "A6: soft empty URL is a ::warning::" "$A_OUT" "::warning::"

# A7: a malformed URL makes no call and is never echoed.
ACT_URL='https://ex.invalid/a"b' run_act 200 true false "$ACT_MSG"
[ "$A_RC" = 1 ] && [ "$(act_calls)" = 0 ] && ok "A7: malformed URL exits 1, no call" || fail "A7: rc=$A_RC calls=$(act_calls)"
want_not "A7: malformed URL is not echoed" "$(grep -v '^::add-mask::' <<< "$A_OUT")" "ex.invalid"

# A8: ping mentions the owner; no ping cannot mention anyone. Both suppress embeds.
run_act 200 true true "$ACT_MSG"
[ "$(act_body 1 | jq -r '.content | startswith("<@283183467804491776> ")')" = true ] \
    && ok "A8: ping content carries the owner mention" || fail "A8: ping content wrong"
[ "$(act_body 1 | jq -c '.allowed_mentions.users')" = '["283183467804491776"]' ] \
    && ok "A8: ping allows only the owner ID (string)" || fail "A8: ping allowed_mentions wrong"
[ "$(act_body 1 | jq '.flags')" = 4 ] && ok "A8: ping body sets flags=4" || fail "A8: ping body flags wrong"
run_act 200 true false "$ACT_MSG"
[ "$(act_body 1 | jq -c '.allowed_mentions.parse')" = '[]' ] \
    && ok "A8: no-ping allows no mentions" || fail "A8: no-ping allowed_mentions wrong"
[ "$(act_body 1 | jq -r '.content | startswith("<@")')" = false ] \
    && ok "A8: no-ping content has no mention" || fail "A8: no-ping content has a mention"
[ "$(act_body 1 | jq '.flags')" = 4 ] && ok "A8: no-ping body sets flags=4" || fail "A8: no-ping body flags wrong"

# A9: a ping typo is an error, not a silent "false".
run_act 200 true yes "$ACT_MSG"
[ "$A_RC" = 1 ] && [ "$(act_calls)" = 0 ] && ok "A9: ping=yes exits 1, no call" || fail "A9: rc=$A_RC calls=$(act_calls)"
want "A9: names the ping error" "$A_OUT" "::error::ping must be true or false"

# A10: the URL reaches curl only through the stdin config; the log masks it.
run_act 200 true false "$ACT_MSG"
want_not "A10: URL is not in curl argv" "$(grep '^ARGV:' "$ACT_CAP")" "example.invalid"
want "A10: config carries ?wait=true" "$(grep '^CONF:' "$ACT_CAP")" "?wait=true"
A10_LEAKS=$(grep -F "$FAKE_WEBHOOK_URL" <<< "$A_OUT" | grep -vc '^::add-mask::')
[ "$A10_LEAKS" = 0 ] && ok "A10: URL appears only in ::add-mask::" || fail "A10: URL echoed outside ::add-mask::"

# A11: the 1900-char cap applies.
printf 'x%.0s' $(seq 1 2500) > "$TMP/act-big.txt"
run_act 200 true false "$TMP/act-big.txt"
[ "$(act_body 1 | jq '.content | length')" -le 1915 ] && ok "A11: content is capped" || fail "A11: content not capped"
[ "$(act_body 1 | jq -r '.content | endswith("(truncated)")')" = true ] \
    && ok "A11: capped content ends with the marker" || fail "A11: no truncation marker"

# -- notify-discord call sites: webhook-url everywhere, ping only where chosen -
# Scans every `uses: ./.github/actions/notify-discord` step in <wf-dir>/*.yml
# until the next step or a line indented 4 or fewer spaces. mode=sites prints one
# summary per site; mode=lines prints every scanned line (trimmed).
notify_scan() { # <wf-dir> <mode>
    local f
    for f in "$1"/*.yml; do
        awk -v file="$(basename "$f")" -v mode="$2" '
            function emit() {
                if (active && mode == "sites")
                    printf "%s#%d webhook=%d ping=%s\n", file, ord, wh, ping
                active = 0
            }
            /uses: \.\/\.github\/actions\/notify-discord/ { emit(); ord++; wh = 0; ping = "-"; active = 1; next }
            active {
                if ($0 ~ /^[[:space:]]*- /) { emit(); next }
                if ($0 !~ /^[[:space:]]*$/) {
                    match($0, /^ */)
                    if (RLENGTH <= 4) { emit(); next }
                }
                line = $0; sub(/^[[:space:]]+/, "", line); sub(/[[:space:]]+$/, "", line)
                if (mode == "lines") printf "%s#%d\t%s\n", file, ord, line
                if (line == "webhook-url: ${{ secrets.DISCORD_DEV_WEBHOOK_URL }}") wh = 1
                if (line ~ /^ping: /) ping = substr(line, 7)
            }
            END { emit() }' "$f"
    done | LC_ALL=C sort
}
notify_sites() { notify_scan "$1" sites; }

NOTIFY_SITES_WANT=$(cat <<'EXPECT_EOF'
db-backup.yml#1 webhook=1 ping='true'
db-backup.yml#2 webhook=1 ping='true'
db-backup.yml#3 webhook=1 ping='true'
docfix-health.yml#1 webhook=1 ping=-
docfix-health.yml#2 webhook=1 ping=-
docs-refreshed-notify.yml#1 webhook=1 ping=-
flake-report.yml#1 webhook=1 ping=-
log-review.yml#1 webhook=1 ping=-
main.yml#1 webhook=1 ping=-
merge-digest-notify.yml#1 webhook=1 ping='true'
mutation.yml#1 webhook=1 ping=-
promote-to-production.yml#1 webhook=1 ping=${{ job.status == 'failure' }}
promote-to-production.yml#2 webhook=1 ping=-
smoke-prod.yml#1 webhook=1 ping='true'
smoke-prod.yml#2 webhook=1 ping='true'
EXPECT_EOF
)

printf '\n-- notify-discord call sites --\n'

# G1: the live workflows match the table.
G1_GOT=$(notify_sites "$ROOT/.github/workflows")
if [ "$G1_GOT" = "$NOTIFY_SITES_WANT" ]; then
    ok "G1: 15 sites pass webhook-url; ping only on the chosen sites"
else
    fail "G1: call sites differ from the table"
    diff <(printf '%s\n' "$NOTIFY_SITES_WANT") <(printf '%s\n' "$G1_GOT") | sed 's/^/       /'
fi

# G2: an injected stray ping line must show up in the scan.
rm -rf "$TMP/wf"; mkdir -p "$TMP/wf"; cp "$ROOT"/.github/workflows/*.yml "$TMP/wf/"
perl -pi -e 's/^(\s*webhook-url:.*)$/$1\n          ping: \x27true\x27/' "$TMP/wf/flake-report.yml"
G2_GOT=$(notify_sites "$TMP/wf")
[ "$G2_GOT" != "$NOTIFY_SITES_WANT" ] && ok "G2: an injected ping line changes the scan" \
    || fail "G2: an injected ping line went unnoticed"
if [ "$G1_GOT" = "$NOTIFY_SITES_WANT" ]; then
    want "G2: the injected ping is what differs" "$G2_GOT" "flake-report.yml#1 webhook=1 ping='true'"
fi

# G3: a deleted webhook-url line must show up in the scan.
rm -rf "$TMP/wf"; mkdir -p "$TMP/wf"; cp "$ROOT"/.github/workflows/*.yml "$TMP/wf/"
perl -ni -e 'print unless /^\s*webhook-url:/' "$TMP/wf/log-review.yml"
G3_GOT=$(notify_sites "$TMP/wf")
[ "$G3_GOT" != "$NOTIFY_SITES_WANT" ] && ok "G3: a deleted webhook-url line changes the scan" \
    || fail "G3: a deleted webhook-url line went unnoticed"
if [ "$G1_GOT" = "$NOTIFY_SITES_WANT" ]; then
    want "G3: the deleted line is what differs" "$G3_GOT" "log-review.yml#1 webhook=0"
fi

# G4: the removed SSH inputs are gone from every site.
G4_LEFT=$(notify_scan "$ROOT/.github/workflows" lines | grep -E $'\t(discord-id|port|host|username):')
[ -z "$G4_LEFT" ] && ok "G4: no discord-id/port/host/username in a notify block" \
    || fail "G4: removed inputs remain: $(tr '\n' ' ' <<< "$G4_LEFT")"

# G5: a job that still runs ssh/scp must keep its setup-ssh step. Jobs split on
# `^  <name>:$`; lines before the first header (file comments) belong to no job.
ssh_scan() { # <wf-dir>: prints "<file>::<job>" for each job with ssh use but no setup-ssh
    local f
    for f in "$1"/*.yml; do
        awk -v file="$(basename "$f")" '
            function flush() {
                if (job != "" && uses_ssh && !has_setup) print file "::" job
            }
            { sub(/\r$/, "") }
            /^  [A-Za-z0-9_-]+:$/ { flush(); job = $0; sub(/^ +/, "", job); sub(/:$/, "", job); uses_ssh = 0; has_setup = 0; next }
            /actions\/setup-ssh/ { has_setup = 1 }
            /id_deploy|ssh -|scp -|--ssh-key/ { uses_ssh = 1 }
            END { flush() }' "$f"
    done | LC_ALL=C sort
}
G5_BAD=$(ssh_scan "$ROOT/.github/workflows")
[ -z "$G5_BAD" ] && ok "G5: every job that runs ssh/scp keeps its setup-ssh step" \
    || fail "G5: ssh/scp without setup-ssh in: $(tr '\n' ' ' <<< "$G5_BAD")"

# G5 self-test: dropping main.yml's setup-ssh line must be flagged.
rm -rf "$TMP/wf"; mkdir -p "$TMP/wf"; cp "$ROOT"/.github/workflows/*.yml "$TMP/wf/"
perl -ni -e 'print unless m{uses: \./\.github/actions/setup-ssh}' "$TMP/wf/main.yml"
G5_GOT=$(ssh_scan "$TMP/wf")
[ -n "$G5_GOT" ] && ok "G5: a dropped setup-ssh step in main.yml is flagged" \
    || fail "G5: a dropped setup-ssh step in main.yml went unnoticed"
grep -qF -- "main.yml::build-and-deploy" <<< "$G5_GOT" \
    && ok "G5: the flagged job is main.yml::build-and-deploy" \
    || fail "G5: expected main.yml::build-and-deploy, got: $(tr '\n' ' ' <<< "$G5_GOT")"

# G6: --ping (the @-mention) is allowed only in the five PING host callers. Tests, the
# README and discord-dm itself mention it and are excluded; any other bin/ caller is QUIET.
G6_GOT=$(grep -rlF -- '--ping' "$ROOT/bin" 2>/dev/null \
    | grep -v -e '/bin/discord-dm$' -e '/bin/test-' -e '/bin/README.md$' \
    | sed "s|^$ROOT/||" | sort || true)
G6_WANT=$(printf '%s\n' bin/db-backups-pull bin/launchd-health-check bin/post-plan-fail-dm bin/pr-cycle bin/pr-cycle-tick)
[ "$G6_GOT" = "$G6_WANT" ] \
    && ok "G6: only the five PING callers contain --ping" \
    || fail "G6: --ping callers differ from the PING set; got: $(tr '\n' ' ' <<< "$G6_GOT")"

# ── Summary ───────────────────────────────────────────────────────────────────
printf '\n'
if [ "$FAILS" -eq 0 ]; then
    echo "test-discord-dm: all cases passed"
else
    printf 'test-discord-dm: %d case(s) FAILED\n' "$FAILS"
fi
exit $(( FAILS > 0 ? 1 : 0 ))
