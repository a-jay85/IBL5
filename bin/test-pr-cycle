# ==========================================================================================
# 27 — --only / --skip scope the WORK, and only the work
# ==========================================================================================
# The filter is applied AFTER pr-attack's ordering, never inside it, so these cases assert
# which PRs get a pr-ready-now session — never that the order among the kept PRs changed.

# --- 27a: --only readies exactly the named PR, then drains -------------------------------
begin_case
reset_state
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
triage_report "101 NEEDS-WORK rebase" "102 NEEDS-WORK rebase" "103 NEEDS-WORK rebase" \
    > "$SCRATCH/triage-out"
run --worker --only 102
[[ $RC -eq 0 ]] || fail "--only run exit $RC, want 0"
[[ "$(calls ready)" == "1" ]] || fail "--only 102 made $(calls ready) ready calls, want 1"
[[ "$(sed -n 1p "$SCRATCH/ready.argv")" == "--pr-list 102 --jobs 3 --go --wait --allow-test-only" ]] \
    || fail "--only 102 readied: $(sed -n 1p "$SCRATCH/ready.argv")"
grep -qF 'done' <<< "$OUT" || fail "--only run did not finish normally"
grep -qF -- '--only 102' <<< "$OUT" || fail "worker did not announce its scope"
# Stage 1 is the only caller that exempts the fleet from the test-only exit-5 refusal.
grep -qF -- '--allow-test-only' "$SCRATCH/ready.argv" \
    || fail "stage1-passes-allow-test-only: fleet argv lacks --allow-test-only: $(sed -n 1p "$SCRATCH/ready.argv")"
echo "stage1-passes-allow-test-only OK"

# The hash form is the same set: normalization happens at parse time, not at match time.
reset_state
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
triage_report "101 NEEDS-WORK rebase" "102 NEEDS-WORK rebase" "103 NEEDS-WORK rebase" \
    > "$SCRATCH/triage-out"
run --worker --only '#102'
[[ "$(sed -n 1p "$SCRATCH/ready.argv")" == "--pr-list 102 --jobs 3 --go --wait --allow-test-only" ]] \
    || fail "--only '#102' readied: $(sed -n 1p "$SCRATCH/ready.argv")"

# Two of three, in pr-attack's order — the filter drops rows, it never reorders them.
reset_state
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
triage_report "101 NEEDS-WORK rebase" "102 NEEDS-WORK rebase" "103 NEEDS-WORK rebase" \
    > "$SCRATCH/triage-out"
run --worker --only 103,101
[[ "$(calls ready)" == "1" ]] || fail "--only 103,101 made $(calls ready) ready calls, want 1"
_a27a="$(sed -n 1p "$SCRATCH/ready.argv")"
[[ "$_a27a" == "--pr-list 101,103 --jobs 3 --go --wait --allow-test-only" ]] \
    || fail "--only 103,101 argv: $_a27a"
end_case "case 27a --only selects and preserves order"

# --- 27b: --skip is the inverse ----------------------------------------------------------
begin_case
reset_state
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
triage_report "101 NEEDS-WORK rebase" "102 NEEDS-WORK rebase" "103 NEEDS-WORK rebase" \
    > "$SCRATCH/triage-out"
run --worker --skip 101,103
[[ $RC -eq 0 ]] || fail "--skip run exit $RC, want 0"
[[ "$(calls ready)" == "1" ]] || fail "--skip 101,103 made $(calls ready) ready calls, want 1"
[[ "$(sed -n 1p "$SCRATCH/ready.argv")" == "--pr-list 102 --jobs 3 --go --wait --allow-test-only" ]] \
    || fail "--skip readied: $(sed -n 1p "$SCRATCH/ready.argv")"
grep -qF -- '--skip 101,103' <<< "$OUT" || fail "worker did not announce its --skip scope"
# No flag at all is the unfiltered baseline — the predicate must be a no-op by default.
reset_state
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
triage_report "101 NEEDS-WORK rebase" "102 NEEDS-WORK rebase" "103 NEEDS-WORK rebase" \
    > "$SCRATCH/triage-out"
run --worker
[[ "$(calls ready)" == "1" ]] || fail "unfiltered run made $(calls ready) ready calls, want 1"
_a27b="$(sed -n 1p "$SCRATCH/ready.argv")"
[[ "$_a27b" == "--pr-list 101,102,103 --jobs 3 --go --wait --allow-test-only" ]] \
    || fail "unfiltered batch argv: $_a27b"
end_case "case 27b --skip and the unfiltered baseline"

# --- 27c: an --only PR the plan never mentions is announced, not silently drained --------
# Without the warning this run is indistinguishable from success: nothing is orderable, so
# DRAINED=1 and the log reads "queue drained" — which a human reads as "already clean".
begin_case
reset_state
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
triage_report "101 NEEDS-WORK rebase" > "$SCRATCH/triage-out"
run --worker --only 999
[[ $RC -eq 0 ]] || fail "unmatched --only exit $RC, want 0"
[[ "$(calls ready)" == "0" ]] || fail "unmatched --only readied $(calls ready) PRs, want 0"
grep -qF 'absent from the plan of attack' <<< "$OUT" || fail "unmatched --only was not announced"
grep -qF '#999' <<< "$OUT" || fail "the warning does not name the missing PR"
# A PR the plan DOES list must not be reported as missing, and the warning fires once.
reset_state
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
triage_report "101 NEEDS-WORK rebase" "102 NEEDS-WORK rebase" "103 NEEDS-WORK rebase" \
    > "$SCRATCH/triage-out"
run --worker --only 101,102
grep -qF 'absent from the plan of attack' <<< "$OUT" && fail "false-positive absent warning"
end_case "case 27c unmatched --only is announced"

# --- 27d: the DIRTY-rescue path honours the scope ----------------------------------------
# Without this, --only 101 would still spend an hour-long pr-ready-now session rebasing an
# out-of-set DIRTY PR, which is the exact cost the flag exists to avoid.
begin_case
reset_state
printf '%s' "$ATTACK_EXCLUDED" > "$SCRATCH/attack-out"
triage_report "101 NEEDS-WORK rebase" > "$SCRATCH/triage-out"
run --worker --only 101
[[ $RC -eq 0 ]] || fail "scoped rescue run exit $RC, want 0"
[[ "$(calls ready)" == "1" ]] || fail "--only 101 made $(calls ready) ready calls, want 1 (no rescue)"
grep -qF '201' <<< "$(sed -n 1p "$SCRATCH/ready.argv")" && fail "--only 101 included out-of-scope DIRTY #201"

# An in-scope DIRTY PR is still rescued: the filter narrows the path, it does not disable it.
reset_state
printf '%s' "$ATTACK_EXCLUDED" > "$SCRATCH/attack-out"
triage_report "101 NEEDS-WORK rebase" > "$SCRATCH/triage-out"
run --worker --only 101,201
[[ "$(calls ready)" == "1" ]] || fail "--only 101,201 made $(calls ready) ready calls, want 1"
_a27d="$(sed -n 1p "$SCRATCH/ready.argv")"
grep -qF '201' <<< "$_a27d" || fail "in-scope DIRTY #201 was not in --pr-list: $_a27d"
end_case "case 27d rescue honours the scope"

# --- 27e: the dry run reports the scope, including the rescues it would skip -------------
begin_case
reset_state
printf '%s' "$ATTACK_EXCLUDED" > "$SCRATCH/attack-out"
triage_report "101 NEEDS-WORK rebase" > "$SCRATCH/triage-out"
run --only 101
[[ $RC -eq 0 ]] || fail "dry run with --only exit $RC, want 0"
grep -qF 'would use scope:      --only 101' <<< "$OUT" || fail "dry run does not report the --only scope"
grep -qF 'would be rescued FIRST' <<< "$OUT" && fail "dry run promised an out-of-scope rescue"
[[ "$(calls ready)" == "0" ]] || fail "dry run fired pr-ready-now"
grep -qF 'stage 1 would ready' <<< "$OUT" || fail "dry run did not show stage 1 list"

reset_state
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
triage_report "101 NEEDS-WORK rebase" > "$SCRATCH/triage-out"
run --skip 101
grep -qF 'would use scope:      --skip 101' <<< "$OUT" || fail "dry run does not report the --skip scope"
grep -qF '#102' <<< "$OUT" || fail "dry run stage 1 list ignored --skip"
run
grep -qF 'would use scope:      every orderable PR' <<< "$OUT" || fail "unfiltered dry run mislabels its scope"
end_case "case 27e dry run reports the scope"

# --- 27f: --go threads the scope into the detached worker --------------------------------
# --go re-invokes this script as --worker through an emitted runner. A flag not propagated
# there is silently dropped: the dry run reports the scope and the real run ignores it.
begin_case
reset_state
TSPIN="${TSBASE}2"
PLIST="$SCRATCH/Library/LaunchAgents/com.ibl5.pr-cycle-$TSPIN.plist"
RUNNER="/tmp/pr-cycle-$TSPIN.sh"
rm -f "$RUNNER" "/tmp/pr-cycle-$TSPIN.log" "$PLIST"
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
PR_CYCLE_DRY_LAUNCH=1 TSPIN="$TSPIN" run --go
[[ $RC -eq 0 ]] || fail "--go (no scope) exit $RC, want 0"
grep -qF "ONLY=''" "$RUNNER" || fail "runner ONLY not empty by default"
grep -qF "SKIP=''" "$RUNNER" || fail "runner SKIP not empty by default"

rm -f "$RUNNER" "$PLIST" "/tmp/pr-cycle-$TSPIN.log"
PR_CYCLE_DRY_LAUNCH=1 TSPIN="$TSPIN" run --go --only '#101,#102'
[[ $RC -eq 0 ]] || fail "--go --only exit $RC, want 0"
bash -n "$RUNNER" || fail "runner does not parse after --only"
runner_var() {  # $1 = variable name; evaluate the runner's own %q-quoted assignment
    bash -c "$(grep -m1 "^$1=" "$RUNNER"); printf '%s' \"\$$1\""
}
[[ "$(runner_var ONLY)" == "101,102" ]] \
    || fail "runner ONLY is '$(runner_var ONLY)', want the normalized 101,102"
grep -qF -- '${ONLY:+--only $ONLY}' "$RUNNER" || fail "runner does not pass --only to the worker"

rm -f "$RUNNER" "$PLIST" "/tmp/pr-cycle-$TSPIN.log"
PR_CYCLE_DRY_LAUNCH=1 TSPIN="$TSPIN" run --go --skip 103
[[ "$(runner_var SKIP)" == "103" ]] || fail "runner SKIP is '$(runner_var SKIP)', want 103"
grep -qF -- '${SKIP:+--skip $SKIP}' "$RUNNER" || fail "runner does not pass --skip to the worker"
rm -f "$RUNNER" "$PLIST" "/tmp/pr-cycle-$TSPIN.log"
unset TSPIN
end_case "case 27f --go propagates the scope"

# ==========================================================================================
# 25 / 26 — static guards over the driver source, and their vacuity check
# ==========================================================================================
# Each guard is a function over a FILE, so it can be run against the real driver (expect
# pass) and against deliberately mutated copies (expect fail). A guard that cannot fail is
# not a guard.
noncomment() { grep -vE '^[[:space:]]*#' "$1"; }

g_no_merge() {
    ! grep -qE 'gh[[:space:]]+pr[[:space:]]+merge|pr[[:space:]]+merge[[:space:]]+--' "$1" \
        && ! grep -qE 'merge[^\n]*--auto' "$1"
}
g_no_armable_lib() { ! grep -q 'pr-armable' "$1"; }
g_triage_pin() {
    grep -qF 'PR_CYCLE_TRIAGE_CMD="${PR_CYCLE_TRIAGE_CMD:-$ROOT/bin/pr-triage}"' "$1"
}
g_one_arm() {
    local n line
    n="$(noncomment "$1" | grep -c -- '--arm')"
    [[ "$n" == "1" ]] || return 1
    # Strip the leading indent and everything from the first redirection onward: the real
    # call site ends in `> ... 2> ...`, and that is not part of the argv being asserted.
    line="$(noncomment "$1" | grep -- '--arm' \
        | sed 's/^[[:space:]]*//; s/[[:space:]]*[0-9]*>.*$//; s/[[:space:]]*$//')"
    [[ "$line" == '"$PR_CYCLE_TRIAGE_CMD" --arm' ]]
}
g_no_bucket_cond() {
    # _bucket_emoji is a display-mapping function; exclude its body from the guard.
    # The guard still catches bucket-conditional logic outside that function. The your-turn
    # grouping awk is the second exempt span: it sorts rows into display groups and decides
    # nothing about arming (it starts at the yt-g cleanup line and ends at its print redirect).
    ! noncomment "$1" \
        | awk '/^_bucket_emoji\(\)[[:space:]]*\{/{skip=1; next} skip && /^\}[[:space:]]*$/{skip=0; next} skip{next} /rm -f .*yt-g\[1-4\]/{gskip=1; next} gskip && /print > \(d "\/yt-g"/{gskip=0; next} gskip{next} {print}' \
        | grep -qE 'FEAT-AWAITING-SIGNOFF|PIPELINE-HELD|UNCLEARED|[^-A-Z_]HELD[^-A-Z_]'
}
# Sibling of g_no_bucket_cond: both of its awk skip spans must open AND close. If the closing
# line (`}` of _bucket_emoji, or the yt-g print redirect) is reworded, the skip stays open to
# EOF and g_no_bucket_cond silently stops checking the rest of the file.
g_bucket_spans_close() {
    noncomment "$1" \
        | awk '/^_bucket_emoji\(\)[[:space:]]*\{/{skip=1; next} skip && /^\}[[:space:]]*$/{skip=0; next} skip{next} /rm -f .*yt-g\[1-4\]/{gskip=1; next} gskip && /print > \(d "\/yt-g"/{gskip=0; next} gskip{next} END{exit (skip || gskip) ? 1 : 0}'
}
g_no_sleep()       { ! noncomment "$1" | grep -qE '(^|[^A-Za-z_])sleep[[:space:]]'; }
g_no_poll()        { ! noncomment "$1" | grep -qE -- '--json state|_poll_merge|_reconcile'; }
g_one_ready()      { [[ "$(noncomment "$1" | grep -cE '"\$PR_CYCLE_READY_CMD" --pr-list ')" == 1 ]] \
                       && ! noncomment "$1" | grep -qE '"\$PR_CYCLE_READY_CMD" --pr[[:space:]]'; }
g_no_timeout_grep(){ ! noncomment "$1" | grep -qF 'TIMED OUT waiting for'; }
g_cmd_prefix() {
    ! noncomment "$1" | grep -E '^[A-Z_]+_CMD=' | grep -qv '^PR_CYCLE_'
}
# The merge-digest DM is built by .github/workflows/merge-digest-notify.yml from the sticky
# comment, not by this driver. If `--json title,url,comments` reappears here, a second digest
# reader has grown back inside pr-cycle and the fixture surface deleted in this PR is needed
# again -- fail loudly rather than let the two drift.
g_no_digest_fetch() {
    ! grep -q -- '--json title,url,comments' "$1"
}
# --only/--skip scope SELECTION, never ACCOUNTING. _pr_allowed must not appear anywhere
# between _arm_and_classify and _report_dry_run — that span holds the arm call, the merge
# poll, the ledgered.txt bookkeeping and the MERGES counter. Filtering there would uncap
# --max-merges (one blanket --arm arms out-of-set PRs too) and lose confirmed merges for PRs
# that really merged.
# Comment lines are BLANKED rather than deleted so the numbering still matches the file:
# the driver's own explanatory comments in that span name _pr_allowed on purpose.
g_scope_selection_only() {
    local start end bad
    start="$(grep -n '^_arm_and_classify()' "$1" | cut -d: -f1)"
    end="$(grep -n '^_report_dry_run()' "$1" | cut -d: -f1)"
    [[ -n "$start" && -n "$end" ]] || return 1
    bad="$(awk '/^[[:space:]]*#/ { print ""; next } { print }' "$1" \
        | grep -n '_pr_allowed' | cut -d: -f1 \
        | awk -v s="$start" -v e="$end" '$1 > s && $1 < e')"
    [[ -z "$bad" ]]
}
# _bucket_emoji is a pure display map in the driver. Extract its text from a driver FILE
# (header line through the first column-0 closing brace) so cases can eval it in isolation.
bucket_emoji_src() {
    awk '/^_bucket_emoji\(\)[[:space:]]*\{/ { on = 1 } on { print } on && /^\}[[:space:]]*$/ { exit }' "$1"
}
# Every bucket the map names, plus the fallback. Row = "<bucket>|<emoji>"; "|❓" is the empty string.
# PAUSED is a real pr-triage bucket with no arm today, so it pins to the fallback.
BUCKET_EMOJI_TABLE=(
    'DIRTY|🔀' 'NOT-MERGEABLE|🚫' 'BLOCKED-CHECK|❌' 'HELD|⏸' 'BLOCKED-DEP|🔗'
    'PIPELINE-HELD|🤖' 'FEAT-AWAITING-SIGNOFF|✍️' 'UNCLEARED|⚠️'
    'PAUSED|❓' 'NO-SUCH-BUCKET|❓' '|❓'
)
BUCKET_EMOJI_ARMS=8   # named (non-*) arms the table above covers
# $1 = driver file. Prints one line per mismatch; returns 1 on any mismatch or a missing function.
bucket_emoji_check() {
    local src arms
    src="$(bucket_emoji_src "$1")"
    [[ -n "$src" ]] || { echo "no _bucket_emoji() in $1"; return 1; }
    arms="$(grep -cE '^[[:space:]]+[A-Z][A-Z-]*\)' <<< "$src")"
    [[ "$arms" == "$BUCKET_EMOJI_ARMS" ]] \
        || { echo "_bucket_emoji has $arms named arms, table covers $BUCKET_EMOJI_ARMS"; return 1; }
    (
        eval "$src"
        declare -F _bucket_emoji > /dev/null || { echo "_bucket_emoji not defined after eval"; exit 1; }
        bad=0
        for row in "${BUCKET_EMOJI_TABLE[@]}"; do
            b="${row%%|*}"; want="${row#*|}"
            got="$(_bucket_emoji "$b")"
            [[ "$got" == "$want" ]] || { echo "_bucket_emoji '$b' = '$got', want '$want'"; bad=1; }
        done
        exit "$bad"
    )
}
# _bucket_emoji must stay a pure map. Allowed body lines: the header, `case "$1" in`,
# `PATTERN) printf '<text>' ;;` arms, `esac`, the closing brace, blanks and comments.
# Anything else (if, [ ], &&, a second command in an arm, a pipeline) fails the guard,
# because g_no_bucket_cond() deliberately skips this body and cannot see logic added here.
g_bucket_emoji_pure_map() {
    local src line q="'"
    local blank_re='^[[:space:]]*(#.*)?$'
    local head_re='^_bucket_emoji\(\)[[:space:]]*\{[[:space:]]*$'
    local case_re='^[[:space:]]+case "\$1" in[[:space:]]*$'
    local arm_re="^[[:space:]]+(\\*|[A-Z][A-Z-]*)\\)[[:space:]]+printf ${q}[^${q}]+${q}[[:space:]]*;;[[:space:]]*\$"
    local esac_re='^[[:space:]]+esac[[:space:]]*$'
    local close_re='^\}[[:space:]]*$'
    src="$(bucket_emoji_src "$1")"
    [[ -n "$src" ]] || return 1
    while IFS= read -r line; do
        [[ "$line" =~ $blank_re || "$line" =~ $head_re || "$line" =~ $case_re \
            || "$line" =~ $arm_re || "$line" =~ $esac_re || "$line" =~ $close_re ]] || return 1
    done <<< "$src"
    return 0
}
# end bucket_emoji helpers

begin_case
for g in g_no_merge g_no_armable_lib g_triage_pin g_one_arm g_no_bucket_cond g_bucket_spans_close \
         g_no_sleep g_no_poll g_one_ready g_no_timeout_grep \
         g_cmd_prefix g_no_digest_fetch g_scope_selection_only g_bucket_emoji_pure_map; do
    "$g" "$DRIVER" || fail "static guard $g fails against the real bin/pr-cycle"
done
# Guard 7 — both new files are executable and parse.
for f in "$DRIVER" "$SCRIPT_DIR/test-pr-cycle"; do
    [[ -x "$f" ]] || fail "$f is not executable"
    bash -n "$f" 2>/dev/null || fail "$f does not parse under bash -n"
done
end_case "case 25 static guards"

begin_case
mutant() { cp "$DRIVER" "$SCRATCH/mutant"; }
mutant; echo 'gh pr merge 101 --squash --auto' >> "$SCRATCH/mutant"
g_no_merge "$SCRATCH/mutant" && fail "vacuous: g_no_merge passed a driver that merges"
mutant; echo '"$PR_CYCLE_GH_CMD" pr  merge  101  --auto' >> "$SCRATCH/mutant"
g_no_merge "$SCRATCH/mutant" && fail "vacuous: g_no_merge passed a seamed merge with --auto"
mutant; echo '. "$ROOT/bin/lib/pr-armable.sh"' >> "$SCRATCH/mutant"
g_no_armable_lib "$SCRATCH/mutant" && fail "vacuous: g_no_armable_lib passed an armable-lib source"
mutant; sed -i.bak 's/^PR_CYCLE_TRIAGE_CMD=.*/PR_CYCLE_TRIAGE_CMD="$ROOT\/bin\/other"/' "$SCRATCH/mutant"
g_triage_pin "$SCRATCH/mutant" && fail "vacuous: g_triage_pin passed a repointed triage seam"
mutant; sed -i.bak '/"\$PR_CYCLE_TRIAGE_CMD" --arm /d' "$SCRATCH/mutant"
g_one_arm "$SCRATCH/mutant" && fail "vacuous: g_one_arm passed a driver with no arm call"
mutant; sed -i.bak 's/" --arm >/" --arm --force >/' "$SCRATCH/mutant"
g_one_arm "$SCRATCH/mutant" && fail "vacuous: g_one_arm passed an arm call with an extra flag"
mutant; echo 'if [ "$BUCKET" = "FEAT-AWAITING-SIGNOFF" ]; then :; fi' >> "$SCRATCH/mutant"
g_no_bucket_cond "$SCRATCH/mutant" && fail "vacuous: g_no_bucket_cond passed a sign-off conditional"
mutant; echo 'if [ "$B" = "HELD" ]; then :; fi' >> "$SCRATCH/mutant"
g_no_bucket_cond "$SCRATCH/mutant" && fail "vacuous: g_no_bucket_cond passed a bare HELD conditional"
# Span-close mutants: reword each closing line so the awk skip stays open to EOF.
mutant; sed -i.bak 's|print > (d "/yt-g"|print >> (d "/yt-g"|' "$SCRATCH/mutant"
g_bucket_spans_close "$SCRATCH/mutant" && fail "vacuous: g_bucket_spans_close passed an unclosed yt-g span"
# Reword every column-0 closing brace so no `}` can end the _bucket_emoji skip.
sed 's/^}[[:space:]]*$/ };/' "$DRIVER" > "$SCRATCH/mutant"
g_bucket_spans_close "$SCRATCH/mutant" && fail "vacuous: g_bucket_spans_close passed an unclosed _bucket_emoji span"
mutant; echo 'sleep 1' >> "$SCRATCH/mutant"
g_no_sleep "$SCRATCH/mutant" && fail "vacuous: g_no_sleep passed a driver with sleep"
mutant; echo '_poll_merge 1' >> "$SCRATCH/mutant"
g_no_poll "$SCRATCH/mutant" && fail "vacuous: g_no_poll passed a driver with _poll_merge"
mutant; echo '"$PR_CYCLE_READY_CMD" --pr-list 1 --go' >> "$SCRATCH/mutant"
g_one_ready "$SCRATCH/mutant" && fail "vacuous: g_one_ready passed a driver with two --pr-list calls"
mutant; echo '"$PR_CYCLE_READY_CMD" --pr 1 --go' >> "$SCRATCH/mutant"
g_one_ready "$SCRATCH/mutant" && fail "vacuous: g_one_ready passed a driver with --pr call"
mutant; echo "grep -qF 'TIMED OUT waiting for' x" >> "$SCRATCH/mutant"
g_no_timeout_grep "$SCRATCH/mutant" && fail "vacuous: g_no_timeout_grep passed a driver with TIMED OUT grep"
mutant; echo 'TRIAGE_CMD="${TRIAGE_CMD:-x}"' >> "$SCRATCH/mutant"
g_cmd_prefix "$SCRATCH/mutant" && fail "vacuous: g_cmd_prefix passed an unprefixed *_CMD seam"
mutant; echo '# --json title,url,comments' >> "$SCRATCH/mutant"
g_no_digest_fetch "$SCRATCH/mutant" && fail "vacuous: g_no_digest_fetch passed a digest comment fetch"
# Appending cannot test this one — the guard is region-scoped, so the mutation has to land
# INSIDE _arm_and_classify. awk inserts the line right after the function header.
awk '/^_arm_and_classify\(\) \{/ { print; print "    _pr_allowed \"$1\" || return 0"; next } { print }' \
    "$DRIVER" > "$SCRATCH/mutant"
g_scope_selection_only "$SCRATCH/mutant" \
    && fail "vacuous: g_scope_selection_only passed a scope filter inside _arm_and_classify"
# _bucket_emoji mutants. Appending cannot test these: the guard reads only the function body,
# so each mutation lands inside it (awk after the header, or sed on one arm line).
awk '/^_bucket_emoji\(\) \{/ { print; print "    if [ \"$1\" = HELD ]; then printf x; return; fi"; next } { print }' \
    "$DRIVER" > "$SCRATCH/mutant"
grep -q 'then printf x; return; fi' "$SCRATCH/mutant" || fail "mutant did not land: if inside _bucket_emoji"
g_bucket_emoji_pure_map "$SCRATCH/mutant" \
    && fail "vacuous: g_bucket_emoji_pure_map passed an if inside _bucket_emoji"
mutant; sed -i.bak '/^[[:space:]]*HELD)/s/ ;;$/; echo held >\&2 ;;/' "$SCRATCH/mutant"
grep -q 'echo held >&2 ;;' "$SCRATCH/mutant" || fail "mutant did not land: second command in HELD arm"
g_bucket_emoji_pure_map "$SCRATCH/mutant" \
    && fail "vacuous: g_bucket_emoji_pure_map passed a second command in an arm"
mutant; sed -i.bak 's/^_bucket_emoji()/_bucket_emoji_gone()/' "$SCRATCH/mutant"
g_bucket_emoji_pure_map "$SCRATCH/mutant" \
    && fail "vacuous: g_bucket_emoji_pure_map passed a driver with no _bucket_emoji"
bucket_emoji_check "$SCRATCH/mutant" > /dev/null \
    && fail "vacuous: bucket_emoji_check passed a driver with no _bucket_emoji"
mutant; sed -i.bak '/^[[:space:]]*NOT-MERGEABLE)/d' "$SCRATCH/mutant"
grep -q 'NOT-MERGEABLE)' "$SCRATCH/mutant" && fail "mutant did not land: NOT-MERGEABLE arm still present"
bucket_emoji_check "$SCRATCH/mutant" > /dev/null \
    && fail "vacuous: bucket_emoji_check passed a driver with the NOT-MERGEABLE arm deleted"
mutant; sed -i.bak "/^[[:space:]]*DIRTY)/s/printf '[^']*'/printf 'X'/" "$SCRATCH/mutant"
grep -qE "DIRTY\)[[:space:]]+printf 'X'" "$SCRATCH/mutant" || fail "mutant did not land: DIRTY wrong value"
bucket_emoji_check "$SCRATCH/mutant" > /dev/null \
    && fail "vacuous: bucket_emoji_check passed a wrong DIRTY emoji"
end_case "case 26 guards are not vacuous"

# ==========================================================================================
# 27 — the pr-ready skip needs BOTH ARMABLE and a current READY verdict
# ==========================================================================================
# 27a (Case A) — both conditions hold: ARMABLE, and a sticky verdict whose recorded
# reviewed tree still equals the head's tree and whose verdict line reads READY. The
# readying session is declined and the PR still proceeds through arming, polling and the
# merge count.
begin_case
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 ARMABLE armed" > "$SCRATCH/triage-out"
echo MERGED > "$SCRATCH/state-101"
install_verdict 101 "$TREE_A"
run --worker
[[ $RC -eq 0 ]] || fail "ARMABLE+READY skip: exit $RC, want 0"
[[ "$(calls ready)" == "0" ]] \
    || fail "ARMABLE+READY skip: pr-ready ran $(calls ready) time(s), want 0"
grep -qF '#101 — already ARMABLE with a current READY verdict, skipping pr-ready' <<< "$OUT" \
    || fail "ARMABLE+READY skip: the skip log line is missing"
[[ "$(arm_calls)" == "1" ]] || fail "ARMABLE+READY skip: want 1 arm, got $(arm_calls)"
grep -qx '101' "$(rundir)/armed.txt" \
    || fail "ARMABLE+READY skip: 101 should be in armed.txt"

# 27b (Case B) — THE REGRESSION THIS CASE EXISTS FOR. ARMABLE with NO verdict comment at
# all must still run pr-ready. This is the modal path, not a corner: ARMABLE is reachable
# on a PR /pr-ready has never touched, because `pr_manual_testing_clearance` greps the PR
# *body* for "No manual testing needed" and `/post-plan` writes that sentinel when it
# opens the PR. A bucket-only skip would decline the readying session on exactly the PRs
# that have never had one.
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 ARMABLE armed" > "$SCRATCH/triage-out"
run --worker
[[ $RC -eq 0 ]] || fail "ARMABLE, no verdict: exit $RC, want 0"
[[ "$(calls ready)" == "1" ]] \
    || fail "ARMABLE with no verdict comment skipped pr-ready: $(calls ready) ready call(s), want 1"
grep -qF '#101 — ARMABLE but no current READY verdict, running pr-ready' <<< "$OUT" \
    || fail "ARMABLE, no verdict: the run-anyway log line is missing"
[[ "$(arm_calls)" == "1" ]] || fail "ARMABLE, no verdict: want 1 arm, got $(arm_calls)"

# 27c (Case C) — a non-ARMABLE pre-read leaves the readying session untouched, and never
# reaches the verdict pre-read at all.
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 NEEDS-WORK rebase" > "$SCRATCH/triage-out"
install_verdict 101 "$TREE_A"
run --worker
[[ "$(calls ready)" == "1" ]] || fail "non-ARMABLE: want 1 ready call, got $(calls ready)"
grep -qF 'skipping pr-ready' <<< "$OUT" && fail "non-ARMABLE: the skip fired anyway"
grep -qF 'no current READY verdict' <<< "$OUT" \
    && fail "non-ARMABLE: the verdict pre-read ran despite the bucket short-circuit"

# 27d (Case D) — the skip sets no HALT and breaks no loop: three ARMABLE PRs, each with a
# current READY verdict, are all reached, all armed, and none of them ever runs pr-ready.
reset_state
printf '%s' "$ATTACK_3PR" > "$SCRATCH/attack-out"
triage_report "101 ARMABLE armed" "102 ARMABLE armed" "103 ARMABLE armed" \
    > "$SCRATCH/triage-out"
for p in 101 102 103; do install_verdict "$p" "$TREE_A"; done
run --worker
[[ $RC -eq 0 ]] || fail "three skips: exit $RC, want 0"
[[ "$(calls ready)" == "0" ]] || fail "three skips: pr-ready ran $(calls ready) time(s), want 0"
for p in 101 102 103; do
    grep -qF "#$p — already ARMABLE with a current READY verdict, skipping pr-ready" <<< "$OUT" \
        || fail "three skips: no skip line for #$p"
done
[[ "$(arm_calls)" == "1" ]] || fail "three skips: want 1 arm, got $(arm_calls)"
grep -qE 'armed 3[^0-9]' <<< "$OUT" || fail "three skips: want armed count 3 in summary"
# Precheck is cached: 3 ARMABLE+READY PRs produce exactly 1 plain triage call (cached
# precheck) + 1 --arm call = 2 total. Without the cache, 3 plain calls + 1 arm = 4.
[[ "$(calls triage)" == "2" ]] \
    || fail "three skips: want 2 triage calls (1 cached precheck + 1 arm), got $(calls triage)"
end_case "case 27 skip requires ARMABLE and a current READY verdict"

# ==========================================================================================
# 28 — the skip's opt-out and its fail-toward-running-pr-ready paths
# ==========================================================================================
# Every case below stages a verdict that WOULD authorise the skip, then breaks exactly one
# thing. Without that staging a case would pass for the wrong reason — the skip declining
# because no verdict exists rather than because of the fault under test.
#
# 28a — the rejected form: PR_CYCLE_SKIP_READY_WHEN_ARMABLE=0 restores the old behaviour.
begin_case
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 ARMABLE armed" > "$SCRATCH/triage-out"
install_verdict 101 "$TREE_A"
SKIPARM=0 run --worker
[[ $RC -eq 0 ]] || fail "opt-out: exit $RC, want 0"
[[ "$(calls ready)" == "1" ]] || fail "opt-out: want 1 ready call, got $(calls ready)"
grep -qF 'skipping pr-ready' <<< "$OUT" && fail "opt-out: the skip fired with the seam at 0"

# 28b — an empty seam behaves exactly like an unset one, i.e. the skip stays ON. This is
# what pins the driver's test to `!= "0"`; a `= "1"` test would fail here.
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 ARMABLE armed" > "$SCRATCH/triage-out"
install_verdict 101 "$TREE_A"
SKIPARM="" run --worker
[[ "$(calls ready)" == "0" ]] \
    || fail "empty seam disabled the skip: $(calls ready) ready call(s), want 0"
unset SKIPARM

# 28c — a non-zero exit from the bucket pre-read falls through to pr-ready, sets no HALT,
# and lets the iteration finish. Only call 1 (the pre-read) fails; the arm still succeeds.
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 ARMABLE armed" > "$SCRATCH/triage-out"
install_verdict 101 "$TREE_A"
echo 2 > "$SCRATCH/triage-rc-1"
run --worker
[[ $RC -eq 0 ]] || fail "pre-read failure: exit $RC, want 0"
[[ "$(calls ready)" == "1" ]] || fail "pre-read failure did not fall through to pr-ready"
grep -qF 'skipping pr-ready' <<< "$OUT" && fail "pre-read failure still skipped"
[[ "$(arm_calls)" == "1" ]] || fail "pre-read failure cost the arm call"

# 28d — a report that carries no row for this PR reads as an empty bucket, so pr-ready runs.
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "999 ARMABLE armed" > "$SCRATCH/triage-out"
install_verdict 101 "$TREE_A"
run --worker
[[ "$(calls ready)" == "1" ]] || fail "absent row: want 1 ready call, got $(calls ready)"
grep -qF 'skipping pr-ready' <<< "$OUT" && fail "absent row still skipped"

# 28e — boundary: the PR column is matched whole, so #1010's row must not satisfy #101.
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "1010 ARMABLE armed" "101 NEEDS-WORK rebase" > "$SCRATCH/triage-out"
install_verdict 101 "$TREE_A"
run --worker
[[ "$(calls ready)" == "1" ]] || fail "prefix row: #1010 was read as #101's bucket"
grep -qF 'skipping pr-ready' <<< "$OUT" && fail "prefix row triggered the skip"

# 28f — STALE VERDICT. The comment says READY, but the tree it names is not the head's
# tree any more. The sticky comment is edited in place and so renders at its original
# timeline position above every commit that has landed since, which is why "the comment
# says READY" is not on its own a live signal. Observed on PR #2160: recorded tree
# f95a5675…, head tree 8857bf91….
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 ARMABLE armed" > "$SCRATCH/triage-out"
install_verdict 101 "$TREE_A" "$TREE_B"
run --worker
[[ $RC -eq 0 ]] || fail "stale verdict: exit $RC, want 0"
[[ "$(calls ready)" == "1" ]] \
    || fail "a verdict for a superseded tree authorised the skip: $(calls ready) ready call(s), want 1"
grep -qF 'no current READY verdict' <<< "$OUT" || fail "stale verdict: wrong log line"

# 28g — a NOT READY verdict with a matching tree does not authorise the skip.
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 ARMABLE armed" > "$SCRATCH/triage-out"
install_verdict 101 "$TREE_A" "$TREE_A" '**NOT READY** — CI is red on the rebased head'
run --worker
[[ "$(calls ready)" == "1" ]] \
    || fail "a NOT READY verdict authorised the skip: $(calls ready) ready call(s), want 1"

# 28g2 — the /post-plan Phase 5.5 terminal-line recipe (_phase-5.5-fidelity.md step 4)
# emits `NOT READY — <reason>` so the comment states why the PR is held instead of a bare
# word that contradicts the remediation narrated above it. The reason is a SUFFIX precisely
# so _verdict_word's `"NOT READY"*` prefix glob still classifies it as blocking. This row
# pins that: move the reason before the word and the skip is wrongly authorised.
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 ARMABLE armed" > "$SCRATCH/triage-out"
install_verdict 101 "$TREE_A" "$TREE_A" \
    'NOT READY — all findings remediated in abc1234; no reviewer verdict covers the post-remediation tree, so auto-merge stays held. Re-run /post-plan to clear.'
run --worker
[[ "$(calls ready)" == "1" ]] \
    || fail "a NOT READY verdict with a reason suffix authorised the skip: $(calls ready) ready call(s), want 1"

# 28g3 — the same recipe's READY WITH NOTES rows also carry a reason suffix. `READY WITH
# NOTES` has always authorised the skip (the pre-recipe step-6 template hardcoded that exact
# bare word), and that is correct: the fidelity reviewer's `READY WITH NOTES` means no
# BLOCKING finding, so an unremediated note is not a hold. This row pins that the added
# suffix does not change that classification either way.
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 ARMABLE armed" > "$SCRATCH/triage-out"
install_verdict 101 "$TREE_A" "$TREE_A" \
    'READY WITH NOTES — all notes remediated in abc1234; reviewer verdict covers tree '"$TREE_A"
run --worker
[[ "$(calls ready)" == "0" ]] \
    || fail "READY WITH NOTES with a reason suffix did not authorise the skip: $(calls ready) ready call(s), want 0"

# 28h — a verdict comment with no `**Reviewed tree:**` contract line on line 1 cannot be
# checked for currency, so it does not authorise the skip. This is every verdict written
# before that line existed, which is why the skip is expected to be rare at first.
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 ARMABLE armed" > "$SCRATCH/triage-out"
# A sticky verdict comment with NO `**Reviewed tree:**` contract line on line 1. Inlined
# here because this is the last case that needs such a body; the shared digest fixture it
# used to borrow now lives in bin/test-digest-dm-build.
printf '{"comments":[{"body":%s}],"headRefOid":"%s"}' \
    "$(printf '%s\n' '<!-- pr-ready-verdict -->' 'Verdict: green.' | jq -Rs .)" \
    "deadbeefcafe$(printf '%028d' 101)" \
    > "$SCRATCH/verdictview-101.json"
printf '%s\n' "$TREE_A" > "$SCRATCH/tree-deadbeefcafe$(printf '%028d' 101)"
run --worker
[[ "$(calls ready)" == "1" ]] \
    || fail "a verdict with no reviewed-tree line authorised the skip: want 1 ready call"

# 28i — the head-tree lookup failing (no fixture for the oid = gh api exits non-zero) is a
# degrade, not a licence to skip, and it costs neither the arm nor the exit code.
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 ARMABLE armed" > "$SCRATCH/triage-out"
install_verdict 101 "$TREE_A"
rm -f "$SCRATCH/tree-deadbeefcafe$(printf '%028d' 101)"
run --worker
[[ $RC -eq 0 ]] || fail "tree lookup failure: exit $RC, want 0"
[[ "$(calls ready)" == "1" ]] || fail "tree lookup failure authorised the skip"
[[ "$(arm_calls)" == "1" ]] || fail "tree lookup failure cost the arm call"

# 28j — the verdict pre-read's own gh call failing degrades to running pr-ready.
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 ARMABLE armed" > "$SCRATCH/triage-out"
install_verdict 101 "$TREE_A"
: > "$SCRATCH/gh-fail-verdict"
run --worker
[[ $RC -eq 0 ]] || fail "verdict gh failure: exit $RC, want 0"
[[ "$(calls ready)" == "1" ]] || fail "verdict gh failure authorised the skip"
rm -f "$SCRATCH/gh-fail-verdict"

# 28k — the other direction, and the reason the verdict line is matched anchored: a body
# that NARRATES a superseded NOT READY finding above a final READY verdict is READY. Real
# bodies do exactly this (PRs #2144, #2160); a body-wide `grep 'NOT READY'` would reject
# every remediated PR and the skip would never fire at all. The fixture carries the
# narrating line, so this is a live assertion, not a tautology.
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
triage_report "101 ARMABLE armed" > "$SCRATCH/triage-out"
install_verdict 101 "$TREE_A" "$TREE_A" '### READY'
grep -qF 'NOT READY' "$SCRATCH/verdictview-101.json" \
    || fail "fixture regression: 28k needs a narrated NOT READY line to be meaningful"
run --worker
[[ "$(calls ready)" == "0" ]] \
    || fail "a narrated NOT READY finding blocked a READY verdict: $(calls ready) ready call(s), want 0"
end_case "case 28 skip opt-out and fail-toward-running paths"

# ==========================================================================================
# 29 — CI actually runs this harness
# ==========================================================================================
begin_case
WF="$SCRIPT_DIR/../.github/workflows/tests.yml"
if [[ -f "$WF" ]]; then
    # Listed once in the bin/run-shell-harnesses argument list (one script per line).
    [[ "$(grep -cE '^[[:space:]]+bin/test-pr-cycle( \\)?$' "$WF")" == "1" ]] \
        || fail "tests.yml does not list bin/test-pr-cycle exactly once in the harness runner"
else
    fail "workflow file not found at $WF"
fi
end_case "case 29 CI wiring"

# ==========================================================================================
# 30 — stage-1 batch argv
# ==========================================================================================
begin_case
reset_state
printf '%s' "$ATTACK_4PR" > "$SCRATCH/attack-out"
triage_report "2101 NEEDS-WORK rebase" "2102 NEEDS-WORK rebase" "2103 NEEDS-WORK rebase" \
    > "$SCRATCH/triage-out"
run --worker
[[ $RC -eq 0 ]] || fail "case 30 exit $RC, want 0"
[[ "$(calls ready)" == "1" ]] || fail "case 30: want 1 fleet call, got $(calls ready)"
[[ "$(sed -n '1p' "$SCRATCH/ready.argv")" == "--pr-list 2101,2102,2103,2104 --jobs 3 --go --wait --allow-test-only" ]] \
    || fail "case 30: argv line 1: $(sed -n '1p' "$SCRATCH/ready.argv")"

reset_state
printf '%s' "$ATTACK_4PR" > "$SCRATCH/attack-out"
triage_report "2101 NEEDS-WORK rebase" "2102 NEEDS-WORK rebase" > "$SCRATCH/triage-out"
run --worker --jobs 2
[[ "$(sed -n '1p' "$SCRATCH/ready.argv")" == "--pr-list 2101,2102,2103,2104 --jobs 2 --go --wait --allow-test-only" ]] \
    || fail "case 30 --jobs 2: argv: $(sed -n '1p' "$SCRATCH/ready.argv")"
end_case "case 30 stage-1 batch argv"

# ==========================================================================================
# 31 — stage-1 halts on fleet failure; text grep gone
# ==========================================================================================
begin_case
reset_state
printf '%s' "$ATTACK_4PR" > "$SCRATCH/attack-out"
echo 1 > "$SCRATCH/ready-rc"
run --worker
[[ $RC -eq 1 ]] || fail "case 31: fleet exit 1 should halt with 1, got $RC"
[[ "$(arm_calls)" == "0" ]] || fail "case 31: arm ran after fleet failure"
grep -qF 'stage 1' "$SCRATCH/dm.argv" || fail "case 31: DM does not mention stage 1"

# Negative twin: TIMED OUT text in stderr with exit 0 must NOT halt.
reset_state
printf '%s' "$ATTACK_4PR" > "$SCRATCH/attack-out"
triage_report "2101 NEEDS-WORK rebase" > "$SCRATCH/triage-out"
echo 'TIMED OUT waiting for 1 session(s) after 7200s; leaving them running' > "$SCRATCH/ready-err"
echo 0 > "$SCRATCH/ready-rc"
run --worker
[[ $RC -eq 0 ]] || fail "case 31 negative twin: TIMED OUT text with rc 0 should not halt, got $RC"
[[ "$(arm_calls)" == "1" ]] || fail "case 31 negative twin: arm did not run"
end_case "case 31 stage-1 halts on fleet failure"

# ==========================================================================================
# 32 — --max-ready cap
# ==========================================================================================
begin_case
reset_state
printf '%s' "$ATTACK_4PR" > "$SCRATCH/attack-out"
triage_report "2101 NEEDS-WORK rebase" "2102 NEEDS-WORK rebase" > "$SCRATCH/triage-out"
run --worker --max-ready 2
[[ $RC -eq 0 ]] || fail "case 32 exit $RC, want 0"
[[ "$(sed -n '1p' "$SCRATCH/ready.argv")" == "--pr-list 2101,2102 --jobs 3 --go --wait --allow-test-only" ]] \
    || fail "case 32 cap 2: argv: $(sed -n '1p' "$SCRATCH/ready.argv")"
run --dry-run --max-ready 2
grep -qF '2103' <<< "$OUT" && grep -qF 'max-ready cap' <<< "$OUT" \
    || fail "case 32: dry run did not list 2103 as over the cap"
grep -qF '2104' <<< "$OUT" && grep -qF 'max-ready cap' <<< "$OUT" \
    || fail "case 32: dry run did not list 2104 as over the cap"

# Boundary: --max-ready 10 with 4 rows keeps all 4.
reset_state
printf '%s' "$ATTACK_4PR" > "$SCRATCH/attack-out"
triage_report "2101 NEEDS-WORK rebase" > "$SCRATCH/triage-out"
run --worker --max-ready 10
[[ "$(sed -n '1p' "$SCRATCH/ready.argv")" == "--pr-list 2101,2102,2103,2104 --jobs 3 --go --wait --allow-test-only" ]] \
    || fail "case 32 no-cap: argv: $(sed -n '1p' "$SCRATCH/ready.argv")"
end_case "case 32 max-ready cap"

# ==========================================================================================
# 34 — single arm, no poll
# ==========================================================================================
begin_case
reset_state
printf '%s' "$ATTACK_4PR" > "$SCRATCH/attack-out"
triage_report "2101 ARMABLE auto-merge" "2102 UNCLEARED run-tests" > "$SCRATCH/triage-out"
run --worker
[[ $RC -eq 0 ]] || fail "case 34 exit $RC, want 0"
[[ "$(arm_calls)" == "1" ]] || fail "case 34: want 1 arm, got $(arm_calls)"
_state_cnt="$(grep -c -- '--json state' "$SCRATCH/gh.argv" 2>/dev/null)"
[[ "${_state_cnt:-0}" == "0" ]] || fail "case 34: state poll found; $_state_cnt calls"
[[ $RC -eq 0 ]] || fail "case 34: want RC 0, got $RC"
end_case "case 34 single arm, no poll"

