ln -s "$PDIR/plan-h2.md" "$NDIR/queue/plan-h2.md"; touch "$NDIR/queue/plan-h2.md.depends-hold"
ln -s "$PDIR/plan-fo.md" "$NDIR/queue/plan-fo.md"
printf 'forced_at: 2026-10-01T09:00:00-0700\n' > "$NDIR/queue/plan-fo.md.force-override"
before=$(find "$NDIR" | sort)
run_queue status >/dev/null 2>&1
after=$(find "$NDIR" | sort)
if [ "$before" = "$after" ]; then
    h_pass "row-status-readonly"
else
    h_fail "row-status-readonly — status changed state"
fi

setup
out=$(run_queue status --bogus 2>&1); rc=$?
if [ "$rc" -eq 1 ] && grep -qF "status takes no arguments" <<< "$out"; then
    h_pass "row-status-bogus-arg"
else
    h_fail "row-status-bogus-arg (rc=$rc): $out"
fi

setup
mkplan plan-f1.md
ln -s "$PDIR/plan-f1.md" "$NDIR/queue/plan-f1.md"
printf '2\n' > "$NDIR/queue/plan-f1.md.attempts"
out=$(run_queue 2>&1); rc=$?
if [ "$rc" -eq 0 ] && [ "$(head -1 <<< "$out")" = "Automouse queue (next to run first):" ] \
    && ! grep -qF "next:" <<< "$out"; then
    h_pass "row-status-show-queue-unchanged"
else
    h_fail "row-status-show-queue-unchanged (rc=$rc): $out"
fi

if grep -qE '^MAX_ATTEMPTS=3([[:space:]]|$)' "$SCRIPT_DIR/automouse/run"; then
    h_pass "row-max-attempts-sync"
else
    h_fail "row-max-attempts-sync — bin/automouse/run MAX_ATTEMPTS changed; update STATUS_MAX_ATTEMPTS in bin/automouse/queue"
fi

h_done
