#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-adr-check — regression test for the local pre-push ADR gate.
#
# Covers the two compositions Part C relies on:
#   1. bin/adr-check --pr --bypass-from-stdin reading the bypass body from STDIN
#      (the commit-message blob the hook pipes in), against an origin/master..HEAD
#      range built in a throwaway repo.
#   2. bin/pre-push-adr-hook driving that composition end-to-end, including the
#      origin/master-absent degrade-open path.
#
# Each case builds a temp git repo with a fake origin/master ref (no real remote
# needed: `git update-ref refs/remotes/origin/master <base>`). The repo's bin/
# gets UNTRACKED copies of adr-check + pre-push-adr-hook + bin/lib/branch-base.sh
# so REPO_ROOT resolves to the temp repo — untracked, so they never appear in
# `git diff` and can't become triggers themselves. The trigger file (bin/foo) is
# the only thing committed into bin/, so the diff sees exactly one added bin/ script.
#
# Run: bin/test-adr-check  (exit 0 = all pass, 1 = a case failed)

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BASE_TMP="$(mktemp -d)"
trap 'rm -rf "$BASE_TMP"' EXIT

FAILED=0
REPO=""
GH_DIR=""
NO_GH=""

expect() { # name want got
    if [ "$3" -eq "$2" ]; then
        echo "ok: $1 (exit $3)"
    else
        echo "FAIL: $1 — expected exit $2, got $3"
        FAILED=1
    fi
}

# new_repo <with-origin: 1|0> — create a fresh temp repo with a base commit and
# (optionally) a fake origin/master ref. Sets $REPO.
new_repo() {
    REPO="$(mktemp -d "$BASE_TMP/repo.XXXXXX")"
    mkdir -p "$REPO/bin/lib"
    cp "$SCRIPT_DIR/adr-check" "$REPO/bin/adr-check"
    cp "$SCRIPT_DIR/pre-push-adr-hook" "$REPO/bin/pre-push-adr-hook"
    cp "$SCRIPT_DIR/lib/branch-base.sh" "$REPO/bin/lib/branch-base.sh"
    chmod +x "$REPO/bin/adr-check" "$REPO/bin/pre-push-adr-hook"
    git -C "$REPO" init -q
    git -C "$REPO" config user.email test@example.com
    git -C "$REPO" config user.name "test"
    git -C "$REPO" config commit.gpgsign false
    echo base > "$REPO/README.md"
    git -C "$REPO" add README.md          # NOT bin/* — keep the bin copies untracked
    git -C "$REPO" commit -qm base
    if [ "$1" -eq 1 ]; then
        git -C "$REPO" update-ref refs/remotes/origin/master "$(git -C "$REPO" rev-parse HEAD)"
    fi
}

# add_bin_trigger <commit-message> — commit a >=50-line bin/ script with a shebang
# (the new-tool-script trigger).
add_bin_trigger() {
    printf '#!/usr/bin/env bash\n' > "$REPO/bin/foo"
    i=1
    while [ "$i" -le 60 ]; do
        echo "# line $i" >> "$REPO/bin/foo"
        i=$((i + 1))
    done
    git -C "$REPO" add bin/foo
    git -C "$REPO" commit -qm "$1"
}

# add_no_trigger — commit a plain .txt file (no trigger surface).
add_no_trigger() {
    echo "notes" > "$REPO/notes.txt"
    git -C "$REPO" add notes.txt
    git -C "$REPO" commit -qm "add notes"
}

# new_stack_repo — master -> parent -> child, with origin/master ADVANCED past the fork
# so origin/master is genuinely NOT an ancestor of child. Sets $REPO.
new_stack_repo() {
    new_repo 1
    git -C "$REPO" branch -M master
    git -C "$REPO" checkout -qb parent
    echo p > "$REPO/p.txt"; git -C "$REPO" add p.txt; git -C "$REPO" commit -qm "parent work"
    git -C "$REPO" update-ref refs/remotes/origin/parent "$(git -C "$REPO" rev-parse HEAD)"
    git -C "$REPO" checkout -q master
    echo m > "$REPO/m.txt"; git -C "$REPO" add m.txt; git -C "$REPO" commit -qm "master moves"
    git -C "$REPO" update-ref refs/remotes/origin/master "$(git -C "$REPO" rev-parse HEAD)"
    git -C "$REPO" checkout -q parent; git -C "$REPO" checkout -qb child
}

# fake_gh <answer> [<sleep-secs>] — PATH shim printing <answer> as baseRefName. Sets $GH_DIR.
fake_gh() {
    GH_DIR="$(mktemp -d "$BASE_TMP/gh.XXXXXX")"
    printf '%s\n' "$1" > "$GH_DIR/answer"
    { echo '#!/bin/sh'
      [ -n "${2:-}" ] && echo "sleep $2"
      echo 'cat "$(dirname "$0")/answer"'; } > "$GH_DIR/gh"
    chmod +x "$GH_DIR/gh"
}

run_hook_env() { # <env-assignments...> — runs the hook in $REPO with extra env
    ( cd "$REPO" && env "$@" "$REPO/bin/pre-push-adr-hook" </dev/null ) >/dev/null 2>&1
}

run_adr_check() { # runs the stdin composition inside $REPO
    ( cd "$REPO" && git log origin/master..HEAD --format='%B' \
        | "$REPO/bin/adr-check" --pr --bypass-from-stdin ) >/dev/null 2>&1
}

run_hook() { # runs the pre-push hook inside $REPO
    ( cd "$REPO" && "$REPO/bin/pre-push-adr-hook" ) >/dev/null 2>&1
}

BYPASS='<!-- no-adr: documented in an existing decision record -->'

# --- adr-check stdin composition (rows 8-9) ---

new_repo 1; add_bin_trigger "add foo tool"
run_adr_check; expect "adrcheck-trigger-no-bypass" 1 $?

new_repo 1; add_bin_trigger "add foo tool

$BYPASS"
run_adr_check; expect "adrcheck-bypass-via-stdin" 0 $?

new_repo 1; add_no_trigger
run_adr_check; expect "adrcheck-no-trigger" 0 $?

# --- pre-push hook script (rows 10-11) ---

new_repo 1; add_bin_trigger "add foo tool"
run_hook; expect "hook-trigger-no-adr" 1 $?

new_repo 1; add_no_trigger
run_hook; expect "hook-no-trigger" 0 $?

new_repo 1; add_bin_trigger "add foo tool

$BYPASS"
run_hook; expect "hook-bypass-trailer" 0 $?

# origin/master absent → degrade-open (exit 0) even with a trigger present.
new_repo 0; add_bin_trigger "add foo tool"
run_hook; expect "hook-no-origin-master" 0 $?

# --- stacked-PR base-resolution hook cases ---

# config base: no-trigger commit on child, config resolves to origin/parent, offline → pass
new_stack_repo
add_no_trigger
git -C "$REPO" config branch.child.iblBase parent
run_hook_env "BRANCH_BASE_OFFLINE=1"; expect "hook-stacked-config-base" 0 $?

# trigger on child with config base: trigger fires, no bypass → block
new_stack_repo
git -C "$REPO" config branch.child.iblBase parent
add_bin_trigger "add foo tool"
run_hook_env "BRANCH_BASE_OFFLINE=1"; expect "hook-stacked-trigger-still-blocks" 1 $?

# bypass marker in commit message: trigger fires but bypass honoured → pass
new_stack_repo
git -C "$REPO" config branch.child.iblBase parent
printf '#!/usr/bin/env bash\n' > "$REPO/bin/foo2"
i=1; while [ "$i" -le 60 ]; do echo "# line $i" >> "$REPO/bin/foo2"; i=$((i + 1)); done
git -C "$REPO" add bin/foo2
git -C "$REPO" commit -qm "add tool
<!-- no-adr: stacked PR uses parent base no ADR needed -->"
run_hook_env "BRANCH_BASE_OFFLINE=1"; expect "hook-stacked-bypass-honoured" 0 $?

# empty range: child has no commits beyond parent, config resolves base → pass
new_stack_repo
git -C "$REPO" config branch.child.iblBase parent
run_hook_env "BRANCH_BASE_OFFLINE=1"; expect "hook-stacked-empty-range" 0 $?

# parent branch not rebased onto master, no config, offline → block
new_stack_repo
git -C "$REPO" checkout -q parent
run_hook_env "BRANCH_BASE_OFFLINE=1"; expect "hook-behind-master-blocks" 1 $?

# child branch, no config, offline → unresolvable → block
new_stack_repo
run_hook_env "BRANCH_BASE_OFFLINE=1"; expect "hook-unresolvable-blocks" 1 $?

# stale config pointing at master (non-ancestor of child) → D6 rejects → block
new_stack_repo
git -C "$REPO" config branch.child.iblBase master
run_hook_env "BRANCH_BASE_OFFLINE=1"; expect "hook-stale-config-master-blocks" 1 $?

# missing branch-base.sh → fail-closed
new_stack_repo
git -C "$REPO" config branch.child.iblBase parent
rm "$REPO/bin/lib/branch-base.sh"
run_hook_env "BRANCH_BASE_OFFLINE=1"; expect "hook-missing-lib-blocks" 1 $?

# gh resolves base: no config, fake_gh returns "parent", offline unset → pass
new_stack_repo
fake_gh parent
run_hook_env "PATH=$GH_DIR:$PATH"; expect "hook-gh-resolves-base" 0 $?

# BRANCH_BASE_OFFLINE empty (not "1") → gh still called → resolves → pass
new_stack_repo
fake_gh parent
run_hook_env "PATH=$GH_DIR:$PATH" "BRANCH_BASE_OFFLINE="; expect "hook-gh-offline-empty-still-calls-gh" 0 $?

# BRANCH_BASE_OFFLINE=1 → gh skipped → unresolvable → block
new_stack_repo
fake_gh parent
run_hook_env "PATH=$GH_DIR:$PATH" "BRANCH_BASE_OFFLINE=1"; expect "hook-gh-offline-one-skips-gh" 1 $?

# hostile baseRefName from gh: starts with "--" → validation rejects → block
new_stack_repo
fake_gh "--upload-pack=evil"
run_hook_env "PATH=$GH_DIR:$PATH"; expect "hook-gh-hostile-baserefname" 1 $?

# injection: gh returns shell-metachar string; must not exec it, sentinel absent
new_stack_repo
fake_gh "p;touch $BASE_TMP/pwned"
run_hook_env "PATH=$GH_DIR:$PATH"; ex=$?
expect "hook-gh-injection-no-exec" 1 "$ex"
[ ! -e "$BASE_TMP/pwned" ] || { echo "FAIL: hook-gh-injection-no-exec — sentinel created"; FAILED=1; }

# timeout: fake_gh sleeps 30s; hook must exit within 15s total
new_stack_repo
fake_gh parent 30
start=$SECONDS
run_hook_env "PATH=$GH_DIR:$PATH"; expect "hook-gh-timeout-bounded" 1 $?
elapsed=$(( SECONDS - start ))
if [ "$elapsed" -lt 15 ]; then
    echo "ok: hook-gh-timeout-bounded-elapsed (${elapsed}s < 15)"
else
    echo "FAIL: hook-gh-timeout-bounded-elapsed — took ${elapsed}s (expected < 15)"
    FAILED=1
fi

# --- adrcheck --base=<ref> flag cases ---

# Shared setup: trigger on parent branch, origin/parent advanced, child merges parent.
# A null gh shim prevents any accidental call to the real gh binary.
NO_GH="$(mktemp -d "$BASE_TMP/nogh.XXXXXX")"
printf '#!/bin/sh\nexit 1\n' > "$NO_GH/gh"; chmod +x "$NO_GH/gh"

new_stack_repo
git -C "$REPO" checkout -q parent
printf '#!/usr/bin/env bash\n' > "$REPO/bin/foo"
i=1; while [ "$i" -le 60 ]; do echo "# line $i" >> "$REPO/bin/foo"; i=$((i + 1)); done
git -C "$REPO" add bin/foo
git -C "$REPO" commit -qm "add foo tool"
git -C "$REPO" update-ref refs/remotes/origin/parent "$(git -C "$REPO" rev-parse HEAD)"
git -C "$REPO" checkout -q child
git -C "$REPO" merge -q parent -m merge

( cd "$REPO" && PATH="$NO_GH:$PATH" "$REPO/bin/adr-check" --pr --base=origin/parent ) >/dev/null 2>&1
expect "adrcheck-base-parent-clean" 0 $?

( cd "$REPO" && PATH="$NO_GH:$PATH" "$REPO/bin/adr-check" --pr --base=origin/master ) >/dev/null 2>&1
expect "adrcheck-base-master-trips" 1 $?

( cd "$REPO" && PATH="$NO_GH:$PATH" "$REPO/bin/adr-check" --base=origin/parent --pr ) >/dev/null 2>&1
expect "adrcheck-base-order-swapped" 0 $?

( cd "$REPO" && PATH="$NO_GH:$PATH" "$REPO/bin/adr-check" --pr --base origin/parent ) >/dev/null 2>&1
expect "adrcheck-base-space-form" 2 $?

( cd "$REPO" && PATH="$NO_GH:$PATH" "$REPO/bin/adr-check" --pr --base= ) >/dev/null 2>&1
expect "adrcheck-base-empty" 2 $?

( cd "$REPO" && PATH="$NO_GH:$PATH" "$REPO/bin/adr-check" --pr --base=-x ) >/dev/null 2>&1
expect "adrcheck-base-leading-dash" 2 $?

( cd "$REPO" && PATH="$NO_GH:$PATH" "$REPO/bin/adr-check" --pr --base=a..b ) >/dev/null 2>&1
expect "adrcheck-base-dotdot" 2 $?

( cd "$REPO" && PATH="$NO_GH:$PATH" "$REPO/bin/adr-check" --staged --base=origin/parent ) >/dev/null 2>&1
expect "adrcheck-base-with-staged" 2 $?

# staged mode with a non-trigger file: no triggers → pass
new_repo 1
echo "plain" > "$REPO/notes.txt"
git -C "$REPO" add notes.txt
( cd "$REPO" && "$REPO/bin/adr-check" --staged ) >/dev/null 2>&1
expect "adrcheck-staged-unchanged" 0 $?

# --- install-git-hooks idempotency + backup-once ---
# install-git-hooks resolves the hooks dir from cwd's git (--git-common-dir), so
# running the worktree copy inside $REPO targets $REPO/.git/hooks. Seed a fake
# non-shim pre-push (the default git-lfs hook) and assert it is backed up once and
# replaced by our sentinel shim, idempotently.
ok_check() { # name condition-already-evaluated($?-style via [ ])
    if [ "$2" -eq 0 ]; then echo "ok: $1"; else echo "FAIL: $1"; FAILED=1; fi
}

new_repo 1
printf '#!/bin/sh\n# original git-lfs hook\ngit lfs pre-push "$@"\n' > "$REPO/.git/hooks/pre-push"
chmod +x "$REPO/.git/hooks/pre-push"
( cd "$REPO" && "$SCRIPT_DIR/install-git-hooks" ) >/dev/null 2>&1
grep -qF '# IBL5-ADR-HOOK' "$REPO/.git/hooks/pre-push"; ok_check "install-writes-shim" $?
grep -qF 'original git-lfs hook' "$REPO/.git/hooks/pre-push.pre-adr.bak" 2>/dev/null; ok_check "install-backs-up-original-once" $?

# Re-run: still our shim, backup unchanged (no second overwrite), exits clean.
( cd "$REPO" && "$SCRIPT_DIR/install-git-hooks" ) >/dev/null 2>&1; reinstall_exit=$?
ok_check "install-rerun-clean-exit" "$reinstall_exit"
grep -qF '# IBL5-ADR-HOOK' "$REPO/.git/hooks/pre-push"; ok_check "install-idempotent-shim" $?
grep -qF 'original git-lfs hook' "$REPO/.git/hooks/pre-push.pre-adr.bak" 2>/dev/null; ok_check "install-backup-preserved" $?

if [ "$FAILED" -ne 0 ]; then
    echo "RESULT: FAILED"
    exit 1
fi
echo "RESULT: all passed"
exit 0
