ln -s "$PDIR/plan-s1.md" "$NDIR/skipped/plan-s1.md"
touch "$NDIR/skipped/plan-s1.md.staleness"
out=$(run_queue status 2>&1); rc=$?
st_check "row-status-skipped-stale" "$rc" "$out" '^skipped +plan-s1 +next: fix the stale path in the plan, then bin/automouse/self-heal$'

