SKIPIN="$SCRATCH/skip-notes-in.tsv"
# dm.argv joins the DM's lines with spaces, so row order is checked with an ordered glob.

# 1: tick notes become a Skipped block, ordered stacked, over-cap, then low-value.
begin_case
