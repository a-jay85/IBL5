# ── cause_usage_limit_clock_form ──────────────────────────────────────────────
srt_reset; srt_claim42
printf "You've hit your limit · resets 3pm (America/Los_Angeles)\n" > "$STUB/agent-output"
srt_now=$(date +%s)
srt_run
srt_reset_e=$(sed -n 's/.*--cause=usage_limit --reset=\([0-9][0-9]*\).*/\1/p' "$STUB/ssh.log" | sed -n '1p')
srt_in_window=no
if [ -n "$srt_reset_e" ] && [ "$srt_reset_e" -gt "$srt_now" ] \
   && [ "$srt_reset_e" -le $((srt_now + 86400 + 60)) ]; then
    srt_in_window=yes
fi
srt_expect_eq "cause_usage_limit_clock_form — reset inside (now, now+24h]" yes "$srt_in_window"
# Same platform test as the tick: BSD `date -r`, then GNU `date -d @E`.
srt_la=$(TZ=America/Los_Angeles date -r "${srt_reset_e:-0}" +%H:%M 2>/dev/null \
    || TZ=America/Los_Angeles date -d "@${srt_reset_e:-0}" +%H:%M 2>/dev/null)
srt_expect_eq "cause_usage_limit_clock_form — renders 15:00 in America/Los_Angeles" "15:00" "$srt_la"

