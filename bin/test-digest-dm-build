#!/usr/bin/env bash
# test-digest-dm-build — contract harness for bin/digest-dm-build.
#
# Rehomed from bin/test-pr-cycle cases 30/31/32 when the ~/IBL5-merge-digest.md ledger
# was replaced by a per-merge Discord DM. Those cases exist because the pr-cycle suite
# once stayed green while every live ledger row read `digest: unavailable` — the parse
# contract needs a producer-driven round trip, not just hand-written fixtures.
#
# Usage: bin/test-digest-dm-build
#
# No network, no gh, no Discord. Everything is stdin fixtures plus one real invocation
# of .claude/review-shared/scripts/digest.sh (the producer).

set -uo pipefail
# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"
H_FAIL_FD=2  # FAIL: lines stay on stderr, as before migration

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DRIVER="$SCRIPT_DIR/digest-dm-build"
PRODUCER="$ROOT/.claude/review-shared/scripts/digest.sh"

SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/tddb.XXXXXX")"
trap 'rm -rf "$SCRATCH"; h_cleanup' EXIT

# Same UTF-8 locale selection as the driver, so ${#v} counts characters here too.
for _l in C.UTF-8 C.utf8 en_US.UTF-8 en_US.utf8; do
    case "$(locale -a 2>/dev/null || true)" in
        *"$_l"*) export LC_ALL="$_l"; break ;;
    esac
done

CASE=""
begin_case() { CASE="$1"; }
ok()   { h_pass "$CASE"; }
fail() { h_fail "[$CASE] $1"; }
want() { case "$2" in *"$3"*) ok ;; *) fail "$1: expected to contain <<$3>>, got <<$2>>" ;; esac; }
wantnot() { case "$2" in *"$3"*) fail "$1: expected NOT to contain <<$3>>" ;; *) ok ;; esac; }
eq()   { [ "$2" = "$3" ] && ok || fail "$1: want <<$3>>, got <<$2>>"; }

# run <stdin-file> [extra args...] -> OUT, RC
run() {
    local _in="$1"; shift
    OUT="$(bash "$DRIVER" --pr-number 2200 --title 'Fix the thing' \
            --url 'https://github.com/o/r/pull/2200' "$@" < "$_in" 2>"$SCRATCH/err")"
    RC=$?
    # Captured so a failing case can be debugged by inspecting $ERR interactively.
    # shellcheck disable=SC2034
    ERR="$(cat "$SCRATCH/err")"
}

[ -f "$DRIVER" ]   || { echo "STOP: no driver at $DRIVER" >&2; exit 1; }
[ -f "$PRODUCER" ] || { echo "STOP: no producer at $PRODUCER" >&2; exit 1; }

# ---------------------------------------------------------------------------
# 1 — the production shape: bare-bold labels, as digest.sh emits them.
# ---------------------------------------------------------------------------
begin_case "1 bare-bold digest"
cat > "$SCRATCH/f1" <<'FIX'
**Reviewed tree:** 0123456789abcdef0123456789abcdef01234567
`covers head aaaaaaaaaaaa · master bbbbbbbbbbbb · written 2026-09-15T00:00Z`

### Rebase
Rebased onto master, no conflicts.

### Merge digest
**What changed:** Replaced the ledger with a DM.
**Why:** The ledger covered 11% of merges.
**Watch:** The first real DM after merge.
**Touches:** bin/pr-cycle, .github/workflows/
**Machine-authored fixes:** none

### Remediation
Nothing.

<!-- pr-ready-verdict -->
FIX
run "$SCRATCH/f1"
eq "exit 0" "$RC" "0"
want "header"       "$OUT" '**Merged [#2200](<https://github.com/o/r/pull/2200>): Fix the thing**'
want "what changed" "$OUT" '**What changed:** Replaced the ledger with a DM.'
want "watch"        "$OUT" '**Watch:** The first real DM after merge.'
want "url"          "$OUT" '(<https://github.com/o/r/pull/2200>)'
wantnot "no bare url line" "$(printf '%s\n' "$OUT" | grep -x 'https://github.com/o/r/pull/2200' || true)" 'https'
wantnot "no Why"        "$OUT" '**Why:**'
wantnot "no Touches"    "$OUT" '**Touches:**'
wantnot "no tree line"  "$OUT" 'Reviewed tree'
wantnot "no provenance" "$OUT" 'covers head'

# ---------------------------------------------------------------------------
# 2 — bulleted labels parse identically (the ledger-era shape).
# ---------------------------------------------------------------------------
begin_case "2 bulleted digest"
cat > "$SCRATCH/f2" <<'FIX'
### Merge digest
- **What changed:** Bulleted value.
- **Watch:** Bulleted watch.
FIX
run "$SCRATCH/f2"
want "bulleted what"  "$OUT" '**What changed:** Bulleted value.'
want "bulleted watch" "$OUT" '**Watch:** Bulleted watch.'

# ---------------------------------------------------------------------------
# 3 — a horizontal rule terminates the block (PRs #2092/#2084 shipped ` ---`
#     folded onto the last value before this branch existed).
# ---------------------------------------------------------------------------
begin_case "3 HR terminator"
cat > "$SCRATCH/f3" <<'FIX'
### Merge digest
**What changed:** Value one.
**Watch:** Value two.

---

Trailing prose that must never be folded in.
FIX
run "$SCRATCH/f3"
eq "watch is clean" "$(printf '%s\n' "$OUT" | grep -c 'Trailing prose')" "0"
want "watch intact"  "$OUT" '**Watch:** Value two.'
wantnot "no stray HR" "$OUT" 'Value two. ---'

# ---------------------------------------------------------------------------
# 4 — a heading terminates the block.
# ---------------------------------------------------------------------------
begin_case "4 heading terminator"
cat > "$SCRATCH/f4" <<'FIX'
### Merge digest
**What changed:** Value one.
**Watch:** Value two.
### Remediation
Filed nothing.
FIX
run "$SCRATCH/f4"
wantnot "remediation not folded" "$OUT" 'Filed nothing'

# ---------------------------------------------------------------------------
# 5 — multi-line values fold onto their label.
# ---------------------------------------------------------------------------
begin_case "5 continuation folding"
cat > "$SCRATCH/f5" <<'FIX'
### Merge digest
**What changed:** First half
  second half.
**Watch:** Only line.
FIX
run "$SCRATCH/f5"
want "folded" "$OUT" '**What changed:** First half second half.'

# ---------------------------------------------------------------------------
# 6 — degraded producer output still delivers.
# ---------------------------------------------------------------------------
begin_case "6 degraded digest"
cat > "$SCRATCH/f6" <<'FIX'
### Merge digest
**What changed:** unavailable — no Phase 6 verdict file
**Why:** unavailable — no Phase 6 verdict file
**Watch:** unavailable — no Phase 6 verdict file
**Touches:** unavailable — no Phase 6 verdict file
**Machine-authored fixes:** unavailable — no Phase 6 verdict file
FIX
run "$SCRATCH/f6"
eq "exit 0" "$RC" "0"
want "degraded carried" "$OUT" '**What changed:** unavailable — no Phase 6 verdict file'
wantnot "not the fallback" "$OUT" 'No /pr-ready digest'

# ---------------------------------------------------------------------------
# 7 — no digest block at all -> the fallback message, exit 0.
# ---------------------------------------------------------------------------
begin_case "7 no digest block"
cat > "$SCRATCH/f7" <<'FIX'
### Rebase
Rebased.
<!-- pr-ready-verdict -->
FIX
run "$SCRATCH/f7"
eq "exit 0" "$RC" "0"
want "fallback"  "$OUT" '(No /pr-ready digest — armed by triage sweep or no review pass run.)'
want "header"    "$OUT" '**Merged [#2200](<https://github.com/o/r/pull/2200>): Fix the thing**'
want "url"       "$OUT" '(<https://github.com/o/r/pull/2200>)'
wantnot "no bare url line" "$(printf '%s\n' "$OUT" | grep -x 'https://github.com/o/r/pull/2200' || true)" 'https'

# ---------------------------------------------------------------------------
# 8 — empty stdin (no sticky comment found at all) -> the same fallback.
# ---------------------------------------------------------------------------
begin_case "8 empty stdin"
: > "$SCRATCH/f8"
run "$SCRATCH/f8"
eq "exit 0" "$RC" "0"
want "fallback" "$OUT" '(No /pr-ready digest'

# ---------------------------------------------------------------------------
# 9 — one label present, the other absent -> name the gap, keep the half that parsed.
# ---------------------------------------------------------------------------
begin_case "9 half a digest"
cat > "$SCRATCH/f9" <<'FIX'
### Merge digest
**Watch:** Only the watch line survived.
FIX
run "$SCRATCH/f9"
want "gap named"  "$OUT" '**What changed:** (missing)'
want "half kept"  "$OUT" '**Watch:** Only the watch line survived.'

# ---------------------------------------------------------------------------
# 10 — truncation: title, What changed, Watch. Character counts, not bytes.
# ---------------------------------------------------------------------------
begin_case "10 truncation"
LONG_W="$(printf 'w%.0s' $(seq 1 1400))"
LONG_T="$(printf 't%.0s' $(seq 1 900))"
{
    printf '### Merge digest\n'
    printf '**What changed:** %s\n' "$LONG_W"
    printf '**Watch:** %s\n' "$LONG_T"
} > "$SCRATCH/f10"
BIGTITLE="$(printf 'T%.0s' $(seq 1 200))"
BIGBRANCH="$(printf 'b%.0s' $(seq 1 200))"
OUT="$(bash "$DRIVER" --pr-number 2200 --title "$BIGTITLE" \
        --url 'https://github.com/o/r/pull/2200' --branch "$BIGBRANCH" < "$SCRATCH/f10")"
_w="$(printf '%s\n' "$OUT" | sed -n 's/^\*\*What changed:\*\* //p')"
_t="$(printf '%s\n' "$OUT" | sed -n 's/^\*\*Watch:\*\* //p')"
_h="$(printf '%s\n' "$OUT" | sed -n 's/^\*\*Merged #2200: \(.*\)\*\*$/\1/p')"
_b="$(printf '%s\n' "$OUT" | sed -n 's/^\[\(b.*\)\](<.*>)$/\1/p')"
eq "what changed is 1000 chars" "${#_w}" "1000"
eq "watch is 650 chars"         "${#_t}" "650"
eq "title is 80 chars"          "${#_h}" "80"
eq "branch is 60 chars"         "${#_b}" "60"
want "what changed elided" "$_w" '…'
want "watch elided"        "$_t" '…'
want "title elided"        "$_h" '…'
want "branch elided"       "$_b" '…'
eq "whole DM under the Discord cap" "$([ "${#OUT}" -lt 2000 ] && echo under || echo over)" "under"

# ---------------------------------------------------------------------------
# 11 — multibyte safety: a byte-wise cut here would split U+00B7 and hand
#      notify-discord's `jq --arg` invalid UTF-8.
# ---------------------------------------------------------------------------
begin_case "11 multibyte truncation"
DOTS="$(printf '·%.0s' $(seq 1 1200))"
{
    printf '### Merge digest\n'
    printf '**What changed:** %s\n' "$DOTS"
    printf '**Watch:** ok\n'
} > "$SCRATCH/f11"
run "$SCRATCH/f11"
_m="$(printf '%s\n' "$OUT" | sed -n 's/^\*\*What changed:\*\* //p')"
eq "1000 characters" "${#_m}" "1000"
printf '%s' "$_m" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1 \
    && ok || fail "truncated value is not valid UTF-8"
jq -n --arg m "$_m" '{content:{message:$m}}' >/dev/null 2>&1 \
    && ok || fail "jq --arg rejected the truncated value"

# ---------------------------------------------------------------------------
# 11b — --branch prints as a link to the PR directly under the header, on both the
#       digest and the fallback paths; absent or empty means no line at all.
# ---------------------------------------------------------------------------
begin_case "11b branch line"
run "$SCRATCH/f1" --branch 'fix-the-thing'
eq "exit 0" "$RC" "0"
eq "line 2 is the branch" "$(printf '%s\n' "$OUT" | sed -n 2p)" '[fix-the-thing](<https://github.com/o/r/pull/2200>)'
eq "line 1 is still the header" "$(printf '%s\n' "$OUT" | sed -n 1p)" '**Merged #2200: Fix the thing**'

run "$SCRATCH/f7" --branch 'fix-the-thing'
eq "fallback line 2 is the branch" "$(printf '%s\n' "$OUT" | sed -n 2p)" '[fix-the-thing](<https://github.com/o/r/pull/2200>)'
want "fallback still carried" "$OUT" '(No /pr-ready digest'

run "$SCRATCH/f1"
eq "no --branch: line 2 blank" "$(printf '%s\n' "$OUT" | sed -n 2p)" ''

run "$SCRATCH/f1" --branch ''
eq "empty --branch: line 2 blank" "$(printf '%s\n' "$OUT" | sed -n 2p)" ''

run "$SCRATCH/f1" --branch 'a`b'
eq "backtick stripped" "$(printf '%s\n' "$OUT" | sed -n 2p)" '[ab](<https://github.com/o/r/pull/2200>)'

run "$SCRATCH/f1" --branch 'a[b]c'
eq "brackets stripped" "$(printf '%s\n' "$OUT" | sed -n 2p)" '[abc](<https://github.com/o/r/pull/2200>)'

WF_NOTIFY="$ROOT/.github/workflows/merge-digest-notify.yml"
eq "workflow passes --branch" "$(grep -c -- '--branch "$PR_BRANCH"' "$WF_NOTIFY")" "1"
eq "workflow sources head.ref" "$(grep -c 'PR_BRANCH: ${{ github.event.pull_request.head.ref }}' "$WF_NOTIFY")" "1"

# ---------------------------------------------------------------------------
# 12 — flag parsing: every rejected form fails loudly, never silently.
# ---------------------------------------------------------------------------
begin_case "12 rejected flag forms"
OUT="$(bash "$DRIVER" --pr-number 1 --title t --url u --bogus x </dev/null 2>&1)"; RC=$?
eq "unknown flag exits 2" "$RC" "2"
want "unknown flag names itself" "$OUT" 'unknown argument: --bogus'

OUT="$(bash "$DRIVER" --pr-number 1 --title t </dev/null 2>&1)"; RC=$?
eq "missing --url exits 2" "$RC" "2"
want "missing flag message" "$OUT" 'are all required'

OUT="$(bash "$DRIVER" --pr-number abc --title t --url u </dev/null 2>&1)"; RC=$?
eq "non-numeric --pr-number exits 2" "$RC" "2"
want "non-numeric message" "$OUT" 'must be digits'

OUT="$(bash "$DRIVER" --help 2>&1)"; RC=$?
eq "--help exits 0" "$RC" "0"
want "help shows usage" "$OUT" 'Usage: bin/digest-dm-build'

# ---------------------------------------------------------------------------
# 13 — REAL producer round trip. digest.sh emits the five lines; we paste them
#      under the contract heading and re-parse. This is the case that would have
#      caught the "every live row read `digest: unavailable`" regression.
# ---------------------------------------------------------------------------
begin_case "13 producer round trip"
cat > "$SCRATCH/p6" <<'FIX'
Phase 6 verdict prose that must not leak into the digest.

## DIGEST
**What changed:** Real producer value.
**Why:** Real producer why.
**Watch:** Real producer watch.
**Touches:** bin/digest-dm-build
**Machine-authored fixes:** none
FIX
LINES="$(bash "$PRODUCER" "$SCRATCH/p6")"
eq "producer emitted five lines" "$(printf '%s\n' "$LINES" | wc -l | tr -d ' ')" "5"
{ printf '### Merge digest\n'; printf '%s\n' "$LINES"; } > "$SCRATCH/f13"
run "$SCRATCH/f13"
want "round-trip what"  "$OUT" '**What changed:** Real producer value.'
want "round-trip watch" "$OUT" '**Watch:** Real producer watch.'
wantnot "no verdict prose" "$OUT" 'must not leak'

begin_case "13b degraded producer round trip"
: > "$SCRATCH/p6empty"
LINES="$(bash "$PRODUCER" "$SCRATCH/p6empty")"
{ printf '### Merge digest\n'; printf '%s\n' "$LINES"; } > "$SCRATCH/f13b"
run "$SCRATCH/f13b"
eq "exit 0" "$RC" "0"
want "degrade reason reaches the DM" "$OUT" 'unavailable —'

# ---------------------------------------------------------------------------
# 14 — the guards above are not vacuous.
# ---------------------------------------------------------------------------
begin_case "14 guards are not vacuous"
cat > "$SCRATCH/f14" <<'FIX'
### Merge digest
**Whatever changed:** Relabelled, must not match.
**Watch:** still here
FIX
run "$SCRATCH/f14"
want "relabelled degrades" "$OUT" '**What changed:** (missing)'

cat > "$SCRATCH/f14b" <<'FIX'
**What changed:** Above the heading, must never be seen.

### Rebase
Rebased.
FIX
run "$SCRATCH/f14b"
want "above-heading ignored" "$OUT" '(No /pr-ready digest'

# The producer really does emit bare-bold, not bulleted — case 2 must stay honest.
begin_case "14c producer emits bare bold"
printf '%s\n' "$LINES" | grep -q '^\*\*What changed:\*\*' \
    && ok || fail "digest.sh no longer emits bare-bold labels; case 2 may be vacuous"

# ---------------------------------------------------------------------------
# 15 — CI actually runs this harness.
# ---------------------------------------------------------------------------
begin_case "15 CI wiring"
WF="$ROOT/.github/workflows/tests.yml"
[ -f "$WF" ] || fail "no tests.yml at $WF"
eq "wired exactly once" "$(grep -cE '^[[:space:]]+bin/test-digest-dm-build( \\)?$' "$WF")" "1"

# ---------------------------------------------------------------------------
# 16-21 — Merge danger line from --pr-body-file.
# ---------------------------------------------------------------------------
_rep() { printf "$1%.0s" $(seq 1 "$2"); }
DANGER_WHY='the rollback path is not reversible once it ships'
DIGEST_FIX="$SCRATCH/danger-digest"
{
    printf '### Merge digest\n'
    printf '**What changed:** %s\n' "$(_rep w 1000)"
    printf '**Watch:** %s\n' "$(_rep t 650)"
} > "$DIGEST_FIX"

begin_case "one-way-prefix"
printf '**Merge danger:** Door: one-way · Blast radius: external · Why: %s\n' "$DANGER_WHY" > "$SCRATCH/body.md"
run "$SCRATCH/f1" --pr-body-file "$SCRATCH/body.md"
eq "exit 0" "$RC" "0"
eq "first line is the danger prefix" "$(printf '%s\n' "$OUT" | sed -n 1p)" '!! ONE-WAY DOOR (blast radius: external)'
want "header follows" "$(printf '%s\n' "$OUT" | sed -n 2p)" '**Merged [#2200]'

begin_case "two-way-localized-compressed"
printf '**Merge danger:** Door: two-way · Blast radius: localized · Why: %s\n' "$DANGER_WHY" > "$SCRATCH/body.md"
# Short title and URL: the 700 bound is What 400 + Watch 200 plus scaffolding, and the
# shared run() URL alone pushes the DM to ~704.
OUT="$(bash "$DRIVER" --pr-number 2200 --title 'Fix' --url 'https://x.io/2200' \
        --pr-body-file "$SCRATCH/body.md" < "$DIGEST_FIX")"
RC=$?
eq "exit 0" "$RC" "0"
want "compressed body is elided" "$OUT" '…'
wantnot "no danger prefix" "$OUT" 'ONE-WAY'
eq "DM under 700 chars" "$([ "${#OUT}" -lt 700 ] && echo under || echo over)" "under"

begin_case "two-way-site-wide-unchanged"
printf '**Merge danger:** Door: two-way · Blast radius: site-wide · Why: %s\n' "$DANGER_WHY" > "$SCRATCH/body.md"
run "$DIGEST_FIX"
_base="$OUT"
run "$DIGEST_FIX" --pr-body-file "$SCRATCH/body.md"
eq "output byte-equal to the no-flag call" "$OUT" "$_base"

begin_case "malformed-line-no-prefix"
printf '**Merge danger:** Door: maybe · Blast radius: external · Why: %s\n' "$DANGER_WHY" > "$SCRATCH/body.md"
run "$DIGEST_FIX" --pr-body-file "$SCRATCH/body.md"
eq "exit 0" "$RC" "0"
wantnot "no prefix" "$OUT" 'ONE-WAY'

begin_case "one-way-cap"
printf '**Merge danger:** Door: one-way · Blast radius: external · Why: %s\n' "$DANGER_WHY" > "$SCRATCH/body.md"
OUT="$(bash "$DRIVER" --pr-number 2200 --title "$(_rep T 80)" \
        --url 'https://github.com/o/r/pull/2200' --branch "$(_rep b 60)" \
        --pr-body-file "$SCRATCH/body.md" < "$DIGEST_FIX")"
want "prefix present" "$OUT" '!! ONE-WAY DOOR (blast radius: external)'
eq "whole DM under the Discord cap" "$([ "${#OUT}" -lt 2000 ] && echo under || echo over)" "under"

# ---------------------------------------------------------------------------
# pr3267 dual-layout — the old (v1) and new (v2) sticky layouts fold to the same five
# label/value pairs, and none of the v2-only sections leaks into a value. _digest_labels
# is a function inside the driver (it has no flag of its own), so lift it by name.
# ---------------------------------------------------------------------------
eval "$(sed -n '/^_digest_labels() {/,/^}/p' "$DRIVER")"
PR3267_DIR="$ROOT/bin/fixtures/review-shared"
PR3267_V1="$(jq -r '.comments[-1].body' "$PR3267_DIR/post-plan-sticky-pr3267-v1.json")"
PR3267_V2="$(jq -r '.comments[-1].body' "$PR3267_DIR/post-plan-sticky-pr3267-v2.json")"
PR3267_WANT="$(printf '%s\t%s\n' \
    'What changed' 'a thing' \
    'Why' 'a reason' \
    'Watch' 'a page' \
    'Touches' 'a file' \
    'Machine-authored fixes' 'none (post-plan remediation: 009d537a1b2c)')"

begin_case "pr3267-v1-digest-labels"
PR3267_L1="$(_digest_labels <<< "$PR3267_V1")"
eq "five label/value pairs" "$PR3267_L1" "$PR3267_WANT"
wantnot "no Still open" "$PR3267_L1" 'Still open'
wantnot "no Fixed in this PR" "$PR3267_L1" 'Fixed in this PR'
wantnot "no Code review" "$PR3267_L1" 'Code review'

begin_case "pr3267-v2-digest-labels"
PR3267_L2="$(_digest_labels <<< "$PR3267_V2")"
eq "equal to the v1 pairs" "$PR3267_L2" "$PR3267_L1"
eq "five label/value pairs" "$PR3267_L2" "$PR3267_WANT"
wantnot "no Still open" "$PR3267_L2" 'Still open'
wantnot "no Fixed in this PR" "$PR3267_L2" 'Fixed in this PR'
wantnot "no Code review" "$PR3267_L2" 'Code review'

begin_case "unknown-flag-exit-2"
run "$SCRATCH/f1" --merge-danger x
eq "unknown flag exits 2" "$RC" "2"
run "$SCRATCH/f1" --pr-body-file /nonexistent
eq "unreadable body file exits 2" "$RC" "2"

# ---------------------------------------------------------------------------
# After-merge mode (--ping-out). The ping decision is bin/lib/post-merge-rows.sh's
# pmr_ping_decision; these cases pin how the driver wires it and what the top block says.
# ---------------------------------------------------------------------------
AM_URL='https://github.com/a-jay85/IBL5/pull/7'
AM_CMT='https://github.com/a-jay85/IBL5/pull/7#issuecomment-99'
AM_RUN='https://github.com/a-jay85/IBL5/actions/runs/123'
PING_FILE="$SCRATCH/ping"

# am <title> [flags...] -> OUT, RC, PING (file content, "<none>" when absent). Stdin is f1.
am() {
    local _title="$1"; shift
    rm -f "$PING_FILE"
    OUT="$(bash "$DRIVER" --pr-number 7 --title "$_title" --url "$AM_URL" \
            --ping-out "$PING_FILE" "$@" < "$SCRATCH/f1" 2>"$SCRATCH/err")"
    RC=$?
    PING="<none>"
    if [ -f "$PING_FILE" ]; then PING="$(cat "$PING_FILE")"; fi
}
_first_line() { printf '%s\n' "$1" | sed -n 1p; }

begin_case "am-manual"
am T --manual-count 2 --auto-ci-count 0 --auto-mac-count 0 --auto-failed-count 0 \
    --comment-url "$AM_CMT" --run-url "$AM_RUN" \
    --job-result after-merge-checklist=success
eq "exit 0" "$RC" "0"
eq "ping true" "$PING" "true"
want "action line first" "$(_first_line "$OUT")" '**Action needed after merge:** 2 manual step(s).'
want "directions is the sticky comment" "$(_first_line "$OUT")" "Directions: <$AM_CMT>"
want "header still present" "$OUT" '**Merged [#7](<https://github.com/a-jay85/IBL5/pull/7>): T**'
want "what changed still present" "$OUT" '**What changed:**'

begin_case "am-none"
am T --manual-count 0 --auto-ci-count 0 --auto-mac-count 0 --auto-failed-count 0 \
    --comment-url '' --run-url "$AM_RUN" --job-result after-merge-checklist=success
eq "exit 0" "$RC" "0"
eq "ping false" "$PING" "false"
eq "output starts at the header" "$(_first_line "$OUT")" '**Merged [#7](<https://github.com/a-jay85/IBL5/pull/7>): T**'
wantnot "no action line" "$OUT" 'Action needed'
wantnot "no problem line" "$OUT" 'pipeline problem'

begin_case "am-auto-only"
am T --manual-count 0 --auto-ci-count 1 --auto-mac-count 2 --auto-failed-count 0 \
    --comment-url "$AM_CMT" --run-url "$AM_RUN" --job-result after-merge-checklist=success
eq "exit 0" "$RC" "0"
eq "ping false" "$PING" "false"
want "auto line" "$(_first_line "$OUT")" 'After merge: 1 CI and 2 Mac step(s) run automatically; Mac failures ping you in #dev.'
wantnot "no action line" "$OUT" 'Action needed'

begin_case "am-auto-failed"
am T --manual-count 0 --auto-ci-count 1 --auto-mac-count 0 --auto-failed-count 1 \
    --comment-url "$AM_CMT" --run-url "$AM_RUN" --job-result after-merge-checklist=success
eq "exit 0" "$RC" "0"
eq "ping true" "$PING" "true"
want "failed line" "$OUT" '**Post-merge auto step failed:** 1. Run: <'"$AM_RUN"'>'

begin_case "am-job-failed"
am T --manual-count 0 --auto-ci-count 0 --auto-mac-count 0 --auto-failed-count 0 \
    --comment-url '' --run-url "$AM_RUN" --job-result after-merge-checklist=failure
eq "exit 0" "$RC" "0"
eq "ping true" "$PING" "true"
want "problem line first" "$(_first_line "$OUT")" '**Post-merge pipeline problem** (job:after-merge-checklist=failure).'
want "run link" "$(_first_line "$OUT")" "Run: <$AM_RUN>"
want "directions fall back to the PR" "$(_first_line "$OUT")" "Directions: <$AM_URL>"

begin_case "am-job-skipped"
am T --manual-count '' --auto-ci-count '' --auto-mac-count '' --auto-failed-count 0 \
    --run-url "$AM_RUN" --job-result after-merge-checklist=skipped
eq "exit 0" "$RC" "0"
eq "ping true" "$PING" "true"
want "names the skipped job" "$OUT" 'job:after-merge-checklist=skipped'

begin_case "am-job-cancelled"
am T --manual-count 0 --auto-ci-count 0 --auto-mac-count 0 --auto-failed-count 0 \
    --run-url "$AM_RUN" --job-result after-merge-checklist=cancelled
eq "exit 0" "$RC" "0"
eq "ping true" "$PING" "true"
want "names the cancelled job" "$OUT" 'job:after-merge-checklist=cancelled'

begin_case "am-bad-count"
am T --manual-count x --auto-ci-count 0 --auto-mac-count 0 --auto-failed-count 0 \
    --run-url "$AM_RUN" --job-result after-merge-checklist=success
eq "exit 0" "$RC" "0"
eq "bad manual count pings" "$PING" "true"
want "names the bad count" "$OUT" 'bad-count:manual'
am T --manual-count 0 --auto-ci-count x --auto-mac-count 0 --auto-failed-count 0 \
    --run-url "$AM_RUN" --job-result after-merge-checklist=success
eq "exit 0 on bad auto count" "$RC" "0"
eq "bad auto count pings" "$PING" "true"
want "names the bad auto count" "$OUT" 'auto_ci_count=invalid'
am T --manual-count 0 --auto-ci-count 0 --auto-mac-count 0 --auto-failed-count 0 \
    --run-url "$AM_RUN" --job-result after-merge-checklist=success
eq "all good does not ping" "$PING" "false"

begin_case "am-mention-text"
am '@everyone <@123> pwn' --manual-count 1 --auto-ci-count 0 --auto-mac-count 0 \
    --auto-failed-count 0 --comment-url "$AM_CMT" --run-url "$AM_RUN" \
    --branch '@here-branch' --job-result after-merge-checklist=success
eq "exit 0" "$RC" "0"
wantnot "no raw @everyone" "$OUT" '@everyone'
wantnot "no raw @here" "$OUT" '@here'
wantnot "no raw user mention" "$OUT" '<@123>'
want "text survives with a zero-width space" "$OUT" "@$(printf '\342\200\213')everyone"

begin_case "am-bad-comment-url"
am T --manual-count 1 --auto-ci-count 0 --auto-mac-count 0 --auto-failed-count 0 \
    --comment-url 'https://evil.example/x> @everyone <https://y' --run-url "$AM_RUN" \
    --job-result after-merge-checklist=success
eq "exit 0" "$RC" "0"
want "directions fall back to the PR URL" "$(_first_line "$OUT")" "Directions: <$AM_URL>"
wantnot "bad url never printed" "$OUT" 'evil.example'
am T --manual-count 1 --auto-ci-count 0 --auto-mac-count 0 --auto-failed-count 0 \
    --comment-url 'http://insecure.example/x' --run-url 'not a url' \
    --job-result after-merge-checklist=failure
want "insecure comment url falls back" "$(_first_line "$OUT")" "Directions: <$AM_URL>"
want "bad run url reads unavailable" "$OUT" 'Run: (run link unavailable)'

begin_case "am-ping-out-empty"
OUT="$(bash "$DRIVER" --pr-number 7 --title T --url "$AM_URL" --ping-out '' < "$SCRATCH/f1" 2>/dev/null)"
RC=$?
eq "empty --ping-out exits 2" "$RC" "2"

begin_case "am-no-ping-out-unchanged"
run "$SCRATCH/f1"
_plain="$OUT"
run "$SCRATCH/f1" --manual-count 3 --job-result after-merge-checklist=failure
eq "after-merge flags without --ping-out change nothing" "$OUT" "$_plain"

begin_case "am-top-survives-cut"
# A digest with a huge What and Watch. The ping line and directions link sit first, so
# the 1900-character cut in notify-discord's send.sh can never take them.
{
    printf '### Merge digest\n'
    printf '**What changed:** %s\n' "$(_rep w 3000)"
    printf '**Why:** y\n'
    printf '**Watch:** %s\n' "$(_rep v 3000)"
    printf '**Touches:** t\n'
    printf '**Machine-authored fixes:** none\n'
} > "$SCRATCH/f-huge"
rm -f "$PING_FILE"
OUT="$(bash "$DRIVER" --pr-number 7 --title "$(_rep T 200)" --url "$AM_URL" \
        --branch "$(_rep b 200)" --ping-out "$PING_FILE" --manual-count 4 \
        --auto-ci-count 1 --auto-mac-count 1 --auto-failed-count 1 \
        --comment-url "$AM_CMT" --run-url "$AM_RUN" \
        --job-result after-merge-checklist=failure < "$SCRATCH/f-huge" 2>/dev/null)"
RC=$?
eq "exit 0" "$RC" "0"
eq "whole DM under the send.sh cut" "$([ "${#OUT}" -le 1900 ] && echo under || echo over)" "under"
want "problem line first" "$(_first_line "$OUT")" '**Post-merge pipeline problem**'
want "action line within the top block" "$(printf '%s\n' "$OUT" | sed -n 1,4p)" '**Action needed after merge:** 4 manual step(s).'
want "directions link within the top block" "$(printf '%s\n' "$OUT" | sed -n 1,4p)" "Directions: <$AM_CMT>"
want "what changed still present" "$OUT" '**What changed:**'

# ---------------------------------------------------------------------------
# workflow-contract — static assertions on merge-digest-notify.yml. The live event slice
# cannot run before merge, so these pin the shape the ping decision depends on. Herestrings
# throughout (.claude/rules/shell-pipefail-grep.md).
# ---------------------------------------------------------------------------
WF_TEXT="$(cat "$WF_NOTIFY")"
_wf_count() { grep -cF -- "$1" <<< "$WF_TEXT" || true; }

begin_case "wf-needs"
want "digest job needs the checklist job" "$WF_TEXT" $'\n    needs: [after-merge-checklist]\n'

begin_case "wf-always"
_after_if="$(awk '/^  notify-merge-digest:/ {j=1} j && /^    if: >-$/ {getline; print; exit}' <<< "$WF_TEXT")"
eq "first line of the digest if: is always()" "$_after_if" '      always() &&'

begin_case "wf-ping-fail-closed"
want "ping compares against false" "$WF_TEXT" "ping: \${{ steps.build.outputs.ping != 'false' }}"

begin_case "wf-no-static-false"
eq "no hard-coded ping: 'false'" "$(_wf_count "ping: 'false'")" "0"

begin_case "wf-one-send"
eq "exactly one notify-discord send" "$(_wf_count 'uses: ./.github/actions/notify-discord')" "1"

begin_case "wf-outputs"
for _k in status manual_count auto_ci_count auto_mac_count comment_url; do
    want "output $_k" "$WF_TEXT" "      $_k: \${{ steps.checklist.outputs.$_k }}"
done

begin_case "wf-job-result"
want "digest passes the checklist job result" "$WF_TEXT" '--job-result "after-merge-checklist=$AM_RESULT"'

begin_case "wf-no-dm-out"
eq "no --dm-out left" "$(_wf_count '--dm-out')" "0"
eq "--title only on the digest call" "$(_wf_count '--title')" "1"

begin_case "wf-default-branch"
eq "both checkouts pin the default branch" \
    "$(_wf_count 'ref: ${{ github.event.repository.default_branch }}')" "2"

begin_case "wf-no-mention-rule-gone"
eq "the old no-mention comment is gone" "$(_wf_count 'never @'"mention")" "0"

h_done
