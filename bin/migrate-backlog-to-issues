#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * bin/migrate-backlog-to-issues — One-shot idempotent migration that reads
 * every IBL5 backlog source file and creates a GitHub Issue for each item
 * in a-jay85/IBL5-backlog (or the repo named by BACKLOG_ISSUES_REPO).
 *
 * Default mode is dry-run — prints the planned creates, touches nothing.
 * Pass --apply to perform creation. Safe to re-run: idempotency key is
 * (area-label, leading-ID-token) so an interrupted run resumes from where
 * it left off on the next invocation.
 */

const DEFAULT_REPO = 'a-jay85/IBL5-backlog';
const BODY_CAP     = 60000;
const RATE_SLEEP   = 3.5;
const DEFERRAL_STOP     = 3;
const LIST_ATTEMPTS     = 4;
const LIST_RETRY_SLEEP  = 5;
const BODY_TRUNCATION_SUFFIX = "\n\n> [truncated — see git history of the retired backlog file]";

