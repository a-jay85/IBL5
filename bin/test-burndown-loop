#!/usr/bin/env bash
# Tests for bin/burndown-loop: CLI forms, env knobs, the lock, the pacing decision,
# batch classification, usage-gate pause and resume, the launchd unit, stop/status
# and the finish DM.
#
# Runs under a scrubbed env (CI: env -i PATH=/usr/bin:/bin). Every test builds its own
# HOME, usage-gate state dir and PATH-shadowing stubs (security, curl, sleep, launchctl,
# caffeinate, claude), so no test reaches the real keychain, the live usage endpoint,
# launchd or Discord. Named tests run as arguments: bin/test-burndown-loop test_cli_no_args

set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOOP="$REPO_ROOT/bin/burndown-loop"
PASS=0
FAIL=0
FAILED_NAMES=""

pass() { PASS=$((PASS + 1)); echo "  ok   $1"; }
fail() { FAIL=$((FAIL + 1)); FAILED_NAMES="$FAILED_NAMES $1"; echo "  FAIL $1${2:+ — $2}"; }

assert_eq() {  # name expected actual
    if [ "$2" = "$3" ]; then pass "$1"; else fail "$1" "expected [$2] got [$3]"; fi
}
assert_contains() {  # name haystack needle
    case "$2" in *"$3"*) pass "$1" ;; *) fail "$1" "missing [$3] in [$2]" ;; esac
}
assert_not_contains() {  # name haystack needle
    case "$2" in *"$3"*) fail "$1" "unexpected [$3] in [$2]" ;; *) pass "$1" ;; esac
}
assert_file() {  # name path
    if [ -e "$2" ]; then pass "$1"; else fail "$1" "missing file $2"; fi
}
assert_no_file() {  # name path
    if [ ! -e "$2" ]; then pass "$1"; else fail "$1" "unexpected file $2"; fi
}

TMPROOT=$(mktemp -d)
trap 'chmod -R u+rwx "$TMPROOT" 2>/dev/null; rm -rf "$TMPROOT"' EXIT

# jq may be off the scrubbed PATH. A silent skip would pass CI while testing nothing.
mkdir -p "$TMPROOT/bin"
JQ_BIN=""
for c in /usr/bin/jq /opt/homebrew/bin/jq /usr/local/bin/jq; do
    if [ -x "$c" ]; then JQ_BIN="$c"; break; fi
done
if [ -z "$JQ_BIN" ]; then echo "FAIL: jq not found"; exit 1; fi
ln -s "$JQ_BIN" "$TMPROOT/bin/jq"

SID_A=11111111-1111-4111-8111-111111111111
SID_B=22222222-2222-4222-8222-222222222222

# ---------------------------------------------------------------- environment

# new_env: fresh HOME, usage-gate state dir and stubs for the current test.
new_env() {
    T=$(mktemp -d "$TMPROOT/t.XXXXXX")
    STUB="$T/stub"
    export HOME="$T/home"
    export IBL5_USAGE_GATE_STATE_DIR="$T/ug"
    export IBL5_BURNDOWN_DISCORD_DM="$T/dm"
    mkdir -p "$HOME/claude-plans/_reports" "$IBL5_USAGE_GATE_STATE_DIR/markers" "$STUB"
    unset IBL5_BURNDOWN_RESERVE_PCT IBL5_BURNDOWN_MAX_FAILS IBL5_BURNDOWN_BATCH_TIMEOUT_MIN \
        IBL5_BURNDOWN_EMPTY_SLEEP_MIN
    STATE="$HOME/.claude/burndown-loop"
    REPORTS="$HOME/claude-plans/_reports"
    LAUNCH_DIR="$HOME/Library/LaunchAgents"
    PATH="$STUB:$TMPROOT/bin:/usr/bin:/bin"
    export PATH
    make_stubs
}

make_stubs() {
    printf '#!/bin/sh\nexit 1\n' > "$STUB/security"
    printf '#!/bin/sh\necho call >> "%s/curl.calls"\nexit 7\n' "$T" > "$STUB/curl"
    printf '#!/bin/sh\necho "$1" >> "%s/sleep.calls"\nif [ -f "%s/sleep.hook" ]; then sh "%s/sleep.hook"; rm -f "%s/sleep.hook"; fi\nexit 0\n' "$T" "$T" "$T" "$T" > "$STUB/sleep"
    printf '#!/bin/sh\necho "$*" >> "%s/launchctl.calls"\nexit 0\n' "$T" > "$STUB/launchctl"
    # caffeinate -s <cmd...>: run the command directly so the exit status is the stub's own.
    printf '#!/bin/sh\nshift\nexec "$@"\n' > "$STUB/caffeinate"
    printf '#!/bin/sh\n{ cat; echo ---; } >> "%s/dm.calls"\n' "$T" > "$T/dm"
    cat > "$STUB/claude" <<'CLAUDE_EOF'
#!/usr/bin/env bash
T="@T@"
REPO_ROOT="@REPO@"
echo "CLAUDE_HEADLESS=${CLAUDE_HEADLESS:-} SID=${IBL5_USAGE_GATE_SESSION_ID:-} RUNNER=${IBL5_USAGE_GATE_RUNNER:-} CEIL=${CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS:-} OPTIN=${IBL5_BURNDOWN_LOOP-unset} ARGV=$*" >> "$T/claude.calls"
rx=$(env | grep '^IBL5_BURNDOWN_REEXEC_' || true)
if [ -n "$rx" ]; then printf '%s\n' "$rx" >> "$T/claude.reexec-env"; fi
printf '%s\n' "${IBL5_BURNDOWN_EMPTY_SENTINEL:-}" >> "$T/claude.sentinel-env"
sentinel() { [ -z "${IBL5_BURNDOWN_EMPTY_SENTINEL:-}" ] || printf 'LEDGER: none\n' > "$IBL5_BURNDOWN_EMPTY_SENTINEL"; }
q="$T/claude.queue"
act=drain
if [ -s "$q" ]; then
    act=$(head -n 1 "$q")
    tail -n +2 "$q" > "$q.tmp"
    mv "$q.tmp" "$q"
fi
n=$(wc -l < "$T/claude.calls" | tr -d ' ')
write_ledger() {
    printf '{"items":[{"issue_num":1,"status":"dispatched","route":"ad-hoc"}],"budget":5%s}\n' "$1" \
        > "$HOME/claude-plans/_reports/burndown-batch-stub-$n.json"
}
case "$act" in
    ledger) write_ledger ',"units_used":5' ;;
    ledger-nounits) write_ledger '' ;;
    ledger-exit3) write_ledger ',"units_used":5'; echo "BURNDOWN-LOOP: abort-exit-3" ;;
    none) sentinel; echo "BURNDOWN-LOOP: none-selected" ;;
    none-unconfirmed) echo "BURNDOWN-LOOP: none-selected" ;;
    sentinel-ledger) sentinel; write_ledger ',"units_used":5' ;;
    sentinel-alarm) sentinel; kill -ALRM $$ ;;
    drain)
        sentinel
        echo "BURNDOWN-LOOP: none-selected"
        touch "$HOME/.claude/burndown-loop/stop"
        ;;
    exit3) echo "BURNDOWN-LOOP: abort-exit-3" ;;
    silent) ;;
    crash) exit 1 ;;
    alarm) kill -ALRM $$ ;;
    marker)
        . "$REPO_ROOT/bin/lib/usage-gate.sh"
        usage_marker_write "$IBL5_USAGE_GATE_SESSION_ID" burndown-loop "$REPO_ROOT/bin/burndown-loop" usage-pause drain 94 seven_day ''
        ;;
esac
exit 0
CLAUDE_EOF
    sed -i.bak -e "s|@T@|$T|" -e "s|@REPO@|$REPO_ROOT|" "$STUB/claude"
    rm -f "$STUB/claude.bak"
    chmod +x "$STUB"/*
    chmod +x "$T/dm"
}

# seed_usage <five> <week> <hours_left>: a fresh cache, so usage_fetch 45 hits it.
seed_usage() {
    local now rs
    now=$(date +%s)
    rs=$((now + $3 * 3600))
    jq -cn --argjson f "$1" --argjson w "$2" --argjson t "$now" --argjson rs "$rs" \
        '{five_hour:{utilization:$f},
          seven_day:{utilization:$w, resets_at:($rs|todate)},
          fetched_at:$t}' > "$IBL5_USAGE_GATE_STATE_DIR/cache.json"
}

# seed_stale <age_secs>: seed_usage 5 0 1, then age the cache past usage_fetch 45.
seed_stale() {
    seed_usage 5 0 1
    jq -c --argjson a "$1" '.fetched_at -= $a' "$IBL5_USAGE_GATE_STATE_DIR/cache.json" \
        > "$IBL5_USAGE_GATE_STATE_DIR/cache.tmp"
    mv "$IBL5_USAGE_GATE_STATE_DIR/cache.tmp" "$IBL5_USAGE_GATE_STATE_DIR/cache.json"
}

# seed_backoff <offset_secs>: a fetch-backoff file expiring offset seconds from now.
seed_backoff() {
    printf '%s 30\n' "$(( $(date +%s) + $1 ))" > "$IBL5_USAGE_GATE_STATE_DIR/fetch-backoff"
}

decision_lines() { printf '%s\n' "$OUT" | grep -c 'decision='; }

# make_tree: a throwaway copy of the loop and its two libs under $T/tree, so a test
# can rewrite the code under a running loop. Sets TT.
make_tree() {
    TT="$T/tree"
    mkdir -p "$TT/bin/lib"
    cp "$REPO_ROOT/bin/burndown-loop" "$TT/bin/burndown-loop"
    cp "$REPO_ROOT/bin/lib/usage-gate.sh" "$REPO_ROOT/bin/lib/usage-fetch.sh" "$TT/bin/lib/"
    chmod +x "$TT/bin/burndown-loop"
}

# tree_hook <file> <line>: on the first sleep, replace <file> under $TT with a copy
# that has <line> appended. Write-then-rename gives a new inode, like git checkout,
# so the running shell never reads the appended text.
tree_hook() {
    cat > "$T/sleep.hook" <<HOOK_EOF
cp "$TT/$1" "$TT/$1.new"
printf '%s\n' '$2' >> "$TT/$1.new"
mv "$TT/$1.new" "$TT/$1"
chmod +x "$TT/bin/burndown-loop"
HOOK_EOF
}

run_tree_loop() {  # <args...>: like run_loop, against the copied tree
    OUT=$("$TT/bin/burndown-loop" "$@" 2>&1)
    RC=$?
}

queue() { printf '%s\n' "$@" > "$T/claude.queue"; }

# run_loop <args...>: sets OUT (stdout+stderr) and RC.
run_loop() {
    OUT=$("$LOOP" "$@" 2>&1)
    RC=$?
}

calls() {  # <file>: line count, 0 when absent
    if [ -f "$1" ]; then wc -l < "$1" | tr -d ' '; else echo 0; fi
}

# gate_do <snippet>: run a snippet with usage-gate.sh sourced, in the test env.
gate_do() {
    bash -c ". '$REPO_ROOT/bin/lib/usage-gate.sh'; $1"
}

marker_for() {  # <sid> <runner>
    gate_do "usage_marker_write $1 $2 '$LOOP' usage-pause drain 94 seven_day ''"
}

# ---------------------------------------------------------------- CLI

test_cli_unknown_arg() {
    new_env
    run_loop frobnicate
    assert_eq cli_unknown:rc 2 "$RC"
    assert_contains cli_unknown:msg "$OUT" "unknown argument"
    run_loop run --bogus
    assert_eq cli_unknown_flag:rc 2 "$RC"
    assert_contains cli_unknown_flag:msg "$OUT" "unknown argument: --bogus"
}

test_cli_no_args() {
    new_env
    run_loop
    assert_eq cli_no_args:rc 2 "$RC"
    assert_contains cli_no_args:usage "$OUT" "Usage: bin/burndown-loop"
}

test_cli_dry_run_wrong_subcommand() {
    new_env
    run_loop start --dry-run
    assert_eq cli_dry_start:rc 2 "$RC"
    assert_contains cli_dry_start:msg "$OUT" "unknown argument: --dry-run"
    assert_no_file cli_dry_start:no-launchctl "$T/launchctl.calls"
}

test_env_knob_empty_default() {
    new_env
    IBL5_BURNDOWN_MAX_FAILS='' IBL5_BURNDOWN_BATCH_TIMEOUT_MIN='' run_loop run --dry-run
    assert_eq knob_empty:rc 0 "$RC"
    assert_contains knob_empty:timeout "$OUT" "timeout=5400"
    assert_contains knob_empty:max_fails "$OUT" "max_fails=3"
}

test_env_knob_invalid() {
    new_env
    IBL5_BURNDOWN_MAX_FAILS=abc run_loop run --dry-run
    assert_eq knob_abc:rc 2 "$RC"
    assert_contains knob_abc:names-var "$OUT" "IBL5_BURNDOWN_MAX_FAILS"
    IBL5_BURNDOWN_MAX_FAILS=0 run_loop run --dry-run
    assert_eq knob_zero:rc 2 "$RC"
    assert_contains knob_zero:names-var "$OUT" "IBL5_BURNDOWN_MAX_FAILS"
    IBL5_BURNDOWN_BATCH_TIMEOUT_MIN=-5 run_loop run --dry-run
    assert_eq knob_neg:rc 2 "$RC"
    assert_contains knob_neg:names-var "$OUT" "IBL5_BURNDOWN_BATCH_TIMEOUT_MIN"
}

test_env_reserve_values() {
    new_env
    # Mutation: ${IBL5_BURNDOWN_RESERVE_PCT-10} in place of :- makes the empty case yield ''.
    run_loop run --dry-run
    assert_contains reserve:unset "$OUT" "reserve=10 "
    IBL5_BURNDOWN_RESERVE_PCT='' run_loop run --dry-run
    assert_contains reserve:empty "$OUT" "reserve=10 "
    IBL5_BURNDOWN_RESERVE_PCT=abc run_loop run --dry-run
    assert_contains reserve:abc "$OUT" "reserve=10 "
    assert_contains reserve:abc-log "$(cat "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log" 2>/dev/null)" "bad-reserve value=abc"
    IBL5_BURNDOWN_RESERVE_PCT=100 run_loop run --dry-run
    assert_contains reserve:100 "$OUT" "reserve=10 "
    IBL5_BURNDOWN_RESERVE_PCT=0 run_loop run --dry-run
    assert_contains reserve:zero "$OUT" "reserve=0 "
    IBL5_BURNDOWN_RESERVE_PCT=25 run_loop run --dry-run
    assert_contains reserve:25 "$OUT" "reserve=25 "
}

test_state_outside_repo() {
    new_env
    seed_usage 5 0 1
    queue none
    run_loop run
    assert_eq outside_repo:rc 0 "$RC"
    # Mutation: STATE pointed at $ROOT/.burndown-loop would leave new untracked paths here.
    assert_no_file outside_repo:no-state-in-repo "$REPO_ROOT/.burndown-loop"
    assert_file outside_repo:state-under-home "$STATE/loop.sid"
    run_loop start
    assert_file outside_repo:plist-under-home "$LAUNCH_DIR/com.ibl5.burndown-loop.plist"
}

test_home_unset() {
    new_env
    OUT=$(env -u HOME "$LOOP" run --dry-run 2>&1)
    RC=$?
    assert_eq home_unset:rc 2 "$RC"
    assert_contains home_unset:msg "$OUT" "HOME is unset"
}

# ---------------------------------------------------------------- pacing decision

test_dry_run_go() {
    new_env
    seed_usage 5 0 1
    run_loop run --dry-run
    assert_eq dry_go:rc 0 "$RC"
    assert_contains dry_go:decision "$OUT" "decision=launch"
    assert_no_file dry_go:no-claude "$T/claude.calls"
    assert_no_file dry_go:no-curl "$T/curl.calls"
}

test_dry_run_wait_capped() {
    new_env
    seed_usage 5 50 160
    run_loop run --dry-run
    assert_eq dry_wait:rc 0 "$RC"
    assert_contains dry_wait:decision "$OUT" "decision=sleep 1800 pace"
    assert_no_file dry_wait:no-sleep "$T/sleep.calls"
    assert_no_file dry_wait:no-curl "$T/curl.calls"
}

test_dry_run_zone() {
    new_env
    seed_usage 95 10 100
    run_loop run --dry-run
    assert_eq dry_zone:rc 0 "$RC"
    assert_contains dry_zone:decision "$OUT" "decision=pause"
    assert_eq dry_zone:no-marker 0 "$(ls "$IBL5_USAGE_GATE_STATE_DIR/markers" | wc -l | tr -d ' ')"
}

test_dry_run_fetch_fail_closed() {
    new_env
    run_loop run --dry-run
    assert_eq dry_blind:rc 0 "$RC"
    assert_contains dry_blind:decision "$OUT" "decision=sleep 1800 blind fetch-rc=1"
    assert_eq dry_blind:one-line 1 "$(decision_lines)"
}

test_dry_run_fetch_backoff_sleep() {
    local secs
    new_env
    seed_stale 600
    seed_backoff 100
    run_loop run --dry-run
    assert_eq fetch_backoff:rc 0 "$RC"
    secs=$(printf '%s\n' "$OUT" | sed -n 's/.*decision=sleep \([0-9]*\) backoff fetch-rc=2.*/\1/p')
    case "$secs" in 104|105) pass fetch_backoff:secs ;; *) fail fetch_backoff:secs "got [$secs]" ;; esac
    assert_eq fetch_backoff:one-line 1 "$(decision_lines)"
    assert_not_contains fetch_backoff:no-launch "$OUT" "decision=launch"

    new_env
    seed_stale 600
    seed_backoff 3
    run_loop run --dry-run
    assert_contains fetch_backoff:floor "$OUT" "decision=sleep 30 backoff fetch-rc=2"
    assert_not_contains fetch_backoff:floor-no-launch "$OUT" "decision=launch"

    new_env
    seed_stale 600
    seed_backoff 900
    run_loop run --dry-run
    assert_contains fetch_backoff:cap "$OUT" "decision=sleep 300 backoff fetch-rc=2"
    assert_not_contains fetch_backoff:cap-no-launch "$OUT" "decision=launch"
}

test_dry_run_fetch_retry_no_backoff() {
    new_env
    seed_stale 600
    assert_no_file fetch_retry:no-backoff-armed "$IBL5_USAGE_GATE_STATE_DIR/fetch-backoff"
    run_loop run --dry-run
    assert_eq fetch_retry:absent-rc 0 "$RC"
    assert_contains fetch_retry:absent "$OUT" "decision=sleep 120 fetch-retry fetch-rc=2"
    assert_eq fetch_retry:absent-one-line 1 "$(decision_lines)"

    new_env
    seed_stale 600
    seed_backoff -100
    run_loop run --dry-run
    assert_eq fetch_retry:expired-rc 0 "$RC"
    assert_contains fetch_retry:expired "$OUT" "decision=sleep 120 fetch-retry fetch-rc=2"
    assert_eq fetch_retry:expired-one-line 1 "$(decision_lines)"

    new_env
    seed_stale 600
    printf 'garbage x\n' > "$IBL5_USAGE_GATE_STATE_DIR/fetch-backoff"
    run_loop run --dry-run
    assert_eq fetch_retry:garbled-rc 0 "$RC"
    assert_contains fetch_retry:garbled "$OUT" "decision=sleep 120 fetch-retry fetch-rc=2"
    assert_eq fetch_retry:garbled-one-line 1 "$(decision_lines)"
}

test_loop_backoff_sleep_reason() {
    new_env
    seed_stale 600
    seed_backoff 100
    run_loop run --once --no-dm
    assert_eq backoff_loop:rc 0 "$RC"
    assert_contains backoff_loop:reason "$OUT" "reason=backoff"
    assert_eq backoff_loop:first-sleep 60 "$(head -n1 "$T/sleep.calls")"
    assert_no_file backoff_loop:no-claude "$T/claude.calls"
}

# ---------------------------------------------------------------- lock

test_lock_live_exits_4() {
    new_env
    seed_usage 5 0 1
    mkdir -p "$STATE/lock"
    echo "$$" > "$STATE/lock/pid"
    run_loop run --once
    assert_eq lock_live:rc 4 "$RC"
    assert_contains lock_live:msg "$OUT" "already running"
    assert_no_file lock_live:no-claude "$T/claude.calls"
}

test_lock_stale_reclaimed() {
    new_env
    seed_usage 5 50 160
    mkdir -p "$STATE/lock"
    echo 999999 > "$STATE/lock/pid"
    run_loop run --once
    assert_eq lock_stale:rc 0 "$RC"
    assert_contains lock_stale:log "$OUT" "reclaimed stale lock"
    assert_no_file lock_stale:released "$STATE/lock"
}

# ---------------------------------------------------------------- batches

test_batch_ran_then_exhausted() {
    new_env
    seed_usage 5 0 1
    queue ledger drain
    run_loop run
    assert_eq ran_exhausted:rc 0 "$RC"
    assert_eq ran_exhausted:calls 2 "$(calls "$T/claude.calls")"
    assert_contains ran_exhausted:log "$OUT" "batch ran ledgers=1 items=1"
    assert_contains ran_exhausted:dm "$(cat "$T/dm.calls" 2>/dev/null)" "finished (stopped)"
    assert_contains ran_exhausted:counts "$(cat "$T/dm.calls" 2>/dev/null)" "batches=1 items=1"
}

test_batch_ran_items_per_batch() {
    new_env
    seed_usage 5 0 1
    queue ledger ledger none
    run_loop run
    assert_eq items_per_batch:rc 0 "$RC"
    assert_contains items_per_batch:second-batch "$OUT" "batch ran ledgers=1 items=1 units=5"
    assert_not_contains items_per_batch:no-running-total "$OUT" "batch ran ledgers=1 items=2"
    assert_contains items_per_batch:finish-total "$(cat "$T/dm.calls" 2>/dev/null)" "batches=2 items=2"
}

test_batch_old_ledger_not_counted() {
    new_env
    seed_usage 5 0 1
    printf '{"items":[],"budget":5}\n' > "$REPORTS/burndown-batch-old.json"
    queue silent
    IBL5_BURNDOWN_MAX_FAILS=1 run_loop run
    assert_eq old_ledger:rc 1 "$RC"
    assert_contains old_ledger:log "$OUT" "batch failed reason=rc=0"
}

test_batch_failures_cap() {
    new_env
    seed_usage 5 0 1
    queue crash crash crash
    run_loop run
    assert_eq failures_cap:rc 1 "$RC"
    assert_eq failures_cap:calls 3 "$(calls "$T/claude.calls")"
    assert_eq failures_cap:backoffs 2 "$(printf '%s\n' "$OUT" | grep -c 'sleep 300s reason=retry-after-failure')"
    assert_contains failures_cap:dm "$(cat "$T/dm.calls" 2>/dev/null)" "finished (failures)"
}

test_batch_timeout_classified() {
    new_env
    seed_usage 5 0 1
    queue alarm
    IBL5_BURNDOWN_MAX_FAILS=1 run_loop run
    assert_eq timeout:rc 1 "$RC"
    assert_contains timeout:reason "$OUT" "reason=timeout"
}

test_batch_abort_retries() {
    new_env
    seed_usage 5 0 1
    queue ledger-exit3 drain
    run_loop run
    assert_eq abort_retry:rc 0 "$RC"
    assert_eq abort_retry:calls 2 "$(calls "$T/claude.calls")"
    assert_contains abort_retry:log "$OUT" "batch aborted: burndown exit 3 fails=1/3"
    assert_contains abort_retry:sleep "$OUT" "sleep 600s reason=retry-after-abort"
    assert_contains abort_retry:finish "$OUT" "finish reason=stopped"
    assert_contains abort_retry:empty-line "$OUT" "backlog empty (sentinel confirmed first round LEDGER: none); re-check in 240m streak="
    assert_contains abort_retry:dm "$(cat "$T/dm.calls" 2>/dev/null)" "finished (stopped)"
    assert_contains abort_retry:counted "$(cat "$T/dm.calls" 2>/dev/null)" "batches=1 items=1"
}

test_batch_abort_cap_fail_closed() {
    new_env
    seed_usage 5 0 1
    queue exit3 exit3 exit3
    run_loop run
    assert_eq abort_cap:rc 1 "$RC"
    assert_eq abort_cap:calls 3 "$(calls "$T/claude.calls")"
    assert_eq abort_cap:sleeps 2 "$(printf '%s\n' "$OUT" | grep -c 'sleep 600s reason=retry-after-abort')"
    assert_contains abort_cap:fails "$OUT" "fails=3/3"
    assert_contains abort_cap:finish "$OUT" "finish reason=fail-closed"
    assert_contains abort_cap:dm "$(cat "$T/dm.calls" 2>/dev/null)" "finished (fail-closed)"
    assert_contains abort_cap:last-fail "$(cat "$T/dm.calls" 2>/dev/null)" "last fail: reason=abort-exit-3"
}

test_batch_abort_then_ran_resets() {
    new_env
    seed_usage 5 0 1
    queue exit3 ledger exit3 drain
    IBL5_BURNDOWN_MAX_FAILS=2 run_loop run
    assert_eq abort_reset:rc 0 "$RC"
    assert_eq abort_reset:calls 4 "$(calls "$T/claude.calls")"
    assert_eq abort_reset:fails-once-each 2 "$(printf '%s\n' "$OUT" | grep -c 'fails=1/2')"
    assert_not_contains abort_reset:never-cap "$OUT" "fails=2/2"
    assert_contains abort_reset:finish "$OUT" "finish reason=stopped"
    assert_contains abort_reset:empty-line "$OUT" "backlog empty (sentinel confirmed first round LEDGER: none); re-check in 240m streak="
}

test_batch_abort_once_no_sleep() {
    new_env
    seed_usage 5 0 1
    queue exit3
    run_loop run --once --no-dm
    assert_eq abort_once:rc 0 "$RC"
    assert_eq abort_once:calls 1 "$(calls "$T/claude.calls")"
    assert_contains abort_once:fails "$OUT" "fails=1/3"
    assert_not_contains abort_once:no-retry "$OUT" "retry-after-abort"
    assert_no_file abort_once:no-sleep "$T/sleep.calls"
    assert_not_contains abort_once:no-fail-closed "$OUT" "finish reason=fail-closed"
}

test_batch_env_and_prompt() {
    unset IBL5_BURNDOWN_LOOP
    new_env
    seed_usage 5 0 1
    queue none
    run_loop run --no-dm
    local line sid
    line=$(head -n 1 "$T/claude.calls" 2>/dev/null)
    sid=$(cat "$STATE/loop.sid" 2>/dev/null)
    assert_contains env_prompt:headless "$line" "CLAUDE_HEADLESS=1"
    assert_contains env_prompt:ceiling "$line" "CEIL=0"
    assert_contains env_prompt:runner "$line" "RUNNER=burndown-loop"
