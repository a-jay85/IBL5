# ==========================================================================================
# your-turn grouped — rows sit under typed headers with full counts; empty groups vanish
# ==========================================================================================
begin_case
reset_state
printf '%s' "$ATTACK_1PR" > "$SCRATCH/attack-out"
{   printf '#101  DIRTY  rebase\n'
    printf '#102  NOT-MERGEABLE  fix\n'
    printf '#103  FEAT-AWAITING-SIGNOFF  sign\n'
    printf '#104  HELD  look\n'
    printf '#105  UNCLEARED  look\n'
    printf '#106  WEIRD  look\n'
} > "$SCRATCH/triage-out"
run --worker
[[ $RC -eq 0 ]] || fail "your-turn grouped: exit $RC, want 0"
# The dm shim flattens newlines to spaces (one argv line per call), so order is checked by
# character offset in the single recorded line.
_dm="$(cat "$SCRATCH/dm.argv")"
_pos() { local _pre="${_dm%%"$1"*}"; if [[ "$_pre" == "$_dm" ]]; then echo -1; else echo "${#_pre}"; fi; }
for _h in '**Conflicts (2)**' '**Awaiting feat sign-off (1)**' '**Other held (3)**'; do
    [[ "$(grep -oF "$_h" <<< "$_dm" | wc -l | tr -d ' ')" == "1" ]] \
        || fail "your-turn grouped: header '$_h' not exactly once: $_dm"
done
! grep -qF 'Failed (' <<< "$_dm" \
    || fail "your-turn grouped: empty Failed group printed a header"
_hc="$(_pos '**Conflicts (2)**')"
_ha="$(_pos '**Awaiting feat sign-off (1)**')"
_ho="$(_pos '**Other held (3)**')"
[[ "$_hc" -ge 0 && "$_hc" -lt "$_ha" && "$_ha" -lt "$_ho" ]] \
    || fail "your-turn grouped: header order wrong ($_hc $_ha $_ho)"
for _n in 101 102 103 104 105 106; do
    _rl="$(_pos "#$_n —")"
    [[ "$_rl" -ge 0 ]] || fail "your-turn grouped: row #$_n missing"
    case "$_n" in
        101|102) [[ "$_rl" -gt "$_hc" && "$_rl" -lt "$_ha" ]] || fail "your-turn grouped: #$_n not under Conflicts" ;;
        103)     [[ "$_rl" -gt "$_ha" && "$_rl" -lt "$_ho" ]] || fail "your-turn grouped: #$_n not under Awaiting" ;;
        *)       [[ "$_rl" -gt "$_ho" ]] || fail "your-turn grouped: #$_n not under Other held (unknown bucket dropped?)" ;;
    esac
done
end_case "your-turn grouped"

