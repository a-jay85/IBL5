+# Capture the local migration history before the sync replaces anything. The replay after
+# the backfill below needs it to tell "never applied here" from "applied here".
+PRE_SYNC_VERSIONS="$(db_cmd "$DB_CONTAINER" mariadb "$DB_DEFAULT_NAME" -N -B \
+    -e "SELECT version FROM schema_migrations /* pre-sync */" 2>/dev/null || true)"
 for t in $PRESERVE_TABLES; do
     # No pipe into grep: under `set -o pipefail` an early grep exit SIGPIPEs the
