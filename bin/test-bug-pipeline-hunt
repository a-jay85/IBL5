# ── Row 46 — escalate, findings/remedy contain shell metacharacters: bytes verbatim in DM ──
# Build the fixture via jq --arg so the shell never evaluates the injected sequences.
bpt_reset
bpt_set_claim "$CLAIM"
_f46=$'metachar probe: `id` $(id) \'q\' "q" **bold**\nsecond line'
_r46=$'remedy: `id` $(id) \'q\' "q" **bold**'
