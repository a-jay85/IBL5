# ---- race-fix wiring in human-signoff.yml (static) ----
HS_WF="$REPO_ROOT/.github/workflows/human-signoff.yml"
# hs_job_block <job_id> — the job's lines, up to the next top-level job key.
hs_job_block() { awk -v j="  $1:" '$0 == j {f=1; print; next} f && /^  [A-Za-z0-9_-]+:$/ {f=0} f' "$HS_WF"; }
GATE_BLOCK=$(hs_job_block human-signoff)
WRITE_BLOCK=$(hs_job_block human-approved-fingerprint)
gate_to=$(sed -nE 's/^    timeout-minutes: ([0-9]+)$/\1/p' <<< "$GATE_BLOCK")
write_to=$(sed -nE 's/^    timeout-minutes: ([0-9]+)$/\1/p' <<< "$WRITE_BLOCK")
aw_n=$(sed -nE "s/^          HS_AWAIT_ATTEMPTS: '([0-9]+)'$/\1/p" <<< "$GATE_BLOCK")
aw_s=$(sed -nE "s/^          HS_AWAIT_SLEEP: '([0-9]+)'$/\1/p" <<< "$GATE_BLOCK")
if [ -n "$gate_to" ] && [ -n "$aw_n" ] && [ -n "$aw_s" ] \
   && [ $((aw_n * aw_s * 2)) -le $((gate_to * 60)) ]; then
    h_pass "wf: wait budget fits twice in the gate timeout"
else
    h_fail "wf: wait budget fits twice in the gate timeout" "timeout=[$gate_to] attempts=[$aw_n] sleep=[$aw_s]"
fi
if [ -n "$write_to" ]; then h_pass "wf: write job has timeout-minutes"; else h_fail "wf: write job has timeout-minutes" "none"; fi
# A job-level permissions block zeroes every scope it omits, so the write job's
# checkout of the shared lib needs contents: read.
write_perms=$(awk '/^    permissions:$/ {f=1; next} f && /^      / {print; next} f {exit}' <<< "$WRITE_BLOCK")
if command grep -qxF '      contents: read' <<< "$write_perms"; then
    h_pass "wf: write job grants contents: read for its checkout"
else
    h_fail "wf: write job grants contents: read for its checkout" "permissions=[$write_perms]"
fi
# shellcheck disable=SC2016  # literal workflow text
want "wf: eval step calls hs_await_record" "$GATE_BLOCK" 'hs_await_record "$HS_AWAIT_ATTEMPTS" "$HS_AWAIT_SLEEP" hs_refetch_comments'
# The eval-step guard admits the bounded wait for drop missing and drop mismatch only.
HS_GUARD=$(printf '%s\n' "$GATE_BLOCK" | command grep -E '^[[:space:]]*if .*HS_DROP_REASON' \
    | sed -E 's/^[[:space:]]*if (.*); then$/\1/')
if [ "$(printf '%s\n' "$HS_GUARD" | grep -c .)" = 1 ]; then
    h_pass "guard: exactly one HS_DROP_REASON guard in the eval step"
else
    h_fail "guard: exactly one HS_DROP_REASON guard in the eval step" "got: $HS_GUARD"
fi
guard_says() {
    [ -n "$HS_GUARD" ] || { echo EMPTY; return 0; }
    # shellcheck disable=SC2016  # expands in the child bash
    HS_VERDICT="$1" HS_DROP_REASON="$2" bash -c 'if eval "$1"; then echo ADMIT; else echo SKIP; fi' _ "$HS_GUARD"
}
want "guard: drop missing admits the wait" "$(guard_says drop missing)" "ADMIT"
want "guard: drop mismatch admits the wait" "$(guard_says drop mismatch)" "ADMIT"
want "guard: drop error skips the wait" "$(guard_says drop error)" "SKIP"
want "guard: near-miss reason mismatched skips the wait" "$(guard_says drop mismatched)" "SKIP"
want "guard: keep skips the wait" "$(guard_says keep "")" "SKIP"
# shellcheck disable=SC2016  # literal workflow text
want "wf: eval step reads issue events" "$GATE_BLOCK" '"repos/$GH_REPO/issues/$PR/events"'
# shellcheck disable=SC2016  # literal workflow text
want "wf: write job guards the record" "$WRITE_BLOCK" 'hs_record_write_ok "$APPROVED_AT" "$LABELS_NOW"'
want "wf: gate publishes approved_at" "$GATE_BLOCK" 'approved_at: ${{ steps.eval.outputs.approved_at }}'
# shellcheck disable=SC2016  # literal workflow text
want "wf: drop still deletes the label" "$WRITE_BLOCK" 'gh api --method DELETE "repos/$GH_REPO/issues/$PR/labels/human-approved"'
src_ln=$(command grep -nF 'source bin/lib/human-signoff-classifier.sh' <<< "$WRITE_BLOCK" | cut -d: -f1)
rec_ln=$(command grep -nF 'if [ "$VERDICT" = "record" ]; then' <<< "$WRITE_BLOCK" | cut -d: -f1)
if [ -n "$src_ln" ] && [ -n "$rec_ln" ] && [ "$src_ln" -gt "$rec_ln" ]; then
    h_pass "wf: drop path never sources the lib"
else
    h_fail "wf: drop path never sources the lib" "source line [$src_ln] record-if line [$rec_ln]"
fi

# run_write <approved_at> <labels> <events_file> <comments_file> — prints WRITE_RC=<rc>.
run_write() {
    # shellcheck disable=SC2016  # expands in the child bash
    LAST_OUT=$(bash -c 'set -euo pipefail; source "$0"; rc=0; hs_record_write_ok "$@" || rc=$?; echo "WRITE_RC=$rc"' "$LIB" "$@" 2>&1)
}
# run_label_at <events_file> — prints LABEL_AT=<ts> LABEL_RC=<rc>.
run_label_at() {
    # shellcheck disable=SC2016  # expands in the child bash
    LAST_OUT=$(bash -c 'set -euo pipefail; source "$0"; rc=0; v=$(hs_newest_label_at "$1") || rc=$?; echo "LABEL_AT=$v LABEL_RC=$rc"' "$LIB" "$@" 2>&1)
}

