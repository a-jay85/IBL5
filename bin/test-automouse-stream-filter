#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-automouse-stream-filter — regression test for bin/lib/automouse-stream-filter.sh.
#
# The filter reads `claude -p --output-format stream-json` NDJSON and emits the
# per-phase automouse log lines (tool: / exit: / COMPACTION:). This pins the
# compaction recorder added so context compactions are no longer dropped silently:
#   - a `system`/`compact_boundary` event is recorded as a COMPACTION line
#   - both field casings extract: documented wire snake_case (compact_metadata.pre_tokens)
#     AND stored-transcript camelCase (compactMetadata.preTokens)
#   - a manual /compact (trigger=manual) is recorded too
#   - FOOTGUN (load-bearing negative): a `system`/`init` event — emitted at the
#     start of every stream-json session — must NOT produce a COMPACTION line
#   - regression: tool: and exit: lines still emit (the new arm didn't break them)
#
# It also pins the closing-text fix: the log's last human-readable line must be the
# run's LAST assistant message, not the `result` event's `.result` field. `.result`
# is snapshotted at the run's first end_turn, so on any run that yields to a
# background Agent it holds a stale "waiting for the review agents" line and makes a
# completed run look truncated.
#
# Run: bin/test-automouse-stream-filter  (exit 0 = all pass, 1 = a case failed)

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
FILTER="$SCRIPT_DIR/lib/automouse-stream-filter.sh"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP" 2>/dev/null' EXIT

FAILED=0

# run_filter <ndjson-on-stdin> → captured filter stdout
# A `result` event always terminates the filter, so every fixture ends with one.
run_filter() {
    local hb="$TMP/hb"
    printf '%s' "$1" | "$FILTER" "$hb" "" "test-plan" 2>/dev/null
}

# run_filter_phase <phase> <ndjson-on-stdin> → captured filter stdout, phase tagged
run_filter_phase() {
    local hb="$TMP/hb"
    printf '%s' "$2" | "$FILTER" "$hb" "" "test-plan" "$1" 2>/dev/null
}

# run_filter_failsig <failsig_file> <ndjson> → captured filter stdout (5-arg form)
run_filter_failsig() {
    printf '%s' "$2" | "$FILTER" "$TMP/hb" "" "test-plan" "impl" "$1" 2>/dev/null
}

# assert_contains <name> <output> <needle>
assert_contains() {
    local name="$1" out="$2" needle="$3"
    if printf '%s' "$out" | grep -qF -- "$needle"; then
        echo "ok: $name"
    else
        echo "FAIL: $name — expected output to contain '$needle'"
        echo "  --- got ---"; printf '%s\n' "$out" | sed 's/^/  /'
        FAILED=1
    fi
}

# assert_not_contains <name> <output> <needle>
assert_not_contains() {
    local name="$1" out="$2" needle="$3"
    if printf '%s' "$out" | grep -qF -- "$needle"; then
        echo "FAIL: $name — output unexpectedly contained '$needle'"
        echo "  --- got ---"; printf '%s\n' "$out" | sed 's/^/  /'
        FAILED=1
    else
        echo "ok: $name"
    fi
}

RESULT_LINE='{"type":"result","subtype":"success","stop_reason":"end_turn","num_turns":1,"duration_ms":1000,"total_cost_usd":0.01,"usage":{"input_tokens":1,"output_tokens":1}}'

# c1 — documented wire schema (snake_case) compaction is recorded
OUT=$(run_filter '{"type":"system","subtype":"compact_boundary","compact_metadata":{"trigger":"auto","pre_tokens":120000}}
'"$RESULT_LINE"'
')
assert_contains "c1-wire-snakecase" "$OUT" "COMPACTION: subtype=compact_boundary trigger=auto pre_tokens=120000"

# c2 — stored-transcript schema (camelCase) compaction is recorded
OUT=$(run_filter '{"type":"system","subtype":"compact_boundary","compactMetadata":{"trigger":"auto","preTokens":167132}}
'"$RESULT_LINE"'
')
assert_contains "c2-transcript-camelcase" "$OUT" "COMPACTION: subtype=compact_boundary trigger=auto pre_tokens=167132"

# c3 — manual /compact (trigger=manual) is recorded
OUT=$(run_filter '{"type":"system","subtype":"compact_boundary","compact_metadata":{"trigger":"manual","pre_tokens":80000}}
'"$RESULT_LINE"'
')
assert_contains "c3-manual-trigger" "$OUT" "trigger=manual"

# c4 (FOOTGUN, negative) — a system/init event must NOT be recorded as a compaction
OUT=$(run_filter '{"type":"system","subtype":"init","session_id":"abc","tools":[]}
'"$RESULT_LINE"'
')
assert_not_contains "c4-init-not-compaction" "$OUT" "COMPACTION"

# c5 (regression) — tool and exit lines still emit with the new arm in place
OUT=$(run_filter '{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Bash"}]}}
'"$RESULT_LINE"'
')
assert_contains "c5a-tool-still-emits" "$OUT" "tool: Bash (#1, turn 1)"
assert_contains "c5b-exit-still-emits" "$OUT" "exit: stop_reason=end_turn"

# c6 — a passed phase is tagged onto the slug column as `<slug>/<phase>`
OUT=$(run_filter_phase impl '{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Bash"}]}}
'"$RESULT_LINE"'
')
assert_contains "c6a-phase-tags-tool" "$OUT" "test-plan/impl tool: Bash"
assert_contains "c6b-phase-tags-exit" "$OUT" "test-plan/impl exit: stop_reason=end_turn"

# c7 (back-compat, negative) — no phase arg → bare slug, no trailing slash
OUT=$(run_filter '{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Bash"}]}}
'"$RESULT_LINE"'
')
assert_contains "c7a-noPhase-bare-slug" "$OUT" "test-plan tool: Bash"
assert_not_contains "c7b-noPhase-no-slash" "$OUT" "test-plan/"

# A `result` event carrying the stale first-end_turn snapshot in `.result`.
RESULT_LINE_STALE='{"type":"result","subtype":"success","result":"Review agents running. Waiting for their results.","stop_reason":"end_turn","num_turns":1,"duration_ms":1000,"total_cost_usd":0.01,"usage":{"input_tokens":1,"output_tokens":1}}'

# c8 — the closing line is the last assistant message; the stale `.result` snapshot
# is dropped. This is the bug that made completed post-plan runs read as if they had
# exited before their review agents returned.
OUT=$(run_filter '{"type":"assistant","message":{"content":[{"type":"text","text":"Review agents running. Waiting for their results."}]}}
{"type":"assistant","message":{"content":[{"type":"text","text":"Post-plan complete. PR is open, CI green."}]}}
'"$RESULT_LINE_STALE"'
')
assert_contains "c8a-prints-final-assistant-text" "$OUT" "Post-plan complete. PR is open, CI green."
assert_not_contains "c8b-drops-stale-result-snapshot" "$OUT" "Waiting for their results."

# c9 (fallback) — a run with no assistant text still prints `.result`
OUT=$(run_filter "$RESULT_LINE_STALE"'
')
assert_contains "c9-falls-back-to-result-field" "$OUT" "Review agents running."

# c10 (negative) — a trailing `thinking` block is never the closing text, and
# thinking content is never logged at all
OUT=$(run_filter '{"type":"assistant","message":{"content":[{"type":"text","text":"Real final answer."}]}}
{"type":"assistant","message":{"content":[{"type":"thinking","thinking":"internal musing"}]}}
'"$RESULT_LINE_STALE"'
')
assert_contains "c10a-thinking-does-not-clobber" "$OUT" "Real final answer."
assert_not_contains "c10b-thinking-never-logged" "$OUT" "internal musing"

# c11 (negative) — a whitespace-only text block does not clobber the real message
OUT=$(run_filter '{"type":"assistant","message":{"content":[{"type":"text","text":"Real final answer."}]}}
{"type":"assistant","message":{"content":[{"type":"text","text":"   "}]}}
'"$RESULT_LINE_STALE"'
')
assert_contains "c11-whitespace-does-not-clobber" "$OUT" "Real final answer."

# c12 — peak_ctx uses the max of non-advisor iterations (Phase 3c fixture shape)
# Record has: top-level ctx=121709 (sum), iter1 type:message ctx=60025,
# iter2 type:advisor_message ctx=61684 (excluded), iter3 type:message ctx=61390.
# Correct peak = 61390; wrong answers: 121709 (summed top), 61684 (advisor).
OUT=$(run_filter '{"type":"assistant","message":{"usage":{"input_tokens":4,"output_tokens":0,"cache_read_input_tokens":120000,"cache_creation_input_tokens":1705,"iterations":[{"type":"message","input_tokens":25,"output_tokens":0,"cache_read_input_tokens":60000,"cache_creation_input_tokens":0},{"type":"advisor_message","input_tokens":61684,"output_tokens":0,"cache_read_input_tokens":0,"cache_creation_input_tokens":0},{"type":"message","input_tokens":5,"output_tokens":0,"cache_read_input_tokens":60000,"cache_creation_input_tokens":1385}]}}}
'"$RESULT_LINE"'
')
assert_contains "peak_ctx takes the max of non-advisor iterations" "$OUT" "peak_ctx=61390"
assert_not_contains "peak_ctx is not the summed top-level usage" "$OUT" "peak_ctx=121709"
assert_not_contains "peak_ctx excludes the advisor_message iteration" "$OUT" "peak_ctx=61684"

# c13 — an event with no usage at all degrades to peak_ctx=0, not a crash
OUT=$(run_filter '{"type":"assistant","message":{"content":[{"type":"text","text":"done"}]}}
'"$RESULT_LINE"'
')
assert_contains "no-usage event degrades to zero" "$OUT" "peak_ctx=0"

# --- failure-signature capture (ADR-0160): optional 5th arg, side file only
nd() { printf '%s\n' "$@"; }   # join args as ndjson lines
USE1='{"type":"assistant","message":{"content":[{"type":"tool_use","id":"tu1","name":"Bash","input":{"command":"vendor/bin/phpunit --filter Foo\nsecond line"}}]}}'
USE2='{"type":"assistant","message":{"content":[{"type":"tool_use","id":"tu2","name":"Bash","input":{"command":"bin/other"}}]}}'
ERR1='{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"tu1","is_error":true,"content":"Exit code 1\nAPI Error: 401 FAILURES! Tests: 3"}]}}'
ERR1_ARR='{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"tu1","is_error":true,"content":[{"type":"text","text":"fatal: bad object"}]}]}}'
ERR1_FIRST='{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"tu1","is_error":true,"content":"first-err"}]}}'
ERR2_SECOND='{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"tu2","is_error":true,"content":"second-err"}]}}'
OKRES='{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"tuX","is_error":false,"content":"fine"}]}}'
FS="$TMP/failsig"

# f1 — the error result is recorded: tool, FIRST command line only, error text
rm -f "$FS"
run_filter_failsig "$FS" "$(nd "$USE1" "$ERR1" "$RESULT_LINE")" >/dev/null
REC=$(cat "$FS" 2>/dev/null || true)
assert_contains "f1-error-result-recorded (tool)" "$REC" "tool: Bash"
assert_contains "f1-error-result-recorded (command)" "$REC" "command: vendor/bin/phpunit --filter Foo"
assert_contains "f1-error-result-recorded (error)" "$REC" "FAILURES! Tests: 3"
assert_not_contains "f1-error-result-recorded (first line only)" "$REC" "second line"

# f2 — error text never reaches stdout (the env-error scan reads the log)
OUT=$(run_filter_failsig "$FS" "$(nd "$USE1" "$ERR1" "$RESULT_LINE")")
assert_not_contains "f2-error-text-never-on-stdout (API Error)" "$OUT" "API Error: 401"
assert_not_contains "f2-error-text-never-on-stdout (FAILURES)" "$OUT" "FAILURES!"

# f3 — text-block-array content is recorded
rm -f "$FS"
run_filter_failsig "$FS" "$(nd "$USE1" "$ERR1_ARR" "$RESULT_LINE")" >/dev/null
assert_contains "f3-array-content-recorded" "$(cat "$FS" 2>/dev/null || true)" "fatal: bad object"

# f4 — the last error wins
rm -f "$FS"
run_filter_failsig "$FS" "$(nd "$USE1" "$ERR1_FIRST" "$USE2" "$ERR2_SECOND" "$RESULT_LINE")" >/dev/null
REC=$(cat "$FS" 2>/dev/null || true)
assert_contains "f4-last-error-wins (second kept)" "$REC" "second-err"
assert_not_contains "f4-last-error-wins (first gone)" "$REC" "first-err"

# f5 — an error followed by 6 non-error results was recovered from: dropped
rm -f "$FS"
run_filter_failsig "$FS" "$(nd "$USE1" "$ERR1" "$OKRES" "$OKRES" "$OKRES" "$OKRES" "$OKRES" "$OKRES" "$RESULT_LINE")" >/dev/null
if [ ! -e "$FS" ]; then echo "ok: f5-recovered-error-dropped"; else echo "FAIL: f5-recovered-error-dropped — file still present"; FAILED=1; fi

# f5b — boundary: exactly 5 later results keeps the error
rm -f "$FS"
run_filter_failsig "$FS" "$(nd "$USE1" "$ERR1" "$OKRES" "$OKRES" "$OKRES" "$OKRES" "$OKRES" "$RESULT_LINE")" >/dev/null
if [ -e "$FS" ]; then echo "ok: f5b-five-later-results-kept"; else echo "FAIL: f5b-five-later-results-kept — file missing"; FAILED=1; fi

# f6 — 4-arg and 5-arg stdout are identical once the timestamp prefix is stripped
FIX6=$(nd "$USE1" "$ERR1" "$RESULT_LINE")
OUT5=$(run_filter_failsig "$FS" "$FIX6" | sed 's/^\[[0-9:]*\]//')
# the 5-arg call is tagged phase=impl; compare against a 4-arg call tagged the same way
OUT4=$(run_filter_phase impl "$FIX6" | sed 's/^\[[0-9:]*\]//')
if [ "$OUT4" = "$OUT5" ]; then echo "ok: f6-four-arg-stdout-unchanged"; else echo "FAIL: f6-four-arg-stdout-unchanged"; echo "  4: $OUT4"; echo "  5: $OUT5"; FAILED=1; fi

# f7 — a stale side file is removed at startup
printf 'stale' > "$FS"
run_filter_failsig "$FS" "$(nd "$RESULT_LINE")" >/dev/null
if [ ! -e "$FS" ]; then echo "ok: f7-stale-file-removed-at-start"; else echo "FAIL: f7-stale-file-removed-at-start — stale file survived"; FAILED=1; fi

# f8 — a non-error result (is_error:false) writes nothing
rm -f "$FS"
run_filter_failsig "$FS" "$(nd "$USE1" "$OKRES" "$RESULT_LINE")" >/dev/null
if [ ! -e "$FS" ]; then echo "ok: f8-non-error-result-ignored"; else echo "FAIL: f8-non-error-result-ignored — file written"; FAILED=1; fi

if [ "$FAILED" -ne 0 ]; then
    echo "RESULT: FAILED"
    exit 1
fi
echo "RESULT: all passed"
exit 0
