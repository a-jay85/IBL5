assert_eq "only: DIVERGED-CONFLICT HEAD unchanged"  "$HEAD23_BEFORE"    "$HEAD23_AFTER"
STATUS23="$(git -C "$WT23" status --porcelain 2>/dev/null)"
if echo "$STATUS23" | grep -q '^UU'; then
    failcase "only: DIVERGED-CONFLICT left a conflicted index (merge --abort missing)"
else
    pass "only: DIVERGED-CONFLICT no UU entry in status"
fi

# ── Test 24: only: DIVERGED-DIRTY attempts nothing ────────────────────────────
MAIN24="$(new_env)"
