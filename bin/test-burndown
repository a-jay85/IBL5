[ "$RC" -eq 0 ] && ok "C43: BURNDOWN_GIT unset: exits 0" || fail "C43: BURNDOWN_GIT unset: exits 0 (got $RC, out: $OUT)"
grep -qF "git worktree list failed" <<< "$OUT" \
    && fail "C43: no git worktree list failed" || ok "C43: no git worktree list failed"

# ── C44: BURNDOWN_GIT="" — empty string falls back to real git ───────────────
rm -f "$T/home/claude-plans/_reports"/burndown-batch-[0-9]*.json
OUT="$(GH_LOG="$T/gh.log" GH_FX_DIR="$T/fx" \
    BACKLOG_GH="$T/gh" BURNDOWN_TIER_HINT="$T/tier" BURNDOWN_GIT="" \
    HOME="$T/home" "$SCRIPT" burndown 2>&1)"; RC=$?
[ "$RC" -eq 0 ] && ok "C44: BURNDOWN_GIT empty: exits 0" || fail "C44: BURNDOWN_GIT empty: exits 0 (got $RC, out: $OUT)"
grep -qF "git worktree list failed" <<< "$OUT" \
    && fail "C44: no git worktree list failed" || ok "C44: no git worktree list failed"

# ── Phase 7: drift guards ─────────────────────────────────────────────────────

SKILL_FILE="$(cd "$(dirname "$0")/.." && pwd)/.claude/skills/burndown/SKILL.md"

# ── C45: subcommand drift guard ───────────────────────────────────────────────
if [ -f "$SKILL_FILE" ]; then
    LIB_FILE="$(cd "$(dirname "$0")" && pwd)/lib/burndown.sh"
    SKILL_SUBCMDS="$(grep -oE 'bin/backlog burndown[a-z-]*' "$SKILL_FILE" \
        | sed 's/bin\/backlog //' | sort -u)"
    C45_FAIL=0
    while IFS= read -r subcmd; do
        [ -n "$subcmd" ] || continue
        grep -qE "^ *${subcmd}\)" "$LIB_FILE" \
            || { fail "C45: $subcmd in skill but not in bd_main case"; C45_FAIL=1; }
    done <<< "$SKILL_SUBCMDS"
    [ "$C45_FAIL" -eq 0 ] && ok "C45: skill subcommands match bd_main case"
else
    fail "C45: SKILL.md not found at $SKILL_FILE"
fi

# ── C46: post-plan boundary ───────────────────────────────────────────────────
if [ -f "$SKILL_FILE" ]; then
    HAS_ALLOWED=0
    HAS_NEVER=0
    while IFS= read -r line; do
        grep -qF 'post-plan-now' <<< "$line" || continue
        if grep -qE 'cd .+ && bin/post-plan-now --auto' <<< "$line"; then
            HAS_ALLOWED=1
        elif grep -qF 'Never run' <<< "$line"; then
            HAS_NEVER=1
        else
            fail "C46: post-plan-now line not in allowed form: $line"
        fi
    done < "$SKILL_FILE"
    [ "$HAS_ALLOWED" -eq 1 ] && ok "C46: has allowed post-plan-now line" \
        || fail "C46: no allowed post-plan-now line found"
    [ "$HAS_NEVER" -eq 1 ] && ok "C46: has Never run line" \
        || fail "C46: no Never run line found"
else
    fail "C46: SKILL.md not found at $SKILL_FILE"
fi

echo ""
echo "Results: $PASS passed, $FAIL failed"
if [ "$FAIL" -gt 0 ]; then
    for f in "${FAILURES[@]}"; do printf '  FAIL: %s\n' "$f"; done
    exit 1
fi
exit 0
