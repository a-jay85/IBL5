#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/fleet-status — one-page view of every background headless Claude run.
#
# WHY THIS EXISTS. Several bin/ producers fire detached headless `claude -p`
# sessions (bin/post-plan-now, bin/plan-now, bin/pr-ready-now, bin/docfix-run via
# launchd one-shots; bin/automouse/run via its own runner). Each leaves state in a
# different place, so answering "what is running and how far along is it?" meant
# three or four ad-hoc commands. This prints the answer and exits.
#
# THE CENTRAL HAZARD: RESIDUE LOOKS EXACTLY LIKE LIVENESS.
# Every signal on disk outlives the run that wrote it, so each row's aliveness is
# a *conjunction*, never a single file's presence:
#
#   launchd   A loaded label is NOT a running job. `launchctl list` keeps the
#             label with PID column "-" after exit (and a negative status column
#             when it was killed — e.g. a real observed -9). Predicate: the PID
#             column must be numeric. Note bin/watch-run keys on label-GONE as its
#             terminator, which is correct for the self-bootout path; this script
#             sees precisely the jobs that did NOT bootout themselves.
#   automouse A heartbeat file is NOT a running phase. Files from runs days dead
#             sit in the same directory as live ones. Predicate: the PID embedded
#             in the filename is alive AND that PID's command still mentions
#             automouse — the PID alone false-positives on PID reuse.
#
# THE OTHER WAY TO OVERCOUNT: DOUBLE-COUNTING ONE JOB. Every job above spawns its
# own `claude -p` children, so a flat `pgrep` lists work the page already showed —
# 5 real jobs once rendered as 12 rows. The last section walks each candidate's
# ancestry and drops anything descending from a PID already printed, which leaves
# it empty on a healthy fleet and turns it into an orphan detector.
#
# PROGRESS. Each producer mints a session uuid, passes `claude --session-id` and
# writes it to /tmp/<label>.session. The SDK streams that run's transcript to
# ~/.claude/projects/*/<uuid>.jsonl LIVE, so the last assistant line and the last
# tool call now render mid-run. Liveness is unchanged: the row is still gated on a
# numeric launchd PID, so a surviving transcript can never speak for a dead job.
# post-plan rows have no sidecar — out/<run>/audit.log stays their only signal.
#
# AND THE ROW LINKS TO WHICHEVER OF THOSE IT READ. Every job on this page is by
# construction still running, which is exactly the window where the /tmp log holds
# nothing — offering it as the thing to open sent you to an empty file for the
# whole run. So a post-plan row names `audit:` once out/<run>/audit.log exists,
# and falls back to `log:` when it does not (the first seconds of a run, or a
# skill-fallback run that never created the harness directory). The label names
# the file, so the row never leaves you guessing which one you got. The /tmp log
# is still the right file AFTER exit — its first line is the RESULT verdict — but
# by then the job is gone from this page.
#
# Usage: bin/fleet-status [--watch [SECS]]
#
# --watch [SECS]   re-render every SECS seconds (default 15) until interrupted.
#
# CLICKABLE PATHS. File paths this page names — each run's log, each queued plan,
# and the plan a live runner is on — are emitted as OSC 8 terminal hyperlinks, so
# they open on click in iTerm2/WezTerm/Ghostty/VS Code. Terminals without OSC 8
# ignore the sequence and show the same text. Links are TTY-gated: piped or
# captured output stays byte-for-byte plain, which is what keeps the page
# greppable (and stops every assertion in bin/test-fleet-status from needing to
# know about escapes). Runner slugs with no queue file stay unlinked.
#
# SCOPE. Processes only. Worktree/branch shipping state is bin/wt-status's job and
# is deliberately not mirrored here — the two answer different questions and a
# copy would just be a second place to keep correct.
#
# Exit: 0 always when rendering succeeded. This is a reporting tool; "nothing is
# running" is information, not a failure.
#
# Bash 3.2 / macOS compatible: no mapfile, no declare -A, no ${var,,}, no touch -d.
# set -u only (NOT set -e) — the liveness predicates rely on kill/grep/launchctl
# returning nonzero as a signal, which -e would turn into an exit.
#
# Requires a `ps` supporting `-o etime=` / `-o command=` (macOS, and procps on
# Linux). BusyBox ps has no `-o` at all, so under Alpine every automouse row
# degrades to "stale" — the conjunction fails closed, which is the right direction
# but makes the section useless. CI runs ubuntu-latest, which has procps.

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# MAIN CHECKOUT, not "wherever this script was invoked from". bin/post-plan-now
# always writes its harness output under the main checkout's tree even when the
# run is for a worktree branch, and this script is itself likely to be run FROM a
# worktree — so resolving the output dir relative to $SCRIPT_DIR/.. silently
# points at a path that does not exist and the progress column falls back to the
# (useless mid-run) launchd log. $(git --git-common-dir) is the shared .git
# directory for every linked worktree; its parent is the main checkout.
MAIN_CHECKOUT="$(cd "$SCRIPT_DIR/.." && pwd)"
_common_dir="$(git -C "$SCRIPT_DIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
[ -n "$_common_dir" ] && [ -d "$_common_dir" ] && MAIN_CHECKOUT="$(dirname "$_common_dir")"

# State locations. Overridable so bin/test-fleet-status can point the whole
# script at a scratch fixture tree instead of the real one.
AUTOMOUSE_DIR="${FLEET_STATUS_AUTOMOUSE_DIR:-$HOME/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/automouse}"
HARNESS_OUT="${FLEET_STATUS_HARNESS_OUT:-$MAIN_CHECKOUT/tools/postplan-harness/out}"
LOG_DIR="${FLEET_STATUS_LOG_DIR:-/tmp}"
TRANSCRIPT_ROOT="${FLEET_STATUS_TRANSCRIPT_ROOT:-$HOME/.claude/projects}"
JQ_BIN="${FLEET_STATUS_JQ:-jq}"
AUTOMOUSE_PLIST="${FLEET_STATUS_AUTOMOUSE_PLIST:-$HOME/Library/LaunchAgents/com.ibl5.automouse.plist}"
# shellcheck source=bin/lib/session-id.sh
. "$SCRIPT_DIR/lib/session-id.sh"

WATCH=0
WATCH_SECS=15

while [ $# -gt 0 ]; do
    case "$1" in
        --watch)
            WATCH=1
            # Optional numeric argument; a non-numeric next arg is the next flag.
            case "${2:-}" in
                ''|*[!0-9]*) ;;
                *) WATCH_SECS="$2"; shift ;;
            esac
            ;;
        -h|--help) sed -n '4,68p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) printf 'fleet-status: unknown option %s\n' "$1" >&2; exit 2 ;;
    esac
    shift
done

if [ -t 1 ]; then
    B=$(printf '\033[1m'); DIM=$(printf '\033[2m'); R=$(printf '\033[0m')
    GRN=$(printf '\033[32m'); YEL=$(printf '\033[33m')
    LINKS=1
else
    B=''; DIM=''; R=''; GRN=''; YEL=''
    LINKS=0
fi

# Links arm SEPARATELY from colour, and the override touches only $LINKS. Folding
# them together would make bin/test-fleet-status's forced-link capture carry SGR
# bytes between fields, and the column regexes it asserts on ('live-plan\.md
# +in progress') would stop matching — the harness would then be testing a
# differently-rendered page than the one it pins.
[ -n "${FLEET_STATUS_FORCE_LINKS:-}" ] && LINKS=1

# ── helpers ────────────────────────────────────────────────────────────────────

# link_file <path> [text] — print TEXT as an OSC 8 hyperlink to file://<path>.
#
# OSC 8 is ESC ] 8 ;; URI ST  TEXT  ESC ] 8 ;; ST. It is what lets a row display
# the short name a human reads ("live-plan.md") while the click target is the
# absolute path, which a bare printed path cannot do.
#
# THREE FAIL-SOFT GATES, each returning plain text rather than a broken link:
#   not a TTY   escapes would corrupt a pipe, a capture or a grep.
#   relative    file:// has no notion of cwd, so a relative path yields a link
#               that silently opens the wrong thing — worse than no link.
#   empty       nothing to point at.
# Spaces are percent-encoded because a raw space ends the URI; no other encoding
# is done deliberately — these paths are /tmp and $HOME names, and a general URL
# encoder is bulk this reporting tool has no use for.
link_file() {
    local path="${1:-}" text="${2:-}" enc
    [ -z "$text" ] && text="$path"
    if [ "$LINKS" -eq 0 ] || [ -z "$path" ]; then printf '%s' "$text"; return; fi
    case "$path" in /*) ;; *) printf '%s' "$text"; return ;; esac
    enc="$(printf '%s' "$path" | sed 's/ /%20/g')"
    # shellcheck disable=SC1003  # '\033\\' is ESC + a literal backslash: the ST
    # that terminates an OSC sequence. Not an escaped quote.
    printf '\033]8;;file://%s\033\\%s\033]8;;\033\\' "$enc" "$text"
}

# Human-readable age from a seconds count: 45s / 12m / 3h04m / 2d01h.
human_age() {
    local secs="${1:-}"
    case "$secs" in ''|*[!0-9-]*) printf '?'; return ;; esac
    [ "$secs" -lt 0 ] && secs=0
    if   [ "$secs" -lt 60 ];    then printf '%ds' "$secs"
    elif [ "$secs" -lt 3600 ];  then printf '%dm' $(( secs / 60 ))
    elif [ "$secs" -lt 86400 ]; then printf '%dh%02dm' $(( secs / 3600 )) $(( (secs % 3600) / 60 ))
    else printf '%dd%02dh' $(( secs / 86400 )) $(( (secs % 86400) / 3600 ))
    fi
}

# Elapsed seconds for a live PID, derived from ps etime (handles dd-hh:mm:ss,
# hh:mm:ss and mm:ss forms). Empty when the PID is gone.
pid_elapsed_secs() {
    local et d hms h m s
    et="$(ps -o etime= -p "$1" 2>/dev/null | tr -d ' ')"
    [ -z "$et" ] && return
    d=0; hms="$et"
    case "$et" in *-*) d="${et%%-*}"; hms="${et#*-}" ;; esac
    h=0
    case "$hms" in *:*:*) h="${hms%%:*}"; hms="${hms#*:}" ;; esac
    m="${hms%%:*}"; s="${hms##*:}"
    # 10# prefixes stop leading zeros being read as octal (e.g. 08, 09).
    printf '%d' $(( 10#$d * 86400 + 10#$h * 3600 + 10#$m * 60 + 10#$s ))
}

# True when PID is alive AND its command line matches the pattern. The pattern
# half is what defends against PID reuse: a PID recorded days ago is fair game
# for an unrelated process now.
pid_alive_matching() {
    local pid="${1:-}" pattern="${2:-}"
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    [ -z "$pattern" ] && return 0
    ps -o command= -p "$pid" 2>/dev/null | grep -q "$pattern"
}

# Clip a one-line field to $2 columns. $3 = "left" keeps the TAIL of the value and
# marks the cut with a leading ellipsis — right-clipping a path yields
# "/Users/ajaynicolas/GitHub/IBL5/ibl5/cla…", which identifies nothing. The
# discriminating end of a path is its last component; of prose, its first.
clip_field() {
    local v="$1" max="${2:-72}" side="${3:-right}"
    v="$(printf '%s' "$v" | tr -s '[:space:]' ' ')"
    [ "${#v}" -le "$max" ] && { printf '%s' "$v"; return 0; }
    if [ "$side" = left ]; then
        printf '…%s' "$(printf '%s' "$v" | cut -c "$(( ${#v} - max + 2 ))-")"
    else
        printf '%s…' "$(printf '%s' "$v" | cut -c "1-$max")"
    fi
}

# Last non-empty line of a file, whitespace-squeezed and clipped to one row.
# When $3 is a grep pattern, the last line MATCHING it wins, falling back to the
# plain last line when nothing matches. The harness's audit.log ends with
# bookkeeping lines (an `outputs: <path>` trailer) that are not progress, so the
# phase-line filter is what keeps the progress column meaningful.
last_line() {
    local f="$1" max="${2:-72}" pattern="${3:-}" line
    [ -f "$f" ] || return 1
    line=''
    [ -n "$pattern" ] && \
        line="$(grep -E "$pattern" "$f" 2>/dev/null | tail -n 1 | tr -s '[:space:]' ' ')"
    [ -z "$line" ] && \
        line="$(grep -v '^[[:space:]]*$' "$f" 2>/dev/null | tail -n 1 | tr -s '[:space:]' ' ')"
    [ -z "$line" ] && return 1
    clip_field "$line" "$max"
}

have_jq() { command -v "$JQ_BIN" >/dev/null 2>&1; }

# Resolve a run's live transcript from its log path, or return 1.
#
# Two terms in the glob. The plain one is the run's own transcript. The
# subagents/ one covers the case this feature exists for: while a /plan run's
# architect sub-agent is working, the PARENT transcript is silent for that
# agent's entire runtime — minutes of a frozen row, which is exactly the freeze
# the placeholder used to show. `ls -t` picks whichever is genuinely newest, so
# the row tracks the sub-agent while it runs and the parent again afterwards.
# This EXTENDS shared-context decision 4 (glob, take the single hit) rather than
# contradicting it: still a glob keyed on the uuid, still no cwd-slug arithmetic.
session_transcript() {
    local log="$1" sc uuid hit
    sc="$(session_sidecar_path "$log")"
    [ -f "$sc" ] || return 1
    uuid="$(head -n 1 "$sc" | tr -d '[:space:]')"
    is_session_id "$uuid" || return 1     # never let an unvalidated value reach a glob
    [ -d "$TRANSCRIPT_ROOT" ] || return 1
    hit="$(ls -t "$TRANSCRIPT_ROOT"/*/"$uuid".jsonl \
                 "$TRANSCRIPT_ROOT"/*/"$uuid"/subagents/agent-*.jsonl 2>/dev/null | head -n 1)"
    [ -n "$hit" ] && [ -f "$hit" ] || return 1
    printf '%s' "$hit"
}

# Transcripts reach 1+ MB, and the records this reader wants are a tiny minority
# of them.
#
# A BYTE WINDOW DOES NOT WORK HERE, which the Phase 7 live smoke is what caught. A
# single `attachment` record routinely exceeds 64 KB -- 81624 bytes observed in a
# real plan-now transcript -- so `tail -c 65536` can land entirely INSIDE one. The
# fragment gets dropped and only the metadata records after it survive, leaving the
# assistant records just before it permanently invisible. The row then shows the
# placeholder for the whole run, which is the exact failure this feature exists to
# remove. Fixtures never caught it because fixture records are a few hundred bytes.
#
# Filter by record type instead. grep emits whole lines, so there is no mid-record
# fragment to drop, and jq only ever parses the handful of records that can
# contribute to the output.
#
# The pattern is the VALUE `"assistant"`, not `"type":"assistant"`: a key-order
# change upstream would silently empty the page under the tighter pattern, and a
# silent empty is indistinguishable from an idle run. Matching the value cannot
# miss. Over-matching is harmless -- every consumer below re-filters on
# `.type=="assistant"`, so a stray record costs one jq parse and nothing else.
transcript_tail() { grep '"assistant"' "$1" 2>/dev/null | tail -n 60; }

transcript_phase() {
    have_jq || return 1
    transcript_tail "$1" | "$JQ_BIN" -R -r '
        fromjson? | select(.type=="assistant")
        | .message.content[]? | select(.type=="text") | .text
        | split("\n")[0] | select(length > 0)' 2>/dev/null | tail -n 1
}

transcript_tool() {
    have_jq || return 1
    transcript_tail "$1" | "$JQ_BIN" -R -r '
        fromjson? | select(.type=="assistant")
        | .message.content[]? | select(.type=="tool_use")
        | [.name, (.input.command // .input.description // .input.file_path
                   // .input.pattern // .input.path // "")] | @tsv' 2>/dev/null | tail -n 1
}

# The branch slug a plan-now run is working on.
#
# Unlike com.ibl5.postplan-now-<slug>-<ts>, the plan-now label carries only a
# timestamp (bin/plan-now sets LABEL="com.ibl5.plan-now-$TS"), so the row would
# otherwise read as an opaque number. The slug lives in the prompt the run was
# fired with — /tmp/plan-now-<ts>.prompt, written by that same script — on a line
# of the form:  - Branch slug: `some-slug`. Base: `master`.
#
# THE PATTERN REQUIRES THE COLON; bin/plan-now's own run_slug() does not. That
# difference is deliberate, not drift. plan-now can afford the loose parse because
# downstream it demands the slug name an existing file under $PLANS_DIR, so a
# garbled match costs it a false negative. This tool has no such backstop — it
# prints whatever it parsed. Checked against 230 real prompt files in /tmp: the
# colon-less form matched the explanatory prose "branch slug, with a `PLAN_FILE`"
# and would have shown PLAN_FILE as the slug; requiring the colon misread none.
prompt_slug() {
    local f="${1:-}" slug
    [ -f "$f" ] || return 1
    slug="$(grep -ioE 'branch slug[*[:space:]]*:[*[:space:]]*`[^`]+`' "$f" 2>/dev/null \
        | head -n 1 | grep -oE '`[^`]+`' | head -n 1 | tr -d '`')"
    # Shape guard. A branch slug is what bin/wt-new accepts; anything else is a
    # parse that went wrong, and showing a wrong slug is worse than showing none.
    case "$slug" in ''|*[!a-zA-Z0-9._-]*) return 1 ;; esac
    [ "${#slug}" -gt 64 ] && return 1
    printf '%s' "$slug"
}

section() { printf '\n%s%s%s\n' "$B" "$1" "$R"; }
note()    { printf '  %s%s%s\n' "$DIM" "$1" "$R"; }

# PIDs already accounted for by an earlier section. Space-delimited (Bash 3.2 has
# no associative arrays). Populated by render_launchd and render_automouse;
# consumed by render_loose, which must therefore run last.
TRACKED_PIDS=" "
track_pid() { TRACKED_PIDS="$TRACKED_PIDS$1 "; }

# True when PID, or ANY of its ancestors, is already tracked. Without the
# ancestry walk the "other sessions" section re-lists every child and grandchild
# of a job the page already showed: each launchd job spawns a caffeinate wrapper
# and a `claude -p`, and each automouse runner spawns a per-phase `claude -p`.
# Measured on a live fleet, that turned 5 real jobs into 12 rows — an overcount in
# exactly the tool whose purpose is to stop overcounting.
pid_is_accounted_for() {
    local pid="${1:-}" hops=0
    while [ -n "$pid" ] && [ "$pid" != "0" ] && [ "$pid" != "1" ] && [ "$hops" -lt 24 ]; do
        case "$TRACKED_PIDS" in *" $pid "*) return 0 ;; esac
        pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
        hops=$(( hops + 1 ))
    done
    return 1
}

# ── section 1: launchd one-shots ───────────────────────────────────────────────
#
# Labels are com.ibl5.<producer>-<suffix>. The suffix maps deterministically to
# this run's log and (for post-plan) its harness output directory, so no search
# is needed — derive the paths.

render_launchd() {
    local count=0 line label pid status suffix producer log outdir progress
    local ident ident_note slug audit progress_tool tf ph tl tool_name tool_tgt

    section "LAUNCHD JOBS  (com.ibl5.*)"

    while IFS= read -r line; do
        pid="$(printf '%s' "$line" | awk '{print $1}')"
        status="$(printf '%s' "$line" | awk '{print $2}')"
        label="$(printf '%s' "$line" | awk '{print $3}')"
        [ -z "$label" ] && continue

        # THE LIVENESS PREDICATE. A loaded label with a "-" PID is a finished or
        # killed job whose plist simply has not been unloaded. Reporting one as
        # running is the single worst failure mode this tool can have.
        case "$pid" in ''|*[!0-9]*) continue ;; esac

        suffix="${label#com.ibl5.}"
        producer="$suffix"; log=''; outdir=''; progress=''; audit=''; progress_tool=''
        ident="$suffix"; ident_note=''

        case "$suffix" in
            postplan-now-*)
                producer="post-plan"
                log="$LOG_DIR/post-plan-now-${suffix#postplan-now-}.log"
                outdir="$HARNESS_OUT/live-${suffix#postplan-now-}"
                ;;
            plan-now-*)
                producer="plan"
                log="$LOG_DIR/${suffix}.log"
                # Slug first, timestamp demoted to a dim tail: the slug is what
                # identifies the run to a human, the timestamp only disambiguates
                # two concurrent runs planning the same slug.
                slug="$(prompt_slug "$LOG_DIR/${suffix}.prompt")" || slug=''
                if [ -n "$slug" ]; then
                    ident="$slug"
                    ident_note="  ${DIM}${suffix#plan-now-}${R}"
                fi
                ;;
            pr-ready-now-*) producer="pr-ready"; log="$LOG_DIR/${suffix}.log" ;;
            docfix-*)       producer="docfix";   log="$LOG_DIR/${suffix}.log" ;;
        esac

        # PROGRESS, best available. The harness audit.log is the only true
        # mid-run phase signal; everything else falls back to the (flush-at-exit,
        # therefore usually empty) launchd log.
        if [ -n "$outdir" ] && [ -f "$outdir/audit.log" ]; then
            audit="$outdir/audit.log"
            progress="$(last_line "$audit" 64 '^\[[0-9:]+\] phase')"
        elif [ -n "$log" ]; then
            progress="$(last_line "$log" 64)"
        fi
        # Last resort: the run's own live transcript. `claude` streams JSONL as it
        # works, so this is the only mid-run signal for a producer that has no
        # audit.log. Gated on $log because the sidecar path derives from it.
        if [ -z "$progress" ] && [ -n "$log" ]; then
            tf="$(session_transcript "$log")" || tf=''
            if [ -n "$tf" ]; then
                ph="$(transcript_phase "$tf")" || ph=''
                tl="$(transcript_tool  "$tf")" || tl=''
                if [ -n "$tl" ]; then
                    tool_name="$(printf '%s' "$tl" | cut -f1)"
                    tool_tgt="$(printf  '%s' "$tl" | cut -f2-)"
                    if [ -n "$tool_tgt" ]; then
                        progress_tool="↳ $tool_name: $(clip_field "$tool_tgt" 52 left)"
                    else
                        progress_tool="↳ $tool_name"
                    fi
                fi
                [ -n "$ph" ] && progress="$(clip_field "$ph" 64)"
                [ -z "$progress" ] && [ -n "$progress_tool" ] && \
                    progress="(working — no assistant text yet)"
            fi
        fi
        if [ -z "$progress" ]; then
            progress="(no output yet — headless runs flush at exit)"
            progress_tool=''
        fi

        count=$(( count + 1 ))
        track_pid "$pid"
        printf '  %s●%s %-10s %s%s%s%s\n' \
            "$GRN" "$R" "$producer" "$B" "$ident" "$R" "$ident_note"
        printf '      pid %-7s up %-8s last-exit-col %s\n' \
            "$pid" "$(human_age "$(pid_elapsed_secs "$pid")")" "$status"
        printf '      %s%s%s\n' "$DIM" "$progress" "$R"
        [ -n "$progress_tool" ] && printf '      %s%s%s\n' "$DIM" "$progress_tool" "$R"
        if [ -n "$audit" ]; then
            printf '      %saudit: %s%s\n' "$DIM" "$(link_file "$audit")" "$R"
        elif [ -n "$log" ]; then
            printf '      %slog: %s%s\n' "$DIM" "$(link_file "$log")" "$R"
        fi
    done <<EOF
$(launchctl list 2>/dev/null | grep 'com\.ibl5\.')
EOF

    [ "$count" -eq 0 ] && note "none running (labels with a '-' PID are finished jobs, not shown)"
    return 0
}

# ── section 2: automouse runners ───────────────────────────────────────────────
#
# bin/automouse/run writes .heartbeat-<pid>-<phase> and .cmdpid-<pid>-<phase> per
# active phase, and removes them on normal exit (cleanup_watcher EXIT trap). They
# survive only a SIGKILL'd or stall-killed runner. The PID is in the filename, so
# aliveness is checkable without trusting the file's existence at all.

render_automouse() {
    local count=0 stale=0 hb base rest pid phase now hb_ts hb_age slug lock attempts slug_ld slug_lb slug_disp

    section "AUTOMOUSE RUNNERS"

    now="$(date +%s)"
    for hb in "$AUTOMOUSE_DIR"/.heartbeat-*; do
        [ -f "$hb" ] || continue
        base="$(basename "$hb")"
        rest="${base#.heartbeat-}"
        pid="${rest%%-*}"
        phase="${rest#*-}"

        if ! pid_alive_matching "$pid" 'automouse'; then
            stale=$(( stale + 1 ))
            continue
        fi

        hb_ts="$(tr -dc '0-9' < "$hb" 2>/dev/null)"
        case "$hb_ts" in
            ''|*[!0-9]*) hb_age='' ;;
            *) hb_age="$(( now - hb_ts ))" ;;
        esac

        # Which plan this runner is on: the lock directory that bin/automouse/run
        # writes a pid file into is authoritative for both nightly (no-arg queue-
        # draining) and one-off (plan <slug>) invocations. Fallback: command-line
        # scrape, which only matches the undocumented explicit .md invocation form.
        slug=''
        for slug_ld in "$AUTOMOUSE_DIR/queue/"*.lock; do
            [ -d "$slug_ld" ] || continue
            [ -f "$slug_ld/pid" ] || continue
            if [ "$(tr -dc '0-9' < "$slug_ld/pid" 2>/dev/null)" = "$pid" ]; then
                slug_lb="$(basename "$slug_ld")"
                slug="${slug_lb%.lock}"
                slug="${slug%.md}"
                break
            fi
        done
        if [ -z "$slug" ]; then
            slug="$(ps -o command= -p "$pid" 2>/dev/null \
                | sed -n 's/.*automouse\/run plan \([^ ]*\)\.md.*/\1/p' \
                | head -n 1)"
        fi
        [ -z "$slug" ] && slug='(unknown plan)'

        # Locks are DIRECTORIES — bin/automouse/run takes them with mkdir, which
        # is the atomic-create primitive. `-f` silently never matches.
        lock=''
        [ -e "$AUTOMOUSE_DIR/queue/$slug.md.lock" ] && lock=' · locked'
        attempts=''
        [ -f "$AUTOMOUSE_DIR/queue/$slug.md.attempts" ] && \
            attempts=" · attempt $(tr -dc '0-9' < "$AUTOMOUSE_DIR/queue/$slug.md.attempts" 2>/dev/null)"

        # Gated on the file existing: $slug here can be the '(unknown plan)'
        # sentinel or a command-line scrape, and a link to a path that is not
        # there opens an error dialog instead of doing nothing.
        slug_disp="$slug"
        { [ -f "$AUTOMOUSE_DIR/queue/$slug.md" ] || [ -L "$AUTOMOUSE_DIR/queue/$slug.md" ]; } && \
            slug_disp="$(link_file "$AUTOMOUSE_DIR/queue/$slug.md" "$slug")"

        count=$(( count + 1 ))
        track_pid "$pid"
        printf '  %s●%s %-10s %s%s%s\n' "$GRN" "$R" "$phase" "$B" "$slug_disp" "$R"
        printf '      pid %-7s up %-8s last activity %s ago%s%s\n' \
            "$pid" "$(human_age "$(pid_elapsed_secs "$pid")")" "$(human_age "$hb_age")" "$lock" "$attempts"
    done

    [ "$count" -eq 0 ] && note "none running"
    [ "$stale" -gt 0 ] && note "$stale stale heartbeat file(s) from dead runs — ignored"
    return 0
}

# ── section 3: queue ───────────────────────────────────────────────────────────

# Wall-clock of automouse's next scheduled fire, e.g. "next run Wed 2026-09-16
# 03:00". Empty on anything unexpected — the header degrades to the bare title
# rather than print a guess.
#
# TWO SOURCES, BOTH REQUIRED, for the reason every other row here is a
# conjunction. The plist is the schedule of record (bin/automouse/run rewrites it
# in burst mode, so a hardcoded 03:00 would go stale), but a plist on disk is
# residue exactly like a heartbeat file: `launchctl bootout` — what
# `bin/automouse/run disarm-tonight` does — leaves it sitting there fully
# populated. Printing its time for an unloaded label would advertise a queue
# drain that will never happen. So: plist for WHEN, loaded label for WHETHER.
#
# Parsed with sed rather than plutil — which is what the sibling reader,
# bin/automouse/run's daily_fire_hhmm(), uses — so this path behaves identically
# under CI's ubuntu runner, where plutil does not exist and the fixture would
# otherwise exercise a different branch there than it does locally. Cost of that
# choice: a binary-format plist parses to nothing and the suffix disappears,
# which fails soft and is the right direction. A StartCalendarInterval holding an
# ARRAY of intervals has no single fire time and is likewise refused, exactly as
# daily_fire_hhmm() refuses it — the `<array>` in bin/automouse/run's one-shot
# template is ProgramArguments, so no plist this repo writes takes that shape.
automouse_next_run() {
    local loaded flat sci h m now_min at_min day
    [ -f "$AUTOMOUSE_PLIST" ] || return 0

    # Anchored — com.ibl5.automouse-morning-digest is a different job. Not
    # `grep -q`: it exits early and SIGPIPEs the writer, which reports 141 on a
    # SUCCESSFUL match under pipefail (.claude/rules/shell-pipefail-grep.md).
    loaded="$(launchctl list 2>/dev/null | grep 'com\.ibl5\.automouse$')"
    [ -n "$loaded" ] || return 0

    flat="$(tr -d ' \t\r\n' < "$AUTOMOUSE_PLIST" 2>/dev/null)"
    sci="${flat#*<key>StartCalendarInterval</key><dict>}"
    [ "$sci" = "$flat" ] && return 0
    sci="${sci%%</dict>*}"

    h="$(printf '%s' "$sci" | sed -n 's|.*<key>Hour</key><integer>\([0-9]*\)</integer>.*|\1|p')"
    m="$(printf '%s' "$sci" | sed -n 's|.*<key>Minute</key><integer>\([0-9]*\)</integer>.*|\1|p')"
    # Validate the digits, never sed's exit status: a missing key yields an empty
    # capture, and a malformed one must not reach the header.
    case "$h" in ''|*[!0-9]*) return 0 ;; esac
    case "$m" in ''|*[!0-9]*) return 0 ;; esac
    [ $(( 10#$h )) -le 23 ] || return 0
    [ $(( 10#$m )) -le 59 ] || return 0

    # 10# again — `date +%H` is zero-padded and $((08)) is an octal error.
    now_min=$(( 10#$(date +%H) * 60 + 10#$(date +%M) ))
    at_min=$(( 10#$h * 60 + 10#$m ))
    if [ "$now_min" -lt "$at_min" ]; then
        day="$(date +'%a %Y-%m-%d')"
    else
        # A calendar day-field bump, NOT epoch + 86400: StartCalendarInterval is
        # wall-clock, so across a DST boundary the two disagree by an hour and
        # only this form matches what launchd will actually do. BSD first, GNU
        # (CI) second.
        day="$(date -v+1d +'%a %Y-%m-%d' 2>/dev/null)"
        [ -z "$day" ] && day="$(date -d '+1 day' +'%a %Y-%m-%d' 2>/dev/null)"
    fi
    [ -n "$day" ] || return 0

    printf 'next run %s %02d:%02d' "$day" "$(( 10#$h ))" "$(( 10#$m ))"
}

render_queue() {
    local count=0 f base next pad

    next="$(automouse_next_run)"
    if [ -n "$next" ]; then
        # $R$DIM inside the argument: section() bolds whatever it is handed, and
        # the schedule is secondary to the title.
        section "AUTOMOUSE QUEUE$R$DIM  ·  $next$R"
    else
        section "AUTOMOUSE QUEUE"
    fi

    for f in "$AUTOMOUSE_DIR"/queue/*.md; do
        { [ -f "$f" ] || [ -L "$f" ]; } || continue
        base="$(basename "$f")"
        count=$(( count + 1 ))
        # Pad OUTSIDE the link. A %-46s over the wrapped string counts the escape
        # bytes as width — the column collapses — and the clickable region would
        # swallow the run of spaces up to the next column.
        pad=''
        [ "${#base}" -lt 46 ] && pad="$(printf '%*s' $(( 46 - ${#base} )) '')"
        # `-e`, not `-f`: mkdir-based locks are directories (see render_automouse).
        if [ -e "$AUTOMOUSE_DIR/queue/$base.lock" ]; then
            printf '  %s▶%s %s%s %sin progress%s\n' \
                "$YEL" "$R" "$(link_file "$f" "$base")" "$pad" "$DIM" "$R"
        else
            printf '  %s·%s %s%s %squeued%s\n' \
                "$DIM" "$R" "$(link_file "$f" "$base")" "$pad" "$DIM" "$R"
        fi
    done

    [ "$count" -eq 0 ] && note "empty"
    return 0
}

# ── section 4: unaccounted headless sessions ───────────────────────────────────
#
# Headless `claude -p` processes with NO job above them — an orphan detector.
#
# Every job the page already showed spawns its own `claude -p` (a launchd job via
# a caffeinate wrapper; an automouse runner once per phase), so listing every
# match would re-count work already on the page: measured on a live fleet, 5 real
# jobs rendered as 12 rows. So each candidate's ancestry is walked, and anything
# descending from an already-printed PID is dropped.
#
# On a healthy fleet this section is therefore EMPTY, and that is the useful
# reading. A row here is a `claude -p` burning tokens with nothing supervising it
# — a run whose parent died, or one started by hand and forgotten.

render_loose() {
    local count=0 pid args name

    section "UNACCOUNTED HEADLESS SESSIONS  (claude -p with no job above them)"

    while IFS= read -r pid; do
        [ -z "$pid" ] && continue
        args="$(ps -o command= -p "$pid" 2>/dev/null)"
        [ -z "$args" ] && continue
        # caffeinate wrappers duplicate their child's command line; skip them so
        # each real session is counted exactly once.
        case "$args" in *"caffeinate "*) continue ;; esac
        pid_is_accounted_for "$pid" && continue
        name="$(printf '%s' "$args" | sed -n 's/.*--name \([^ ]*\).*/\1/p' | head -n 1)"
        [ -z "$name" ] && name='(unnamed)'
        count=$(( count + 1 ))
        printf '  %s●%s pid %-7s up %-8s %s\n' \
            "$YEL" "$R" "$pid" "$(human_age "$(pid_elapsed_secs "$pid")")" "$name"
    done <<EOF
$(pgrep -f 'claude -p' 2>/dev/null)
EOF

    [ "$count" -eq 0 ] && note "none — every running session belongs to a job listed above"
    return 0
}

render_all() {
    printf '%sFLEET STATUS%s  %s%s%s\n' "$B" "$R" "$DIM" "$(date '+%Y-%m-%d %H:%M:%S %Z')" "$R"
    render_launchd
    render_automouse
    render_queue
    render_loose
    printf '\n'
}

if [ "$WATCH" -eq 1 ]; then
    while :; do
        clear
        render_all
        printf '%srefreshing every %ss — ctrl-c to stop%s\n' "$DIM" "$WATCH_SECS" "$R"
        sleep "$WATCH_SECS"
    done
else
    render_all
fi

exit 0
