set_checks aaa1111 red; set_checks bbb2222 red
E_PRCMD="$RW/wrapper"
run_tick
[[ "$(pending_count)" == "1" ]] || fail "integration-real-worker-reconcile: tick 1 left $(pending_count) pending entries (out: $OUT)"
rf="$(find "$STATE_DIR/results" -type f 2>/dev/null | head -1)"
