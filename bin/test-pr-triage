# --- S7: status body is non-JSON garbage on #78 (exit 0 from gh) -> absent on #78,
# and the sweep continues: #79 behind it still reads its good status and arms ---
FIX="$(mktemp -d -p "$TMP")"
protection_json "${PROT_REQ[@]}" > "$FIX/protection.json"
checks_json success success success > "$FIX/checks-$(printf '%040d' 78).json"
