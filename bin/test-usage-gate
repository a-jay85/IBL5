#!/usr/bin/env bash
# Unit and CLI tests for the usage-limit drain/pause/resume gate.
# Phases 1-8 of usage-limit-drain-resume extend this file.
#
# Every test points IBL5_USAGE_GATE_STATE_DIR at a fresh mktemp dir so the real
# state dir is never written, and shadows `security` / `curl` on PATH so the real
# keychain and network are never touched.

set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PASS=0
FAIL=0
FAILED_NAMES=""

pass() { PASS=$((PASS + 1)); echo "  ok   $1"; }
fail() { FAIL=$((FAIL + 1)); FAILED_NAMES="$FAILED_NAMES $1"; echo "  FAIL $1${2:+ — $2}"; }

assert_eq() {  # name expected actual
    if [ "$2" = "$3" ]; then pass "$1"; else fail "$1" "expected [$2] got [$3]"; fi
}
assert_contains() {  # name haystack needle
    case "$2" in *"$3"*) pass "$1" ;; *) fail "$1" "missing [$3] in [$2]" ;; esac
}
assert_file() {  # name path
    if [ -e "$2" ]; then pass "$1"; else fail "$1" "missing file $2"; fi
}
assert_no_file() {  # name path
    if [ ! -e "$2" ]; then pass "$1"; else fail "$1" "unexpected file $2"; fi
}

TMPROOT=$(mktemp -d)
trap 'rm -rf "$TMPROOT"' EXIT

# make_stub_bin <dir> <token|""> <curl-body> [curl-exit]
# PATH-shadowed `security` and `curl`. curl appends a line to <dir>/curl.calls.
make_stub_bin() {
    local dir="$1" tok="$2" body="$3" rc="${4:-0}"
    mkdir -p "$dir"
    if [ -n "$tok" ]; then
        printf '#!/bin/sh\necho '"'"'{"claudeAiOauth":{"accessToken":"%s"}}'"'"'\n' "$tok" > "$dir/security"
    else
        printf '#!/bin/sh\nexit 1\n' > "$dir/security"
    fi
    printf '%s' "$body" > "$dir/curl.body"
    printf '#!/bin/sh\necho call >> "%s/curl.calls"\ncat "%s/curl.body"\nexit %s\n' "$dir" "$dir" "$rc" > "$dir/curl"
    chmod +x "$dir/security" "$dir/curl"
}

curl_calls() {  # <stubdir>
    if [ -f "$1/curl.calls" ]; then wc -l < "$1/curl.calls" | tr -d ' '; else echo 0; fi
}

BODY_A='{"five_hour":{"utilization":41.0,"resets_at":"2026-09-28T20:00:00.123+00:00"},"seven_day":{"utilization":12.0,"resets_at":"2026-10-02T00:00:00+00:00"}}'
BODY_B='{"five_hour":{"utilization":77.0,"resets_at":"2026-09-28T21:00:00+00:00"},"seven_day":{"utilization":30.0,"resets_at":"2026-10-02T00:00:00+00:00"}}'

# new_env: fresh state dir + stub dir, exported for the current test.
new_env() {
    T=$(mktemp -d "$TMPROOT/t.XXXXXX")
    export IBL5_USAGE_GATE_STATE_DIR="$T/state"
    STUB="$T/stub"
    mkdir -p "$IBL5_USAGE_GATE_STATE_DIR/markers"
    ORIG_PATH="${ORIG_PATH:-$PATH}"
    ORIG_HOME="${ORIG_HOME:-$HOME}"
    export HOME="$ORIG_HOME"
    unset IBL5_USAGE_GATE_TEST_MODE
}

# seed_home <account_uuid|"">: isolate HOME; seed ~/.claude.json with the account id.
seed_home() {
    mkdir -p "$T/home"; export HOME="$T/home"
    if [ -n "$1" ]; then printf '{"oauthAccount":{"accountUuid":"%s"}}\n' "$1" > "$HOME/.claude.json"; fi
}
acct_hash() { printf '%s' "$1" | shasum -a 256 | cut -c1-16; }

seed_cache() {  # <fetched_at> <body>
    printf '%s' "$2" | jq --argjson t "$1" '. + {fetched_at:$t}' > "$IBL5_USAGE_GATE_STATE_DIR/cache.json"
}

# ---------------------------------------------------------------- Phase 1

test_fetch_fresh_cache_hit() {
    new_env
    make_stub_bin "$STUB" tok "$BODY_B" 1
    seed_cache "$(date +%s)" "$BODY_A"
    local out rc
    out=$(PATH="$STUB:$ORIG_PATH" bash -c ". '$REPO_ROOT/bin/lib/usage-fetch.sh'; usage_fetch 45"); rc=$?
    assert_eq fetch_fresh_cache_hit:rc 0 "$rc"
    assert_eq fetch_fresh_cache_hit:body "$(printf '%s' "$BODY_A" | jq -S -c .)" "$(printf '%s' "$out" | jq -S -c .)"
    assert_eq fetch_fresh_cache_hit:no-curl 0 "$(curl_calls "$STUB")"
}

test_fetch_stale_triggers_live() {
    new_env
    make_stub_bin "$STUB" tok "$BODY_B"
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    local out rc
    out=$(PATH="$STUB:$ORIG_PATH" bash -c ". '$REPO_ROOT/bin/lib/usage-fetch.sh'; usage_fetch 45"); rc=$?
    assert_eq fetch_stale_triggers_live:rc 0 "$rc"
    assert_eq fetch_stale_triggers_live:body 77.0 "$(printf '%s' "$out" | jq -r '.five_hour.utilization')"
    assert_eq fetch_stale_triggers_live:cache 77.0 "$(jq -r '.five_hour.utilization' "$IBL5_USAGE_GATE_STATE_DIR/cache.json")"
    assert_eq fetch_stale_triggers_live:one-call 1 "$(curl_calls "$STUB")"
}

test_fetch_no_token_fail_open() {
    new_env
    make_stub_bin "$STUB" "" "$BODY_B"
    local out rc
    out=$(PATH="$STUB:$ORIG_PATH" bash -c ". '$REPO_ROOT/bin/lib/usage-fetch.sh'; usage_fetch 45"); rc=$?
    assert_eq fetch_no_token:rc 1 "$rc"
    assert_eq fetch_no_token:empty "" "$out"
    assert_contains fetch_no_token:log "$(cat "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log")" "fetch-failed reason=no-token"
    assert_eq fetch_no_token:no-curl 0 "$(curl_calls "$STUB")"
}

test_fetch_bad_body_serves_stale() {
    new_env
    make_stub_bin "$STUB" tok '{"error":"x"}'
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    local before out rc
    before=$(cat "$IBL5_USAGE_GATE_STATE_DIR/cache.json")
    out=$(PATH="$STUB:$ORIG_PATH" bash -c ". '$REPO_ROOT/bin/lib/usage-fetch.sh'; usage_fetch 45"); rc=$?
    assert_eq fetch_bad_body:rc 2 "$rc"
    assert_eq fetch_bad_body:stale 41.0 "$(printf '%s' "$out" | jq -r '.five_hour.utilization')"
    assert_contains fetch_bad_body:log "$(cat "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log")" "reason=bad-body"
    assert_eq fetch_bad_body:cache-unchanged "$before" "$(cat "$IBL5_USAGE_GATE_STATE_DIR/cache.json")"
}

# seed_cache_fp <fetched_at> <body> <cred_fp>: seed_cache plus a stamped cred_fp.
seed_cache_fp() {
    printf '%s' "$2" | jq --argjson t "$1" --arg fp "$3" '. + {fetched_at:$t, cred_fp:$fp}' \
        > "$IBL5_USAGE_GATE_STATE_DIR/cache.json"
}

test_fetch_cred_switch_drops_cache() {
    new_env
    make_stub_bin "$STUB" tok "$BODY_B"
    seed_cache_fp "$(date +%s)" "$BODY_A" "0000000000000000"
    local d="$IBL5_USAGE_GATE_STATE_DIR" out rc
    printf '%s\n' "$(( $(date +%s) + 600 )) 1" > "$d/fetch-backoff"
    out=$(PATH="$STUB:$ORIG_PATH" bash -c ". '$REPO_ROOT/bin/lib/usage-fetch.sh'; usage_fetch 45"); rc=$?
    assert_eq cred_switch:rc 0 "$rc"
    assert_eq cred_switch:live-body 77.0 "$(printf '%s' "$out" | jq -r '.five_hour.utilization')"
    assert_eq cred_switch:one-call 1 "$(curl_calls "$STUB")"
    assert_eq cred_switch:backoff-cleared "" "$(ls "$d/fetch-backoff" 2>/dev/null)"
    assert_eq cred_switch:no-fp-in-output "null" "$(printf '%s' "$out" | jq -r '.cred_fp')"
    assert_eq cred_switch:fp-stamped "$(printf tok | shasum -a 256 | cut -c1-16)" "$(jq -r '.cred_fp' "$d/cache.json")"
    assert_contains cred_switch:log "$(cat "$d/usage-gate.log")" "cred-switch cache-dropped"
}

test_fetch_same_cred_keeps_cache() {
    new_env
    make_stub_bin "$STUB" tok "$BODY_B" 1
    seed_cache_fp "$(date +%s)" "$BODY_A" "$(printf tok | shasum -a 256 | cut -c1-16)"
    local out
    out=$(PATH="$STUB:$ORIG_PATH" bash -c ". '$REPO_ROOT/bin/lib/usage-fetch.sh'; usage_fetch 45")
    assert_eq same_cred:cached 41.0 "$(printf '%s' "$out" | jq -r '.five_hour.utilization')"
    assert_eq same_cred:no-curl 0 "$(curl_calls "$STUB")"
}

test_fetch_no_keychain_keeps_cache() {
    new_env
    make_stub_bin "$STUB" "" "$BODY_B"
    seed_cache_fp "$(date +%s)" "$BODY_A" "0000000000000000"
    local out rc
    out=$(PATH="$STUB:$ORIG_PATH" bash -c ". '$REPO_ROOT/bin/lib/usage-fetch.sh'; usage_fetch 45"); rc=$?
    assert_eq no_keychain:rc 0 "$rc"
    assert_eq no_keychain:cached 41.0 "$(printf '%s' "$out" | jq -r '.five_hour.utilization')"
    assert_eq no_keychain:no-curl 0 "$(curl_calls "$STUB")"
}

# ---------------------------------------------------------------- fetch backoff / single-flight

SECRET_TOK=TESTSECRET-9f3a1c

# make_stub_http <dir> <token|""> <status> <body> [retry_after|""] [sleep_secs]
# Like make_stub_bin, but the curl stub honors `-D <file>`: it writes an HTTP status
# line (and Retry-After when given) there, CRLF-terminated like real curl.
make_stub_http() {
    local dir="$1" tok="$2" st="$3" body="$4" ra="${5:-}" sl="${6:-0}"
    make_stub_bin "$dir" "$tok" "$body"
    cat > "$dir/curl" <<STUB
#!/bin/sh
hdr=""
while [ \$# -gt 0 ]; do
    case "\$1" in -D) hdr="\$2"; shift ;; esac
    shift
done
echo call >> "$dir/curl.calls"
[ "$sl" -gt 0 ] && sleep "$sl"
if [ -n "\$hdr" ]; then
    printf 'HTTP/2 %s\r\n' "$st" > "\$hdr"
    [ -n "$ra" ] && printf 'retry-after: %s\r\n' "$ra" >> "\$hdr"
    printf '\r\n' >> "\$hdr"
fi
cat "$dir/curl.body"
STUB
    chmod +x "$dir/curl"
}

fetch_once() {  # <max_age>: one usage_fetch; stdout = body; rc = usage_fetch rc
    PATH="$STUB:$ORIG_PATH" bash -c ". '$REPO_ROOT/bin/lib/usage-fetch.sh'; usage_fetch $1"
}

# fetch_parallel <n> <max_age>: n concurrent usage_fetch calls; results in $T/out.<i>, $T/rc.<i>.
# Waits only on its own pids (never a bare `wait`).
fetch_parallel() {
    local i=1 pids=""
    while [ "$i" -le "$1" ]; do
        ( fetch_once "$2" > "$T/out.$i"; echo $? > "$T/rc.$i" ) &
        pids="$pids $!"
        i=$((i + 1))
    done
    for p in $pids; do wait "$p"; done
}

log_count() {  # <fixed-string>: occurrences in usage-gate.log
    local n
    n=$(grep -cF -- "$1" "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log" 2>/dev/null)
    echo "${n:-0}"
}

fetch_log() { cat "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log" 2>/dev/null; }
util_of() { printf '%s' "$1" | jq -r '.five_hour.utilization'; }
# log_re_count <ERE>: lines in usage-gate.log matching an extended regex (full-line pins).
log_re_count() {
    local n
    n=$(grep -cE -- "$1" "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log" 2>/dev/null)
    echo "${n:-0}"
}
LOG_PFX='^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z [0-9]+ '

# assert_backoff_delay <name> <secs>: fetch-backoff until - now lies in [secs-2, secs].
assert_backoff_delay() {
    local u s left
    read -r u s < "$IBL5_USAGE_GATE_STATE_DIR/fetch-backoff" 2>/dev/null
    left=$(( ${u:-0} - $(date +%s) ))
    if [ "$left" -ge $(( $2 - 2 )) ] && [ "$left" -le "$2" ]; then pass "$1"; else fail "$1" "until-now=$left want=$2"; fi
}

# expire_backoff: moves fetch-backoff's until into the past, keeping its step.
expire_backoff() {
    local f="$IBL5_USAGE_GATE_STATE_DIR/fetch-backoff" u s
    read -r u s < "$f" 2>/dev/null
    printf '%s %s\n' "$(( $(date +%s) - 1 ))" "${s:-0}" > "$f"
}

# seed_episode <start_ago> <last_ago> <attempts>: writes fetch-429-episode relative to now.
seed_episode() {
    local now; now=$(date +%s)
    printf '%s %s %s\n' "$((now - $1))" "$((now - $2))" "$3" > "$IBL5_USAGE_GATE_STATE_DIR/fetch-429-episode"
}
episode_attempts() { awk '{print $3}' "$IBL5_USAGE_GATE_STATE_DIR/fetch-429-episode" 2>/dev/null; }

RL_BODY='{"error":{"type":"rate_limit_error","message":"Rate limited. Please try again later."}}'

test_fetch_429_retry_after_arms_backoff() {
    new_env
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    make_stub_http "$STUB" "$SECRET_TOK" 429 "$RL_BODY" 120
    local out rc until step now i
    out=$(fetch_once 45); rc=$?
    assert_eq fetch_429_ra:rc1 2 "$rc"
    assert_eq fetch_429_ra:stale1 41.0 "$(util_of "$out")"
    assert_eq fetch_429_ra:one-call 1 "$(curl_calls "$STUB")"
    assert_contains fetch_429_ra:log "$(fetch_log)" "429-episode start retry_after=120 backoff=120"
    read -r until step < "$IBL5_USAGE_GATE_STATE_DIR/fetch-backoff"
    now=$(date +%s)
    assert_eq fetch_429_ra:step 1 "$step"
    if [ $((until - now)) -ge 118 ] && [ $((until - now)) -le 121 ]; then
        pass fetch_429_ra:until
    else
        fail fetch_429_ra:until "until-now=$((until - now))"
    fi
    for i in 2 3; do
        out=$(fetch_once 45); rc=$?
        assert_eq "fetch_429_ra:rc$i" 2 "$rc"
        assert_eq "fetch_429_ra:stale$i" 41.0 "$(util_of "$out")"
        assert_eq "fetch_429_ra:calls$i" 1 "$(curl_calls "$STUB")"
    done
    assert_eq fetch_429_ra:skip-logged-once 1 "$(log_count backoff-skip)"
    assert_eq fetch_429_ra:no-bad-body 0 "$(log_count bad-body)"
}

test_fetch_429_retry_after_capped() {
    new_env
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    make_stub_http "$STUB" "$SECRET_TOK" 429 "$RL_BODY" 99999
    fetch_once 45 >/dev/null
    assert_contains fetch_429_cap:log "$(fetch_log)" "backoff=900"

    new_env
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    make_stub_http "$STUB" "$SECRET_TOK" 429 "$RL_BODY" 0
    fetch_once 45 >/dev/null
    assert_contains fetch_429_cap:zero-falls-to-exp "$(fetch_log)" "backoff=30"
}

test_fetch_429_exponential_and_expiry() {
    new_env
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    make_stub_http "$STUB" "$SECRET_TOK" 429 "$RL_BODY"
    local bf="$IBL5_USAGE_GATE_STATE_DIR/fetch-backoff" until step
    fetch_once 45 >/dev/null
    assert_contains fetch_429_exp:first "$(fetch_log)" "retry_after=none backoff=30"
    read -r until step < "$bf"
    assert_eq fetch_429_exp:step1 1 "$step"
    printf '%s\n' "$(( $(date +%s) - 1 )) 1" > "$bf"
    fetch_once 45 >/dev/null
    assert_eq fetch_429_exp:live-fetch 2 "$(curl_calls "$STUB")"
    assert_backoff_delay fetch_429_exp:second 60
    read -r until step < "$bf"
    assert_eq fetch_429_exp:step2 2 "$step"
    printf '%s\n' "$(( $(date +%s) - 1 )) 9" > "$bf"
    fetch_once 45 >/dev/null
    assert_backoff_delay fetch_429_exp:cap 480
}

test_fetch_429_concurrent_one_call() {
    new_env
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    make_stub_http "$STUB" "$SECRET_TOK" 429 "$RL_BODY" 120 2
    local i round
    for round in 1 2; do
        fetch_parallel 6 45
        assert_eq "fetch_429_conc:calls$round" 1 "$(curl_calls "$STUB")"
        for i in 1 2 3 4 5 6; do
            assert_eq "fetch_429_conc:rc$round.$i" 2 "$(cat "$T/rc.$i")"
            assert_eq "fetch_429_conc:util$round.$i" 41.0 "$(util_of "$(cat "$T/out.$i")")"
        done
        assert_no_file "fetch_429_conc:no-lock$round" "$IBL5_USAGE_GATE_STATE_DIR/fetch.lock.d"
    done
    assert_eq fetch_429_conc:one-start 1 "$(log_count '429-episode start')"
}

test_fetch_success_clears_backoff() {
    new_env
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    local d="$IBL5_USAGE_GATE_STATE_DIR" out rc
    printf '%s\n' "$(( $(date +%s) - 1 )) 3" > "$d/fetch-backoff"
    printf '%s\n' 12345 > "$d/fetch-backoff.logged"
    make_stub_http "$STUB" "$SECRET_TOK" 200 "$BODY_B"
    out=$(fetch_once 45); rc=$?
    assert_eq fetch_clears:rc 0 "$rc"
    assert_eq fetch_clears:body 77.0 "$(util_of "$out")"
    assert_eq fetch_clears:one-call 1 "$(curl_calls "$STUB")"
    assert_no_file fetch_clears:backoff "$d/fetch-backoff"
    assert_no_file fetch_clears:logged "$d/fetch-backoff.logged"
    make_stub_http "$STUB" "$SECRET_TOK" 429 "$RL_BODY"
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    fetch_once 45 >/dev/null
    assert_contains fetch_clears:no-episode-starts-at-base "$(fetch_log)" "retry_after=none backoff=30"
}

test_fetch_429_no_cache_rc1() {
    new_env
    make_stub_http "$STUB" "$SECRET_TOK" 429 "$RL_BODY"
    local out rc
    out=$(fetch_once 45); rc=$?
    assert_eq fetch_429_nocache:rc1 1 "$rc"
    assert_eq fetch_429_nocache:empty1 "" "$out"
    assert_file fetch_429_nocache:backoff "$IBL5_USAGE_GATE_STATE_DIR/fetch-backoff"
    out=$(fetch_once 45); rc=$?
    assert_eq fetch_429_nocache:rc2 1 "$rc"
    assert_eq fetch_429_nocache:empty2 "" "$out"
    assert_eq fetch_429_nocache:one-call 1 "$(curl_calls "$STUB")"
}

test_fetch_single_flight_parallel() {
    new_env
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    make_stub_http "$STUB" "$SECRET_TOK" 200 "$BODY_B" "" 3
    local i rc saw77=0 n
    fetch_parallel 6 45
    assert_eq fetch_single_flight:calls 1 "$(curl_calls "$STUB")"
    for i in 1 2 3 4 5 6; do
        rc=$(cat "$T/rc.$i")
        if [ "$rc" = 0 ] || [ "$rc" = 2 ]; then pass "fetch_single_flight:rc.$i"; else fail "fetch_single_flight:rc.$i" "rc=$rc"; fi
        [ "$(util_of "$(cat "$T/out.$i")")" = "77.0" ] && saw77=1
    done
    assert_eq fetch_single_flight:saw-fresh 1 "$saw77"
    assert_eq fetch_single_flight:cache 77.0 "$(jq -r '.five_hour.utilization' "$IBL5_USAGE_GATE_STATE_DIR/cache.json")"
    assert_no_file fetch_single_flight:no-lock "$IBL5_USAGE_GATE_STATE_DIR/fetch.lock.d"
    n=$(log_count "fetch-skip reason=in-flight")
    if [ "$n" = 1 ] || [ "$n" = 2 ]; then pass fetch_single_flight:inflight-logged; else fail fetch_single_flight:inflight-logged "count=$n"; fi
}

test_fetch_stale_lock_reclaimed() {
    new_env
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    local d="$IBL5_USAGE_GATE_STATE_DIR" out rc leftovers
    mkdir "$d/fetch.lock.d"
    printf '%s\n' "$(( $(date +%s) - 60 )) 999999" > "$d/fetch.lock.d/at"
    make_stub_http "$STUB" "$SECRET_TOK" 200 "$BODY_B"
    out=$(fetch_once 45); rc=$?
    assert_eq fetch_stale_lock:rc 0 "$rc"
    assert_eq fetch_stale_lock:body 77.0 "$(util_of "$out")"
    assert_eq fetch_stale_lock:one-call 1 "$(curl_calls "$STUB")"
    assert_no_file fetch_stale_lock:lock-gone "$d/fetch.lock.d"
    leftovers=$(ls -d "$d"/fetch.lock.d.stale.* 2>/dev/null)
    assert_eq fetch_stale_lock:no-stale-dir "" "$leftovers"
}

test_fetch_fresh_lock_respected() {
    new_env
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    local d="$IBL5_USAGE_GATE_STATE_DIR" out rc stamp
    mkdir "$d/fetch.lock.d"
    stamp="$(date +%s) 999999"
    printf '%s\n' "$stamp" > "$d/fetch.lock.d/at"
    make_stub_http "$STUB" "$SECRET_TOK" 200 "$BODY_B"
    out=$(fetch_once 45); rc=$?
    assert_eq fetch_fresh_lock:rc 2 "$rc"
    assert_eq fetch_fresh_lock:stale 41.0 "$(util_of "$out")"
    assert_eq fetch_fresh_lock:no-curl 0 "$(curl_calls "$STUB")"
    assert_file fetch_fresh_lock:lock-kept "$d/fetch.lock.d"
    assert_eq fetch_fresh_lock:at-unchanged "$stamp" "$(cat "$d/fetch.lock.d/at")"
    assert_contains fetch_fresh_lock:log "$(fetch_log)" "fetch-skip reason=in-flight"
    rm -f "$d/cache.json"
    out=$(fetch_once 45); rc=$?
    assert_eq fetch_fresh_lock:nocache-rc 1 "$rc"
    assert_eq fetch_fresh_lock:nocache-empty "" "$out"
    assert_eq fetch_fresh_lock:nocache-no-curl 0 "$(curl_calls "$STUB")"
}

test_fetch_orphan_lock_ages_out() {
    new_env
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    local d="$IBL5_USAGE_GATE_STATE_DIR" rc epoch pid
    mkdir "$d/fetch.lock.d"
    make_stub_http "$STUB" "$SECRET_TOK" 200 "$BODY_B"
    fetch_once 45 >/dev/null; rc=$?
    assert_eq fetch_orphan:rc1 2 "$rc"
    assert_eq fetch_orphan:no-curl 0 "$(curl_calls "$STUB")"
    assert_file fetch_orphan:stamped "$d/fetch.lock.d/at"
    read -r epoch pid < "$d/fetch.lock.d/at"
    case "$epoch" in ''|*[!0-9]*) fail fetch_orphan:numeric "epoch=[$epoch]" ;; *) pass fetch_orphan:numeric ;; esac
    printf '%s\n' "$(( $(date +%s) - 60 )) 0" > "$d/fetch.lock.d/at"
    fetch_once 45 >/dev/null; rc=$?
    assert_eq fetch_orphan:rc2 0 "$rc"
    assert_eq fetch_orphan:one-call 1 "$(curl_calls "$STUB")"
}

test_fetch_non_429_errors_no_backoff() {
    new_env
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    local d="$IBL5_USAGE_GATE_STATE_DIR" rc
    make_stub_http "$STUB" "$SECRET_TOK" 500 "$RL_BODY"
    fetch_once 45 >/dev/null; rc=$?
    assert_eq fetch_non429:rc500 2 "$rc"
    assert_contains fetch_non429:log500 "$(fetch_log)" "fetch-failed reason=http-500"
    assert_no_file fetch_non429:no-backoff500 "$d/fetch-backoff"
    make_stub_bin "$STUB" "$SECRET_TOK" "" 28
    fetch_once 45 >/dev/null; rc=$?
    assert_eq fetch_non429:rc28 2 "$rc"
    assert_contains fetch_non429:log28 "$(fetch_log)" "fetch-failed reason=curl-exit-28"
    assert_no_file fetch_non429:no-backoff28 "$d/fetch-backoff"
}

test_fetch_bad_body_200_status() {
    new_env
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    local d="$IBL5_USAGE_GATE_STATE_DIR" rc
    make_stub_http "$STUB" "$SECRET_TOK" 200 '{"error":"x"}'
    fetch_once 45 >/dev/null; rc=$?
    assert_eq fetch_bad200:rc 2 "$rc"
    assert_contains fetch_bad200:log "$(fetch_log)" "fetch-failed reason=bad-body"
    assert_eq fetch_bad200:not-rate-limited 0 "$(log_count rate-limited)"
    assert_no_file fetch_bad200:no-backoff "$d/fetch-backoff"
}

test_fetch_token_never_persisted() {
    new_env
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    local d="$IBL5_USAGE_GATE_STATE_DIR" grc hdrs
    make_stub_http "$STUB" "$SECRET_TOK" 429 "$RL_BODY"
    fetch_once 45 >/dev/null
    printf '%s\n' "$(( $(date +%s) - 1 )) 1" > "$d/fetch-backoff"
    make_stub_http "$STUB" "$SECRET_TOK" 200 "$BODY_B"
    fetch_once 45 >/dev/null
    grep -rF "$SECRET_TOK" "$d" >/dev/null 2>&1; grc=$?
    if [ "$grc" -ne 0 ]; then pass fetch_token_leak:none; else fail fetch_token_leak:none "token found under state dir"; fi
    hdrs=$(ls "$d"/fetch.hdr.* 2>/dev/null)
    assert_eq fetch_token_leak:no-hdr-files "" "$hdrs"
}

test_fetch_rejects_bad_max_age() {
    new_env
