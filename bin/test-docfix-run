# Case 26: empty diff (branch identical to base) → rc 1
SB2="$(build_veronly_repo)"
R="$SB2/repo"
PLAN_V="$SB2/home/claude-plans/$VR_SLUG.md"
( cd "$R" && HOME="$SB2/home" DOCFIX_BASE_REF=master \
