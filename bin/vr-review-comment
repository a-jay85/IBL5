#!/usr/bin/env bun
// bin/vr-review-comment — build the sticky `visual-review` PR comment markdown,
// and (additive) publish brand-new VR screens inline at the top of the PR body.
//
// Reads the change-driven gallery JSON (bin/vr-build-gallery output — cells are
// already classified changed/new/flake against master's committed baseline), the
// coverage JSON (bin/vr-changed-coverage output), and the per-SHA Pages base URL,
// then writes the comment markdown (consumed by
// marocchino/sticky-pull-request-comment in .github/workflows/e2e-tests.yml).
//
// Additive modes (see ADR-0076):
//   --copy-new-screens=DEST   copy each newCells render into DEST, then exit.
//   --update-pr-body=N        splice a new-screens image section into PR #N's
//                             body (offset 0, marker-delimited), then exit.
//
// Additive modes (see ADR-0126 — truly-manual visual rows):
//   --manual-rows-from-pr=N   read PR #N's body, parse the `vr:` cells out of
//                             its `## Manual Testing` bullets, write JSON, exit.
//   --out-json=PATH           destination for the above.
//   --manual-gallery=PATH     the capture spec's status-merged JSON; render the
//                             manual-row sticky comment markdown to --out, exit.
//
// Usage:
//   bin/vr-review-comment --gallery=ibl5/vr-gallery.json --coverage=coverage.json \
//     --pages-url=https://a-jay85.github.io/IBL5/<sha>/visual-review/ --out=vr-review-comment.md
import { readFileSync, writeFileSync, existsSync, mkdirSync, copyFileSync, mkdtempSync, rmSync } from 'fs';
import { tmpdir } from 'os';
import { execFileSync } from 'child_process';
import { resolve, dirname, join } from 'path';
import { fileURLToPath } from 'url';

const __dir = dirname(fileURLToPath(import.meta.url));
const ibl5Dir = resolve(__dir, '..', 'ibl5');

const { buildComment } = await import(resolve(ibl5Dir, 'tests/e2e/vr-review-comment.ts'));
const { buildCopyPlan, buildNewScreensSection, newScreenUrl, normalizeBody, spliceBody } =
  await import(resolve(ibl5Dir, 'tests/e2e/vr-pr-body.ts'));
const { parseManualBullets, buildManualSection, manualShotUrl } =
  await import(resolve(ibl5Dir, 'tests/e2e/vr-manual-rows.ts'));
const {
  parsePrNumber,
  isHeadSha,
  cellsHash,
  renderToken,
  planRender,
  assembleMeta,
  buildScreensBlock,
  extractScreensBlock,
  spliceWithRetry,
  blockImageUrls,
  isNoop,
} = await import(resolve(ibl5Dir, 'tests/e2e/vr-pr-screens.ts'));

const USAGE =
  'Usage: bin/vr-review-comment --gallery=PATH --coverage=PATH --pages-url=URL [--out=PATH]\n' +
  '   or: bin/vr-review-comment --gallery=PATH --copy-new-screens=DEST [--renders-dir=SRC]\n' +
  '   or: bin/vr-review-comment --gallery=PATH --pages-url=URL --update-pr-body=N [--dry-run] [--body-file-in=PATH]\n' +
  '   or: bin/vr-review-comment --manual-rows-from-pr=N [--out-json=PATH] [--body-file-in=PATH]\n' +
  '   or: bin/vr-review-comment --manual-gallery=PATH --pages-url=URL [--out=PATH]\n' +
  '   or: bin/vr-review-comment --screens-plan --pr=N --head-sha=SHA --cells-json=PATH --prev-dir=DIR --before-tree=SHA --after-tree=SHA --gallery-present=true|false --run-url=URL [--body-file-in=PATH]\n' +
  '   or: bin/vr-review-comment --screens-assemble <plan flags> --sides=JSON --before-rows=PATH --after-rows=PATH --out-dir=DIR\n' +
  '   or: bin/vr-review-comment --splice-screens=N --block-file=PATH [--dry-run] [--body-file-in=PATH]\n' +
  '   or: bin/vr-review-comment --screens-urls --block-file=PATH\n' +
  '   or: bin/vr-review-comment --screens-live-check=N [--body-file-in=PATH]';

let galleryPath: string | null = null;
let coveragePath: string | null = null;
let pagesUrl: string | null = null;
let outPath: string | null = null;
let copyDest: string | null = null;
let rendersDir = 'ibl5/vr-gallery';
let updatePr: string | null = null;
let dryRun = false;
let bodyFileIn: string | null = null;
let manualRowsFromPr: string | null = null;
let outJson = 'ibl5/vr-manual-rows.json';
let manualGallery: string | null = null;
let screensPlan = false;
let screensAssemble = false;
let spliceScreens: string | null = null;
let screensUrls = false;
let screensLiveCheck: string | null = null;
let prFlag: string | null = null;
let headShaFlag: string | null = null;
let cellsJson: string | null = null;
let prevDir: string | null = null;
let beforeTreeFlag: string | null = null;
let afterTreeFlag: string | null = null;
let galleryPresentFlag: string | null = null;
let runUrlFlag: string | null = null;
let sidesFlag: string | null = null;
let beforeRowsPath: string | null = null;
let afterRowsPath: string | null = null;
let outDir: string | null = null;
let blockFile: string | null = null;

for (const arg of process.argv.slice(2)) {
  if (arg.startsWith('--gallery=')) galleryPath = arg.slice('--gallery='.length);
  else if (arg.startsWith('--coverage=')) coveragePath = arg.slice('--coverage='.length);
  else if (arg.startsWith('--pages-url=')) pagesUrl = arg.slice('--pages-url='.length);
  else if (arg.startsWith('--out=')) outPath = arg.slice('--out='.length);
  else if (arg.startsWith('--copy-new-screens=')) copyDest = arg.slice('--copy-new-screens='.length);
  else if (arg.startsWith('--renders-dir=')) rendersDir = arg.slice('--renders-dir='.length);
  else if (arg.startsWith('--update-pr-body=')) updatePr = arg.slice('--update-pr-body='.length);
  else if (arg === '--dry-run') dryRun = true;
  else if (arg.startsWith('--body-file-in=')) bodyFileIn = arg.slice('--body-file-in='.length);
  else if (arg.startsWith('--manual-rows-from-pr='))
    manualRowsFromPr = arg.slice('--manual-rows-from-pr='.length);
  else if (arg.startsWith('--out-json=')) outJson = arg.slice('--out-json='.length);
  else if (arg.startsWith('--manual-gallery=')) manualGallery = arg.slice('--manual-gallery='.length);
  else if (arg === '--screens-plan') screensPlan = true;
  else if (arg === '--screens-assemble') screensAssemble = true;
  else if (arg.startsWith('--splice-screens=')) spliceScreens = arg.slice('--splice-screens='.length);
  else if (arg === '--screens-urls') screensUrls = true;
  else if (arg.startsWith('--screens-live-check='))
    screensLiveCheck = arg.slice('--screens-live-check='.length);
  else if (arg.startsWith('--pr=')) prFlag = arg.slice('--pr='.length);
  else if (arg.startsWith('--head-sha=')) headShaFlag = arg.slice('--head-sha='.length);
  else if (arg.startsWith('--cells-json=')) cellsJson = arg.slice('--cells-json='.length);
  else if (arg.startsWith('--prev-dir=')) prevDir = arg.slice('--prev-dir='.length);
  else if (arg.startsWith('--before-tree=')) beforeTreeFlag = arg.slice('--before-tree='.length);
  else if (arg.startsWith('--after-tree=')) afterTreeFlag = arg.slice('--after-tree='.length);
  else if (arg.startsWith('--gallery-present='))
    galleryPresentFlag = arg.slice('--gallery-present='.length);
  else if (arg.startsWith('--run-url=')) runUrlFlag = arg.slice('--run-url='.length);
  else if (arg.startsWith('--sides=')) sidesFlag = arg.slice('--sides='.length);
  else if (arg.startsWith('--before-rows=')) beforeRowsPath = arg.slice('--before-rows='.length);
  else if (arg.startsWith('--after-rows=')) afterRowsPath = arg.slice('--after-rows='.length);
  else if (arg.startsWith('--out-dir=')) outDir = arg.slice('--out-dir='.length);
  else if (arg.startsWith('--block-file=')) blockFile = arg.slice('--block-file='.length);
  else if (arg === '--help') {
    process.stdout.write(USAGE + '\n');
    process.exit(0);
  } else {
    process.stderr.write(`Unknown argument: ${arg}\n${USAGE}\n`);
    process.exit(2);
  }
}

// Screens modes (PR-keyed phone review) — all logic lives in
// tests/e2e/vr-pr-screens.ts; this layer only does gh / fetch / fs I/O.
function invalidFlag(flag: string): never {
  process.stderr.write(`vr-review-comment: invalid ${flag}\n`);
  process.exit(2);
}

function readPrBody(pr: string): string {
  const raw =
    bodyFileIn !== null && existsSync(bodyFileIn)
      ? readFileSync(bodyFileIn, 'utf-8')
      : execFileSync('gh', ['pr', 'view', pr, '--json', 'body', '-q', '.body'], { encoding: 'utf-8' });
  return normalizeBody(raw);
}

function readJsonOrNull(path: string | null): unknown {
  if (path === null || !existsSync(path)) return null;
  try {
    return JSON.parse(readFileSync(path, 'utf-8'));
  } catch {
    return null;
  }
}

function readTextOrEmpty(path: string | null): string {
  if (path === null || !existsSync(path)) return '';
  try {
    return readFileSync(path, 'utf-8');
  } catch {
    return '';
  }
}

function loadPrevManifest(dir: string): { schema: 1; cellsHash: string; beforeTree: string; afterTree: string } | null {
  const m = readJsonOrNull(join(dir, 'manifest.json')) as Record<string, unknown> | null;
  if (
    m !== null &&
    typeof m === 'object' &&
    m.schema === 1 &&
    typeof m.cellsHash === 'string' &&
    typeof m.beforeTree === 'string' &&
    typeof m.afterTree === 'string'
  ) {
    return { schema: 1, cellsHash: m.cellsHash, beforeTree: m.beforeTree, afterTree: m.afterTree };
  }
  return null;
}

function loadPrevRows(dir: string): { cells: string[]; before: object; after: object } | null {
  const r = readJsonOrNull(join(dir, 'rows.json')) as Record<string, unknown> | null;
  if (
    r !== null &&
    typeof r === 'object' &&
    Array.isArray(r.cells) &&
    typeof r.before === 'object' &&
    r.before !== null &&
    typeof r.after === 'object' &&
    r.after !== null
  ) {
    return r as unknown as { cells: string[]; before: object; after: object };
  }
  return null;
}

function loadCapturedRows(path: string | null): unknown[] | null {
  const parsed = readJsonOrNull(path) as unknown;
  if (parsed === null) return null;
  const rows = Array.isArray(parsed)
    ? parsed
    : ((parsed as { results?: unknown; rows?: unknown }).results ?? (parsed as { rows?: unknown }).rows);
  return Array.isArray(rows) ? rows : null;
}

function parseSidesFlag(raw: string): Array<'before' | 'after'> {
  let v: unknown;
  try {
    v = JSON.parse(raw);
  } catch {
    return invalidFlag('--sides');
  }
  if (!Array.isArray(v) || !v.every((x) => x === 'before' || x === 'after')) invalidFlag('--sides');
  return v as Array<'before' | 'after'>;
}

function buildPlanContext() {
  const pr = parsePrNumber(prFlag ?? '');
  if (pr === null) invalidFlag('--pr');
  if (!isHeadSha(headShaFlag ?? '')) invalidFlag('--head-sha');
  if (!isHeadSha(beforeTreeFlag ?? '')) invalidFlag('--before-tree');
  if (!isHeadSha(afterTreeFlag ?? '')) invalidFlag('--after-tree');
  if (galleryPresentFlag !== 'true' && galleryPresentFlag !== 'false') invalidFlag('--gallery-present');
  if (cellsJson === null) invalidFlag('--cells-json');
  if (prevDir === null) invalidFlag('--prev-dir');
  if (runUrlFlag === null) invalidFlag('--run-url');

  const parsedCells = readJsonOrNull(cellsJson) as { rows?: unknown } | null;
  const cells = Array.isArray(parsedCells?.rows) ? (parsedCells.rows as any[]) : [];
  const prevManifest = loadPrevManifest(prevDir as string);
  const prevRows = loadPrevRows(prevDir as string);
  const cur = {
    cellsHash: cellsHash(cells),
    beforeTree: beforeTreeFlag as string,
    afterTree: afterTreeFlag as string,
  };
  return {
    pr: pr as number,
    headSha: headShaFlag as string,
    galleryPresent: galleryPresentFlag === 'true',
    runUrl: runUrlFlag as string,
    cells,
    prevManifest,
    prevRows,
    cur,
  };
}

if (screensPlan || screensAssemble) {
  const ctx = buildPlanContext();
  const buildBlock = (meta: { rows: any; manifest: any }): string =>
    buildScreensBlock({
      pr: ctx.pr,
      headSha: ctx.headSha,
      token: renderToken(meta.manifest),
      rows: meta.rows,
      galleryPresent: ctx.galleryPresent,
      runUrl: ctx.runUrl,
    });

  if (screensPlan) {
    const sides = planRender(ctx.prevManifest, ctx.cur);
    const expected = assembleMeta({
      cells: ctx.cells,
      sides: [],
      captured: { before: null, after: null },
      prevRows: ctx.prevRows,
      prevManifest: ctx.prevManifest,
      cur: ctx.cur,
    });
    const bodyBlock = extractScreensBlock(readPrBody(String(ctx.pr)));
    const noop = isNoop({
      sides,
      expectedBlock: buildBlock(expected),
      bodyBlock,
      prevBlock: readTextOrEmpty(join(prevDir as string, 'block.md')),
    });
    process.stdout.write(
      `sides=${JSON.stringify(sides)}\ncells=${ctx.cells.length}\ncells_hash=${ctx.cur.cellsHash}\nnoop=${noop}\n`
    );
    process.exit(0);
  }

  if (sidesFlag === null) invalidFlag('--sides');
  if (outDir === null) invalidFlag('--out-dir');
  const sides = parseSidesFlag(sidesFlag as string);
  const meta = assembleMeta({
    cells: ctx.cells,
    sides,
    captured: { before: loadCapturedRows(beforeRowsPath), after: loadCapturedRows(afterRowsPath) },
    prevRows: ctx.prevRows,
    prevManifest: ctx.prevManifest,
    cur: ctx.cur,
  });
  mkdirSync(outDir as string, { recursive: true });
  writeFileSync(join(outDir as string, 'manifest.json'), JSON.stringify(meta.manifest, null, 2) + '\n');
  writeFileSync(join(outDir as string, 'rows.json'), JSON.stringify(meta.rows, null, 2) + '\n');
  writeFileSync(join(outDir as string, 'block.md'), buildBlock(meta));
  process.stdout.write(`vr-review-comment: assembled screens block -> ${outDir}\n`);
  process.exit(0);
}

if (spliceScreens !== null) {
  const pr = parsePrNumber(spliceScreens);
  if (pr === null) invalidFlag('--splice-screens');
  if (blockFile === null) invalidFlag('--block-file');
  const block = readFileSync(blockFile as string, 'utf-8');
  const prStr = String(pr);
  let dryState: string | null = null;
  const tmpRoot = mkdtempSync(join(tmpdir(), 'vr-screens-'));
  const readLive = (): string =>
    bodyFileIn !== null && existsSync(bodyFileIn)
      ? readFileSync(bodyFileIn, 'utf-8')
      : execFileSync('gh', ['pr', 'view', prStr, '--json', 'body', '-q', '.body'], { encoding: 'utf-8' });
  const io = {
    read: (): string => (dryRun && dryState !== null ? dryState : readLive()),
    write: (body: string): void => {
      if (dryRun) {
        dryState = body;
        return;
      }
      const tmp = join(tmpRoot, 'body.md');
      writeFileSync(tmp, body + '\n');
      execFileSync('gh', ['pr', 'edit', prStr, '--body-file', tmp], { stdio: 'inherit' });
    },
  };
  const res = spliceWithRetry(io, block.replace(/\n+$/, ''));
  rmSync(tmpRoot, { recursive: true, force: true });
  process.stderr.write(`screens-splice: ${res.outcome} after ${res.attempts} attempt(s)\n`);
  if (res.outcome === 'too-large' || res.outcome === 'malformed' || res.outcome === 'lost') {
    const warn = `::warning::screens-splice: ${res.outcome}; PR body left unchanged\n`;
    (dryRun ? process.stderr : process.stdout).write(warn);
  }
  if (dryRun) process.stdout.write((dryState ?? normalizeBody(readLive())) + '\n');
  process.exit(0);
}

if (screensUrls) {
  if (blockFile === null) invalidFlag('--block-file');
  const urls: string[] = blockImageUrls(readFileSync(blockFile as string, 'utf-8'));
  if (urls.length > 0) process.stdout.write(urls.join('\n') + '\n');
  process.exit(0);
}

if (screensLiveCheck !== null) {
  const pr = parsePrNumber(screensLiveCheck);
  if (pr === null) invalidFlag('--screens-live-check');
  const block = extractScreensBlock(readPrBody(String(pr)));
  if (block === '') {
    process.stdout.write('screens-live-check: no block\n');
    process.exit(0);
  }
  const urls: string[] = blockImageUrls(block);
  let bad = urls.length === 0;
  if (urls.length === 0) process.stdout.write('screens-live-check: block has no image urls\n');
  for (const url of urls) {
    let status = 0;
    try {
      const r = await fetch(url, { signal: AbortSignal.timeout(15000) });
      status = r.status;
    } catch {
      status = 0;
    }
    if (status !== 200) bad = true;
    process.stdout.write(`${status} ${url}\n`);
  }
  process.exit(bad ? 1 : 0);
}

// Manual-row extraction mode (ADR-0126) — read PR #N's body, pull the `vr:`
// cells out of its `## Manual Testing` bullets, write JSON, exit. Needs neither
// the gallery nor a pages URL, so it sits ahead of both. Zero rows still writes
// a well-formed file so every downstream step is a clean no-op.
if (manualRowsFromPr !== null) {
  const raw =
    bodyFileIn !== null && existsSync(bodyFileIn)
      ? readFileSync(bodyFileIn, 'utf-8')
      : execFileSync('gh', ['pr', 'view', manualRowsFromPr, '--json', 'body', '-q', '.body'], {
          encoding: 'utf-8',
        });
  const { rows, errors } = parseManualBullets(raw === 'null' ? '' : raw);
  const dir = dirname(outJson);
  if (dir !== '' && dir !== '.' && !existsSync(dir)) mkdirSync(dir, { recursive: true });
  writeFileSync(outJson, JSON.stringify({ rows, errors }, null, 2) + '\n');
  for (const e of errors) process.stderr.write(`vr-review-comment: ${e}\n`);
  process.stdout.write(
    `vr-review-comment: ${rows.length} manual vr row(s), ${errors.length} error(s) -> ${outJson}\n`
  );
  process.exit(0);
}

// Change-driven gallery JSON — cells are PRE-CLASSIFIED by bin/vr-build-gallery
// (changed/new vs master's committed baseline; flake = self-disagreeing render).
// Absent/garbled ⇒ no diff/infra cells (the uncovered/global sections still
// render from coverage). No git ls-files here: the builder already did the
// tracked-index check (ADR-0069) when it resolved `git show <base.sha>:…`.
// Loaded here (right after arg parsing) because copy mode needs it but not a
// pages URL.
type LeanCell = { module: string; viewport: 'desktop' | 'mobile'; title: string };
type ManualRowResult = { label: string; row: string; status: string; error?: string };
let gallery: { changedCells?: LeanCell[]; newCells?: LeanCell[]; flakeCells?: LeanCell[] } = {};
if (galleryPath !== null && existsSync(galleryPath)) {
  try {
    gallery = JSON.parse(readFileSync(galleryPath, 'utf-8'));
  } catch {
    // keep empty gallery
  }
}
const rawNewCells: LeanCell[] = gallery.newCells ?? [];

// Copy mode — publish each NEW cell's first render into the deploy tree, then exit.
if (copyDest !== null) {
  const plan = buildCopyPlan(rawNewCells, rendersDir, copyDest);
  if (plan.length > 0) mkdirSync(copyDest, { recursive: true });
  for (const { src, dest } of plan) {
    if (existsSync(src)) copyFileSync(src, dest);
    else process.stderr.write(`vr-review-comment: missing render ${src}\n`); // defensive skip
  }
  process.stdout.write(`vr-review-comment: copied ${plan.length} new-screen render(s)\n`);
  process.exit(0);
}

if (pagesUrl === null) {
  process.stderr.write(`--pages-url is required\n${USAGE}\n`);
  process.exit(2);
}

// Bounded readiness poll (I/O — glue only). Returns after first 200 or the cap.
async function waitForFirstScreen(url: string): Promise<boolean> {
  for (let i = 0; i < 6; i++) {
    // ~6 attempts, hard cap ~30s
    try {
      const r = await fetch(url, { method: 'HEAD' });
      if (r.ok) return true;
    } catch {
      // treat as not-ready; keep polling
    }
    await new Promise((res) => setTimeout(res, i < 5 ? 5000 : 0)); // 5s backoff, no tail wait
  }
  return false; // timed out -> proceed anyway
}

// Manual-gallery mode (ADR-0126) — render the manual-row sticky comment markdown
// from the capture spec's status-merged JSON, then exit. Zero rows means
// buildManualSection returns '' and we write NO file, so the sticky-comment step
// has nothing to post (its `if` keys on the file existing).
if (manualGallery !== null) {
  let results: ManualRowResult[] = [];
  if (existsSync(manualGallery)) {
    try {
      const parsed = JSON.parse(readFileSync(manualGallery, 'utf-8'));
      results = Array.isArray(parsed) ? parsed : (parsed.results ?? parsed.rows ?? []);
    } catch {
      // keep zero rows -> no comment, never a crash in CI
    }
  }
  const section = buildManualSection(results, pagesUrl);
  if (section === '') {
    process.stdout.write('vr-review-comment: no manual rows to publish\n');
    process.exit(0);
  }
  const firstOk = results.find((r) => r.status === 'ok');
  if (firstOk !== undefined) {
    const ok = await waitForFirstScreen(manualShotUrl(pagesUrl, firstOk.label));
    if (!ok) process.stderr.write('vr-review-comment: manual shot URL not live; posting anyway\n');
  }
  if (outPath !== null) writeFileSync(outPath, section);
  else process.stdout.write(section);
  process.exit(0);
}

// Update-body mode — splice the new-screens section into the PR body, then exit.
if (updatePr !== null) {
  const section = buildNewScreensSection(rawNewCells, pagesUrl);
  if (dryRun) {
    const cur = bodyFileIn !== null && existsSync(bodyFileIn) ? readFileSync(bodyFileIn, 'utf-8') : '';
    process.stdout.write(spliceBody(normalizeBody(cur), section));
    process.exit(0);
  }
  if (rawNewCells.length > 0) {
    const ok = await waitForFirstScreen(newScreenUrl(pagesUrl, rawNewCells[0].title));
    if (!ok) process.stderr.write('vr-review-comment: new-screen URL not live; editing anyway\n');
  }
  const raw = execFileSync('gh', ['pr', 'view', updatePr, '--json', 'body', '-q', '.body'], {
    encoding: 'utf-8',
  });
  const next = spliceBody(normalizeBody(raw), section);
  const tmp = resolve(process.cwd(), 'vr-pr-body.tmp.md');
  writeFileSync(tmp, next + '\n');
  execFileSync('gh', ['pr', 'edit', updatePr, '--body-file', tmp], { stdio: 'inherit' });
  process.exit(0);
}

// Comment mode (default) — reached only when neither new mode fired above.

// Coverage JSON — fail safe to "review everything" if absent/garbled.
let coverage = { coveredRows: [] as string[], uncoveredChangedPaths: [] as string[], globalChange: true };
if (coveragePath !== null && existsSync(coveragePath)) {
  try {
    coverage = JSON.parse(readFileSync(coveragePath, 'utf-8'));
  } catch {
    // keep the fail-safe default
  }
}

const changedCells = (gallery.changedCells ?? []).map((c) => ({ ...c, isNew: false }));
const newCells = (gallery.newCells ?? []).map((c) => ({ ...c, isNew: true }));
const diffCells = [...changedCells, ...newCells];
const infraCells = gallery.flakeCells ?? [];

const markdown = buildComment({
  diffCells,
  infraCells,
  uncoveredChangedPaths: coverage.uncoveredChangedPaths ?? [],
  globalChange: coverage.globalChange ?? false,
  pagesUrl,
});

if (outPath !== null) {
  writeFileSync(outPath, markdown);
} else {
  process.stdout.write(markdown);
}
