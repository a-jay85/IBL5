# ── Test 26: only: NO-REMOTE on local-only branch ─────────────────────────────
MAIN26="$(new_env)"
# Create a worktree on a branch that was never pushed
WT26_BRANCH="wt-local26"
WT26_DIR="$MAIN26/worktrees/$WT26_BRANCH"
mkdir -p "$(dirname "$WT26_DIR")"
git -C "$MAIN26" worktree add -q -b "$WT26_BRANCH" "$WT26_DIR" master
run_only "$WT26_DIR"
assert_eq "only: NO-REMOTE stdout"  "NO-REMOTE" "$ONLY_OUT"
assert_eq "only: NO-REMOTE exit 0"  "0"         "$ONLY_ST"

# ── Test 27: only: FETCH-FAILED under fetch timeout ───────────────────────────
MAIN27="$(new_env)"
WT27="$(add_worktree "$MAIN27" "wt-ff27" current)"
STUBBIN27="$TMP/stubbin27"
mkdir -p "$STUBBIN27"
cp "$STUBBIN/ioreg" "$STUBBIN27/ioreg"
cp "$STUBBIN/lsof" "$STUBBIN27/lsof"
# Capture real git path before STUBBIN swap — STUBBIN only has ioreg/lsof, not git.
REAL_GIT27="$(command -v git)"
cat > "$STUBBIN27/git" <<SH
#!/bin/sh
for _a; do
    case "\$_a" in fetch) sleep 30; exit 0;; esac
done
exec "$REAL_GIT27" "\$@"
SH
chmod +x "$STUBBIN27/git"
STUBBIN_SAVE27="$STUBBIN"
STUBBIN="$STUBBIN27"
ONLY_ST=0; ONLY_ERR="$TMP/only27.err"
ONLY_OUT="$(WT_SYNC_FETCH_TIMEOUT=1 PATH="$STUBBIN:$PATH" \
            WT_SYNC_IOREG="$STUBBIN/ioreg" \
            WT_SYNC_LOG="$_TICK_LOG" WT_SYNC_LOCK_DIR="$_TICK_LOCKD" \
            WT_SYNC_ENABLED=1 \
            "$TICK" --only "$WT27" 2>"$ONLY_ERR")" || ONLY_ST=$?
STUBBIN="$STUBBIN_SAVE27"
assert_eq "only: FETCH-FAILED stdout"  "FETCH-FAILED" "$ONLY_OUT"
assert_eq "only: FETCH-FAILED exit 0"  "0"            "$ONLY_ST"

# ── Test 28: only: idle gate bypassed ─────────────────────────────────────────
MAIN28="$(new_env)"
WT28="$(add_worktree "$MAIN28" "wt-idle28" current)"
# STUB_IOREG_LINE=0 means operator present (idle 0s < 600s threshold)
STUB_IOREG_LINE="HIDIdleTime = 0" run_only "$WT28"
if [ -n "$ONLY_OUT" ]; then
    pass "only: idle gate bypassed — verdict emitted ($ONLY_OUT)"
else
    failcase "only: idle gate not bypassed — no verdict emitted"
fi

# ── Test 29: only: in-use gate bypassed ───────────────────────────────────────
MAIN29="$(new_env)"
WT29="$(add_worktree "$MAIN29" "wt-inuse29" current)"
WT29_REAL="$(cd "$WT29" && pwd -P)"
STUB_LSOF_LINE="lsof    999 user   3   DIR   $WT29_REAL" run_only "$WT29"
if [ -n "$ONLY_OUT" ]; then
    pass "only: in-use gate bypassed — verdict emitted ($ONLY_OUT)"
else
    failcase "only: in-use gate not bypassed — no verdict emitted"
fi

# ── Test 30: only: main checkout refused; --only with no value exits 2 ────────
MAIN30="$(new_env)"
ONLY_ST30=0
ONLY_OUT30="$(PATH="$STUBBIN:$PATH" WT_SYNC_IOREG="$STUBBIN/ioreg" \
              WT_SYNC_LOG="$_TICK_LOG" WT_SYNC_LOCK_DIR="$_TICK_LOCKD" \
              WT_SYNC_ENABLED=1 \
              "$TICK" --only "$MAIN30" 2>"$TMP/only30.err")" || ONLY_ST30=$?
assert_eq "only: main checkout stdout empty"  ""  "$ONLY_OUT30"
assert_eq "only: main checkout exits 2"       "2" "$ONLY_ST30"
assert_match "only: main checkout stderr"  "main checkout" "$(cat "$TMP/only30.err")"
# Folded: --only with no value exits 2 and does not hang
ONLY_ST30b=0
timeout 5 "$TICK" --only 2>/dev/null; ONLY_ST30b=$? || true
assert_eq "only: no-value exits 2"  "2" "$ONLY_ST30b"

# ── Test 31: only: lock is waited on, never taken ─────────────────────────────
MAIN31="$(new_env)"
WT31="$(add_worktree "$MAIN31" "wt-lock31" current)"
# Write a live PID into the lock file to simulate a running fleet tick
_TICK_LOCK31="$_TICK_LOCKD/wt-sync.lock"
printf '%d\n' "$$" > "$_TICK_LOCK31"
WT_SYNC_ONDEMAND_LOCK_WAIT=2 run_only "$WT31"
if [ -n "$ONLY_OUT" ]; then
    pass "only: lock waited — verdict still emitted ($ONLY_OUT)"
else
    failcase "only: lock wait blocked verdict entirely"
fi
# Assert the lock was never overwritten (it must still hold our shell PID)
if [ -f "$_TICK_LOCK31" ]; then
    LOCK_PID31="$(cat "$_TICK_LOCK31" 2>/dev/null || true)"
    assert_eq "only: lock file holds original PID (never taken)" "$$" "$LOCK_PID31"
else
    failcase "only: lock file was removed by on-demand mode (must not take the lock)"
fi
rm -f "$_TICK_LOCK31"

# ── Hook wrapper tests ────────────────────────────────────────────────────────
HOOK="$SCRIPT_DIR/hooks/wt-sync-session-start.sh"
# Create a synthetic git env with a linked worktree and a fake tick.
MAIN_HOOK="$(new_env)"
WT_HOOK="$(add_worktree "$MAIN_HOOK" "wt-hooktest" current)"
mkdir -p "$MAIN_HOOK/bin"
# Fake tick: ignores args, always emits CURRENT (tests hook routing, not tick logic).
cat > "$MAIN_HOOK/bin/wt-sync-tick" <<'SH'
#!/bin/sh
echo "CURRENT"
SH
chmod +x "$MAIN_HOOK/bin/wt-sync-tick"

# Row 1: linked worktree → verdict printed
HOOK_OUT1="$(CLAUDE_PROJECT_DIR="$WT_HOOK" PATH="$STUBBIN:$PATH" bash "$HOOK" 2>/dev/null || true)"
assert_match "hook: linked worktree yields wt-sync verdict" "^wt-sync: " "$HOOK_OUT1"
HOOK_ST1=0
CLAUDE_PROJECT_DIR="$WT_HOOK" PATH="$STUBBIN:$PATH" bash "$HOOK" >/dev/null 2>/dev/null || HOOK_ST1=$?
assert_eq "hook: linked worktree exits 0" "0" "$HOOK_ST1"

# Row 2: main checkout → silent
HOOK_OUT2="$(CLAUDE_PROJECT_DIR="$MAIN_HOOK" PATH="$STUBBIN:$PATH" bash "$HOOK" 2>/dev/null || true)"
assert_eq "hook: main checkout is silent" "" "$HOOK_OUT2"
HOOK_ST2=0
CLAUDE_PROJECT_DIR="$MAIN_HOOK" PATH="$STUBBIN:$PATH" bash "$HOOK" >/dev/null 2>/dev/null || HOOK_ST2=$?
assert_eq "hook: main checkout exits 0" "0" "$HOOK_ST2"

# Row 3a: non-git directory → silent, exit 0
HOOK_OUT3a="$(CLAUDE_PROJECT_DIR="$TMP" PATH="$STUBBIN:$PATH" bash "$HOOK" 2>/dev/null || true)"
assert_eq "hook: non-git dir is silent" "" "$HOOK_OUT3a"
HOOK_ST3a=0
CLAUDE_PROJECT_DIR="$TMP" PATH="$STUBBIN:$PATH" bash "$HOOK" >/dev/null 2>/dev/null || HOOK_ST3a=$?
assert_eq "hook: non-git dir exits 0" "0" "$HOOK_ST3a"

# Row 3b: tick not executable → silent, exit 0
chmod 0644 "$MAIN_HOOK/bin/wt-sync-tick"
HOOK_OUT3b="$(CLAUDE_PROJECT_DIR="$WT_HOOK" PATH="$STUBBIN:$PATH" bash "$HOOK" 2>/dev/null || true)"
assert_eq "hook: non-executable tick is silent" "" "$HOOK_OUT3b"
HOOK_ST3b=0
CLAUDE_PROJECT_DIR="$WT_HOOK" PATH="$STUBBIN:$PATH" bash "$HOOK" >/dev/null 2>/dev/null || HOOK_ST3b=$?
assert_eq "hook: non-executable tick exits 0" "0" "$HOOK_ST3b"
chmod +x "$MAIN_HOOK/bin/wt-sync-tick"   # restore

# ── Source-level anti-pattern row ─────────────────────────────────────────────
if grep -nE '(reset[[:space:]]+--hard|[[:space:]]stash[[:space:]]|[[:space:]]rebase[[:space:]]|push[[:space:]]+origin|git[[:space:]].*--force)' "$TICK" | grep -vE '^[0-9]+:[[:space:]]*#'; then
    failcase "source-level: wt-sync-tick contains a forbidden git write verb"
else
    pass "source-level: no reset --hard / stash / rebase / push in the tick"
fi

# ── Final report ──────────────────────────────────────────────────────────────
echo ""
if [ "$FAILED" -eq 0 ]; then
    echo "All tests passed."
    exit 0
else
    echo "${FAILED} test(s) FAILED."
    exit 1
fi
