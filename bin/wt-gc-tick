#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/wt-gc-tick — scheduled merged-worktree sweep driver (ADR-0165).
#
# Fired hourly by the launchd LaunchAgent installed by bin/wt-gc-cron-setup.
# Runs the unchanged `bin/cleanup --all` (reaps only proven-merged worktrees;
# in-use and dirty worktrees are skipped by cleanup itself), then counts what
# the sweep must never delete (STALLED, UNPUSHED, EMPTY, OPEN-PR) via the
# read-only bin/wt-status and logs it.
#
# NEVER passes --discard-generated, --discard-closed, or --drop-merged-stashes to bin/cleanup.
# The cleanup argv is a literal; no flag of this script forwards to it.
#
# Gates, in order: kill switch (WT_GC_ENABLED=0), fail-closed HID-idle gate,
# 6h minimum-interval stamp, single-flight PID lock. Every gated skip is exit 0.
# Exit 1 only for a bad flag, an unresolvable repo root, a failed
# bin/cleanup / bin/wt-status, or a failed reap step (so the launchd health
# check alerts).
#
# After the surface counts, six reap steps from bin/lib/wt-gc-reap.sh run in
# order, each in a subshell behind its own kill switch ("0" disables it):
#   empty         WT_GC_REAP_EMPTY         EMPTY worktrees older than
#                                          WT_GC_EMPTY_DAYS (7), re-verified
#   dirty-merged  WT_GC_REAP_DIRTY_MERGED  merged worktrees whose dirt is
#                                          byte-identical to origin/master
#   refs          WT_GC_REAP_REFS          backup branches (PR merged >
#                                          WT_GC_BACKUP_DAYS, 7), refs/tmp,
#                                          refs/wt-sync-backup, refs/backup
#                                          (> WT_GC_REF_DAYS, 14), refs of
#                                          remotes absent from `git remote`
#   tmp-pack      WT_GC_REAP_TMP_PACK      objects/pack/tmp_pack_* older than
#                                          WT_GC_TMP_PACK_DAYS (1), not open
#   docker        WT_GC_DOCKER_PRUNE       image + builder prune, filter
#                                          until=WT_GC_DOCKER_UNTIL (168h)
#   stale-list    WT_GC_STALE_LIST         STALLED/UNPUSHED older than
#                                          WT_GC_STALE_DAYS (7) to
#                                          WT_GC_STALE_FILE for the digest
#
# Archive-first classes (ADR-0165 addendum 2026-11-01). Each is archived under
# refs/wt-gc-archive/<stamp>/ (or a containers-*.json file) before removal.
# Switches: "0" disables; unset or empty = on.
#   WT_GC_ARCHIVE_PRUNE       drop archives older than WT_GC_ARCHIVE_DAYS
#   WT_GC_REAP_DIRTY_ARCHIVE  merged worktrees with dirt that is not identical
#   WT_GC_REAP_DETACHED       detached worktrees at a commit already in master
#   WT_GC_REAP_CLOSED         worktrees of closed PRs whose remote branch is gone
#   WT_GC_DROP_STASHES        stashes on gone branches or already in master
#   WT_GC_REF_FALLBACK        backup branches with no PR, by commit age
#   WT_GC_DOCKER_CONTAINERS   exited ibl5-* containers (docker rm, no volumes)
# Ages in days; empty or non-numeric = invalid, that step is skipped:
#   WT_GC_ARCHIVE_DAYS (90)          WT_GC_DIRTY_ARCHIVE_DAYS (3)
#   WT_GC_DETACHED_DAYS (3)          WT_GC_CLOSED_DAYS (7)
#   WT_GC_STASH_DAYS (7)             WT_GC_BACKUP_FALLBACK_DAYS (14)
#   WT_GC_CONTAINER_DAYS (14)
#   WT_GC_ARCHIVE_STAMP       test seam: epoch seconds that name the archives
# ---
# Every deleted branch/ref is first written as "<sha> <ref>" to a dated file
# under WT_GC_TIPS_DIR. Every probe that gates a delete keeps on error. A step
# failure logs, exits 1 and withholds the stamp, so the next idle tick retries.
#
# Usage: bin/wt-gc-tick [--dry-run] [--force] [--help]
#   --dry-run         Pass --dry-run to cleanup; never write the stamp.
#   --force           Bypass the HID-idle gate and the min-interval stamp.
#   --help            Print this header comment.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=bin/lib/tick-guards.sh disable=SC1091
source "$SCRIPT_DIR/lib/tick-guards.sh"

# launchd and `env -i` runs may lack HOME.
if [ -z "${HOME:-}" ]; then HOME="$(cd ~ 2>/dev/null && pwd)"; export HOME; fi

# ── Env seams (defaults = production; tests override) ─────────────────────────
WT_GC_ENABLED="${WT_GC_ENABLED:-1}"            # "0" = kill switch; any other value = enabled
WT_GC_IDLE_SECS="${WT_GC_IDLE_SECS:-1800}"     # HID idle required before a sweep
WT_GC_MIN_INTERVAL_SECS="${WT_GC_MIN_INTERVAL_SECS:-21600}"  # one real sweep per 6h at most
WT_GC_LOCK_DIR="${WT_GC_LOCK_DIR:-$HOME/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/wt-gc}"
WT_GC_LOG="${WT_GC_LOG:-$WT_GC_LOCK_DIR/wt-gc.log}"
# Absolute on purpose: the launchd PATH once omitted /usr/sbin and a bare
# `ioreg` fail-closed every tick (see bin/wt-sync-tick).
WT_GC_IOREG="${WT_GC_IOREG:-/usr/sbin/ioreg}"
WT_GC_REPO_ROOT="${WT_GC_REPO_ROOT:-}"         # empty = derive main checkout (below)
WT_GC_CLEANUP="${WT_GC_CLEANUP:-$SCRIPT_DIR/cleanup}"        # test seam: argv-capture stub
WT_GC_WT_STATUS="${WT_GC_WT_STATUS:-$SCRIPT_DIR/wt-status}"  # test seam: fixture output
# Per-step kill switches: "0" disables that step only; unset/empty = enabled.
WT_GC_REAP_EMPTY="${WT_GC_REAP_EMPTY:-1}"
WT_GC_REAP_DIRTY_MERGED="${WT_GC_REAP_DIRTY_MERGED:-1}"
WT_GC_REAP_DETACHED="${WT_GC_REAP_DETACHED:-1}"
WT_GC_REAP_CLOSED="${WT_GC_REAP_CLOSED:-1}"
WT_GC_DROP_STASHES="${WT_GC_DROP_STASHES:-1}"
WT_GC_REAP_DIRTY_ARCHIVE="${WT_GC_REAP_DIRTY_ARCHIVE:-1}"   # sub-switch: 0 = byte-identical dirt only
WT_GC_REAP_REFS="${WT_GC_REAP_REFS:-1}"
WT_GC_REF_FALLBACK="${WT_GC_REF_FALLBACK:-1}"   # sub-switch: 0 = backups need a merged PR
WT_GC_REAP_TMP_PACK="${WT_GC_REAP_TMP_PACK:-1}"
WT_GC_DOCKER_PRUNE="${WT_GC_DOCKER_PRUNE:-1}"
WT_GC_DOCKER_CONTAINERS="${WT_GC_DOCKER_CONTAINERS:-1}"
WT_GC_STALE_LIST="${WT_GC_STALE_LIST:-1}"
WT_GC_ARCHIVE_PRUNE="${WT_GC_ARCHIVE_PRUNE:-1}"
# Ages (days) / Docker until-filter. Non-numeric or empty = that step skipped, rc=1.
WT_GC_EMPTY_DAYS="${WT_GC_EMPTY_DAYS-7}"
WT_GC_DIRTY_ARCHIVE_DAYS="${WT_GC_DIRTY_ARCHIVE_DAYS-3}"
WT_GC_DETACHED_DAYS="${WT_GC_DETACHED_DAYS-3}"
WT_GC_CLOSED_DAYS="${WT_GC_CLOSED_DAYS-7}"
WT_GC_STASH_DAYS="${WT_GC_STASH_DAYS-7}"
WT_GC_BACKUP_DAYS="${WT_GC_BACKUP_DAYS-7}"
WT_GC_BACKUP_FALLBACK_DAYS="${WT_GC_BACKUP_FALLBACK_DAYS-14}"
WT_GC_REF_DAYS="${WT_GC_REF_DAYS-14}"
WT_GC_TMP_PACK_DAYS="${WT_GC_TMP_PACK_DAYS-1}"
WT_GC_STALE_DAYS="${WT_GC_STALE_DAYS-7}"
WT_GC_DOCKER_UNTIL="${WT_GC_DOCKER_UNTIL-168h}"
WT_GC_CONTAINER_DAYS="${WT_GC_CONTAINER_DAYS-14}"
WT_GC_ARCHIVE_DAYS="${WT_GC_ARCHIVE_DAYS-90}"
WT_GC_ARCHIVE_STAMP="${WT_GC_ARCHIVE_STAMP:-}"   # test seam: pins keep-ref names; empty = now
# Paths / binaries.
WT_GC_TIPS_DIR="${WT_GC_TIPS_DIR:-$WT_GC_LOCK_DIR/tips}"
WT_GC_STALE_FILE="${WT_GC_STALE_FILE:-$WT_GC_LOCK_DIR/stale-worktrees.tsv}"
WT_GC_WT_REMOVE="${WT_GC_WT_REMOVE:-$SCRIPT_DIR/wt-remove}"
WT_GC_QUEUE_DIR="${WT_GC_QUEUE_DIR:-$HOME/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/automouse/queue}"
WT_GC_SESSION_REGISTRY="${WT_GC_SESSION_REGISTRY:-$HOME/.claude/session-registry/active.json}"
WT_GC_LAUNCHCTL="${WT_GC_LAUNCHCTL:-/bin/launchctl}"
# Unpushed open-PR alert (read-only on worktrees; never pushes or deletes).
WT_GC_PR_ALERT="${WT_GC_PR_ALERT:-1}"   # "0" = alert pass disabled; unset/empty = enabled
# Newest unpushed commit must be at least this many seconds old. Empty or
# non-numeric = the alert pass logs and skips (exit code unchanged).
WT_GC_PR_ALERT_MIN_AGE_SECS="${WT_GC_PR_ALERT_MIN_AGE_SECS-3600}"
WT_GC_PR_ALERT_DIR="${WT_GC_PR_ALERT_DIR:-$WT_GC_LOCK_DIR/pr-alerts}"   # dedupe markers
# Set-but-empty = no sender: the pass logs dm=unavailable and writes no marker.
WT_GC_DISCORD_DM="${WT_GC_DISCORD_DM-$SCRIPT_DIR/discord-dm}"
# The launchd PATH is minimal, so WT_GC_LSOF / WT_GC_GH / WT_GC_DOCKER are
# resolved after the library loads: PATH first, then these dirs. A seam that
# is set, even to "", is used as given and never resolved. "" or a missing
# file means "not found", and the step that needs it keeps everything.
WT_GC_BIN_DIRS="${WT_GC_BIN_DIRS-/usr/sbin:/opt/homebrew/bin:/usr/local/bin}"

# ── Logging ───────────────────────────────────────────────────────────────────
log() {
    local line
    line="$(printf '[%s] %s' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*")"
    printf '%s\n' "$line"
    { mkdir -p "$(dirname "$WT_GC_LOG")" && printf '%s\n' "$line" >> "$WT_GC_LOG"; } 2>/dev/null || true
}

DRY_RUN=0
FORCE=0
while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DRY_RUN=1; shift ;;
        --force)   FORCE=1;   shift ;;
        -h|--help)
            awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"
            exit 0 ;;
        *) log "Unknown option: $1" >&2; exit 1 ;;
    esac
done

# ── Kill switch ───────────────────────────────────────────────────────────────
if [ "$WT_GC_ENABLED" = 0 ]; then
    log "disabled (WT_GC_ENABLED=0) — exiting"
    exit 0
fi

# ── Interval seam validation (fail-closed) ────────────────────────────────────
case "$WT_GC_IDLE_SECS" in
    ''|*[!0-9]*)
        log "invalid WT_GC_IDLE_SECS '$WT_GC_IDLE_SECS' — fail-closed"
        exit 0 ;;
esac
case "$WT_GC_MIN_INTERVAL_SECS" in
    ''|*[!0-9]*)
        log "invalid WT_GC_MIN_INTERVAL_SECS '$WT_GC_MIN_INTERVAL_SECS' — fail-closed"
        exit 0 ;;
esac

# ── Repo root ─────────────────────────────────────────────────────────────────
# shellcheck source=bin/lib/git-helpers.sh disable=SC1091
source "$SCRIPT_DIR/lib/git-helpers.sh"
# shellcheck source=bin/lib/wt-guards.sh disable=SC1091
source "$SCRIPT_DIR/lib/wt-guards.sh"
# shellcheck source=bin/lib/wt-gc-reap.sh disable=SC1091
source "$SCRIPT_DIR/lib/wt-gc-reap.sh"
# shellcheck source=bin/lib/launchd-job.sh disable=SC1091
source "$SCRIPT_DIR/lib/launchd-job.sh"
[ -n "${WT_GC_LSOF+x}" ]   || WT_GC_LSOF="$(_gc_resolve_bin lsof)"
[ -n "${WT_GC_GH+x}" ]     || WT_GC_GH="$(_gc_resolve_bin gh)"
[ -n "${WT_GC_DOCKER+x}" ] || WT_GC_DOCKER="$(_gc_resolve_bin docker)"
if [ -z "$WT_GC_REPO_ROOT" ]; then
    WT_GC_REPO_ROOT="$(main_checkout_root "$SCRIPT_DIR/..")" || WT_GC_REPO_ROOT=""
fi
if [ -z "$WT_GC_REPO_ROOT" ]; then
    log "cannot resolve repo root — aborting"
    exit 1
fi

# ── Presence gate (HID idle) ──────────────────────────────────────────────────
# Fail-closed: missing reader, empty, or non-numeric idle means operator present.
if [ "$FORCE" = 0 ]; then
    idle_rc=0
    idle="$(hid_idle_secs "$WT_GC_IOREG")" || idle_rc=$?
    case "$idle_rc" in
        0) ;;
        1)
            log "idle reader missing or not executable ('$WT_GC_IOREG') — treating as operator present (fail-closed)"
            exit 0
            ;;
        *)
            log "idle value unreadable ('${idle:-<empty>}') — treating as operator present (fail-closed)"
            exit 0
            ;;
    esac
    if [ "$idle" -lt "$WT_GC_IDLE_SECS" ]; then
        log "operator present (idle ${idle}s < threshold ${WT_GC_IDLE_SECS}s) — exiting"
        exit 0
    fi
    log "idle ${idle}s >= threshold ${WT_GC_IDLE_SECS}s — proceeding"
fi

mkdir -p "$WT_GC_LOCK_DIR" 2>/dev/null || true
STAMP_FILE="$WT_GC_LOCK_DIR/last-sweep"
LOCK_FILE="$WT_GC_LOCK_DIR/wt-gc.lock"

# ── Min-interval gate ─────────────────────────────────────────────────────────
# A missing or non-numeric stamp means "never swept".
if [ "$FORCE" = 0 ] && [ "$DRY_RUN" = 0 ] && [ -f "$STAMP_FILE" ]; then
    stamp="$(cat "$STAMP_FILE" 2>/dev/null || true)"
    case "$stamp" in
        ''|*[!0-9]*) ;;
        *)
            ago=$(( $(date +%s) - stamp ))
            if [ "$ago" -lt "$WT_GC_MIN_INTERVAL_SECS" ]; then
                log "last sweep ${ago}s ago < ${WT_GC_MIN_INTERVAL_SECS}s — exiting"
                exit 0
            fi
            ;;
    esac
fi

# ── Single-flight lock ────────────────────────────────────────────────────────
# Event shim for tick_lock_acquire: keeps this tick's log wording.
_gc_lock_event() {
    case "$1" in
        held)         log "previous tick (pid $2) still running — exiting" ;;
        stale)        log "stale lock (pid ${2:-<unreadable>}) — reclaiming" ;;
        write-failed) log "could not write lock file $2 — aborting" ;;
    esac
}
if ! tick_lock_acquire "$LOCK_FILE" _gc_lock_event; then
    exit 0
fi
TMP_OUT="$(mktemp "${TMPDIR:-/tmp}/wt-gc-out.XXXXXX")"
TMP_STATUS="$(mktemp "${TMPDIR:-/tmp}/wt-gc-status.XXXXXX")"
TMP_STEP="$(mktemp "${TMPDIR:-/tmp}/wt-gc-step.XXXXXX")"
trap 'tick_lock_release "$LOCK_FILE"; rm -f "$TMP_OUT" "$TMP_STATUS" "$TMP_STEP"' EXIT

EXIT_CODE=0

# ── Sweep ─────────────────────────────────────────────────────────────────────
# The argv is a literal, never built from caller input.
if [ "$DRY_RUN" = 1 ]; then set -- --all --dry-run; else set -- --all; fi
cleanup_rc=0
(cd "$WT_GC_REPO_ROOT" && "$WT_GC_CLEANUP" "$@") > "$TMP_OUT" 2>&1 || cleanup_rc=$?
{ cat "$TMP_OUT" >> "$WT_GC_LOG"; } 2>/dev/null || true

summary="$(sed -nE 's/^Summary: ([0-9]+) cleaned, ([0-9]+) skipped$/\1 \2/p' "$TMP_OUT" | tail -1)"
cleaned="?"
skipped="?"
summary_state=missing
if [ -n "$summary" ]; then
    cleaned="${summary% *}"
    skipped="${summary#* }"
    summary_state=present
fi
if [ "$cleanup_rc" -ne 0 ] || [ "$summary_state" = missing ]; then
    log "cleanup failed (rc=$cleanup_rc, summary=$summary_state)"
    EXIT_CODE=1
fi

# ── Surface (read-only classifier; never fetches) ─────────────────────────────
status_rc=0
(cd "$WT_GC_REPO_ROOT" && "$WT_GC_WT_STATUS") > "$TMP_STATUS" 2>/dev/null || status_rc=$?
if [ "$status_rc" -ne 0 ]; then
    log "wt-status failed (rc=$status_rc)"
    EXIT_CODE=1
fi

counts="$(awk '
    $1=="STALLED"  {s++}
    $1=="UNPUSHED" {u++}
    $1=="EMPTY"    {e++}
    $1=="OPEN-PR"  {o++}
    $1=="MERGED"   {m++}
    END {printf "%d %d %d %d %d", s, u, e, o, m}' "$TMP_STATUS")"
read -r n_stalled n_unpushed n_empty n_open_pr n_merged <<EOF
$counts
EOF

awk '$1=="STALLED" || $1=="UNPUSHED" {print $1, $2}' "$TMP_STATUS" | while read -r cls wt; do
    log "SURFACE $cls $wt"
done

# ── Unpushed open-PR alert helpers (read-only) ────────────────────────────────
# _pra_wt_for_name <wt-name>: print "<path>\t<branch>" for the worktree whose
# basename is <wt-name> (the name bin/wt-status prints) and that has a branch.
# Returns 1 when none matches or the worktree list fails.
_pra_wt_for_name() {
    local want="$1" porcelain
    porcelain="$(git -C "$WT_GC_REPO_ROOT" worktree list --porcelain 2>/dev/null)" || return 1
    awk -v want="$want" '
        function emit() {
            if (p != "" && b != "" && !f) {
                n = p; sub(/.*\//, "", n)
                if (n == want) { printf "%s\t%s\n", p, b; f = 1 }
            }
            p = ""; b = ""
        }
        /^worktree /            { emit(); p = substr($0, 10) }
        /^branch refs\/heads\// { b = substr($0, 19) }
        END                     { emit(); exit !f }' <<< "$porcelain"
}

# _pra_live_label <branch> <pr-number> <launchctl-list-text>: print the label of
# a live post-plan-now run for <branch> or a live fleet rescue for <pr-number>.
# Returns 0 when one is live, 1 otherwise.
_pra_live_label() {
    local br="$1" pr="$2" snap="$3" _pid _st label
    ljob_postplan_now_live "$(ljob_safe_slug "$br")" "$snap" && return 0
    [ -n "$pr" ] || return 1
    while IFS=$'\t' read -r _pid _st label; do
        case "$label" in
            com.ibl5.post-plan-fleet-"$pr")
                printf '%s\n' "$label"; return 0 ;;
        esac
    done <<< "$snap"
    return 1
}

# _pra_unique_shas <branch>: print, newest first, the commits on refs/heads/<branch>
# with no patch-equivalent twin on refs/remotes/origin/<branch>. Prints nothing
# when every commit has a twin. Returns 2 when rev-list fails, so a failed
# rev-list never reads as "nothing unpushed".
_pra_unique_shas() {
    local br="$1" out rc=0
    out="$(git -C "$WT_GC_REPO_ROOT" rev-list --cherry-pick --right-only \
        "refs/remotes/origin/$br...refs/heads/$br" 2>/dev/null)" || rc=$?
    [ "$rc" -eq 0 ] || return 2
    if [ -n "$out" ]; then printf '%s\n' "$out"; fi
    return 0
}

# alert_unpushed_open_prs: DM the owner once per (branch, local head SHA) when an
# OPEN-PR worktree holds commits with no origin twin, the newest such commit is
# at least WT_GC_PR_ALERT_MIN_AGE_SECS old, and no post-plan-now or fleet run for
# it is live. Read-only on every worktree: never pushes, resets, or deletes.
# The caller runs it in a subshell; it always returns 0.
alert_unpushed_open_prs() {
    local sent=0 suppressed=0 skipped=0 failed=0
    local rows snap now cls wt rest pr hit wt_path br shas newest ct age
    local label head safe marker prev count first subjects more msg dm_rc pr_line
    if [ "$WT_GC_PR_ALERT" = 0 ]; then
        log "pr-alert disabled (WT_GC_PR_ALERT=0)"; return 0
    fi
    case "$WT_GC_PR_ALERT_MIN_AGE_SECS" in
        ''|*[!0-9]*)
            log "pr-alert skipped: invalid WT_GC_PR_ALERT_MIN_AGE_SECS '$WT_GC_PR_ALERT_MIN_AGE_SECS'"
            return 0 ;;
    esac
    rows="$(awk '$1=="OPEN-PR"' "$TMP_STATUS" 2>/dev/null || true)"
    snap="$("$WT_GC_LAUNCHCTL" list 2>/dev/null || true)"
    now="$(date +%s)"
    while read -r cls wt rest <&3; do
        [ -n "$wt" ] || continue
        pr="$(sed -nE 's/.*\(PR #([0-9]+)\).*/\1/p' <<< "$rest")"
        if ! hit="$(_pra_wt_for_name "$wt")"; then
            log "PR-ALERT skip $wt (no branch worktree)"; skipped=$((skipped + 1)); continue
        fi
        wt_path="${hit%%	*}"; br="${hit#*	}"
        if ! git -C "$WT_GC_REPO_ROOT" show-ref --verify --quiet "refs/remotes/origin/$br"; then
            log "PR-ALERT skip $br (no origin ref)"; skipped=$((skipped + 1)); continue
        fi
        if ! shas="$(_pra_unique_shas "$br")"; then
            log "PR-ALERT skip $br (rev-list failed)"; skipped=$((skipped + 1)); continue
        fi
        if [ -z "$shas" ]; then
            log "PR-ALERT twin $br (every commit has an origin twin)"
            suppressed=$((suppressed + 1)); continue
        fi
        newest="$(sed -n '1p' <<< "$shas")"
        ct="$(git -C "$WT_GC_REPO_ROOT" log -1 --format=%ct "$newest" 2>/dev/null || true)"
        case "$ct" in ''|*[!0-9]*)
            log "PR-ALERT skip $br (commit time unreadable)"; skipped=$((skipped + 1)); continue ;;
        esac
        age=$((now - ct))
        if [ "$age" -lt "$WT_GC_PR_ALERT_MIN_AGE_SECS" ]; then
            log "PR-ALERT fresh $br age=${age}s"; suppressed=$((suppressed + 1)); continue
        fi
        if label="$(_pra_live_label "$br" "$pr" "$snap")"; then
            log "PR-ALERT live-run $br ($label)"; suppressed=$((suppressed + 1)); continue
        fi
        if ! head="$(git -C "$WT_GC_REPO_ROOT" rev-parse --verify --quiet "refs/heads/$br")"; then
            log "PR-ALERT skip $br (head unreadable)"; skipped=$((skipped + 1)); continue
        fi
        safe="$(ljob_safe_slug "$br")"
        marker="$WT_GC_PR_ALERT_DIR/$safe"
        prev=""
        if [ -f "$marker" ]; then prev="$(cat "$marker" 2>/dev/null || true)"; fi
        if [ "$prev" = "$head" ]; then
            log "PR-ALERT dedupe $br head=$head"; suppressed=$((suppressed + 1)); continue
        fi
        count="$(grep -c . <<< "$shas")"
        first="$(sed -n '1,15p' <<< "$shas")"
        subjects="$(git -C "$WT_GC_REPO_ROOT" log --no-walk=unsorted --format='- %h %s' --stdin <<< "$first" 2>/dev/null)" \
            || subjects="- (commit subjects unreadable)"
        more=""
        if [ "$count" -gt 15 ]; then more="$(printf '\n- ... and %d more' $((count - 15)))"; fi
        if [ -n "$pr" ]; then pr_line="https://github.com/a-jay85/IBL5/pull/$pr"
        else pr_line="(number not reported by wt-status)"; fi
        msg="$(printf 'wt-gc: open-PR branch has commits not on origin\nPR: %s\nBranch: %s\nWorktree: %s\nLocal head: %s\nUnpushed commits (%s, newest first):\n%s%s' \
            "$pr_line" "$br" "$wt_path" "$head" "$count" "$subjects" "$more")"
        if [ "$DRY_RUN" = 1 ]; then
            log "PR-ALERT would-send $br head=$head unique=$count"; continue
        fi
        if [ -z "$WT_GC_DISCORD_DM" ] || [ ! -x "$WT_GC_DISCORD_DM" ]; then
            log "PR-ALERT dm=unavailable $br ('${WT_GC_DISCORD_DM}')"; failed=$((failed + 1)); continue
        fi
        dm_rc=0
        "$WT_GC_DISCORD_DM" --attempts 2 - <<< "$msg" >> "$WT_GC_LOG" 2>&1 || dm_rc=$?
        if [ "$dm_rc" -ne 0 ]; then
            log "PR-ALERT dm-failed $br rc=$dm_rc (retries next sweep)"; failed=$((failed + 1)); continue
        fi
        { mkdir -p "$WT_GC_PR_ALERT_DIR" && printf '%s\n' "$head" > "$marker"; } 2>/dev/null \
            || log "PR-ALERT marker-write-failed $br ($marker)"
        log "PR-ALERT sent $br head=$head unique=$count"
        sent=$((sent + 1))
    done 3<<< "$rows"
    log "pr-alert done sent=$sent suppressed=$suppressed skipped=$skipped failed=$failed"
    return 0
}

# ── Reap steps (bin/lib/wt-gc-reap.sh) ────────────────────────────────────────
STEPS_FAILED=0
# run_step <name> <switch-value> <switch-name> <fn>: kill switch, then the step
# in a subshell so `set -e` inside it can never abort the sweep. Step log()
# lines reach stdout and the log directly; stray stderr is appended to the log.
run_step() {
    local name="$1" sw="$2" swname="$3" fn="$4" rc=0
    if [ "$sw" = 0 ]; then log "step $name disabled ($swname=0)"; return 0; fi
    # Background + wait: a `( ... ) || cmd` list would run the subshell in a
    # context where bash ignores errexit. errexit covers the step's own
    # commands; helpers a step calls as `f || rc=1` run without it and rely on
    # their explicit returns.
    ( set -euo pipefail; "$fn" ) 2> "$TMP_STEP" &
    wait $! || rc=$?
    { cat "$TMP_STEP" >> "$WT_GC_LOG"; } 2>/dev/null || true
    if [ "$rc" -ne 0 ]; then
        log "step $name failed (rc=$rc) — continuing"
        STEPS_FAILED=$((STEPS_FAILED + 1)); EXIT_CODE=1
    fi
}
log "config WT_GC_ARCHIVE_PRUNE=$WT_GC_ARCHIVE_PRUNE WT_GC_ARCHIVE_DAYS=$WT_GC_ARCHIVE_DAYS" \
    "WT_GC_REAP_DIRTY_ARCHIVE=$WT_GC_REAP_DIRTY_ARCHIVE WT_GC_DIRTY_ARCHIVE_DAYS=$WT_GC_DIRTY_ARCHIVE_DAYS" \
    "WT_GC_REAP_DETACHED=$WT_GC_REAP_DETACHED WT_GC_DETACHED_DAYS=$WT_GC_DETACHED_DAYS" \
    "WT_GC_REAP_CLOSED=$WT_GC_REAP_CLOSED WT_GC_CLOSED_DAYS=$WT_GC_CLOSED_DAYS" \
    "WT_GC_DROP_STASHES=$WT_GC_DROP_STASHES WT_GC_STASH_DAYS=$WT_GC_STASH_DAYS" \
    "WT_GC_REF_FALLBACK=$WT_GC_REF_FALLBACK WT_GC_BACKUP_FALLBACK_DAYS=$WT_GC_BACKUP_FALLBACK_DAYS" \
    "WT_GC_DOCKER_CONTAINERS=$WT_GC_DOCKER_CONTAINERS WT_GC_CONTAINER_DAYS=$WT_GC_CONTAINER_DAYS" \
    "WT_GC_ARCHIVE_STAMP=$WT_GC_ARCHIVE_STAMP"
run_step empty        "$WT_GC_REAP_EMPTY"       WT_GC_REAP_EMPTY        reap_empty_worktrees
run_step dirty-merged "$WT_GC_REAP_DIRTY_MERGED" WT_GC_REAP_DIRTY_MERGED reap_dirty_merged_worktrees
run_step detached     "$WT_GC_REAP_DETACHED"     WT_GC_REAP_DETACHED     reap_detached_snapshots
run_step closed       "$WT_GC_REAP_CLOSED"       WT_GC_REAP_CLOSED       reap_closed_worktrees
run_step stashes      "$WT_GC_DROP_STASHES"      WT_GC_DROP_STASHES      drop_orphan_stashes
run_step refs         "$WT_GC_REAP_REFS"         WT_GC_REAP_REFS         reap_stale_refs
run_step tmp-pack     "$WT_GC_REAP_TMP_PACK"     WT_GC_REAP_TMP_PACK     reap_tmp_packs
run_step docker       "$WT_GC_DOCKER_PRUNE"      WT_GC_DOCKER_PRUNE      docker_prune
run_step stale-list   "$WT_GC_STALE_LIST"        WT_GC_STALE_LIST        write_stale_list
run_step archive-prune "$WT_GC_ARCHIVE_PRUNE"    WT_GC_ARCHIVE_PRUNE     prune_archives
log "reap done steps_failed=$STEPS_FAILED"
# Unpushed open-PR alert. Runs after every cleanup and reap decision, in a
# subshell, so a failure here (even a set -u trip) can change neither those
# decisions nor EXIT_CODE nor the sweep stamp.
( alert_unpushed_open_prs ) || log "pr-alert pass exited rc=$? (exit code unchanged)"

log "done dry_run=$DRY_RUN cleaned=$cleaned skipped=$skipped stalled=$n_stalled unpushed=$n_unpushed empty=$n_empty open_pr=$n_open_pr merged=$n_merged rc=$EXIT_CODE"

if [ "$EXIT_CODE" -eq 0 ] && [ "$DRY_RUN" = 0 ]; then
    date +%s > "$STAMP_FILE" 2>/dev/null || true
fi
exit "$EXIT_CODE"
