# ── Closed-PR worktree reap ───────────────────────────────────────────────────
CL_ON=(WT_GC_REAP_CLOSED=1 WT_GC_ARCHIVE_STAMP=1700000000)
# c_wt <name> <dirt> [oid] [ahead] — STALLED row, cleanup closed-skip line,
# CLOSED PR 9 for the head. The close epoch goes in $CD/gh/9.json.
c_wt() {
    local tip
    mk_wt "$1" "$1" "ahead=${4:-1}" age_days=10 "dirt=$2"
    row STALLED "$1"
    printf '  SKIP %s: PR closed but remote gone (pass --discard-closed to remove)\n' "$1" >> "$CD/skips"
    tip="$(git -C "$ENV_MAIN" rev-parse "refs/heads/$1")"
    printf 'CLOSED\t9\t%s\n' "${3:-$tip}" > "$CD/gh/by-head/$1.json"
}

if should_run CL0-cleanup-skip-literal; then
fx CL0-cleanup-skip-literal
# The closed step finds candidates by this literal in the real bin/cleanup.
CL0_N="$(grep -c 'PR closed but remote gone' "$SCRIPT_DIR/cleanup")"
[ "${CL0_N:-0}" -ge 1 ] || note_err "bin/cleanup no longer prints 'PR closed but remote gone'"
finish_case
fi

if should_run CL1-closed-reaped; then
fx CL1-closed-reaped
c_wt cl1 none
epoch_ago 10 > "$CD/gh/9.json"
rt "${CL_ON[@]}" STUB_SKIP_LINES="$CD/skips" -- --force
chk_rc CL1 0
log_has 'closed reaped cl1 pr=#9' || note_err "not reaped"
[ -d "$(wt_dir cl1)" ] && note_err "worktree still present"
has_branch cl1 && note_err "branch still present"
arch_has 1700000000/wt/cl1 || note_err "no wt archive ref"
arch_has 1700000000/heads/cl1 || note_err "no heads archive ref"
finish_case
fi

if should_run CL2-closed-dirt-archived; then
fx CL2-closed-dirt-archived
c_wt cl2 untracked-diff
epoch_ago 10 > "$CD/gh/9.json"
