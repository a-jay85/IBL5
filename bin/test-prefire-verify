    new_case
    green_plan
    run_gate --plan "$PLAN"
    want_rc 0
    local n
    n=$(pass_files '\.pass$' | wc -l | tr -d ' ')
    [ "$n" -eq 2 ] || note "expected 2 .pass files, got $n"
    want_out "SKIP exec-mutations: the plan has no Executable Mutations rows"
}

