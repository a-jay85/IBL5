#!/usr/bin/env bash
# bin/test-harness-lib — exercises bin/lib/harness.sh.
#
# It cannot judge the lib with the lib, so it keeps its own t_ok/t_bad
# helpers and T_FAIL counter. Each case writes a scenario script that
# sources the lib, runs it under /bin/bash (bash 3.2 on macOS, 5.x on
# Ubuntu), and checks stdout, stderr, and the exit code.

set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB="$SELF_DIR/lib/harness.sh"
BASH_BIN=/bin/bash

T_FAIL=0
t_ok() { printf 'ok: %s\n' "$1"; }
t_bad() { printf 'FAIL: %s\n' "$1"; T_FAIL=$((T_FAIL + 1)); }

WORK=$(mktemp -d "${TMPDIR:-/tmp}/test-harness-lib.XXXXXX")
trap 'rm -rf "$WORK"' EXIT

OUT=""
ERR=""
RC=0

# run_scenario NAME BODY [ENV...]: writes BODY after the lib-sourcing line,
# runs it, and sets OUT, ERR, RC. Extra args are passed to `env` first.
run_scenario() {
    local name="$1" body="$2" script
    shift 2
    script="$WORK/$name.sh"
    {
        printf '. %q\n' "$LIB"
        printf '%s\n' "$body"
    } >"$script"
    RC=0
    if [ "$#" -gt 0 ]; then
        env "$@" "$BASH_BIN" "$script" >"$WORK/$name.out" 2>"$WORK/$name.err" </dev/null || RC=$?
    else
        "$BASH_BIN" "$script" >"$WORK/$name.out" 2>"$WORK/$name.err" </dev/null || RC=$?
    fi
    OUT=$(cat "$WORK/$name.out")
    ERR=$(cat "$WORK/$name.err")
}

has() { grep -qF -- "$2" <<<"$1"; }

case_pass_summary() {
    run_scenario pass_summary 'h_pass a; h_pass b; h_done' "$@"
    if [ "$RC" -eq 0 ] && has "$OUT" "ok: a" &&
        has "$OUT" "RESULT: all passed (2 assertions)"; then
        t_ok "case_pass_summary"
    else
        t_bad "case_pass_summary (rc=$RC out=[$OUT] err=[$ERR])"
    fi
}

case_fail_exits_nonzero() {
    run_scenario fail_exits 'h_pass a; h_fail b detail; h_done'
    if [ "$RC" -eq 1 ] && has "$OUT" "FAIL: b — detail" &&
        has "$OUT" "RESULT: FAILED (1 of 2 assertions failed)"; then
        t_ok "case_fail_exits_nonzero"
    else
        t_bad "case_fail_exits_nonzero (rc=$RC out=[$OUT])"
    fi
}

case_zero_assertions() {
    run_scenario zero 'h_done'
    if [ "$RC" -eq 1 ] && has "$OUT" "no assertions ran"; then
        t_ok "case_zero_assertions"
    else
        t_bad "case_zero_assertions (rc=$RC out=[$OUT])"
    fi
}

case_legacy_failed() {
    run_scenario legacy 'FAILED=1; h_pass a; h_done'
    if [ "$RC" -eq 1 ] && has "$OUT" "legacy FAILED=1"; then
        t_ok "case_legacy_failed"
    else
        t_bad "case_legacy_failed (rc=$RC out=[$OUT])"
    fi
}

case_errexit_safe() {
    run_scenario errexit 'set -euo pipefail
h_fail x
h_eq e 1 2
h_contains c abc zz
echo reached
h_done'
    if [ "$RC" -eq 1 ] && has "$OUT" "reached" &&
        has "$OUT" "RESULT: FAILED (3 of 3 assertions failed)"; then
        t_ok "case_errexit_safe"
    else
        t_bad "case_errexit_safe (rc=$RC out=[$OUT] err=[$ERR])"
    fi
}

case_eq() {
    run_scenario eq 'h_eq l 1 1; h_eq l 1 2; h_done'
    if [ "$RC" -eq 1 ] && has "$OUT" "ok: l" && has "$OUT" "FAIL: l — want [1] got [2]" &&
        has "$OUT" "RESULT: FAILED (1 of 2 assertions failed)"; then
        t_ok "case_eq"
    else
        t_bad "case_eq (rc=$RC out=[$OUT])"
    fi
}

case_contains_fixed_string() {
    run_scenario contains "h_contains regex abc a.c
h_contains bracket 'x[1]y' '[1]'
h_not_contains negated abc b
h_contains glob abc 'a?c'
h_contains globclass x1y '[1]'
h_done"
    if [ "$RC" -eq 1 ] && has "$OUT" "FAIL: regex — missing [a.c]" &&
        has "$OUT" "ok: bracket" && has "$OUT" "FAIL: negated — unexpected [b]" &&
        has "$OUT" "FAIL: glob — missing [a?c]" &&
        has "$OUT" "FAIL: globclass — missing [[1]]" &&
        has "$OUT" "RESULT: FAILED (4 of 5 assertions failed)"; then
        t_ok "case_contains_fixed_string"
    else
        t_bad "case_contains_fixed_string (rc=$RC out=[$OUT])"
    fi
}

case_exists_absent() {
    local f="$WORK/present-file" m="$WORK/missing-path"
    : >"$f"
    run_scenario exists "h_exists e1 $(printf '%q' "$f")
h_exists e2 $(printf '%q' "$m")
h_absent a1 $(printf '%q' "$m")
h_absent a2 $(printf '%q' "$f")
h_done"
    if [ "$RC" -eq 1 ] && has "$OUT" "ok: e1" && has "$OUT" "FAIL: e2 — no such path" &&
        has "$OUT" "ok: a1" && has "$OUT" "FAIL: a2 — path exists" &&
        has "$OUT" "RESULT: FAILED (2 of 4 assertions failed)"; then
        t_ok "case_exists_absent"
    else
        t_bad "case_exists_absent (rc=$RC out=[$OUT])"
    fi
}

case_near_inclusive() {
    run_scenario near 'h_near edge 10 15 5; h_near over 10 16 5; h_done'
    if [ "$RC" -eq 1 ] && has "$OUT" "ok: edge" && has "$OUT" "FAIL: over" &&
        has "$OUT" "RESULT: FAILED (1 of 2 assertions failed)"; then
        t_ok "case_near_inclusive"
    else
        t_bad "case_near_inclusive (rc=$RC out=[$OUT])"
    fi
}

case_tmp_trap_cleans() {
    run_scenario tmp_trap 'h_tmp A; h_tmp B
[ -d "$A" ] && [ -d "$B" ] && [ "$A" != "$B" ] && h_pass both-exist
echo "A=$A"; echo "B=$B"
h_done'
    local a b
    a=$(sed -n 's/^A=//p' <<<"$OUT")
    b=$(sed -n 's/^B=//p' <<<"$OUT")
    if [ "$RC" -eq 0 ] && has "$OUT" "ok: both-exist" && [ -n "$a" ] && [ -n "$b" ] &&
        [ ! -e "$a" ] && [ ! -e "$b" ]; then
        t_ok "case_tmp_trap_cleans"
    else
        t_bad "case_tmp_trap_cleans (rc=$RC out=[$OUT] err=[$ERR])"
    fi
}

case_tmp_respects_existing_trap() {
    local d1 d2
    run_scenario tmp_own_trap "trap 'echo mytrap' EXIT
h_tmp D
echo \"D=\$D\"
h_pass a
h_done"
    d1=$(sed -n 's/^D=//p' <<<"$OUT")
    run_scenario tmp_cleanup_trap 'trap h_cleanup EXIT
h_tmp D
echo "D=$D"
h_pass a
h_done'
    d2=$(sed -n 's/^D=//p' <<<"$OUT")
    if has "$(cat "$WORK/tmp_own_trap.out")" "mytrap" && [ -n "$d1" ] && [ -d "$d1" ] &&
        [ -n "$d2" ] && [ ! -e "$d2" ]; then
        t_ok "case_tmp_respects_existing_trap"
    else
        t_bad "case_tmp_respects_existing_trap (d1=[$d1] d2=[$d2] out=[$OUT])"
    fi
    [ -n "$d1" ] && rm -rf "$d1"
}

case_git_repo_default() {
    run_scenario git_default 'h_tmp T
h_git_repo "$T/r"
echo "branch=$(git -C "$T/r" symbolic-ref --short HEAD)"
echo "count=$(git -C "$T/r" rev-list --count HEAD)"
echo "email=$(git -C "$T/r" config --local user.email)"
echo "gpg=$(git -C "$T/r" config --local commit.gpgsign)"
h_pass a
h_done' "$@"
    if [ "$RC" -eq 0 ] && has "$OUT" "branch=master" && has "$OUT" "count=1" &&
        has "$OUT" "email=harness@example.invalid" && has "$OUT" "gpg=false"; then
        t_ok "case_git_repo_default"
    else
        t_bad "case_git_repo_default (rc=$RC out=[$OUT] err=[$ERR])"
    fi
}

case_git_repo_no_commit() {
    run_scenario git_no_commit 'h_tmp T
h_git_repo "$T/r" --no-commit
if git -C "$T/r" rev-parse --verify -q HEAD >/dev/null; then echo head=yes; else echo head=no; fi
echo "ref=$(git -C "$T/r" symbolic-ref HEAD)"
h_pass a
h_done'
    if [ "$RC" -eq 0 ] && has "$OUT" "head=no" && has "$OUT" "ref=refs/heads/master"; then
        t_ok "case_git_repo_no_commit"
    else
        t_bad "case_git_repo_no_commit (rc=$RC out=[$OUT] err=[$ERR])"
    fi
}

case_git_repo_bare_origin() {
    run_scenario git_bare 'h_tmp T
h_git_repo "$T/r" --bare-origin
echo "bare=$(git -C "$H_ORIGIN" rev-parse --is-bare-repository)"
if [ "$(git -C "$H_ORIGIN" rev-parse master)" = "$(git -C "$T/r" rev-parse HEAD)" ]; then echo same=yes; fi
h_pass a
h_done'
    if [ "$RC" -eq 0 ] && has "$OUT" "bare=true" && has "$OUT" "same=yes"; then
        t_ok "case_git_repo_bare_origin"
    else
        t_bad "case_git_repo_bare_origin (rc=$RC out=[$OUT] err=[$ERR])"
    fi
}

case_git_repo_unknown_flag() {
    run_scenario git_bogus 'h_tmp T
h_git_repo "$T/r" --bogus
echo after
h_pass a
h_done'
    if [ "$RC" -eq 2 ] && has "$ERR" "HARNESS-SETUP: h_git_repo: unknown flag --bogus" &&
        ! has "$OUT" "after"; then
        t_ok "case_git_repo_unknown_flag"
    else
        t_bad "case_git_repo_unknown_flag (rc=$RC out=[$OUT] err=[$ERR])"
    fi
}

case_env_i() {
    local before=$T_FAIL
    case_pass_summary -i PATH=/usr/bin:/bin
    case_git_repo_default -i PATH=/usr/bin:/bin
    if [ "$T_FAIL" -eq "$before" ]; then
        t_ok "case_env_i"
    else
        t_bad "case_env_i"
    fi
}

case_double_source() {
    run_scenario double_source "h_pass a
. $(printf '%q' "$LIB")
echo \"count=\$H_PASS\"
h_done"
    if [ "$RC" -eq 0 ] && has "$OUT" "count=1" &&
        has "$OUT" "RESULT: all passed (1 assertions)"; then
        t_ok "case_double_source"
    else
        t_bad "case_double_source (rc=$RC out=[$OUT])"
    fi
}

# A blank TMPDIR must fall back to /tmp. With ${TMPDIR-/tmp} the dir would
# land at /h.XXXXXX (or mktemp would fail with rc 2).
case_tmp_blank_tmpdir() {
    run_scenario tmp_blank 'h_tmp D
echo "D=$D"
h_pass a
h_done' TMPDIR=
    local d
    d=$(sed -n 's/^D=//p' <<<"$OUT")
    case "$d" in
        /tmp/h.*) [ "$RC" -eq 0 ] && t_ok "case_tmp_blank_tmpdir" ||
            t_bad "case_tmp_blank_tmpdir (rc=$RC out=[$OUT] err=[$ERR])" ;;
        *) t_bad "case_tmp_blank_tmpdir (dir=[$d] rc=$RC err=[$ERR])" ;;
    esac
}

# bpt_ok/bpt_fail in bin/lib/bug-pipeline-test-stubs.sh delegate to the lib.
# bpt_ok must still print exactly `ok: <label>` (an `okay:` line would drop
# the bug-pipeline harnesses' pass counts), and bpt_fail must count in H_FAIL
# and keep setting the legacy FAILED flag.
case_bpt_delegates() {
    run_scenario bpt_delegates ". $(printf '%q' "$SELF_DIR/lib/bug-pipeline-test-stubs.sh")
bpt_ok x
bpt_fail y
echo \"pass=\$H_PASS fail=\$H_FAIL legacy=\$FAILED\"
h_done"
    if grep -qxF "ok: x" <<<"$OUT" && grep -qxF "FAIL: y" <<<"$OUT" &&
        has "$OUT" "pass=1 fail=1 legacy=1" && [ "$RC" -eq 1 ]; then
        t_ok "case_bpt_delegates"
    else
        t_bad "case_bpt_delegates (rc=$RC out=[$OUT] err=[$ERR])"
    fi
}

# _usage_fake_home DIR PCT: a fake HOME whose default usage-gate dir holds a
# fresh cache at PCT five-hour utilization. Prints the default dir.
_usage_fake_home() {
    local sd="$1/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/usage-gate"
    mkdir -p "$sd/markers"
    printf '{"five_hour":{"utilization":%s},"seven_day":{"utilization":10},"fetched_at":%s}\n' \
        "$2" "$(date +%s)" >"$sd/cache.json"
    printf '%s\n' "$sd"
}

# Sourcing the harness isolates the usage gate: a private state dir, a private
# projects dir, and test mode on, none of them under the (fake) HOME.
case_usage_isolation_env() {
    local sd cp tm fake_default
    fake_default="$WORK/home-env/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/usage-gate"
    run_scenario usage_env 'echo "SD=$IBL5_USAGE_GATE_STATE_DIR"
echo "CP=$IBL5_USAGE_CLAUDE_PROJECTS"
echo "TM=$IBL5_USAGE_GATE_TEST_MODE"
[ -d "$IBL5_USAGE_GATE_STATE_DIR/markers" ] && [ -d "$IBL5_USAGE_CLAUDE_PROJECTS" ] && h_pass dirs
h_done' HOME="$WORK/home-env"
    sd=$(sed -n 's/^SD=//p' <<<"$OUT")
    cp=$(sed -n 's/^CP=//p' <<<"$OUT")
    tm=$(sed -n 's/^TM=//p' <<<"$OUT")
    local parent=${sd%/state}
    case "$sd" in
        */state) ;;
        *) t_bad "case_usage_isolation_env (sd=[$sd])"; return ;;
    esac
    if [ "$RC" -eq 0 ] && [ "$tm" = 1 ] && [ "$sd" != "$fake_default" ] &&
        [[ "$(basename "$parent")" == h.* ]] && [[ "$cp" == */projects ]] &&
        [ ! -e "$parent" ]; then
        t_ok "case_usage_isolation_env"
    else
        t_bad "case_usage_isolation_env (rc=$RC sd=[$sd] cp=[$cp] tm=[$tm] err=[$ERR])"
    fi
}

# Inherited real-looking values are overwritten, not honored.
case_usage_isolation_overwrites() {
    local sd cp tm fake_default
    fake_default="$WORK/home-ow/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/usage-gate"
    run_scenario usage_overwrite 'echo "SD=$IBL5_USAGE_GATE_STATE_DIR"
echo "CP=$IBL5_USAGE_CLAUDE_PROJECTS"
echo "TM=$IBL5_USAGE_GATE_TEST_MODE"
h_pass a
h_done' HOME="$WORK/home-ow" IBL5_USAGE_GATE_STATE_DIR="$fake_default" \
        IBL5_USAGE_CLAUDE_PROJECTS="$WORK/home-ow/.claude/projects" IBL5_USAGE_GATE_TEST_MODE=
    sd=$(sed -n 's/^SD=//p' <<<"$OUT")
    cp=$(sed -n 's/^CP=//p' <<<"$OUT")
    tm=$(sed -n 's/^TM=//p' <<<"$OUT")
    if [ "$RC" -eq 0 ] && [ "$tm" = 1 ] && [ "$sd" != "$fake_default" ] &&
        [ "$cp" != "$WORK/home-ow/.claude/projects" ] && [ -n "$sd" ] && [ -n "$cp" ]; then
        t_ok "case_usage_isolation_overwrites"
    else
        t_bad "case_usage_isolation_overwrites (rc=$RC sd=[$sd] cp=[$cp] tm=[$tm] err=[$ERR])"
    fi
}

# A harness consumer under a fake HOME holding a fresh 95% cache at the default
# path must not read it: prestart passes (fail open) and nothing is written
# beside that cache.
case_usage_isolation_prestart_fail_open() {
    local sd files markers
    sd=$(_usage_fake_home "$WORK/home-pre" 95)
    run_scenario usage_prestart ". $(printf '%q' "$SELF_DIR/lib/usage-gate.sh")
usage_prestart_gate automouse sid-x /x/run
echo \"PRE=\$?\"
h_pass ran
h_done" HOME="$WORK/home-pre"
    files=$(find "$sd" -type f)
    markers=$(ls -A "$sd/markers")
    if [ "$RC" -eq 0 ] && has "$OUT" "PRE=0" && [ "$files" = "$sd/cache.json" ] &&
        [ -z "$markers" ] && ! has "$ERR" "USAGE-GATE-TEST: refusing"; then
        t_ok "case_usage_isolation_prestart_fail_open"
    else
        t_bad "case_usage_isolation_prestart_fail_open (rc=$RC out=[$OUT] files=[$files] markers=[$markers] err=[$ERR])"
    fi
}

# The harness and the isolation lib both source cleanly under a launchd-like
# empty environment with set -euo pipefail.
case_usage_isolation_lib_env_i() {
    local rc1=0 rc2=0 out1 out2 err1 err2
    {
        printf 'set -euo pipefail\n'
        printf '. %q\n' "$LIB"
        printf 'echo "TM=$IBL5_USAGE_GATE_TEST_MODE"\nh_pass a\nh_done\n'
    } >"$WORK/usage_env_i.sh"
    {
        printf 'set -euo pipefail\n'
        printf '. %q\n' "$SELF_DIR/lib/usage-test-isolation.sh"
        printf 'd=$(mktemp -d)\nusage_test_isolate "$d"\n'
        printf 'echo "TM=$IBL5_USAGE_GATE_TEST_MODE"\necho "SD=$IBL5_USAGE_GATE_STATE_DIR"\n'
        printf 'test "$IBL5_USAGE_GATE_TEST_MODE" = 1 && echo ISOLATE-OK\nrm -rf "$d"\n'
    } >"$WORK/usage_env_i2.sh"
    env -i PATH=/usr/bin:/bin "$BASH_BIN" "$WORK/usage_env_i.sh" >"$WORK/usage_env_i.out" 2>"$WORK/usage_env_i.err" </dev/null || rc1=$?
    env -i PATH=/usr/bin:/bin "$BASH_BIN" "$WORK/usage_env_i2.sh" >"$WORK/usage_env_i2.out" 2>"$WORK/usage_env_i2.err" </dev/null || rc2=$?
    out1=$(cat "$WORK/usage_env_i.out")
    out2=$(cat "$WORK/usage_env_i2.out")
    err1=$(cat "$WORK/usage_env_i.err")
    err2=$(cat "$WORK/usage_env_i2.err")
    if [ "$rc1" -eq 0 ] && [ "$rc2" -eq 0 ] && has "$out1" "TM=1" && has "$out2" "TM=1" &&
        has "$out2" "/state" && has "$out2" "ISOLATE-OK" && ! has "$err1" "unbound variable" && ! has "$err2" "unbound variable"; then
        t_ok "case_usage_isolation_lib_env_i"
    else
        t_bad "case_usage_isolation_lib_env_i (rc1=$rc1 rc2=$rc2 out1=[$out1] out2=[$out2] err1=[$err1] err2=[$err2])"
    fi
}

# Every bin/test-* that sources harness.sh (directly or through the
# bug-pipeline stubs lib) must end with exactly one `h_done` and keep no
# legacy `exit "$FAILED"` tail. A harness that forgets h_done exits 0 even
# when its checks fail.
case_consumers_end_with_h_done() {
    local f last bad=0
    for f in "$SELF_DIR"/test-*; do
        [ "$f" = "$SELF_DIR/test-harness-lib" ] && continue
        grep -qE '^[[:space:]]*(\.|source)[[:space:]].*lib/(harness|bug-pipeline-test-stubs)\.sh' "$f" ||
            continue
        last=$(grep -vE '^[[:space:]]*(#|$)' "$f" | tail -n 1)
        if [ "$last" != "h_done" ] ||
            [ "$(grep -cE '^[[:space:]]*h_done[[:space:]]*$' "$f")" -ne 1 ] ||
            grep -qF 'exit "$FAILED"' "$f"; then
            printf 'NO-H_DONE: %s\n' "${f#"$SELF_DIR"/}"
            bad=1
        fi
    done
    if [ "$bad" -eq 0 ]; then
        t_ok "case_consumers_end_with_h_done"
    else
        t_bad "case_consumers_end_with_h_done"
    fi
}

# Usage-gate isolation scan. Entry points are the non-test scripts under bin/
# that source the usage libs, so a new caller extends the list with no edit
# here. A token matches only after a non-name character, so plan-now does not
# match inside post-plan-now and pr-triage does not match inside test-pr-triage.
_usage_entry_regex() {
    local f first tok toks='usage-fetch\.sh' list
    list=$(grep -rlE 'usage-(gate|fetch)\.sh' "$SELF_DIR" | grep -v '/test-' | sort)
    while IFS= read -r f; do
        [ -f "$f" ] || continue
        first=""; IFS= read -r first <"$f" || true
        case "$first" in '#!'*) ;; *) case "$f" in *.sh) ;; *) continue ;; esac ;; esac
        tok=${f#"$SELF_DIR"/}; tok=${tok#lib/}
        toks="$toks|$(sed 's/\./\\./g' <<<"$tok")"
    done <<<"$list"
    printf '(^|[^A-Za-z0-9_-])(%s)\n' "$toks"
}

# _usage_scan DIR REGEX: prints one line per violation in DIR/test-*, returns 1
# on any. Excluded by name: test-harness-lib holds this scan and fixture text
# naming every token; test-usage-gate is the usage libs' own suite, isolates
# each case through new_env, and must run with test mode off to exercise the
# live keychain/curl path.
_usage_scan() {
    local dir="$1" re="$2" f n nc bad=0
    for f in "$dir"/test-*; do
        [ -f "$f" ] || continue
        n=${f##*/}
        case "$n" in test-harness-lib | test-usage-gate) continue ;; esac
        grep -qE "$re" "$f" || continue
        nc=$(grep -vE '^[[:space:]]*#' "$f")
        if ! grep -qE '^[[:space:]]*(\.|source)[[:space:]].*lib/(harness|bug-pipeline-test-stubs)\.sh' <<<"$nc" &&
            ! { grep -qE '^[[:space:]]*(\.|source)[[:space:]].*lib/usage-test-isolation\.sh' <<<"$nc" &&
                grep -qE '(^|[;&|[:space:]])usage_test_isolate[[:space:]]' <<<"$nc"; } &&
            ! grep -qF IBL5_USAGE_GATE_STATE_DIR <<<"$nc"; then
            printf 'USAGE-UNISOLATED: %s\n' "$n"
            bad=1
        fi
        if grep -qE '(^|[^A-Za-z0-9_-])env[[:space:]]+-i([[:space:]]|$)' <<<"$nc" &&
            ! grep -qF IBL5_USAGE_GATE_STATE_DIR <<<"$nc"; then
            printf 'USAGE-ENV-I-UNFORWARDED: %s\n' "$n"
            bad=1
        fi
    done
    return "$bad"
}

# Every bin/test-* that names a usage-gated entry point must isolate the usage
# gate (harness source, isolation lib call, or its own state dir), and a
# `env -i` test must forward IBL5_USAGE_GATE_STATE_DIR. Four checks: the entry
# regex derives, synthetic fixtures are flagged exactly, a real lib-route file
# stripped of its call is flagged, and the real corpus is clean.
case_usage_gate_isolated() {
    local re fx="$WORK/usage-fx" got want rc ok=1 name canary f nc first
    re=$(_usage_entry_regex)
    if ! grep -qF 'automouse/run' <<<"$re" || ! grep -qF 'plan-now' <<<"$re"; then
        echo "USAGE-SCAN: entry-point derivation broke"
        ok=0
    fi

    mkdir -p "$fx"
    printf '%s\n' 'bin/automouse/run --once' >"$fx/test-fx-bare"
    printf '%s\n' '# IBL5_USAGE_GATE_STATE_DIR is set elsewhere' 'bin/plan-now x' >"$fx/test-fx-comment-only"
    printf '%s\n' '. "$D/lib/usage-test-isolation.sh"' 'bin/post-plan-now x' >"$fx/test-fx-src-no-call"
    printf '%s\n' '. "$D/lib/harness.sh"' 'env -i PATH=/usr/bin:/bin bin/pr-triage' >"$fx/test-fx-envi"
    printf '%s\n' '. "$D/lib/harness.sh"' 'env -i PATH=/usr/bin:/bin IBL5_USAGE_GATE_STATE_DIR="$IBL5_USAGE_GATE_STATE_DIR" bin/pr-triage' >"$fx/test-fx-envi-fwd"
    printf '%s\n' '. "$D/lib/harness.sh"' 'bin/automouse/run' >"$fx/test-fx-harness"
    printf '%s\n' '. "$D/lib/usage-test-isolation.sh"; usage_test_isolate "$T/usage"' 'bin/burndown-loop' >"$fx/test-fx-iso"
    printf '%s\n' 'export IBL5_USAGE_GATE_STATE_DIR="$T/s"' 'bin/usage-gate-coordinator' >"$fx/test-fx-statedir"
    printf '%s\n' 'echo bin/test-pr-triage' >"$fx/test-fx-left-boundary"
    want=$(printf '%s\n' 'USAGE-ENV-I-UNFORWARDED: test-fx-envi' 'USAGE-UNISOLATED: test-fx-bare' \
        'USAGE-UNISOLATED: test-fx-comment-only' 'USAGE-UNISOLATED: test-fx-src-no-call' | sort)
    rc=0
    got=$(_usage_scan "$fx" "$re" | sort) || true
    _usage_scan "$fx" "$re" >/dev/null || rc=$?
    if [ "$got" != "$want" ] || [ "$rc" -ne 1 ]; then
        echo "USAGE-SCAN: fixtures flagged [$got] rc=$rc, wanted [$want] rc=1"
        ok=0
    fi

    canary=""
    for f in "$SELF_DIR"/test-*; do
        [ -f "$f" ] || continue
        nc=$(grep -vE '^[[:space:]]*#' "$f")
        if grep -qE '^[[:space:]]*(\.|source)[[:space:]].*lib/usage-test-isolation\.sh' <<<"$nc" &&
            ! grep -qF IBL5_USAGE_GATE_STATE_DIR <<<"$nc" && [ "${f##*/}" != test-harness-lib ]; then
            canary=$f
            break
        fi
    done
    if [ -z "$canary" ]; then
        echo "USAGE-SCAN: no lib-route file to mutate"
        ok=0
    else
        name=${canary##*/}
        mkdir -p "$WORK/usage-canary" "$WORK/usage-canary-ok"
        grep -v 'usage_test_isolate' "$canary" >"$WORK/usage-canary/$name"
        cp "$canary" "$WORK/usage-canary-ok/$name"
        got=$(_usage_scan "$WORK/usage-canary" "$re") || true
        if [ "$got" != "USAGE-UNISOLATED: $name" ]; then
            echo "USAGE-SCAN: stripped canary $name flagged [$got]"
            ok=0
        fi
        if ! _usage_scan "$WORK/usage-canary-ok" "$re" >/dev/null; then
            echo "USAGE-SCAN: unmodified canary $name flagged"
            ok=0
        fi
    fi

    if ! _usage_scan "$SELF_DIR" "$re"; then
        ok=0
    fi

    # Every bash bin/test-* parses: a Shape A/B edit with a stray quote fails here.
    for f in "$SELF_DIR"/test-*; do
        [ -f "$f" ] || continue
        first=""; IFS= read -r first <"$f" || true
        case "$first" in '#!/usr/bin/env bash' | '#!/bin/bash') ;; *) continue ;; esac
        if ! "$BASH_BIN" -n "$f" 2>/dev/null; then
            echo "SYNTAX: ${f##*/}"
            ok=0
        fi
    done

    if [ "$ok" -eq 1 ]; then
        t_ok "case_usage_gate_isolated"
    else
        t_bad "case_usage_gate_isolated"
    fi
}

case_pass_summary
case_fail_exits_nonzero
case_zero_assertions
case_legacy_failed
case_errexit_safe
case_eq
case_contains_fixed_string
case_exists_absent
case_near_inclusive
case_tmp_trap_cleans
case_tmp_respects_existing_trap
case_git_repo_default
case_git_repo_no_commit
case_git_repo_bare_origin
case_git_repo_unknown_flag
case_env_i
case_double_source
case_tmp_blank_tmpdir
case_bpt_delegates
case_usage_isolation_env
case_usage_isolation_overwrites
case_usage_isolation_prestart_fail_open
case_usage_isolation_lib_env_i
case_consumers_end_with_h_done
case_usage_gate_isolated

if [ "$T_FAIL" -eq 0 ]; then
    echo "test-harness-lib: all cases passed"
else
    echo "test-harness-lib: $T_FAIL case(s) failed"
fi
[ "$T_FAIL" -eq 0 ]
