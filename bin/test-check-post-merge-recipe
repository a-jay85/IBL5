#!/usr/bin/env bash
# shellcheck shell=bash
#
# test-check-post-merge-recipe — behavioural harness for bin/check-post-merge-recipe.
#
# Writes PR-body fixtures to a temp dir and drives the checker with --body-file and
# --repo-slug, so no gh credential, network, or git remote is needed (the origin-parsing
# cases build throwaway repos). Each case prints exactly `PASS <name>` or
# `FAIL <name>: <why>`; the run ends with `N passed, M failed`.
#
# Run: bin/test-check-post-merge-recipe  (exit 0 = all pass, exit 1 = any fail)

set -euo pipefail

SCRIPT="$(cd "$(dirname "$0")" && pwd)/check-post-merge-recipe"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/test-check-post-merge-recipe.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

PASSED=0
FAILED=0
RC=0
OUT=""
ERR=""

fx() { cat > "$TMP/$1.md"; }

# run_raw <cmd...>: run a command in ${RUN_DIR:-$PWD}, capture exit code, stdout, stderr.
run_raw() {
    RC=0
    OUT="$(cd "${RUN_DIR:-$PWD}" && env -u GIT_DIR -u GIT_WORK_TREE "$@" 2>"$TMP/err")" || RC=$?
    ERR="$(cat "$TMP/err")"
}

# run_case <fixture-name> [extra args...]
run_case() {
    local name="$1"
    shift
    run_raw "$SCRIPT" --body-file "$TMP/$name.md" --repo-slug a-jay85/IBL5 "$@"
}

# check <name> <want-exit> [stderr-substring] [stdout-substring]
check() {
    local name="$1" want="$2" errpat="${3:-}" outpat="${4:-}" why=""
    if [[ "$RC" != "$want" ]]; then
        why="exit $RC, want $want (stderr: $ERR)"
    elif [[ -n "$errpat" ]] && ! grep -qF -- "$errpat" <<< "$ERR"; then
        why="stderr missing '$errpat' (stderr: $ERR)"
    elif [[ -n "$outpat" ]] && ! grep -qF -- "$outpat" <<< "$OUT"; then
        why="stdout missing '$outpat' (stdout: $OUT)"
    fi
    if [[ -z "$why" ]]; then
        echo "PASS $name"
        PASSED=$((PASSED + 1))
    else
        echo "FAIL $name: $why"
        FAILED=$((FAILED + 1))
    fi
}

