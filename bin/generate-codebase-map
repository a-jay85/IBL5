#!/bin/bash
# Generate .claude/rules/codebase-map.md from ibl5/classes/ structure.
# Run: bin/generate-codebase-map
# Auto-run: SessionStart hook + git pre-commit hook + master-push CI job in .github/workflows/tests.yml

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
Usage: bin/generate-codebase-map

Generate .claude/rules/codebase-map.md and .claude/rules/codebase-map-detail.md
from ibl5/classes/ structure.
No-op if content (excluding the last_verified date) is unchanged.
Run automatically by the SessionStart hook, git pre-commit hook, and CI.

Exit codes:
  0  Map written (or already up to date)
EOF
    exit 0
fi

set -euo pipefail

# Deterministic output: force byte-order sort regardless of user locale
export LC_ALL=C

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CLASSES_DIR="$REPO_ROOT/ibl5/classes"
OUTPUT="$REPO_ROOT/.claude/rules/codebase-map.md"

# Third-party / built-in namespaces to exclude from dependency graph
EXCLUDE_NS="Delight|Monolog|PHPMailer|Psr|ZipArchive|SplFileObject|DateTimeImmutable|DateTime|RuntimeException|InvalidArgumentException|LogicException|Override|JsonSerializable|Stringable|BackedEnum|UnitEnum|ValueError|Fiber|WeakMap"

# Temp files
DEP_LINES=$(mktemp)
NEW_OUTPUT=$(mktemp)
NEW_DETAIL=$(mktemp)
DETAIL_OUTPUT="$REPO_ROOT/.claude/rules/codebase-map-detail.md"
trap 'rm -f "$DEP_LINES" "$NEW_OUTPUT" "$NEW_DETAIL"' EXIT

TODAY=$(date +%Y-%m-%d)

{
cat <<HEADER
---
description: Auto-generated module map of ibl5/classes/ with file counts and roles. Cross-module dependencies live in codebase-map-detail.md (Read on demand).
paths: ibl5/classes/**/*.php
last_verified: ${TODAY}
---

# Codebase Module Map

Auto-generated by \`bin/generate-codebase-map\`. Do not edit manually.

**Legend:** R=Repository S=Service V=View Ct=Controller P=Processor Vl=Validator | C=has Contracts/ dir

## Module Index

| Module | Files | C | Roles | Subdirs |
|--------|------:|:-:|-------|---------|
HEADER

# Single pass: module index + collect dependencies
for dir in "$CLASSES_DIR"/*/; do
    module=$(basename "$dir")

    # Count PHP files at module root (not in Contracts/)
    files=0 R=0 S=0 V=0 Ct=0 P=0 Vl=0
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        fname=$(basename "$f")
        files=$((files + 1))
        case "$fname" in
            *Repository.php)  R=$((R + 1)) ;;
            *Service.php)     S=$((S + 1)) ;;
            *View.php)        V=$((V + 1)) ;;
            *Controller.php)  Ct=$((Ct + 1)) ;;
            *Processor.php)   P=$((P + 1)) ;;
            *Validator.php)   Vl=$((Vl + 1)) ;;
        esac
    done < <(find "$dir" -maxdepth 1 -name '*.php' -type f 2>/dev/null)

    # Contracts/
    contracts="-"
    [ -d "$dir/Contracts" ] && contracts="Y"

    # Roles string (only non-zero)
    roles=""
    [ $R -gt 0 ]  && roles="${roles}R${R} "
    [ $S -gt 0 ]  && roles="${roles}S${S} "
    [ $V -gt 0 ]  && roles="${roles}V${V} "
    [ $Ct -gt 0 ] && roles="${roles}Ct${Ct} "
    [ $P -gt 0 ]  && roles="${roles}P${P} "
    [ $Vl -gt 0 ] && roles="${roles}Vl${Vl} "
    roles="${roles% }"

    # Non-Contracts subdirectories
    subdirs=""
    for sub in "$dir"*/; do
        [ -d "$sub" ] || continue
        subname=$(basename "$sub")
        [ "$subname" = "Contracts" ] && continue
        subdirs="${subdirs}${subname} "
    done
    subdirs="${subdirs% }"

    printf "| %s | %d | %s | %s | %s |\n" "$module" "$files" "$contracts" "$roles" "$subdirs"

    # Collect dependencies (same pass)
    deps=$(grep -rh '^use ' "$dir" --include='*.php' 2>/dev/null \
        | sed 's/^use //;s/;.*//' \
        | awk -F'\\\\' '{print $1}' \
        | grep -vE "^($module|$EXCLUDE_NS)$" \
        | sort -u \
        | tr '\n' ' ' || true)
    deps="${deps% }"
    [ -n "$deps" ] && echo "$module -> $deps" >> "$DEP_LINES"
done

# Root-level loose files
echo ""
echo "**Root files:** $(find "$CLASSES_DIR" -maxdepth 1 -name '*.php' -print0 2>/dev/null | xargs -0 -I{} basename {} .php | sort | tr '\n' ' ' | sed 's/ $//')"

echo ""
echo "**Cross-module dependencies:** see \`.claude/rules/codebase-map-detail.md\` (Read on demand)."
} > "$NEW_OUTPUT"

{
cat <<DETAIL_HEADER
---
description: Read-on-demand only (no auto-attach trigger). Auto-generated cross-module dependency list for ibl5/classes/, the companion to codebase-map.md.
last_verified: ${TODAY}
paths: "~/.claude/hooks/plan-gate-edit.sh"
---

# Codebase Module Map: Dependencies

Auto-generated by \`bin/generate-codebase-map\`. Do not edit manually.

## Cross-Module Dependencies

DETAIL_HEADER
cat "$DEP_LINES"
cat <<'FOOTER'

## Usage

When working in a module, use targeted paths instead of broad searches:
- `Glob("ibl5/classes/ModuleName/**/*.php")` for all module files
- `Glob("ibl5/classes/ModuleName/Contracts/*.php")` for interfaces
- Check the dependency list above to identify related modules
FOOTER
} > "$NEW_DETAIL"

# Only update a file if there are real content changes (not just the date)
strip_date() { sed 's/^last_verified: .*/last_verified: NORMALIZED/' "$1"; }
write_if_changed() {
    local new="$1" out="$2"
    if [ -f "$out" ] && diff -q <(strip_date "$out") <(strip_date "$new") >/dev/null 2>&1; then
        return 0
    fi
    cp "$new" "$out"
}
write_if_changed "$NEW_OUTPUT" "$OUTPUT"
write_if_changed "$NEW_DETAIL" "$DETAIL_OUTPUT"
