#!/usr/bin/env bash
# pr-ready-helper — the single guard-clean entry point for the /pr-ready skill.
#
# WHY THIS EXISTS
# ---------------
# .claude/skills/pr-ready/SKILL.md mandates EnterWorktree, so every runtime phase
# after Phase 0 executes inside a worktree-isolated session. The harness guard for
# that mode refuses Bash commands it cannot statically prove stay inside the
# worktree — compound statements, a sourced library plus a call to what it defined,
# redirect-plus-process-substitution. Decomposition cannot fix the sourced-library
# case, because shell state does not survive between Bash tool calls: a function
# must be called in the same invocation that sourced it.
#
# The fix is a shape change, never a bypass. Each compound block moves behind one
# plain `bin/pr-ready-helper <subcommand> <args>` invocation, which the guard runs.
# The compound work then happens inside a single process, where it is legal.
#
# HARD INVARIANT — this helper reads and reports. It never creates a commit, never
# publishes anything to the remote, never merges a pull request, and never arms
# auto-merge. Any future edit that adds one of those belongs in a different script.
#
# Reuse: the six hold predicates come from bin/lib/pr-armable.sh, sourced verbatim
# and never re-derived. The sticky create-or-update shape mirrors bin/pr-canary-check.

set -euo pipefail

# --- Test seams ------------------------------------------------------------
# Same names bin/lib/pr-armable.sh already uses, so one export stubs both layers.
# The empty check runs BEFORE the default assignment: `${GH_CMD:-gh}` treats set-
# but-empty as unset, so without this an explicit GH_CMD="" would silently become
# a real GitHub call instead of the loud abort a stubbed test expects.
if [[ -n "${GH_CMD+set}" && -z "${GH_CMD}" ]]; then
    echo "pr-ready-helper: GH_CMD is set but empty — refusing to expand to an empty command" >&2
    exit 2
fi
if [[ -n "${REPO_SLUG+set}" && -z "${REPO_SLUG}" ]]; then
    echo "pr-ready-helper: REPO_SLUG is set but empty — refusing to build an empty API path" >&2
    exit 2
fi
GH_CMD="${GH_CMD:-gh}"
REPO_SLUG="${REPO_SLUG:-a-jay85/IBL5}"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ARMABLE_LIB="$SCRIPT_DIR/lib/pr-armable.sh"

usage() {
    cat >&2 <<'USAGE'
Usage: bin/pr-ready-helper <subcommand> [args]

Subcommands:
  capture-pre <pr-number> <master-sha>  Capture the pre-rebase tree diff; print the
                                        commit count on stdout (nothing else).
  prove-tree  <pr-number>               Compare the post-rebase tree against the
                                        captured pre-rebase one; TREE-EQUIVALENT or
                                        TREE DIVERGED.
  holds       <pr-number>               Run all six fail-closed hold predicates from
                                        bin/lib/pr-armable.sh; exit 1 if any holds.
  sticky      <pr-number>               Create-or-update the /pr-ready verdict comment
                                        from /tmp/pr-ready-verdict-<pr-number>.md.
  selftest                              Probe the harness worktree-isolation guard:
                                        prints GUARD-CLEAN when the wrapped constructs
                                        all ran inside this process.

Exits 2 on an unknown subcommand or a malformed argument.
USAGE
    exit 2
}

# require_pr_number <arg> — every subcommand validates its own <pr-number>.
require_pr_number() {
    local n="${1:-}"
    if [[ ! "$n" =~ ^[0-9]+$ ]]; then
        echo "pr-ready-helper: expected a numeric <pr-number>, got '${n}'" >&2
        usage
    fi
}

# cmd_selftest — the guard-boundary probe.
#
# Exists for exactly one purpose: to be invoked as a plain `bin/pr-ready-helper
# selftest` from inside an EnterWorktree-isolated session, proving that the plain
# `bin/<script> <args>` shape is NOT refused even when the script internally performs
# the three constructs the guard refuses when they are typed into a Bash call.
#
# It ships permanently rather than being deleted after the initial probe: if the
# harness guard changes behaviour later, this is the one-command mechanical re-probe,
# instead of a /pr-ready run failing halfway through its Phase 7.
#
# Never prints GUARD-CLEAN on a partial run — every construct is checked and the
# failing one is named.
cmd_selftest() {
    local scratch
    scratch="$(mktemp "/tmp/pr-ready-selftest-XXXXXX")"
    # shellcheck disable=SC2064  # expand $scratch now, at trap-install time
    trap "rm -f '$scratch'" EXIT

    # Construct 1 — a redirect, then read the file back.
    git rev-parse --short HEAD > "$scratch"
    if [[ ! -s "$scratch" ]]; then
        echo "selftest: construct 1 (redirect) failed — $scratch is empty" >&2
        return 1
    fi

    # Construct 2 — source a library and call one of its functions in the SAME
    # process. This is the construct decomposition provably cannot fix at the Bash
    # tool layer. The predicate is cheap and side-effect-free: a body with no
    # `## Manual Testing` section must classify UNKNOWN.
    if [[ ! -f "$ARMABLE_LIB" ]]; then
        echo "selftest: construct 2 (source) failed — library not found at $ARMABLE_LIB" >&2
        return 1
    fi
    # shellcheck source=bin/lib/pr-armable.sh
    source "$ARMABLE_LIB"
    local clearance
    clearance="$(pr_manual_testing_clearance "a body with no manual testing section")"
    if [[ "$clearance" != "UNKNOWN" ]]; then
        echo "selftest: construct 2 (source + predicate call) failed — expected UNKNOWN, got '$clearance'" >&2
        return 1
    fi

    # Construct 3 — process substitution over two trivially-equal streams.
    if ! diff <(printf 'a\nb\n') <(printf 'a\nb\n') > /dev/null; then
        echo "selftest: construct 3 (process substitution) failed" >&2
        return 1
    fi

    echo "GUARD-CLEAN"
}

# cmd_capture_pre — capture the pre-rebase tree state.
#
# Called by the /pr-ready skill BEFORE the rebase delegate runs, so HEAD at that moment
# is the pre-rebase branch tip. The patch file must survive until cmd_prove_tree reads
# it; deliberately no trap is installed here — cleanup is prove-tree's responsibility,
# since prove-tree owns the end of the pre/post lifecycle.
#
# stdout is the integer commit count and NOTHING ELSE — the caller captures it into
# commits_before for the squash decision. Informational output goes to stderr.
cmd_capture_pre() {
    require_pr_number "${1:-}"
    local pr_number="$1"
    local master_sha="${2:-}"
    if [[ -z "$master_sha" ]]; then
        echo "pr-ready-helper capture-pre: missing required argument <master-sha>" >&2
        exit 2
    fi

    local pre="/tmp/pr-ready-diff-pre-${pr_number}.patch"
    # Three-dot range captures everything the branch adds over master.
    git diff origin/master...HEAD > "$pre"
    # Deliberately no trap here — the patch must survive for prove-tree to read.
    echo "captured pre-rebase state to $pre" >&2

    # TWO-dot range against the pinned SHA — never re-resolve origin/master.
    # The three-dot range above and the two-dot range here differ deliberately;
    # both are carried over verbatim from the _rebase-and-conflicts.md block.
    git rev-list --count "$master_sha"..HEAD
}

# cmd_prove_tree — compare the post-rebase tree against the captured pre-rebase state.
#
# Materialises both git-apply --numstat streams into temp files under set -euo pipefail
# before comparing with diff. Process substitution (diff <(…) <(…)) is not used:
# it discards the exit status of both substituted commands, so a git apply failure
# would masquerade as equivalence. The materialised form makes that failure loud.
#
# silence is not success — if either patch is empty, diff still passes because two empty
# streams are equivalent; that is correct behaviour here, since an empty pre-patch means
# the branch had no changes to lose.
#
# The numstat comparison is deliberately fail-loud-biased. If origin/master itself
# changed the same files between the two captures, the counts can differ without any
# work being lost, producing a TREE DIVERGED false alarm. That direction is safe — it
# stops the run for a human to inspect. The inverse (a silent TREE-EQUIVALENT on real
# loss) is the failure this check exists to prevent.
cmd_prove_tree() {
    require_pr_number "${1:-}"
    local pr_number="$1"

    local pre="/tmp/pr-ready-diff-pre-${pr_number}.patch"
    local post="/tmp/pr-ready-diff-post-${pr_number}.patch"

    # Guard the input FIRST — the highest-value negative path in the whole plan.
    # Two failed git apply --numstat calls produce two empty streams; diff returns 0,
    # and the run would print TREE-EQUIVALENT having proven nothing. A missing pre-patch
    # must never fall through to the comparison. A zero-byte pre-patch is a legitimate
    # state (the branch had no changes) and proceeds normally — guard on existence, not size.
    if [[ ! -e "$pre" ]]; then
        echo "pr-ready-helper prove-tree: pre-rebase patch not found: $pre" >&2
        echo "pr-ready-helper prove-tree: run capture-pre before the rebase delegate" >&2
        exit 2
    fi

    local tmp_pre tmp_post tmp_diff
    tmp_pre=$(mktemp "/tmp/pr-ready-numstat-pre-XXXXXX")
    tmp_post=$(mktemp "/tmp/pr-ready-numstat-post-XXXXXX")
    tmp_diff=$(mktemp "/tmp/pr-ready-diff-result-XXXXXX")

    # Install the trap only AFTER the missing-pre-patch guard has passed,
    # so the exit-2 path does not delete a file it did not create.
    # prove-tree owns the teardown for the pre/post lifecycle.
    # shellcheck disable=SC2064  # expand vars now, at trap-install time
    trap "rm -f '$pre' '$post' '$tmp_pre' '$tmp_post' '$tmp_diff'" EXIT

    git diff origin/master...HEAD > "$post"

    # Materialise both numstat streams separately — rc-checked under set -euo pipefail.
    # Process substitution is intentionally avoided: see comment above.
    # --allow-empty is required so that a zero-byte patch (branch with no changes)
    # produces an empty stream at rc 0 rather than aborting under set -e.
    git apply --numstat --allow-empty "$pre" | sort > "$tmp_pre"
    git apply --numstat --allow-empty "$post" | sort > "$tmp_post"

    if diff "$tmp_pre" "$tmp_post" > "$tmp_diff"; then
        echo "TREE-EQUIVALENT"
        exit 0
    fi

    echo "TREE DIVERGED — lost work detected"
    cat "$tmp_diff"
    exit 1
}

# cmd_holds — run every auto-merge hold predicate and report, fail-closed.
#
# Replaces the SKILL.md Phase 7 step 1 block, which the isolation guard refuses because
# it sources a library and then calls what that library defined. Shell state does not
# survive between Bash tool calls, so decomposition provably cannot fix it; a single
# process can.
#
# The prohibited failure mode for this subcommand is a wrapper that swallows a non-zero
# rc and reports "no hold". Everything below is shaped against that: one guarded fetch,
# no `|| true` anywhere, and `set -euo pipefail` left free to abort loudly if any
# predicate returns non-zero. A loud abort is a correct outcome here; a clean report
# built on a failed fetch is not.
cmd_holds() {
    require_pr_number "${1:-}"
    local n="$1"

    if [[ ! -f "$ARMABLE_LIB" ]]; then
        echo "HOLD: hold-predicate library not found at $ARMABLE_LIB"
        exit 1
    fi
    # shellcheck source=bin/lib/pr-armable.sh
    source "$ARMABLE_LIB"

    # ONE fetch, not four. Four `gh pr view` calls cost four round-trips and can observe
    # four different states of the PR mid-run; one fetch is cheaper and atomic.
    local raw
    raw="$("$GH_CMD" pr view "$n" --json body,title,labels,files)" \
        || { echo "HOLD: gh pr view failed for PR $n"; exit 1; }
    if [[ -z "$raw" ]]; then
        echo "HOLD: gh pr view returned an empty payload for PR $n"
        exit 1
    fi
    # A non-JSON payload is a failed fetch, not a PR with empty fields. Letting it
    # through would hand pr_feat_hold an empty TITLE, which silently neuters the
    # `feat:` floor — the exact fail-OPEN this subcommand exists to prevent.
    if ! printf '%s' "$raw" | jq -e . >/dev/null 2>&1; then
        echo "HOLD: gh pr view returned a non-JSON payload for PR $n"
        exit 1
    fi

    local body title labels files
    body="$(printf '%s' "$raw" | jq -r '.body // ""')"
    title="$(printf '%s' "$raw" | jq -r '.title // ""')"
    labels="$(printf '%s' "$raw" | jq -c '.labels // []')"
    files="$(printf '%s' "$raw" | jq -c '.files // []')"

    # All six predicates from bin/lib/pr-armable.sh — never re-derive, never relax, never swallow non-zero rc
    #
    # Argument mapping copied from the only other consumer, bin/pr-triage:178-182, plus
    # pr_pipeline_authored_hold (labels, unconditional — there is NO override label).
    # pr_unresolved_findings_hold takes the PR number and makes its own API calls
    # internally through GH_CMD / REPO_SLUG, so it needs nothing pre-fetched.
    local clearance golden deps feat pipeline unresolved
    clearance="$(pr_manual_testing_clearance "$body")"
    golden="$(pr_golden_hold "$files")"
    deps="$(pr_dep_holds "$body" | tr '\n' ' ')"
    feat="$(pr_feat_hold "$title" "$labels")"
    pipeline="$(pr_pipeline_authored_hold "$labels")"
    unresolved="$(pr_unresolved_findings_hold "$n" | tr '\n' ' ')"

    local held=0

    # Clearance is the ONE positive-signal axis: clear only on exactly CLEARED.
    # HELD holds (real manual rows), and UNKNOWN holds too (no `## Manual Testing`
    # section at all — a hand-made PR, or one /post-plan never processed). Fail-closed
    # means clear requires a positive clearance signal, never the mere absence of a hold.
    if [[ "$clearance" == "CLEARED" ]]; then
        echo "CLEAR: pr_manual_testing_clearance — CLEARED"
    else
        echo "HOLD:  pr_manual_testing_clearance — ${clearance:-(no output)}"
        held=1
    fi

    # The other five clear on EMPTY output; any non-empty value is the hold reason.
    # All six lines print on every run, hold or not, so a missing line reads as a bug
    # rather than as an absent hold.
    local name value
    for name in pr_golden_hold pr_dep_holds pr_feat_hold pr_pipeline_authored_hold pr_unresolved_findings_hold; do
        case "$name" in
            pr_golden_hold)                 value="$golden" ;;
            pr_dep_holds)                   value="$deps" ;;
            pr_feat_hold)                   value="$feat" ;;
            pr_pipeline_authored_hold)      value="$pipeline" ;;
            pr_unresolved_findings_hold)    value="$unresolved" ;;
        esac
        # Trim the trailing separator `tr` leaves on the two multi-line predicates.
        value="${value%"${value##*[![:space:]]}"}"
        if [[ -z "$value" ]]; then
            echo "CLEAR: $name — (none)"
        else
            echo "HOLD:  $name — $value"
            held=1
        fi
    done

    # Exit 1 on ANY hold — the skill gates its subsequent steps on this exit code.
    [[ "$held" -eq 0 ]] || exit 1
}

case "${1:-}" in
    capture-pre)
        cmd_capture_pre "${2:-}" "${3:-}"
        ;;
    prove-tree)
        cmd_prove_tree "${2:-}"
        ;;
    holds)
        cmd_holds "${2:-}"
        ;;
    selftest)
        cmd_selftest
        ;;
    *)
        usage
        ;;
esac
