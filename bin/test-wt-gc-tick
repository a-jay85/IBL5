# ══════════════════════════════════════════════════════════════════════════════
# PRA — unpushed open-PR alert (alert_unpushed_open_prs)
# ══════════════════════════════════════════════════════════════════════════════
# pra_setup <wt-name> <branch>: fixture env + worktree with one commit dated one
# day back, an origin ref at origin/master (so the commit has no twin), and an
# OPEN-PR row for PR 4242. Sets PRA_WT to the worktree path.
pra_setup() {
    local old
    mk_wt "$1" "$2"
    PRA_WT="$(dirname "$ENV_MAIN")/IBL5-worktrees/$1"
    old=$(( $(date +%s) - 86400 ))
    printf 'pra\n' > "$PRA_WT/pra-$1.txt"
    git -C "$PRA_WT" add "pra-$1.txt"
    GIT_AUTHOR_DATE="@$old" GIT_COMMITTER_DATE="@$old" \
        git -C "$PRA_WT" commit -qm "pra: stranded change"
    git -C "$ENV_MAIN" update-ref "refs/remotes/origin/$2" origin/master
    printf 'OPEN-PR %s (PR #4242)\n' "$1" > "$CD/rows"
    rm -f "$CD/dm-argv" "$CD/dm-msg"
}
# pra_twin <branch>: point origin/<branch> at a patch-equivalent commit with a
# different SHA (same tree and parent, different message).
pra_twin() {
    local tree twin
    tree="$(git -C "$PRA_WT" rev-parse 'HEAD^{tree}')"
    twin="$(git -C "$ENV_MAIN" commit-tree "$tree" -p origin/master -m 'pra: twin')"
    git -C "$ENV_MAIN" update-ref "refs/remotes/origin/$1" "$twin"
}
dm_calls() { if [ -f "$CD/dm-argv" ]; then grep -c . "$CD/dm-argv"; else echo 0; fi; }
pra_marker() { cat "$CD/state/pr-alerts/$1" 2>/dev/null || true; }
# rt_keep: rt without wiping the state dir, so the dedupe marker survives.
rt_keep() {
    rm -f "$CD/docker-argv" "$CD/wt-remove-argv" "$CD/gh-argv"
    run_tick WT_GC_REPO_ROOT="$ENV_MAIN" WT_GC_WT_STATUS="$STUBBIN/wt-status-rows" \
        STUB_WT_STATUS_ROWS="$CD/rows" WT_GC_WT_REMOVE="$ENV_MAIN/bin/wt-remove" "$@"
}
pra_head() { git -C "$ENV_MAIN" rev-parse refs/heads/pra-br; }

if should_run PRA1-alert-fires; then
