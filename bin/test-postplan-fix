#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-postplan-fix: cases for bin/postplan-fix (one-command fix entry for a blocked
# post-plan run). claude and gh are stubs; the script runs from a copy inside a temp git
# repo, so nothing in the real checkout or on the network is touched.
#
#   1. --help exits 0 and prints Usage; no tool is called.
#   2. Unknown flag exits 2.
#   3. Unset arg, empty arg, and two args each exit 2.
#   4. Unknown PR exits 1.
#   5. Unknown slug exits 1.
#   6. A prefix of a real branch exits 1 (the worktree match is exact).
#   7. PR path: claude gets cwd = the branch worktree, one argv element, and the newest
#      run's blocked-ship text and the newest post-plan-now-… log under POSTPLAN_LOG_DIR.
#   8. Slug path: result.json under the worktree's own out dir; gh is not called.
#   9. Worktree with no run dir still launches.
#  10. A 5000-byte failure text is capped at 1500 bytes.
#  11. Run from a linked worktree: the main checkout's out dir is still searched.
#  12. env -i probe: no HOME, no Homebrew, bash with pipefail; POSTPLAN_LOG_DIR forwarded.
#  13. POSTPLAN_LOG_DIR unset or empty: the private log dir is not read.
#  14-24. --headless [--dry-run]: flag rejection, dry run, main-checkout refusal, dirty
#      tree, resolve-and-commit, FAILED verdict, leftover markers, moved ref (restored
#      with a reflog message), clean rebase, missing harness, env -i.
#      21d-21i: the ref guard covers only the session branch's own two refs. An
#      unrelated master move and an unrelated branch create/delete are kept; an own ref
#      that moves again before the restore is left as is (compare-and-swap); an own ref
#      the session deleted is restored and one it created is removed. A sibling ref
#      under the own remote ref's name does not abort the run.
#      headless-stacked-base: a branch whose iblBase names a pushed parent rebases onto that parent,
#      not master. headless-stacked-unresolved: an iblBase no layer resolves prints
#      result=gave-up-base, exits 1, and leaves HEAD alone.
#      headless-clean-rebase, headless-rebase-linear, headless-abort-restores-head0: the
#      sync is a rebase, never a merge. A clean run leaves no merge commit; a resolved
#      conflict leaves one commit on the BASE tip with the manifest pre_sha at head0; a
#      FAILED verdict resets the branch to head0 with no rebase in progress.
#      Each prints one "case ok headless-<name>" line.
#
# Run: bin/test-postplan-fix [--case NAME]...  (exit 0 = all pass, 1 = a case failed)
# --case takes a case_end name such as headless-result-committed. Cases 1-13 have no
# name and always run.

set -u

# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

ROOT=$(cd "$(dirname "$0")/.." && pwd)

ok()   { h_pass "$1"; }
fail() { h_fail "$@"; }
# --case NAME (repeatable): run only the named cases. Shared fixtures and helpers between
# cases still run. A mutation-matrix row uses this to fit one case inside its 30s timeout.
# A name that matches no case fails the run, so a typo cannot pass as a green baseline.
ONLY_CASES=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --case)
            [[ $# -ge 2 && -n "$2" ]] || { echo "usage: $0 [--case NAME]..." >&2; exit 2; }
            ONLY_CASES+=("$2"); shift 2 ;;
        *) echo "usage: $0 [--case NAME]... (unknown argument: $1)" >&2; exit 2 ;;
    esac
done
RAN_CASES=$'\n'
should_run() {  # $1 = case name; true when no --case was given or $1 was named
    [[ ${#ONLY_CASES[@]} -eq 0 ]] && return 0
    local c
    for c in "${ONLY_CASES[@]}"; do
        if [[ "$c" == "$1" ]]; then RAN_CASES+="$1"$'\n'; return 0; fi
    done
    return 1
}
check_only_cases() {  # fail every --case name that matched no case
    local c
    for c in ${ONLY_CASES[@]+"${ONLY_CASES[@]}"}; do
        [[ "$RAN_CASES" == *$'\n'"$c"$'\n'* ]] || fail "unknown --case name: $c (no case ran)"
    done
}

TMP=$(mktemp -d "${TMPDIR:-/tmp}/test-postplan-fix.XXXXXX")
B_BLOCK="pfx$$-block"; B_JSON="pfx$$-json"; B_NORUN="pfx$$-norun"; B_BIG="pfx$$-big"
B_PREFIX="pfx$$-bloc"
B_HR="pfx$$-hr"
RUNLOG="$TMP/runlog"; mkdir -p "$RUNLOG"
export POSTPLAN_LOG_DIR="$RUNLOG"   # read by bin/postplan-fix; keeps /tmp clean
PNLOG="$RUNLOG/post-plan-now-$B_BLOCK-20261008-120001-9.log"
trap 'rm -rf "$TMP"' EXIT
# The unstacked cases resolve their merge target to origin/master with no real gh call.
export BRANCH_BASE_OFFLINE=1

has()   { case "$2" in *"$3"*) ok "$1" ;; *) fail "$1" "missing '$3'" ;; esac; }
hasnt() { case "$2" in *"$3"*) fail "$1" "unexpected '$3'" ;; *) ok "$1" ;; esac; }
rc_is() { if [ "$2" = "$3" ]; then ok "$1"; else fail "$1" "rc $2, want $3"; fi; }

# --- fixture: a temp repo holding a committed copy of the script and its libs ---
MAIN="$TMP/main"
git init -q "$MAIN"
mkdir -p "$MAIN/bin"
cp "$ROOT/bin/postplan-fix" "$MAIN/bin/postplan-fix"
cp "$ROOT/bin/post-plan-now" "$MAIN/bin/post-plan-now"   # --holdrepeat sources its postplan_inflight_label
cp -R "$ROOT/bin/lib" "$MAIN/bin/lib"
git -C "$MAIN" add -A
git -C "$MAIN" -c user.name=t -c user.email=t@t commit -qm init
for B in "$B_BLOCK" "$B_JSON" "$B_NORUN" "$B_BIG"; do
    git -C "$MAIN" worktree add -q -b "$B" "$TMP/wt-$B"
done

# Headless fixture: MAIN is on master with an origin remote. B_CONFLICT changes a.txt to
# "feature"; master commits a.txt as "master" and pushes, so merging origin/master conflicts.
# The denied-tool import needs harness/ under MAIN: only that package is linked, because a
# link to the whole tools/ dir would aim the OUT fixtures below at the real checkout.
git -C "$MAIN" branch -M master
# A user-level rerere would replay case 18's resolution into the later cases.
git -C "$MAIN" config rerere.enabled false
B_CONFLICT="pfx$$-conflict"; B_CLEAN="pfx$$-clean"
GITC=(git -c user.name=t -c user.email=t@t)
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t
mkdir -p "$MAIN/tools/postplan-harness"
ln -s "$ROOT/tools/postplan-harness/harness" "$MAIN/tools/postplan-harness/harness"
git clone -q --bare "$MAIN" "$TMP/origin.git"
git -C "$MAIN" remote add origin "$TMP/origin.git"
git -C "$MAIN" fetch -q origin
INIT_SHA=$(git -C "$MAIN" rev-parse master)
git -C "$MAIN" worktree add -q -b "$B_CONFLICT" "$TMP/wt-$B_CONFLICT" "$INIT_SHA"
printf 'feature\n' > "$TMP/wt-$B_CONFLICT/a.txt"
git -C "$TMP/wt-$B_CONFLICT" add a.txt
"${GITC[@]}" -C "$TMP/wt-$B_CONFLICT" commit -qm feature
printf 'master\n' > "$MAIN/a.txt"
git -C "$MAIN" add a.txt
"${GITC[@]}" -C "$MAIN" commit -qm master-change
git -C "$MAIN" push -q origin master
git -C "$MAIN" worktree add -q -b "$B_CLEAN" "$TMP/wt-$B_CLEAN" master
# A pre-existing remote-tracking ref for the moved-ref case to disturb.
git -C "$MAIN" update-ref "refs/remotes/origin/$B_CONFLICT" "$INIT_SHA"
# Stacked fixture: stackparent is on origin, B_STACK is cut from it with iblBase recorded.
# Then stackparent gains a conflicting a.txt commit and master gains an unrelated commit,
# so a merge of the declared parent conflicts while a merge of master would not.
B_STACK="pfx$$-stack"
git -C "$MAIN" worktree add -q -b stackparent "$TMP/wt-stackparent" "$INIT_SHA"
printf 'parent base\n' > "$TMP/wt-stackparent/p.txt"
git -C "$TMP/wt-stackparent" add p.txt
"${GITC[@]}" -C "$TMP/wt-stackparent" commit -qm parent-base
git -C "$TMP/wt-stackparent" push -q origin stackparent
git -C "$MAIN" worktree add -q -b "$B_STACK" "$TMP/wt-$B_STACK" stackparent
git -C "$MAIN" config "branch.$B_STACK.iblBase" stackparent
printf 'feature\n' > "$TMP/wt-$B_STACK/a.txt"
git -C "$TMP/wt-$B_STACK" add a.txt
"${GITC[@]}" -C "$TMP/wt-$B_STACK" commit -qm stack-feature
printf 'parent\n' > "$TMP/wt-stackparent/a.txt"
git -C "$TMP/wt-stackparent" add a.txt
"${GITC[@]}" -C "$TMP/wt-stackparent" commit -qm parent-change
git -C "$TMP/wt-stackparent" push -q origin stackparent
printf 'other\n' > "$MAIN/m2.txt"
git -C "$MAIN" add m2.txt
"${GITC[@]}" -C "$MAIN" commit -qm master-unrelated
git -C "$MAIN" push -q origin master

OUT="$MAIN/tools/postplan-harness/out"
JSON_OUT="$TMP/wt-$B_JSON/tools/postplan-harness/out"
mkdir -p "$OUT/live-$B_BLOCK-20261007-090000-1" "$OUT/live-$B_BLOCK-20261008-120000-2" \
    "$OUT/live-$B_BIG-20261008-120000-4" "$JSON_OUT/live-$B_JSON-20261008-120000-3"
printf '{"terminal":"failed","error_kind":"x","error":"OLDRUN"}' \
    > "$OUT/live-$B_BLOCK-20261007-090000-1/result.json"
printf 'Why: required check failed\nBLOCKMARK\n' \
    > "$OUT/live-$B_BLOCK-20261008-120000-2/blocked-ship.txt"
printf '{"terminal":"failed","error_kind":"gh","error":"gh: gh pr create --title: JSONMARK"}' \
    > "$JSON_OUT/live-$B_JSON-20261008-120000-3/result.json"
{ head -c 5000 /dev/zero | tr '\0' 'x'; printf 'TAILMARK'; } \
    > "$OUT/live-$B_BIG-20261008-120000-4/blocked-ship.txt"
: > "$PNLOG"
SHARED_TMP=/tmp
if [ -e "$SHARED_TMP/$(basename "$PNLOG")" ]; then
    fail "fixture: fake runner log leaked into the shared /tmp"
else
    ok "fixture: fake runner log stays under the private POSTPLAN_LOG_DIR"
fi

STUB="$TMP/stub"; mkdir -p "$STUB"
cat > "$STUB/claude" <<STUBEOF
#!/bin/bash
pwd -P > "$TMP/claude.cwd"
echo "\$#" > "$TMP/claude.argc"
if [ "\$1" = "-p" ]; then cat > "$TMP/claude.prompt"; else printf '%s' "\$1" > "$TMP/claude.prompt"; fi
printf '%s\n' "\$@" >> "$TMP/claude.args"
# CLAUDE_STUB_EFFECT / CLAUDE_STUB_REPLY are test-only: a script to run, a file to print.
if [ -n "\${CLAUDE_STUB_EFFECT-}" ]; then bash "\$CLAUDE_STUB_EFFECT"; fi
if [ -n "\${CLAUDE_STUB_REPLY-}" ]; then cat "\$CLAUDE_STUB_REPLY"; fi
if [ -n "\${CLAUDE_STUB_STDERR-}" ]; then echo "\$CLAUDE_STUB_STDERR" >&2; fi
exit 0
STUBEOF
cat > "$STUB/gh" <<STUBEOF
#!/bin/bash
: > "$TMP/gh.called"
printf '%s\n' "\$*" >> "$TMP/gh.calls"
if [ "\$1 \$2 \$3" = "pr view 42" ]; then printf '%s\n' "$B_BLOCK"; exit 0; fi
# PR 77 backs the --holdrepeat cases. Snapshots read gh.snap.after once claude has run.
if [ "\$1 \$2 \$3" = "pr view 77" ]; then
    case "\$*" in
        *headRefName*) printf '%s\n' "$B_HR"; exit 0 ;;
        *title,labels*)
            s="$TMP/gh.snap.before"
            if [ -e "$TMP/claude.args" ] && { [ -f "$TMP/gh.snap.after" ] || [ -f "$TMP/gh.snap.after.json" ]; }; then s="$TMP/gh.snap.after"; fi
            # A .json fixture goes through the launcher's real --json field list and --jq
            # expression, so a field the launcher never asks for reads as null on both sides.
            if [ -f "\$s.json" ]; then
                fields="" expr=""
                while [ \$# -gt 0 ]; do
                    case "\$1" in --json) fields="\$2"; shift ;; --jq) expr="\$2"; shift ;; esac
                    shift
                done
                jq --arg f "\$fields" '. as \$o | reduce (\$f | split(","))[] as \$k ({}; .[\$k] = \$o[\$k])' "\$s.json" | jq -r "\$expr"
            else
                cat "\$s"
            fi
            exit 0 ;;
        # gh.paged: the first page of a long thread, which never holds the newest comment.
        *comments*) if [ -e "$TMP/gh.paged" ]; then echo "an old comment"; else cat "$TMP/gh.lastcomment" 2>/dev/null; fi; exit 0 ;;
    esac
fi
if [ "\$1 \$2" = "pr comment" ]; then
    if [ -e "$TMP/gh.commentfail" ]; then exit 1; fi
    while [ \$# -gt 0 ]; do
        if [ "\$1" = "--body-file" ]; then cp "\$2" "$TMP/gh.lastcomment"; cp "\$2" "$TMP/gh.comment"; fi
        shift
    done
    echo "https://github.com/a-jay85/IBL5/pull/77#issuecomment-555"
    exit 0
fi
if [ "\$1 \$2" = "api repos/a-jay85/IBL5/issues/comments/555" ]; then cat "$TMP/gh.lastcomment" 2>/dev/null; exit 0; fi
if [ "\$1 \$2" = "pr edit" ] || [ "\$1 \$2" = "pr merge" ]; then exit 0; fi
exit 1
STUBEOF
chmod +x "$STUB/claude" "$STUB/gh"

# run_fix <script> <args...>: sets RC, ERR, STDOUT, PROMPT; clears the stub's records first.
run_fix() {
    local script="$1"; shift
    rm -f "$TMP/claude.cwd" "$TMP/claude.argc" "$TMP/claude.prompt" "$TMP/gh.called" "$TMP/claude.args" \
        "$TMP/gh.calls" "$TMP/gh.comment"
    STDOUT=$(PATH="$STUB:$PATH" bash "$script" "$@" 2>"$TMP/err"); RC=$?
    ERR=$(cat "$TMP/err")
    PROMPT=""; [ -f "$TMP/claude.prompt" ] && PROMPT=$(cat "$TMP/claude.prompt")
}
no_claude() { if [ -e "$TMP/claude.argc" ]; then fail "$1" "claude was called"; else ok "$1"; fi; }

SUT="$MAIN/bin/postplan-fix"

# 1
run_fix "$SUT" --help
rc_is "1: --help exits 0" "$RC" 0
has "1: --help prints Usage" "$STDOUT" "Usage:"
no_claude "1: --help calls no claude"
if [ -e "$TMP/gh.called" ]; then fail "1: --help calls no gh"; else ok "1: --help calls no gh"; fi

# 2
run_fix "$SUT" --bogus
rc_is "2: unknown flag exits 2" "$RC" 2
has "2: unknown flag message" "$ERR" "unknown flag: --bogus"
no_claude "2: unknown flag calls no claude"

# 3
run_fix "$SUT"
rc_is "3: unset arg exits 2" "$RC" 2
has "3: unset arg message" "$ERR" "expected exactly one"
run_fix "$SUT" ""
rc_is "3: empty arg exits 2" "$RC" 2
has "3: empty arg message" "$ERR" "expected exactly one"
run_fix "$SUT" a b
rc_is "3: two args exit 2" "$RC" 2
no_claude "3: bad arg count calls no claude"

# 4
run_fix "$SUT" 999
rc_is "4: unknown PR exits 1" "$RC" 1
has "4: unknown PR message" "$ERR" "PR #999 not found"
no_claude "4: unknown PR calls no claude"

# 5
run_fix "$SUT" nosuch-branch
rc_is "5: unknown slug exits 1" "$RC" 1
has "5: unknown slug message" "$ERR" "no worktree has branch nosuch-branch"
no_claude "5: unknown slug calls no claude"

# 6
run_fix "$SUT" "$B_PREFIX"
rc_is "6: branch prefix exits 1" "$RC" 1
has "6: branch prefix message" "$ERR" "no worktree has branch"
no_claude "6: branch prefix calls no claude"

# 7
run_fix "$SUT" 42
rc_is "7: PR path exits 0" "$RC" 0
WANT_CWD=$(cd "$TMP/wt-$B_BLOCK" && pwd -P)
GOT_CWD=""; [ -f "$TMP/claude.cwd" ] && GOT_CWD=$(cat "$TMP/claude.cwd")
if [ "$GOT_CWD" = "$WANT_CWD" ]; then ok "7: claude runs in the branch worktree"; else fail "7: claude cwd" "got '$GOT_CWD'"; fi
GOT_ARGC=""; [ -f "$TMP/claude.argc" ] && GOT_ARGC=$(cat "$TMP/claude.argc")
if [ "$GOT_ARGC" = "1" ]; then ok "7: claude gets exactly one argv element"; else fail "7: claude argc" "got '$GOT_ARGC'"; fi
for tok in BLOCKMARK "ship blocked (exit 3)" "PR #42" "live-$B_BLOCK-20261008-120000-2" audit.log \
    blocked-ship.txt "$RUNLOG/post-plan-now-$B_BLOCK-" "Do not ship" "untrusted program output"; do
    has "7: prompt names '$tok'" "$PROMPT" "$tok"
done
hasnt "7: newest run wins (no OLDRUN)" "$PROMPT" "OLDRUN"

# 8
run_fix "$SUT" "$B_JSON"
rc_is "8: slug path exits 0" "$RC" 0
if [ -e "$TMP/gh.called" ]; then fail "8: gh not called for a slug"; else ok "8: gh not called for a slug"; fi
has "8: prompt carries the stage" "$PROMPT" "failed / gh"
has "8: prompt carries the error" "$PROMPT" "JSONMARK"
hasnt "8: no blocked-ship.txt line" "$PROMPT" "blocked-ship.txt:"

# 9
run_fix "$SUT" "$B_NORUN"
rc_is "9: no run dir still exits 0" "$RC" 0
has "9: prompt says no run dir" "$PROMPT" "no harness run dir found"
has "9: prompt says cause not recorded" "$PROMPT" "cause not recorded; read audit.log"

# 10
run_fix "$SUT" "$B_BIG"
rc_is "10: big text exits 0" "$RC" 0
hasnt "10: text is capped (no TAILMARK)" "$PROMPT" "TAILMARK"
if [ "${#PROMPT}" -lt 3000 ]; then ok "10: prompt under 3000 bytes"; else fail "10: prompt size" "${#PROMPT}"; fi

# 11
run_fix "$TMP/wt-$B_JSON/bin/postplan-fix" "$B_JSON"
rc_is "11: linked-worktree caller exits 0" "$RC" 0
has "11: worktree's own out dir found" "$PROMPT" "JSONMARK"
run_fix "$TMP/wt-$B_JSON/bin/postplan-fix" "$B_BLOCK"
rc_is "11: main out dir reached from a worktree exits 0" "$RC" 0
has "11: main out dir searched" "$PROMPT" "BLOCKMARK"

# 12
rm -f "$TMP/claude.prompt"
env -i POSTPLAN_LOG_DIR="$POSTPLAN_LOG_DIR" \
    IBL5_USAGE_GATE_STATE_DIR="$IBL5_USAGE_GATE_STATE_DIR" IBL5_USAGE_CLAUDE_PROJECTS="$IBL5_USAGE_CLAUDE_PROJECTS" IBL5_USAGE_GATE_TEST_MODE="$IBL5_USAGE_GATE_TEST_MODE" \
    PATH="$STUB:/usr/bin:/bin" /bin/bash -c 'set -euo pipefail; "$1" "$2"' _ "$SUT" "$B_BLOCK" \
    >/dev/null 2>"$TMP/err"; RC=$?
rc_is "12: env -i probe exits 0" "$RC" 0
PROMPT=""; [ -f "$TMP/claude.prompt" ] && PROMPT=$(cat "$TMP/claude.prompt")
has "12: env -i probe reaches claude with the text" "$PROMPT" "BLOCKMARK"
has "12: env -i probe finds the private runner log" "$PROMPT" "$RUNLOG/post-plan-now-$B_BLOCK-"

# 13
SAVED_RUNLOG_DIR="$POSTPLAN_LOG_DIR"
unset POSTPLAN_LOG_DIR
run_fix "$SUT" "$B_BLOCK"
rc_is "13: unset POSTPLAN_LOG_DIR still exits 0" "$RC" 0
hasnt "13: unset var does not read the private log dir" "$PROMPT" "$RUNLOG"
hasnt "13: unset var finds no shared-/tmp log for this slug" "$PROMPT" "post-plan-now log:"
export POSTPLAN_LOG_DIR=''
run_fix "$SUT" "$B_BLOCK"
rc_is "13: empty POSTPLAN_LOG_DIR still exits 0" "$RC" 0
hasnt "13: empty var does not read the private log dir" "$PROMPT" "$RUNLOG"
export POSTPLAN_LOG_DIR="$SAVED_RUNLOG_DIR"

# --- headless rescue mode (--headless [--dry-run]) ---
# Each case collects its checks with need() and reports once through h_pass as
# "case ok headless-<name>" (or one h_fail naming every failed check).
# Cases 14-24 start from the same state: B_CONFLICT at its feature tip, clean tree, and
# origin/<B_CONFLICT> at the fixture's init commit.
WTC="$TMP/wt-$B_CONFLICT"
TIP=$(git -C "$WTC" rev-parse HEAD)
WTP=$(git -C "$MAIN" worktree list --porcelain | awk -v b="refs/heads/$B_CONFLICT" '
    /^worktree / { p = substr($0, 10) }
    /^branch /   { if (substr($0, 8) == b && !f) { print p; f=1 } }
')
mkdir -p "$TMP/effects"
hl_bad=""
need() { local d="$1"; shift; if ! "$@"; then hl_bad+="$d; "; fi; }
case_end() {
    if [ -z "$hl_bad" ]; then h_pass "case ok $1"; else h_fail "$1" "$hl_bad"; fi
    hl_bad=""
}
has_s() { case "$1" in *"$2"*) return 0 ;; esac; return 1; }
ends_s() { case "$1" in *"$2") return 0 ;; esac; return 1; }
no_args() { [ ! -e "$TMP/claude.args" ]; }
hl_reset() {
    git -C "$WTC" rebase --abort >/dev/null 2>&1 || true
    git -C "$WTC" reset -q --hard "$TIP"
    git -C "$WTC" clean -fdq
    git -C "$MAIN" update-ref "refs/remotes/origin/$B_CONFLICT" "$INIT_SHA"
    unset CLAUDE_STUB_REPLY CLAUDE_STUB_EFFECT CLAUDE_STUB_STDERR
}
no_merge() { [ ! -d "$(git -C "$WTC" rev-parse --path-format=absolute --git-path rebase-merge)" ]; }
origin_branch() { git --git-dir="$TMP/origin.git" rev-parse "refs/heads/$B_CONFLICT" 2>/dev/null || echo none; }
printf 'SUMMARY: kept both\nRESOLVED\n' > "$TMP/reply-resolved"
printf 'SUMMARY: gave up\nFAILED\n' > "$TMP/reply-failed"
printf 'printf "feature\\nmaster\\n" > a.txt\ngit add a.txt\n' > "$TMP/effects/resolve.sh"
printf 'git update-ref "refs/remotes/origin/%s" HEAD\n' "$B_CONFLICT" > "$TMP/effects/moveref.sh"
MASTER_TIP=$(git -C "$MAIN" rev-parse refs/heads/master)
REAL_GIT=$(command -v git)
B_GONE="pfx$$-gone"; B_NEW="pfx$$-new"; R_SIB="refs/remotes/origin/$B_CONFLICT-sib"
RESTORE_MSG="postplan-fix: restore after session moved refs"
{ cat "$TMP/effects/resolve.sh"; printf 'git update-ref refs/heads/master %s\n' "$INIT_SHA"; } \
    > "$TMP/effects/move-master.sh"
{ cat "$TMP/effects/resolve.sh"
  printf 'git update-ref refs/heads/%s %s\n' "$B_NEW" "$INIT_SHA"
  printf 'git update-ref -d refs/heads/%s\n' "$B_GONE"
  printf 'git update-ref %s %s\n' "$R_SIB" "$INIT_SHA"; } > "$TMP/effects/branch-churn.sh"
printf 'git update-ref -d "refs/remotes/origin/%s"\n' "$B_CONFLICT" > "$TMP/effects/delref.sh"
# Test-only git shim: just before postplan-fix's restore update-ref runs, move the
# own remote-tracking ref once more, as a concurrent fetch would.
mkdir -p "$TMP/gitshim"
cat > "$TMP/gitshim/git" <<SHIMEOF
#!/bin/bash
case " \$* " in
    *" $RESTORE_MSG "*)
        if [ ! -e "$TMP/race.done" ]; then
            : > "$TMP/race.done"
            "$REAL_GIT" -C "$MAIN" update-ref "refs/remotes/origin/$B_CONFLICT" "$TIP"
        fi ;;
esac
exec "$REAL_GIT" "\$@"
SHIMEOF
chmod +x "$TMP/gitshim/git"
printf 'printf "feature\\nmaster\\n" > a.txt\ngit add a.txt\nprintf stray > stray.txt\n' > "$TMP/effects/untracked.sh"

# 14
if should_run "headless-reject-forms"; then
hl_reset
for args in "--headless=1 x" "--dry-run x" "--bogus"; do
    # shellcheck disable=SC2086
    run_fix "$SUT" $args
    need "rc 2 for '$args'" test "$RC" = 2
    if has_s "$ERR" "unknown flag" || has_s "$ERR" "needs --headless"; then :; else hl_bad+="message for '$args'; "; fi
    need "no stub call for '$args'" no_args
done
case_end headless-reject-forms
fi

# 15 (case 16 compares against REMOTE0; neither ref moves between here and case 16)
ORIGIN0=$(git --git-dir="$TMP/origin.git" rev-parse refs/heads/master)
REMOTE0=$(git -C "$WTC" rev-parse refs/remotes/origin/master)
if should_run "headless-dry-run"; then
hl_reset
run_fix "$SUT" --headless --dry-run "$B_CONFLICT"
need "rc 0" test "$RC" = 0
need "no stub call" no_args
need "origin.git unchanged" test "$(git --git-dir="$TMP/origin.git" rev-parse refs/heads/master)" = "$ORIGIN0"
need "origin/master unchanged" test "$(git -C "$WTC" rev-parse refs/remotes/origin/master)" = "$REMOTE0"
need "no rebase in progress" no_merge
# shellcheck disable=SC2088  # the prompt holds a literal ~/claude-plans/
for tok in "argv:" "--model" "claude-sonnet-5-5" "--disallowedTools" "Bash(git push:*)" "Bash(gh:*)" "Bash(*/git push:*)" "Bash(git * push *)" \
    "Bash(git -C:*)" "--max-budget-usd" "SUMMARY:" "RESOLVED" "FAILED" "Do NOT commit" "~/claude-plans/"; do
    need "stdout has '$tok'" has_s "$STDOUT" "$tok"
done
case_end headless-dry-run
fi

# 16
if should_run "headless-refuses-main"; then
hl_reset
run_fix "$SUT" --headless master
need "rc 2" test "$RC" = 2
need "message" has_s "$ERR" "refuses the main checkout"
need "no stub call" no_args
need "origin/master unchanged (no fetch)" test "$(git -C "$WTC" rev-parse refs/remotes/origin/master)" = "$REMOTE0"
case_end headless-refuses-main
fi

# 17
if should_run "headless-dirty-tree"; then
hl_reset
printf 'x\n' > "$WTC/untracked.txt"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "message" has_s "$ERR" "worktree is dirty"
need "no rebase in progress" no_merge
need "no stub call" no_args
case_end headless-dirty-tree
fi

# 18
if should_run "headless-resolves-and-commits"; then
hl_reset
ORIGIN_BR0=$(origin_branch)
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/resolve.sh"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 0 (stderr: $ERR)" test "$RC" = 0
need "one parent, the origin/master tip" test "$(git -C "$WTC" log -1 --format=%P)" = "$(git -C "$WTC" rev-parse refs/remotes/origin/master)"
need "origin branch unchanged" test "$(origin_branch)" = "$ORIGIN_BR0"
need "stub cwd is the worktree" test "$(cat "$TMP/claude.cwd" 2>/dev/null)" = "$(cd "$WTC" && pwd -P)"
need "stdout says nothing pushed" has_s "$STDOUT" "nothing pushed"
need "stdout carries the ship line" has_s "$STDOUT" "cd $WTP && bin/post-plan-now"
need "stdout ends with the result word" ends_s "$STDOUT" "postplan-fix: headless result=committed"
need "a.txt resolved" test "$(cat "$WTC/a.txt")" = "$(printf 'feature\nmaster')"
case_end headless-resolves-and-commits
fi

# 19
if should_run "headless-failed-verdict"; then
hl_reset
export CLAUDE_STUB_REPLY="$TMP/reply-failed"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "no rebase in progress" no_merge
need "HEAD is the branch tip" test "$(git -C "$WTC" rev-parse HEAD)" = "$TIP"
need "a.txt is feature" test "$(cat "$WTC/a.txt")" = "feature"
need "stderr names the verdict" has_s "$ERR" "session ended FAILED"
case_end headless-failed-verdict
fi

# 20
if should_run "headless-markers-remain"; then
hl_reset
printf 'RESOLVED\n' > "$TMP/reply-bare-resolved"
export CLAUDE_STUB_REPLY="$TMP/reply-bare-resolved"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "stderr names the markers (got: $ERR)" has_s "$ERR" "conflict markers remain"
need "no rebase in progress" no_merge
need "HEAD is the branch tip" test "$(git -C "$WTC" rev-parse HEAD)" = "$TIP"
case_end headless-markers-remain
fi

# 21
if should_run "headless-moved-ref"; then
hl_reset
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/moveref.sh"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "stderr names moved refs" has_s "$ERR" "session moved refs"
need "ref restored" test "$(git -C "$WTC" rev-parse "refs/remotes/origin/$B_CONFLICT")" = "$INIT_SHA"
need "restore reflog message" test "$(git -C "$WTC" reflog show -1 --format=%gs "refs/remotes/origin/$B_CONFLICT")" = "postplan-fix: restore after session moved refs"
need "no rebase in progress" no_merge
case_end headless-moved-ref
fi

# 21b: a stray untracked file outside the remit aborts the run
if should_run "headless-untracked-outside-remit"; then
hl_reset
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/untracked.sh"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "stderr names the stray path (got: $ERR)" has_s "$ERR" "session touched stray.txt outside its remit"
need "no rebase in progress" no_merge
case_end headless-untracked-outside-remit
fi

# 21c: the prompt arrives on stdin, and stderr noise after RESOLVED does not flip the verdict
if should_run "headless-stdin-and-stderr"; then
hl_reset
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/resolve.sh"
export CLAUDE_STUB_STDERR="warning: late stderr line"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 0 (stderr: $ERR)" test "$RC" = 0
need "prompt read from stdin" has_s "$PROMPT" "Headless remit"
need "prompt is not an argv element" test "$(grep -c 'Headless remit' "$TMP/claude.args")" = 0
case_end headless-stdin-and-stderr
fi

# 21d: another checkout moving refs/heads/master during the session is kept, not rolled back
if should_run "headless-unrelated-master-moved"; then
hl_reset
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/move-master.sh"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 0 (stderr: $ERR)" test "$RC" = 0
need "no session-moved-refs abort" eval '! has_s "$ERR" "session moved refs"'
need "master keeps its new value" test "$(git -C "$MAIN" rev-parse refs/heads/master)" = "$INIT_SHA"
need "no restore entry in master's reflog" eval '! git -C "$MAIN" reflog show -1 --format=%gs refs/heads/master | grep -qF "$RESTORE_MSG"'
git -C "$MAIN" update-ref refs/heads/master "$MASTER_TIP"
case_end headless-unrelated-master-moved
fi

# 21e: an unrelated branch created and another deleted during the session stay that way
if should_run "headless-unrelated-branch-churn"; then
hl_reset
git -C "$MAIN" update-ref "refs/heads/$B_GONE" "$INIT_SHA"
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/branch-churn.sh"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 0 (stderr: $ERR)" test "$RC" = 0
need "no session-moved-refs abort" eval '! has_s "$ERR" "session moved refs"'
need "created branch kept" git -C "$MAIN" rev-parse -q --verify "refs/heads/$B_NEW"
need "deleted branch stays deleted" eval '! git -C "$MAIN" rev-parse -q --verify "refs/heads/$B_GONE"'
need "name-prefix sibling ref kept" git -C "$MAIN" rev-parse -q --verify "$R_SIB"
git -C "$MAIN" update-ref -d "refs/heads/$B_NEW"
git -C "$MAIN" update-ref -d "$R_SIB"
case_end headless-unrelated-branch-churn
fi

# 21f: the own ref moves again after REFS1 is read; the CAS restore leaves the new value
if should_run "headless-restore-cas"; then
hl_reset
rm -f "$TMP/race.done"
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/moveref.sh"
PATH="$TMP/gitshim:$PATH" run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "shim raced the restore" test -e "$TMP/race.done"
need "stderr names moved refs" has_s "$ERR" "session moved refs"
need "stderr names the CAS miss" has_s "$ERR" "moved again after the session; left as is"
need "raced value survives" test "$(git -C "$WTC" rev-parse "refs/remotes/origin/$B_CONFLICT")" = "$TIP"
need "no rebase in progress" no_merge
case_end headless-restore-cas
fi

# 21g: the session deleted its own remote-tracking ref; restore recreates it
if should_run "headless-own-ref-deleted"; then
hl_reset
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/delref.sh"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "stderr names moved refs" has_s "$ERR" "session moved refs"
need "ref recreated" test "$(git -C "$WTC" rev-parse -q --verify "refs/remotes/origin/$B_CONFLICT")" = "$INIT_SHA"
need "restore reflog message" test "$(git -C "$WTC" reflog show -1 --format=%gs "refs/remotes/origin/$B_CONFLICT")" = "$RESTORE_MSG"
case_end headless-own-ref-deleted
fi

# 21h: the session created its own remote-tracking ref; restore deletes it
if should_run "headless-own-ref-created"; then
hl_reset
git -C "$MAIN" update-ref -d "refs/remotes/origin/$B_CONFLICT"
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/moveref.sh"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "stderr names moved refs" has_s "$ERR" "session moved refs"
need "created own ref removed" eval '! git -C "$WTC" rev-parse -q --verify "refs/remotes/origin/$B_CONFLICT"'
case_end headless-own-ref-created
fi

# 21i: a sibling ref under the own remote ref's name is not an own-ref move
if should_run "headless-own-ref-sibling"; then
hl_reset
git -C "$MAIN" update-ref -d "refs/remotes/origin/$B_CONFLICT"
printf 'git update-ref "refs/remotes/origin/%s/x" %s\n' "$B_CONFLICT" "$INIT_SHA" > "$TMP/effects/sibling.sh"
export CLAUDE_STUB_REPLY="$TMP/reply-failed" CLAUDE_STUB_EFFECT="$TMP/effects/sibling.sh"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "no session-moved-refs abort" eval '! has_s "$ERR" "session moved refs"'
need "stderr names the verdict" has_s "$ERR" "session ended FAILED"
need "sibling ref kept" git -C "$MAIN" rev-parse -q --verify "refs/remotes/origin/$B_CONFLICT/x"
git -C "$MAIN" update-ref -d "refs/remotes/origin/$B_CONFLICT/x"
case_end headless-own-ref-sibling
fi

# 22
if should_run "headless-clean-rebase"; then
hl_reset
run_fix "$SUT" --headless "$B_CLEAN"
need "rc 0" test "$RC" = 0
need "stdout says rebases cleanly" has_s "$STDOUT" "rebases cleanly"
need "result=clean" ends_s "$STDOUT" "postplan-fix: headless result=clean"
need "no merge commits in BASE..HEAD" test -z "$(git -C "$TMP/wt-$B_CLEAN" rev-list --merges refs/remotes/origin/master..HEAD)"
need "HEAD descends from BASE" git -C "$TMP/wt-$B_CLEAN" merge-base --is-ancestor refs/remotes/origin/master HEAD
need "no stub call" no_args
case_end headless-clean-rebase
fi

if should_run "headless-merge-edit-survives"; then
hl_reset
B_MERGE="pfx$$-mergeedit"
WTM="$TMP/wt-$B_MERGE"
git -C "$MAIN" worktree add -q -b "$B_MERGE" "$WTM" "$INIT_SHA"
printf 'one\n' > "$WTM/b.txt"; git -C "$WTM" add b.txt
"${GITC[@]}" -C "$WTM" commit -qm branch-one
git -C "$MAIN" branch -q "$B_MERGE-side" "$INIT_SHA"
git -C "$MAIN" worktree add -q "$TMP/wt-$B_MERGE-side" "$B_MERGE-side"
printf 'side\n' > "$TMP/wt-$B_MERGE-side/s.txt"; git -C "$TMP/wt-$B_MERGE-side" add s.txt
"${GITC[@]}" -C "$TMP/wt-$B_MERGE-side" commit -qm side
"${GITC[@]}" -C "$WTM" merge -q --no-commit --no-ff "$B_MERGE-side"
printf 'edited inside the merge\n' > "$WTM/b.txt"; git -C "$WTM" add b.txt
"${GITC[@]}" -C "$WTM" commit -qm merge-with-edit
run_fix "$SUT" --headless "$B_MERGE"
need "rc 0 (stderr: $ERR)" test "$RC" = 0
need "result=clean" ends_s "$STDOUT" "postplan-fix: headless result=clean"
need "the edit made inside the merge survives" test "$(cat "$WTM/b.txt")" = "edited inside the merge"
need "no merge commits in BASE..HEAD" test -z "$(git -C "$WTM" rev-list --merges refs/remotes/origin/master..HEAD)"
git -C "$MAIN" worktree remove --force "$WTM"
git -C "$MAIN" worktree remove --force "$TMP/wt-$B_MERGE-side"
case_end headless-merge-edit-survives
fi

# 22b-d: machine-readable result words and the pre-merge manifest the harness reads.
PM_MANIFEST="/tmp/postplan-premerged-$B_CONFLICT.json"
PM_FLAG="/tmp/postplan-conflict-resolved-$B_CONFLICT"
pm_clean() {
    rm -f "$PM_MANIFEST" "$PM_FLAG" \
        "/tmp/postplan-premerged-$B_CLEAN.json" "/tmp/postplan-conflict-resolved-$B_CLEAN"
}
trap 'pm_clean; rm -rf "$TMP"' EXIT
last_line() { printf '%s\n' "$1" | tail -n 1; }
first_line() { printf '%s\n' "$1" | head -n 1; }

if should_run "headless-result-committed"; then
hl_reset; pm_clean
ORIGIN_BR0=$(origin_branch)
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/resolve.sh"
run_fix "$SUT" --headless "$B_CONFLICT"
NEW_HEAD=$(git -C "$WTC" rev-parse HEAD)
PM_JSON=$(cat "$PM_MANIFEST" 2>/dev/null || true)
need "rc 0 (stderr: $ERR)" test "$RC" = 0
need "head0 line comes first" test "$(first_line "$STDOUT")" = "postplan-fix: headless head0=$TIP wt=$WTP"
need "last line is the result word" test "$(last_line "$STDOUT")" = "postplan-fix: headless result=committed"
need "manifest exists" test -f "$PM_MANIFEST"
need "manifest sha is the new HEAD" has_s "$PM_JSON" "\"sha\": \"$NEW_HEAD\""
need "manifest pre_sha is head0" has_s "$PM_JSON" "\"pre_sha\": \"$TIP\""
need "manifest lists the conflicted file" has_s "$PM_JSON" "\"files\": [\"a.txt\"]"
need "flag holds the new HEAD" has_s "$(cat "$PM_FLAG" 2>/dev/null || true)" "$NEW_HEAD"
need "nothing pushed" test "$(origin_branch)" = "$ORIGIN_BR0"
case_end headless-result-committed
fi

if should_run "headless-rebase-linear"; then
hl_reset; pm_clean
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/resolve.sh"
run_fix "$SUT" --headless "$B_CONFLICT"
BASE_TIP=$(git -C "$WTC" rev-parse refs/remotes/origin/master)
PM_JSON=$(cat "$PM_MANIFEST" 2>/dev/null || true)
need "rc 0 (stderr: $ERR)" test "$RC" = 0
need "HEAD has one parent" test "$(git -C "$WTC" log -1 --format=%P | wc -w | tr -d ' ')" = 1
need "the parent is the BASE tip" test "$(git -C "$WTC" rev-parse HEAD^)" = "$BASE_TIP"
need "stdout says rebased locally" has_s "$STDOUT" "rebased $B_CONFLICT onto origin/master locally"
need "manifest pre_sha is head0" has_s "$PM_JSON" "\"pre_sha\": \"$TIP\""
need "no rebase in progress" no_merge
case_end headless-rebase-linear
fi

if should_run "headless-abort-restores-head0"; then
hl_reset; pm_clean
export CLAUDE_STUB_REPLY="$TMP/reply-failed"
run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "branch ref is head0" test "$(git -C "$WTC" rev-parse "refs/heads/$B_CONFLICT")" = "$TIP"
need "HEAD is head0" test "$(git -C "$WTC" rev-parse HEAD)" = "$TIP"
need "no rebase-merge dir" no_merge
need "no manifest" test ! -e "$PM_MANIFEST"
case_end headless-abort-restores-head0
fi

if should_run "headless-clean-rebinds-carried-flag"; then
hl_reset; pm_clean
CLEAN_WT="$TMP/wt-$B_CLEAN"
# An earlier case left this branch on the base tip. Cut back one commit so the replay has work to do.
git -C "$CLEAN_WT" reset -q --hard refs/remotes/origin/master~1
printf 'own\n' > "$CLEAN_WT/own-$$.txt"
git -C "$CLEAN_WT" add -A
git -C "$CLEAN_WT" commit -q -m "own commit" --no-verify
CLEAN_HEAD0=$(git -C "$CLEAN_WT" rev-parse HEAD)
printf '%s\n' "$CLEAN_HEAD0" > "/tmp/postplan-conflict-resolved-$B_CLEAN"
run_fix "$SUT" --headless "$B_CLEAN"
CLEAN_NEW=$(git -C "$CLEAN_WT" rev-parse HEAD)
need "rc 0" test "$RC" = 0
need "result=clean" ends_s "$STDOUT" "postplan-fix: headless result=clean"
need "HEAD moved" test "$CLEAN_NEW" != "$CLEAN_HEAD0"
need "marker keeps the old SHA" has_s "$(cat "/tmp/postplan-conflict-resolved-$B_CLEAN")" "$CLEAN_HEAD0"
need "marker gains the new HEAD" has_s "$(cat "/tmp/postplan-conflict-resolved-$B_CLEAN")" "$CLEAN_NEW"
pm_clean
case_end headless-clean-rebinds-carried-flag
fi

if should_run "headless-resolution-runs-hook"; then
hl_reset; pm_clean
mkdir -p "$TMP/deny-hooks"
printf '#!/bin/sh\n[ -d "$(git rev-parse --git-path rebase-merge)" ] || exit 0\necho hook-says-no >&2\nexit 1\n' > "$TMP/deny-hooks/pre-commit"
chmod +x "$TMP/deny-hooks/pre-commit"
HP0=$(git -C "$WTC" config --get core.hooksPath || true)
git -C "$WTC" config core.hooksPath "$TMP/deny-hooks"
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/resolve.sh"
run_fix "$SUT" --headless "$B_CONFLICT"
if [ -n "$HP0" ]; then git -C "$WTC" config core.hooksPath "$HP0"; else git -C "$WTC" config --unset core.hooksPath || true; fi
need "rc 1" test "$RC" = 1
need "stderr names the hook denial (got: $ERR)" has_s "$ERR" "pre-commit hook denied the resolution"
need "HEAD is head0" test "$(git -C "$WTC" rev-parse HEAD)" = "$TIP"
need "no rebase in progress" no_merge
need "no manifest" test ! -e "$PM_MANIFEST"
case_end headless-resolution-runs-hook
fi

if should_run "headless-result-clean"; then
hl_reset; pm_clean
run_fix "$SUT" --headless "$B_CLEAN"
need "rc 0" test "$RC" = 0
need "last line is the result word" test "$(last_line "$STDOUT")" = "postplan-fix: headless result=clean"
need "no manifest" test ! -e "/tmp/postplan-premerged-$B_CLEAN.json"
need "no flag" test ! -e "/tmp/postplan-conflict-resolved-$B_CLEAN"
case_end headless-result-clean
fi

# Stacked branch: the rescue rebases onto the declared parent and leaves master out.
stack_reset() {
    git -C "$WTS" rebase --abort >/dev/null 2>&1 || true
    git -C "$WTS" reset -q --hard "$STIP"
    git -C "$WTS" clean -fdq
    git -C "$MAIN" config "branch.$B_STACK.iblBase" "${1:-stackparent}"
    rm -f "/tmp/postplan-premerged-$B_STACK.json" "/tmp/postplan-conflict-resolved-$B_STACK"
    unset CLAUDE_STUB_REPLY CLAUDE_STUB_EFFECT CLAUDE_STUB_STDERR
}
WTS="$TMP/wt-$B_STACK"
STIP=$(git -C "$WTS" rev-parse HEAD)

if should_run "headless-stacked-base"; then
stack_reset
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/resolve.sh"
run_fix "$SUT" --headless "$B_STACK"
S_PARENT=$(git -C "$WTS" rev-parse refs/remotes/origin/stackparent)
need "rc 0 (stderr: $ERR)" test "$RC" = 0
need "one parent, the declared parent tip" test "$(git -C "$WTS" log -1 --format='%P' HEAD)" = "$S_PARENT"
need "master is not an ancestor" test ! "$(git -C "$WTS" merge-base --is-ancestor refs/remotes/origin/master HEAD && echo yes)" = yes
need "last line is the result word" test "$(last_line "$STDOUT")" = "postplan-fix: headless result=committed"
stack_reset
case_end headless-stacked-base
fi

if should_run "headless-stacked-unresolved"; then
stack_reset gone
run_fix "$SUT" --headless "$B_STACK"
need "rc 1" test "$RC" = 1
need "last line is the result word" test "$(last_line "$STDOUT")" = "postplan-fix: headless result=gave-up-base"
need "stderr names the fix" has_s "$ERR" "git config branch."
need "HEAD unchanged" test "$(git -C "$WTS" rev-parse HEAD)" = "$STIP"
need "no merge started" test ! -e "$WTS/.git" -o -z "$(git -C "$WTS" rev-parse -q --verify MERGE_HEAD 2>/dev/null)"
need "no stub call" no_args
stack_reset
case_end headless-stacked-unresolved
fi

if should_run "headless-record-failure-resets"; then
hl_reset; pm_clean
mkdir -p "$TMP/pystub"
REAL_PY=$(command -v python3)
cat > "$TMP/pystub/python3" <<PYEOF
#!/bin/bash
case " \$* " in *" -m harness.premerge "*) exit 3 ;; esac
exec "$REAL_PY" "\$@"
PYEOF
chmod +x "$TMP/pystub/python3"
export CLAUDE_STUB_REPLY="$TMP/reply-resolved" CLAUDE_STUB_EFFECT="$TMP/effects/resolve.sh"
PATH="$TMP/pystub:$PATH" run_fix "$SUT" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "result word" has_s "$STDOUT" "postplan-fix: headless result=gave-up-record"
need "stderr names the reset" has_s "$ERR" "could not record the resolution manifest; reset to $TIP"
need "HEAD is head0" test "$(git -C "$WTC" rev-parse HEAD)" = "$TIP"
need "no rebase in progress" no_merge
need "no manifest" test ! -e "$PM_MANIFEST"
case_end headless-record-failure-resets
fi
pm_clean

# 23
if should_run "headless-no-harness"; then
hl_reset
MAIN2="$TMP/main2"
git init -q "$MAIN2"
mkdir -p "$MAIN2/bin"
cp "$ROOT/bin/postplan-fix" "$MAIN2/bin/postplan-fix"
cp -R "$ROOT/bin/lib" "$MAIN2/bin/lib"
git -C "$MAIN2" add -A
git -C "$MAIN2" commit -qm init
git -C "$MAIN2" worktree add -q -b "$B_CONFLICT" "$TMP/wt2-$B_CONFLICT"
run_fix "$MAIN2/bin/postplan-fix" --headless "$B_CONFLICT"
need "rc 1" test "$RC" = 1
need "message" has_s "$ERR" "denied-tool list unavailable"
need "no stub call" no_args
case_end headless-no-harness
fi

# 24
if should_run "headless-env-i"; then
hl_reset
mkdir -p "$TMP/home"
env -i PATH=/usr/bin:/bin HOME="$TMP/home" POSTPLAN_LOG_DIR="$RUNLOG" \
    bash -o pipefail "$SUT" --headless --dry-run "$B_CONFLICT" >/dev/null 2>"$TMP/err"; RC=$?
ERR=$(cat "$TMP/err")
need "rc 0 (stderr: $ERR)" test "$RC" = 0
case_end headless-env-i
fi

# --- --holdrepeat: a bounded claude session fixes a repeat post-plan hold on condition 3 ---
# claude, gh, discord-dm, post-plan-now and launchctl are stubs. PR 77 is B_HR's PR. Each case
# drives the real launcher: hr_reset seeds the hold record through the production writer
# (harness.holdrepeat.observe), then the case runs the script and checks exit code, the final
# "result=" line and the side effects (refs, DMs, gh calls, post-plan re-fire, ledger).
export HOME="$TMP/hrhome"; mkdir -p "$HOME/.claude/hooks"   # no real user hooks seen by the gate-path guard
WTH="$TMP/wt-$B_HR"
HR_STATE="$TMP/hrstate"; HR_PLANS="$TMP/plans"; mkdir -p "$HR_PLANS"
git -C "$MAIN" worktree add -q -b "$B_HR" "$WTH" master
# The branch sits one commit ahead of master, like a real PR branch. A zero-ahead fixture hides
# any check that diffs the staged tree against origin/master instead of HEAD.
printf 'fixture\n' > "$WTH/hr-branch-work.txt"
git -C "$WTH" add hr-branch-work.txt
git -C "$WTH" commit -q -m "branch work ahead of master"
git -C "$WTH" push -q origin "$B_HR"
git -C "$WTH" fetch -q origin "$B_HR"
HR_TIP=$(git -C "$WTH" rev-parse HEAD)
HR_REASON='MISSING: bin/test-widget; MISSING-FILE: bin/widget-tool; UNREALISED-ASSERTION: row 1 -- The widget renders `widgetmark`'
cat > "$TMP/plan.orig" <<'PLANEOF'
# Widget plan

## Verification Matrix

| # | What to verify | Test type | Timing | Test file / location |
|---|---------------|-----------|--------|---------------------|
| 1 | The widget renders `widgetmark` | CLI-executable | post-impl | `bin/test-widget` |

## Critical Files

- `bin/widget-tool`
PLANEOF
cat > "$TMP/hr-seed.py" <<'PYEOF'
import sys
from types import SimpleNamespace
from harness import holdrepeat as hr

state, slug, reason = sys.argv[1:4]
extra = len(sys.argv) > 4 and sys.argv[4] != ""
conds = [SimpleNamespace(number=3, name="cond-3", blocked=True, reason=reason)]
if extra:
    conds.append(SimpleNamespace(number=14, name="cond-14", blocked=True, reason="review finding"))
hr.observe(state, slug, armed=False, conditions=conds, fingerprint="fp", pr=77,
           now="2026-10-23T12:00:00Z")
PYEOF
hr_seed() { PYTHONPATH="$ROOT/tools/postplan-harness" python3 "$TMP/hr-seed.py" "$1" "$B_HR" "$2" "${3:-}"; }
printf '{"five_hour":null,"seven_day":{"utilization":10}}\n' > "$TMP/usage-ok.json"
printf '{"five_hour":null,"seven_day":{"utilization":99}}\n' > "$TMP/usage-stop.json"
cat > "$TMP/dm-stub" <<STUBEOF
#!/bin/bash
{ printf 'ARGS:%s\n' "\$*"; cat; printf '\n@@DM@@\n'; } >> "$TMP/dm.log"
STUBEOF
cat > "$TMP/ppn-stub" <<STUBEOF
#!/bin/bash
printf 'args=%s headless=%s cwd=%s\n' "\$*" "\${CLAUDE_HEADLESS-unset}" "\$(pwd -P)" >> "$TMP/ppn.calls"
exit \${PPN_STUB_RC:-0}
STUBEOF
cat > "$TMP/launchctl-stub" <<STUBEOF
#!/bin/bash
cat "$TMP/launchctl.list" 2>/dev/null
exit 0
STUBEOF
chmod +x "$TMP/dm-stub" "$TMP/ppn-stub" "$TMP/launchctl-stub"
hr_env() {
    export PLANS_DIR="$HR_PLANS" POSTPLAN_FIX_STATE_DIR="$HR_STATE" POSTPLAN_FIX_DISCORD_DM="$TMP/dm-stub" \
        POSTPLAN_FIX_POST_PLAN_NOW="$TMP/ppn-stub" POSTPLAN_FIX_USAGE_JSON="$TMP/usage-ok.json" \
        LAUNCHCTL_CMD="$TMP/launchctl-stub"
}
hr_reset() {
    git -C "$WTH" reset -q --hard "$HR_TIP"
    git -C "$WTH" clean -fdq
    git --git-dir="$TMP/origin.git" update-ref "refs/heads/$B_HR" "$HR_TIP"
    git -C "$WTH" fetch -q origin "$B_HR"
    rm -rf "$HR_STATE"; mkdir -p "$HR_STATE"
    hr_seed "$HR_STATE" "$HR_REASON"
    cp "$TMP/plan.orig" "$HR_PLANS/$B_HR.md"
    rm -f "$TMP/dm.log" "$TMP/ppn.calls" "$TMP/launchctl.list" "$TMP/gh.snap.after" "$TMP/gh.snap.before.json" "$TMP/gh.snap.after.json" "$TMP/gh.lastcomment" "$TMP/gh.comment" "$TMP/gh.commentfail" "$TMP/gh.paged"
    printf 'Fix widget\tbug\tno\n' > "$TMP/gh.snap.before"
    unset CLAUDE_STUB_REPLY CLAUDE_STUB_EFFECT CLAUDE_STUB_STDERR CLAUDE_HEADLESS PPN_STUB_RC
    hr_env
}
hr_env
# Effects run inside the worktree (the stub claude inherits the launcher's cwd).
HR_PLAN_FILE="$HR_PLANS/$B_HR.md"
HR_NOTE_SED='/append to .*plan-change-note/{s/^.*append to (.*plan-change-note\.md) one bullet.*$/\1/p;q;}'
cat > "$TMP/effects/hr-fix.sh" <<'EFFEOF'
printf '#!/bin/bash\n# widgetmark\n' > bin/test-widget
printf '#!/bin/bash\n' > bin/widget-tool
EFFEOF
{ cat "$TMP/effects/hr-fix.sh"; printf 'printf "x\\n" > bin/check-docs\n'; } > "$TMP/effects/hr-gate.sh"
{ cat "$TMP/effects/hr-fix.sh"; printf 'printf "Fix widget\\tbug,human-approved\\tno\\n" > "%s"\n' "$TMP/gh.snap.after"; } > "$TMP/effects/hr-label.sh"
{ cat "$TMP/effects/hr-fix.sh"; printf 'printf "Other title\\tbug\\tno\\n" > "%s"\n' "$TMP/gh.snap.after"; } > "$TMP/effects/hr-title.sh"
{ cat "$TMP/effects/hr-fix.sh"; printf 'git add -A\ngit commit -qm sneaky\n'; } > "$TMP/effects/hr-commit.sh"
{ cat "$TMP/effects/hr-fix.sh"
  printf 'NOTE=$(sed -nE %s "%s")\n' "'$HR_NOTE_SED'" "$TMP/claude.prompt"
  printf 'printf -- "- dropped something else\\n" > "$NOTE"\n'
  printf 'grep -v widgetmark "%s" > "%s.tmp"; mv "%s.tmp" "%s"\n' "$HR_PLAN_FILE" "$HR_PLAN_FILE" "$HR_PLAN_FILE" "$HR_PLAN_FILE"
} > "$TMP/effects/hr-planrow.sh"
{ cat "$TMP/effects/hr-fix.sh"
  printf 'NOTE=$(sed -nE %s "%s")\n' "'$HR_NOTE_SED'" "$TMP/claude.prompt"
  printf 'printf -- "- widgetmark and bin/test-widget: reworded after review, the row was stale\\n" > "$NOTE"\n'
  printf 'printf "\\n<!-- touched -->\\n" >> "%s"\n' "$HR_PLAN_FILE"
} > "$TMP/effects/hr-planedit.sh"
{ cat "$TMP/effects/hr-fix.sh"; printf 'printf "\\n<!-- x -->\\n" >> "%s"\n' "$HR_PLAN_FILE"; } > "$TMP/effects/hr-gateplan.sh"
printf 'SUMMARY: done\nHOLDREPEAT_FIX: fixed\n' > "$TMP/reply-hr-fixed"
printf 'SUMMARY: nothing\n**HOLDREPEAT_FIX: nothing-to-fix**\n' > "$TMP/reply-hr-nothing"
printf 'SUMMARY: gate\nHOLDREPEAT_FIX: needs-gate-edit bin/check-docs\n' > "$TMP/reply-hr-gate"
printf 'SUMMARY: ended without a marker\n' > "$TMP/reply-hr-nomarker"

dm_count() { if [ -f "$TMP/dm.log" ]; then grep -c '@@DM@@' "$TMP/dm.log"; else echo 0; fi; }
ppn_count() { if [ -f "$TMP/ppn.calls" ]; then grep -c '' "$TMP/ppn.calls"; else echo 0; fi; }
gh_has() { grep -qF -- "$1" "$TMP/gh.calls" 2>/dev/null; }
dm_has() { grep -qF -- "$1" "$TMP/dm.log" 2>/dev/null; }
ppn_has() { grep -qF -- "$1" "$TMP/ppn.calls" 2>/dev/null; }
HR_LEDGER="$HR_STATE/$B_HR.holdrepeat-fix.json"
ledger_has() { grep -qF -- "$1" "$HR_LEDGER" 2>/dev/null; }
no_ledger() { [ ! -e "$HR_LEDGER" ]; }
no_ppn() { [ ! -e "$TMP/ppn.calls" ]; }
wt_clean() { [ -z "$(git -C "$WTH" status --porcelain)" ]; }
head_is_tip() { [ "$(git -C "$WTH" rev-parse HEAD)" = "$HR_TIP" ]; }
origin_hr() { git --git-dir="$TMP/origin.git" rev-parse "refs/heads/$B_HR"; }
origin_is_tip() { [ "$(origin_hr)" = "$HR_TIP" ]; }
plan_is_orig() { cmp -s "$TMP/plan.orig" "$HR_PLAN_FILE"; }
final_is() { [ "$(printf '%s\n' "$1" | tail -n 1)" = "postplan-fix: holdrepeat result=$2" ]; }
line_re() { grep -Eq -- "$2" <<< "$1"; }
hr_run() { run_fix "$SUT" --holdrepeat 77; }

# 25 (eligible dry-run: no claude call, no ledger write, the four seams are named)
if should_run "holdrepeat-eligible-dry-run"; then
hr_reset
run_fix "$SUT" --holdrepeat --dry-run 77
need "rc 0 (stderr: $ERR)" test "$RC" = 0
need "final line" final_is "$STDOUT" dry-run
need "fingerprint" has_s "$STDOUT" "dry-run fingerprint="
need "state-dir line" has_s "$STDOUT" "state-dir=$HR_STATE"
need "dm-bin line" has_s "$STDOUT" "dm-bin=$TMP/dm-stub"
need "usage-source line" has_s "$STDOUT" "usage-source=$TMP/usage-ok.json"
need "post-plan-now-bin line" has_s "$STDOUT" "post-plan-now-bin=$TMP/ppn-stub"
need "no claude call" no_args
need "no ledger file" no_ledger
case_end holdrepeat-eligible-dry-run
fi

# 26
