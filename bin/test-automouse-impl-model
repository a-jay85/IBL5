#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-automouse-impl-model — regression test for bin/lib/plan-impl-model.
#
# The helper selects the automouse impl-agent model from a plan's FIRST YAML
# frontmatter block only (anchored to line 1). This pins:
#   - sonnet / explicit-opus frontmatter selects the right model
#   - the FOOTGUN (load-bearing negative): a plan with NO frontmatter that
#     merely documents an impl_model example in its body must NOT self-select
#     (→ Opus default). PR2's own plan documents the syntax this way.
#   - frontmatter present but without impl_model → Opus default
#   - leading/trailing whitespace tolerance
# Without the footgun cases, a body-greedy parser could silently downgrade a
# plan that only documents the syntax.
#
# Run: bin/test-automouse-impl-model  (exit 0 = all pass, 1 = a case failed)

set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
HELPER="$SCRIPT_DIR/lib/plan-impl-model"
TIER_HELPER="$SCRIPT_DIR/lib/plan-model-tier"
TMP="$(mktemp -d)"
trap 'rm -f "$TMP"/*.md 2>/dev/null; rmdir "$TMP" 2>/dev/null' EXIT

FAILED=0

# assert <name> <expected-model> <plan-body>
assert() {
    name="$1"; want="$2"; body="$3"
    f="$TMP/$name.md"
    printf '%s\n' "$body" > "$f"
    got=$("$HELPER" "$f")
    if [ "$got" != "$want" ]; then
        echo "FAIL: $name — expected '$want', got '$got'"
        FAILED=1
    else
        echo "ok: $name ($got)"
    fi
}

# assert_reject <name> <body> <expected-stderr-substring>
assert_reject() {
    name="$1"; body="$2"; want_sub="$3"
    f="$TMP/$name.md"
    printf '%s\n' "$body" > "$f"
    out=$("$HELPER" "$f" 2>/dev/null); rc=$?
    err=$("$HELPER" "$f" 2>&1 >/dev/null)
    if [ "$rc" -eq 0 ]; then echo "FAIL: $name — expected nonzero exit, got 0"; FAILED=1; return; fi
    if [ -n "$out" ]; then echo "FAIL: $name — stdout must be empty on rejection, got: $out"; FAILED=1; fi
    case "$err" in *"$want_sub"*) ;; *) echo "FAIL: $name — stderr missing '$want_sub', got: $err"; FAILED=1 ;; esac
    if [ "$rc" -ne 0 ] && [ -z "$out" ]; then
        case "$err" in *"$want_sub"*) echo "ok: $name (rejected, stderr contains '$want_sub')" ;; esac
    fi
}

# assert_tier <raw-value> <expected-tier>
assert_tier() {
    val="$1"; want_tier="$2"
    got=$("$TIER_HELPER" "$val" 2>/dev/null); rc=$?
    if [ $rc -ne 0 ]; then echo "FAIL: tier($val) — expected exit 0, got $rc"; FAILED=1; return; fi
    if [ "$got" != "$want_tier" ]; then
        echo "FAIL: tier($val) — expected '$want_tier', got '$got'"
        FAILED=1
    else
        echo "ok: tier($val) ($got)"
    fi
}

# c1 — line-1 frontmatter selects sonnet
assert "c1-sonnet" "claude-sonnet-4-6" '---
impl_model: sonnet
---
# Plan
body'

# c2 (FOOTGUN, negative) — no frontmatter; an impl_model example in the BODY is ignored
assert "c2-footgun-body-example" "claude-opus-5" '# Plan
Documenting the syntax:
```
---
impl_model: haiku
---
```
more body'

# c3 (negative) — real frontmatter without impl_model; trailing body example ignored
assert "c3-no-field" "claude-opus-5" '---
description: x
---
# Plan
---
impl_model: haiku
---'

# c4 (negative) — explicit opus falls through to the default
assert "c4-explicit-opus" "claude-opus-5" '---
impl_model: opus
---
# Plan'

# c5 — leading/trailing whitespace around the value is tolerated
assert "c5-whitespace" "claude-sonnet-4-6" '---
impl_model:   sonnet
---
# Plan'

# c6 — full opus id accepted and resolves to claude-opus-5
assert "c6-full-opus" "claude-opus-5" '---
impl_model: claude-opus-5
---'

# c7 — full sonnet id accepted and resolves to claude-sonnet-4-6
assert "c7-full-sonnet" "claude-sonnet-4-6" '---
impl_model: claude-sonnet-4-6
---'

# c8 — full haiku id accepted and resolves to claude-haiku-4-5
assert "c8-full-haiku" "claude-haiku-4-5" '---
impl_model: claude-haiku-4-5
---'

# r1 — dotted form (claude-sonnet-4.6) is rejected
assert_reject "r1-dotted" '---
impl_model: claude-sonnet-4.6
---' "is not a recognized model"

# r2 — capitalized alias is rejected
assert_reject "r2-capitalized" '---
impl_model: Sonnet
---' "is not a recognized model"

# r3 — foreign model id is rejected
assert_reject "r3-foreign" '---
impl_model: gpt-4
---' "is not a recognized model"

# r4 — fable alias is rejected with the agent-tiering reference
assert_reject "r4-fable-alias" '---
impl_model: fable
---' ".claude/rules/agent-tiering.md"

# r5 — fable full id is rejected with the agent-tiering reference
assert_reject "r5-fable-full" '---
impl_model: claude-fable-5
---' ".claude/rules/agent-tiering.md"

# tier tests — directly pin the classifier contract independent of the resolver
assert_tier ""               "absent"
assert_tier "opus"           "opus-tier"
assert_tier "claude-opus-5"  "opus-tier"
assert_tier "sonnet"         "sonnet-tier"
assert_tier "claude-sonnet-4-6" "sonnet-tier"
assert_tier "haiku"          "haiku-tier"
assert_tier "claude-haiku-4-5"  "haiku-tier"

# tier no-arg — plan-model-tier with no argument must exit 2 (usage error)
"$TIER_HELPER" 2>/dev/null; tier_no_arg_rc=$?
if [ $tier_no_arg_rc -ne 2 ]; then
    echo "FAIL: tier(no-arg) — expected exit 2, got $tier_no_arg_rc"
    FAILED=1
else
    echo "ok: tier(no-arg) (exit $tier_no_arg_rc)"
fi

if [ "$FAILED" -ne 0 ]; then
    echo "RESULT: FAILED"
    exit 1
fi
echo "RESULT: all passed"
exit 0
