# (b) older than the threshold but a live post-plan process names the worktree or the slug.
for ps_line in \
    "5555 /bin/bash -lc cd $WT && caffeinate -s tools/postplan-harness/run isolated $WT x --live" \
    "5555 tail -f /logs/post-plan-now-branch-one-20261018-004740-25853.log" \
