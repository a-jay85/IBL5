first_del="$(grep -n 'del(.required_status_checks.contexts' "$TMP/pr2144.md" | head -1 | cut -d: -f1)"
got_s3="$(grep -o 'line [0-9]*: shape 3' <<< "$ERR" | cut -d' ' -f2 | tr -d ':' | tr '\n' ' ')"
n_expected_s1="$(grep -c 'ajaynicolas/IBL5' "$TMP/pr2144.md")"
why=""
if [[ "$RC" != 1 ]]; then
    why="exit $RC, want 1"
elif [[ "$n_expected_s1" != 4 ]]; then
    why="fixture has $n_expected_s1 ajaynicolas/IBL5 lines, want 4"
elif [[ "$got_s1" != "$expected_s1" ]]; then
    why="shape 1 pointers '$got_s1' != fixture lines '$expected_s1'"
elif ! grep -q 'shape 2' <<< "$ERR"; then
    why="no shape 2 finding"
elif [[ "$got_s3" != "$first_del " ]]; then
    why="shape 3 pointers '$got_s3' != single del( line '$first_del'"
fi
if [[ -z "$why" ]]; then
    echo "PASS replay-2144"
    PASSED=$((PASSED + 1))
else
    echo "FAIL replay-2144: $why"
    FAILED=$((FAILED + 1))
fi

echo "$PASSED passed, $FAILED failed"
[[ "$FAILED" -eq 0 ]]
