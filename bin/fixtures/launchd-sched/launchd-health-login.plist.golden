<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ibl5.launchd-health-login</string>
	<key>ProgramArguments</key>
	<array>
		<string>@MAIN_WT@/bin/launchd-health-check</string>
		<string>--startup-delay</string>
		<string>180</string>
	</array>
	<key>WorkingDirectory</key>
	<string>@MAIN_WT@</string>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- launchd agents start with a minimal PATH that omits Homebrew; git and the
		     checker must resolve. HOME interpolates HERE, at generation time —
		     launchd does NOT expand variables in EnvironmentVariables, so a literal
		     dollar-sign-HOME would bake in a dead path. -->
		<key>PATH</key>
		<string>/opt/homebrew/bin:/opt/homebrew/opt/mariadb/bin:/usr/local/bin:/usr/bin:/bin:@HOME@/.local/bin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>@HOME@/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/launchd-health/logs/launchd-health-login.out.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/launchd-health/logs/launchd-health-login.err.log</string>
</dict>
</plist>
