#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/sim-recap-tick — the poll-only sim-recap pipeline driver (ADR-0092).
#
# Fired every 300s by the launchd LaunchAgent (bin/sim-recap-cron-setup). On an
# EMPTY tick it exits 0 having spawned ZERO `claude` processes — the cost guard
# that makes a 300s poll cheap enough to run unattended forever.
#
# "Empty" means the queue call SUCCEEDED and reported no sim. A queue call that
# FAILS returns empty stdout too — byte-identical to an idle queue — so every
# call goes through q(), which logs a distinct ERROR and returns non-zero, and
# main() aborts the tick rather than reporting a cheap exit. Without that, a
# broken pipeline is indistinguishable from a quiet one in the launchd log.
#
# Phase gate (RecapPhasePolicy): sim recaps are enabled only during HEAT and
# Regular Season. When claim-next reports recaps_enabled=false and there is no
# pending sim (nothing to drain), the tick logs and exits cheap. It never
# unloads itself: the job stays loaded through disabled phases and resumes on
# the first tick after the phase becomes HEAT or Regular Season. No manual
# re-arm is needed.
#
# Trust split (ADR-0092): the Mac holds ONE credential — a SELECT-only MySQL
# user reached over an SSH tunnel — handed only to the generation agent for game
# data. Every privileged queue action is a prod-side `ssh php simRecapQueue.php`
# call the agent cannot make (claiming a row is an UPDATE the read-only user is
# refused). All *_id fields are read as STRINGS with `jq -r` (snowflake rule).
# This script OWNS bringing that tunnel up (ensure_tunnel, called on every
# generation path) — the poller runs unattended, so nothing else can.
#
# NOT set -e: one sim's failure must never abort the tick before its park branch
# runs. Routes, backoff, and stale-lease timers are computed SERVER-side by
# parkByCause / reclaimStaleClaim. The only local time math is reading a usage-limit
# reset time (claude_reset_epoch) and the Actions step budget for a retry pass.

set -u

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
Usage: bin/sim-recap-tick [--dry-run] [--sim=<id>]

Poll-only sim-recap pipeline driver (ADR-0092). Fired every 300s by the
launchd LaunchAgent (bin/sim-recap-cron-setup).

Options:
  --dry-run      Regenerate a recap for tuning without touching the queue,
                 or writing to the DB. Requires --sim=<id>.
  --sim=<id>     Specify the sim ID to process (used with --dry-run, or to
                 force-process a particular sim on a live tick).

Key environment overrides (all have production defaults):
  SIM_RECAP_CLAUDE_BIN   Path to the claude binary.
  SIM_RECAP_SSH_HOST     SSH host for queue access.
  SIM_RECAP_MODEL        Model to use for generation.

Exit codes: 0 success (a hand-off, wait, or backoff is still 0), 1 tick
failure, an unknown SIM_RECAP_HOST_MODE, or a terminal sim in actions mode,
2 unknown argument.
EOF
    exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# ── Env seams (default to production values; the test harness overrides) ───────
SIM_RECAP_SSH_BIN="${SIM_RECAP_SSH_BIN:-ssh}"
SIM_RECAP_JQ_BIN="${SIM_RECAP_JQ_BIN:-jq}"
SIM_RECAP_CLAUDE_BIN="${SIM_RECAP_CLAUDE_BIN:-claude}"
SIM_RECAP_PROMPT_BIN="${SIM_RECAP_PROMPT_BIN:-$REPO_ROOT/bin/sim-recap-prompt}"
SIM_RECAP_SSH_HOST="${SIM_RECAP_SSH_HOST:-}"
SIM_RECAP_REMOTE_ROOT="${SIM_RECAP_REMOTE_ROOT:-}"
SIM_RECAP_MODEL="${SIM_RECAP_MODEL:-claude-opus-5-5}"
SIM_RECAP_CLAUDE_TIMEOUT="${SIM_RECAP_CLAUDE_TIMEOUT:-1800}"
SIM_RECAP_DB_HOST="${SIM_RECAP_DB_HOST:-127.0.0.1}"
SIM_RECAP_DB_PORT="${SIM_RECAP_DB_PORT:-13306}"
SIM_RECAP_DB_USER="${SIM_RECAP_DB_USER:-}"
SIM_RECAP_DB_NAME="${SIM_RECAP_DB_NAME:-}"
# Pinned, not bare `mysql`: the launchd PATH resolves to Homebrew's 9.x client,
# which dropped mysql_native_password and cannot authenticate at all (ERROR 2059).
# Same default as sim-recap-prompt, which documents the full why; the tick keeps
# its own copy so preflight_mysql can check the binary the agent will actually be
# told to run, and exports it so both sides can never disagree.
SIM_RECAP_MYSQL_BIN="${SIM_RECAP_MYSQL_BIN:-/opt/homebrew/opt/mysql@8.4/bin/mysql}"
SIM_RECAP_CURL_BIN="${SIM_RECAP_CURL_BIN:-curl}"
SIM_RECAP_BOT_BASE_URL="${SIM_RECAP_BOT_BASE_URL:-http://127.0.0.1:50001}"
SIM_RECAP_OPS_ALERT_THREAD_ID="${SIM_RECAP_OPS_ALERT_THREAD_ID:-}"
# Discord webhook URL (secret; embeds its token). Non-empty = post ops alerts
# straight to Discord (Actions host), into SIM_RECAP_OPS_ALERT_THREAD_ID when set
# and the webhook's own channel when not. Empty = Mac bot at SIM_RECAP_BOT_BASE_URL.
# Travels to curl via `-K -` on stdin, never argv, never a log line.
SIM_RECAP_OPS_WEBHOOK_URL="${SIM_RECAP_OPS_WEBHOOK_URL:-}"
# Where the ops-alert edge state lives. Deliberately NOT under WORKDIR (mktemp -d,
# rm -rf'd on EXIT) — suppressing a repeat across ticks needs a path that outlives
# the run. Sits in the sim-recap dir sim-recap-cron-setup already creates (for its
# logs/ subdir); ops_state_write mkdir -p's it anyway so neither depends on order.
# HOME is defaulted, not bare: both HOME references in this file use the defensive
# ${HOME:-/tmp} pattern (SIM_RECAP_OPS_ALERT_STATE below and SIM_RECAP_DB_SYNC_LOG
# further down). We run under `set -u`, and the plist's EnvironmentVariables does
# not set it — so a bare $HOME would abort the tick at expansion time, on EVERY
# poll, if launchd ever handed us an environment without it.
SIM_RECAP_OPS_ALERT_STATE="${SIM_RECAP_OPS_ALERT_STATE:-${HOME:-/tmp}/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/sim-recap/ops-alert.json}"
SIM_RECAP_DB_SYNC_BIN="${SIM_RECAP_DB_SYNC_BIN:-$REPO_ROOT/ibl5/bin/db-sync-now}"
SIM_RECAP_DB_SYNC_LOG="${SIM_RECAP_DB_SYNC_LOG:-${HOME:-/tmp}/.claude/projects/-Users-ajaynicolas-GitHub-IBL5/sim-recap/logs/db-sync.log}"
# launchd (Mac poller, default) | actions (GitHub Actions runner). Host-specific
# steps key on this, never on hostname: db-sync, ops transport (Phase 2).
SIM_RECAP_HOST_MODE="${SIM_RECAP_HOST_MODE:-launchd}"
# HOST_ID is the queue's name for this host (the --host= flag). Unset and empty
# both took the launchd default above and mean the Mac. Anything else is refused
# here, before any ssh call: a typo must never claim a sim under the wrong host.
case "$SIM_RECAP_HOST_MODE" in
    launchd) HOST_ID=mac ;;
    actions) HOST_ID=actions ;;
    *)
        printf '[%s] %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" \
            "ERROR: SIM_RECAP_HOST_MODE must be launchd or actions — aborting tick (no sim claimed)" >&2
        exit 1
        ;;
esac
DRY_RUN=0
# SIM_RECAP_DB_PASSWORD is read from the environment ONLY (never defaulted, never
# argv, never logged). require_password() enforces its presence on the live path.

# The prompt builder reads the DB coordinates from its environment (never the
# password — that reaches the agent through MYSQL_PWD at spawn time).
export SIM_RECAP_DB_HOST SIM_RECAP_DB_PORT SIM_RECAP_DB_USER SIM_RECAP_DB_NAME
export SIM_RECAP_MYSQL_BIN

# ── Per-run temp working dir (security constraint 7 / ADR-0062) ───────────────
# Global so the EXIT trap can see it; assigned in generate()/dry_run().
WORKDIR=""

# Set by dry_run() before it fetches anything. Global rather than main()'s local
# DRY_RUN because roster_health_transition() — five frames down — has to know.
DRY_RUN_MODE=0

# Set by park() for every outcome except 'none' (a lost claim).
TICK_PARKED=0
# Set by park() when prod says no route is left ('failed') or answers with an
# outcome this tick does not know. main() turns it into exit 1 in actions mode,
# so a red run means a human is needed and nothing else does.
TICK_TERMINAL=0
# Set by park() on 'retry_now'; main() re-enters the claim loop on this host.
# Reset at the top of every pass.
PARK_RETRY=0
# Passes per tick: one more than ParkPolicy's two retry_now slots, so a prod-side
# bug can never spin the tick. main()'s `for pass in 1 2 3` must match it.
readonly MAX_PASSES=3
# The actions `Run tick` step's timeout-minutes (35) in seconds. Another pass is
# started only when a full claude run still fits inside it.
readonly ACTIONS_STEP_BUDGET=2100
TICK_START=0
cleanup_workdir() {
    [ -n "${SIM_RECAP_KEEP_WORKDIR:-}" ] && return 0
    [ -n "$WORKDIR" ] && rm -rf "$WORKDIR"
    return 0
}
trap cleanup_workdir EXIT

# ── Logging (prints messages, never the environment) ──────────────────────────
# Diagnostics go to stderr, never stdout: in --dry-run stdout carries the
# generated payload.json alone (a clean, pipeable document — row 60/61), so no
# log line may interleave with it. launchd captures both streams in live mode.
log() { printf '[%s] %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*" >&2; }

# ── Ops alert on roster-context health — EDGE-triggered, exactly two pings ────
# One ping on healthy→degraded, one on degraded→healthy, and silence in between.
# A sustained simRecapContext.php outage otherwise pings once per claimed sim for
# as long as it lasts, which trades an upstream fault for a notification bleed
# (bin/bug-pipeline-tick makes the same argument for its CI-autofix ceiling).
#
# Why no periodic "still degraded" reminder: the RECOVERY ping is what makes the
# silence readable. Once you know a recovery ping is coming, "no ping since the
# onset" unambiguously means the outage is still open, so a reminder buys nothing
# and reintroduces exactly the annoyance this closes. It also keeps the whole
# mechanism CLOCKLESS — no cooldown means no time seam, and all four
# (observation × state) cases below are deterministic to test.
#
# State is the presence of $SIM_RECAP_OPS_ALERT_STATE: absent means healthy. So a
# wiped ~/.claude, or a fresh machine, re-alerts on the next failure — which is
# the correct behaviour, not a bug to design around.
#
# Both edges are observed only where a sim is CLAIMED, so an empty queue neither
# alerts nor recovers: if the outage ends while nothing is pending, the RECOVERED
# ping waits for the first sim after it. That is the right trade — the alert is
# about recaps shipping roster-blind, and no recap is shipping.
ops_post() { # message — fault-tolerant by contract; never fails the tick
    if [ -n "$SIM_RECAP_OPS_WEBHOOK_URL" ]; then
        local url="$SIM_RECAP_OPS_WEBHOOK_URL" sep='?'
        # No thread ID = post to the webhook's own channel, so the parameter is
        # left off rather than sent empty.
        if [ -n "$SIM_RECAP_OPS_ALERT_THREAD_ID" ]; then
            case "$url" in *\?*) sep='&' ;; esac
            url="${url}${sep}thread_id=${SIM_RECAP_OPS_ALERT_THREAD_ID}"
        fi
        printf 'url = "%s"\n' "$url" | "$SIM_RECAP_CURL_BIN" -s -K - -X POST \
            -H 'Content-Type: application/json' \
            -d "$("$SIM_RECAP_JQ_BIN" -nc --arg m "$1" '{content:$m}')" \
            2>/dev/null >/dev/null || true
        return 0
    fi
    "$SIM_RECAP_CURL_BIN" -s -X POST "$SIM_RECAP_BOT_BASE_URL/post-to-thread" \
        -H 'Content-Type: application/json' \
        -d "$("$SIM_RECAP_JQ_BIN" -nc --arg t "$SIM_RECAP_OPS_ALERT_THREAD_ID" --arg m "$1" \
             '{thread_id:$t,message:$m}')" 2>/dev/null >/dev/null || true
}

# Write via temp + mv so a failed write can never leave a TRUNCATED state file:
# an empty file reads as "healthy", which would silently restore the flood. The
# write is still non-fatal, but it logs — a flood must leave a breadcrumb rather
# than being indistinguishable from "no suppression was ever added."
ops_state_write() { # degraded_since  degraded_count
    # $$ keeps the temp per-process. A FIXED .tmp name would be shared by
    # overlapping ticks (the claude timeout is 1800s, the poll interval 300s):
    # both truncate the same inode, their writes interleave, and both mv — moving
    # garbled JSON into place, which jq then fails to read, which reads as
    # "healthy", which restores the very flood temp+mv exists to prevent. And
    # each writer would think it succeeded, so nothing would log.
    local tmp="$SIM_RECAP_OPS_ALERT_STATE.tmp.$$"
    if mkdir -p "$(dirname "$SIM_RECAP_OPS_ALERT_STATE")" 2>/dev/null \
       && "$SIM_RECAP_JQ_BIN" -nc --arg s "$1" --argjson c "$2" \
              '{degraded_since:$s,degraded_count:$c}' > "$tmp" 2>/dev/null \
       && mv -f "$tmp" "$SIM_RECAP_OPS_ALERT_STATE" 2>/dev/null; then
        return 0
    fi
    rm -f "$tmp" 2>/dev/null
    log "WARNING: could not write ops-alert state to $SIM_RECAP_OPS_ALERT_STATE — repeat-alert suppression is OFF until this is fixed"
    return 0
}

roster_health_transition() { # sim  ok|degraded
    # Armed by either setting. The webhook alone posts to its own channel; the
    # Mac bot path has no default channel, so it still needs a thread ID.
    [ -z "${SIM_RECAP_OPS_ALERT_THREAD_ID:-}" ] && [ -z "$SIM_RECAP_OPS_WEBHOOK_URL" ] && return 0
    # --dry-run must never touch the shared edge state. A human regenerating a
    # recap while the endpoint is down would consume the onset edge and silence
    # the real alert; a dry-run while it is up would clear state and fire a false
    # "recovered". The plan's "both call sites alert, it is a no-op anyway"
    # premise held for a STATELESS alert and stops holding once it carries state.
    [ "$DRY_RUN_MODE" -eq 1 ] && return 0

    local sim="$1" health="$2" since count
    since="$("$SIM_RECAP_JQ_BIN" -r '.degraded_since // empty' "$SIM_RECAP_OPS_ALERT_STATE" 2>/dev/null)"
    count="$("$SIM_RECAP_JQ_BIN" -r '.degraded_count // 0' "$SIM_RECAP_OPS_ALERT_STATE" 2>/dev/null)"
    # Non-numeric, not just empty: a state file that is valid JSON with a STRING
    # degraded_count makes $((count + 1)) below expand as a variable name, which
    # is unbound under `set -u` and kills the whole tick. A corrupt state file may
    # cost a suppression; it must never cost the recap.
    case "$count" in ''|*[!0-9]*) count=0 ;; esac

    if [ "$health" = "degraded" ]; then
        if [ -n "$since" ]; then
            # Already alerted — stay silent, just keep the running tally so the
            # recovery ping can say how much damage the outage did.
            ops_state_write "$since" "$((count + 1))"
            return 0
        fi
        # Record BEFORE posting: if the POST fails we would rather lose one ping
        # than re-alert on every subsequent sim, which is the bug being fixed.
        since="$(date '+%Y-%m-%dT%H:%M:%S')"
        ops_state_write "$since" 1
        ops_post "WARNING: sim $sim recap proceeding roster-blind — simRecapContext.php fetch failed. Further roster-blind sims will NOT re-alert; expect a single RECOVERED message when it comes back."
    else
        [ -z "$since" ] && return 0   # healthy, and it was healthy — say nothing
        rm -f "$SIM_RECAP_OPS_ALERT_STATE" 2>/dev/null
        ops_post "RECOVERED: simRecapContext.php is answering again (sim $sim). $count sim recap(s) ran roster-blind since $since."
    fi
    return 0
}

# ── Loud signal on Actions: a run annotation, never in launchd mode ──────────
# Every interpolated value is a sim integer, a cause/outcome enum, or a
# blocked_until timestamp. Never pass a webhook, token, password, or raw JSON.
# Written to stderr: the workflow sends stdout to /dev/null, and the runner
# reads workflow commands from both streams.
gha_annotate() { # level message
    [ "$SIM_RECAP_HOST_MODE" = actions ] || return 0
    printf '::%s title=sim-recap::%s\n' "$1" "$2" >&2
    return 0
}

# ── Usage/rate-limit detector (regex adapted from bin/bug-pipeline-tick:76-79) ──
# 401/403 are NOT here: a rejected token is an auth error, not a quota error.
claude_env_error() {
    printf '%s' "$1" | grep -qiE \
        "hit your [a-z0-9 -]*limit|usage limit reached|api error:[[:space:]]*(429|529)|overloaded_error|rate_limit_error"
}

# ── Usage-limit reset time → epoch (prints an epoch or nothing; never fails) ──
# Form A: "usage limit reached|<10-digit epoch>".
# Form B: "resets <h>[:<mm>] am|pm" with an optional "(<Area/City>)" zone; the
#   zone is used only when it looks like Area/City, else the host's local zone.
#   Today's epoch at that clock time; when it is not in the future, +86400.
# No match prints nothing, and the queue applies its 60-minute default. Prod
# clamps whatever arrives to (now, now+6h], so a misparse costs an early retry.
claude_reset_epoch() { # agent_output
    local text="$1" m h mm ap zone hhmmss epoch now
    m="$(printf '%s' "$text" | grep -oiE 'usage limit reached\|[0-9]{10}' | sed -n '1p')"
    if [ -n "$m" ]; then
        printf '%s\n' "${m##*|}"
        return 0
    fi
    local re='resets[[:space:]]+([0-9]{1,2})(:([0-9]{2}))?[[:space:]]*([AaPp][Mm])([[:space:]]*\(([^)]*)\))?'
    [[ $text =~ $re ]] || return 0
    h="${BASH_REMATCH[1]}"; mm="${BASH_REMATCH[3]:-00}"; ap="${BASH_REMATCH[4]}"; zone="${BASH_REMATCH[6]:-}"
    h=$((10#$h))
    if [ "$h" -lt 1 ] || [ "$h" -gt 12 ] || [ "$((10#$mm))" -gt 59 ]; then
        return 0
    fi
    case "$ap" in
        [Aa][Mm]) [ "$h" -eq 12 ] && h=0 ;;
        *)        [ "$h" -ne 12 ] && h=$((h + 12)) ;;
    esac
    hhmmss="$(printf '%02d:%s:00' "$h" "$mm")"
    printf '%s' "$zone" | grep -qE '^[A-Za-z_]+/[A-Za-z_]+$' || zone=""
    # Same platform test as _date_ago in bin/automouse/run: BSD first, then GNU.
    # TZ is set only when a zone was named; an empty TZ means UTC, not local.
    if [ -n "$zone" ]; then
        epoch="$(TZ="$zone" date -j -f '%H:%M:%S' "$hhmmss" +%s 2>/dev/null \
            || TZ="$zone" date -d "$hhmmss" +%s 2>/dev/null)"
    else
        epoch="$(date -j -f '%H:%M:%S' "$hhmmss" +%s 2>/dev/null \
            || date -d "$hhmmss" +%s 2>/dev/null)"
    fi
    case "$epoch" in ''|*[!0-9]*) return 0 ;; esac
    now="$(date +%s)"
    [ "$epoch" -le "$now" ] && epoch=$((epoch + 86400))
    printf '%s\n' "$epoch"
    return 0
}

# ── Auth-failure detector: a bad or expired CLAUDE_CODE_OAUTH_TOKEN ───────────
# Real output: "Failed to authenticate. API Error: 401 OAuth access token is invalid."
claude_auth_error() {
    printf '%s' "$1" | grep -qiE \
        "api error:[[:space:]]*(401|403)|failed to authenticate|oauth access token is invalid|invalid api key"
}

# ── One seam for every prod-side queue call ───────────────────────────────────
# q <verb> [flags...] -> one JSON object on stdout; exit status of the call.
#
# A dead ssh, an undeployed simRecapQueue.php, or a PHP fatal all yield EMPTY
# stdout plus a non-zero exit. Empty stdout alone is ambiguous (an idle queue
# looks the same), so the exit status is the ONLY signal that separates them —
# name the verb here so one grep of the launchd log identifies the broken call.
q() {
    local verb="$1" rc
    "$SIM_RECAP_SSH_BIN" "$SIM_RECAP_SSH_HOST" \
        "php $SIM_RECAP_REMOTE_ROOT/ibl5/scripts/simRecapQueue.php $*"
    rc=$?
    if [ "$rc" -ne 0 ]; then
        log "ERROR: queue call '$verb' failed (exit $rc) — remote simRecapQueue.php did not complete"
    fi
    return "$rc"
}

# ── One seam for the prod-side context precompute ────────────────────────────
# qctx <sim> -> JSON object on stdout; exit status of the call.
# A dead ssh, an undeployed simRecapContext.php, or a PHP fatal yields EMPTY
# stdout plus non-zero exit. Fault-tolerant: caller falls back to '{}' on failure.
qctx() {
    local sim="$1" rc
    "$SIM_RECAP_SSH_BIN" "$SIM_RECAP_SSH_HOST" \
        "php $SIM_RECAP_REMOTE_ROOT/ibl5/scripts/simRecapContext.php --sim=$sim"
    rc=$?
    if [ "$rc" -ne 0 ]; then
        log "WARNING: roster-context fetch (sim $sim) failed (exit $rc) — proceeding without roster context"
    fi
    return "$rc"
}

# jq_ok <json> <filter> -> true when the filter succeeds (fail-closed on garbage).
jq_ok() { printf '%s' "$1" | "$SIM_RECAP_JQ_BIN" -e "$2" >/dev/null 2>&1; }

# Refuse to run the live path without the one credential, BEFORE any ssh/agent.
require_password() {
    if [ -z "${SIM_RECAP_DB_PASSWORD:-}" ]; then
        log "ERROR: SIM_RECAP_DB_PASSWORD is unset — refusing to run (it belongs in the launchd plist EnvironmentVariables)"
        exit 1
    fi
}

# ── Park a failed sim with its cause; prod's ParkPolicy picks the route ───────
# The tick only names the cause (flaky|usage_limit|auth|transport|prompt). The
# flag order is fixed: the forced-command ssh gate matches it exactly.
# 'none' is a DISTINCT outcome (lost claim — another run owns the sim now), not
# an error and not a retry. Never collapse it into a failure path.
park() { # sim cause [reset_epoch]
    local sim="$1" cause="$2" reset="${3:-}" resp rc outcome route blocked notified
    if [ -n "$reset" ]; then
        resp="$(q park --sim="$sim" --host="$HOST_ID" --cause="$cause" --reset="$reset")"
    else
        resp="$(q park --sim="$sim" --host="$HOST_ID" --cause="$cause")"
    fi
    rc=$?
    if [ "$rc" -ne 0 ]; then
        # Prod is unreachable from this host. The row stays 'generating';
        # reclaim-stale frees it after 45 minutes and the other host's backup
        # claim takes it, so this is a workaround in progress, not terminal.
        TICK_PARKED=1
        park_unreachable "$sim" "$cause"
        return 0
    fi
    outcome="$(printf '%s' "$resp" | "$SIM_RECAP_JQ_BIN" -r '.outcome // empty' 2>/dev/null)"
    route="$(printf '%s' "$resp" | "$SIM_RECAP_JQ_BIN" -r '.route // empty' 2>/dev/null)"
    blocked="$(printf '%s' "$resp" | "$SIM_RECAP_JQ_BIN" -r '.blocked_until // empty' 2>/dev/null \
        | tr -cd '0-9:T -')"
    notified="$(printf '%s' "$resp" | "$SIM_RECAP_JQ_BIN" -r '.notified // empty' 2>/dev/null)"
    case "$route" in mac|actions|any) ;; *) route="the other host" ;; esac
    case "$outcome" in
        retry_now)
            TICK_PARKED=1; PARK_RETRY=1
            log "sim $sim: retrying now on this host (cause $cause)" ;;
        waiting)
            TICK_PARKED=1
            log "sim $sim: usage limit — waiting until $blocked; no hand-off (same Claude account on both hosts)"
            gha_annotate warning "sim $sim: Claude usage limit; waiting until $blocked (cause $cause)" ;;
        handed)
            TICK_PARKED=1
            log "sim $sim: handed to $route (cause $cause)"
            gha_annotate warning "sim $sim: handed to $route (cause $cause)" ;;
        backoff)
            TICK_PARKED=1
            log "sim $sim: backing off until $blocked (cause $cause)"
            gha_annotate warning "sim $sim: backing off until $blocked (cause $cause)" ;;
        failed)
            TICK_PARKED=1; TICK_TERMINAL=1
            log "sim $sim: TERMINAL — no route left (cause $cause)"
            gha_annotate error "sim $sim has no route left (cause $cause); #admin-chat told" ;;
        none)
            log "sim $sim: park returned 'none' — lost the claim; another run owns it now, stopping"
            return 0 ;;
        *)
            # An old prod answering 'pending' lands here and fails loud. The raw
            # value goes to the log only, never into an annotation.
            TICK_PARKED=1; TICK_TERMINAL=1
            log "sim $sim: park returned an unexpected outcome '$outcome'"
            gha_annotate error "sim $sim: park returned an unexpected outcome (cause $cause); see the run log" ;;
    esac
    case "$notified" in
        ''|unchanged|skipped) : ;;
        failed)
            log "WARNING: sim $sim: admin-chat post from the league server failed ($outcome) — falling back to the ops thread"
            gha_annotate warning "sim $sim: admin-chat post failed (cause $cause)"
            ops_post "Sim $sim recap: $(park_outcome_words "$outcome") (cause $cause). The #admin-chat post from the league server failed." ;;
        *)  log "admin-chat: told the commissioner ($outcome)" ;;
    esac
    return 0
}

# Plain-text words for a park outcome (ops fallback message only).
park_outcome_words() { # outcome
    case "$1" in
        retry_now) printf 'retrying now on the same host' ;;
        waiting)   printf 'waiting for the Claude usage limit to reset' ;;
        handed)    printf 'handed to the other host' ;;
        backoff)   printf 'backing off before the next retry' ;;
        failed)    printf 'no route left, recaps are not available' ;;
        none)      printf 'lost the claim to another run' ;;
        *)         printf 'unexpected park result' ;;
    esac
}

# ── Prod unreachable on park: tell the ops thread once per sim ────────────────
# De-dup lines (park-unreachable-<sim>) live next to the ops-alert edge state, in
# a sibling file rather than inside it: ops_state_write rewrites that JSON via
# temp+mv and recovery rm's it, either of which would erase the lines and
# re-post. The sibling sits in the same directory, which the Actions cache steps
# already persist, and needs no new env var.
park_unreachable() { # sim cause
    local sim="$1" cause="$2" who state="$SIM_RECAP_OPS_ALERT_STATE.park-unreachable"
    log "WARNING: sim $sim: park did not reach the league server (cause $cause) — the row stays claimed; reclaim-stale frees it and the other host takes over"
    gha_annotate warning "sim $sim: could not reach the league server to park (cause $cause); the other host will take over"
    if grep -qxF "park-unreachable-$sim" "$state" 2>/dev/null; then
        return 0
    fi
    mkdir -p "$(dirname "$state")" 2>/dev/null
    printf 'park-unreachable-%s\n' "$sim" >> "$state" 2>/dev/null \
        || log "WARNING: could not write $state — the unreachable notice may repeat"
    if [ "$HOST_ID" = actions ]; then who="GitHub"; else who="the Mac"; fi
    ops_post "Sim $sim recap: $who couldn't reach the league server. The other host will take over."
    return 0
}

# ── Success post: prod tells #admin-chat the recaps are up ────────────────────
# Prod builds the message from the row; this host sends only enums. A failed
# call or post is a WARNING, never a failed tick.
admin_status_done() { # sim
    local sim="$1" resp rc notified
    resp="$(q notify --sim="$sim" --host="$HOST_ID" --event=done)"
    rc=$?
    notified="$(printf '%s' "$resp" | "$SIM_RECAP_JQ_BIN" -r '.notified // empty' 2>/dev/null)"
    if [ "$rc" -ne 0 ] || [ "$notified" = failed ]; then
        log "WARNING: sim $sim: admin-chat success post failed"
        gha_annotate warning "sim $sim: admin-chat success post failed"
    elif [ -n "$notified" ] && [ "$notified" != unchanged ] && [ "$notified" != skipped ]; then
        log "admin-chat: told the commissioner (done)"
    fi
    return 0
}

# ── Fetch the two DB-derived inputs the agent gets, into the workdir ──────────
# Returns non-zero if either fetch is unusable, so the caller can park.
fetch_agent_inputs() { # sim  (writes mentions.json + themes-ledger.json into WORKDIR)
    local sim="$1" mm rt
    mm="$(q mention-map)"
    if ! jq_ok "$mm" '.ok == true'; then
        log "sim $sim: mention-map fetch failed"
        return 1
    fi
    printf '%s' "$mm" | "$SIM_RECAP_JQ_BIN" '.teams' > "$WORKDIR/mentions.json" 2>/dev/null

    rt="$(q recent-themes)"
    if ! jq_ok "$rt" '.ok == true'; then
        log "sim $sim: recent-themes fetch failed"
        return 1
    fi
    # .themes is a flat JSON array of strings — string-safe by construction.
    printf '%s' "$rt" | "$SIM_RECAP_JQ_BIN" '.themes' > "$WORKDIR/themes-ledger.json" 2>/dev/null

    # Fetch precomputed roster context (fault-tolerant — failure does NOT park).
    local ctx ctx_rc
    ctx="$(qctx "$sim")"; ctx_rc=$?
    if [ "$ctx_rc" -eq 0 ] && jq_ok "$ctx" '.sim != null'; then
        printf '%s' "$ctx" > "$WORKDIR/roster-context.json"
        roster_health_transition "$sim" ok
    else
        log "sim $sim: roster-context unavailable — writing empty context"
        roster_health_transition "$sim" degraded
        printf '{}' > "$WORKDIR/roster-context.json"
    fi
    return 0
}

# ── Ensure the SELECT-only MySQL tunnel is up before the agent runs ───────────
# Nothing else opens it: the poller runs unattended, so a reboot (or the
# ControlMaster exiting) would otherwise leave every tick generating against a
# dead port. `-O forward` attaches the forward to the master the queue calls
# already keep alive (ControlMaster auto / ControlPersist 10m in ~/.ssh/config)
# and is idempotent — rc 0, no duplicate listener, when the forward exists.
# Fails CLOSED: a bare "port 13306 is open" probe would green-light a LOCAL
# MySQL bound to the same port and recap the wrong database, so a port we could
# not establish ourselves is treated as no tunnel at all.
ensure_tunnel() {
    local fwd="${SIM_RECAP_DB_PORT}:127.0.0.1:3306"
    "$SIM_RECAP_SSH_BIN" -O forward -L "$fwd" "$SIM_RECAP_SSH_HOST" >/dev/null 2>&1 && return 0
    log "no ssh ControlMaster to attach the DB tunnel to — opening one"
    # ExitOnForwardFailure=yes is load-bearing: without it a bind conflict leaves
    # a stray background ssh with rc 0 — one leaked process per tick, forever.
    "$SIM_RECAP_SSH_BIN" -f -N -o ExitOnForwardFailure=yes -L "$fwd" "$SIM_RECAP_SSH_HOST" \
        >/dev/null 2>&1 && return 0
    log "ERROR: could not bring up the DB tunnel on port $SIM_RECAP_DB_PORT — parking rather than querying a dead port"
    return 1
}

# ── Run the generation agent in the temp dir; leaves payload.json on success ──
run_agent() { # sim prompt
    local sim="$1" prompt="$2"
    # --allowedTools narrows what runs WITHOUT a prompt; it is NOT a sandbox, and
    # this comment used to claim otherwise. ~/.claude/settings.json allows bare
    # `Bash` with defaultMode auto, so the flag is additive: the agent can and does
    # run python3, rm, sed. Do not "fix" that by tightening Bash to mysql-only —
    # the generation run legitimately needs scratch-file tooling.
    #
    # What actually enforces security constraint 2 is the CREDENTIAL split, and it
    # holds independently of any tool flag: the only secret this subshell hands the
    # agent is MYSQL_PWD for a SELECT-only user (never in the prompt, never in
    # argv, never logged). Every privileged queue action is a prod-side
    # simRecapQueue.php call the tick makes on its own, with inputs the agent never
    # supplies. Residual gap, accepted: the agent inherits the Mac's ssh identity
    # and could in principle reach prod that way — the trust boundary here is the
    # code we hand it, not the tool list.
    ( cd "$WORKDIR" && MYSQL_PWD="${SIM_RECAP_DB_PASSWORD:-}" \
        timeout "$SIM_RECAP_CLAUDE_TIMEOUT" "$SIM_RECAP_CLAUDE_BIN" -p "$prompt" \
            --model "$SIM_RECAP_MODEL" --output-format json \
            --allowedTools "Bash(mysql:*)" "Write" ) > "$WORKDIR/agent.json" 2>&1
    return $?
}

# ── log_agent_cost <sim> — one log line with what the agent run cost ──────────
# The workdir (and agent.json with it) is deleted later, so this is the only
# record of the spend. agent.json also captures stderr (2>&1), so it may not be
# pure JSON: take the last line that parses as a type=="result" object. Purely
# informational — always returns 0 so it can never alter the tick's exit path.
log_agent_cost() { # sim
    local sim="$1" row cost turns dur_ms in_tok cr_tok cw_tok out_tok
    row="$("$SIM_RECAP_JQ_BIN" -rR '
        fromjson? | select(type == "object" and .type == "result")
        | [(.total_cost_usd // 0), (.num_turns // 0), (.duration_ms // 0),
           (.usage.input_tokens // 0), (.usage.cache_read_input_tokens // 0),
           (.usage.cache_creation_input_tokens // 0), (.usage.output_tokens // 0)]
        | @tsv' "$WORKDIR/agent.json" 2>/dev/null | tail -n 1)"
    if [ -z "$row" ]; then
        log "sim $sim: agent cost unavailable"
        return 0
    fi
    IFS=$'\t' read -r cost turns dur_ms in_tok cr_tok cw_tok out_tok <<< "$row"
    local line
    line="$(printf 'sim %s: agent cost $%.2f, turns %s, duration %ss, input %s (cache read %s, cache write %s), output %s tokens, model %s' \
        "$sim" "$cost" "$turns" "$((${dur_ms%.*} / 1000))" "$in_tok" "$cr_tok" "$cw_tok" "$out_tok" "$SIM_RECAP_MODEL")" \
        || { log "sim $sim: agent cost unavailable"; return 0; }
    log "$line"
    return 0
}

# ── generate <sim> — inject, prompt, run agent, store or park ─────────────────
generate() { # sim
    local sim="$1"
    WORKDIR="$(mktemp -d "${TMPDIR:-/tmp}/sim-recap-XXXXXX")"
    log "workdir $WORKDIR for sim $sim"

    if ! fetch_agent_inputs "$sim"; then
        park "$sim" transport; return 0
    fi

    local prompt
    if ! prompt="$("$SIM_RECAP_PROMPT_BIN" --sim="$sim" \
            --mentions="$WORKDIR/mentions.json" --themes="$WORKDIR/themes-ledger.json" \
            --roster="$WORKDIR/roster-context.json")"; then
        log "sim $sim: prompt build failed (missing exemplar?) — parking"
        park "$sim" prompt; return 0
    fi

    # Before spawning claude — a dead tunnel means every mysql call it makes
    # fails, burning a full agent run to produce nothing.
    if ! ensure_tunnel; then
        log "sim $sim: no DB tunnel — parking without spawning the agent"
        park "$sim" transport; return 0
    fi

    local agent_rc
    run_agent "$sim" "$prompt"; agent_rc=$?
    log_agent_cost "$sim"

    if claude_auth_error "$(cat "$WORKDIR/agent.json" 2>/dev/null)"; then
        log "sim $sim: agent auth failed (401/403) — CLAUDE_CODE_OAUTH_TOKEN is invalid or expired; parking"
        park "$sim" auth; return 0
    fi

    if claude_env_error "$(cat "$WORKDIR/agent.json" 2>/dev/null)"; then
        log "sim $sim: agent hit a usage limit — parking with a backoff"
        park "$sim" usage_limit "$(claude_reset_epoch "$(cat "$WORKDIR/agent.json" 2>/dev/null)")"; return 0
    fi

    if [ ! -f "$WORKDIR/payload.json" ] || \
       ! "$SIM_RECAP_JQ_BIN" -e '(.games | type == "array") and (.games | length > 0)' \
            "$WORKDIR/payload.json" >/dev/null 2>&1; then
        # A claude timeout (rc 124) lands here too and counts as flaky.
        log "sim $sim: agent produced no valid payload.json (rc=$agent_rc) — parking"
        park "$sim" flaky; return 0
    fi

    # Store: pipe the payload on stdin (never argv — multi-KB, ps-visible).
    # Do NOT add 2>&1 here. ssh writes non-JSON banners to stderr — OpenSSH 10.2
    # emits a post-quantum-KEX warning whenever a store opens a fresh connection
    # instead of riding the ControlMaster — and merging that into $store makes
    # jq_ok choke on a perfectly good response. That is not hypothetical: sim 722
    # (2026-07-26) stored all 56 recaps, then logged "store failed (rc=0)" and
    # tried to park an already-done row. Leave stderr on the tick's own stderr,
    # where launchd captures it uninterleaved. (run_agent's 2>&1 is different and
    # correct — claude_env_error greps that merged blob for rate-limit text.)
    local store store_rc
    store="$("$SIM_RECAP_SSH_BIN" "$SIM_RECAP_SSH_HOST" \
        "php $SIM_RECAP_REMOTE_ROOT/ibl5/scripts/storeSimRecap.php --sim=$sim" \
        < "$WORKDIR/payload.json")"
    store_rc=$?
    if [ "$store_rc" -eq 0 ] && jq_ok "$store" '.ok == true'; then
        log "sim $sim: stored ($(printf '%s' "$store" | "$SIM_RECAP_JQ_BIN" -r '.games' 2>/dev/null) game recaps)"
        # A stored sim means prod has data this local DB does not. Fire a refresh
        # detached: ibl5/bin/db-sync-now takes minutes and this tick must return well
        # inside launchd's 300s StartInterval. It self-guards (lock + 30-min
        # throttle + container check), so firing per stored sim is safe and a
        # sim-less tick never reaches this line.
        if [ "$DRY_RUN" -eq 0 ] && [ "$SIM_RECAP_HOST_MODE" = launchd ] && [ -x "$SIM_RECAP_DB_SYNC_BIN" ]; then
            log "sim $sim: triggering local DB sync (detached)"
            mkdir -p "$(dirname "$SIM_RECAP_DB_SYNC_LOG")" 2>/dev/null || true
            nohup "$SIM_RECAP_DB_SYNC_BIN" >> "$SIM_RECAP_DB_SYNC_LOG" 2>&1 &
            disown 2>/dev/null || true
        elif [ "$SIM_RECAP_HOST_MODE" = actions ]; then
            log "sim $sim: db-sync skipped (host mode: actions)"
        fi
        # After the db-sync trigger, so the success post never delays it.
        admin_status_done "$sim"
        local avg_len
        avg_len="$("$SIM_RECAP_JQ_BIN" -r \
            '[.games[].recap_text | length] | if length == 0 then 0 else (add / length | floor) end' \
            "$WORKDIR/payload.json" 2>/dev/null)"
        case "$avg_len" in
            ''|*[!0-9]*) : ;;  # unreadable payload: the store already succeeded, stay quiet
            *)
                if [ "$avg_len" -lt 504 ]; then
                    log "sim $sim: WARNING — average game recap is ${avg_len} chars, below the exemplar band of 504-639. Stored anyway; prose is running short."
                fi
                ;;
        esac
        return 0
    fi
    # ssh's own connection failure (255) or no answer at all is transport;
    # prod answering with anything but ok:true is a bad result (flaky).
    local store_cause=flaky
    if [ "$store_rc" -eq 255 ] || [ -z "$store" ]; then
        store_cause=transport
    fi
    log "sim $sim: store failed (rc=$store_rc, cause=$store_cause): $store — parking"
    park "$sim" "$store_cause"
    return 0
}

# ── --dry-run --sim=N — regenerate for tuning; touches NO queue row, NO DB write.
# Fetches read-only inputs, runs the agent, prints the complete payload.json to
# stdout (themes included, under .themes). Never claims, parks, stores, or posts.
dry_run() {
    # Set before ANY fetch: roster_health_transition() reads this to keep a
    # human's tuning run from consuming the ops-alert edge (see that function).
    DRY_RUN_MODE=1
    local sim="$DRY_SIM"
    if [ -z "$sim" ] || ! printf '%s' "$sim" | grep -qE '^[0-9]+$'; then
        log "ERROR: --dry-run requires an explicit --sim=N (it never chooses a sim implicitly)"
        exit 1
    fi
    WORKDIR="$(mktemp -d "${TMPDIR:-/tmp}/sim-recap-XXXXXX")"
    log "workdir $WORKDIR for dry-run sim $sim"

    # Read-only fetches only; a failure here is not worth parking a row we don't own.
    fetch_agent_inputs "$sim" || true
    [ -f "$WORKDIR/mentions.json" ] || printf '{}' > "$WORKDIR/mentions.json"
    [ -f "$WORKDIR/themes-ledger.json" ] || printf '[]' > "$WORKDIR/themes-ledger.json"
    [ -f "$WORKDIR/roster-context.json" ] || printf '{}' > "$WORKDIR/roster-context.json"

    local prompt
    if ! prompt="$("$SIM_RECAP_PROMPT_BIN" --sim="$sim" \
            --mentions="$WORKDIR/mentions.json" --themes="$WORKDIR/themes-ledger.json" \
            --roster="$WORKDIR/roster-context.json")"; then
        log "dry-run sim $sim: prompt build failed (missing exemplar?)"
        exit 1
    fi

    if ! ensure_tunnel; then
        log "dry-run sim $sim: no DB tunnel — not spawning the agent"
        exit 1
    fi

    run_agent "$sim" "$prompt"

    if [ ! -f "$WORKDIR/payload.json" ]; then
        log "dry-run sim $sim: agent produced no payload.json"
        exit 1
    fi
    # stdout carries the complete generated document, pretty-printed: a human
    # reads it against the exemplar (row 60) and 3b's contract test pipes it
    # through SimRecapPayload::fromJson() (row 61). Themes live inside .themes of
    # this same payload, so there is nothing to echo separately — one channel,
    # one document. All diagnostics have gone to stderr via log().
    "$SIM_RECAP_JQ_BIN" '.' "$WORKDIR/payload.json"
    return 0
}

# ── main — flag parse, then the claim loop with the empty-tick invariant ──────
main() {
    TICK_START="$(date +%s)"
    DRY_RUN=0
    DRY_SIM=""
    local arg
    for arg in "$@"; do
        case "$arg" in
            --dry-run) DRY_RUN=1 ;;
            --sim=*)   DRY_SIM="${arg#--sim=}" ;;
            *) log "unknown argument: $arg"; exit 2 ;;
        esac
    done
    # SIM_RECAP_HOST_MODE was validated at load time, where HOST_ID is set.

    # Preflight: the agent binary must actually resolve, BEFORE anything claims a
    # sim. An unresolvable $SIM_RECAP_CLAUDE_BIN makes `timeout` exit 127, which
    # generate() cannot tell apart from "the agent ran and produced nothing" — so
    # it parks and burns an attempt, every poll, until parkByCause's budget marks
    # the sim permanently `failed`. That is exactly what happened when the Claude
    # Code native installer moved `claude` to ~/.local/bin, off the launchd PATH
    # (sim 721, 2026-07-25). Abort loudly instead: a broken environment must cost
    # zero attempts.
    if ! command -v "$SIM_RECAP_CLAUDE_BIN" >/dev/null 2>&1; then
        log "ERROR: agent binary '$SIM_RECAP_CLAUDE_BIN' not found on PATH ($PATH) — aborting tick (no sim claimed)"
        return 1
    fi

    # Same preflight, for the mysql client. The prompt hands the agent this exact
    # path and tells it not to go hunting for another one — which is right (the
    # one on PATH cannot authenticate) but removes the recovery it improvised for
    # sim 722. If the pin ever goes stale (mysql@8.4 unlinked, EOL'd, upgraded out
    # from under us), every query the agent makes fails, it produces no payload,
    # and the sim parks — one wasted attempt per poll, same shape as sim 721's
    # rc=127. Cost zero attempts instead.
    if ! command -v "$SIM_RECAP_MYSQL_BIN" >/dev/null 2>&1; then
        log "ERROR: mysql client '$SIM_RECAP_MYSQL_BIN' not found — aborting tick (no sim claimed)"
        return 1
    fi

    if [ "$DRY_RUN" -eq 1 ]; then
        dry_run
        return $?
    fi

    # Live path: refuse without the credential BEFORE any ssh or agent call.
    require_password

    # Reclaim first, unconditionally — a crashed run's sim is recoverable on the
    # very next tick. Rides the multiplexed ssh connection, so ~tens of ms.
    local rec sim_rec rc
    rec="$(q reclaim-stale)"
    rc=$?
    # Fail-closed on the FIRST queue call: if the remote side is unreachable or
    # undeployed, nothing downstream can work, and continuing would land in the
    # cheap-exit path and log an idle queue that was never actually consulted.
    if [ "$rc" -ne 0 ]; then
        log "ERROR: reclaim-stale did not complete — aborting tick (no claude spawned)"
        return 1
    fi
    if jq_ok "$rec" '.ok == true'; then
        sim_rec="$(printf '%s' "$rec" | "$SIM_RECAP_JQ_BIN" -r '.sim // empty' 2>/dev/null)"
        [ -n "$sim_rec" ] && [ "$sim_rec" != "null" ] && \
            log "reclaimed stale sim $sim_rec back to pending"
    fi

    # ── Claim → generate, re-entered on this host only after a 'retry_now' park.
    # `for pass in 1 2 3` is MAX_PASSES spelled out: a fixed loop, never `while`,
    # so a prod that answers retry_now forever still ends the tick.
    local claim normalized sim="" claim_verb pass now
    for pass in 1 2 3; do
        PARK_RETRY=0
        # A retry pass makes a fresh WORKDIR; the EXIT trap only sees the last.
        cleanup_workdir
        WORKDIR=""
        claim_verb="claim-next --host=$HOST_ID"
        if [ -n "$DRY_SIM" ]; then
            claim_verb="claim --sim=$DRY_SIM --host=$HOST_ID"
            claim="$(q claim --sim="$DRY_SIM" --host="$HOST_ID")"
        else
            claim="$(q claim-next --host="$HOST_ID")"
        fi
        rc=$?
        # This check MUST precede the empty-tick guard below: a failed call returns
        # empty stdout, so the guard would swallow it and report an idle queue. That
        # is not hypothetical — the poller logged 342 consecutive "exiting cheap"
        # ticks while simRecapQueue.php was simply absent from the remote root.
        if [ "$rc" -ne 0 ]; then
            log "ERROR: $claim_verb did not complete — aborting tick (no claude spawned)"
            return 1
        fi
        normalized="$(printf '%s' "$claim" | tr -d '[:space:]')"

        # ★ EMPTY-TICK COST GUARD — no work, spawn zero `claude`, exit cheap.
        if [ -z "$normalized" ]; then
            log "no pending sim — exiting cheap"
            return 0
        fi

        # Fail-closed: a truncated ssh, an HTML error page, or a stub returning
        # garbage must NOT be parsed into a bogus sim number and spawn the agent.
        if ! jq_ok "$claim" 'type == "object" and .ok == true'; then
            log "ERROR: $claim_verb did not return a valid queue object — aborting tick (no claude spawned)"
            return 1
        fi

        # `claim --sim=N` echoes N back even when the row was not claimed (already
        # done, or another host holds it). Generating anyway would overwrite a stored
        # recap and re-post it, so only an explicit claimed:true proceeds.
        if [ -n "$DRY_SIM" ] && ! jq_ok "$claim" '.claimed == true'; then
            log "ERROR: sim $DRY_SIM was not claimable (not pending) — aborting tick (no claude spawned)"
            return 1
        fi

        sim="$(printf '%s' "$claim" | "$SIM_RECAP_JQ_BIN" -r '.sim // empty' 2>/dev/null)"
        if [ -z "$sim" ] || [ "$sim" = "null" ]; then
            # Phase gate: if recaps are disabled and there is nothing left to drain,
            # log and exit cheap. The poller stays armed and resumes by itself on the
            # first tick after the phase enables recaps. Fail-safe: a missing or
            # unparseable recaps_enabled field is treated as true (falls through to
            # the plain idle exit). Skipped when --sim=N was supplied (a human drove
            # this tick by hand); --dry-run never reaches here, it returns from
            # dry_run() above.
            if [ -z "$DRY_SIM" ] && jq_ok "$claim" '.recaps_enabled == false'; then
                local phase_log
                phase_log="$(printf '%s' "$claim" | \
                    "$SIM_RECAP_JQ_BIN" -r '.phase // "unknown"' 2>/dev/null)"
                log "recaps disabled (phase: ${phase_log}) and no pending sim — poller stays armed; it resumes on its own when the phase enables recaps"
                return 0
            fi
            log "no pending sim — exiting cheap"
            return 0
        fi

        log "claimed sim $sim (pass $pass of $MAX_PASSES)"
        generate "$sim"

        [ "$PARK_RETRY" -eq 1 ] || break
        if [ "$pass" -ge "$MAX_PASSES" ]; then
            log "sim $sim: retry cap of $MAX_PASSES passes reached — a later tick takes it"
            continue
        fi
        # Actions only: another pass must fit a full claude run inside the step's
        # timeout. When it cannot, ask the workflow to re-dispatch; the cron is the
        # backstop if that dispatch fails. launchd never overlaps one job's
        # instances, so it has no budget.
        if [ "$SIM_RECAP_HOST_MODE" = actions ]; then
            local timeout_s="$SIM_RECAP_CLAUDE_TIMEOUT"
            case "$timeout_s" in ''|*[!0-9]*) timeout_s=1800 ;; esac
            now="$(date +%s)"
            if [ $((now - TICK_START + timeout_s + 120)) -gt "$ACTIONS_STEP_BUDGET" ]; then
                if [ -n "${GITHUB_OUTPUT:-}" ]; then
                    printf 'redispatch=true\n' >> "$GITHUB_OUTPUT"
                fi
                log "sim $sim: no time left in this run — asking the workflow to re-dispatch"
                break
            fi
        fi
    done

    # Only a terminal sim turns an Actions run red: a hand-off, wait, or backoff
    # is a workaround in progress (warning annotation + #admin-chat post).
    if [ "$SIM_RECAP_HOST_MODE" = actions ] && [ "$TICK_TERMINAL" -eq 1 ]; then
        log "sim $sim: terminal — exiting 1 so the Actions run shows red (host mode: actions)"
        return 1
    fi
    if [ "$TICK_PARKED" -eq 1 ]; then
        log "sim $sim: parked, not terminal — exiting 0; the workaround is in progress"
    fi
    return 0
}

main "$@"
