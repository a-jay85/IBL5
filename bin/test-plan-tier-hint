#!/usr/bin/env bash
# shellcheck shell=bash
#
# test-plan-tier-hint — behavioural harness for the judge-backed architect-tier
# hint, plus the static drift assertions that keep the prose surfaces saying
# the tier is an Opus judgment.
#
# Every behavioural case drives a stub judge through PLAN_TIER_HINT_CLAUDE (or
# a fake `claude` on PATH). The harness never calls a real model: CI is exported
# so a case that forgets the seam hits the hint's CI guard instead.
#
# Run: bin/test-plan-tier-hint  (exit 0 = all pass, 1 = a case failed)

set -u

# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
# PLAN_TIER_HINT overrides the script under test (mutation check runs master's copy).
HINT="${PLAN_TIER_HINT:-$SCRIPT_DIR/plan-tier-hint}"
# Any case that forgets the stub seam hits the CI guard instead of a paid model
# call. Cases that need CI unset use `env -u CI` and a fake claude on PATH.
export CI=1
h_tmp BASE_TMP

OUT="$BASE_TMP/out"
ERR="$BASE_TMP/err"
TAB="$(printf '\t')"
# Every hint run in this harness logs here, never to the real
# ~/.claude/logs file. J10 and J11 call "$HINT" without run_hint, so this
# must be an export.
export PLAN_TIER_HINT_LOG="$BASE_TMP/verdict.log"

expect_eq() { h_eq "$1" "$2" "$3"; } # name want got

expect_exit() { # name want-code got-code
    if [ "$3" -eq "$2" ]; then
        h_pass "$1 (exit $3)"
    else
        h_fail "$1" "expected exit $2, got $3"
        sed 's/^/      | /' "$ERR" 2>/dev/null | head -10
    fi
}

expect_match() { # name pattern file
    if grep -qE "$2" "$3"; then
        h_pass "$1"
    else
        h_fail "$1" "output did not match /$2/"
        sed 's/^/      | /' "$3" 2>/dev/null | head -10
    fi
}

assert_contains() { # name file literal
    if grep -qF "$3" "$ROOT/$2"; then
        h_pass "$1"
    else
        h_fail "$1" "$2 no longer contains the expected text"
    fi
}

assert_absent() { # name file literal
    if grep -qF "$3" "$ROOT/$2"; then
        h_fail "$1" "$2 still contains the retired text"
    else
        h_pass "$1"
    fi
}

expect_absent_file() { # name path
    if [ -e "$2" ]; then
        h_fail "$1" "$2 exists (the judge was invoked)"
    else
        h_pass "$1"
    fi
}

expect_present_file() { # name path
    if [ -e "$2" ]; then
        h_pass "$1"
    else
        h_fail "$1" "$2 is missing (the judge was never invoked)"
    fi
}

# env_json <result-text> [jq-update] — a judge envelope, JSON-escaped by jq.
env_json() {
    jq -cn --arg r "$1" '{type:"result",is_error:false,result:$r}' | jq -c "${2:-.}"
}

# mk_judge <name> <exit-code> <stdout-text> — writes $BASE_TMP/judge-<name>.
mk_judge() {
    local f="$BASE_TMP/judge-$1"
    {
        printf '#!/usr/bin/env bash\n'
        printf 'printf "%%s\\n" %q\n' "$3"
        printf 'exit %s\n' "$2"
    } >"$f"
    chmod +x "$f"
}

# mk_recorder — a judge that records it ran, its argv, and its cwd, then
# answers a valid default envelope.
mk_recorder() {
    local f="$BASE_TMP/judge-rec"
    {
        printf '#!/usr/bin/env bash\n'
        printf ': >%q\n' "$BASE_TMP/called"
        printf 'printf "%%s\\n" "$@" >%q\n' "$BASE_TMP/argv"
        printf 'pwd >%q\n' "$BASE_TMP/cwd"
        printf 'printf "%%s\\n" %q\n' "$(env_json "$(printf 'default\nrecorded')")"
    } >"$f"
    chmod +x "$f"
}

reset_recorder() { rm -f "$BASE_TMP/called" "$BASE_TMP/argv" "$BASE_TMP/cwd"; }

# run_hint <judge-path> [hint args...] — sets RC; output in $OUT, stderr in $ERR.
run_hint() {
    local j="$1"; shift
    PLAN_TIER_HINT_CLAUDE="$j" "$HINT" "$@" </dev/null >"$OUT" 2>"$ERR"
    RC=$?
}

# arg_after <flag> — the argv line after <flag> in the recorder log, bracketed
# so an empty value reads as [] and a missing one as nothing.
arg_after() {
    awk -v k="$1" 'f == 1 { printf "[%s]", $0; f = 2 } f == 0 && $0 == k { f = 1 }' "$BASE_TMP/argv"
}

mk_recorder

echo "== J1 verdict passthrough =="
for v in xhigh default sonnet; do
    mk_judge "pass-$v" 0 "$(env_json "$(printf '%s\nreason for %s' "$v" "$v")")"
    run_hint "$BASE_TMP/judge-pass-$v" --desc 'some task'
    expect_eq "J1 $v passes through" "$v" "$(cat "$OUT")"
    expect_exit "J1 $v exits 0" 0 "$RC"
done

echo
echo "== J2 --explain format =="
mk_judge explain 0 "$(env_json "$(printf 'default\nadditive gate, check 3')")"
run_hint "$BASE_TMP/judge-explain" --explain --desc 'some task'
expect_eq "J2 explain prints verdict TAB reason" "default${TAB}additive gate, check 3" "$(cat "$OUT")"
expect_eq "J2 explain is one line" "1" "$(awk 'END { print NR }' "$OUT")"
mk_judge explain-tab 0 "$(env_json "$(printf 'default\nleft\tright')")"
run_hint "$BASE_TMP/judge-explain-tab" --explain --desc 'some task'
expect_eq "J2 TAB in reason becomes a space" "default${TAB}left right" "$(cat "$OUT")"
expect_eq "J2 explain line holds exactly one TAB" "2" "$(awk -F'\t' '{ print NF }' "$OUT")"

echo
echo "== J3 no input and usage errors never call the judge =="
rm -f "$PLAN_TIER_HINT_LOG"
reset_recorder
run_hint "$BASE_TMP/judge-rec"
expect_exit "J3 no input exits 2" 2 "$RC"
expect_absent_file "J3 no input: judge not called" "$BASE_TMP/called"
reset_recorder
run_hint "$BASE_TMP/judge-rec" --bogus
expect_exit "J3 --bogus exits 2" 2 "$RC"
expect_absent_file "J3 --bogus: judge not called" "$BASE_TMP/called"
reset_recorder
run_hint "$BASE_TMP/judge-rec" --files
expect_exit "J3 bare --files exits 2" 2 "$RC"
expect_absent_file "J3 bare --files: judge not called" "$BASE_TMP/called"
reset_recorder
run_hint "$BASE_TMP/judge-rec" --help
expect_exit "J3 --help exits 0" 0 "$RC"
expect_absent_file "J3 --help: judge not called" "$BASE_TMP/called"
# Usage errors and --help exit before emit(), so they never log.
expect_absent_file "J3 usage errors and --help write no log line" "$PLAN_TIER_HINT_LOG"

echo
echo "== J4 timeout =="
printf '#!/usr/bin/env bash\nexec sleep 30\n' >"$BASE_TMP/judge-slow"
chmod +x "$BASE_TMP/judge-slow"
T0=$SECONDS
PLAN_TIER_HINT_TIMEOUT=1 run_hint "$BASE_TMP/judge-slow" --explain --desc 'some task'
ELAPSED=$((SECONDS - T0))
expect_exit "J4 timeout exits 0" 0 "$RC"
expect_match "J4 timeout gives default naming the timeout" \
    "^default${TAB}judge-failsafe: judge timed out after 1s" "$OUT"
if [ "$ELAPSED" -lt 10 ]; then
    h_pass "J4 timeout returns in under 10s (${ELAPSED}s)"
else
    h_fail "J4 timeout returns in under 10s" "took ${ELAPSED}s"
fi

echo
echo "== J5 timeout env fallback =="
{
    printf '#!/usr/bin/env bash\nsleep 2\n'
    printf 'printf "%%s\\n" %q\n' "$(env_json "$(printf 'default\nslow but fine')")"
} >"$BASE_TMP/judge-2s"
chmod +x "$BASE_TMP/judge-2s"
for t in 0 abc ''; do
    PLAN_TIER_HINT_TIMEOUT="$t" run_hint "$BASE_TMP/judge-2s" --desc 'some task'
    expect_eq "J5 PLAN_TIER_HINT_TIMEOUT=[$t] falls back to 180s" "default" "$(cat "$OUT")"
done

echo
echo "== J6 strict parse rejects near misses =="
J6_I=0
for txt in \
    "$(printf '**default**\nreason')" \
    "$(printf 'Default\nreason')" \
    "$(printf 'default sonnet\nreason')" \
    "$(printf 'default.\nreason')" \
    "$(printf 'The verdict is default\nreason')" \
    "default" \
    "$(printf 'default\nreason\na third line')" \
    "$(printf '\ndefault\nreason')"; do
    J6_I=$((J6_I + 1))
    mk_judge "near-$J6_I" 0 "$(env_json "$txt")"
    run_hint "$BASE_TMP/judge-near-$J6_I" --explain --desc 'some task'
    expect_match "J6.$J6_I near miss [$(printf '%s' "$txt" | tr '\n' '|')] gives default unparseable" \
        "^default${TAB}judge-failsafe: judge output unparseable" "$OUT"
done

echo
echo "== J7 strict parse tolerates whitespace =="
# $(...) strips trailing newlines, so jq appends the two blank lines itself.
mk_judge trail 0 "$(env_json "$(printf 'default\nreason')" '.result += "\n\n\n"')"
run_hint "$BASE_TMP/judge-trail" --desc 'some task'
expect_eq "J7 trailing blank lines still give default" "default" "$(cat "$OUT")"
mk_judge cr 0 "$(env_json "$(printf '  default  \r\nreason')")"
run_hint "$BASE_TMP/judge-cr" --desc 'some task'
expect_eq "J7 CR-terminated padded default gives default" "default" "$(cat "$OUT")"

echo
echo "== J8 envelope failures =="
GOOD="$(printf 'default\nreason')"
mk_judge env-nonjson 0 "this is not json"
mk_judge env-iserror 0 "$(env_json "$GOOD" '.is_error = true')"
# stop_reason:max_tokens marks a cut-off reply, unusable even when .result parses.
mk_judge env-maxtok 0 "$(env_json "$GOOD" '.stop_reason = "max_tokens"')"
mk_judge env-noresult 0 "$(env_json "$GOOD" 'del(.result)')"
for k in nonjson iserror maxtok noresult; do
    run_hint "$BASE_TMP/judge-env-$k" --explain --desc 'some task'
    expect_match "J8 $k envelope gives default unusable" \
        "^default${TAB}judge-failsafe: judge envelope unusable" "$OUT"
done

echo
echo "== J9 non-zero judge exit =="
mk_judge exit3 3 "$(env_json "$GOOD")"
run_hint "$BASE_TMP/judge-exit3" --explain --desc 'some task'
expect_exit "J9 hint still exits 0" 0 "$RC"
expect_match "J9 exit 3 gives default naming the exit" \
    "^default${TAB}judge-failsafe: judge exited 3" "$OUT"

echo
echo "== J10 CI guard =="
mkdir -p "$BASE_TMP/fakebin"
{
    printf '#!/usr/bin/env bash\n'
    printf ': >%q\n' "$BASE_TMP/fake-called"
    printf 'printf "%%s\\n" %q\n' "$(env_json "$GOOD")"
} >"$BASE_TMP/fakebin/claude"
chmod +x "$BASE_TMP/fakebin/claude"
FAKEPATH="$BASE_TMP/fakebin:$PATH"

rm -f "$BASE_TMP/fake-called"
env -u PLAN_TIER_HINT_CLAUDE CI=1 PATH="$FAKEPATH" \
    "$HINT" --explain --desc 'some task' </dev/null >"$OUT" 2>"$ERR"
expect_match "J10a CI=1, seam unset: default naming the CI guard" "^default${TAB}judge-failsafe: CI guard" "$OUT"
expect_absent_file "J10a fake claude never ran" "$BASE_TMP/fake-called"

# The hint reads the seam with :-, so an empty value counts as unset. A read
# like ${PLAN_TIER_HINT_CLAUDE+set} would treat it as set and skip the guard.
rm -f "$BASE_TMP/fake-called"
env CI=1 PLAN_TIER_HINT_CLAUDE= PATH="$FAKEPATH" \
    "$HINT" --explain --desc 'some task' </dev/null >"$OUT" 2>"$ERR"
expect_match "J10b CI=1, empty seam counts as unset" "^default${TAB}judge-failsafe: CI guard" "$OUT"
expect_absent_file "J10b fake claude never ran" "$BASE_TMP/fake-called"

rm -f "$BASE_TMP/fake-called"
env -u CI -u PLAN_TIER_HINT_CLAUDE PATH="$FAKEPATH" \
    "$HINT" --desc 'some task' </dev/null >"$OUT" 2>"$ERR"
expect_eq "J10c CI unset reaches the real-binary path" "default" "$(cat "$OUT")"
expect_present_file "J10c fake claude ran" "$BASE_TMP/fake-called"

rm -f "$BASE_TMP/fake-called"
env -u PLAN_TIER_HINT_CLAUDE CI= PATH="$FAKEPATH" \
    "$HINT" --desc 'some task' </dev/null >"$OUT" 2>"$ERR"
expect_eq "J10d empty CI counts as unset" "default" "$(cat "$OUT")"
expect_present_file "J10d fake claude ran" "$BASE_TMP/fake-called"

echo
echo "== J11 claude missing =="
if [ -e /usr/bin/claude ] || [ -e /bin/claude ]; then
    echo "SKIP: J11 needs a PATH with no claude, but /usr/bin or /bin holds one"
    h_skip "J11 claude missing"
else
    mkdir -p "$BASE_TMP/emptybin"
    env -u CI -u PLAN_TIER_HINT_CLAUDE PATH="$BASE_TMP/emptybin:/usr/bin:/bin" \
        "$HINT" --explain --desc 'some task' </dev/null >"$OUT" 2>"$ERR"
    expect_match "J11 no claude on PATH: default naming the missing CLI" \
        "^default${TAB}judge-failsafe: claude CLI not found" "$OUT"
fi

echo
echo "== J12 verdict log =="
# log_field <n> — field n of the log's last line.
log_field() { awk -F'\t' -v n="$1" '{ f = $n } END { print f }' "$PLAN_TIER_HINT_LOG"; }

rm -f "$PLAN_TIER_HINT_LOG"
mk_judge recipe 0 "$(env_json "$(printf 'sonnet\nrecipe copy')")"
X130="$(printf '%0130d' 0 | tr 0 x)"
X120="$(printf '%0120d' 0 | tr 0 x)"
run_hint "$BASE_TMP/judge-recipe" --desc "$(printf '%s\t\ntail' "$X130")"
expect_eq "J12a success writes exactly one log line" "1" "$(awk 'END { print NR }' "$PLAN_TIER_HINT_LOG")"
expect_eq "J12a log line has exactly 4 TAB fields" "4" "$(awk -F'\t' '{ print NF }' "$PLAN_TIER_HINT_LOG")"
J12_TS="$(log_field 1)"
if grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}T' <<<"$J12_TS"; then
    h_pass "J12a field 1 is an ISO timestamp"
else
    h_fail "J12a field 1 is an ISO timestamp" "got [$J12_TS]"
fi
expect_eq "J12a field 2 is the verdict" "sonnet" "$(log_field 2)"
expect_eq "J12a field 3 is the reason" "recipe copy" "$(log_field 3)"
expect_eq "J12a field 4 is the task cut to 120 chars" "$X120" "$(log_field 4)"

env -u PLAN_TIER_HINT_CLAUDE CI=1 \
    "$HINT" --explain --desc 'some task' </dev/null >"$OUT" 2>"$ERR"
expect_eq "J12b failsafe logs its verdict" "default" "$(log_field 2)"
case "$(log_field 3)" in
    'judge-failsafe: CI guard'*) h_pass "J12b failsafe logs its judge-failsafe reason" ;;
    *) h_fail "J12b failsafe logs its judge-failsafe reason" "got [$(log_field 3)]" ;;
esac

run_hint "$BASE_TMP/judge-pass-default" --desc 'some task'
expect_eq "J12c no --explain: stdout is the bare verdict" "default" "$(cat "$OUT")"
expect_eq "J12c no --explain: the log still holds the reason" "reason for default" "$(log_field 3)"

run_hint "$BASE_TMP/judge-pass-default" --files 'bin/a,bin/b'
expect_eq "J12d files-only task logs the file list" "files: bin/a,bin/b" "$(log_field 4)"

echo
echo "== J14 a failed log write is harmless =="
: >"$BASE_TMP/notadir"
PLAN_TIER_HINT_LOG="$BASE_TMP/notadir/x.log" run_hint "$BASE_TMP/judge-pass-default" --desc 'some task'
expect_eq "J14a parent is a file: verdict unchanged" "default" "$(cat "$OUT")"
expect_exit "J14a parent is a file: exit unchanged" 0 "$RC"
expect_eq "J14a parent is a file: stderr stays empty" "" "$(cat "$ERR")"

mkfifo "$BASE_TMP/fifo"
PLAN_TIER_HINT_LOG="$BASE_TMP/fifo" PLAN_TIER_HINT_CLAUDE="$BASE_TMP/judge-pass-default" \
    "$HINT" --desc 'some task' </dev/null >"$OUT" 2>"$ERR" &
FIFO_PID=$!
FIFO_I=0
while [ "$FIFO_I" -lt 10 ] && kill -0 "$FIFO_PID" 2>/dev/null; do
    sleep 1
    FIFO_I=$((FIFO_I + 1))
done
if kill -0 "$FIFO_PID" 2>/dev/null; then
    kill -KILL "$FIFO_PID" 2>/dev/null
    wait "$FIFO_PID" 2>/dev/null
    h_fail "J14b FIFO log path returns within 10s" "the hint hung on the FIFO"
else
    wait "$FIFO_PID"
    FIFO_RC=$?
    h_pass "J14b FIFO log path returns within 10s"
    expect_eq "J14b FIFO: verdict unchanged" "default" "$(cat "$OUT")"
    expect_exit "J14b FIFO: exit unchanged" 0 "$FIFO_RC"
fi

echo
echo "== J15 empty and unset log seam mean the default path =="
rm -rf "${BASE_TMP:?}/home"
HOME_LOG="$BASE_TMP/home/.claude/logs/plan-tier-hint.log"
HOME="$BASE_TMP/home" PLAN_TIER_HINT_LOG='' \
    run_hint "$BASE_TMP/judge-pass-default" --desc 'empty seam'
expect_eq "J15 empty seam writes the default path" "1" "$(awk 'END { print NR }' "$HOME_LOG" 2>/dev/null)"
env -u PLAN_TIER_HINT_LOG HOME="$BASE_TMP/home" PLAN_TIER_HINT_CLAUDE="$BASE_TMP/judge-pass-default" \
    "$HINT" --desc 'unset seam' </dev/null >"$OUT" 2>"$ERR"
expect_eq "J15 unset seam writes the default path" "2" "$(awk 'END { print NR }' "$HOME_LOG" 2>/dev/null)"

echo
echo "== J13 judge call contract =="
reset_recorder
run_hint "$BASE_TMP/judge-rec" --desc 'Drop the human signoff floor' --files 'bin/a,bin/b'
expect_eq "J13 --model is claude-opus-5-5" "[claude-opus-5-5]" "$(arg_after --model)"
expect_eq "J13 --effort is high" "[high]" "$(arg_after --effort)"
expect_eq "J13 --output-format is json" "[json]" "$(arg_after --output-format)"
expect_eq "J13 --allowedTools carries an empty value" "[]" "$(arg_after --allowedTools)"
expect_eq "J13 --tools carries an empty value" "[]" "$(arg_after --tools)"
if grep -qxF -- '--strict-mcp-config' "$BASE_TMP/argv"; then
    h_pass "J13 --strict-mcp-config is passed"
else
    h_fail "J13 --strict-mcp-config is passed" "the judge argv lacks it"
fi
if grep -qxF -- '--dangerously-skip-permissions' "$BASE_TMP/argv"; then
    h_fail "J13 no --dangerously-skip-permissions" "the judge argv carries it"
else
    h_pass "J13 no --dangerously-skip-permissions"
fi
for t in 'would a wrong plan be expensive?' '2.5 times Opus 5.5 per token' \
    'plan-architect-sonnet' 'output format, answer default.' \
    'a design the brief already resolves'; do
    if grep -qF -- "$t" "$BASE_TMP/argv"; then
        h_pass "J13 prompt carries the open question text [$t]"
    else
        h_fail "J13 prompt carries the open question text [$t]" "the judge prompt lacks it"
    fi
done
# The old extraction's fence and the old check-1 sentence: SKILL.md text no
# longer reaches the judge.
for t in '--- check list ---' 'previously rejected now passes'; do
    if grep -qF -- "$t" "$BASE_TMP/argv"; then
        h_fail "J13 prompt carries no SKILL.md check text [$t]" "the judge prompt still has it"
    else
        h_pass "J13 prompt carries no SKILL.md check text [$t]"
    fi
done
TASK_HITS="$(awk '
    /^<task-/ { inside = 1; next }
    /^<\/task-/ { inside = 0; next }
    inside && /Drop the human signoff floor/ { d = 1 }
    inside && $0 == "bin/a" { a = 1 }
    inside && $0 == "bin/b" { b = 1 }
    END { printf "%d%d%d", d, a, b }
' "$BASE_TMP/argv")"
expect_eq "J13 description and one-per-line paths sit inside the task tags" "111" "$TASK_HITS"
JUDGE_CWD="$(cat "$BASE_TMP/cwd" 2>/dev/null)"
case "$JUDGE_CWD" in
    "$ROOT"*|'') h_fail "J13 judge runs outside the repo root" "cwd was [$JUDGE_CWD]" ;;
    *) h_pass "J13 judge runs outside the repo root" ;;
esac

echo
echo "== J16 --desc-only callers keep the old task block =="
reset_recorder
run_hint "$BASE_TMP/judge-rec" --desc 'Rename the standings cache key'
J16_SHAPE="$(awk '
    /^<task-/ { inside = 1; next }
    /^<\/task-/ { inside = 0; next }
    inside && $0 == "Description: Rename the standings cache key" { d = 1 }
    inside && $0 == "Files:" { f = 1 }
    inside && /^(Brief|Signals):/ { extra = 1 }
    END { printf "%d%d%d", d, f, extra }
' "$BASE_TMP/argv")"
expect_eq "J16 --desc-only task block keeps Description and Files lines, no Brief or Signals" "110" "$J16_SHAPE"
expect_eq "J16 --desc-only still prints default from the stub" "default" "$(cut -f1 "$OUT")"

# fence_dump — every line inside the task fence of the last recorded prompt.
fence_dump() {
    awk '/^<task-/ { i = 1; next } /^<\/task-/ { i = 0; next } i' "$BASE_TMP/argv"
}
# fence_files — the Files: section lines, comma-joined.
fence_files() {
    fence_dump | awk '
        /^(Brief|Signals):$/ { f = 0 }
        f { printf "%s%s", (n++ ? "," : ""), $0 }
        $0 == "Files:" { f = 1 }'
}
mkdir -p "$BASE_TMP/briefs"
J17_BRIEF="$BASE_TMP/briefs/j17.md"
cat > "$J17_BRIEF" <<'J17_EOF'
/plan Tighten the cache key.
- Step 3 MUST route to `plan-architect-xhigh`.
Do NOT escalate to plan-architect-sonnet.
step 3 must route to plan-architect
The architect writes the plan once.
Route to the queue after review.
J17_EOF

echo
echo "== J17 directive lines never reach the judge =="
reset_recorder
run_hint "$BASE_TMP/judge-rec" --brief "$J17_BRIEF"
J17_DUMP="$(fence_dump)"
expect_eq "J17 no must-route-to line in the fence" "0" \
    "$(printf '%s\n' "$J17_DUMP" | awk 'tolower($0) ~ /must route to/ { n++ } END { print n + 0 }')"
expect_eq "J17 no plan-architect line in the fence" "0" \
    "$(printf '%s\n' "$J17_DUMP" | awk '/plan-architect/ { n++ } END { print n + 0 }')"
expect_eq "J17 the /plan line and both near-miss keepers survive" "111" \
    "$(printf '%s\n' "$J17_DUMP" | awk '
        $0 == "/plan Tighten the cache key." { a = 1 }
        $0 == "The architect writes the plan once." { b = 1 }
        $0 == "Route to the queue after review." { c = 1 }
        END { printf "%d%d%d", a, b, c }')"

echo
echo "== J18 a directive passed as --desc is stripped, the log keeps it =="
reset_recorder
run_hint "$BASE_TMP/judge-rec" --desc 'Step 3 MUST route to plan-architect-xhigh' --files bin/a
J18_DUMP="$(fence_dump)"
expect_eq "J18 fence Description line is empty" "1" \
    "$(printf '%s\n' "$J18_DUMP" | awk '$0 == "Description: " { n++ } END { print n + 0 }')"
expect_eq "J18 fence still lists bin/a" "bin/a" "$(fence_files)"
expect_eq "J18 log line keeps the raw --desc text" "1" \
    "$(tail -n 1 "$PLAN_TIER_HINT_LOG" | awk '/MUST route to/ { n++ } END { print n + 0 }')"

echo
echo "== J19 brief paths join Files =="
J19_BRIEF="$BASE_TMP/briefs/j19.md"
cat > "$J19_BRIEF" <<'J19_EOF'
The gate lives at `bin/plan-now:313`.
Edit ibl5/classes/Foo.php. Then ibl5/classes/Foo.php. again.
See .claude/agents/plan-architect.md for the def.
J19_EOF
reset_recorder
run_hint "$BASE_TMP/judge-rec" --files bin/a --brief "$J19_BRIEF"
expect_eq "J19 Files are --files first, then brief paths, trimmed and deduped" \
    "bin/a,bin/plan-now,ibl5/classes/Foo.php" "$(fence_files)"

echo
echo "== J20 human-review signals =="
J20_BRIEF="$BASE_TMP/briefs/j20.md"
cat > "$J20_BRIEF" <<'J20_EOF'
/plan Add a thing.
- PR title type `feat:` for this change.
- Frontmatter sets `auto_merge: false`.
J20_EOF
reset_recorder
run_hint "$BASE_TMP/judge-rec" --signals implement --brief "$J20_BRIEF"
J20_DUMP="$(fence_dump)"
expect_eq "J20 Signals header and all three signal lines" "1111" \
    "$(printf '%s\n' "$J20_DUMP" | awk '
        $0 == "Signals:" { h = 1 }
        $0 == "- title type feat: the PR is held for a human sign-off before merge" { a = 1 }
        $0 == "- auto_merge false: an owner signs off before merge" { b = 1 }
        $0 == "- plan-now --implement: the plan waits on disk for a human to read it before it is queued" { c = 1 }
        END { printf "%d%d%d%d", h, a, b, c }')"
J20_NEAR="$BASE_TMP/briefs/j20-near.md"
cat > "$J20_NEAR" <<'J20N_EOF'
/plan Add a thing.
- PR title type `chore:` for this change.
- Frontmatter sets `auto_merge: true`.
J20N_EOF
reset_recorder
run_hint "$BASE_TMP/judge-rec" --brief "$J20_NEAR"
expect_eq "J20 near-miss brief raises no Signals header" "0" \
    "$(fence_dump | awk '$0 == "Signals:" { n++ } END { print n + 0 }')"

