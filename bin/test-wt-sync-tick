assert_absent "kill-switch: log not written" "synced=" "$(cat "$LOG12" 2>/dev/null)"

# ── Test 13: plist PATH resolves EVERY binary the tick shells out to ─────────
# The regression this guards: the generated PATH omitted /usr/sbin, so `ioreg`
# resolved to nothing under launchd, the presence gate fail-closed on every
# tick, and wt-sync never synced a single worktree. A missing tool is invisible
# at runtime (fail-closed by design), so it must be caught here instead.
PLIST_PATH_VAL="$("$CRON_SETUP" --print-schedule 2>/dev/null \
    | awk '/<key>PATH<\/key>/ { getline; gsub(/^[[:space:]]*<string>|<\/string>[[:space:]]*$/, ""); print; exit }')"
if [ -z "$PLIST_PATH_VAL" ]; then
    failcase "plist-path: could not extract PATH from --print-schedule"
else
    pass "plist-path: extracted PATH from plist"
    # ioreg is macOS-only; the Linux CI runner cannot resolve it anywhere.
    _plist_bins="git lsof"
    [ "$(uname)" = "Darwin" ] && _plist_bins="$_plist_bins ioreg"
    for _bin in $_plist_bins; do
        if PATH="$PLIST_PATH_VAL" command -v "$_bin" >/dev/null 2>&1; then
            pass "plist-path: '$_bin' resolves under the launchd PATH"
        else
            failcase "plist-path: '$_bin' does NOT resolve under the launchd PATH ($PLIST_PATH_VAL)"
        fi
    done
fi
# The seam default must itself be an existing executable on this machine.
_IOREG_DEFAULT="$(awk -F'"' '/^WT_SYNC_IOREG=/ { print $0; exit }' "$TICK" | sed 's/.*:-//; s/}.*//')"
if [ "$(uname)" != "Darwin" ]; then
    echo "SKIP: plist-path: WT_SYNC_IOREG default check skipped on non-Darwin"
elif [ -x "$_IOREG_DEFAULT" ]; then
    pass "plist-path: WT_SYNC_IOREG default ($_IOREG_DEFAULT) is executable"
else
    failcase "plist-path: WT_SYNC_IOREG default ('$_IOREG_DEFAULT') is not an executable"
fi

# ── Test 14: idle reader missing → distinct fail-closed message, nothing synced ─
# Must NOT be silently indistinguishable from a bad HID reading — a missing
# binary is a deployment bug and has to be greppable in the launchd log.
MAIN14="$(new_env)"
add_worktree "$MAIN14" "wt-noioreg" behind >/dev/null
LOG14="$(fresh_log t14)"; LOCKD14="$(fresh_lockd t14)"
OUT14="$(env PATH="$STUBBIN:$PATH" WT_SYNC_IOREG="$TMP/definitely-not-here/ioreg" \
            WT_SYNC_REPO_ROOT="$MAIN14" WT_SYNC_LOG="$LOG14" \
            WT_SYNC_LOCK_DIR="$LOCKD14" WT_SYNC_ENABLED=1 \
            "$TICK" 2>&1)" || true
assert_match  "missing-ioreg: distinct message" "idle reader missing or not executable" "$OUT14"
assert_absent "missing-ioreg: log has no synced= entry" "synced=" "$(cat "$LOG14" 2>/dev/null)"
HEAD14="$(git -C "$MAIN14/worktrees/wt-noioreg" rev-parse HEAD 2>/dev/null || echo '')"
ORIG14="$(git -C "$MAIN14" rev-parse origin/wt-noioreg 2>/dev/null || echo 'x')"
if [ "$HEAD14" != "$ORIG14" ]; then
    pass "missing-ioreg: worktree not synced"
else
    failcase "missing-ioreg: worktree was synced (should not have been)"
fi

# ── Test 15: source-level — ioreg is invoked via the seam, never bare ────────
if grep -qE '^[^#]*[^/"]\bioreg -c' "$TICK"; then
    failcase "source-level: wt-sync-tick calls bare 'ioreg' (PATH-dependent)"
else
    pass "source-level: ioreg invoked via \$WT_SYNC_IOREG, not a bare PATH lookup"
fi

# ── Test 16: source-level — header cites the real ADR for this script ────────
if grep -q 'ADR-0104' "$TICK"; then
    failcase "source-level: wt-sync-tick header cites ADR-0104 (no such ADR file)"
elif grep -q 'ADR-0106' "$TICK"; then
    pass "source-level: wt-sync-tick header cites ADR-0106"
else
    failcase "source-level: wt-sync-tick header cites no ADR at all"
fi

