test_xm_no_timeout_is_prerequisite() {
    new_case
    # A PATH that carries every tool the gate and lib need except gtimeout/timeout.
    local nt="$D/no-timeout-bin" t p
    mkdir -p "$nt"
    for t in bash git awk sed grep tr cat rm mkdir mktemp python3 sort head tail wc cut dirname basename cp mv date env readlink realpath cmp diff touch sha256sum shasum uname ls sleep kill id; do
        p=$(command -v "$t" 2>/dev/null) || continue
        case "$p" in /*) ln -sf "$p" "$nt/$t" ;; esac
    done
    xm_plan 'grep -qx a ibl5/tracked.txt'
    OUT=$(cd "$R" && PATH="$nt" /bin/bash "$GATE" --base master --plan "$PLAN" --stage exec-mutations 2>&1); RC=$?
    want_rc 3
    want_out "prerequisite missing: gtimeout or timeout (brew install coreutils)"
    [ "$(xm_tracked)" = a ] || note "tracked.txt is '$(xm_tracked)', not a"
}

test_xm_term_mid_row_restores_tree() {
    new_case
    xm_plan 'grep -qx a ibl5/tracked.txt || sleep 25'
    local pid i=0 t0=$SECONDS
    (cd "$R" && exec "$GATE" --base master --plan "$PLAN" --stage exec-mutations) > "$D/out" 2>&1 &
    pid=$!
    while [ "$(xm_tracked)" != b ] && [ "$i" -lt 50 ]; do sleep 0.2; i=$((i + 1)); done
    if [ "$(xm_tracked)" != b ]; then
        note "the mutation never appeared; cannot test TERM mid-row"
        kill -KILL "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
        return
    fi
    kill -TERM "$pid"
    wait "$pid" 2>/dev/null; RC=$?
    OUT=$(cat "$D/out")
    want_rc 143
    [ $((SECONDS - t0)) -lt 10 ] || note "TERM took $((SECONDS - t0)) s; the stage sat out the row"
    [ "$(xm_tracked)" = a ] || note "tracked.txt is '$(xm_tracked)', not a"
    xm_journal_empty || note "journal not empty"
    [ -z "$(xm_passes)" ] || note "an exec-mutations pass record exists"
}

test_xm_sigkill_leftover_repaired_before_tree_hash() {
    new_case
    xm_plan 'grep -qx a ibl5/tracked.txt || sleep 25'
    local pid i=0
    "$REPO/bin/lib/plan-exec-mutations" run --root "$R" --timeout 30 "$PLAN" > "$D/lib.out" 2>&1 &
    pid=$!
    while [ "$(xm_tracked)" != b ] && [ "$i" -lt 50 ]; do sleep 0.2; i=$((i + 1)); done
    if [ "$(xm_tracked)" != b ]; then
        note "the mutation never appeared; cannot test the SIGKILL leftover"
        kill -KILL "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
        return
    fi
    kill -KILL "$pid"
    wait "$pid" 2>/dev/null
    xm_journal_empty && note "no leftover journal after SIGKILL; the fixture is not exercising the repair"
    run_gate --stage phpunit
    want_rc 0
    want_out "restored a mutation left by an interrupted exec-mutations run"
    [ "$(xm_tracked)" = a ] || note "tracked.txt is '$(xm_tracked)', not a"
    xm_journal_empty || note "journal not empty after the gate"
    local want_name
    want_name="$(tree_hash).phpunit.pass"
    [ "$(pass_files '\.phpunit\.pass$')" = "$want_name" ] || note "phpunit record is '$(pass_files '\.phpunit\.pass$')', wanted $want_name"
}

test_xm_revert_failed_maps_to_fail() {
    new_case
    printf '#!/usr/bin/env bash\ncase "$1" in\n    run) echo "REVERT-FAILED row 1 — stub"; exit 3 ;;\n    pending) exit 1 ;;\n    recover) exit 0 ;;\n    *) exec "%s/bin/lib/plan-exec-mutations" "$@" ;;\nesac\n' "$REPO" > "$D/stubs/xmlib"
    chmod +x "$D/stubs/xmlib"
    xm_plan 'true'
    OUT=$(cd "$R" && PREFIRE_EXEC_MUTATIONS_LIB="$D/stubs/xmlib" "$GATE" --base master --plan "$PLAN" --stage exec-mutations 2>&1); RC=$?
    want_rc 1
    want_out "a mutation could not be reverted or its backup failed; run bin/lib/plan-exec-mutations recover"
    [ -z "$(xm_passes)" ] || note "an exec-mutations pass record exists"
}

test_xm_killed_lib_recovers_and_reports() {
    new_case
    printf '#!/usr/bin/env bash\ncase "$1" in\n    run) kill -9 $$ ;;\n    pending) exit 1 ;;\n    recover) touch "%s/recovered"; exit 0 ;;\n    *) exec "%s/bin/lib/plan-exec-mutations" "$@" ;;\nesac\n' "$D" "$REPO" > "$D/stubs/xmlib"
    chmod +x "$D/stubs/xmlib"
    xm_plan 'true'
    OUT=$(cd "$R" && PREFIRE_EXEC_MUTATIONS_LIB="$D/stubs/xmlib" "$GATE" --base master --plan "$PLAN" --stage exec-mutations 2>&1); RC=$?
    want_rc 1
    want_out "the mutation script stopped unexpectedly (exit 137)"
    [ -e "$D/recovered" ] || note "recover did not run after the lib was killed"
    [ -z "$(xm_passes)" ] || note "an exec-mutations pass record exists"
}

test_xm_locked_stage() {
    new_case
    printf '#!/usr/bin/env bash\ncase "$1" in\n    run) echo "EXEC-LOCKED - stub"; exit 4 ;;\n    pending) exit 1 ;;\n    recover) touch "%s/recovered"; exit 0 ;;\n    *) exec "%s/bin/lib/plan-exec-mutations" "$@" ;;\nesac\n' "$D" "$REPO" > "$D/stubs/xmlib"
    chmod +x "$D/stubs/xmlib"
    xm_plan 'true'
    OUT=$(cd "$R" && PREFIRE_EXEC_MUTATIONS_LIB="$D/stubs/xmlib" "$GATE" --base master --plan "$PLAN" --stage exec-mutations 2>&1); RC=$?
    want_rc 3
    want_out "another plan-exec-mutations run holds this worktree's exec lock"
    [ ! -e "$D/recovered" ] || note "recover ran although another run holds the lock"
    grep -qF -- "stopped unexpectedly" <<< "$OUT" && note "output blames the stub as an unexpected stop"
    [ -z "$(xm_passes)" ] || note "an exec-mutations pass record exists"
}

test_xm_locked_recover() {
    new_case
    printf '#!/usr/bin/env bash\ncase "$1" in\n    pending) exit 0 ;;\n    recover) exit 4 ;;\n    *) exec "%s/bin/lib/plan-exec-mutations" "$@" ;;\nesac\n' "$REPO" > "$D/stubs/xmlib"
    chmod +x "$D/stubs/xmlib"
    xm_plan 'true'
    OUT=$(cd "$R" && PREFIRE_EXEC_MUTATIONS_LIB="$D/stubs/xmlib" "$GATE" --base master --plan "$PLAN" --stage phpunit 2>&1); RC=$?
    want_rc 3
    want_out "another plan-exec-mutations run holds this worktree's exec lock"
    grep -qF -- "could not restore" <<< "$OUT" && note "output claims recover could not restore"
    [ -z "$(pass_files '\.phpunit\.pass$')" ] || note "a phpunit pass record exists"
}

# xm_argv_stub: stub lib whose `run` records its argv to $D/xm-argv and prints <verdict> row 1;
# parse and recover go to the real lib, so the plan's record is a real one.
xm_argv_stub() { # <verdict> <exit>
    printf '#!/usr/bin/env bash\ncase "$1" in\n    run) printf "%%s\\n" "$@" > "%s/xm-argv"; echo "%s row 1 — stub"; exit %s ;;\n    pending) exit 1 ;;\n    *) exec "%s/bin/lib/plan-exec-mutations" "$@" ;;\nesac\n' "$D" "$1" "$2" "$REPO" > "$D/stubs/xmlib"
    chmod +x "$D/stubs/xmlib"
}
xm_argv() { # <flag>: the value after <flag> in the recorded run argv
    awk -v f="$1" 'prev == f { print; exit } { prev = $0 }' "$D/xm-argv" 2>/dev/null
}

test_xm_default_uses_short_limits() {
    new_case
    xm_argv_stub TRIPPED 0
    xm_plan 'true'
    OUT=$(cd "$R" && PREFIRE_EXEC_MUTATIONS_LIB="$D/stubs/xmlib" "$GATE" --base master --plan "$PLAN" --stage exec-mutations 2>&1); RC=$?
    want_rc 0
    [ "$(xm_argv --max-timeout)" = 120 ] || note "--max-timeout is '$(xm_argv --max-timeout)', wanted 120"
    [ "$(xm_argv --budget)" = 300 ] || note "--budget is '$(xm_argv --budget)', wanted 300"
}

test_xm_fire_point_uses_larger_limits() {
    new_case
    xm_argv_stub TRIPPED 0
    xm_plan 'true'
    OUT=$(cd "$R" && PREFIRE_EXEC_MUTATIONS_LIB="$D/stubs/xmlib" "$GATE" --base master --plan "$PLAN" --stage exec-mutations --fire-point 2>&1); RC=$?
    want_rc 0
    [ "$(xm_argv --max-timeout)" = 300 ] || note "--max-timeout is '$(xm_argv --max-timeout)', wanted 300"
    [ "$(xm_argv --budget)" = 1800 ] || note "--budget is '$(xm_argv --budget)', wanted 1800"
}

test_xm_fire_point_limits_match_harness() {
    local m="$REPO/tools/postplan-harness/harness/mutations.py" mt bu
    mt=$(sed -n 's/^DEFAULT_MAX_TIMEOUT = \([0-9]*\).*/\1/p' "$m")
    bu=$(sed -n 's/^DEFAULT_BUDGET = \([0-9]*\).*/\1/p' "$m")
    [ "$mt" = 300 ] || note "harness DEFAULT_MAX_TIMEOUT is '$mt'; prefire-verify --fire-point uses 300"
    [ "$bu" = 1800 ] || note "harness DEFAULT_BUDGET is '$bu'; prefire-verify --fire-point uses 1800"
    grep -qF 'XM_MAX_TIMEOUT=300' "$GATE" || note "prefire-verify lacks XM_MAX_TIMEOUT=300"
    grep -qF 'XM_BUDGET=1800' "$GATE" || note "prefire-verify lacks XM_BUDGET=1800"
}

