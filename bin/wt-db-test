#!/bin/bash
# Run database integration tests in a worktree using the sibling ibl5_test database.
# Delegates to bin/db-test-up for bootstrap + test execution.
#
# Usage: bin/wt-db-test <worktree-name> [--no-run]
#
# The worktree's Docker environment must already be running (bin/wt-up).

set -euo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'EOF'
Usage: bin/wt-db-test <worktree-name> [--no-run]

Run database integration tests in a worktree using the sibling ibl5_test database.
The worktree's Docker environment must already be running (bin/wt-up).

Arguments:
  <worktree-name>   name of the worktree to test
  --no-run          set up the test database without running tests

Exit codes: delegates to bin/db-test-up
EOF
    exit 0
fi

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
source "$REPO_ROOT/bin/lib/git-helpers.sh"
WT_PARENT="$(worktrees_parent_dir "$REPO_ROOT")"

WORKTREE_NAME=""
EXTRA_ARGS=()

for arg in "$@"; do
    case "$arg" in
        --no-run) EXTRA_ARGS+=("$arg") ;;
        -*) echo "Unknown option: $arg" >&2; exit 1 ;;
        *)
            if [ -z "$WORKTREE_NAME" ]; then
                WORKTREE_NAME="$arg"
            else
                echo "Error: unexpected argument '$arg'" >&2
                exit 1
            fi
            ;;
    esac
done

if [ -z "$WORKTREE_NAME" ]; then
    echo "Usage: bin/wt-db-test <worktree-name> [--no-run]" >&2
    exit 1
fi

WORKTREE_PATH="$WT_PARENT/$WORKTREE_NAME"
if [ ! -d "$WORKTREE_PATH" ]; then
    WORKTREE_PATH="$REPO_ROOT/worktrees/$WORKTREE_NAME"  # legacy fallback (pre-migration)
fi
if [ ! -d "$WORKTREE_PATH" ]; then
    echo "Error: Worktree not found at $WT_PARENT/$WORKTREE_NAME (nor legacy $REPO_ROOT/worktrees/$WORKTREE_NAME)" >&2
    exit 1
fi

exec "$REPO_ROOT/bin/db-test-up" "$WORKTREE_NAME" "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"
