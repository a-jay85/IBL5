test_marker_clear_stamps() {
    new_env
    in_env "usage_marker_write $SID_A post-plan-now $PPN_BIN usage-pause drain 94 five_hour ''; usage_marker_clear $SID_A"
    assert_eq clear_stamp:rc 0 "$?"
    assert_no_file clear_stamp:marker-gone "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
    assert_file clear_stamp:stamp "$IBL5_USAGE_GATE_STATE_DIR/cleared/$SID_A"
}

# Runners call usage_marker_clear under `set -e`. When dm-seen holds only this sid,
# grep -v prints nothing and exits 1; that must not kill the caller.
test_marker_clear_sole_dm_seen_under_set_e() {
    new_env
    mkdir -p "$IBL5_USAGE_GATE_STATE_DIR"
    printf '%s\n' "$SID_A" > "$IBL5_USAGE_GATE_STATE_DIR/dm-seen"
    in_env "set -euo pipefail; usage_marker_clear $SID_A; echo survived > '$T/after'"
    assert_eq clear_sole_seen:rc 0 "$?"
    assert_file clear_sole_seen:caller-continued "$T/after"
    assert_eq clear_sole_seen:seen-empty "" "$(cat "$IBL5_USAGE_GATE_STATE_DIR/dm-seen")"
    printf '%s\n%s\n' "$SID_A" "$SID_B" > "$IBL5_USAGE_GATE_STATE_DIR/dm-seen"
    in_env "set -euo pipefail; usage_marker_clear $SID_A"
    assert_eq clear_sole_seen:keeps-other "$SID_B" "$(cat "$IBL5_USAGE_GATE_STATE_DIR/dm-seen")"
}

test_paused_hold_live() {
    new_env
    in_env "usage_paused_hold_live $SID_A 60"
    assert_eq hold_live:nothing 1 "$?"
    in_env "usage_marker_write $SID_A post-plan-now $PPN_BIN usage-pause drain 94 five_hour ''; usage_paused_hold_live $SID_A 60"
    assert_eq hold_live:marker 0 "$?"
    in_env "usage_marker_clear $SID_A; usage_paused_hold_live $SID_A 60"
    assert_eq hold_live:cleared-fresh 0 "$?"
    echo 1577836800 > "$IBL5_USAGE_GATE_STATE_DIR/cleared/$SID_A"
    in_env "usage_paused_hold_live $SID_A 60"
    assert_eq hold_live:cleared-old 1 "$?"
    in_env "usage_paused_hold_live ../x 60"
    assert_eq hold_live:bad-sid 1 "$?"
}

test_marker_find() {
    new_env
    local out cwd
    cwd=$(git -C "$(dirname "$PPN_BIN")" rev-parse --show-toplevel)
    in_env "usage_marker_find post-plan-now $cwd" >/dev/null 2>&1
    assert_eq marker_find:none 1 "$?"
    in_env "usage_marker_write $SID_A post-plan-now $PPN_BIN usage-pause drain 94 five_hour ''"
    out=$(in_env "usage_marker_find post-plan-now $cwd")
    assert_eq marker_find:match "$SID_A" "$out"
    in_env "usage_marker_find automouse $cwd" >/dev/null 2>&1
    assert_eq marker_find:other-runner 1 "$?"
    in_env "usage_marker_find post-plan-now /nowhere" >/dev/null 2>&1
    assert_eq marker_find:other-cwd 1 "$?"
}

test_postrun_pause_any() {
    new_env
    make_stub_bin "$STUB" "" "$BODY_B"
    printf "You've hit your limit\n" > "$T/log"
    in_env "usage_postrun_pause post-plan-now $SID_A $PPN_BIN any $T/log"
    assert_eq postrun_any:limit 0 "$?"
    assert_eq postrun_any:reason limit-hit "$(jq -r .reason "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json")"
    printf 'API Error: 401\n' > "$T/log"
    in_env "usage_postrun_pause post-plan-now $SID_B $PPN_BIN any $T/log"
    assert_eq postrun_any:401 1 "$?"
    assert_no_file postrun_any:no-marker "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_B.json"
}

test_limit_hit_marker_writes() {
    new_env
    make_stub_bin "$STUB" "" '{}' 1
    seed_cache "$(date +%s)" "$(usage_json 50 0)"
    in_env "usage_limit_hit_marker post-plan-now $SID_C $PPN_BIN"
    assert_eq limit_hit_marker:rc 0 "$?"
    local f="$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_C.json"
    assert_eq limit_hit_marker:reason limit-hit "$(jq -r .reason "$f" 2>/dev/null)"
    assert_eq limit_hit_marker:runner post-plan-now "$(jq -r .runner "$f" 2>/dev/null)"
    assert_eq limit_hit_marker:argv "$PPN_BIN --resume-paused $SID_C" "$(jq -r '.resume_argv | join(" ")' "$f" 2>/dev/null)"
    local notexec="$T/notexec"
    : > "$notexec"
    in_env "usage_limit_hit_marker post-plan-now $SID_D $notexec"
    assert_eq limit_hit_marker:notexec-rc 1 "$?"
    assert_no_file limit_hit_marker:notexec-no-marker "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_D.json"
}

# ---------------------------------------------------------------- Phase 8 (weekly pacing)

PACE_RS=1790000000

# pace_json <five> <week> <week_resets_epoch|"">
pace_json() {
    jq -cn --argjson f "$1" --argjson w "$2" --arg wr "$3" '
      {five_hour:{utilization:$f},
       seven_day:({utilization:$w} + (if $wr=="" then {} else {resets_at:($wr|tonumber|todate)} end))}'
}

# pace_at <body> <hours_before_reset>: run usage_pace_verdict at RS - hours*3600.
pace_at() {
    gate_run "usage_pace_verdict '$1' $(( PACE_RS - $2 * 3600 ))"
}

test_pace_reserve_parse() {
    new_env
    assert_eq pace_reserve:unset 10 "$(gate_run "unset IBL5_BURNDOWN_RESERVE_PCT; usage_pace_reserve")"
    assert_eq pace_reserve:empty 10 "$(gate_run "IBL5_BURNDOWN_RESERVE_PCT= usage_pace_reserve")"
    assert_eq pace_reserve:abc 10 "$(gate_run "IBL5_BURNDOWN_RESERVE_PCT=abc usage_pace_reserve")"
    assert_contains pace_reserve:abc-log "$(cat "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log")" "bad-reserve value=abc"
    assert_eq pace_reserve:100 10 "$(gate_run "IBL5_BURNDOWN_RESERVE_PCT=100 usage_pace_reserve")"
    assert_eq pace_reserve:0 0 "$(gate_run "IBL5_BURNDOWN_RESERVE_PCT=0 usage_pace_reserve")"
    assert_eq pace_reserve:25 25 "$(gate_run "IBL5_BURNDOWN_RESERVE_PCT=25 usage_pace_reserve")"
}

test_pace_verdict_go_early_window() {
    new_env
    local out
    out=$(pace_at "$(pace_json 5 20 "$PACE_RS")" 120)
    assert_eq pace_go:verdict go "$(printf '%s' "$out" | cut -d' ' -f1)"
    assert_eq pace_go:allowed 25.7 "$(printf '%s' "$out" | cut -d' ' -f3)"
    assert_eq pace_go:wait 0 "$(printf '%s' "$out" | cut -d' ' -f4)"
}

test_pace_verdict_wait_formula() {
    new_env
    local out want
    out=$(pace_at "$(pace_json 5 30 "$PACE_RS")" 120)
    want=$(jq -n '((30*168/90)-48)*3600 | ceil')
    assert_eq pace_wait:verdict wait "$(printf '%s' "$out" | cut -d' ' -f1)"
    assert_eq pace_wait:allowed 25.7 "$(printf '%s' "$out" | cut -d' ' -f3)"
    assert_eq pace_wait:seconds "$want" "$(printf '%s' "$out" | cut -d' ' -f4)"
    assert_eq pace_wait:seconds-literal 28800 "$(printf '%s' "$out" | cut -d' ' -f4)"
}

test_pace_verdict_over_ceiling() {
    new_env
    local out
    out=$(pace_at "$(pace_json 5 91 "$PACE_RS")" 10)
    assert_eq pace_ceiling:verdict wait "$(printf '%s' "$out" | cut -d' ' -f1)"
    assert_eq pace_ceiling:until-reset 36000 "$(printf '%s' "$out" | cut -d' ' -f4)"
}

test_pace_verdict_zone_five_hour() {
    new_env
    local out
    out=$(pace_at "$(pace_json 95 10 "$PACE_RS")" 120)
    assert_eq pace_zone:verdict zone "$(printf '%s' "$out" | cut -d' ' -f1)"
    assert_eq pace_zone:wait 0 "$(printf '%s' "$out" | cut -d' ' -f4)"
}

test_pace_verdict_blind() {
    new_env
    local out
    out=$(pace_at "$(pace_json 5 20 "")" 120)
    assert_eq pace_blind:no-resets blind "$(printf '%s' "$out" | cut -d' ' -f1)"
    out=$(pace_at "$(pace_json 5 20 "$PACE_RS" | jq -c 'del(.seven_day.utilization)')" 120)
    assert_eq pace_blind:no-util blind "$(printf '%s' "$out" | cut -d' ' -f1)"
    out=$(gate_run "usage_pace_verdict '$(pace_json 5 20 "$PACE_RS")' abc")
    assert_eq pace_blind:bad-now blind "$(printf '%s' "$out" | cut -d' ' -f1)"
    out=$(gate_run "usage_pace_verdict '' $(( PACE_RS - 120 * 3600 ))")
    assert_eq pace_blind:empty-body blind "$(printf '%s' "$out" | cut -d' ' -f1)"
}

test_pace_verdict_clamps() {
    new_env
    local out
    out=$(gate_run "usage_pace_verdict '$(pace_json 5 50 "$PACE_RS")' $(( PACE_RS + 3600 ))")
    assert_eq pace_clamp:past-verdict go "$(printf '%s' "$out" | cut -d' ' -f1)"
    assert_eq pace_clamp:past-allowed 90 "$(printf '%s' "$out" | cut -d' ' -f3)"
    out=$(pace_at "$(pace_json 5 0 "$PACE_RS")" 200)
    assert_eq pace_clamp:far-verdict wait "$(printf '%s' "$out" | cut -d' ' -f1)"
    assert_eq pace_clamp:far-allowed 0 "$(printf '%s' "$out" | cut -d' ' -f3)"
    assert_eq pace_clamp:far-floor 60 "$(printf '%s' "$out" | cut -d' ' -f4)"
}

test_runner_priority_burndown_loop() {
    new_env
    assert_eq prio_burndown_loop 4 "$(gate_run "usage_runner_priority burndown-loop")"
    gate_run "usage_runner_priority burndown" >/dev/null 2>&1
    assert_eq prio_burndown_near_miss 1 "$?"
    in_env "usage_marker_write $SID_A burndown-loop '$REPO_ROOT/bin/burndown-loop' usage-pause drain 94 seven_day ''"
    assert_eq prio_burndown_loop:marker-rc 0 "$?"
    assert_eq prio_burndown_loop:runner burndown-loop "$(jq -r .runner "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json" 2>/dev/null)"
}

# ---------------------------------------------------------------- cred-switch resume

FP_A=$(printf tokA | shasum -a 256 | cut -c1-16)

# elig_run <token|""> <expr>: run <expr> with the keychain stub returning <token>.
elig_run() {
    make_stub_bin "$STUB" "$1" '{}' 1
    PATH="$STUB:$ORIG_PATH" bash -c ". '$REPO_ROOT/bin/lib/usage-gate.sh'; $2"
}

# elig_marker <reason> <paused_ago> <cred_fp|"">: seed a marker for SID_A.
elig_marker() {
    new_env
    jq -n --arg sid "$SID_A" --arg reason "$1" --argjson at "$(( $(date +%s) - $2 ))" --arg fp "$3" \
        '{session_id:$sid, reason:$reason, paused_at:$at, resume_count:0,
          cred_fp:(if $fp == "" then null else $fp end)}' \
        > "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
}

test_cred_switch_marker_records_fp() {
    new_env
    local rbin="$T/resume.sh"
    printf '#!/bin/sh\n' > "$rbin"; chmod +x "$rbin"
    elig_run tokA "usage_marker_write $SID_A plan-now '$rbin' limit-hit hit 100 five_hour 1790625600"
    assert_eq cred_switch_write:fp "$FP_A" "$(jq -r '.cred_fp' "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json")"
    elig_run "" "usage_marker_write $SID_A plan-now '$rbin' limit-hit hit 100 five_hour 1790625600"
    assert_eq cred_switch_write:null-when-unreadable null "$(jq -r '.cred_fp' "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json")"
}

test_cred_switch_same_login_held() {
    elig_marker limit-hit 60 "$FP_A"
    elig_run tokA "usage_marker_eligible $SID_A $(date +%s)"
    assert_eq cred_switch_same:rc 1 "$?"
}

test_cred_switch_new_login_eligible() {
    elig_marker limit-hit 60 "$FP_A"
    elig_run tokB "usage_marker_eligible $SID_A $(date +%s)"
    assert_eq cred_switch_new:rc 0 "$?"
    assert_contains cred_switch_new:log "$(cat "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log")" "limit-hit-hold-skipped reason=cred-switch sid=$SID_A"
}

test_cred_switch_null_marker_fp_held() {
    elig_marker limit-hit 60 ""
    elig_run tokB "usage_marker_eligible $SID_A $(date +%s)"
    assert_eq cred_switch_null_fp:rc 1 "$?"
}

test_cred_switch_unreadable_keychain_held() {
    elig_marker limit-hit 60 "$FP_A"
    elig_run "" "usage_marker_eligible $SID_A $(date +%s)"
    assert_eq cred_switch_no_keychain:rc 1 "$?"
}

# ---------------------------------------------------------------- account-switch fast path

FP_TOKB=$(printf tokB | shasum -a 256 | cut -c1-16)

# switch_seed <acct_old_uuid|""> <acct_new_uuid|""> <backoff_secs>: old-account cache, new token.
switch_seed() {
    seed_home "$2"
    local d="$IBL5_USAGE_GATE_STATE_DIR"
    [ -n "$1" ] && acct_hash "$1" > "$d/acct-last"
    seed_cache_fp "$(date +%s)" "$BODY_A" "$FP_A"
    printf '%s\n' "$(( $(date +%s) + $3 )) 1" > "$d/fetch-backoff"
    make_stub_http "$STUB" tokB 429 "$RL_BODY" 3598
}

test_fetch_switch_short_backoff() {
    new_env
    switch_seed uuid-A uuid-B 600
    local d="$IBL5_USAGE_GATE_STATE_DIR" until step now
    fetch_once 60 >/dev/null
    assert_contains switch_short:dropped "$(fetch_log)" "cred-switch cache-dropped"
    assert_contains switch_short:signal "$(fetch_log)" "cred-switch signal kind=account"
    assert_contains switch_short:backoff "$(fetch_log)" "retry_after=3598 backoff=45 switch-retry=1/3"
    read -r until step < "$d/fetch-backoff"
    now=$(date +%s)
    if [ $((until - now)) -le 45 ]; then pass switch_short:until; else fail switch_short:until "until-now=$((until - now))"; fi
    assert_eq switch_short:count 1 "$(awk '{print $3}' "$d/cred-switch")"
    assert_no_file switch_short:no-episode "$d/fetch-429-episode"
    assert_eq switch_short:no-secrets "" "$(grep -rl -e tokB -e uuid-B "$d" 2>/dev/null)"
}

test_fetch_switch_short_backoff_exhausts() {
    new_env
    seed_home ""
    local d="$IBL5_USAGE_GATE_STATE_DIR"
    make_stub_http "$STUB" tokB 429 "$RL_BODY" 3598
    printf '%s %s 2 account\n' "$(date +%s)" "$FP_TOKB" > "$d/cred-switch"
    fetch_once 60 >/dev/null
    assert_contains switch_exhaust:third "$(fetch_log)" "backoff=45 switch-retry=3/3"
    rm -f "$d/fetch-backoff"
    : > "$d/usage-gate.log"
    fetch_once 60 >/dev/null
    assert_contains switch_exhaust:normal "$(fetch_log)" "retry_after=3598 backoff=900"
    assert_eq switch_exhaust:no-retry-tag 0 "$(log_count switch-retry)"
}

test_fetch_switch_short_backoff_guards() {
    new_env
    seed_home ""
    local d="$IBL5_USAGE_GATE_STATE_DIR"
    make_stub_http "$STUB" tokB 429 "$RL_BODY" 3598
    printf '%s %s 0 account\n' "$(date +%s)" "$FP_A" > "$d/cred-switch"
    fetch_once 60 >/dev/null
    assert_contains switch_guard:other-fp "$(fetch_log)" "retry_after=3598 backoff=900"
    new_env
    seed_home ""
    d="$IBL5_USAGE_GATE_STATE_DIR"
    make_stub_http "$STUB" tokB 429 "$RL_BODY" 3598
    printf '%s %s 0 account\n' "$(( $(date +%s) - 1800 ))" "$FP_TOKB" > "$d/cred-switch"
    fetch_once 60 >/dev/null
    assert_contains switch_guard:expired "$(fetch_log)" "retry_after=3598 backoff=900"
    assert_eq switch_guard:no-retry-tag 0 "$(log_count switch-retry)"
}

test_fetch_same_account_refresh_no_signal() {
    new_env
    switch_seed uuid-A uuid-A 600
    fetch_once 60 >/dev/null
    assert_contains same_acct:logged "$(fetch_log)" "cred-switch same-account"
    assert_no_file same_acct:no-signal "$IBL5_USAGE_GATE_STATE_DIR/cred-switch"
    assert_contains same_acct:backoff "$(fetch_log)" "retry_after=3598 backoff=900"
}

test_fetch_switch_unknown_account_signals_token() {
    new_env
    switch_seed "" "" 600
    fetch_once 60 >/dev/null
    assert_contains unknown_acct:signal "$(fetch_log)" "cred-switch signal kind=token"
    assert_contains unknown_acct:backoff "$(fetch_log)" "backoff=45"
}

test_fetch_429_episode_climbs_across_success() {
    new_env
    local d="$IBL5_USAGE_GATE_STATE_DIR" exp i=0
    # Labels expand per round: ep_climb:delay1 through ep_climb:delay6, plus success-clears and episode-kept.
    for exp in 30 60 120 240 480 480; do
        i=$((i + 1))
        seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
        make_stub_http "$STUB" "$SECRET_TOK" 429 "$RL_BODY"
        fetch_once 45 >/dev/null
        assert_backoff_delay "ep_climb:delay$i" "$exp"
        expire_backoff
        seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
        make_stub_http "$STUB" "$SECRET_TOK" 200 "$BODY_B"
        fetch_once 45 >/dev/null
        assert_no_file "ep_climb:success-clears$i" "$d/fetch-backoff"
        assert_file "ep_climb:episode-kept$i" "$d/fetch-429-episode"
    done
    assert_eq ep_climb:attempts 6 "$(episode_attempts)"
    assert_eq ep_climb:one-start 1 "$(log_count '429-episode start')"
    assert_eq ep_climb:start-wording 1 "$(log_re_count "${LOG_PFX}429-episode start retry_after=none backoff=30\$")"
    assert_eq ep_climb:no-end-while-live 0 "$(log_count '429-episode end')"
    assert_eq ep_climb:no-per-attempt 0 "$(log_count 'reason=rate-limited')"
}

test_fetch_429_episode_end_logged_once() {
    new_env
    local d="$IBL5_USAGE_GATE_STATE_DIR"
    seed_episode 3000 1801 6
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    make_stub_http "$STUB" "$SECRET_TOK" 200 "$BODY_B"
    fetch_once 45 >/dev/null
    assert_eq ep_end:wording 1 "$(log_re_count "${LOG_PFX}429-episode end duration=1199 attempts=6\$")"
    assert_no_file ep_end:removed "$d/fetch-429-episode"
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    fetch_once 45 >/dev/null
    assert_eq ep_end:once 1 "$(log_count '429-episode end')"

    new_env
    d="$IBL5_USAGE_GATE_STATE_DIR"
    seed_episode 100 10 3
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    make_stub_http "$STUB" "$SECRET_TOK" 200 "$BODY_B"
    fetch_once 45 >/dev/null
    assert_eq ep_end:live-no-end 0 "$(log_count '429-episode end')"
    assert_eq ep_end:live-kept 3 "$(episode_attempts)"
}

test_fetch_429_episode_quiet_boundary() {
    new_env
    seed_episode 3000 1801 6
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    make_stub_http "$STUB" "$SECRET_TOK" 429 "$RL_BODY"
    fetch_once 45 >/dev/null
    assert_eq ep_quiet:prev-end 1 "$(log_re_count "${LOG_PFX}429-episode end duration=1199 attempts=6\$")"
    assert_eq ep_quiet:new-start 1 "$(log_re_count "${LOG_PFX}429-episode start retry_after=none backoff=30\$")"
    assert_backoff_delay ep_quiet:fresh-delay 30
    assert_eq ep_quiet:fresh-attempts 1 "$(episode_attempts)"

    new_env
    seed_episode 3000 1790 6
    seed_cache "$(( $(date +%s) - 100 ))" "$BODY_A"
    make_stub_http "$STUB" "$SECRET_TOK" 429 "$RL_BODY"
    fetch_once 45 >/dev/null
    assert_backoff_delay ep_quiet:live-delay 480
    assert_eq ep_quiet:live-attempts 7 "$(episode_attempts)"
    assert_eq ep_quiet:live-no-start 0 "$(log_count '429-episode start')"
    assert_eq ep_quiet:live-no-end 0 "$(log_count '429-episode end')"
}

test_fetch_429_episode_retry_after_not_multiplied() {
    new_env
