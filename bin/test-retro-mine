    mv "$t/projects/-Users-x-GitHub-IBL5/s1.jsonl" "$t/projects/-Users-x-GitHub-IBL5/s1/subagents/agent-1.jsonl"
    rm_tuneup_run "$t" --dry-run
    rm_has "tuneup_subagents_skipped: subagent transcript yields no thread" "$RM_OUT" "threads interactive=0 headless=0"
}

case_tuneup_signal_types() {
    local t d f ts
    t="$(rm_tmp)"
    rm_tuneup_stubs "$t"
    rm_tuneup_thread "$t" "" s1 3600
    d="$t/projects/-Users-x-GitHub-IBL5"
    f="$d/s1.jsonl"
    ts="$(rm_iso $((RM_NOW - 3000)))"
    rm_tline "$f" "{\"type\":\"system\",\"subtype\":\"stop_hook_summary\",\"hasOutput\":true,\"hookErrors\":[\"stop blocked: dirty tree\"],\"timestamp\":\"$ts\"}"
    rm_tline "$f" "{\"type\":\"system\",\"subtype\":\"compact_boundary\",\"compactMetadata\":{\"trigger\":\"auto\",\"preTokens\":160000},\"timestamp\":\"$ts\"}"
    rm_tline "$f" "{\"type\":\"assistant\",\"timestamp\":\"$ts\",\"message\":{\"id\":\"m1\",\"usage\":{\"input_tokens\":60000,\"output_tokens\":0}}}"
    rm_tline "$f" "{\"type\":\"assistant\",\"timestamp\":\"$ts\",\"message\":{\"id\":\"m1\",\"usage\":{\"input_tokens\":60000,\"output_tokens\":0}}}"
    rm_tline "$f" "{\"type\":\"assistant\",\"timestamp\":\"$ts\",\"message\":{\"id\":\"m2\",\"usage\":{\"input_tokens\":150000,\"output_tokens\":0}}}"
    rm_tline "$d/h.jsonl" "{\"type\":\"user\",\"entrypoint\":\"sdk-cli\",\"timestamp\":\"$ts\",\"message\":{\"content\":\"do the thing\"}}"
    rm_tline "$d/h.jsonl" "{\"type\":\"user\",\"entrypoint\":\"sdk-cli\",\"timestamp\":\"$ts\",\"message\":{\"content\":\"no, stop that\"}}"
    rm_tuneup_run "$t" --dry-run
    rm_has "tuneup_signal_types: one correction (headless ignored)" "$RM_OUT" "signals correction=1"
    rm_has "tuneup_signal_types: one hook deny" "$RM_OUT" "signals hook_deny=1"
    rm_has "tuneup_signal_types: one stop block" "$RM_OUT" "signals stop_block=1"
    rm_has "tuneup_signal_types: one compaction" "$RM_OUT" "signals compaction=1"
    rm_has "tuneup_signal_types: one heavy turn after message.id dedupe" "$RM_OUT" "signals heavy_turn=1"
}

