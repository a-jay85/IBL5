test_coord_runaway_stuck() {
    coord_setup 50
    coord_marker $SID_A plan-now
    patch_marker $SID_A ".resume_count = 5 | .resets_at = $(( $(date +%s) + 3600 ))"
    run_coord --once >/dev/null 2>&1
    sleep 0.3
    assert_no_file coord_runaway:not-launched "$T/launched.$SID_A"
    assert_eq coord_runaway:stuck true "$(jq -r .stuck "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json")"
    assert_eq coord_runaway:one-dm 1 "$(dm_calls)"
    run_coord --once >/dev/null 2>&1
    assert_eq coord_runaway:no-second-dm 1 "$(dm_calls)"
}

# A marker left stuck in an earlier usage window gets a fresh count once that
# window resets, and the coordinator resumes it without a manual --resume-paused.
test_coord_runaway_window_reset() {
    coord_setup 50
    coord_marker $SID_A plan-now
    patch_marker $SID_A ".resume_count = 5 | .stuck = true | .stuck_reason = \"paused-5-times\" | .resets_at = $(( $(date +%s) - 60 ))"
    local out
    out=$(run_coord --dry-run --once 2>/dev/null)
    assert_contains coord_window_reset:dry-action "$out" "ACTION unstick $SID_A window-reset"
    assert_eq coord_window_reset:dry-keeps-stuck true "$(jq -r .stuck "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json")"
    run_coord --once >/dev/null 2>&1
    wait_file "$T/launched.$SID_A"
    assert_file coord_window_reset:launched "$T/launched.$SID_A"
    assert_eq coord_window_reset:unstuck false "$(jq -r '.stuck // false' "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json")"
    assert_eq coord_window_reset:count-restarted 1 "$(jq -r .resume_count "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json")"
    assert_contains coord_window_reset:log "$(cat "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log")" "runaway-reset sid=$SID_A reason=window-reset"
    assert_contains coord_window_reset:dm "$(cat "$T/dm.txt")" "usage window reset"
}

# A marker left stuck under one account gets a fresh count after a login switch,
# because the new account has its own limits. Its window has not reset yet.
test_coord_runaway_account_switch() {
    coord_setup 50
    seed_home uuid-A
    coord_marker $SID_A plan-now
    patch_marker $SID_A ".resume_count = 5 | .stuck = true | .stuck_reason = \"paused-5-times\" | .resets_at = $(( $(date +%s) + 86400 ))"
    assert_eq coord_acct_switch:marker-acct "$(acct_hash uuid-A)" "$(jq -r .acct_fp "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json")"
    seed_home uuid-B
    local out
    out=$(run_coord --dry-run --once 2>/dev/null)
    assert_contains coord_acct_switch:dry-action "$out" "ACTION unstick $SID_A account-switch"
    assert_eq coord_acct_switch:dry-keeps-stuck true "$(jq -r .stuck "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json")"
    run_coord --once >/dev/null 2>&1
    wait_file "$T/launched.$SID_A"
    assert_file coord_acct_switch:launched "$T/launched.$SID_A"
    assert_eq coord_acct_switch:unstuck false "$(jq -r '.stuck // false' "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json")"
    assert_eq coord_acct_switch:count-restarted 1 "$(jq -r .resume_count "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json")"
    assert_contains coord_acct_switch:log "$(cat "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log")" "runaway-reset sid=$SID_A reason=account-switch"
    assert_contains coord_acct_switch:dm "$(cat "$T/dm.txt")" "login switch detected"
    assert_eq coord_acct_switch:reset-acct "$(acct_hash uuid-B)" "$(jq -r .reset_acct "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json")"
    # The resumed run exits without pausing; after 5 more tries it stays stuck.
    rm -f "$T/launched.$SID_A"
    patch_marker $SID_A ".resume_count = 5 | .stuck = true | .stuck_reason = \"paused-5-times\""
    run_coord --once >/dev/null 2>&1
    sleep 0.3
    assert_no_file coord_acct_switch:no-second-reset "$T/launched.$SID_A"
    assert_eq coord_acct_switch:stuck-again true "$(jq -r .stuck "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json")"
}

# Same account, window not reset: the stuck marker stays stuck.
test_coord_runaway_same_account_stays_stuck() {
    coord_setup 50
    seed_home uuid-A
    coord_marker $SID_A plan-now
    patch_marker $SID_A ".resume_count = 5 | .stuck = true | .stuck_reason = \"paused-5-times\" | .resets_at = $(( $(date +%s) + 86400 ))"
    run_coord --once >/dev/null 2>&1
    sleep 0.3
    assert_no_file coord_same_acct:not-launched "$T/launched.$SID_A"
    assert_eq coord_same_acct:still-stuck true "$(jq -r .stuck "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json")"
}

# A marker whose resets_at is unknown stays stuck: there is no window to wait out.
test_coord_runaway_no_resets_stays_stuck() {
    coord_setup 50
    coord_marker $SID_A plan-now
    patch_marker $SID_A '.resume_count = 5 | .stuck = true | .stuck_reason = "paused-5-times" | .resets_at = null'
    run_coord --once >/dev/null 2>&1
    sleep 0.3
    assert_no_file coord_no_resets:not-launched "$T/launched.$SID_A"
    assert_eq coord_no_resets:still-stuck true "$(jq -r .stuck "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json")"
}

# A resume binary removed after the pause (worktree reaped once its PR merged) gets
# the marker cleared, so the runner's queue lock is no longer held by it.
test_coord_missing_bin_retires() {
    coord_setup 50
    coord_marker $SID_A plan-now
    rm -f "$RBIN"
    local out
    out=$(run_coord --dry-run --once 2>/dev/null)
    assert_contains coord_missing_bin:dry-action "$out" "ACTION clear $SID_A resume-bin-missing"
    assert_file coord_missing_bin:dry-keeps "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
    run_coord --once >/dev/null 2>&1
    assert_no_file coord_missing_bin:marker-gone "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
    assert_file coord_missing_bin:cleared-stamp "$IBL5_USAGE_GATE_STATE_DIR/cleared/$SID_A"
    assert_eq coord_missing_bin:one-dm 1 "$(dm_calls)"
    assert_contains coord_missing_bin:dm-text "$(cat "$T/dm.txt")" "marker cleared"
}

# A marker already left stuck by the old code is retired too, even in the stop zone.
test_coord_missing_bin_retires_stuck_in_stop() {
    coord_setup 99
    coord_marker $SID_A post-plan-now
    patch_marker $SID_A '.stuck = true | .stuck_reason = "resume-bin-not-executable"'
    rm -f "$RBIN"
    run_coord --once >/dev/null 2>&1
    assert_no_file coord_missing_bin_stuck:marker-gone "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json"
    assert_eq coord_missing_bin_stuck:one-dm 1 "$(dm_calls)"
}

test_coord_in_flight_skip() {
    coord_setup 50
    coord_marker $SID_A plan-now
    patch_marker $SID_A ".resuming_pid = $$"
    run_coord --once >/dev/null 2>&1
    sleep 0.3
    assert_no_file coord_in_flight:not-relaunched "$T/launched.$SID_A"
    assert_eq coord_in_flight:count-unchanged 0 "$(jq -r .resume_count "$IBL5_USAGE_GATE_STATE_DIR/markers/$SID_A.json")"
}

test_coord_stale_resets_passed() {
    coord_setup 99
    seed_cache "$(( $(date +%s) - 600 ))" "$(usage_json 99 0)"
    coord_marker $SID_A plan-now; coord_marker $SID_B plan-now
    patch_marker $SID_A ".resets_at = $(( $(date +%s) - 3600 ))"
    patch_marker $SID_B ".resets_at = $(( $(date +%s) + 3600 ))"
    run_coord --once >/dev/null 2>&1
    wait_file "$T/launched.$SID_A"
    assert_file coord_stale:past-launches "$T/launched.$SID_A"
    assert_no_file coord_stale:future-waits "$T/launched.$SID_B"
    assert_contains coord_stale:log "$(cat "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log")" "coordinator-stale-usage"
}

test_coord_tick_busy() {
    coord_setup 50
    coord_marker $SID_A plan-now
    mkdir "$IBL5_USAGE_GATE_STATE_DIR/coordinator.lock.d"
    printf '%s\n' "$(date +%s)" > "$IBL5_USAGE_GATE_STATE_DIR/coordinator.lock.d/at"
    run_coord --once >/dev/null 2>&1
    assert_eq coord_busy:rc 0 "$?"
    sleep 0.3
    assert_no_file coord_busy:not-launched "$T/launched.$SID_A"
    assert_contains coord_busy:log "$(cat "$IBL5_USAGE_GATE_STATE_DIR/usage-gate.log")" "tick-busy"
}

