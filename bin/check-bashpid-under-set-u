#!/bin/bash
#
# bin/check-bashpid-under-set-u — keep bash-4-only BASHPID reads out of bin/ shell scripts.
#
# macOS /bin/bash is 3.2, where BASHPID does not exist. Under set -u a bare read aborts
# the script, and callers that treat a failure as a normal result hide the abort.
# Use "${BASHPID:-$$}" or a helper that falls back to $$.
#
# Flags a code line that reads the variable bare, in its dollar-prefixed or braced
# form, with no default operator (:- or - or :+ or +). Comment text is stripped
# (quote-blind: the first # at line start or after whitespace starts a comment).
# Scope: every file under bin/ ending in .sh or .bash, or with a shell shebang.
# --files exists for the harness. Whole-tree scan, so no base ref.
#
# Bash 3.2 safe (no mapfile). Exit codes: 0 = pass, 1 = violation, 2 = usage error.
# gate-backtest-argv:

set -euo pipefail

die() { echo "check-bashpid-under-set-u: $*" >&2; exit 2; }
# shellcheck disable=SC2016 # regex text, nothing to expand
BAD_RE='\$(BASHPID([^[:alnum:]_]|$)|\{#?BASHPID(\}|:[^-+]|[/#%^,?[]))'

files=()
case "${1:-}" in
    -h | --help) echo "usage: bin/check-bashpid-under-set-u [--files <path>...]"; exit 0 ;;
    --files)
        shift
        [ "$#" -gt 0 ] || die "--files needs at least one path"
        for f in "$@"; do [ -f "$f" ] || die "no such file: $f"; files+=("$f"); done
        ;;
    "") cd "$(dirname "$0")/.."
        while IFS= read -r f; do [ -f "$f" ] && files+=("$f"); done < <(find bin -type f | sort) ;;
    *) die "unknown option: $1" ;;
esac

hits=0
for f in ${files[@]+"${files[@]}"}; do
    first=""
    IFS= read -r first <"$f" || true
    case "$f" in *.sh | *.bash) ;; *) case "$first" in '#!'*bash* | '#!'*/sh*) ;; *) continue ;; esac ;; esac
    out=$(sed -E 's/(^|[[:space:]])#.*//' "$f" | grep -nE "$BAD_RE" || true)
    [ -z "$out" ] || { hits=1; printf '%s\n' "$out" | sed "s|^|$f:|"; }
done
# shellcheck disable=SC2016 # literal hint text
[ "$hits" -eq 0 ] || { echo 'fix: write "${BASHPID:-$$}" (bash 3.2 has no BASHPID)'; exit 1; }
echo "check-bashpid-under-set-u: OK (${#files[@]} files scanned)"
