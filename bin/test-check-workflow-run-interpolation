#!/usr/bin/env bash
# shellcheck shell=bash
#
# bin/test-check-workflow-run-interpolation — regression test for the run-body
# interpolation gate. Each case writes a throwaway workflow file and asserts the
# check's exit code (and, where it matters, what it printed).
#
# Run: bin/test-check-workflow-run-interpolation  (exit 0 = all pass, 1 = a case failed)
set -u
# shellcheck source=bin/lib/harness.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/harness.sh"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CHECK="$SCRIPT_DIR/check-workflow-run-interpolation"
h_tmp TMP

# write_wf <body>  → echoes the path of a fresh file holding <body>. Uses mktemp
# (not a counter): this runs in a $(...) subshell, so a counter would not persist.
write_wf() {
  local f
  f="$(mktemp "$TMP/wf.XXXXXX")"
  printf '%s\n' "$1" > "$f"
  printf '%s' "$f"
}

expect() { # name want-exit got-exit
  if [ "$3" -eq "$2" ]; then
    h_pass "$1 (exit $3)"
  else
    h_fail "$1" "expected exit $2, got $3"
  fi
}

# run_case <name> <want-exit> <file>  → runs the check, sets $out, asserts the exit.
run_case() {
  local rc
  out="$("$CHECK" "$3" 2>/dev/null)"
  rc=$?
  expect "$1" "$2" "$rc"
}

# --- bad: env.VRCTX in a block run ---------------------------------------------
f="$(write_wf 'name: t
on: [workflow_call]
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - name: Splice
        run: |
          echo start
          x --update-pr-body=${{ env.VRCTX_PR }}')"
run_case "flags env.VRCTX in block run" 1 "$f"
if ! grep -qF -- ":10:" <<< "$out"; then
  h_fail "flags env.VRCTX in block run" "output does not name line 10: $out"
fi

# --- bad: string input in a run body (the #1387 shape) -------------------------
f="$(write_wf 'name: t
on:
  workflow_call:
    inputs:
      refresh_head_sha:
        type: string
        required: false
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - name: Splice
        run: |
          x \
            --head-sha=${{ inputs.refresh_head_sha || github.event.pull_request.head.sha }}')"
run_case "flags inputs head-sha in run" 1 "$f"

# --- good: same expression through step env ------------------------------------
f="$(write_wf 'name: t
on:
  workflow_call:
    inputs:
      refresh_head_sha:
        type: string
        required: false
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - name: Splice
        env:
          VR_HEAD_SHA: ${{ inputs.refresh_head_sha || github.event.pull_request.head.sha }}
        run: |
          x \
            --head-sha="$VR_HEAD_SHA"')"
run_case "accepts step env VR_HEAD_SHA" 0 "$f"

# --- good: with: number ---------------------------------------------------------
f="$(write_wf 'name: t
on: [workflow_call]
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - uses: some/action@v1
        with:
          number: ${{ env.VRCTX_PR }}')"
run_case "accepts with number" 0 "$f"

# --- good: concurrency group ----------------------------------------------------
f="$(write_wf 'name: t
on:
  workflow_call:
    inputs:
      pr_number:
        type: string
concurrency:
  group: x-${{ inputs.pr_number }}
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - run: echo hi')"
run_case "accepts concurrency group" 0 "$f"

# --- good: boolean input --------------------------------------------------------
f="$(write_wf 'name: t
on:
  workflow_dispatch:
    inputs:
      force:
        type: boolean
        default: false
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - name: Go
        run: |
          if [ "${{ inputs.force }}" = "true" ]; then
            echo forced
          fi')"
run_case "accepts boolean input" 0 "$f"

# --- bad: same name, string type ------------------------------------------------
f="$(write_wf 'name: t
on:
  workflow_dispatch:
    inputs:
      force:
        type: string
        default: false
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - name: Go
        run: |
          if [ "${{ inputs.force }}" = "true" ]; then
            echo forced
          fi')"
run_case "flags string input of same name" 1 "$f"

# --- good: matrix shard ---------------------------------------------------------
f="$(write_wf 'name: t
on: [push]
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - name: Shard
        run: |
          x --shard=${{ matrix.shard-index }}/${{ matrix.total-shards }}')"
run_case "accepts matrix shard" 0 "$f"

# --- bad: single-line run -------------------------------------------------------
f="$(write_wf 'name: t
on: [push]
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - run: echo ${{ env.FOO }}')"
run_case "flags single-line run" 1 "$f"

# --- good: block ends at dedent -------------------------------------------------
f="$(write_wf 'name: t
on: [push]
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - name: A
        run: |
          echo ok
        name: x ${{ env.FOO }}')"
run_case "block ends at dedent" 0 "$f"

# --- good: `- run: |` stops at a sibling key at the run: column (#1397) ---------
# On a `- run: |` line the leading-space count is 2 less than the column of `run:`;
# the sibling `env:` sits at the `run:` column, so the guard must end the script
# there and not flag the expression under env:.
f="$(write_wf 'name: t
on:
  workflow_call:
    inputs:
      x:
        type: string
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - run: |
          echo "$X"
        env:
          X: ${{ inputs.x }}')"
run_case "dash-run block stops at sibling env" 0 "$f"

# --- bad: same expression inside the `- run: |` script (paired with the above) ---
f="$(write_wf 'name: t
on:
  workflow_call:
    inputs:
      x:
        type: string
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - run: |
          echo "${{ inputs.x }}"
        env:
          Y: ok')"
run_case "dash-run block flags expression in script" 1 "$f"

# --- bad: blank line keeps the block open ---------------------------------------
f="$(write_wf 'name: t
on: [push]
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - name: A
        run: |
          echo a

          echo ${{ env.FOO }}')"
run_case "blank line keeps block open" 1 "$f"

# --- bad: shell comment is still expanded ---------------------------------------
f="$(write_wf 'name: t
on: [push]
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - name: A
        run: |
          # ${{ env.FOO }}
          echo ok')"
run_case "flags shell comment" 1 "$f"

# --- bad: composite action input ------------------------------------------------
f="$(write_wf 'name: act
inputs:
  foo:
    description: x
runs:
  using: composite
  steps:
    - run: echo ${{ inputs.foo }}
      shell: bash')"
run_case "flags composite action input" 1 "$f"

# --- good: dotted prefix is not env./inputs. ------------------------------------
f="$(write_wf 'name: t
on: [push]
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - name: A
        run: |
          echo ${{ github.event.inputs.x }} ${{ steps.a.outputs.env }}')"
run_case "skips dotted prefix" 0 "$f"

# --- one report per offending line ----------------------------------------------
f="$(write_wf 'name: t
on: [push]
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - name: A
        run: |
          echo ${{ env.A }} ${{ env.B }}')"
run_case "one report per line" 1 "$f"
lines="$(printf '%s\n' "$out" | grep -c .)"
if [ "$lines" -ne 1 ]; then
  h_fail "one report per line" "expected 1 output line, got $lines"
fi

# --- strict mode: pull_request_target trigger ------------------------------------
# Row-29 acceptance mutation (PR #3652): PR title in the dispatcher's run line.
f="$(write_wf 'name: t
on:
  pull_request_target:
    types: [labeled, auto_merge_enabled]
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - run: echo ${{ github.event.pull_request.title }}')"
run_case "strict: flags PR title in pull_request_target run (row-29)" 1 "$f"
if ! grep -qF -- "pull_request_target workflow" <<< "$out"; then
  h_fail "strict: report names pull_request_target" "output lacks 'pull_request_target workflow': $out"
fi
if ! grep -qF -- ":9:" <<< "$out"; then
  h_fail "strict: report names line 9" "output does not name line 9: $out"
fi
"$CHECK" "$f" >/dev/null 2>"$TMP/strict-err"
if grep -qF -- "in a pull_request_target workflow every" "$TMP/strict-err"; then
  h_pass "strict: stderr hint names pull_request_target"
else
  h_fail "strict: stderr hint names pull_request_target" "stderr lacks the strict hint"
fi

f="$(write_wf 'name: t
on: pull_request_target
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - name: A
        run: |
          echo ${{ steps.a.outputs.x }}')"
run_case "strict: scalar on: flags steps output" 1 "$f"

f="$(write_wf 'name: t
on: [pull_request_target, workflow_dispatch]
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - name: A
        run: echo ${{ needs.a.outputs.x }}')"
run_case "strict: flow on: list flags needs output" 1 "$f"

f="$(write_wf 'name: t
on:
# trigger list
  pull_request_target:
    types: [labeled]
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - run: echo ${{ github.event.label.name }}')"
run_case "strict: block on: with column-0 comment still flags" 1 "$f"

f="$(write_wf 'name: t
"on":
  pull_request_target:
    types: [opened]
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - run: echo ${{ github.event.pull_request.head.ref }}')"
run_case "strict: quoted on: block form flags" 1 "$f"

f="$(write_wf 'name: t
on:
  pull_request_target:
    types: [labeled]
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - name: Dispatch
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
        run: gh workflow run x.yml --ref master')"
run_case "strict: env: expression outside run passes" 0 "$f"

f="$(write_wf 'name: t
on: pull_request_target
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - name: A
        run: |
          echo ${{ github.a }} ${{ github.b }}')"
run_case "strict: one report per line" 1 "$f"
lines="$(printf '%s\n' "$out" | grep -c .)"
if [ "$lines" -ne 1 ]; then
  h_fail "strict: one report per line" "expected 1 output line, got $lines"
fi

# --- trigger parser near-misses: these files stay on the default rule ------------
f="$(write_wf 'name: t
on: [push]  # pull_request_target relay lives elsewhere
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - run: echo ${{ github.repository }}')"
run_case "trigger: trailing comment mention passes" 0 "$f"

f="$(write_wf 'name: relay for pull_request_target events
on: [push]
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - run: echo ${{ github.repository }}')"
run_case "trigger: name: mention outside on: passes" 0 "$f"

f="$(write_wf 'name: t
on: [pull_request]
jobs:
  j:
    runs-on: ubuntu-latest
    steps:
      - run: echo ${{ github.event.pull_request.number }}')"
run_case "trigger: on: [pull_request] keeps github.* allowed" 0 "$f"

# --- usage errors ---------------------------------------------------------------
"$CHECK" --bogus >/dev/null 2>"$TMP/err"; rc=$?
expect "rejects unknown option" 2 "$rc"
if ! grep -qF -- "unknown option" "$TMP/err"; then
  h_fail "rejects unknown option" "stderr lacks 'unknown option'"
fi

"$CHECK" "$TMP/does-not-exist.yml" >/dev/null 2>&1; rc=$?
expect "rejects missing file" 2 "$rc"

h_done
