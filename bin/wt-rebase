#!/bin/bash
# Reconcile all active worktree branches with origin/<branch>, then merge
# origin/master into each one. Fetches once up front (including in --dry-run,
# since classification is entirely a function of remote refs). Never pushes
# anything. Skips worktrees that are actively in use or have uncommitted
# changes. Aborts the merge on conflicts, leaving the worktree as found.
#
# Stacking: if a branch's PR base is not master, origin/master is still merged
# in — there is no stacked-base detection. Merging origin/master into a stacked
# child is harmless (it adds an ancestor the child would gain on merge anyway),
# unlike rebasing it, which rewrites the child's shared commits. No stacked PRs
# exist in this repo today; revisit only if `bin/wt-new --base` sees real use.
#
# Read-only toward the remote: this script only fetches. Reconciliation is
# local-only; a worktree left behind its own origin/<branch> after a skip is
# reported for the operator to resolve, never corrected by a forced update.
#
# Usage: bin/wt-rebase [--dry-run]

set -euo pipefail

# shellcheck source=bin/lib/wt-guards.sh
source "$(dirname "$0")/lib/wt-guards.sh"
# shellcheck source=bin/lib/git-helpers.sh
source "$(dirname "$0")/lib/git-helpers.sh"

REPO_ROOT="$(git worktree list --porcelain | head -1 | sed 's/^worktree //')"
WT_PARENT="$(worktrees_parent_dir "$REPO_ROOT")"
DRY_RUN=false

for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=true ;;
        -*) echo "Unknown option: $arg" >&2; exit 1 ;;
    esac
done

# PID lock — prevent two concurrent invocations from touching the same worktrees.
# /tmp is outside .git/ so it is unambiguous across all worktrees sharing a common
# .git; the kill -0 liveness check means a lock from a crashed run self-heals.
LOCK="/tmp/wt-rebase.pid"
if [ -f "$LOCK" ] && kill -0 "$(cat "$LOCK")" 2>/dev/null; then
    echo "bin/wt-rebase already running (pid $(cat "$LOCK")), skipping." >&2
    exit 0
fi
echo $$ > "$LOCK"
trap 'rm -f "$LOCK"' EXIT

# Fetch once up front — classification is a function of origin/master and
# origin/<branch>; guarding the fetch behind DRY_RUN would classify off stale
# refs and produce meaningless output. A fetch mutates only remote-tracking
# refs — never a worktree or local branch — so it is dry-run-safe.
git -C "$REPO_ROOT" fetch origin --prune --quiet

UPDATED=0
FAILED=0
SKIPPED=0

echo "Reconciling worktrees and merging origin/master..."

while IFS= read -r wt_path; do
    [[ "$wt_path" == "$REPO_ROOT" ]] && continue
    [[ "$wt_path" == "$WT_PARENT/"* ]] || [[ "$wt_path" == "$REPO_ROOT/worktrees/"* ]] || continue

    wt_name=$(basename "$wt_path")
    branch=$(git -C "$wt_path" branch --show-current 2>/dev/null || true)
    [[ -z "$branch" ]] && continue

    # Guards run before classification — an in-use or dirty worktree is always
    # reported, even if it happens to be current with master.
    if is_worktree_in_use "$wt_path"; then
        echo "  SKIP    $wt_name — actively in use"
        SKIPPED=$((SKIPPED + 1)); continue
    fi
    if has_uncommitted_changes "$wt_path"; then
        echo "  SKIP    $wt_name — uncommitted changes"
        SKIPPED=$((SKIPPED + 1)); continue
    fi

    # Reconcile phase: classify the relationship between local HEAD and
    # origin/<branch>. States:
    #   none  — in sync or strictly ahead (local-only work, not diverged)
    #   ff    — strictly behind own remote branch (fast-forward is safe)
    #   reset — diverged, but every local patch already exists upstream
    #           (CI force-pushed a replay; reset --hard is content-safe)
    #   skip  — diverged AND holds a patch that exists nowhere upstream
    #           (real unpublished work; must never be discarded)
    reconcile="none"
    if git -C "$wt_path" rev-parse --verify --quiet "refs/remotes/origin/$branch" >/dev/null 2>&1; then
        local_sha="$(git -C "$wt_path" rev-parse HEAD)"
        remote_sha="$(git -C "$wt_path" rev-parse "origin/$branch")"
        if [[ "$local_sha" == "$remote_sha" ]]; then
            reconcile="none"                                   # (1) in sync
        elif git -C "$wt_path" merge-base --is-ancestor HEAD "origin/$branch" 2>/dev/null; then
            reconcile="ff"                                     # (2) strictly behind own remote
        elif git -C "$wt_path" merge-base --is-ancestor "origin/$branch" HEAD 2>/dev/null; then
            reconcile="none"                                   # (3) strictly ahead — local-only
                                                               #     work, not diverged; merge proceeds
        elif [[ "$(git -C "$wt_path" cherry "origin/$branch" HEAD | grep -c '^+')" -eq 0 ]]; then
            reconcile="reset"                                  # (4a) diverged; every local patch
                                                               #      already upstream — CI replay
        else
            reconcile="skip"                                   # (4b) diverged AND local-only patches
        fi
    fi
    # origin/<branch> absent (auto-deleted on merge, then --prune'd): reconcile stays "none"

    # Data-loss boundary — loud stderr, never silenced
    if [[ "$reconcile" == "skip" ]]; then
        n=$(git -C "$wt_path" cherry "origin/$branch" HEAD | grep -c '^+')
        echo "  SKIP    $wt_name ($branch) — diverged from origin/$branch with $n local-only commit(s); reconcile manually" >&2
        SKIPPED=$((SKIPPED + 1)); continue
    fi

    # Compute merge_needed before any action, so --dry-run can predict it.
    # After ff/reset, HEAD would move to origin/<branch>; evaluate against that.
    case "$reconcile" in
        ff|reset)
            merge_needed=false
            tmp_head="$(git -C "$wt_path" rev-parse "origin/$branch")"
            # Would origin/master be an ancestor of origin/<branch> after reconcile?
            git -C "$wt_path" merge-base --is-ancestor origin/master "$tmp_head" 2>/dev/null \
                || merge_needed=true
            ;;
        none)
            merge_needed=false
            git -C "$wt_path" merge-base --is-ancestor origin/master HEAD 2>/dev/null \
                || merge_needed=true
            ;;
    esac

    # Skip silently if already current (no reconcile and no merge needed)
    if [[ "$reconcile" == "none" ]] && [[ "$merge_needed" == "false" ]]; then
        continue
    fi

    if [ "$DRY_RUN" = true ]; then
        echo "  WOULD   $wt_name ($branch) — reconcile:$reconcile merge:$merge_needed"
        UPDATED=$((UPDATED + 1)); continue
    fi

    # Execute reconcile action
    case "$reconcile" in
        ff)    git -C "$wt_path" merge --ff-only "origin/$branch" -q ;;
        reset) git -C "$wt_path" reset --hard "origin/$branch" -q ;;
    esac

    # Execute merge if needed (re-evaluate after reconcile moved HEAD)
    merge_needed=false
    git -C "$wt_path" merge-base --is-ancestor origin/master HEAD 2>/dev/null \
        || merge_needed=true

    if [[ "$merge_needed" == "true" ]]; then
        if git -C "$wt_path" merge origin/master -q; then
            :
        else
            git -C "$wt_path" merge --abort 2>/dev/null || true
            echo "  FAILED  $wt_name ($branch) — conflicts, merge aborted"
            FAILED=$((FAILED + 1)); continue
        fi
    fi

    echo "  OK      $wt_name ($branch) — reconcile:$reconcile merge:$merge_needed"
    UPDATED=$((UPDATED + 1))

done < <(git -C "$REPO_ROOT" worktree list --porcelain | awk '/^worktree / { print substr($0, 10) }')

if [[ $UPDATED -eq 0 && $FAILED -eq 0 && $SKIPPED -eq 0 ]]; then
    echo "  All worktrees up to date."
fi

echo "Done: $UPDATED updated, $SKIPPED skipped, $FAILED failed."
