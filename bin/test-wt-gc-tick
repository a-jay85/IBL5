# ── tmp_pack cleanup ──────────────────────────────────────────────────────────
fx T1-T4-tmp-pack
PACK="$ENV_MAIN/.git/objects/pack"
mkdir -p "$PACK"
printf 'x' > "$PACK/tmp_pack_new"
printf 'x' > "$PACK/tmp_pack_old"; touch -t "$(epoch_to_touch "$(epoch_ago 2)")" "$PACK/tmp_pack_old"
printf 'x' > "$PACK/pack-abc.pack"; touch -t "$(epoch_to_touch "$(epoch_ago 2)")" "$PACK/pack-abc.pack"
printf 'p123\n' > "$CD/lsof-out"
rt WT_GC_REAP_TMP_PACK=1 STUB_LSOF_RC=0 STUB_LSOF_OUT="$CD/lsof-out" -- --force
log_has "tmp_pack keep $PACK/tmp_pack_new: age" || note_err "T1 fresh pack not kept for age"
log_has "tmp_pack keep $PACK/tmp_pack_old: held open" || note_err "T2 held pack not kept"
[ -f "$PACK/tmp_pack_old" ] || note_err "T2 held pack deleted"
rt WT_GC_REAP_TMP_PACK=1 STUB_LSOF_ERR=1 -- --force
log_has "tmp_pack keep $PACK/tmp_pack_old: probe error" || note_err "T3 lsof error not kept"
[ -f "$PACK/tmp_pack_old" ] || note_err "T3 pack deleted"
rt WT_GC_REAP_TMP_PACK=1 -- --dry-run --force
[ -f "$PACK/tmp_pack_old" ] || note_err "dry run deleted a pack"
log_has "DRY-RUN would: rm -f -- $PACK/tmp_pack_old" || note_err "no DRY-RUN rm line"
rt WT_GC_REAP_TMP_PACK=1 STUB_LSOF_RC=1 -- --force
chk_rc T4 0
[ -f "$PACK/tmp_pack_old" ] && note_err "T4 leftover pack kept"
[ -f "$PACK/pack-abc.pack" ] || note_err "T4 pack-* sibling deleted"
[ -f "$PACK/tmp_pack_new" ] || note_err "T4 fresh pack deleted"
finish_case

# ── Docker prune ──────────────────────────────────────────────────────────────
fx K1-K4-docker
rt WT_GC_DOCKER_PRUNE=1 -- --force
chk_rc K1 0
[ "$(cat "$CD/docker-argv" 2>/dev/null)" = "$(printf '%s\n' info \
    'image prune -af --filter until=168h' 'builder prune -f --filter until=168h')" ] \
    || note_err "K1 docker argv not exact"
grep -qE 'volume|system' "$CD/docker-argv" 2>/dev/null && note_err "K1 volume/system prune"
rt WT_GC_DOCKER_PRUNE=1 STUB_DOCKER_INFO_RC=1 -- --force
chk_rc K2 0
log_has 'docker daemon unreachable — skipped' || note_err "K2 no unreachable line"
[ "$(cat "$CD/docker-argv" 2>/dev/null)" = info ] || note_err "K2 prune ran with daemon down"
rt WT_GC_DOCKER_PRUNE=1 STUB_DOCKER_IMAGE_RC=1 -- --force
chk_rc K3 1
log_has 'docker image prune failed \(rc=1\)' || note_err "K3 no image-failed line"
grep -q '^builder prune' "$CD/docker-argv" 2>/dev/null || note_err "K3 builder prune skipped"
rt WT_GC_DOCKER_PRUNE=1 -- --dry-run --force
chk_rc K4 0
[ "$(cat "$CD/docker-argv" 2>/dev/null)" = info ] || note_err "K4 dry run pruned"
[ "$(grep -c 'DRY-RUN would: .*docker .*prune' "$(LOG)")" = 2 ] || note_err "K4 not two DRY-RUN prune lines"
finish_case

# ── Stale-worktree list for the digest ────────────────────────────────────────
fx S1-S3-stale-list
mk_wt stalled-old s-old age_days=10 dirt=diff
mk_wt unpushed-new u-new ahead=1 age_days=2
row STALLED stalled-old; row UNPUSHED unpushed-new
rt WT_GC_STALE_LIST=1 -- --force
chk_rc S1 0
sed -n 1p "$CD/stale.tsv" 2>/dev/null | grep -qE '^# generated [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$' \
    || note_err "S1 no header"
[ "$(sed -n '2,$p' "$CD/stale.tsv" 2>/dev/null)" = "$(printf 'stalled-old\tSTALLED\t10')" ] \
    || note_err "S1 rows not exactly the >=7d one"
log_has 'SURFACE STALLED stalled-old' || note_err "S1 SURFACE line dropped"
rm -f "$CD/stale.tsv"
rt WT_GC_STALE_LIST=1 -- --dry-run --force
[ -e "$CD/stale.tsv" ] && note_err "S2 dry run wrote the list"
log_has 'DRY-RUN would: write stale list \(1 rows\)' || note_err "S2 no DRY-RUN line"
rt WT_GC_STALE_LIST=0 -- --force
[ -e "$CD/stale.tsv" ] && note_err "S3 switch off wrote the list"
log_has 'step stale-list disabled \(WT_GC_STALE_LIST=0\)' || note_err "S3 no disabled line"
finish_case

# ══════════════════════════════════════════════════════════════════════════════
# G7 verdict: no run, in any case, ever passed a destructive flag to cleanup
# ══════════════════════════════════════════════════════════════════════════════
CASE=G7-cleanup-argv
CASE_ERRS="$G7_ERRS"   # exact-argv findings from the G7 section above
if [ ! -s "$ROOT/all-argv" ]; then note_err "no cleanup argv was ever captured"; fi
if grep -E -- '--discard-generated|--discard-closed|--drop-merged-stashes' "$ROOT/all-argv" >/dev/null 2>&1; then
    note_err "a run passed a destructive flag to cleanup"
fi
finish_case

h_done
