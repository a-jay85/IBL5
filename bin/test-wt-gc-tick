finish_case
fi


# ══════════════════════════════════════════════════════════════════════════════
# Reap steps (bin/lib/wt-gc-reap.sh): fixture env, stubs, cases H0..S3
# ══════════════════════════════════════════════════════════════════════════════
# fx <case> — begin a case with a fresh fixture env, an empty registry, an
# empty gh fixture dir and an empty wt-status row file.
fx() {
    begin_case "$1"
    new_env "$CD/env"
    printf '{}\n' > "$CD/registry.json"
    mkdir -p "$CD/gh/by-head"
    : > "$CD/rows"
}
# row <CLASS> <name> — one wt-status-rows line.
row() { printf "%-12s %-30s %s\n" "$1" "$2" "(fixture)" >> "$CD/rows"; }
# rt [VAR=val ...] -- [args] — run_tick against the fixture env.
rt() {
    fresh
    rm -f "$CD/docker-argv" "$CD/wt-remove-argv" "$CD/gh-argv"
    run_tick WT_GC_REPO_ROOT="$ENV_MAIN" WT_GC_WT_STATUS="$STUBBIN/wt-status-rows" \
        STUB_WT_STATUS_ROWS="$CD/rows" WT_GC_WT_REMOVE="$ENV_MAIN/bin/wt-remove" "$@"
}
wt_dir()     { printf '%s/IBL5-worktrees/%s' "$(dirname "$ENV_MAIN")" "$1"; }
has_branch() { git -C "$ENV_MAIN" show-ref -q --verify "refs/heads/$1"; }
has_ref()    { git -C "$ENV_MAIN" show-ref -q --verify "$1"; }
tips_has()   { cat "$CD"/tips/tips-*.txt 2>/dev/null | grep -qxF -- "$1"; }
arch_has()   { git -C "$ENV_MAIN" show-ref -q --verify "refs/wt-gc-archive/$1"; }
ALL_ON=(WT_GC_REAP_EMPTY=1 WT_GC_REAP_DIRTY_MERGED=1 WT_GC_REAP_REFS=1
    WT_GC_REAP_TMP_PACK=1 WT_GC_DOCKER_PRUNE=1 WT_GC_STALE_LIST=1)

# H0 — the tick with every reap step off is inert on the fixture env.
if should_run H0-fixture-env; then
fx H0-fixture-env
mk_wt empty-old e-old age_days=10
mk_wt ahead-old a-old ahead=2 age_days=10
mk_ref refs/tmp/x 15
row EMPTY empty-old; row EMPTY ahead-old
B_REFS="$(refs_snapshot)"; B_WT="$(wt_snapshot)"
rt -- --force
chk_rc "H0" 0
grep -qE 'done dry_run=0 cleaned=[0-9]+ skipped=[0-9]+ stalled=0 unpushed=0 empty=2 open_pr=0 merged=0 rc=0$' \
    <<< "$(final_line)" || note_err "done line shape changed"
[ "$(refs_snapshot)" = "$B_REFS" ] || note_err "refs changed"
[ "$(wt_snapshot)" = "$B_WT" ] || note_err "worktrees changed"
[ "$(git -C "$ENV_MAIN" rev-list --count origin/master..a-old)" = 2 ] || note_err "a-old not 2 ahead"
CT="$(git -C "$ENV_MAIN" log -1 --format=%ct refs/tmp/x)"
[ $(( $(date +%s) - CT )) -ge $(( 14 * 86400 )) ] || note_err "refs/tmp/x committer date not backdated"
finish_case
fi

# H1 — each kill switch at 0 disables only its own step.
if should_run H1-switch-isolation; then
fx H1-switch-isolation
SW_VARS=(WT_GC_REAP_EMPTY WT_GC_REAP_DIRTY_MERGED WT_GC_REAP_REFS WT_GC_REAP_TMP_PACK WT_GC_DOCKER_PRUNE WT_GC_STALE_LIST)
SW_NAMES=(empty dirty-merged refs tmp-pack docker stale-list)
SW_PATS=('step empty threshold=' 'step dirty-merged$' 'refs threshold backup=' 'step tmp-pack threshold=' 'step docker threshold=' 'step stale-list threshold=')
for i in 0 1 2 3 4 5; do
    rt "${ALL_ON[@]}" "${SW_VARS[$i]}=0" -- --force
    chk_rc "${SW_VARS[$i]}=0" 0
    log_has "step ${SW_NAMES[$i]} disabled \(${SW_VARS[$i]}=0\)" || note_err "${SW_VARS[$i]}: no disabled line"
    for j in 0 1 2 3 4 5; do
        if [ "$i" = "$j" ]; then
            log_has "${SW_PATS[$j]}" && note_err "${SW_VARS[$i]}=0: step ${SW_NAMES[$j]} still ran"
        else
            log_has "${SW_PATS[$j]}" || note_err "${SW_VARS[$i]}=0: step ${SW_NAMES[$j]} did not run"
        fi
    done
done
finish_case
fi

# H2 — numeric seams: unset = default (legal); empty = invalid, rc 1 (illegal).
# Mutation check: rewriting a seam as ${VAR:-7} (empty -> default) fails this case.
if should_run H2-numeric-seams; then
fx H2-numeric-seams
N_VARS=(WT_GC_EMPTY_DAYS WT_GC_BACKUP_DAYS WT_GC_REF_DAYS WT_GC_TMP_PACK_DAYS WT_GC_STALE_DAYS WT_GC_DOCKER_UNTIL)
N_ON=(WT_GC_REAP_EMPTY=1 WT_GC_REAP_REFS=1 WT_GC_REAP_REFS=1 WT_GC_REAP_TMP_PACK=1 WT_GC_STALE_LIST=1 WT_GC_DOCKER_PRUNE=1)
N_DEF=('step empty threshold=7d' 'refs threshold backup=7d other=14d' 'refs threshold backup=7d other=14d'
    'step tmp-pack threshold=1d' 'step stale-list threshold=7d' 'step docker threshold=168h')
for i in 0 1 2 3 4 5; do
    rt "${N_ON[$i]}" -- --force
    chk_rc "${N_VARS[$i]} unset" 0
    log_has "${N_DEF[$i]}" || note_err "${N_VARS[$i]} unset: default not used"
    log_has 'invalid ' && note_err "${N_VARS[$i]} unset: invalid logged"
    rt "${N_ON[$i]}" "${N_VARS[$i]}=" -- --force
    chk_rc "${N_VARS[$i]} empty" 1
    log_has "invalid ${N_VARS[$i]} ''" || note_err "${N_VARS[$i]} empty: no invalid line"
    [ -f "$CD/state/last-sweep" ] && note_err "${N_VARS[$i]} empty: stamp written"
done
rt WT_GC_DOCKER_PRUNE=1 WT_GC_DOCKER_UNTIL=168 -- --force
chk_rc "DOCKER_UNTIL=168" 1
log_has "invalid WT_GC_DOCKER_UNTIL '168'" || note_err "168 without h accepted"
grep -q prune "$CD/docker-argv" 2>/dev/null && note_err "168 without h: prune ran"
finish_case
fi

# H2b — switch and path seams: empty means default, never an error. (An empty
# binary seam means "not found", not default: case P3.)
if should_run H2b-path-seams; then
fx H2b-path-seams
rt WT_GC_REAP_EMPTY= WT_GC_REAP_DIRTY_MERGED= WT_GC_REAP_REFS= WT_GC_REAP_TMP_PACK= \
    WT_GC_DOCKER_PRUNE= WT_GC_STALE_LIST= WT_GC_TIPS_DIR= WT_GC_STALE_FILE= \
    WT_GC_QUEUE_DIR= WT_GC_SESSION_REGISTRY= -- --force
chk_rc "empty switch/path seams" 0
log_has 'invalid |unbound' && note_err "empty seam rejected"
err_has 'unbound' && note_err "unbound variable"
[ -f "$CD/state/stale-worktrees.tsv" ] || note_err "WT_GC_STALE_FILE= did not default under the lock dir"
log_has 'step docker threshold=168h' || note_err "WT_GC_DOCKER_PRUNE= did not mean enabled"
finish_case
fi

# H3 — a failing step logs, later steps still run, rc 1, no stamp.
if should_run H3-failure-isolation; then
fx H3-failure-isolation
mk_ref refs/tmp/old 20
rt "${ALL_ON[@]}" WT_GC_TIPS_DIR=/dev/null/x -- --force
chk_rc "H3" 1
log_has 'step refs failed \(rc=' || note_err "no 'step refs failed'"
log_has 'step tmp-pack threshold=' || note_err "later step tmp-pack did not run"
log_has 'step stale-list threshold=' || note_err "later step stale-list did not run"
log_has 'reap done steps_failed=1' || note_err "steps_failed not 1"
[ -f "$CD/state/last-sweep" ] && note_err "stamp written after a failed step"
has_ref refs/tmp/old || note_err "ref deleted without a tips line"
finish_case
fi

# H3b — errexit holds inside a step: a failing command stops the step before
# a later delete; the tick logs the failure and exits 1. The refs step's
# `now="$(date +%s)"` fails via a date wrapper; past it, the foreign-remote
# ref would be deleted (that class has no age test).
if should_run H3b-step-errexit; then
fx H3b-step-errexit
mk_ref refs/remotes/prh/1 1
mkdir -p "$CD/datewrap"
cat > "$CD/datewrap/date" <<SH
#!/usr/bin/env bash
[ "\$*" = "+%s" ] && exit 1
exec "$(command -v date)" "\$@"
SH
chmod +x "$CD/datewrap/date"
rt WT_GC_REAP_REFS=1 WT_GC_REAP_TMP_PACK=1 PATH="$CD/datewrap:$STUBBIN:$PATH" -- --force
chk_rc H3b 1
log_has 'step refs failed \(rc=' || note_err "no 'step refs failed'"
log_has 'step tmp-pack threshold=' || note_err "later step did not run"
has_ref refs/remotes/prh/1 || note_err "step ran past the failed command and deleted a ref"
finish_case
fi

# H4 — _gc_tips_record writes and re-reads; an unwritable dir returns 1.
if should_run H4-tips-record; then
fx H4-tips-record
touch "$CD/afile"
H4_SHA="$(git -C "$ENV_MAIN" rev-parse HEAD)"
H4_RC=0
(
    log() { :; }
    # shellcheck source=bin/lib/wt-gc-reap.sh disable=SC1091
    source "$SCRIPT_DIR/lib/wt-gc-reap.sh"
    WT_GC_REPO_ROOT="$ENV_MAIN" WT_GC_ARCHIVE_STAMP=1700000001
    WT_GC_TIPS_DIR="$CD/tips" _gc_tips_record "$H4_SHA" refs/tmp/x || exit 3
    WT_GC_TIPS_DIR="$CD/afile/x" _gc_tips_record "$H4_SHA" refs/tmp/x && exit 4
    exit 0
) || H4_RC=$?
[ "$H4_RC" = 0 ] || note_err "tips record rc path $H4_RC"
grep -qxF "$H4_SHA refs/tmp/x" "$CD/tips/tips-$(date +%F).txt" 2>/dev/null || note_err "tips line missing"
arch_has 1700000001/tmp/x || note_err "H4 keep-ref missing"
[ -e "$CD/afile/x" ] && note_err "unwritable dir produced a file"
finish_case
fi

# L1 — the library sources under env -i (no HOME, minimal PATH).
if should_run L1-library-env-i; then
begin_case L1-library-env-i
RC=0
env -i PATH=/usr/bin:/bin bash -euo pipefail -c \
    'source "$1" && type _gc_do _gc_tips_record _gc_live_work >/dev/null && echo OK' \
    _ "$SCRIPT_DIR/lib/wt-gc-reap.sh" > "$CD/out" 2>&1 || RC=$?
chk_rc "env -i source" 0
grep -qx OK "$CD/out" || note_err "functions not defined"
finish_case
fi

