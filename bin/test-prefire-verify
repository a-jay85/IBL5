test_phpunit_force_full_env_invalid_exits_2() {
    subset_case
    export PREFIRE_PHPUNIT_FULL=yes
    run_gate --stage phpunit
    want_rc 2
    want_out "PREFIRE_PHPUNIT_FULL must be 1, 0, or unset"
    want_cnt phpunit 0
}

# parent edits UnrelatedTest.php, child (stacked on parent) edits BarTest.php.
stacked_tree() {
    (
        cd "$R" || exit 1
        git checkout -q -b parent
        printf '// parent edit\n' >> ibl5/tests/Other/UnrelatedTest.php
        git add -A && git commit -q -m parent
        git checkout -q -b child
        printf '// child edit\n' >> ibl5/tests/Foo/BarTest.php
        git add -A && git commit -q -m child
        git config branch.child.iblBase parent
    ) || { echo "HARNESS-SETUP: stacked fixture failed" >&2; exit 2; }
}

test_phpunit_stacked_iblbase_scopes_diff() {
    subset_case
    stacked_tree
    run_gate_nobase --stage phpunit
    want_rc 0
    want_args "1:tests/Foo/BarTest.php"
}

test_phpunit_base_flag_overrides_iblbase() {
    subset_case
    stacked_tree
    run_gate --stage phpunit
    want_rc 0
    want_args "2:tests/Foo/BarTest.php tests/Other/UnrelatedTest.php"
}

test_phpunit_subset_leaves_worktree_clean() {
    subset_case
    touch_file ibl5/classes/Foo/Bar.php
    local before after logs n=0 f first=""
    before=$(git -C "$R" status --porcelain)
    run_gate --stage phpunit
    after=$(git -C "$R" status --porcelain)
    want_rc 0
    [ "$before" = "$after" ] || note "git status changed: before='$before' after='$after'"
    logs=$(state_dir)
    for f in "$logs"/*.phpunit.log; do
        [ -e "$f" ] || continue
        n=$((n + 1)); first=$(head -n 1 "$f")
    done
    [ "$n" -eq 1 ] || note "expected exactly 1 phpunit log, found $n"
    [ "$first" = "prefire-verify phpunit mode: subset" ] || note "log first line is '$first'"
}

