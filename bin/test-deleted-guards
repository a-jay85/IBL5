EOF
run_dg --diff "$T/dup-cross-file.diff"
h_eq "dup-cross-file-legacy-keys" "strict-mode@bin/foo#4fd4bd77 strict-mode@bin/bar#4fd4bd77 " "$(keys_of "$OUT")"

cat > "$T/dup-cancel.diff" <<'EOF'
diff --git a/bin/foo b/bin/foo
