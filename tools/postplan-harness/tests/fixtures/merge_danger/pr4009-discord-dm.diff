+# Sent log: one line per delivered message. Best-effort by design: every failure is
+# swallowed so logging can never change a send's exit code or output.
+log_sent() {
+    local log kind caller args word preview
+    log="${DISCORD_DM_SENT_LOG:-$HOME/.claude/discord-dm-sent.log}"
+    if [ "$USE_WEBHOOK" = 1 ]; then kind="$WEBHOOK_KIND"
+    elif [ "$RAW" = 1 ] || [ "$ROUTE" != "/discordDM" ]; then kind="route:$ROUTE"
+    else kind="dm"; fi
+    caller="${DISCORD_DM_CALLER:-}"
+    if [ -z "$caller" ]; then
+        args=$(ps -o args= -p "$PPID" 2>/dev/null)
+        for word in $args; do
+            case "$word" in bin/*|*/bin/*) [ -f "$word" ] && { caller="${word##*/}"; break; } ;; esac
+        done
+        [ -n "$caller" ] || caller="${args%% *}"
+        caller="${caller##*/}"
+    fi
+    [ -n "$caller" ] || caller="unknown"
+    caller=$(printf '%s' "$caller" | tr '\t\r\n' '   ')
+    preview=$(printf '%s' "$FULL_MSG" | head -n 1 | tr '\t\r' '  ' | cut -c1-60)
+    mkdir -p "$(dirname "$log")"
+    printf '%s\t%s\t%s\t%s\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$kind" "$caller" \
+        "$(printf '%s' "$FULL_MSG" | wc -c | tr -d ' ')" "$preview" >> "$log"
+}
+
+if [ "$DELIVERED" = 1 ]; then
+    { log_sent; } >/dev/null 2>&1 || true
+    exit 0
+fi
 
