P2_LINE=$(grep -n 'PICK.*#100' <<< "$OUT" | head -1 | cut -d: -f1)
if [ -n "$P1_LINE" ] && [ -n "$P2_LINE" ] && [ "$P1_LINE" -lt "$P2_LINE" ]; then
    ok "C24: P1 picked before P2"
else
    fail "C24: P1 picked before P2 (P1=$P1_LINE, P2=$P2_LINE)"
fi

