    new_case
    green_plan
    run_gate --plan "$PLAN"; want_rc 0
    run_gate --plan "$PLAN"; want_rc 0
    want_cnt phpunit 1
    want_cnt mutation 0
    want_cnt row1 1
    want_out "pass cached for tree"
}

