need "--headless: message" has_s "$ERR" "mutually exclusive"
run_fix "$SUT" --holdrepeat "$B_HR"
need "slug: rc 2" test "$RC" = 2
need "slug: message" has_s "$ERR" "needs a PR number"
run_fix "$SUT" --dry-run 77
